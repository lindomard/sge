  object Qr_Notas: TQuery
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      'select NSNUMERO,NSCODEMP,NSLOTSEQ_CP,NSCHAVEP,NSORDEMP,NSDTEMIS'
      '       P1CHAVE,P1ORDEM FROM CADNS,CADP01'
      'WHERE NSDTEMIS>='#39'01/10/2004'#39
      'AND P1CODEMP=NSCODEMP '
      'AND P1CHAVE=NSCHAVEP'
      'AND P1ORDEM=NSORDEMP'
      'AND P1CHAVE IS NULL')
    Left = 8
    Top = 24
