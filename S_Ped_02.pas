function tFrm_Ped_02.fMaiorDevol(pTipo: Integer; pCodPro,pLote,pDtVcto: String): Real;
{
ptipo=0 so retorna o valor
      1 atualiza lote e vcto;
}
begin
DM1.Query5.Close;
DM1.Query5.SQL.Clear;
DM1.Query5.SQL.Add('Select sum(P2QTD) AS P2QTD,sum(NVL(P2QTDDEV,0)) as P2QTDDEV,'
                  +' sum(NVL(P2QTD_ENTREGANDO,0)) as P2QTD_ENTREGANDO '
                  +',P2LOTE,P2DTVCTO '
                  +' ,sum(P2QTD-(NVL(P2QTDDEV,0)+NVL(P2QTD_ENTREGANDO,0))) AS QTDVDA '
                  +' from CADP02 where ');
mcinst:=' ((';
mem_CADP01D.First;
While not mem_CADP01D .Eof do
   begin
   if mem_CADP01DP1DCHAVE.IsNull then
      begin
      mem_CADP01D.Next;
      Continue;
      end;
   DM1.Query5.SQL.add(mcinst+' (P2CODEMP=0'+mem_CADP01DP1DCODEMP_OR.AsString
                  +' and P2LOTSEQ=0'+mem_CADP01DP1DLS_OR.AsString
                  +' and P2CHAVE=0'+mem_CADP01DP1DCH_OR.AsString+')');
   mcinst:=') or (';
   mem_CADP01D.Next;
   end;
if mcinst=') or (' then
   DM1.Query5.SQL.Add(')) ');
DM1.Query5.SQL.Add(' and P2CODPRO='+pcodpro);
if trim(plote)<>'' then
   DM1.Query5.SQL.Add(' and P2LOTE='+chr(39)+pLote+chr(39));
if (trim(pDtVcto)<>'/  /') and (trim(pDtvcto)<>'') then
   DM1.Query5.SQL.Add(' and P2DTVCTO='+chr(39)+FormatDateTime(fdt2, StrToDate(pDtvcto))+chr(39));
DM1.Query5.SQL.add(' and P2QTD>(P2QTDDEV+P2QTD_ENTREGANDO) ');
DM1.Query5.SQL.Add('group by P2LOTE,P2DTVCTO ');
DM1.Query5.SQL.Add('order by QTDVDA DESC ');
try
   DM1.Query5.Open;
except
   DM1.Query5.sql.savetofile('c:\sql.txt');
   end;
if DM1.Query5.IsEmpty then
   result:=0
else
   begin
   if ptipo=1 then
      begin
      if trim(DM1.Query5.FieldByName('P2LOTE').asstring)<>'' then
         edt_lote.Text:=DM1.Query5.FieldByName('P2LOTE').asstring;
      if DM1.Query5.FieldByName('P2DTVCTO').AsDateTime>pdatanula then
         edt_dtvcto.Text:=formatDateTime(fdt2, DM1.Query5.FieldByName('P2DTVCTO').AsDateTime);

      end;
   Result:=DM1.Query5.FieldbyName('QTDVDA').AsFloat;
   end;
end;


function tFrm_Ped_02.fBaixarDevolucao(pTipo: Integer; pCodPro,pLote,pDtVcto: String; pQtd:real): Boolean;
{
ptipo=0 Baixa a Devolucao
      1 Cancela a Devolução
}
var
mQtdProd,mQtdBaixa: Real;
begin
if pTipo=0 then
   begin
   DM1.Query5.Close;
   DM1.Query5.SQL.Clear;
   DM1.Query5.SQL.Add('Select P2QTD,P2QTDDEV'
                  +' ,NVL(P2QTD_ENTREGANDO) AS P2QTD_ENTREGANDO '
                  +' ,P2QTD-(NVL(P2QTDDEV,0)+NVL(P2QTD_ENTREGANDO,0)) AS QTDVDA '
                  +',P2LOTE,P2DTVCTO,P2CODEMP,P2CODPRO,P2CHAVE,P2ORDEM,P2LOTSEQ,P2ITEM '
                  +' from CADP02 where ');
   mcinst:=' ((';
   mem_CADP01D.First;
   While not mem_CADP01D .Eof do
      begin
      if mem_CADP01DP1DCHAVE.IsNull then
         begin
         mem_CADP01D.Next;
         Continue;
      end;
      DM1.Query5.SQL.add(mcinst+' (P2CODEMP=0'+mem_CADP01DP1DCODEMP_OR.AsString
                     +' and P2LOTSEQ=0'+mem_CADP01DP1DLS_OR.AsString
                     +' and P2CHAVE=0'+mem_CADP01DP1DCH_OR.AsString+')');
      mcinst:=') or (';
      mem_CADP01D.Next;
      end;
   if mcinst=') or (' then
      DM1.Query5.SQL.Add(')) ');
   DM1.Query5.SQL.Add(' and P2CODPRO='+pcodpro);
   if trim(plote)<>'' then
      DM1.Query5.SQL.Add(' and P2LOTE='+chr(39)+pLote+chr(39));
   if (trim(pDtVcto)<>'/  /') and (trim(pDtvcto)<>'') then
      DM1.Query5.SQL.Add(' and P2DTVCTO='+chr(39)+FormatDateTime(fdt2, StrToDate(pDtvcto))+chr(39));
   DM1.Query5.SQL.add(' and P2QTD>(NVL(P2QTDDEV,0)+NVL(P2QTD_ENTREGANDO,0)) ');
   DM1.Query5.SQL.Add('order by QTDVDA DESC ');
   try
      DM1.Query5.Open;
   except
      DM1.Query5.sql.savetofile('c:\sql.txt');
      end;
   mQtdProd:=pqtd;
   While (not DM1.Query5.Eof) and (mQTdProd>0) do
      begin
      mQtdBaixa:=DM1.Query5.fieldbyName('QTDVDA').AsFloat;
      if mQtdBaixa>mQtdProd then
         mQtdBaixa:=mQtdprod;
      DM1.Query1.Close;
      DM1.Query1.SQL.clear;
      DM1.Query1.SQL.add('Update CADP02 set P2QTDDEV=P2QTDDEV+:QTDDEV '
                         +' where P2CODEMP=:CODEMP '
                         +' and P2LOTSEQ=:LOTSEQ '
                         +' and P2CHAVE=:CHAVE '
                         +' and P2CODPRO=:CODPRO '
                         +' and P2ITEM=:ITEM ');
      DM1.Query1.ParambyName('CODEMP').AsFloat:=DM1.Query5.FieldbyName('P2CODEMP').AsFloat;
      DM1.Query1.ParambyName('LOTSEQ').AsFloat:=DM1.Query5.FieldbyName('P2LOTSEQ').AsFloat;
      DM1.Query1.ParambyName('CHAVE').AsFloat :=DM1.Query5.FieldbyName('P2CHAVE').AsFloat;
      DM1.Query1.ParambyName('CODPRO').AsFloat :=DM1.Query5.FieldbyName('P2CODPRO').AsFloat;
      DM1.Query1.ParambyName('ITEM').AsFloat  :=DM1.Query5.FieldbyName('P2ITEM').AsFloat;
      DM1.Query1.ParambyName('QTDDEV').AsFloat:=mQtdBaixa;
      try
         DM1.query1.ExecSQL;
         fdm1StartCommit;
      except
         ex_erroSql_Novo(DM1.Query1,21203,'Frm_Ped_02','CADP02');
         end;
      mQtdProd:=mQtdProd-mQtdBaixa;
      DM1.Query5.Next;
      end;
   end
else if pTipo=1 then
   begin
   DM1.Query5.Close;
   DM1.Query5.SQL.Clear;
