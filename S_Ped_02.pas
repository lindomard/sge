procedure TFrm_Ped_02.edt_loteExit(Sender: TObject);
begin
if (mpd_ant_codpro=StrToFloat(edt_codproduto.Text)) and (
   (mpd_ant_lote<>edt_lote.Text) or (mpd_ant_dtvcto<>edt_dtvcto.Text)) then
  begin
  flcadpar02(0,0,CodUsr,IntToStr(56));
  if DM4.Tb_Par02PA2PDSN.Value = 'S' then
    begin
    if fValidaSenha(0,codusr,56,0,QryItem_NotaP2CODPRO.Value,0,0,0, 'Senha para alterar o lote do pedido?','') <> 0 then
     begin
      fMensagem('Alteração não Aceita!',0,['0'],0);
      edt_lote.Text  :=mpd_ant_lote;
      edt_dtvcto.Text:=mpd_ant_dtvcto;
      edt_lote.SetFocus;
      exit;
      end;
    end;
  end;


if valint(copy(mpseg,4,2))=2 then
   begin
   if not flcadlgc(0,1,0,edt_codproduto.Text,edt_lote.Text,'') then
      begin
      fmensagem('Grade não Encontrada!',0,['0'],0);
      edt_codproduto.SetFocus;
      exit;
      end;
   end;

if (mPd_SaiNor) or
   (mPd_SaiCons) or
   (mPd_SaiTerc) or
   (mPd_SaiRVenda) or
   (mPd_EntraNor) or
   (mPd_EntraCons) or
   (mPd_EntraTerc) or
   (mPd_EntraRVenda) then
   begin
   if (trim(edt_lote.text)<>'') and (valint(copy(mpseg,4,2))=1) then
      begin
      if (trim(edt_dtvcto.Text)='/  /') OR (trim(edt_dtvcto.Text)='') then
         mdtv:='ALL'
      else
         mdtv:=edt_dtvcto.Text;

      if mPd_Oper_Ped=1 then
         begin
         if mPosReg_Prod<>nil then
            QryItem_Nota.GotoBookmark(mPosReg_Prod);
         end;
      if (mPd_Oper_Ped<>1) or (QryItem_NotaP2LOTE.AsString<>edt_lote.Text) then
         begin
         if flcadlgc(0,1,0,edt_codproduto.Text,edt_lote.Text,mdtv) then
            begin
            if (trim(edt_dtvcto.Text)='/  /') and (DM1.Tb_LGCCLDTVCTO.Asdatetime>pDatanula) then
               edt_dtvcto.Text:=FormatDateTime(fdt2, DM1.Tb_LGCCLDTVCTO.Value);
            end
         else
            begin
             if mPd_Venda_Devol=0 then
                begin
                fmensagem('Lote não Encontrado!',0,['0'],0);
                edt_codproduto.SetFocus;
                exit;
                end;
            end;
         end;

       if (mPd_Venda_Devol=1) and (not CB_PEDORI.Checked) and (not Tb_DevCli.IsEmpty) then
          edt_codprodutoexit(self);
      end;
   end;
end;


function tFrm_Ped_02.fgravarpendencia(pCodemp: Integer):Boolean;
var
mItemPen: Integer;
begin
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('Delete from CADPEN where ');
DM1.Query1.SQL.Add('( PECODEMP=0'+IntTostr(pcodemp)+' or PECODEMP=0'
                  +IntToStr(iif(pcodemp>100,pcodemp-100,pcodemp+100))+') and ');
DM1.Query1.SQL.add(' PELOTSEQ=0'+IntToStr(mPd_LotSeq)
                  +' and PECHAVE=0'+IntToStr(mpd_chave));
Try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   ex_erroSql(01,9878,'Frm_Ped_AutoP','CADPEN');
   end;
if mpd_ptipop=0 then
   begin
   result:=true;
   exit;
   end;
mem_CADPEN.First;


DM1.Query2.Close;
DM1.Query2.SQL.clear;
DM1.Query2.SQL.add('Insert into CADPEN ('
                  +' PECODEMP '
                  +',PELOTSEQ '
                  +',PECHAVE '
                  +',PEITEM '
                  +',PECODPRO '
                  +',PEGRADE '
                  +',PEQTDPED '
                  +',PEQTDENV '
                  +',PEQTDPEN '
                  +',PEDESC01 '
                  +',PEDESC02 '
                  +',PEDESC03 '
                  +',PEVALDES '
                  +',PEPRECO '
                  +',PEDATA '
                  +',PECODCLI '
                  +',PECODVEN ) values ('
                  +' :CODEMP '
                  +',:LOTSEQ'
                  +',:CHAVE'
                  +',:ITEM '
                  +',:CODPRO '
                  +',:GRADE '
                  +',:QTDPED '
                  +',:QTDENV '
                  +',:QTDPEN '
                  +',:DESC01 '
                  +',:DESC02 '
                  +',:DESC03 '
                  +',:VALDES '
                  +',:PRECO '
                  +',:DATA '
                  +',:CODCLI '
                  +',:CODVEN '
                  +')');
mItemPen:=0;

While not mem_CADPEN.Eof do
   begin
   mItemPen:=mItemPen+1;
   DM1.Query2.ParamByName('CODEMP').AsFloat := pCodemp;
   DM1.Query2.ParamByName('LOTSEQ').AsFloat := mPd_LotSeq;
   DM1.Query2.ParamByName('CHAVE').AsFloat  := mpd_chave;
   DM1.Query2.ParamByName('ITEM').AsFloat   := mItemPen;
   DM1.Query2.ParamByName('CODPRO').AsFloat := mem_CADPENPECODPRO.AsFloat;
   DM1.Query2.ParamByName('GRADE').AsString := mem_CADPENPEGRADE.AsString;
   DM1.Query2.ParamByName('QTDPED').AsFloat := mem_CADPENPEQTDPED.AsFloat;
   DM1.Query2.ParamByName('QTDENV').AsFloat := mem_CADPENPEQTDENV.AsFloat;
   DM1.Query2.ParamByName('QTDPEN').AsFloat := mem_CADPENPEQTDPEN.AsFloat;
   DM1.Query2.ParamByName('DESC01').AsFloat := mem_CADPENPEDESC01.AsFloat;
   DM1.Query2.ParamByName('DESC02').AsFloat := mem_CADPENPEDESC02.AsFloat;
   DM1.Query2.ParamByName('DESC03').AsFloat := mem_CADPENPEDESC03.AsFloat;
   DM1.Query2.ParamByName('VALDES').AsFloat := mem_CADPENPEVALDES.AsFloat;
   DM1.Query2.ParamByName('PRECO').AsFloat  := mem_CADPENPEPRECO.AsFloat;
   DM1.Query2.ParamByName('DATA').AsDateTime:= StrToDate(edt_datapedido.Text);
   DM1.Query2.ParamByName('CODCLI').AsFloat := fSonumero(edt_codcliente.Text);
   DM1.Query2.ParamByName('CODVEN').AsFloat := mem_CADPENPECODVEN.AsFloat;
//   DM1.Query2.ParamByName('CODVEN').AsFloat := fSonumero(edt_codvendedor.Text);
   Try
      DM1.Query2.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql_Novo(DM1.Query2,19268,'Frm_Ped_02','CADPEN');
      end;
   mem_CADPEN.Next;
   end;
result:=true;

end;

