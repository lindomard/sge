procedure TFrm_Ped_02.btn_imprimirClick(Sender: TObject);
var
  mNivel,mQtdMan: Integer;
  mCodAnt: String;
  mCodEAnt: String;
begin
Qr_Ped01.First;
mqtdman:=Qr_Ped01P1QTDMAN.AsInteger;
Qr_Ped01.Close;
Qr_Ped01.Open;
if Qr_Ped01.Eof then
   begin
   btn_cancelar.Click;
   verteclado(0);
   fMensagem('Chave não Encontrada!',0,['0'],0);
   exit;
   end;

if (Qr_Ped01P1SITPED.Value = 1) and ( (Qr_Ped01P1DATHOR_ULTEVE.AsDateTime>pdatanula)
   and (trunc((now-Qr_Ped01P1DATHOR_ULTEVE.AsDateTime))*24*60<=1))
   and (not mpd_RestaurandoPedido) then
   begin
   mcinst2:=Qr_Ped01P1CODUSR.AsString+' - ';
   if Qr_Ped01P1CODUSR.AsInteger=1111 then
      mcinst2:=mcinst2+'Programador(Master)'
   else
      begin
      if flcadusr(0,0,Qr_Ped01P1CODUSR.AsString) then
         mcinst2:=mcinst2+DM4.Tb_UsrNOMUSR.AsString;
      end;
   mcinst := 'Este Pedido Sendo Alterado no Computador: '+Qr_Ped01P1COMP_ULTEVE.AsString
           + ' Pelo Usuário: '+mcinst2
           + ' Data/Hora: '+Formatdatetime('dd/mm/yyyy hh:nn:ss', Qr_Ped01P1DATHOR_ULTEVE.AsDateTime);
   verteclado(0);
   fMensagem(mcinst,0,['0'],0);
   exit;
   end;

if Qr_Ped01P1QTDMAN.Value>mqtdman then
   begin
   moper_ped:=3;
   btn_localizar.Click;

   if (Qr_Ped01P1SITPED.Value = 1) and ( (Qr_Ped01P1DATHOR_ULTEVE.AsDateTime>pdatanula)
      and (trunc((now-Qr_Ped01P1DATHOR_ULTEVE.AsDateTime))*24*60<=1))
      and (not mpd_RestaurandoPedido) then
      begin
      mcinst2:=Qr_Ped01P1CODUSR.AsString+' - ';
      if Qr_Ped01P1CODUSR.AsInteger=1111 then
         mcinst2:=mcinst2+'Programador(Master)'
      else
         begin
         if flcadusr(0,0,Qr_Ped01P1CODUSR.AsString) then
            mcinst2:=mcinst2+DM4.Tb_UsrNOMUSR.AsString;
         end;
      mcinst := 'Este Pedido Sendo Alterado no Computador: '+Qr_Ped01P1COMP_ULTEVE.AsString
              + ' Pelo Usuário: '+mcinst2
              + ' Data/Hora: '+Formatdatetime('dd/mm/yyyy hh:nn:ss', Qr_Ped01P1DATHOR_ULTEVE.AsDateTime);
      verteclado(0);
      fMensagem(mcinst,0,['0'],0);
      exit;
      end;
   end;
{
if (CB_MODORCAM.Checked) and (Qr_Ped01P1TIPO.AsInteger=0) then
   begin
   fEmitirPedido(0,0,0,Qr_Ped01P1CHAVE.AsFloat,0,Qr_Ped01P1LOTSEQ.AsFloat,Qr_Ped01P1CODEMP.AsFloat);
   exit;
   end;
}
Qr_Ped01.First;
mcodant:='';
mcodeant:='';
if (log_codven<>0) and (Qr_Ped01P1STATUS.AsInteger=1)
   and (Qr_Ped01P1TIPO.AsInteger>0) and (DM1.Tb_PargerPLOGUSRPED.AsInteger=1) then
   begin
   fMensagem('Reimpressão não autorizada, Favor solicitar Gerência!',0,['0'],0);
   exit;
   end;
While not Qr_Ped01.eof do
   begin
   mnivel:=0;
   if (mpd_ptipop=0) or (mpd_ptipop=10) then // orcamento
      begin
      if (mcodant<>Qr_Ped01P1CHAVE.AsString) or ((mcodeant<>Qr_Ped01P1CHAVE.AsString) and (pconsemp=false)) then
         begin
         if Qr_Ped01P1SEPAMB.AsInteger=18 then
            begin
            if Frm_Fatur_OrcGrupo=nil then
               Application.CreateForm(TFrm_Fatur_OrcGrupo, Frm_Fatur_OrcGrupo)
            else
               begin
               Frm_Fatur_OrcGrupo.free;
               Frm_Fatur_OrcGrupo:=nil;
               Application.CreateForm(TFrm_Fatur_OrcGrupo, Frm_Fatur_OrcGrupo);
               end;
            Frm_Fatur_OrcGrupo.CHAVE.Text   :=edt_chave.Text;
            Frm_Fatur_OrcGrupo.MDATAP.Text  :=edt_datapedido.Text;
            Frm_Fatur_OrcGrupo.MCLIENTE.Text:=edt_codcliente.Text+' '+edt_nomecliente.Text;
            Frm_Fatur_OrcGrupo.MCIDADE.Text :=DM1.Tb_CliCCIDADE.Value+' - '+DM1.Tb_CliCUF.Value;
            Frm_Fatur_OrcGrupo.Memo_obs.Lines.Clear;
            Frm_Fatur_OrcGrupo.FormStyle:=fsNormal;
            Frm_Fatur_OrcGrupo.Visible:=false;
            fAtualizaForm(0);
            Frm_Fatur_OrcGrupo.ShowModal;
            Frm_Fatur_OrcGrupo.Free;
            Frm_Fatur_OrcGrupo:=nil;
            end
         else
            begin
            FPedEmiteNf(0,2,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,1,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,iif(CB_MODORCAM.Checked,1,0),0); // orcamento
            if DM1.Tb_PargerPLORCMOD02.AsInteger=1 then
               FPedEmiteNf(0,6,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,1,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,iif(CB_MODORCAM.Checked,1,0),0); // orcamento
            mcodant:=Qr_Ped01P1CHAVE.AsString;
            mcodeant:=Qr_Ped01P1CODEMP.AsString;
            end;
         end;
      end
   else if mpd_ptipop=9 then  // emprestimo de mercadorias (vale)
      begin
      FPedEmiteNf(0,4,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,0,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,iif(CB_MODORCAM.Checked,1,0),0); // lista emprestimo de mercadorias (Vale)
      if DM1.Tb_PargerPLVALEMOD02.AsInteger=1 then
         FPedEmiteNf(0,8,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,0,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,iif(CB_MODORCAM.Checked,1,0),0); // lista emprestimo de mercadorias (Vale)

//      if DM1.Tb_PargerPSTATUS_LSEP09.AsInteger>0 then
//          mnivel:=1;
      end
   else // lista de separacao
      begin
      if DM1.Tb_PargerPLSEPSEP_ORDEM.AsInteger=1 then
         begin
         FPedEmiteNf(0,3,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,0,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,iif(CB_MODORCAM.Checked,1,0),0); // lista de separacao
         if DM1.Tb_PargerPLSEPMOD02.AsInteger=1 then
            FPedEmiteNf(0,5,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,0,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,iif(CB_MODORCAM.Checked,1,0),0); // lista de separacao
         end
      else
         begin
         if (mcodant<>Qr_Ped01P1CHAVE.AsString) or ((mcodeant<>Qr_Ped01P1CHAVE.AsString) and (pconsemp=false)) then
            begin
            if not cb_ListaParc.Checked then
              begin
              FPedEmiteNf(0,3,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,1,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,iif(CB_MODORCAM.Checked,1,0),0); // lista de separacao
              end
            else
              begin
              while not Qr_Ped01.Eof do
                begin
                FPedEmiteNf(0,3,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,0,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,iif(CB_MODORCAM.Checked,1,0),0); // lista de separacao
                Qr_Ped01.Next;
                end;
              end;
            if DM1.Tb_PargerPLSEPMOD02.AsInteger=1 then
               FPedEmiteNf(0,5,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,1,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,iif(CB_MODORCAM.Checked,1,0),0); // lista de separacao
            end;
         mcodant:=Qr_Ped01P1CHAVE.AsString;
         mcodeant:=Qr_Ped01P1CODEMP.AsString;
         end;
      mnivel:=1;
      end;
   if mnivel=1 then
      begin
      DM1.Query1.Close;
      DM1.Query1.SQl.clear;
      DM1.Query1.Sql.add('Update CADP01 set P1STATUS='+iif(Qr_Ped01P1TIPO.AsInteger=0,'0','1')
                        +iif(mpd_ptipop=9,', P1EMIDOC=1, P1DATDOC=:DATDOC','')
                        +' where '
                        +'(P1CODEMP=0'+IntToStr(codemp)+' or P1CODEMP=0'+IntToStr(iif(codemp>100,codemp-100,codemp+100))+' )'
                        +' and P1LOTSEQ=0'+Qr_Ped01P1LOTSEQ.AsString
                        +' and P1CHAVE=0'+Qr_Ped01P1CHAVE.AsString
                        +' and P1STATUS=0');
      if mpd_ptipop=9 then
         DM1.Query1.ParambyName('DATDOC').AsDate := NOW;

      Try
         DM1.Query1.ExecSQL;
         fdm1StartCommit;
      except
         ex_erroSql(01,8291,'Frm_Ped_02','CADP01');
         end;
      end
   else
      begin
      DM1.Query1.Close;
      DM1.Query1.SQl.clear;
      DM1.Query1.Sql.add('Update CADP01 set P1STATUS='+iif(Qr_Ped01P1TIPO.AsInteger=0,'0','1')
                        +iif(mpd_ptipop=9,', P1EMIDOC=1, P1DATDOC=:DATDOC','')
                        +' where P1CODEMP=0'+Qr_Ped01P1CODEMP.AsString
                        +' and P1LOTSEQ=0'+Qr_Ped01P1LOTSEQ.AsString
                        +' and P1CHAVE=0'+Qr_Ped01P1CHAVE.AsString
                        +' and P1ORDEM=0'+Qr_Ped01P1ORDEM.AsString
                        +' and P1STATUS=0');
      if mpd_ptipop=9 then
         DM1.Query1.ParambyName('DATDOC').AsDate := NOW;
      Try
         DM1.Query1.ExecSQL;
         fdm1StartCommit;
      except
         ex_erroSql(01,8307,'Frm_Ped_02','CADP01');
         end;
      end;
   DM1.Query1.Close;
   Qr_Ped01.Next;
   end;

if not CB_IMPNAOLIMPA.Checked then
  btn_cancelar.Click;

