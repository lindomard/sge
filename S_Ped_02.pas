procedure TFrm_Ped_02.edt_codvendedorEnter(Sender: TObject);
begin
   mfocusman := True;
   Ant_Float:=ValFloat(edt_codvendedor.Text);
end;

procedure TFrm_Ped_02.edt_codvendedorExit(Sender: TObject);
begin

edt_codvendedor.text := fdeixanum2(edt_codvendedor.Text);
if (btn_cancelar.Focused) or (btn_sair.Focused) and (ant_float<>0) then
   edt_codvendedor.Text:=FloatToStr(ant_float);

if Trim(edt_codvendedor.Text) = '' then
   exit;

if not flcadven(1,0,edt_codvendedor.Text) then
   begin
   if (Panel_cabecalho.Focused) or  (btn_cancelar.Focused) then
      edt_codvendedor.Text := ''
   else
      begin
      verteclado(0);
      fMensagem('Vendedor não Cadastrado!',0,['0'],0);
      edt_codvendedor.Text := '';
      edt_codvendedor.SetFocus;
      end;
   end
else
   begin
   edt_nomevendedor.Text := DM1.Tb_VenVNOME.Value;
   mPed_Ven_PCOMV01      := DM1.Tb_VenVCOMIS.AsFloat;
   mPed_Ven_CodRegiao    := DM1.Tb_VenVCODREG.AsFloat;
   if trim(edt_nomevendedor.Text) <> '' then
      begin
      fpd_CarregaPlanoVendas(0);
      end;
   if (not mpd_RestaurandoPedido) and (mAceita_pergunta) then
      begin
      if (DM1.Tb_PargerPVENDCLI.AsInteger = 1) and (fsonumero(edt_codvendedor.Text) > 0) then
         begin
         if (ValInt(edt_codvendedor.Text) <> DM1.Tb_CliCCODVEN.Value) and (ValInt(edt_codvendedor.Text) <> DM1.Tb_CliCCODV02.Value) and
            (ValInt(edt_codvendedor.Text) <> DM1.Tb_CliCCODV03.Value) and (ValInt(edt_codvendedor.Text) <> DM1.Tb_CliCCODV04.Value) then
            begin
            flcadpar02(0,0,CodUsr,IntToStr(35));
            if DM4.Tb_Par02PA2PDSN.Value = 'S' then
               begin
               if fValidaSenha(0,codusr,35,0,DM1.Tb_CliCCODCLI.Value,0,0,0, 'Senha para Confirmar a alteração do Codigo do Vendedor','') <> 0 then
                  begin
                  fMensagem('Alteração não Aceita!',0,['0'],0);
                  edt_codvendedor.Text := DM1.Tb_CliCCODVEN.AsString;
                  edt_codvendedor.SetFocus;
                  exit;
                  end;
                end
             else
                begin
                mcinst4 := DM1.Tb_CliCCODVEN.AsString;
                if DM1.Tb_CliCCODV02.AsInteger > 0 then
                   mcinst4 := mcinst4+'/'+DM1.Tb_CliCCODV02.AsString;
                 if DM1.Tb_CliCCODV03.AsInteger > 0 then
                    mcinst4 := mcinst4+'/'+DM1.Tb_CliCCODV03.AsString;
                 if DM1.Tb_CliCCODV04.AsInteger > 0 then
                    mcinst4 := mcinst4+'/'+DM1.Tb_CliCCODV04.AsString;
                 fMensagem('Vendedor nao vinculado a Este Cliente. Vendedor(es) Vinculado(s): '+mcinst4,0,['0'],0);
                 end;
              end;
           end
        else
           begin
           if (Ant_Float <> 0) and (Ant_Float <> ValFloat(edt_codvendedor.Text)) then
              begin
              if fValidaSenha(0,codusr,35,0,DM1.Tb_CliCCODCLI.Value,0,0,0, 'Senha para Confirmar a alteração do Codigo do Vendedor','') <> 0 then
                 begin
                 verteclado(0);
                 fMensagem('Alteração não Aceita!',0,['0'],0);
                 edt_codvendedor.Text:=FloatToStr(Ant_Float);
                 edt_codvendedor.SetFocus;
                 exit;
                 end;
              verteclado(0);
              if (not QryItem_Nota.IsEmpty) and (mpd_ptipop < 2) then
                 begin
                 if DM1.Tb_PargerPRECALCPEDMAN.AsInteger <> 1 then
                    fMensagem('O Pedido poderá ter seus valores alterados',0,['0'],0);
                 if DM1.Tb_PargerPRECALCPEDMAN.AsInteger<>1 then
                    fped01reatribuir(0);
                 end;
              Ant_Float:=ValFloat(edt_codvendedor.Text);
             end;
         end;
      end;
   end;
end;

