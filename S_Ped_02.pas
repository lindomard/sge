function tFrm_Ped_02.fTotalizarFormas(pTipo: Integer): Boolean;
var
mPosReg: TBookmark;
begin

mTotal_fp           :=0;
mPrazoFp            :=0;
mPesoFP             :=0;
FPPRAZOMED.Caption:= '0';
mFPag_Seq           :=0;
FPTOTLIQ.Caption:=FormatFloat(mcasas, mTotal_fp);
FPRESTANTE.Caption:=FormatFloat(mcasas, ValFloat(st_totliquido.Caption)-mTotal_fp);
if (not mem_cadpfp.Active) or (mem_cadpfp.IsEmpty) then
   begin
   result:=true;
   exit;
   end;
mPosReg        :=mem_cadpfp.GetBookmark;
mem_cadpfp.First;
While not mem_cadpfp.Eof do
   begin
   mTotal_fp:=mTotal_fp+mem_cadpfpPFPVALOR.Value;
   if (mem_cadpfpPFPDATA.IsNull) or (trim(edt_datapedido.Text)='/  /') then
      mPrazoFp:=1
   else
      mPrazoFp:=mem_cadpfpPFPDATA.AsDateTime-StrtoDate(edt_datapedido.Text);
   if mPrazoFp<1 then
      mPrazoFp:=1;
   mPesoFP:=mPesoFP+(mem_cadpfpPFPVALOR.AsFloat*mPrazoFp);
   mFPag_Seq           := mFPag_Seq+1;
   mem_cadpfp.Next;
   end;
if (mPesoFP<>0) and (mtotal_fp<>0) then
   begin
   try
      FPPRAZOMED.Caption:= FloatTostr( round( mPesoFP/mTotal_fp));
   except
      FPPRAZOMED.Caption:= '0';
      end;
   end
else
   FPPRAZOMED.Caption:= '0';
FPTOTLIQ.Caption:=FormatFloat(mcasas, mTotal_fp);
FPRESTANTE.Caption:=FormatFloat(mcasas, ValFloat(st_totliquido.Caption)-mTotal_fp);
mem_cadpfp.GotoBookmark(mPosReg);
result:=true;
end;

