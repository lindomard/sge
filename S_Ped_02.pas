function tFrm_Ped_02.fRetornaEstoque(pTipo: Integer;pCodPro,pGrade,pDtVcto: String;
                         pSaiNor,pSaiCons,pSaiTerc,pSaiRVenda: Boolean): TArrayEstoque;
{
  pTipo = 0 Testa Somente pelo codigo do produto
  pTipo = 1 Testa Pelo Codigo, lote/grade e Data de Vecimento
  pTipo = 2 Testa Pelo Codigo e o Lote/Grade


}

var
mRetorno: TArrayEstoque;

begin
mRetorno[0]:=0;
mRetorno[1]:=0;
mRetorno[2]:=0;

if ptipo=1 then // se for verificacao completa
   begin
   DM1.Query1.Close;
   DM1.Query1.Sql.clear;
   DM1.Query1.Sql.add('Select CLQTD,CLQTDC,CLQTDT,CLQTDR,CLQTD_PRAT,CLQTD_REP,CLQTD_DEP from CADLGC where '
                     +IIF(DM1.Qr_Tid.Locate('TINOME','CADEST',[]),'',' CLCODEMP=0'+IntToStr(codemp)+' and ')
                     +' CLCODPRO=0'+pCodPro);
   if (Trim(pGrade)='')  then
      DM1.Query1.Sql.add(' and (CLNUMERO is null or CLNUMERO='+chr(39)+' '+chr(39)+')')
    else
      DM1.Query1.Sql.add(' and CLNUMERO='+chr(39)+pGrade+chr(39));
   if (Trim(pDtVcto)='') or (trim(pDtVcto)='/  /') then
      DM1.Query1.SQL.add(' and (CLDTVCTO is null or CLDTVCTO<='+chr(39)+FormatDateTime(fdt, pdatanula)+chr(39)+')')
   else
      DM1.Query1.Sql.add(' and CLDTVCTO='+chr(39)+pDtVcto+chr(39));
   DM1.Query1.sql.Add(' order by CLCODPRO,CLDTVCTO,CLNUMERO');
   try
      DM1.Query1.Open;
   except
      DM1.Query1.sql.savetofile('c:\sql.txt');
      end;
   if not DM1.Query1.IsEmpty then
      begin
      if pSaiNor then
          begin
          mRetorno[0] :=DM1.Query1.FieldbyName('CLQTD').AsFloat;
          mRetorno[1] :=DM1.Query1.FieldbyName('CLQTD_PRAT').AsFloat;
          mRetorno[2] :=DM1.Query1.FieldbyName('CLQTD_DEP').AsFloat;
          end
       else if pSaiCons then
          mRetorno[0] :=DM1.Query1.FieldbyName('CLQTDC').AsFloat
       else if pSaiTerc then
          mRetorno[0] :=DM1.Query1.FieldbyName('CLQTDT').AsFloat
       else if pSaiRVenda then
          mRetorno[0] :=DM1.Query1.FieldbyName('CLQTDR').AsFloat;
       end;
    end
else if ptipo=2 then // se for verificacao apenas do codigo e do lote/grade
   begin
   DM1.Query1.Close;
   DM1.Query1.Sql.clear;
   DM1.Query1.Sql.add('Select CLQTD,CLQTDC,CLQTDT,CLQTDR,CLQTD_PRAT,CLQTD_REP,CLQTD_DEP from CADLGC where '
                     +IIF(DM1.Qr_Tid.Locate('TINOME','CADEST',[]),'',' CLCODEMP=0'+IntToStr(codemp)+' and ')
                     +' CLCODPRO=0'+pCodPro);
   if (Trim(pGrade)='')  then
      DM1.Query1.Sql.add(' and (CLNUMERO is null or CLNUMERO='+chr(39)+' '+chr(39)+')')
   else
      DM1.Query1.Sql.add(' and CLNUMERO='+chr(39)+pGrade+chr(39));
   DM1.Query1.sql.Add(' order by CLCODPRO,CLDTVCTO,CLNUMERO');
   try
      DM1.Query1.Open;
   except
      DM1.Query1.sql.savetofile('c:\sql.txt');
      end;
   if not DM1.Query1.IsEmpty then
       begin
       if pSaiNor then
          begin
          mRetorno[0] :=DM1.Query1.FieldbyName('CLQTD').AsFloat;
          mRetorno[1] :=DM1.Query1.FieldbyName('CLQTD_PRAT').AsFloat;
          mRetorno[2] :=DM1.Query1.FieldbyName('CLQTD_DEP').AsFloat;
          end
       else if pSaiCons then
          mRetorno[0] :=DM1.Query1.FieldbyName('CLQTDC').AsFloat
       else if pSaiTerc then
          mRetorno[0] :=DM1.Query1.FieldbyName('CLQTDT').AsFloat
       else if pSaiRVenda then
          mRetorno[0] :=DM1.Query1.FieldbyName('CLQTDR').AsFloat;
       end;
    end
else if ptipo=0 then // se for verificacao apenas pelo codigo
   begin
   if flcadest(0,0,0,pCodPro) then
      begin
      if pSaiNor then
         begin
         mRetorno[0] :=DM1.Tb_EstCESALDO.AsFloat;
         mRetorno[1] :=DM1.Tb_EstCESALDO_PRAT.AsFloat;
         mRetorno[2]:=DM1.Tb_EstCESALDO_DEP.AsFloat;
         end
      else if pSaiCons then
         mRetorno[0] :=DM1.Tb_EstCESALDOC.AsFloat
      else if pSaiTerc then
         mRetorno[0] :=DM1.Tb_EstCESALDOT.AsFloat
      else if pSaiRVenda then
         mRetorno[0] :=DM1.Tb_EstCESALDOR.AsFloat;
      end;
   end;
mRetorno[0] :=Arredonda(mretorno[0],DM1.Tb_PargerPCASQTD.Asinteger);
mRetorno[1] :=Arredonda(mretorno[1],DM1.Tb_PargerPCASQTD.Asinteger);
mRetorno[2] :=Arredonda(mretorno[2],DM1.Tb_PargerPCASQTD.Asinteger);


result:=mRetorno;
end;

