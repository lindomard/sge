                                    (Valfloat(edt_valorDesconto.Text)-(mPd_TotDescRat_101+mPd_TotDescRat));
         mpds_totBcIssqn_101  :=mpds_totBcIssqn_101+QryItem_NotaP2BASEN_101.AsFloat-(Valfloat(edt_valorDesconto.Text)-(mPd_TotDescRat_101+mPd_TotDescRat));
         if QryServico_Nota.FieldByName('P2SALIQ_101').AsFloat>0 then
            begin
            mRestoRateio_Issqn:=Arredonda( (((Valfloat(edt_valorDesconto.Text)-(mPd_TotDescRat_101+mPd_TotDescRat))
                             * QryServico_Nota.FieldByName('P2SALIQ_101').AsFloat)/100) , 2);
            QryServico_Nota.FieldByName('P2SVISSQN_101').AsFloat:=QryServico_Nota.FieldByName('P2SVISSQN_101').AsFloat-mRestoRateio_Issqn;
            mpds_totIssqn_101    :=mpds_totIssqn_101-mRestoRateio_Issqn;
            end;
         end;
      QryServico_Nota.FieldByName('P2STOTDES_101').AsFloat       :=QryServico_Nota.FieldByName('P2STOTDES_101').AsFloat
                                                          +(Valfloat(edt_valorDesconto.Text)-(mPd_TotDescRat_101+mPd_TotDescRat));
      QryServico_Nota.FieldByName('P2SDESCRAT_101').AsFloat      :=QryServico_Nota.FieldByName('P2SDESCRAT_101').AsFloat+
                                                         (Valfloat(edt_valorDesconto.Text)-(mPd_TotDescRat_101+mPd_TotDescRat));
      mPd_TotDescRat_101 := Arredonda(mPd_TotDescRat_101 + (Valfloat(edt_valorDesconto.Text)-(mPd_TotDescRat_101+mPd_TotDescRat)), DM1.Tb_PargerPCASAS.Asinteger);
      end;
   QryServico_Nota.Post;
   end;

