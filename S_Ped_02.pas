   begin
   if (mPed0_CliConsFin= 1) or (DM1.Tb_CliCREVENDA_CP.AsInteger = 1) then
      begin
      if trim(DM6.Tb_CLFISCAL_UFCFCST_CF.AsString) <> '' then
         mcinst2 := DM6.Tb_CLFISCAL_UFCFCST_CF.Value
      else
         mcinst2 := DM6.Tb_CLFISCAL_UFCFCST_RV.Value;
      end
   else
      mcinst2   := DM6.Tb_CLFISCAL_UFCFCST_RV.Value;
   end
else
   begin
   if (mPed0_CliConsFin = 1) or (DM1.Tb_CliCREVENDA_CP.AsInteger = 1) then
      begin
      if mPed_Cli_UF=DM1.Tb_EmpUF.AsString then
        begin
        mcinst2   := DM1.Tb_ProPDFIS_ORIGEM.Value+DM1.Tb_ProPDFIS_CST_ICMS_EST_CF.AsString;
        mcinst3   := DM1.Tb_ProPDFIS_CSOSN_EST_CF.AsString;
        end
      else
        begin
        mcinst2   := DM1.Tb_ProPDFIS_ORIGEM.Value+DM1.Tb_ProPDFIS_CST_ICMS_INT_CF.AsString;
        mcinst3   := DM1.Tb_ProPDFIS_CSOSN_INT_CF.AsString;
        end;
      end
   else
      begin
      if mPed_Cli_UF=DM1.Tb_EmpUF.AsString then
        begin
        mcinst2   := DM1.Tb_ProPDFIS_ORIGEM.Value+DM1.Tb_ProPDFIS_CST_ICMS_EST_REV.AsString;
        mcinst3   := DM1.Tb_ProPDFIS_CSOSN_EST_REV.AsString;
        end
      else
        begin
        mcinst2   := DM1.Tb_ProPDFIS_ORIGEM.Value+DM1.Tb_ProPDFIS_CST_ICMS_INT_REV.AsString;
        mcinst3   := DM1.Tb_ProPDFIS_CSOSN_INT_REV.AsString;
        end;
      end;
   end;
if (mPed0_CliMotDes>0) and (DM1.Tb_ProPDDESICMS.AsInteger=1) and (DM1.Tb_EmpEMP_OPTSIMPLES.AsInteger=3)then
  mcinst2:='040';


if (mcinst3='202') and (mPed1_CliSMICR=3) then
  mcinst3:='201';

mcinst2:=FormatFloat('000',valint(mcinst2));
if (mcinst2[2]='2') and (mPed0_CliREDICMSNOR<>0) then
  mcinst2:=mcinst2[1]+'0'+mcinst2[3];

//if (mcinst2[2] in ['1','6','7']) and (mPed0_CalcICMSR<>true) then
//  mcinst2:=mcinst2[1]+'0'+mcinst2[3];

//if (mcinst3[1] in ['2','5','9']) and (mPed0_CalcICMSR<>true) then
//  mcinst3:='102';

if (DM1.Tb_PargerPINDUSTRIA.AsInteger>0) and (cb_ConsProprio.Visible=False) then
  begin
  if (DM1.Tb_ProPDNIVEL.AsInteger=1) or (DM1.Tb_ProPDNIVEL.AsInteger=0) then
    cb_ConsProprio.Checked:=True
  else
    cb_ConsProprio.Checked:=False;
  end;

if (mcinst2[2] in ['1','6','7']) or (mcinst3[1] in ['2','5','9']) then
  begin
  if cb_ConsProprio.Checked=false then
    begin
    mRet0_CFOP        :=mPed0_Cfo_Ret_rev;
    mRet1_CFOP        :=mPed1_Cfo_Ret_rev;
    end
  else
    begin
    mRet0_CFOP        :=mPed0_Cfo_Ret_Indus;
    mRet1_CFOP        :=mPed1_Cfo_Ret_Indus;
    end;
  mRet0_CFOP_SUBECF :=mPed0_Cfo_SubEcf_Ret;
  mRet0_CFOP_Servico:=mPed0_Cfo_Servico;
  mRet1_CFOP_SUBECF :=mPed1_Cfo_SubEcf_Ret;
  mRet1_CFOP_Servico:=mPed1_Cfo_Servico;
  end
else if (mcinst2[2]='4') and (mcinst3='400') then
  begin
  if cb_ConsProprio.Checked=false then
    begin
    mRet0_CFOP        :=mPed0_Cfo_Isento_rev;
    mRet1_CFOP        :=mPed1_Cfo_Isento_rev;
    end
  else
    begin
    mRet0_CFOP        :=mPed0_Cfo_Isento_Indus;
    mRet1_CFOP        :=mPed1_Cfo_Isento_Indus;
    end;
  mRet0_CFOP_SUBECF :=mPed0_Cfo_SubEcf_Isento;
  mRet0_CFOP_Servico:=mPed0_Cfo_Servico;
  mRet1_CFOP_SUBECF :=mPed1_Cfo_SubEcf_Isento;
  mRet1_CFOP_Servico:=mPed1_Cfo_Servico;
  end
else
  begin
  if cb_ConsProprio.Checked=false then
    begin
    mRet0_CFOP        :=mPed0_Cfo_Trib_rev;
    mRet1_CFOP        :=mPed1_Cfo_Trib_rev;
    end
  else
    begin
    mRet0_CFOP        :=mPed0_Cfo_Trib_Indus;
    mRet1_CFOP        :=mPed1_Cfo_Trib_Indus;
    end;
  mRet0_CFOP_SUBECF :=mPed0_Cfo_SubEcf_Trib;
  mRet0_CFOP_Servico:=mPed1_Cfo_Servico;
  mRet1_CFOP_SUBECF :=mPed1_Cfo_SubEcf_Trib;
  mRet1_CFOP_Servico:=mPed1_Cfo_Servico;
  end;
edt_cfop.Text:=FloatToStr(mRet0_CFOP);
end;

