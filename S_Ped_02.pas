                  +'       ,PFPDEV_NUMERO '
                  +'       ,PFPDEV_DESD '
                  +'       ,PFPDEV_DUP '
                  +'       ,PFPDEV_DTEMIS '
                  +'       ,PFPPRAZO '
                  +'       ,PFPDUPLIC '

                  +' ) values ('
                  +' :PFPCODEMP '
                  +' ,:PFPLOTSEQ '
                  +' ,:PFPCHAVE '
                  +' ,:PFPORDEM '
                  +' ,:PFPSEQ '
                  +' ,:PFPVINCULO '
                  +' ,:PFPFORMA '
                  +' ,:PFPNOMFOR '
                  +' ,:PFPDATA '
                  +' ,:PFPNUMDOC '
                  +' ,:PFPBANCO '
                  +' ,:PFPSERIE '
                  +' ,:PFPVALOR '
                  +' ,:PFPCC '
                  +' ,:PFPCOMP '
                  +' ,:PFPAGENCIA '
                  +' ,:PFPEMITENTE'
                  +' ,:PFPCNPF'
                  +' ,:PFPRG'
                  +' ,:PFPDTNAS '
                  +' ,:PFPFPGTO '
                  +'       ,:PFPDEV_CODEMP '
                  +'       ,:PFPDEV_CODECF '
                  +'       ,:PFPDEV_NUMERO '
                  +'       ,:PFPDEV_DESD '
                  +'       ,:PFPDEV_DUP '
                  +'       ,:PFPDEV_DTEMIS '
                  +'       ,:PFPPRAZO '
                  +'       ,:PFPDUPLIC '
                  +') ');
if not mem_cadpfp.Active then
   begin
   mem_cadpfp.Close;
   mem_cadpfp.Open;;
   end;

if mPed_SubMod=0 then
  begin
  mem_cadpfp.First;
  while not mem_cadpfp.Eof do
    begin
    mValor_Total:=mValor_Total+mem_cadpfpPFPVALOR.AsFloat;
    mem_cadpfp.Next;
    end;
  mDeduc:=(mValor_Total-pValorPed)/mem_cadpfp.RecordCount;
  end
else
  begin
  mem_cadpfp.Last;
  end;

y:=0;

While not mem_cadpfp.Bof do
   begin
   y:=y+1;
   DM1.Query2.ParamByName('PFPCODEMP').AsFloat:=pcodemp;
   DM1.Query2.ParamByName('PFPLOTSEQ').AsFloat:=mPd_LotSeq;
   DM1.Query2.ParamByName('PFPCHAVE').AsFloat :=mpd_chave;
   DM1.Query2.ParamByName('PFPORDEM').AsFloat :=mpd_ordem;
   DM1.Query2.ParamByName('PFPSEQ').AsFloat   :=y;
   DM1.Query2.ParamByName('PFPVINCULO').AsFloat :=mem_cadpfpPFPVINCULO.Value;
   DM1.Query2.ParamByName('PFPFORMA').AsFloat :=mem_cadpfpPFPFORMA.Value;
   DM1.Query2.ParamByName('PFPNOMFOR').AsString:=mem_cadpfpPFPNOMFOR.Value;
   if mem_cadpfpPFPDATA.IsNull then
      DM1.Query2.ParamByName('PFPDATA').AsDateTime :=pdatanula
   else
      DM1.Query2.ParamByName('PFPDATA').AsDateTime :=mem_cadpfpPFPDATA.Value;
   DM1.Query2.ParamByName('PFPNUMDOC').AsString    :=mem_cadpfpPFPNUMDOC.Value;
   DM1.Query2.ParamByName('PFPBANCO').AsFloat      :=mem_cadpfpPFPBANCO.Value;
   DM1.Query2.ParamByName('PFPSERIE').AsString     :=mem_cadpfpPFPSERIE.Value;
   flqr1('P1SUBMOD','P1','CADP01','N','P1CHAVE',DM1.Query2.ParamByName('PFPCHAVE').AsString);
   edt_submod.Text:=FormatFloat('000',StrTofloat('0'+PalNum_Sis(Qr_Ped01P1SUBMOD.Value)));
{
LINDOMAR RETIROU DEPOIS VER COM O LUIZ FERNANDO
   if (pcodemp>100) and (codemp<100) then
     edt_submod.Text:='100';
   if (pcodemp<100) and (codemp>100) then
     edt_submod.Text:='100';
   if (pcodemp>100) and (codemp>100) then
     edt_submod.Text:='100';
}
//   DM1.Query2.ParamByName('PFPVALOR').AsFloat      :=iif(pCodemp>100,ValFloat(edt_submod.Text)/100*mem_cadpfpPFPVALOR.Value,(100-ValFloat(edt_submod.Text))/100*mem_cadpfpPFPVALOR.Value);
// VER COM O LUIZ FERNANDO PQ ALTEROU
   DM1.Query2.ParamByName('PFPCC').AsString        :=mem_cadpfpPFPCC.Value;
   DM1.Query2.ParamByName('PFPCOMP').AsString      :=mem_cadpfpPFPCOMP.Value;
   DM1.Query2.ParamByName('PFPAGENCIA').AsString   :=mem_cadpfpPFPAGENCIA.Value;
   DM1.Query2.ParamByName('PFPEMITENTE').AsString  :=mem_cadpfpPFPEMITENTE.Value;
   DM1.Query2.ParamByName('PFPCNPF').AsFloat       :=mem_cadpfpPFPCNPF.AsFloat;
   DM1.Query2.ParamByName('PFPRG').AsString        :=mem_cadpfpPFPRG.Value;
   if mem_cadpfpPFPDTNAS.IsNull then
      DM1.Query2.ParamByName('PFPDTNAS').AsDateTime :=pdatanula
   else
      DM1.Query2.ParamByName('PFPDTNAS').AsDateTime :=mem_cadpfpPFPDTNAS.Value;
   DM1.Query2.ParamByName('PFPFPGTO').AsFloat       :=mem_cadpfpPFPFPGTO.Value;
   DM1.Query2.ParamByName('PFPDEV_CODEMP').AsFloat       :=mem_cadpfpPFPDEV_CODEMP.AsFloat;
   DM1.Query2.ParamByName('PFPDEV_CODECF').AsFloat       :=mem_cadpfpPFPDEV_CODECF.AsFloat;
   DM1.Query2.ParamByName('PFPDEV_NUMERO').AsFloat       :=mem_cadpfpPFPDEV_NUMERO.AsFloat;
   DM1.Query2.ParamByName('PFPDEV_DESD').AsString        :=mem_cadpfpPFPDEV_DESD.AsString;
   DM1.Query2.ParamByName('PFPDEV_DUP').AsFloat          :=mem_cadpfpPFPDEV_DUP.AsFloat;
   DM1.Query2.ParamByName('PFPDEV_DTEMIS').AsDateTime    :=mem_cadpfpPFPDEV_DTEMIS.AsFloat;
   DM1.Query2.ParamByName('PFPPRAZO').AsFloat            :=mem_cadpfpPFPPRAZO.AsFloat;

   mValor_FPgto:=mem_cadpfpPFPVALOR.AsFloat;
   if (mPed_SubMod>0) and (mPed_SubMod<100) then
      begin
      mValor_FPgto:=Arredonda((mem_cadpfpPFPVALOR.AsFloat*mPed_SubMod/100),DM1.Tb_PargerPCASAS.AsInteger);
      if pcodemp=codemp then
         mValor_FPgto:=Arredonda(mem_cadpfpPFPVALOR.AsFloat-mValor_FPgto,2);//+0.02;
//         mValor_FPgto:=ValFloat(FormatFloat(mcasaspu,mem_cadpfpPFPVALOR.AsFloat-mValor_FPgto));
      if mValor_FPgto>mValor_Falta then
         mValor_FPgto:=mValor_Falta;
      mValor_Falta:=mValor_Falta-mValor_FPgto;
      if mem_cadpfp.RecNo=1 then
        mValor_FPgto:=mValor_Falta+mValor_FPgto;
      end;
//   mValor_FPgto:=mem_cadpfpPFPVALOR.AsFloat-mValor_FPgto;
//   mValor_FPgto:=mem_cadpfpPFPVALOR.AsFloat-mValor_FPgto;
   DM1.Query2.ParamByName('PFPDUPLIC').AsFloat           :=mValor_FPgto-mDeduc;
   DM1.Query2.ParamByName('PFPVALOR').AsFloat            :=mValor_FPgto-mDeduc;
   try
      DM1.Query2.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql(02,18659,'frm_Ped_02','CADPFP');
      end;
   mem_cadpfp.Prior;
   end;
mPd_Gravou_Fpgto:=true;
result:=True;
end;

function tFrm_Ped_02.fPed01EmiteOnLine(pTipo: Integer;pAceitaConfirmacao:Boolean): Boolean;
var
mEmitiu_Out: Boolean;

emitiu: Boolean;
MNUMNF: Real;
mdupacum: String;
mcomp: String;
mcodemp: Integer;
mannf_aceito: Boolean;
mNivel: Integer;
mTotserv: Real;
pSerieNF,pModNF: string;

begin
mTotserv:=0;

Qr_Ped01.First;
mpd_chave_ant:=0;
While not Qr_Ped01.eof do
   begin
   mEmitiu_Out:=False;
   mnivel:=0;
   emitiu:=True;
   mcomp:='';
   mdupacum:='';
   mcodemp:=Qr_Ped01P1CODEMP.AsInteger;

   flcadpar01(0,Qr_Ped01P1CODEMP.AsInteger,'1');
   if (mpd_ptipop=0) or (mpd_ptipop=10)  then // orcamento
      begin
      if DM4.Tb_Par01PONLINE_ORC.Value=1 then
         begin
         if (DM4.Tb_Par01PONLINE_ORC_CONF.AsInteger=1) then
            begin
            if fmensagem('Confirma a emissao do Orcamento?',0,['1','2'],1)=mrYes  then
               begin
               FPedEmiteNf(0,2,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,1,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,0,0); // orcamento
               mEmitiu_Out:=true;
               end
            else
               break;
            end
         else
            begin
            FPedEmiteNf(pTipo,2,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1CODEMP.AsInteger,1,Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,0,0); // orcamento
            mEmitiu_Out:=true;
            end;
         end;
      end
   else if mpd_ptipop=9 then  // emprestimo de mercadorias (vale)
      begin
      if DM4.Tb_Par01PONLINE_VAL.Value=1 then
         begin
         if (DM4.Tb_Par01PONLINE_VAL_CONF.AsInteger=1) and (pAceitaConfirmacao) then
            begin
            if fmensagem('Confirma a emissao do vale de mercadorias?',0,['1','2'],1)=mrYes  then
               begin
               FPedEmiteNf(pTipo,4,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,
               Qr_Ped01P1ORDEM.AsInteger,
               Qr_Ped01P1CODEMP.AsInteger,0,
               Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,0,0); // lista emprestimo de mercadorias (Vale)
               if DM1.Tb_PargerPSTATUS_LSEP09.AsInteger>0 then
                  mnivel:=1;

               mEmitiu_Out:=true;
               end
            else
               break;
            end
         else
            begin
            FPedEmiteNf(pTipo,4,0,Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,
            Qr_Ped01P1ORDEM.AsInteger,
            Qr_Ped01P1CODEMP.AsInteger,0,
            Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,0,0); // lista emprestimo de mercadorias (Vale)
            mEmitiu_Out:=true;
            end;
         end;
      end
   else // lista de separacao
      begin
      if DM4.Tb_Par01PONLINE_LSEP.Value=1 then
         begin
         if mpd_chave_ant<>Qr_Ped01P1CHAVE.Value then
            begin
            if (DM4.Tb_Par01PONLINE_LSEP_CONF.AsInteger=1) and (pAceitaConfirmacao) then
               begin
               if fmensagem('Confirma a emissao da lista de separacao?',0,['1','2'],1)=mrYes  then
                  begin
                  if mlib_bloqPend=2 then
                     begin
                     fmensagemSom('Pedido com bloqueios pendentes!',0,['0'],0);
                     break;
                     end;
                  FPedEmiteNf(pTipo,3,0,Qr_Ped01P1LOTSEQ.AsInteger,
                  Qr_Ped01P1CHAVE.AsInteger,
                  Qr_Ped01P1ORDEM.AsInteger,
                  Qr_Ped01P1CODEMP.AsInteger,1,
                  Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,0,0); // lista de separacao
                  mpd_chave_ant:=Qr_Ped01P1CHAVE.Value;
                  mnivel:=1;
                  mEmitiu_Out:=true;
                  end
               else
                  break;
               end
            else
               begin
               FPedEmiteNf(pTipo,3,0,Qr_Ped01P1LOTSEQ.AsInteger,
               Qr_Ped01P1CHAVE.AsInteger,
               Qr_Ped01P1ORDEM.AsInteger,
               Qr_Ped01P1CODEMP.AsInteger,1,
               Qr_Ped01P1FORMACE.AsInteger,false,false,true,1,0,0); // lista de separacao
               mpd_chave_ant:=Qr_Ped01P1CHAVE.Value;
               mnivel:=1;
               mEmitiu_Out:=true;
               end;
            end;
         end;
      end;
   if mEmitiu_Out then
      begin
      if mnivel=1 then
         begin
         DM1.Query1.Close;
         DM1.Query1.SQl.clear;
         DM1.Query1.Sql.add('Update CADP01 set P1STATUS=1 '
                           +iif(mpd_ptipop=9,', P1EMIDOC=1, P1DATDOC=:DATDOC','')
                           +' where '
                           +'(P1CODEMP=0'+IntToStr(codemp)+' or P1CODEMP=0'+IntToStr(iif(codemp>100,codemp-100,codemp+100))+' )'
                           +' and P1LOTSEQ=0'+Qr_Ped01P1LOTSEQ.AsString
                           +' and P1CHAVE=0'+Qr_Ped01P1CHAVE.AsString
                           +' and P1STATUS=0');
         if mpd_ptipop=9 then
            DM1.Query1.ParambyName('DATDOC').AsDate := NOW;
         Try
            DM1.Query1.ExecSQL;
            fdm1StartCommit;
         except
            ex_erroSql(01,8291,'Frm_Ped_02','CADP01');
            end;
         DM1.Query1.Close;
         end
      else
         begin
         DM1.Query1.Close;
         DM1.Query1.SQl.clear;
         DM1.Query1.Sql.add('Update CADP01 set P1STATUS=1 '
                           +iif(mpd_ptipop=9,', P1EMIDOC=1, P1DATDOC=:DATDOC','')
                           +' where P1CODEMP=0'+Qr_Ped01P1CODEMP.AsString
                           +' and P1LOTSEQ=0'+Qr_Ped01P1LOTSEQ.AsString
                           +' and P1CHAVE=0'+Qr_Ped01P1CHAVE.AsString
                           +' and P1ORDEM=0'+Qr_Ped01P1ORDEM.AsString
                           +' and P1STATUS=0');
         if mpd_ptipop=9 then
            DM1.Query1.ParambyName('DATDOC').AsDate := NOW;
         Try
            DM1.Query1.ExecSQL;
            fdm1StartCommit;
         except
            ex_erroSql(01,8307,'Frm_Ped_02','CADP01');
            end;
         DM1.Query1.Close;
         end;
      end;
// começou a nota fiscal
   if (Qr_Ped01P1TIPO.Value<>0) and (Qr_Ped01P1STATUS.Value<2) then
      begin
      flcadpar01(0,Qr_Ped01P1CODEMP.AsInteger,'1');
      if DM4.Tb_Par01PONLINE_NF.Value=1 then
         begin
         if (DM4.Tb_Par01PONLINE_VAL_CONF.AsInteger=1) and (pAceitaConfirmacao) then
            begin
            if fmensagem('Confirma a emissao da nota fiscal?',0,['1','2'],1)<>mrYes  then
               begin
               result:=true;
               exit;
               end;
            end;
         if Qr_Ped01P1DATAP.Value<>date then
            begin
            fCarregarPO99(Qr_Ped01P1TABPV.Value,Qr_Ped01P1CODEMP.Value,
                      Qr_Ped01P1LOTSEQ.Value,Qr_Ped01P1CODPV.Value);
            fgvencto(iif(Qr_Ped01P1TABPV.Value='PP',1,0),Qr_Ped01P1CODEMP.AsInteger,
               Qr_Ped01P1LOTSEQ.AsInteger,Qr_Ped01P1CHAVE.AsInteger,
                 Qr_Ped01P1ORDEM.AsInteger,Qr_Ped01P1PRAZO.AsInteger,
                 Qr_Ped01P1CODPV.AsInteger,
                 Qr_Ped01P1PVDDESCF.AsInteger,
                 Qr_Ped01P1PVDIASDESCF.AsInteger,
                 Qr_Ped01P1TOTALL.Value,
                 Qr_Ped01P1COMIS.Value,
                 Qr_Ped01P1COMV02.Value,Qr_Ped01P1COMV03.Value,
                 Qr_Ped01P1COMV04.Value,
                 Qr_Ped01P1COMISS.Value,Qr_Ped01P1COMIST.Value,
                 Qr_Ped01P1SEMCOM.Value,
                 Qr_Ped01P1COMASSE.Value,
                 Qr_Ped01P1ICMSR.Value,
                 Qr_Ped01P1VALFRE.Value+Qr_Ped01P1TOTEXTCOM.Value,
                 Qr_Ped01P1VALSEG.Value,
                 Qr_Ped01P1DESCFIN.Value,
                 Qr_Ped01P1TOTDI01.Value,
                 Qr_Ped01P1TOTDI02.Value,
                 Qr_Ped01P1TOTDI03.Value,
                 Qr_Ped01P1TOTDIVL.Value,
                 Qr_Ped01P1VALDES01.Value,
                 Qr_Ped01P1VALDES02.Value,
                 Qr_Ped01P1VLRDES.Value,
                 Qr_Ped01P1TARBAN.Value,
                 Qr_Ped01P1IPIINA.Value+Qr_Ped01P1IPIPOS.Value+Qr_Ped01P1IPINEG.Value,
                 Qr_Ped01P1TOTCGRU.Value,
                 Qr_Ped01P1TOTSGRU.Value,
                 Qr_Ped01P1TOTSERLIQ.Value,
                 Qr_Ped01P1VALENT.Value,
                 Qr_Ped01P1PRAZO_ENT.Value,
                 Qr_Ped01P1COMIS_EXTRA.Value,
                 mPed_SubMod,
                 date,
                 Qr_Ped01P1TABPV.Value);
            end;
         if flcadp01(0,Qr_Ped01P1CODEMP.AsInteger,Qr_Ped01P1LOTSEQ.AsInteger,
                     Qr_Ped01P1CHAVE.AsString,'') then
            begin
            emitiu:=true;
            mdupacum:='';
            mcomp     :='';
            mTotServ  :=0;
            while not DM1.Tb_Ped01.Eof do
               begin
               if DM1.Tb_Ped01P1STATUS.Value>1 then
                  begin
                  DM1.Tb_Ped01.next;
                  Continue;
                  end;
               emitiu    :=true;

               pSerieNF:='';
               pModNF  :='';
               mnumnf:=fBuscarNUMNF(DM1.Tb_Ped01P1CODEMP.AsInteger,'SERIE'+IntToStr(DM1.Tb_Ped01P1CODSER.AsInteger+1),pSerieNF,pModNF,0);
               DM1.Tb_Ped01.Edit;
               DM1.Tb_Ped01P1NUMNF.Value :=mnumnf;
               DM1.Tb_Ped01P1DATANF.Value:=date;
               DM1.Tb_Ped01P1DATDOC.Value:=now;
               DM1.Tb_Ped01P1SERIE.Value :=pSerieNF;
               DM1.Tb_Ped01P1MODELO.Value:=pModNF;
               DM1.Tb_Ped01P1STATUS.Value:=2;
               DM1.Tb_Ped01P1EMIDOC.Value:=1;
               DM1.Tb_Ped01.Post;


          // inicio


               DM1.Query1.Close;
               DM1.Query1.Sql.Clear;
               DM1.Query1.Sql.add('Select count(*) from CADNS  '
                              +' where NSCODEMP=0'+DM1.Tb_Ped01P1CODEMP.AsString
                              +' and NSLOTSEQ_CP=0'+DM1.Tb_Ped01P1LOTSEQ.AsString
                              +' and NSCHAVEP=0'+DM1.Tb_Ped01P1CHAVE.AsString
                              +' and NSORDEMP=0'+DM1.Tb_Ped01P1ORDEM.AsString);
               DM1.Query1.open;
               if DM1.Query1.fields[0].AsInteger<1 then
                  begin
                  Fgravarnf(0);
                  DM1.Query1.Close;
                  DM1.Query1.Sql.Clear;
                  DM1.Query1.Sql.add('Select count(*) from CADNS  '
                                 +' where NSCODEMP=0'+DM1.Tb_Ped01P1CODEMP.AsString
                                 +' and NSLOTSEQ_CP=0'+DM1.Tb_Ped01P1LOTSEQ.AsString
                                 +' and NSCHAVEP=0'+DM1.Tb_Ped01P1CHAVE.AsString
                                 +' and NSORDEMP=0'+DM1.Tb_Ped01P1ORDEM.AsString);
                  DM1.Query1.open;
                  if DM1.Query1.fields[0].AsInteger<1 then
                     begin
                     fmensagem('Erro 15194 ao Gravar a Nota Fiscal de Saida, informar Suporte da INTERSYS!',
                              0,['0'],0);
                     end;
                  end;

          // termino

                  if DM1.Tb_Ped01P1CHAVE.AsInteger=DM1.Tb_Ped01P1NUMNF.AsInteger then
                    begin
                    if fmensagem(' Numero de Nota Fiscal = Numero do Pedido = '+Qr_Ped01P1CHAVE.AsString,1,['1','2'],1)=mrNo then
                      Exit;
                    end;

               FPedEmiteNf(pTipo,DM1.Tb_Ped01P1CODSER.AsInteger,0,
                             DM1.Tb_Ped01P1LOTSEQ.AsInteger,
                             DM1.Tb_Ped01P1CHAVE.AsInteger,
                             DM1.Tb_Ped01P1ORDEM.AsInteger,
                             DM1.Tb_Ped01P1CODEMP.AsInteger,0,
                             DM1.Tb_Ped01P1FORMACE.AsInteger,false,false,true,1,0,0); // Reemisao de Nota fiscal
               DM1.Tb_Ped01.Next;
               end;
            end;
         DM1.Tb_Ped01.Close;
         end;
      end;
   Qr_Ped01.Next;
   end;
result:=True;
end;


function tFrm_Ped_02.fPed01Div_Qtd(pRestPro,pRestFor,pRestCon,pfracao: Integer; pqtd,pund: Real):Real;
var
mqtdTot: Real;
begin
//LINDOMARQTD
//         else if DM1.Tb_ProPDREST.Value=2 then

if (mped_SubMod=99) then
   begin
   if (pRestCon=1) then
      result:=0
   else
      result:=pqtd;
   end
else
   begin
   if pRestPro=4 then // so pf
      begin
      if codemp>100 then
         begin
         mqtdTot:=0;
         if pund=100 then
            mPd_Qtdblqpro100:=mPd_Qtdblqpro100+1;
         end
      else
         begin
         if pund=0 then
            mPd_Qtdblqpro0:=mPd_Qtdblqpro0+1;
         mqtdTot:=pqtd;
         end
      end
   else if pRestPro=3 then // so menor 99
      begin
      if codemp>100 then
         begin
         mqtdTot:=pqtd;
         if pund=0 then
            mPd_Qtdblqpro0:=mPd_Qtdblqpro0+1;
         end
      else
         begin
         mqtdTot:=0;
         if pund=100 then
            mPd_Qtdblqpro100:=mPd_Qtdblqpro100+1;
         end
      end
   else if (pRestPro=2) and (pRestCon<>0) then // se a restricao for por controle e bloqueado
      begin
      if pRestCon=2 then // se pf
         begin
         if codemp>100 then
            begin
            if pund=100 then
               mPd_Qtdblqcon100:=mPd_Qtdblqcon100+1;
            mqtdTot:=0;
            end
         else
            begin
            mqtdTot:=pqtd;
            if pund=0 then
               mPd_Qtdblqcon0:=mPd_Qtdblqcon0+1;
            end;
         end
      else if pRestCon=1 then // se menor 99
         begin
         if codemp>100 then
            begin
            if pund=0 then
               mPd_Qtdblqcon0:=mPd_Qtdblqcon0+1;
            mqtdTot:=pqtd;
            end
         else
            begin
            mqtdTot:=0;
            if pund=100 then
               mPd_Qtdblqcon100:=mPd_Qtdblqcon100+1;
            end;
         end
      end
   else if (pRestPro=1) and (pRestFor<>0) then // se a restricao for por fornecedor e bloqueado

      begin
      if pRestFor=2 then // se pf
         begin
         if codemp>100 then
            begin
            if pund=0 then
               mPd_Qtdblqfor0:=mPd_Qtdblqfor0+1;
            mqtdTot:=0;
            end
         else
            begin
            mqtdTot:=pqtd;
            if pund=0 then
               mPd_Qtdblqfor0:=mPd_Qtdblqfor0+1;
            end;
         end
      else if pRestfor=1 then // se menor 99
         begin
         if codemp>100 then
            begin
            if pund=0 then
               mPd_Qtdblqfor0:=mPd_Qtdblqfor0+1;
            mqtdTot:=pqtd;
            end
         else
            begin
            mqtdTot:=0;
            if pund=100 then
               mPd_Qtdblqfor100:=mPd_Qtdblqfor100+1;
            end;
         end
      end
   else
      begin
//      mqtdtot:=pqtd*(100-pund)/100;
//      if pfracao=0 then
//         mqtdTot:=Arredonda(mqtdTot,0);
//         mqtdTot:=Round(mqtdTot);
//      mqtdtot:=pqtd-mqtdtot;
      mqtdTot:=pqtd*pund/100;
      if pfracao=0 then
         mqtdTot:=Arredonda(mqtdTot,0);
      if mqtdTot>pqtd then
         mqtdTot:=pqtd;
      end;
   result:=mqtdTot;
   end;
end;

