procedure TFrm_Ped_02.edt_valoipiExit(Sender: TObject);
var
  mtotalipi : Real;
  mtotbipi  : real;
begin
  edt_valoipi.Text := insere(FormatFloat(mcasas,ValFloat(edt_valoipi.Text)),' ',pspapco);

  if ValFloat(edt_valoipi.Text)>9999999 then begin
     fMensagem('Campo Valor do IPI muito grande!',0,['0'],0);
     edt_valoipi.SetFocus;
     exit;
  end;

  mtotalipi := 0;
  mtotbipi  := 0;

  QryItem_Nota.First;
  while not QryItem_Nota.Eof do
     begin
     if QryItem_NotaP2CODPRO.IsNull then
        begin
        QryItem_Nota.Next;
        Continue;
        end;
     mtotalipi := mtotalipi+QryItem_NotaP2VALIPI.Value;
     mtotbipi  := mtotbipi+QryItem_NotaP2TOTLIQ.Value;
     QryItem_Nota.Next;
     end;

  if mtotbipi < ValFloat(edt_valoipi.Text) then
     begin
     fMensagem('Não ha Produtos com ipi suficiente para Este Valor!',0,['0'],0);
     edt_valoipi.SetFocus;
     exit;
     end;

  mdifipi := ValFloat(edt_valoipi.Text)-mtotalipi;
  fratearipi(0);
  FExibirtotais(0);
end;

