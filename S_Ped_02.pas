function tFrm_Ped_02.fBuscaPedAnterior(pTipo: Integer): Boolean;
var

mItemPen: Integer;
mFoiFaturado: Boolean;
mtipop_ant: Integer;
Query4: TQuery;
Query6: TQuery;
begin
mpd_ptipop:=-1;
mpd_RestaurandoPedido:=true;
if ptipo=0 then
   begin
   Query4 := TQuery.Create(nil);
   Query4.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
   Query6 := TQuery.Create(nil);
   Query6.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
   mFoiFaturado:=False;
   Query4.Close;
   Query4.SQL.Clear;
   Query4.SQL.Add('SELECT * FROM CADP01_TEMP '
                 +' WHERE (P1TERM =:TERM and P1CODUSR=:CODUSR )'
                 +' and trunc(  (SYSDATE-p1dathor_man)*24*60,2) >= 0.05  ');
   Query4.ParamByName('TERM').AsString   := mPd_NomeComputador;
   Query4.ParamByName('CODUSR').AsString := IntToStr(codusr);
   try
      Query4.Open;
   except
      ex_erroSql_Novo(Query4,16937,'Frm_Ped_02','CADP01');
      end;
   if not Query4.IsEmpty then
      begin
      mPd_Incluiu_Pedido:=true;
      mAceita_pergunta:=false;
      Application.CreateForm(Tfrm_Agde, form_Agde_ped_02);
      form_Agde_ped_02.Show;
      form_Agde_ped_02.Label1.Caption:='Aguarde Enquanto é Restaurado Pedido Interrompido!!!';
      form_Agde_ped_02.Update;
//      verteclado(0);
      mPd_Oper_Ped:=Query4.FieldByName('P1TIPO_EVE').AsInteger;
      mpd_chave   :=Query4.FieldByName('P1CHAVE').AsInteger;
      if (Query4.FieldByName('P1TIPO_EVE').AsInteger=1) and (mpd_chave>0) then
         begin
         DM1.Query1.close;
         DM1.Query1.sql.clear;
         DM1.query1.Sql.add('select count(*),max(P1TIPO) as P1TIPO from CADP01 where '
                           +fla_EmpBaixaAlta(0,'CADP01,','',codemp,'P1CODEMP',' and ')
                           +' P1LOTSEQ=0'+InttoStr(ls_numped)+' and '
                           +' P1CHAVE=0'+Query4.fieldByName('P1CHAVE').AsString);
         dm1.Query1.Open;

         if DM1.Query1.fields[0].AsInteger>0 then
            begin
            if (Query4.fieldbyName('P1TIPO').asinteger<>0) and
               (DM1.Query1.fieldbyName('P1TIPO').AsInteger=0) then
               begin
               mFoiFaturado:=True;
               mpd_ptipop:=Query4.fieldbyName('P1TIPO').asinteger;
               end;
            end
         else
            begin
            DM1.Query1.close;
            DM1.Query1.SQL.Clear;
            DM1.query1.Sql.add('select max(P1CODNOV) as CODNOV from OLD_CADP01 where '
                           +fla_EmpBaixaAlta(0,'CADP01','',codemp,'P1CODEMP',' and ')
                           +' P1LOTSEQ=0'+InttoStr(ls_numped)+' and '
                           +' P1CHAVE=0'+Query4.fieldByName('P1CHAVE').AsString);
