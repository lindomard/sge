procedure Tfrm_ped_02.edt_datapedidoExit(Sender: TObject);
begin
if Trim(edt_datapedido.Text)='/  /' then
    exit;
try
  edt_datapedido.Text:=FormatDatetime(fdt2,StrtoDate(edt_datapedido.Text));
except
  fMensagem('Data Invalida!',0,['0'],0);
  edt_datapedido.Text := FormatDateTime(fdt2, date);
  edt_datapedido.SetFocus;
  end;

if (not mpd_RestaurandoPedido) and (not mPd_FaturandoPedido) then
   begin
   if Qr_Ped01P1DATAP.AsDateTime<>StrToDate(edt_datapedido.Text) then
     begin
     flcadpar02(0,0,CodUsr,IntToStr(55));
     if DM4.Tb_Par02PA2PDSN.Value = 'S' then
       begin
       if fValidaSenha(0,codusr,55,0,DM1.Tb_CliCCODCLI.Value,0,0,0, 'Senha para alterar a data do pedido?','') <> 0 then
         begin
         fMensagem('Alteração não Aceita!',0,['0'],0);
         edt_datapedido.Text := Qr_Ped01P1DATAP.AsString;
         edt_datapedido.SetFocus;
         exit;
         end;
       end;
     end;
   end;

if not mem_cadpfp.IsEmpty then
   begin
   mem_cadpfp.First;
   While not mem_cadpfp.Eof do
      begin
      mem_cadpfp.Edit;
      mem_cadpfpPFPDATA.AsDateTime:=StrtoDate(edt_datapedido.Text)+mem_cadpfpPFPPRAZO.AsFloat;
      if (mem_cadpfpPFPDATA.AsDateTime<Date) then
        begin
        mem_cadpfpPFPDATA.AsDateTime:=Date+mem_cadpfpPFPPRAZO.AsInteger;
        end;
      mem_cadpfp.Post;
      mem_cadpfp.Next;
      end;
   end;
end;

