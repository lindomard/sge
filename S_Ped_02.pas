procedure Tfrm_ped_02.cdsAddExtraAfterEdit(DataSet: TDataSet);
begin
ce_TotAddExt.Value:=ce_TotAddExt.Value-cdsAddExtraVALADDEXT.AsFloat;
btn_ValoresAdicionaisClick(self);
end;

procedure Tfrm_ped_02.btn_ValoresAdicionaisClick(Sender: TObject);
var
  Fator : Real;
  Dif   : Real;
begin
try
  Fator := Arredonda(ce_TotAddExt.Value / ValFloat(edt_totalitem.Caption),2);
except
  Fator := 0;
  end;
Dif:=ce_TotAddExt.Value-Fator*ValFloat(edt_totalitem.Caption);

QryItem_Nota.First;
while not QryItem_Nota.Eof do
  begin
  QryItem_Nota.Edit;
  QryItem_NotaP2PRECO.AsFloat:=QryItem_NotaP2PRECO.AsFloat + Fator + Dif;
  Dif:=0;
  QryItem_Nota.Post;
  QryItem_Nota.Next;
  end;
btn_calcularClick(self);
TOTEXTCOM.Value:=ce_TotAddExt.Value;
TOTEXTCOMExit(self);
end;

