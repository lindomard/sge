procedure TFrm_Ped_02.edt_codsepKeyPress(Sender: TObject; var Key: Char);
begin
   if (key in ['A'..'Z']) or (key in ['a'..'z']) or (key = '%') then begin
      edt_codsep.Text := fchamausr(0,'frm_ped_02',key);
      if valint(edt_codsep.Text)<>0 then
         edt_codsepExit(Self);
      key:=#0;
   end;
end;

procedure TFrm_Ped_02.edt_codprodutoEnter(Sender: TObject);
begin

mpd_QtdPed:=0; // Quantidade Pedida o item


if fsonumero(edt_codcliente.Text)=0 then
   begin
   if mAceita_pergunta then
      fmensagem('Favor Digitar um Cliente válido!',0,['0'],0);
   pgc_capapedido.ActivePage:= tbs_principal;
   edt_codcliente.SetFocus;
   exit;
   end;

if ValInt(edt_codvendedor.Text)=0 then
   begin
   if mAceita_pergunta then
      fmensagem('Favor Digitar um codigo de Vendedor válido!',0,['0'],0);
   pgc_capapedido.ActivePage:=tbs_principal;
   edt_codvendedor.SetFocus;
   exit;
   end;

if fsonumero(edt_codvenda.Text)=0 then
   begin
   fmensagem('Favor um Plano de Vendas válido!',0,['0'],0);
   pgc_capapedido.ActivePage:=tbs_principal;
   edt_codvenda.SetFocus;
   exit;
   end;

if (mPd_Venda_Devol=1) and (not CB_PEDORI.Checked)
   and ((not mem_CADP01D.Active) or (mem_CADP01D.IsEmpty))  then
   begin
   if mAceita_pergunta then
      fmensagem('Favor Digitar os Pedidos de Origem da Devolução!',0,['0'],0);
   exit;
   end;
if (mPd_Venda_Devol=1) and (not CB_PEDORI.Checked) and (Tb_DevCli.IsEmpty) then
   begin
   if mAceita_pergunta then
      fmensagem('Favor Digitar os Pedidos de Origem da Devolução!',0,['0'],0);
   pgc_capapedido.ActivePage:=tbs_devolucao;
   edt_dcodemp.SetFocus;
   exit;
   end;
if trim(edt_status.Caption)='' then
   begin
   if mPd_Oper_Ped=1 then
      edt_status.Caption:='A'
   else
      edt_status.Caption:='I';
   end;

if ValFloat(edt_codcliente.Text) <> 0 then
   begin
   if (mpd_ptipop = 9) and (DM1.Tb_CliCBLQEMP.Value = 1) then
      begin
      verteclado(0);
      fMensagem('Não é permitido fazer empréstimo para Este Cliente!',0,['0'],0);
      edt_codcliente.SetFocus;
//      cb_tipopedido.SetFocus;
      abort;
      end;
   if not fpedtestacfop(mpd_ptipop,mPed_SubMod) then
      begin
      cb_tipopedido.SetFocus;
      exit;
      end;
   end;


//mpd_ant_codpro:=fsonumero(edt_codproduto.Text);
//mpd_ant_und   :=edt_und.Text;
//mpd_ant_Preco :=edt_precounitario.Value;

if QryItem_Nota.IsEmpty then
   mpd_ant_Leitor := cb_leitor.Checked;


end;

procedure TFrm_Ped_02.edt_codprodutoKeyPress(Sender: TObject; var Key: Char);
begin
if (key in ['A'..'Z']) or (key in ['a'..'z']) or (key = '%') then
   begin
   if DM1.Tb_PargerPPCOGRA.Value=1 then
      edt_codproduto.Text := fChamaPro(2,'frm_pedidos02',key)
   else if (valint(copy(mpseg,4,2))=2) then
      edt_codproduto.Text := fChamaPro(0,'frm_pedidos02',key)
   else
      edt_codproduto.Text:=fChamaPro(0,'frm_pedidos02',key);
   if trim(mla_lote)<>'' then
      edt_lote.Text := mla_lote;
   if (trim(mla_dtvcto)<>'/  /') or (trim(mla_dtvcto)<>'') then
      edt_dtvcto.Text := mla_dtvcto;
   key:=#0;
   edt_codprodutoExit(Self);
   end
else
   begin
   if not (key in ['0'..'9']) and (key<>#8) then key:=#0;
   end;
end;


