procedure TFrm_Ped_02.bbDevTotalClick(Sender: TObject);
begin


if (mPd_Venda_Devol=1) and (not CB_PEDORI.Checked)
   and ((not mem_CADP01D.Active) or (mem_CADP01D.IsEmpty))  then
   begin
   if mAceita_pergunta then
      fmensagem('Favor Digitar os Pedidos de Origem da Devolução!',0,['0'],0);
   exit;
   end;

if not QryItem_Nota.IsEmpty then
   begin
   if mAceita_pergunta then
      fmensagem('Para Devolução Total Exclua os Ítens Digitados!',0,['0'],0);
   exit;
   end
else
   begin
   Tb_DevCli.First;
   While not Tb_DevCli.Eof do
      begin
      if Tb_DevCliTIPO.AsString='P' then
        begin
        pc_prodServ.ActivePageIndex:=0;        
        edt_codproduto.Text    :=Tb_DevCliP2CODPRO.AsString;
        edt_codven.Caption     :=Tb_DevCliP2CODVEN.AsString;
        edt_lote.Text          :=Tb_DevCliP2LOTE.AsString;
