        begin
        flcadpro(1,1,codemp,QryItem_Nota.FieldByName('P2CODPRO').AsString);
        if mPd_MovEstoque=0 then
          CMovPro(0,DM1.Tb_ProPDCODPRO.AsInteger,QryItem_Nota.FieldByName('P2LOTE').AsString,'S_Ped_02',1,DM1.Tb_ProPDSALDO.AsFloat,QryItem_Nota.FieldByName('P2QTD').AsFloat,'Exclusão do Pedido - '+edt_chave.Text)
        else if mPd_MovEstoque=1 then
          CMovPro(0,DM1.Tb_ProPDCODPRO.AsInteger,QryItem_Nota.FieldByName('P2LOTE').AsString,'S_Ped_02',0,DM1.Tb_ProPDSALDO.AsFloat,QryItem_Nota.FieldByName('P2QTD').AsFloat,'Exclusão do Pedido - '+edt_chave.Text);
        end;


      if mPd_SaiTerc then
         begin
         flbaiest_Nov(0,0,0,3,codemp,FloatToStr(QryItem_Nota.FieldByName('P2CODPRO').AsFloat),'frm_Ped_02',(QryItem_Nota.FieldByName('P2QTD').AsFloat));
         if valint(copy(mpseg,4,2))>0 then
            flbailgc_Novo(0,0,0,3,codemp,QryItem_NotaP2CODPRO.AsString,QryItem_NotaP2LOTE.AsString,mdtv,'','',QryItem_NotaP2QTD.AsFloat);
         end;
      if mPd_SaiRVenda then
         begin
         flbaiest_Nov(0,0,0,2,codemp,FloatToStr(QryItem_Nota.FieldByName('P2CODPRO').AsFloat),'frm_Ped_02',(QryItem_Nota.FieldByName('P2QTD').AsFloat));
         if valint(copy(mpseg,4,2))>0 then
            flbailgc_Novo(0,0,0,2,codemp,QryItem_NotaP2CODPRO.AsString,QryItem_NotaP2LOTE.AsString,mdtv,'','',QryItem_NotaP2QTD.AsFloat);
         end;
      if mPd_SaiCons then
         begin
         flbaiest_Nov(0,0,0,1,codemp,FloatToStr(QryItem_Nota.FieldByName('P2CODPRO').AsFloat),'frm_Ped_02',(QryItem_Nota.FieldByName('P2QTD').AsFloat));
         if valint(copy(mpseg,4,2))>0 then
            flbailgc_Novo(0,0,0,1,codemp,QryItem_NotaP2CODPRO.AsString,QryItem_NotaP2LOTE.AsString,mdtv,'','',QryItem_NotaP2QTD.AsFloat);
         end;
      if mPd_SaiNor then
         begin
         flbaiest_Nov(0,0,0,0,codemp,FloatToStr(QryItem_Nota.FieldByName('P2CODPRO').AsFloat),'frm_Ped_02',(QryItem_Nota.FieldByName('P2QTD').AsFloat));
         if valint(copy(mpseg,4,2))>0 then
            flbailgc_Novo(0,0,0,0,codemp,QryItem_NotaP2CODPRO.AsString,QryItem_NotaP2LOTE.AsString,mdtv,'','',QryItem_NotaP2QTD.AsFloat);

         if (QryItem_Nota.FieldByName('P2DTVCTO').IsNull) or (QryItem_Nota.FieldByName('P2DTVCTO').AsDateTime<=pdatanula) then
            mcinst4:=''
         else
            mcinst4:=FormatDateTime(fdt2, QryItem_Nota.FieldByName('P2DTVCTO').AsDateTime);


         if (not mpd_RestaurandoPedido) and  (mPd_Venda_Devol=1) and (not CB_PEDORI.Checked) and (not Tb_DevCli.IsEmpty) then
            FBaixarDevolucao(1,QryItem_Nota.FieldByName('P2CODPRO').AsString,
            QryItem_Nota.FieldByName('P2LOTE').AsString,mcinst4,QryItem_NotaP2QTD.AsFloat);

         end;
      if mPd_EntraTerc then
         begin
         flbaiest_Nov(0,0,1,3,codemp,FloatToStr(QryItem_Nota.FieldByName('P2CODPRO').AsFloat),'frm_Ped_02',(QryItem_Nota.FieldByName('P2QTD').AsFloat));
         if valint(copy(mpseg,4,2))>0 then
            flbailgc_Novo(0,0,1,3,codemp,QryItem_NotaP2CODPRO.AsString,QryItem_NotaP2LOTE.AsString,mdtv,'','',QryItem_NotaP2QTD.AsFloat);
         end;
      if mPd_EntraRVenda then
         begin

         flbaiest_Nov(0,0,1,2,codemp,FloatToStr(QryItem_Nota.FieldByName('P2CODPRO').AsFloat),'frm_Ped_02',(QryItem_Nota.FieldByName('P2QTD').AsFloat));
         if valint(copy(mpseg,4,2))>0 then
            flbailgc_Novo(0,0,1,2,codemp,QryItem_NotaP2CODPRO.AsString,QryItem_NotaP2LOTE.AsString,mdtv,'','',QryItem_NotaP2QTD.AsFloat);
         end;
      if mPd_EntraCons then
         begin
         flbaiest_Nov(0,0,1,1,codemp,FloatToStr(QryItem_Nota.FieldByName('P2CODPRO').AsFloat),'frm_Ped_02',(QryItem_Nota.FieldByName('P2QTD').AsFloat));
         if valint(copy(mpseg,4,2))>0 then
            flbailgc_Novo(0,0,1,1,codemp,QryItem_NotaP2CODPRO.AsString,QryItem_NotaP2LOTE.AsString,mdtv,'','',QryItem_NotaP2QTD.AsFloat);
         end;
      if mPd_EntraNor then
         begin
         flbaiest_Nov(0,0,1,0,codemp,FloatToStr(QryItem_Nota.FieldByName('P2CODPRO').AsFloat),'frm_Ped_02',(QryItem_Nota.FieldByName('P2QTD').AsFloat));
         if valint(copy(mpseg,4,2))>0 then
            flbailgc_Novo(0,0,1,0,codemp,QryItem_NotaP2CODPRO.AsString,QryItem_NotaP2LOTE.AsString,mdtv,'','',QryItem_NotaP2QTD.AsFloat);

         if (QryItem_Nota.FieldByName('P2DTVCTO').IsNull) or (QryItem_Nota.FieldByName('P2DTVCTO').AsDateTime<=pdatanula) then
