procedure TFrm_Ped_02.edt_precounitarioExit(Sender: TObject);
var
mValor_Ant: real;
begin
if ValFloat(edt_codproduto.Text)<=0 then
  Exit;
//SENHA INTERNA PARA ALTERAR PRECO
if (mpd_ant_codpro=StrToFloat(edt_codproduto.Text)) and (Arredonda(edt_precounitario.Value,2)<>Arredonda(mpd_ant_Preco,2)) then
  begin
  if (not mPd_FaturandoPedido) and (not mpd_RestaurandoPedido) and (Qr_Ped01P1TIPO.AsInteger>0) then
    begin
    if fValidaSenha(0,codusr,63,0,StrToFloat(edt_codproduto.text),0,0,0,'Senha para Alterar o Preço do Produto','')<>0 then
      begin
      if cb_tipopreco.itemindex=3 then
         edt_desc1.value:=mpd_ant_Desc1;
      edt_precounitario.Value:=mpd_ant_Preco;
      end;
    end;
  end;


// inicio
if (not DM1.Tb_Pro.Active) or ( (fsonumero(edt_codproduto.text)>0) and
   (valfloat(edt_codproduto.Text)<>DM1.Tb_ProPDCODPRO.AsFloat)) then
   flcadpro(1,0,0,trim(edt_codproduto.Text));

if (cb_tipopreco.ItemIndex=3)  then
   begin
   mValor_Ant:=edt_precounitario.Value;

   edt_precounitario.Value:=fbuscarPreco_novo(0,fSonumero(edt_codproduto.Text),
   edt_lote.Text,cb_tipopreco.ItemIndex,edt_tipopco.AsInteger,edt_desc1.Value,edt_desc2.Value,edt_desc3.Value,true,cb_tabelavenda.Text,edt_codvenda.Text,edt_quantidade.Value);
   if edt_precounitario.value=0 then
      edt_precounitario.value:=mValor_Ant;
   end;

 edt_total.Value := Arredonda(( edt_precounitario.Value * edt_quantidade.Value), DM1.Tb_PargerPCASAS.Asinteger) ;

