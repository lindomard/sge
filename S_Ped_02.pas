function tFrm_Ped_02.fGerarFormas_ped02(pTipo,pAtualiza: Integer): Boolean;
// ptipo=0 normal 1-prazo ponderado
// patualiza=0 inclusao de formas 1-Ajustar Formas e dados clientes
var

y,mQtdd: Integer;
mValParc: Real;
mDifParc: Real;
mValpParc: Real;

begin
DM1.Qr_FP.First;
if not mem_cadpfp.Active then
   begin
   mem_cadpfp.Close;
   mem_cadpfp.Open;
   end;


if Arredonda(mTotal_fp,2)<>valFloat(st_totliquido.Caption) then
   begin
   if mem_cadpfp.RecordCount=1 then
      begin
      mem_cadpfp.Edit;
      mem_cadpfpPFPVALOR.Value:=valFloat(st_totliquido.Caption);
      mem_cadpfp.Post;
      result:=true;
      exit;
      end
   else
      begin
      pAtualiza:=0;
      mem_cadpfp.close;
      mem_cadpfp.Open;

      end;
   end;

mTotal_fp:=0;
if pAtualiza=1 then
   begin
   mem_cadpfp.Last;
   mFPag_Seq:=0;
   While not mem_cadpfp.Bof do
      begin
      mFPag_Seq:=mFPag_Seq+1;
      mem_cadpfp.Edit;
      mem_cadpfpPFPSEQ.Value:=mFPag_Seq;
{
      if mcodfp=0 then
         begin
         if not DM1.Qr_FP.Locate('FPVINCULO',0,[]) then
            DM1.Qr_FP.First;
         end
      else
         begin
         if not DM1.Qr_FP.Locate('FPCODIGO',mCodFp,[]) then
            DM1.Qr_FP.First;
         end;
      mem_cadpfpPFPNOMFOR.Value :=DM1.Qr_FPFPDESC.Value;
      mem_cadpfpPFPFORMA.Value  :=DM1.Qr_FPFPCODIGO.Value;
      mem_cadpfpPFPVINCULO.Value:=DM1.Qr_FPFPVINCULO.Value;
      flcadcli_ic(1,0,DM1.Tb_CliCCODCLI.AsString);
