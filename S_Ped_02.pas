            edt_ambiente.Text      := form_PedCli_ped_02.Tb_Ped02P2AMBIENTE.AsString
         else
            edt_ambiente.Text      := '';


          if ((valint(copy(mpseg,4,2))<>2) and not (DM1.Tb_PargerPFATDPRO.AsInteger > 0)) or mUnirProdutos then
             begin
