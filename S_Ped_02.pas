            edt_lote.Text:=Tb_DevCliP2LOTE.AsString;
          if Tb_DevCliP2DTVCTO.AsDateTime>pdatanula then
           edt_dtvcto.Text:=FormatDatetime(fdt2, Tb_DevCliP2DTVCTO.AsDateTime);
          end
        else
          begin
          fmensagem('Produto não Encontrado no Pedido de Origem!',0,['0'],0);
