if DM1.Tb_PargerPUPVESP.Asinteger = 1 then
   cb_tabelavenda.text := 'AP';

edt_codvenda.Text := fdeixanum2(edt_codvenda.Text);

if (trim(edt_codvenda.Text) = '') or (trim(cb_tabelavenda.Text) = '') then
