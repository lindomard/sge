function tFrm_Ped_02.fPd_GravarItens(pOrigem: Integer): boolean;
var
 mpd_pesobruto, mpd_pesoliquido: Real;
 mpd_QtdIn,mpd_QtdServNF,mpd_tcimpda: Integer;
 mpd_GravouPedido: Boolean;
 mpd_itens,mpd_itemad_atual,mpd_itemad_geral: Integer;
 y: Integer;
 mPercDespAce: Real;
begin
mcinst:=mdocs[02];
if not fltdvca(0,0,'NF',mcinst,'CADTAB') then
   begin
   mpd_QtdIn:=20;
   mpd_QtdServNF:=20;
   mpd_tcimpda:=0;
   end
else
   begin
   mpd_QtdIn:=DM1.Tb_TDVCATCQTDITEM.AsInteger;
   mpd_QtdServNF:=DM1.Tb_TDVCATCQTDSER.AsInteger;
   mpd_tcimpda:=DM1.Tb_TDVCATCIMPDA.AsInteger;
   end;

mPercDespAce:=0;
if ValFloat(edt_outdesp.Text) > 0 then
  begin
  mPercDespAce := ValFloat(edt_outdesp.Text)*100/ValFloat(st_totalbruto.Caption);
  mPercDespAce := Truncar(mPercDespAce,3);
  end;

if mpd_QtdIn=0 then mpd_QtdIn:=20;
if mpd_QtdServNF=0 then mpd_QtdServNF:=20;

if DM1.Tb_PargerPANOTUNI.Value=1 then
   begin
   mpd_QtdIn    :=990;
   mpd_QtdServNF:=990;
   end;

mpd_itens :=0;

mpd_itemad_atual:=0;
mpd_itemad_geral:=0;

mpd_GravouPedido:=true;
QryItem_Nota.Last;

While not QryItem_Nota.Bof do
   begin
   if mPed_Formace<>1 then
      begin
      if (QryItem_Nota.fieldbyName('P2QTD').asfloat
         -QryItem_Nota.fieldbyName('P2QTD_101').asfloat)<=0 then
         begin
         QryItem_Nota.Prior;
         Continue;
         end
      end
   else
      begin
      if (Arredonda(QryItem_Nota.fieldbyName('P2PRECO').AsFloat,mQtdcasaspu_ped)
              -Arredonda(QryItem_Nota.fieldbyName('P2PRECO_101').asfloat,mQtdcasaspu_ped))<=0 then
         begin
         QryItem_Nota.Prior;
         Continue;
         end;
      end;
   if mpd_chave=0 then
      begin
      if pconsemp then
         mpd_chave:=fbuscaNUMPED( iif(codemp>100,codemp-100,codemp))
      else
         mpd_chave:=fbuscaNUMPED(codemp);
     if DM1.Tb_PargerPFORPEDPAD.asinteger=3 then
         mpd_chave:=fbuscarSequencia('PEDVEN_'+'0');
      mpd_ordem:=1;
      end
   else if mpd_ordem=0 then
      mpd_ordem:=1;
   mpd_itens :=mpd_itens+1;



   if (trim(QryItem_NotaDESCALTER.AsString)<>'') then
      begin
      form_DescAlter_ped_02.DESCALTER.Text:=QryItem_NotaDESCALTER.Value;
      mpd_itemad_geral:=mpd_itemad_geral+form_DescAlter_ped_02.DESCALTER.Lines.Count;
      mpd_itemad_atual:=form_DescAlter_ped_02.DESCALTER.Lines.Count;
      end
   else
      mpd_itemad_atual:=0;

   if ( (mpd_itens+mpd_itemad_geral) >mpd_QtdIn) then
      begin
      fpd_gravap1(0,codemp);
      mpd_ordem:=mpd_ordem+1;
      mpd_GravouPedido:=true;
      mpd_itens:=1;
      mpd_itemad_geral:=0;
      end;

   DM4.Qr_IncPed02.Close;
   DM4.Qr_IncPed02.ParambyName('P2CODEMP').AsFloat      :=codemp;
   DM4.Qr_IncPed02.ParambyName('P2LOTSEQ').AsFloat      :=mPd_LotSeq;
   DM4.Qr_IncPed02.ParambyName('P2CHAVE').AsFloat       :=mpd_chave;
   DM4.Qr_IncPed02.ParambyName('P2CHAVE_NIVEL').AsFloat :=0;
   DM4.Qr_IncPed02.ParambyName('P2PCREDSN').AsFloat     :=DM4.Tb_ParGer02PG2PACREDICMS.AsFloat;
   DM4.Qr_IncPed02.ParambyName('P2ORDEM').AsFloat       :=mpd_ordem;
   DM4.Qr_IncPed02.ParambyName('P2ITEM').AsFloat        :=mpd_itens;
   DM4.Qr_IncPed02.ParambyName('P2CODPRO').AsFloat      :=QryItem_Nota.fieldbyName('P2CODPRO').AsFloat;
   DM4.Qr_IncPed02.ParambyName('P2UND').AsString        :=QryItem_Nota.fieldbyName('P2UND').AsString;
   DM4.Qr_IncPed02.ParambyName('P2CODANT').AsFloat      :=QryItem_Nota.fieldbyName('P2CODANT').AsFloat;

   if mPed_Formace=1 then
      begin
      DM4.Qr_IncPed02.ParambyName('P2QTD').AsFloat      :=QryItem_Nota.fieldbyName('P2QTD').AsFloat;
      DM4.Qr_IncPed02.ParambyName('P2QTD_ATEN').AsFloat :=QryItem_Nota.fieldbyName('P2QTD').AsFloat;
      DM4.Qr_IncPed02.ParambyName('P2PRECO').AsFloat       :=QryItem_NotaP2PRECO.AsFloat
                                                           -QryItem_NotaP2PRECO_101.AsFloat;
      end
   else
      begin
      DM4.Qr_IncPed02.ParambyName('P2QTD').AsFloat      :=QryItem_Nota.fieldbyName('P2QTD').AsFloat
                                                         -QryItem_Nota.fieldbyName('P2QTD_101').AsFloat;
      DM4.Qr_IncPed02.ParambyName('P2QTD_ATEN').AsFloat :=QryItem_Nota.fieldbyName('P2QTD').AsFloat
                                                         -QryItem_Nota.fieldbyName('P2QTD_101').AsFloat;
      DM4.Qr_IncPed02.ParambyName('P2PRECO').AsFloat       :=QryItem_NotaP2PRECO.AsFloat;
      end;

   DM4.Qr_IncPed02.ParambyName('P2QTDDEV').AsFloat      :=QryItem_Nota.fieldbyName('P2QTDDEV').AsFloat
