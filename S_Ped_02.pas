      ex_erroSql_Novo(DM1.Query5,16937,'Frm_Ped_02','CADP01');
      end;


   DM1.Query5.First;

   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;
   DM1.Query1.SQL.Add('delete from CADP02_TEMP WHERE P2TERM =:TERM '
                     +' and P2DATHOR=:DATHOR ');
   DM1.Query1.ParamByName('TERM').AsString     := mPd_NomeComputador;
   DM1.Query1.ParamByName('DATHOR').AsDateTime := mPd_DatHor_Eve;
   try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql_Novo(DM1.Query5,16937,'Frm_Ped_02','CADP01');
      end;

   while not DM1.Query5.Eof do
      begin
      if DM1.Query5.FieldByName('P2TIPO_EVE').AsInteger<>0 then
         begin
         DM1.Query5.Next;
         Continue;
         end;
      edt_codproduto.Text    := DM1.Query5.FieldbyName('P2CODPRO').AsString;
      edt_codven.Caption     := DM1.Query5.FieldbyName('P2CODVEN').AsString;
      edt_codprodutoExit(Self);
      edt_lote.Text          := DM1.Query5.FieldbyName('P2LOTE').AsString;
      edt_dtvcto.Text        := '/  /';
      edt_precounitario.Value:= DM1.Query5.FieldbyName('P2PRECO').AsFloat;
      edt_quantidade.Value   := DM1.Query5.FieldbyName('P2QTD').AsFloat;
      edt_ambiente.Text      := DM1.Query5.FieldbyName('P2AMBIENTE').Asstring;
      edt_complemento.Text   := DM1.Query5.FieldbyName('P2COMPLEMENTO').AsString;
      edt_desc1.Value        := DM1.Query5.FieldbyName('P2DESC01').AsFloat;
      edt_desc2.Value        := DM1.Query5.FieldbyName('P2DESC02').AsFloat;
      edt_desc3.Value        := DM1.Query5.FieldbyName('P2DESC03').AsFloat;
      edt_descfin.Value      := DM1.Query5.FieldbyName('P2DESCFIN').AsFloat;
      edt_comissao.value     := DM1.Query5.FieldbyName('P2PCOMIS').AsFloat;
      edt_tipopco.value      := DM1.Query5.FieldbyName('P2TIPO_PCO').AsFloat;
      cb_ConsProprio.Checked := iif(DM1.Query5.FieldbyName('P2CONS_PROPRIO').AsInteger=0,true,false);
      edt_quantidadeExit(self);
      if edt_quantidade.Value<=0 then
         begin
         edt_codproduto.Text    := '';
         edt_codven.Caption     := '';
         edt_lote.Text          := '';
         edt_dtvcto.Text        :='/  /';
         edt_precounitario.Text := '';
         edt_quantidade.Text    := '';
         edt_desc1.Text         := '';
         edt_desc2.Text         := '';
         edt_desc3.Text         := '';
         edt_descfin.Text       := '';
         edt_comissao.Text      := '';
         edt_descricao.Text     := '';
         edt_secao.Text         := '';
         edt_marca.Text         := '';
         edt_und.Text           := '';
         edt_ambiente.Text      := '';
         edt_complemento.Text   := '';
         DM1.Query5.Next;
         Continue;
         end;
      edt_tipopco.value      := DM1.Query5.FieldbyName('P2TIPO_PCO').AsFloat;
      if DM1.Tb_PargerPDQPCOP.AsInteger=4 then
         edt_tipopcoExit(Self);
      edt_precounitario.Value:= DM1.Query5.FieldbyName('P2PRECO').AsFloat;
      bbGravarItemClick(Self);
      DM1.Query5.Next;
      end;
   mPd_FaturandoPedido:=false;
   end;

cb_leitor.Checked:=mLeitor_Ant;

mPd_FaturandoPedido:=false;
result:=true;
