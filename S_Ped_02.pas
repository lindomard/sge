      begin
      fMensagem('Quantidade Maxima Permitida para devolução: '
               +FormatFloat(mcasqtd, xqtde)
               ,0,['0'],0);
      edt_Quantidade.Value:=xqtde;
      edt_quantidade.SetFocus;
      exit;
      end;
