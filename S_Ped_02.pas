begin
if fValidaSenha(0,codusr,67,0,DM1.Tb_Ped01P1CHAVE.AsInteger,0,0,0, 'Senha para Emitir Nota Fiscal.','')<>0 then
   begin
   verteclado(0);
   fMensagem('Emissão não Aceita!',0,['0'],0);
   exit;
   end;

if (DM1.Tb_PargerPPEDFPGTO.AsInteger>0) and not (mem_cadpfp.IsEmpty) and (Qr_Ped01P1TIPO.AsInteger>0) then
  begin
  mem_cadpfp.First;
  while not mem_cadpfp.Eof do                       
    begin
    if (mem_cadpfpPFPDATA.AsDateTime<Date) and (Qr_Ped01P1EMIDOC.AsInteger=0)  then
      begin
      Fmensagem('Data de Vencimento do Parcelamento Não Pode Ser Menor que a Data Atual!',0,['0'],0);
      exit;
      end;
    mem_cadpfp.Next;
    end;
  end;

Qr_Ped01.First;
mqtdman:=Qr_Ped01P1QTDMAN.AsInteger;
Qr_Ped01.Close;
Qr_Ped01.Open;

if Qr_Ped01.Eof then
   begin
   fLimparTudo(0);
   fMensagem('Chave não Encontrada!',0,['0'],0);
   exit;
   end;
if (Qr_Ped01P1SITPED.Value = 1) and ( (Qr_Ped01P1DATHOR_ULTEVE.AsDateTime>pdatanula)
   and (trunc((now-Qr_Ped01P1DATHOR_ULTEVE.AsDateTime))*24*60<=1))
   and (not mpd_RestaurandoPedido) then
   begin
   mcinst2:=Qr_Ped01P1CODUSR.AsString+' - ';
   if Qr_Ped01P1CODUSR.AsInteger=1111 then
      mcinst2:=mcinst2+'Programador(Master)'
   else
      begin
      if flcadusr(0,0,Qr_Ped01P1CODUSR.AsString) then
         mcinst2:=mcinst2+DM4.Tb_UsrNOMUSR.AsString;
      end;
   mcinst := 'Este Pedido Sendo Alterado no Computador: '+Qr_Ped01P1COMP_ULTEVE.AsString
           + ' Pelo Usuário: '+mcinst2
           + ' Data/Hora: '+Formatdatetime('dd/mm/yyyy hh:nn:ss', Qr_Ped01P1DATHOR_ULTEVE.AsDateTime);
   fMensagem(mcinst,0,['0'],0);
   exit;
   end;

if Qr_Ped01P1QTDMAN.Value>mqtdman then
   begin
   mPd_Oper_Ped:=3;
   btn_localizar.Click;
   if (Qr_Ped01P1SITPED.Value = 1) and ( (Qr_Ped01P1DATHOR_ULTEVE.AsDateTime>pdatanula)
      and (trunc((now-Qr_Ped01P1DATHOR_ULTEVE.AsDateTime))*24*60<=1))
      and (not mpd_RestaurandoPedido) then
      begin
      mcinst2:=Qr_Ped01P1CODUSR.AsString+' - ';
      if Qr_Ped01P1CODUSR.AsInteger=1111 then
         mcinst2:=mcinst2+'Programador(Master)'
      else
         begin
         if flcadusr(0,0,Qr_Ped01P1CODUSR.AsString) then
            mcinst2:=mcinst2+DM4.Tb_UsrNOMUSR.AsString;
         end;
      mcinst := 'Este Pedido Sendo Alterado no Computador: '+Qr_Ped01P1COMP_ULTEVE.AsString
              + ' Pelo Usuário: '+mcinst2
              + ' Data/Hora: '+Formatdatetime('dd/mm/yyyy hh:nn:ss', Qr_Ped01P1DATHOR_ULTEVE.AsDateTime);
      fMensagem(mcinst,0,['0'],0);
      exit;
      end;
   end;
Qr_Ped01.First;
While not Qr_Ped01.eof do
   begin
   if Qr_Ped01P1CODEMP.AsInteger>99 then
      begin
      Qr_Ped01.Next;
      Continue;
      end;
   if not fTestarCNPJ_IE(0,Qr_Ped01P1CODCLI.AsFloat) then
      exit;
   if Qr_Ped01P1CODTRA.AsInteger>0 then
      begin
      if not fTestarCNPJ_IE(1,Qr_Ped01P1CODTRA.AsFloat) then
         exit;
      end;
   Qr_Ped01.Next;
   end;

