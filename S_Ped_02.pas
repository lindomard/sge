   txts_comis.ReadOnly  :=false;
   edt_comissao.ReadOnly:=false;
   end;

pTarBan0:=0;
pTarBan1:=0;

fPed01tarbanpd(0,pTarBan0,pTarBan1);
if (ant_codpv <> '') and (trim(cb_tabelavenda.Text)+FormatFloat('0000',ValFloat(edt_codvenda.Text)) <> ant_codpv)
   and (not mpd_RestaurandoPedido) then
   begin
   ant_codpv := Trim(cb_tabelavenda.Text)+FormatFloat('0000',ValFloat(edt_codvenda.Text));
   if (cb_tipopreco.ItemIndex <> 2) and (cb_tipopreco.ItemIndex <> 5) and (cb_tipopreco.ItemIndex <> 4)
      and (cb_tipopreco.ItemIndex<>7)  then
      begin
{      if (not frm_ped_02.QryItem_Nota.IsEmpty)
