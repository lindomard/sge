   if fmensagem('Deseja Excluir o Serviço Selecionado?',0,['1','2'],0)<>mrYes then
      exit;
   mpd_ItemServ := mpd_ItemServ - 1;
   edt_qtdeServ.Caption  := FormatFloat('0.00',mpd_ItemServ);

    if mPd_SaiTerc or mPd_SaiRVenda or mPd_SaiCons or mPd_SaiNor or mPd_EntraTerc
