        edt_descricao.Text     :=Tb_DevCliPDNOME.AsString;
        edt_codprodutoExit(self);
        edt_und.Text           :=Tb_DevCliPDUND.AsString;
        edt_marca.Text         :=Tb_DevCliPDMARCA.AsString;
        edt_quantidade.Value   :=Tb_DevCliP2QTD.AsFloat;
        edt_precounitario.Value:=Tb_DevCliP2PRECO.AsFloat;
        edt_desc1.Value        :=Tb_DevCliP2DESC1.AsFloat;
        edt_desc2.Value        :=Tb_DevCliP2DESC2.AsFloat;
        edt_desc3.Value        :=Tb_DevCliP2DESC3.AsFloat;
        edt_descfin.Value      :=Tb_DevCliP2PDESCF.AsFloat;
        edt_comissao.Value     :=Tb_DevCliP2PCOMIS.AsFloat;
        DESCALTER.Text         :=Tb_DevCliP2NOMPRO_ORI.AsString;
        edt_precounitarioExit(self);
        bbGravarItemClick(self);
        end
      else
        begin
        pc_prodServ.ActivePageIndex:=1;
        txts_codpro.Text        :=Tb_DevCliP2CODPRO.AsString;
        txts_codproExit(self);
        txts_descricao.Text     :=Tb_DevCliPDNOME.AsString;
        txts_und.Text           :=Tb_DevCliPDUND.AsString;
        txts_quant.Value        :=Tb_DevCliP2QTD.AsFloat;
        txts_pcouni.Value       :=Tb_DevCliP2PRECO.AsFloat;
        txts_desci01.Value      :=Tb_DevCliP2DESC1.AsFloat;
        txts_desci02.Value      :=Tb_DevCliP2DESC2.AsFloat;
        txts_desci03.Value      :=Tb_DevCliP2DESC3.AsFloat;
        txts_descfin.Value      :=Tb_DevCliP2PDESCF.AsFloat;
        txts_comis.Value        :=Tb_DevCliP2PCOMIS.AsFloat;
        txts_pcouniExit(self);
        bbGravarServClick(self);        
        end;
      Tb_DevCli.Next;
      end;
   end;


end;

procedure TFrm_Ped_02.sbn_oridevClick(Sender: TObject);
var
mDeletaItem: boolean;
begin
if mem_CADP01DP1DCH_OR.IsNull then
   begin
   fmensagem('Favor Selecionar uma chave válida!!',
                         0,['1','2'],0);
   exit;
   end;


if fmensagem(pchar('Quer Realmente Excluir o Registro Selecionado?'),
                         0,['1','2'],0)<>mrYes then
   exit;
// inicio

mDeletaItem:=true;
if mPd_Oper_Ped=1 then
   begin
   DM1.Query1.Close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.Sql.Add('SELECT count(*) as QTD FROM CADP01D_TEMP WHERE ');
   DM1.query1.SQL.add('     P1DTERM=:P1DTERM');
   DM1.query1.SQL.add(' and P1DDATHOR=:P1DDATHOR');
   DM1.query1.SQL.add(' and P1DTIPO_EVE=0');
   DM1.query1.SQL.add(' and P1DLS_OR=:P1DLS_OR');
   DM1.query1.SQL.add(' and P1DCODEMP_OR=:P1DCODEMP_OR');
   DM1.query1.SQL.add(' and P1DCH_OR=:P1DCH_OR');

   DM1.Query1.ParamByName('P1DTERM').AsString     := mPd_NomeComputador;
   DM1.Query1.ParamByName('P1DDATHOR').AsDateTime := mPd_DatHor_Eve;
   DM1.Query1.ParamByName('P1DLS_OR').AsFloat     := mem_CADP01DP1DLS_OR.Value;
   DM1.Query1.ParamByName('P1DCODEMP_OR').AsFloat := mem_CADP01DP1DCODEMP_OR.Value;
   DM1.Query1.ParamByName('P1DCH_OR').AsFloat     := mem_CADP01DP1DCH_OR.Value;
   DM1.Query1.Open;
   if DM1.Query1.Fields[0].AsInteger<=0 then
      begin
      mDeletaItem:=false;
      DM1.Query1.Close;
      DM1.Query1.SQL.Clear;
      DM1.Query1.SQL.add('Insert into CADP01D_TEMP ('
                        +' P1DCODEMP '
                        +',P1DLOTSEQ '
                        +',P1DCHAVE '
                        +',P1DORDEM '
                        +',P1DLS_OR '
                        +',P1DCODEMP_OR '
                        +',P1DCH_OR '
                        +',P1DOR_OR '
                        +',P1DDATAP '
                        +',P1DTERM '
                        +',P1DDATHOR '
                        +',P1DCODUSR '
                        +',P1DTIPO_EVE '
                        +') values ('
                        +' :P1DCODEMP '
                        +',:P1DLOTSEQ '
                        +',:P1DCHAVE '
                        +',:P1DORDEM '
                        +',:P1DLS_OR '
                        +',:P1DCODEMP_OR '
                        +',:P1DCH_OR '
                        +',:P1DOR_OR '
                        +',:P1DDATAP '
                        +',:P1DTERM '
                        +',:P1DDATHOR '
                        +',:P1DCODUSR '
                        +',:P1DTIPO_EVE '
                        +')');
      DM1.Query1.ParamByName('P1DCODEMP').AsFloat   :=codemp;
      DM1.Query1.ParamByName('P1DLOTSEQ').AsFloat   :=mPd_LotSeq;
      DM1.Query1.ParamByName('P1DCHAVE').AsFloat    :=valfloat(edt_chave.Text);
      DM1.Query1.ParamByName('P1DORDEM').AsFloat    :=0;
      DM1.Query1.ParamByName('P1DLS_OR').AsFloat    :=mem_CADP01DP1DLS_OR.AsFloat;
      DM1.Query1.ParamByName('P1DCODEMP_OR').AsFloat:=mem_CADP01DP1DCODEMP_OR.AsFloat;
      DM1.Query1.ParamByName('P1DCH_OR').AsFloat    :=mem_CADP01DP1DCH_OR.AsFloat;
      DM1.Query1.ParamByName('P1DOR_OR').AsFloat    :=mem_CADP01DP1DOR_OR.AsFloat;
      DM1.Query1.ParamByName('P1DDATAP').AsDateTime :=DM1.Query3.FieldbyName('P1DATAP').AsDateTime;
      DM1.Query1.ParamByName('P1DTERM').AsString    :=mPd_NomeComputador;
      DM1.Query1.ParamByName('P1DDATHOR').AsDateTime:=mPd_DatHor_Eve;
      DM1.Query1.ParamByName('P1DCODUSR').AsFloat   :=codusr;
      DM1.Query1.ParamByName('P1DTIPO_EVE').AsFloat :=2; // exclusao somente quando alteração
      try
         DM1.Query1.ExecSQL;
         fdm1StartCommit;
      except
         end;
      end;
   end;

//TERMINO

if mDeletaItem then
   begin
   DM1.Query1.Close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.Sql.Add('Delete FROM CADP01D_TEMP WHERE ');
   DM1.query1.SQL.add('     P1DTERM=:P1DTERM');
   DM1.query1.SQL.add(' and P1DDATHOR=:P1DDATHOR');
   DM1.query1.SQL.add(' and P1DTIPO_EVE=0');
   DM1.query1.SQL.add(' and P1DLS_OR=:P1DLS_OR');
   DM1.query1.SQL.add(' and P1DCODEMP_OR=:P1DCODEMP_OR');
   DM1.query1.SQL.add(' and P1DCH_OR=:P1DCH_OR');
   DM1.Query1.ParamByName('P1DTERM').AsString     := mPd_NomeComputador;
   DM1.Query1.ParamByName('P1DDATHOR').AsDateTime := mPd_DatHor_Eve;
   DM1.Query1.ParamByName('P1DLS_OR').AsFloat     := mem_CADP01DP1DLS_OR.Value;
   DM1.Query1.ParamByName('P1DCODEMP_OR').AsFloat := mem_CADP01DP1DCODEMP_OR.Value;
   DM1.Query1.ParamByName('P1DCH_OR').AsFloat     := mem_CADP01DP1DCH_OR.Value;
   try
      DM1.Query1.ExecSQL;
      fDM1StartCommit;
   except
      ex_erroSql_Novo(DM1.Query1,16937,'Frm_Ped_02','CADP01');
      end;
   end;


// termino


mem_CADP01D.Delete;
fLerDevPend(0);
edt_dchave.Text:='';
edt_ddata.Text :='/  /';
edt_dchave.SetFocus;

end;

