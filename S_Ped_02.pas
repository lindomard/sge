         flbailgc_Novo(0,0,0,2,codemp,QryServico_NotaP2SCODPRO.AsString,'','','','',QryServico_NotaP2SQTD.AsFloat)
      end;

   if mPd_SaiCons then
      begin
      flbaiest_Nov(0,0,0,1,codemp,QryServico_NotaP2SCODPRO.AsString,'frm_Ped_02',QryServico_NotaP2SQTD.AsFloat);
      if valint(copy(mpseg,4,2))>0 then
