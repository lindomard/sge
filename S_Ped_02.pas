procedure TFrm_Ped_02.edt_dchaveExit(Sender: TObject);
begin
edt_dchave.Text := fdeixanum2(edt_dchave.Text);
if trim(edt_dchave.text)='' then
   exit;
cb_leitor.Checked:=false;

if valint(edt_dcodemp.Text)<>0 then
  la_Empresas:='( P1CODEMP='+IntToStr(codemp)+' or P1CODEMP=0'+IntToStr(codemp+IIF(codemp>100,-100,100))+')';

DM1.Query3.Close;
DM1.Query3.SQL.Clear;
DM1.Query3.SQL.Add('Select P1CODEMP,P1DATAP,P1DATDOC,P1CODCLI,P1EMIDOC,P1CODVEN,P1NUMNF,P1NUMCF,P1DATACF,P1DATANF,'
                   +'P1CHAVE,P1LOTSEQ,P1ORDEM,P1TIPO,P1ALIQDEB from CADP01 where '
                   +la_empresas
                   +iif(la_empresas='','',' and '));
DM1.Query3.SQL.Add(' P1LOTSEQ=0'+Trim(edt_dlotseq.Text));
DM1.Query3.SQL.Add(' and P1CHAVE=0'+Trim(edt_dchave.Text));
DM1.Query3.SQL.Add(' and P1STATUS<9');
DM1.Query3.Open;
if DM1.Query3.IsEmpty then
   begin
   verteclado(0);
   fMensagem('Chave não Encontrada!',0,['0'],0);
   edt_dchave.SetFocus;
   exit;
   end
else if DM1.Query3.FieldbyName('P1TIPO').Asinteger=0 then
   begin
   verteclado(0);
   fMensagem('Este Pedido é Orçamento!',0,['0'],0);
   edt_dchave.SetFocus;
   exit;
   end;
if fsonumero(edt_codcliente.Text)<>0 then
   begin
   if DM1.Query3.Fieldbyname('P1CODCLI').Asfloat<>fsonumero(edt_codcliente.Text) then
      begin
      verteclado(0);
      fMensagem('O Pedido de Origem não é deste Cliente. Cliente do Pedido: '+DM1.Query3.fieldbyName('P1CODCLI').AsString
                ,0,['0'],0);
      edt_dchave.SetFocus;
      exit;
      end;
   end;
if DM1.Query3.FieldbyName('P1EMIDOC').Asinteger=0 then
   begin
   verteclado(0);
   fMensagem('Não é um pedido válido para esta operação'+#13
             +'Venda não Confirmada!',0,['0'],0);
   edt_dchave.SetFocus;
   exit;
   end;

if fsonumero(edt_codvendedor.Text)<>DM1.Query3.FieldbyName('P1CODVEN').AsFloat then
   begin
   if flcadven(1,0,DM1.Query3.FieldbyName('P1CODVEN').AsString) then
      begin
      edt_codvendedor.Text:=DM1.Query3.FieldbyName('P1CODVEN').AsString;
      Ant_Float:=ValFloat(edt_codvendedor.Text);
      edt_codvendedorExit(Self);
      end;
   end;
if not mem_CADP01D.Active then
   mem_CADP01D.Open;
mem_CADP01D.Insert;
mem_CADP01DP1DCODEMP.Value   :=codemp;
mem_CADP01DP1DLOTSEQ.Value   :=mPd_LotSeq;
mem_CADP01DP1DCHAVE.Value    :=ValFloat(edt_chave.Text);
mem_CADP01DP1DCODEMP_OR.Value:=DM1.Query3.FieldbyName('P1CODEMP').AsFloat;
mem_CADP01DP1DCH_OR.Value    :=DM1.Query3.FieldbyName('P1CHAVE').AsFloat;
mem_CADP01DP1DLS_OR.Value    :=DM1.Query3.FieldbyName('P1LOTSEQ').AsFloat;
mem_CADP01DP1DOR_OR.Value    :=DM1.Query3.FieldbyName('P1ORDEM').AsFloat;
mem_CADP01DP1DDATAP.AsDateTime:=DM1.Query3.FieldbyName('P1DATAP').AsDateTime;
mem_CADP01D.Post;

if not mPd_Incluiu_Pedido then
   fAtualizaPedidoTemp(0)
else
   fAtualizaPedidoTemp(1);

DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.add('Insert into CADP01D_TEMP ('
                  +' P1DCODEMP '
                  +',P1DLOTSEQ '
                  +',P1DCHAVE '
                  +',P1DORDEM '
                  +',P1DLS_OR '
                  +',P1DCODEMP_OR '
                  +',P1DCH_OR '
                  +',P1DOR_OR '
                  +',P1DDATAP '
                  +',P1DTERM '
                  +',P1DDATHOR '
                  +',P1DCODUSR '
                  +',P1DTIPO_EVE '
                  +') values ('
                  +' :P1DCODEMP '
                  +',:P1DLOTSEQ '
                  +',:P1DCHAVE '
                  +',:P1DORDEM '
                  +',:P1DLS_OR '
                  +',:P1DCODEMP_OR '
                  +',:P1DCH_OR '
                  +',:P1DOR_OR '
                  +',:P1DDATAP '
                  +',:P1DTERM '
                  +',:P1DDATHOR '
                  +',:P1DCODUSR '
                  +',:P1DTIPO_EVE '
                  +')');
DM1.Query1.ParamByName('P1DCODEMP').AsFloat   :=codemp;
DM1.Query1.ParamByName('P1DLOTSEQ').AsFloat   :=mPd_LotSeq;
DM1.Query1.ParamByName('P1DCHAVE').AsFloat    :=valfloat(edt_chave.Text);
DM1.Query1.ParamByName('P1DORDEM').AsFloat    :=0;
DM1.Query1.ParamByName('P1DLS_OR').AsFloat    :=DM1.Query3.FieldbyName('P1LOTSEQ').AsFloat;
DM1.Query1.ParamByName('P1DCODEMP_OR').AsFloat:=DM1.Query3.FieldbyName('P1CODEMP').AsFloat;
DM1.Query1.ParamByName('P1DCH_OR').AsFloat    :=DM1.Query3.FieldbyName('P1CHAVE').AsFloat;
DM1.Query1.ParamByName('P1DOR_OR').AsFloat    :=DM1.Query3.FieldbyName('P1ORDEM').AsFloat;
DM1.Query1.ParamByName('P1DDATAP').AsDateTime :=DM1.Query3.FieldbyName('P1DATAP').AsDateTime;
DM1.Query1.ParamByName('P1DTERM').AsString    :=mPd_NomeComputador;
DM1.Query1.ParamByName('P1DDATHOR').AsDateTime:=mPd_DatHor_Eve;
DM1.Query1.ParamByName('P1DCODUSR').AsFloat   :=codusr;
DM1.Query1.ParamByName('P1DTIPO_EVE').AsFloat :=0;
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   end;

fLerDevPend(0);

edt_dchave.Text:='';
edt_ddata.Text :='/  /';
edt_dchave.SetFocus;



end;

