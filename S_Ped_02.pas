function tFrm_Ped_02.fpcoliq(ptipo: Integer; pPreco, pDesc01, pDesc02,pDesc03: Real): Real;
var
preco: Real;
begin
if ptipo=0 then
   begin
   preco:=ppreco-(ppreco*pdesc01/100);
   preco:=preco -(preco*pDesc02/100);
   if not cb_desc03.Checked then
     preco:=preco -(preco*pDesc03/100)
   else
     preco:=preco - pDesc03;
   end
else
   begin
   preco:=ppreco-(ppreco*pdesc01/100);
   preco:=preco -(preco*pDesc02/100);
   if not cb_desc03.Checked then
     preco:=preco -(preco*pDesc03/100)
   else
     preco:=preco - pDesc03;
   end;
preco:=Arredonda(preco,mQtdcasaspu_ped);

Result:=Preco;
end;
