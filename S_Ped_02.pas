procedure TFrm_Ped_02.ExcluirMPClick(Sender: TObject);
var
mDeletaItem:Boolean;
begin
if btn_gravar.Enabled=false then
   exit;

if not mpd_RestaurandoPedido then
   begin
   if fmensagem('Deseja Excluir o Item Selecionado?',0,['1','2'],0)<>mrYes then
      exit;

   if mPd_SaiTerc then
      begin
      flbaiest_Nov(0,0,0,3,codemp,mem_cadp02_mpP2MP_CODPRO.AsString,'frm_Ped_02',mem_cadp02_mpP2MP_QTDSOL.AsFloat);
      end;

   if mPd_SaiRVenda then
      begin
      flbaiest_Nov(0,0,0,2,codemp,mem_cadp02_mpP2MP_CODPRO.AsString,'frm_Ped_02',mem_cadp02_mpP2MP_QTDSOL.AsFloat);
      end;

   if mPd_SaiCons then
      begin
      flbaiest_Nov(0,0,0,1,codemp,mem_cadp02_mpP2MP_CODPRO.AsString,'frm_Ped_02',mem_cadp02_mpP2MP_QTDSOL.AsFloat);
      end;

   if mPd_SaiNor then
      begin
      flbaiest_Nov(0,0,0,0,codemp,mem_cadp02_mpP2MP_CODPRO.AsString,'frm_Ped_02',mem_cadp02_mpP2MP_QTDSOL.AsFloat);
      end;

   if mPd_EntraTerc then
      begin
      flbaiest_Nov(0,0,1,3,codemp,mem_cadp02_mpP2MP_CODPRO.AsString,'frm_Ped_02',mem_cadp02_mpP2MP_QTDSOL.AsFloat);
      end;

   if mPd_EntraRVenda then
      begin
      flbaiest_Nov(0,0,1,2,codemp,mem_cadp02_mpP2MP_CODPRO.AsString,'frm_Ped_02',mem_cadp02_mpP2MP_QTDSOL.AsFloat);
      end;

   if mPd_EntraCons then
      begin
      flbaiest_Nov(0,0,1,1,codemp,mem_cadp02_mpP2MP_CODPRO.AsString,'frm_Ped_02',mem_cadp02_mpP2MP_QTDSOL.AsFloat);
      end;
   if mPd_EntraNor then
      begin
      flbaiest_Nov(0,0,1,0,codemp,mem_cadp02_mpP2MP_CODPRO.AsString,'frm_Ped_02',mem_cadp02_mpP2MP_QTDSOL.AsFloat);
      end;


   // INICIO SE FOR ALTERACAO DE PEDIDO

   mDeletaItem:=true;
   if mPd_Oper_Ped=1 then
      begin
      DM1.Query1.Close;
      DM1.Query1.Sql.Clear;
      DM1.Query1.Sql.Add('SELECT count(*) as QTD FROM CADP02_MP_TEMP WHERE ');
      DM1.query1.SQL.add('  P2MP_TERM=:P2TERM');
      DM1.query1.SQL.add(' and P2MP_DATHOR=:P2DATHOR');
      DM1.query1.SQL.add(' and P2MP_CODPRO=:P2CODPRO');
      DM1.query1.SQL.add(' and P2MP_TIPEVE=0');
      DM1.Query1.ParamByName('P2MP_TERM').AsString   := mPd_NomeComputador;
      DM1.Query1.ParamByName('P2MP_DATHOR').AsDateTime := mPd_DatHor_Eve;
      DM1.Query1.ParamByName('P2MP_CODPRO').Value      := mem_cadp02_mpP2MP_CODPRO.AsFloat;
      DM1.Query1.Open;
      if DM1.Query1.Fields[0].AsInteger<=0 then
         begin
         mDeletaItem:=false;

         DM1.Query2.Close;
         DM1.Query2.SQL.Clear;
         DM1.Query2.SQL.Add(' INSERT INTO CADP02_MP_TEMP (  '
                           +'  P2MP_CODEMP '
                           +', P2MP_LOTSEQ '
                           +', P2MP_CHAVE '
                           +', P2MP_ITEM '
                           +', P2MP_CODPRO '
                           +', P2MP_PRECO '
                           +', P2MP_QTDSOL '
                           +', P2MP_QTD_DEVOL '
                           +', P2MP_QTD_SOBRA'
                           +', P2MP_QTD_QUEBRA '
                           +', P2MP_QTD_OUTRET'

                           +', P2MP_DATAHORA_SOL '
                           +', P2MP_TERM                '
                           +', P2MP_DATHOR                '
                           +', P2MP_CODUSR                '
                           +', P2MP_TIPEVE '

                           +') VALUES(                   '
                           +'  :P2MP_CODEMP '
                           +', :P2MP_LOTSEQ '
                           +', :P2MP_CHAVE '
                           +', :P2MP_ITEM '
                           +', :P2MP_PRECO '
                           +', :P2MP_CODPRO '
                           +', :P2MP_QTDSOL '
                           +', :P2MP_QTD_DEVOL '
                           +', :P2MP_QTD_SOBRA '
                           +', :P2MP_QTD_QUEBRA '
                           +', :P2MP_QTD_OUTRET '
                           +', :P2MP_DATAHORA_SOL '
                           +', :P2MP_TIPEVE '
                           +', :P2MP_TERM                '
                           +', :P2MP_DATHOR                '
                           +', :P2MP_CODUSR                '
                           +', :P2MP_TIPEVE '

                           + '   )                ');

         DM1.Query2.ParamByName('P2TIPO_EVE').Value       := 2; // exclusao somente quando alteração
         DM1.Query2.ParamByName('P2MP_CODEMP').Value      := codemp;
         DM1.Query2.ParamByName('P2MP_LOTSEQ').Value      := ls_numped;
         DM1.Query2.ParamByName('P2MP_CHAVE').Value       := mpd_chave;
         DM1.Query2.ParamByName('P2MP_ITEM').Value        := mpd_varItem_mp;
         DM1.Query2.ParamByName('P2MP_PRECO').Value       := Frm_Ped_02_MPReq.edtmp_preco.Value;
         DM1.Query2.ParamByName('P2MP_CODPRO').Value      := fSonumero(Frm_Ped_02_MPReq.edtmp_codpro.Text);
         DM1.Query2.ParamByName('P2MP_QTDSOL').Value      := Frm_Ped_02_MPReq.edtmp_qtdsol.Value;
         DM1.Query2.ParamByName('P2MP_QTD_DEVOL').Value   := Frm_Ped_02_MPReq_Outros.edtmp_qtddev.Value;
         DM1.Query2.ParamByName('P2MP_QTD_SOBRA').Value   := Frm_Ped_02_MPReq_Outros.edtmp_sobra.Value;
         DM1.Query2.ParamByName('P2MP_QTD_QUEBRA').Value  := Frm_Ped_02_MPReq_Outros.edtmp_quebra.Value;
         DM1.Query2.ParamByName('P2MP_QTD_OUTRET').Value  := Frm_Ped_02_MPReq_Outros.edtmp_outret.Value;

         DM1.Query2.ParamByName('P2MP_DATAHORA_SOL').AsDateTime:= StrToDateTime(FormatDateTime(fdt,mem_cadp02_mpP2MP_DATA_SOL.AsDateTime)+' '+mem_cadp02_mpP2MP_HORA_SOL.AsString+':00');
         DM1.Query2.ParamByName('P2MP_TERM').Value        := mPd_NomeComputador;
         DM1.Query2.ParamByName('P2MP_CODUSR').Value      := codusr;
         DM1.Query2.ParamByName('P2MP_DATHOR').Value      := mPd_DatHor_Eve;

         try
            DM1.Query2.ExecSQL;
            fdm1StartCommit;
         except
            ex_erroSql_Novo(DM1.Query2,23572,'Frm_Ped_02','CADP02_MP');
            end;
         end;

      end;

   //TERMINO

   if mDeletaItem then
      begin
      DM1.Query1.Close;
      DM1.Query1.Sql.Clear;
      DM1.Query1.Sql.Add('DELETE FROM CADP02_MP_TEMP WHERE ');
      DM1.query1.SQL.add('  P2MP_TERM=:P2TERM');
      DM1.query1.SQL.add(' and P2MP_DATHOR=:P2DATHOR');
      DM1.query1.SQL.add(' and P2MP_CODPRO=:P2CODPRO');
      DM1.query1.SQL.add(' and P2MP_TIPEVE=0');
      DM1.Query1.ParamByName('P2TERM').AsString   := mPd_NomeComputador;
      DM1.Query1.ParamByName('P2DATHOR').AsDateTime := mPd_DatHor_Eve;
      DM1.Query1.ParamByName('P2CODPRO').Value      := mem_cadp02_mpP2MP_CODPRO.AsFloat;
      try
         DM1.Query1.ExecSQL;
         fDM1StartCommit;
      except
         ex_erroSql_Novo(DM1.Query1,16937,'Frm_Ped_02','CADP01');
         end;
      end;
   end;
// ajustando os totais

mPdMP_totqtdsol:=mPdMP_totqtdsol-mem_cadp02_mpP2MP_QTDSOL.AsFloat;
mPdMP_totqtdDev:=mPdMP_totqtdDev-mem_cadp02_mpP2MP_QTDDEVOL.AsFloat;
mPdMP_totbruSol:=mPdMP_totbruSol-mem_cadp02_mpTOTALBRU.AsFloat;
mPdMP_totbruDev:=mPdMP_totbruDev-Arredonda( (mem_cadp02_mpP2MP_QTDDEVOL.AsFloat
                                       *mem_cadp02_mpP2MP_PRECO.AsFloat), DM1.Tb_PargerPCASAS.AsInteger) ;

// termino dos ajustes dos totais


if (QryItem_nota.RecordCount = 1) and (QryServico_Nota.RecordCount=0) and (mem_cadp02_mp.RecordCount=0) then
   LimpaRodape;
mem_cadp02_mp.Delete;

mPosReg_MP:=nil;
mPd_Oper_mp  :=0;

end;

