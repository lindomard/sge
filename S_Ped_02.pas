function tFrm_Ped_02.fLerDevPend(pTipo: Integer): Boolean;
begin
if mem_CADP01D.IsEmpty then
   begin
   Tb_DevCli.Close;
   result:=true;
   exit;
   end;

la_tabelas  :='';
la_Join     :='';
la_instrucao:='';
la_empresas :='';
fInnerJoin4(1,'CADP02','P2CODEMP','P1CODEMP','P2LOTSEQ','P1LOTSEQ','P2CHAVE','P1CHAVE','P2ORDEM','P1ORDEM');
la_instrucao:=la_instrucao+' and ';
fInnerJoin(1,'CADPRO','PDCODEMP', 'P2CODEMP','PDCODPRO' ,'P2CODPRO');

Tb_DevCli.Close;
Tb_DevCli.SQL.Clear;
Tb_DevCli.SQL.Add('Select SUM(P1TOTALL) AS P1TOTALL, SUM(P1TOTDES) AS P1TOTDES, max(P1ALIQDEB) as P1ALIQDEB,  '
                 +' sum(P2QTD) as P2QTD,sum(P2QTDDEV) as P2QTDDEV, max(P2ITEM) AS P2ITEM, '
                 +' sum(P2TOTLIQ-P2DESCRAT) AS P2TOTLIQ,sum(P2TOTDES) AS P2TOTDES, '
                 +' max(P2CODEMP) as P2CODEMP, '
                 +' sum(NVL(P2QTD_ENTREGUE,0)) AS P2QTD_ENTREGUE,'
                 +' sum(NVL(P2QTD_ENTREGANDO,0)) AS P2QTD_ENTREGANDO,'
                 +' sum((P2TOTLIQ-P2DESCRAT)/P2QTD) AS PcoLiqDev, '
                 +' max(p2nompro_ori) as P2NOMPRO_ORI, '
                 +' max(P2PRECO) AS P2PRECO, '
                 +' max(P2PCOMAX) AS P2PCOMAX, '
                 +' max(P2DESC1) AS P2DESC1, '
                 +' max(P2DESC2) AS P2DESC2, '
                 +' max(P2DESC3) AS P2DESC3, '
                 +' max(P2PDESCF) AS P2PDESCF, '
                 +' max(P2PCOMIS) AS P2PCOMIS, '
                 +' max(P2PCOM02) AS P2PCOM02, '
                 +' max(P2PCOM03) AS P2PCOM03, '
                 +' sum(P2VALDES) AS P2VALDES, '
                 +' min(P2ST_IVA) AS P2ST_IVA, '
                 +' min(P2ST_REDUT) AS P2ST_REDUT, '
                 +' min(P2ST_ICMCRED) AS P2ST_ICMCRED, '
