function tFrm_Ped_02.fratearipi(ptipo:Integer): Boolean;
var
  mdifteste : Real;
begin
  BlqEventoPed02:=true;

  QryItem_Nota.First;
  while (not QryItem_Nota.Eof) and (mdifipi<>0) do
     begin
     if QryItem_NotaP2CODPRO.IsNull then begin
        QryItem_Nota.Next;
        Continue;
     end;

     if QryItem_NotaP2ALIPI.AsFloat=0 then begin
        QryItem_Nota.Next;
        Continue;
     end;

     if mdifipi>0 then begin
        mdifteste:=QryItem_NotaP2TOTLIQ.Value-QryItem_NotaP2VALIPI.Value;

        if mdifteste>0 then begin
           if mdifteste<mdifipi then begin
              QryItem_Nota.Edit;
              QryItem_NotaP2VALIPI.Value:=QryItem_NotaP2VALIPI.Value+mdifteste;
              mPd_totipi             :=mPd_totipi+mdifteste;
              FExibirtotais(0);
              mdifipi:=mdifipi-mdifteste;
              QryItem_Nota.Post;
           end else begin
              QryItem_Nota.Edit;
              QryItem_NotaP2VALIPI.Value:=QryItem_NotaP2VALIPI.Value+mdifipi;
              mPd_totipi             :=mPd_totipi+mdifipi;
              FExibirtotais(0);
              QryItem_Nota.Post;
              mdifipi:=0;
           end;
        end;
     end else begin
        if QryItem_NotaP2VALIPI.AsFloat<>0 then begin
           if QryItem_NotaP2VALIPI.Value>(mdifipi*-1) then begin
              QryItem_Nota.Edit;
              QryItem_NotaP2VALIPI.Value:=QryItem_NotaP2VALIPI.Value+mdifipi;
              mPd_totipi             :=mPd_totipi+mdifipi;
              mdifipi:=0;
              FExibirtotais(0);
              QryItem_Nota.Post;
           end else begin
              QryItem_Nota.Edit;
              if (mdifipi*-1)>QryItem_NotaP2VALIPI.Value then begin
                 mdifipi:=mdifipi+QryItem_Notap2VALIPI.Value;
                 mPd_totipi             :=mPd_totipi-QryItem_NotaP2VALIPI.Value;
                 QryItem_NotaP2VALIPI.Value:=0;
              end else begin
                 mPd_totipi             :=mPd_totipi+mdifipi;
                 QryItem_NotaP2VALIPI.Value:=QryItem_NotaP2VALIPI.Value+mdifipi;
                 mdifipi:=0;
              end;
              FExibirtotais(0);
              QryItem_Nota.Post;
           end
        end;
     end;

     QryItem_Nota.Next;
   end;

   BlqEventoPed02:=false;
   result:=True;
end;



