procedure Tfrm_ped_02.btn_gravAddExtraClick(Sender: TObject);
begin
if trim(edt_descaddext.Text)<>'' then
  begin
  if pOpAddExt=0 then
    cdsAddExtra.Append
  else
    cdsAddExtra.Edit;
  cdsAddExtraDESCADDEXT.AsString:=edt_descaddext.Text;
  cdsAddExtraVALADDEXT.AsFloat  :=ce_valaddext.Value;
  cdsAddExtra.Post;
  edt_descaddext.Clear;
  ce_valaddext.Clear;
  edt_descaddext.SetFocus;
  pOpAddExt:=0;
  end;
end;

procedure Tfrm_ped_02.Alterar1Click(Sender: TObject);
begin
edt_descaddext.Text:=cdsAddExtraDESCADDEXT.AsString;
ce_valaddext.Value:=cdsAddExtraVALADDEXT.AsFloat;
edt_descaddext.SetFocus;
pOpAddExt:=1;
end;

procedure Tfrm_ped_02.TsAddExtExit(Sender: TObject);
begin
pOpAddExt:=0;
edt_descaddext.Clear;
ce_valaddext.Clear;
end;

procedure Tfrm_ped_02.Excluir1Click(Sender: TObject);
begin
if (not cdsAddExtraDESCADDEXT.IsNull) and (not cdsAddExtraVALADDEXT.IsNull) then
  begin
  edt_descaddext.Clear;
  ce_valaddext.Clear;
  cdsAddExtra.Delete;
  end;
end;

