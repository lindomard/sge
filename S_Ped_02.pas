function tFrm_Ped_02.flQrPedfp(ptipo,pFormaCe: Integer;pInstru: String): Boolean;
{
ptipo=0-Normal registro por registro
     =1-Somando os Valores

}
begin


DM1.Query2.Close;
DM1.Query2.SQL.Clear;
DM1.Query2.SQL.add('Select ');
if ptipo=0 then
   begin
   DM1.Query2.SQL.Add(' * ');
   DM1.Query2.SQL.Add(' from CADPFP where '+pInstru);
   end
else
   begin
   DM1.Query2.SQL.Add('       min(PFPCODEMP) as  PFPCODEMP,'
                   +'       min(PFPLOTSEQ) as  PFPLOTSEQ, '
                   +'       min(PFPCHAVE)  as  PFPCHAVE, '
                   +'       sum(PFPVALOR) aS PFPVALOR, '
                   +'       PFPSEQ, '
                   +'       PFPVINCULO,'
                   +'       PFPFORMA, '
                   +'       PFPNOMFOR, '
                   +'       PFPDATA as PFPDATA,'
                   +'       PFPNUMDOC, '
                   +'       PFPBANCO, '
                   +'       PFPSERIE, '
                   +'       PFPCC, '
                   +'       PFPCOMP, '
                   +'       PFPAGENCIA, '
                   +'       PFPEMITENTE, '
                   +'       PFPCNPF, '
                   +'       PFPRG, '
                   +'       PFPDTNAS as PFPDTNAS '
                   +'      ,PFPFPGTO '
                   +'    ,PFPDEV_CODEMP '
                             +'    ,PFPDEV_CODECF '
                             +'    ,PFPDEV_NUMERO '
                             +'    ,PFPDEV_DESD '
                             +'    ,PFPDEV_DUP '
                             +'    ,PFPDEV_DTEMIS '
                             +'    ,PFPPRAZO '



                   +'       from CADPFP where '
                   +pInstru
                   +' group by PFPSEQ, '
                   +'       PFPVINCULO,'
                   +'       PFPFORMA, '
                   +'       PFPNOMFOR, '
                   +'       PFPDATA, '
                   +'       PFPNUMDOC, '
                   +'       PFPBANCO, '
                   +'       PFPSERIE, '
                   +'       PFPCC, '
                   +'       PFPCOMP, '
                   +'       PFPAGENCIA, '
                   +'       PFPEMITENTE, '
                   +'       PFPCNPF, '
                   +'       PFPRG, '
                   +'       PFPDTNAS '
                   +'       ,PFPFPGTO '
                   +'    ,PFPDEV_CODEMP '
                             +'    ,PFPDEV_CODECF '
                             +'    ,PFPDEV_NUMERO '
                             +'    ,PFPDEV_DESD '
                             +'    ,PFPDEV_DUP '
                             +'    ,PFPDEV_DTEMIS '
                             +'    ,PFPPRAZO '
                             );

   end;

DM1.Query2.SQL.Add(' order by PFPCHAVE,PFPSEQ');
try
   DM1.Query2.open;
except
  error:=SALVA_NOME('c:\sge\errosql\','exp');
  DM1.Query2.SQL.SaveToFile(error);
  ShowMessage('Log de error '+error);
