   DM1.Query1.SQL.Clear;
   DM1.Query1.SQL.Add('Select P1DATAP,P1CHAVE,P1CODEMP,P1TOTALL from CADP01 where '
                     +' P1MOTIVO=:MOTIVO '
                     +' and P1STATUS=9 ');
   DM1.Query1.ParamByName('MOTIVO').AsString:='Resumido/Faturado no Pedido: '+fdeixanum(edt_CHAVE.Text)+'. ';
   try
      DM1.Query1.Open;
   except
      end;
   mcinst2:='';
   if not DM1.Query1.isempty then
      begin
      mcinst2:=mcinst2+insere('-','-',80)+#13;
      mcinst2:=mcinst2+centra('ORIGEM','-',80)+chr(13);
      mcinst2:=mcinst2+insere('-','-',80)+chr(13);
      While not DM1.Query1.Eof do
         begin
         mcinst2:=mcinst2+'Chave: '+FormatFloat('00000000', DM1.Query1.FieldbyName('P1CHAVE').AsFloat)
                                     +' Data: '+FormatDateTime(fdt2,DM1.Query1.FieldbyName('P1DATAP').AsFloat)
                                     +' Valor: '+insere2(FormatFloat(mcasas, DM1.Query1.fieldbyName('P1TOTALL').AsFloat),' ',15)+chr(13);
         DM1.Query1.Next;
         end;
      end;
   MessageBox(Application.Handle, PChar(mCinst2), 'Origens', MB_ICONINFORMATION + MB_OK);
   end;


