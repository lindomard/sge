procedure TFrm_Ped_02.edt_loteKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
if (mPd_Oper_item=1) and (key=27) then
   begin
   LimpaEditsPedidos(0);
   mPd_Oper_item         := 0;
   edt_codproduto.SetFocus;
   end
else if key = vk_F3 then
   begin
   if form_ConsLot_ped_02=nil then
      Application.CreateForm(TFrm_ConsLot,form_ConsLot_ped_02)
   else begin
       form_ConsLot_ped_02.free;
       form_ConsLot_ped_02:=nil;
       Application.CreateForm(Tfrm_ConsLot,form_ConsLot_ped_02);
   end;
      flcadlgc(0,0,0,edt_codproduto.Text,'','');
      form_ConsLot_ped_02.CODPRO.Text:=edt_codproduto.Text;
      form_ConsLot_ped_02.NOMPRO.Text:=edt_descricao.Text;
      form_ConsLot_ped_02.CODPRO.Enabled:=True;
      if valint(copy(mpseg,4,2))=2 then
         begin
         form_ConsLot_ped_02.Caption:='Consulta no arquivo de Grades';
         form_ConsLot_ped_02.DBGrid1.Columns[0].Visible:=false;
         form_ConsLot_ped_02.DBGrid1.Columns[1].Title.Caption:='Grade';
         end;
      form_ConsLot_ped_02.mConsLotOrigem:=1;
      fAtualizaForm(0);
      form_ConsLot_ped_02.FormStyle:=fsNormal;
      form_ConsLot_ped_02.Visible:=false;

      form_ConsLot_ped_02.ShowModal;
      if trim(form_ConsLot_ped_02.plote)<>'' then
         begin
         edt_lote.Text  :=form_ConsLot_ped_02.pLote;
         edt_dtvcto.Text:=form_ConsLot_ped_02.pdtvcto;
         end;
      FreeAndNil(form_ConsLot_ped_02);
   end;
end;

