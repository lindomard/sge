function tFrm_Ped_02.fPed01lerant(ptipo: Integer):Boolean;
var
  x,mcod  : Integer;
  minstru : String;
  v       : String;
begin
  minstru:=' Select ';
  v:='';
  for x:=0 to Qr_Ped01.FieldCount-1 do begin
      if Qr_Ped01.Fields[x].FieldKind=fkCalculated then
         Continue;
      minstru:=minstru+v+Qr_Ped01.Fields[x].FieldName;
      v:=',';
  end;

  minstru:=minstru+' from OLD_CADP01 where P1CODNOV=0'+DM1.Qr_EventoCODNOV.AsString;
  Qr_Ped01.Close;
  Qr_Ped01.SQL.Clear;
  Qr_Ped01.SQL.add(minstru);
  Qr_Ped01.Open;
  fAtualizarBotoes(3);


  Result:=True;
end;

