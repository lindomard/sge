         mem_cadpfp.Close;
         mCodFp:=DM1.Tb_PVPVVINCULO.AsFloat;
         fGerarFormas_ped02(iif(Qr_Ped01P1TABPV.Value='PP',1,0),0)
         end;
      end;
   end;


if mpd_pvtdc = 0 then
   edt_desconto01.Text := FormatFloat(mcasas, mpvdes)
else if mpd_pvtdc = 1 then
   edt_desconto01.Text := FormatFloat(mcasas, DM1.Tb_CliCDESC.Value);

if mpd_pvtdc = 5 then
   begin
   txts_comis.ReadOnly  :=false;
   edt_comissao.ReadOnly:=false;
   end
else
