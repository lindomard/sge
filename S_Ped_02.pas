       mem_cadpfp.Edit;
       if (cb_recalcula_periodo.Checked) then
         begin
         mem_cadpfpPFPDATA.AsDateTime:=Date+mem_cadpfpPFPPRAZO.AsInteger;
//         mem_cadpfpPFPDATA.AsDateTime:=StrtoDate(edt_datapedido.Text)+mem_cadpfpPFPPRAZO.AsInteger;
         end
       else if (mem_cadpfpPFPDATA.AsDateTime<Date) then
         begin
         mem_cadpfpPFPDATA.AsDateTime:=Date+mem_cadpfpPFPPRAZO.AsInteger;
         end;
//       mem_cadpfpPFPDATA.AsDateTime:=Date+mem_cadpfpPFPPRAZO.AsInteger;
       mem_cadpfp.Post;
       mem_cadpfp.Next;
       end;
     end;


   if not QryItem_Nota.Active then
      exit;



   mValidaPedServ:=false;
   FPD_RecalcularTudo(1);
   mValidaPedServ:=true;
   if TOTEXTCOM.Value>0 then
     TOTEXTCOMExit(self);

end;

procedure TFrm_Ped_02.btn_excluirClick(Sender: TObject);
var
 mtitulosBaixados : Boolean;
 aceita           : Boolean;
 minc             : String;
 pcodemp          : Integer;
 mqtdman          : Integer;
 mResult          : Integer;
 mMotivo_Exclusao: String;

begin
if Trim(edt_chave.Text) = '' then
   begin
   fmensagem('Favor localiar registro, para exclusão do mesmo!',0,['0'],0);
   Panel_cabecalho.SetFocus;
   Exit;
   end;

Qr_Ped01.First;

mqtdman := Qr_Ped01P1QTDMAN.AsInteger;
Qr_Ped01.Close;
Qr_Ped01.Open;

if Qr_Ped01.Eof then
   begin
   fmensagem('Este Pedido ja foi Excluido anteriormente!',0,['0'],0);
   fLimparTudo(0);
   exit;
   end;

if (Qr_Ped01submod.Value>0) and (Qr_Ped01submod.Value<100) then
   begin
   if Qr_Ped01.RecordCount<2 then
      begin
      fmensagem('Exclusão Invalida Pedido nao esta 100%',0,['0'],0);
      exit;
      end;
   end;

if (Qr_Ped01P1SITPED.Value = 1) and ( (Qr_Ped01P1DATHOR_ULTEVE.AsDateTime>pdatanula)
   and (trunc((now-Qr_Ped01P1DATHOR_ULTEVE.AsDateTime))*24*60<=1))
   and (not mpd_RestaurandoPedido) then
   begin
   mcinst2:=Qr_Ped01P1CODUSR.AsString+' - ';
   if Qr_Ped01P1CODUSR.AsInteger=1111 then
      mcinst2:=mcinst2+'Programador(Master)'
   else
      begin
      if flcadusr(0,0,Qr_Ped01P1CODUSR.AsString) then
         mcinst2:=mcinst2+DM4.Tb_UsrNOMUSR.AsString;
      end;
   mcinst := 'Este Pedido Sendo Alterado no Computador: '+Qr_Ped01P1COMP_ULTEVE.AsString
           + ' Pelo Usuário: '+mcinst2
           + ' Data/Hora: '+Formatdatetime('dd/mm/yyyy hh:nn:ss', Qr_Ped01P1DATHOR_ULTEVE.AsDateTime);
   fMensagem(mcinst,0,['0'],0);
   exit;
   end;

if Qr_Ped01P1QTDMAN.Value>mqtdman then
   begin
   mPd_Oper_Ped:=3;
   btn_localizar.Click;

   if (Qr_Ped01P1SITPED.Value = 1) and ( (Qr_Ped01P1DATHOR_ULTEVE.AsDateTime>pdatanula)
      and (trunc((now-Qr_Ped01P1DATHOR_ULTEVE.AsDateTime))*24*60<=1))
      and (not mpd_RestaurandoPedido) then
      begin
      mcinst2:=Qr_Ped01P1CODUSR.AsString+' - ';
      if Qr_Ped01P1CODUSR.AsInteger=1111 then
         mcinst2:=mcinst2+'Programador(Master)'
      else
         begin
         if flcadusr(0,0,Qr_Ped01P1CODUSR.AsString) then
            mcinst2:=mcinst2+DM4.Tb_UsrNOMUSR.AsString;
         end;
      mcinst := 'Este Pedido Sendo Alterado no Computador: '+Qr_Ped01P1COMP_ULTEVE.AsString
              + ' Pelo Usuário: '+mcinst2
              + ' Data/Hora: '+Formatdatetime('dd/mm/yyyy hh:nn:ss', Qr_Ped01P1DATHOR_ULTEVE.AsDateTime);
      fMensagem(mcinst,0,['0'],0);
      exit;
      end;
   end;

if (Qr_Ped01P1STATUS.Value>6) then
   begin
   fMensagem('Favor Utilizar Outro Recurso para Esta Exclusão!',0,['0'],0);
   exit;
   end;

if mpd_ordem<>0 then
   begin
   fMensagem('Exclusão invalida favor selecionar o pedido completo',0,['0'],0);
   exit;
   end;

if (DM1.Tb_PargerPQTDDBLOQPED.AsFloat<>0) then
   begin
   if (Qr_Ped01P1DATAP.Value+DM1.Tb_PargerPQTDDBLOQPED.AsFloat)>pdatasis then
      begin
      if (Qr_Ped01P1NUMCF.Value>0) or (Qr_Ped01P1NUMNF.Value>0) then
          begin
          fMensagem('Não Pode ser Excluido o Pedido! '+#13
                   +'Quantidade de dias máximo: '+DM1.Tb_PargerPQTDDBLOQPED.AsString
                    ,0,['0'],0);
          exit;
        end;
      end;
   end;

if (Qr_Ped01P1NUMCF.Value>0)  then
   begin
   minc:='Este Pedido Possui o Cupom de Numero: '+FormatFloat('000000',Qr_Ped01P1NUMCF.Value);
   minc:=minc+#13+'Este cupom não sera cancelado utilizando esta opção';
   minc:=minc+#13+'Mesmo assim quer prosseguir?';

   if fmensagem(pchar(minc),0,['1','2'],0)<>mrYes then
      exit;
   end;

aceita:=True;
mtitulosBaixados:=false;
Qr_Ped01.First;

While not Qr_Ped01.Eof do
   begin
   if flcaddar(9,Qr_Ped01P1CODEMP.AsInteger,0,codecf,0,Qr_Ped01P1CHAVE.AsString,Qr_Ped01P1ORDEM.AsString,Qr_Ped01P1LOTSEQ.AsString,Qr_Ped01P1DATDOC.AsDateTime,'') then
      begin
      While not DM1.Tb_Dar.Eof do
         begin
         if (DM1.Tb_DarCRSTATUS.Value>0) and ((DM1.Tb_DarCRLOTE.Value<>0) or (DM1.Tb_DarCRVALPAG.AsFloat>0)) then
            begin
            mtitulosBaixados:=true;
            aceita:=false;
            end;
         DM1.Tb_Dar.Next;
         end;
      end;
   Qr_Ped01.Next;
   end;

Qr_Ped01.First;
if DM1.Tb_PargerPEXCFP_EXCPED.Value<>1 then
   begin
   if not aceita then
      begin
      fMensagem('Ha títulos pagos deste pedido cancelar primeiro as baixas!',0,['0'],0);
      exit;
      end;
   end;

DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.add('Select count(*) from CADRM1 where '
                  +iif(DM1.Qr_TID.Locate('TINOME','CADPED',[]),'',' R1_CODEMP=0'+IntToStr(codemp)+' and ')
                  +' R1_LOTSEQ=0'+IntToStr(mPd_LotSeq)+' and '
                  +' R1_CHAVE=0'+Qr_Ped01P1CHAVE.AsString);
DM1.Query1.Open;

if DM1.Query1.Fields[0].AsInteger>0 then
   begin
   if DM1.Query1.Fields[0].AsInteger=1 then
      fMensagem('Existe '+DM1.Query1.Fields[0].AsString+' Romaneio Para Este Pedido. Favor Exclui-lo Primeiro!',0,['0'],0)
   else
      fMensagem('Existem '+DM1.Query1.Fields[0].AsString+' Romaneios Para Este Pedido. Favor Exclui-los Primeiro!',0,['0'],0);
   exit;
   end;


if (Qr_Ped01P1SITPED.Value = 1) and ( (Qr_Ped01P1DATHOR_ULTEVE.AsDateTime>pdatanula)
   and (trunc((now-Qr_Ped01P1DATHOR_ULTEVE.AsDateTime))*24*60<=1))
   and (not mpd_RestaurandoPedido) then
   begin
   mcinst2:=Qr_Ped01P1CODUSR.AsString+' - ';
   if Qr_Ped01P1CODUSR.AsInteger=1111 then
      mcinst2:=mcinst2+'Programador(Master)'
   else
      begin
      if flcadusr(0,0,Qr_Ped01P1CODUSR.AsString) then
         mcinst2:=mcinst2+DM4.Tb_UsrNOMUSR.AsString;
      end;
   mcinst := 'Este Pedido Sendo Alterado no Computador: '+Qr_Ped01P1COMP_ULTEVE.AsString
           + ' Pelo Usuário: '+mcinst2
           + ' Data/Hora: '+Formatdatetime('dd/mm/yyyy hh:nn:ss', Qr_Ped01P1DATHOR_ULTEVE.AsDateTime);
   fMensagem(mcinst,0,['0'],0);
   exit;
   end;

if fmensagem('Quer realmente excluir este pedido?',0,['1','2'],0)<>mrYes then
   exit;


While true do
   begin
   mMotivo_Exclusao:='';
   if not InputQuery('Motivo da Exclusao!','Digite o Motivo da Exclusao:',mMotivo_Exclusao) then
      break;
   mMotivo_Exclusao:=trim(mMotivo_Exclusao);
   if length(mMotivo_Exclusao)<15 then
      begin
      fmensagem('O Motivo Tem que ter pelo menos quinze letras!',0,['0'],0);
      continue;
      end;
   if trim(mMotivo_Exclusao)<>'' then
      break;
   end;

if trim(mMotivo_Exclusao)='' then
   exit;


Qr_Ped01.First;

Res1:='';
flcadpar01(0,Qr_Ped01P1CODEMP.AsInteger,'1');

if Qr_Ped01P1STATUS.Value=2 then
   begin
   if fValidaSenha(0,codusr,4,0,DM1.Tb_CliCCODCLI.Value,0,0,0,'Senha para Excluir o Pedido apos a emissão da nota fiscal','')<>0 then      exit;
   end
else
   begin
   if fValidaSenha(0,codusr,3,0,DM1.Tb_CliCCODCLI.Value ,0,0,0,'Senha para Excluir o Pedido','')<>0 then
      exit;
   end;


if mPd_ChaveTerc=Qr_Ped01P1CHAVE.AsInteger then
   mPd_ChaveTerc:=0;

Qr_Ped01.First;

if mtitulosBaixados then
   begin
   if not fPed01ExcluiPagamento(0,Qr_Ped01) then
      begin
      verteclado(0);
      fMensagem('Não foi possível excluir a(s) forma(s) de Pagamento automaticamente,'+#13
                +'Favor exluir manualmente!',0,['0'],0);
      exit;
      end;
   end;
// INICIO

if mPd_ChaveTerc=Qr_Ped01P1CHAVE.AsInteger then
   mPd_ChaveTerc:=0;
Qr_Ped01.First;
While not Qr_Ped01.Eof do
   begin
   if (Qr_Ped01P1CODEMP.AsFloat<100) and (Qr_Ped01P1status.AsFloat>1)
      and (Qr_Ped01P1NUMNF.AsFloat>0)  then

      begin
      if DM4.Tb_ParGer02PG2USANFE.AsInteger>0 then
         begin
         if Qr_Ped01P1NFE_ENVXML.AsFloat=9 then
            begin
            if pdatasis<Date then
               pdatasis:=Date;
            if (pdatasis-Qr_Ped01P1DATANF.AsDateTime)>1 then
                begin
                fmensagem('Esta nota Fiscal não Permitido o Cancelamento pelo SEFAZ'
                         +'Mais de 1 dias apos a emissão!',0,['0'],0);
                exit;
                end;
            mResult:=fCancelarNFE(Qr_Ped01P1CODEMP.AsFloat,Qr_Ped01P1LOTSEQ.AsFloat,
                   Qr_Ped01P1CHAVE.AsFloat,Qr_Ped01P1ORDEM.AsFloat,
                   Qr_Ped01P1NUMNF.AsFloat,mMotivo_Exclusao,true );
            if mResult<>0 then
               begin
               fmensagem('erro '+IntTostr(mResult)+' ao validar o xml!',0,['0'],0);
               exit;
               end;


            mResult:=fCancelarNFE(Qr_Ped01P1CODEMP.AsFloat,Qr_Ped01P1LOTSEQ.AsFloat,
                   Qr_Ped01P1CHAVE.AsFloat,Qr_Ped01P1ORDEM.AsFloat,
                   Qr_Ped01P1NUMNF.AsFloat,mMotivo_Exclusao,false);
            if mResult<>0 then
               begin
               fmensagem('erro '+IntTostr(mResult)+' ao validar o xml!',0,['0'],0);
               exit;
               end;
            end
         else
            begin

            DM1.Query2.Close;
            DM1.Query2.SQL.Clear;
            DM1.Query2.SQL.Add('SELECT NSNFE_CHAVEACESSO,NSNFE_DCHAVEACESSO'
                              +',NSNUMERO,NSTOTNOTA,NSNFE_NUMPROT,NSDTEMIS,NSSERIE FROM CADNS where '
                              +iif(DM1.Qr_TID.locate('TINOME','CADNS',[]),'',' NSCODEMP=0'+Qr_Ped01P1CODEMP.AsString+' and ')
                              +' NSLOTSEQ_CP=0'+Qr_Ped01P1LOTSEQ.AsString
                              +' and NSCHAVEP=0'+Qr_Ped01P1CHAVE.AsString
                              +' and NSORDEMP=0'+Qr_Ped01P1ORDEM.AsString
                              +' and NSNUMERO=0'+Qr_Ped01P1NUMNF.AsString);
            DM1.Query2.Open;
            if DM1.Query2.IsEmpty then
               begin
               fmensagem('Erro ao Procurar a Nota Fiscal: '+Qr_Ped01P1NUMNF.AsString,0,['0'],0);
               exit;
               end;

            if valint(DM1.Query2.FieldByName('NSSERIE').AsString)=0  then  //  serie
               begin
               DM1.Query1.close;
               DM1.Query1.SQL.clear;
               DM1.Query1.SQL.Add('Select PNF_SERIE from CADPAR_NF where PNF_CODEMP=:CODEMP '
                                 +' and PNF_CHAVE=:CHAVE ');
               DM1.Query1.ParamByName('CODEMP').AsInteger:=DM4.Qr_Ped01P1CODEMP.AsInteger;
               DM1.Query1.ParamByName('CHAVE').Value     :=DM1.Query2.fieldbyname('NSTIPDOC').AsString;
               DM1.Query1.Open;
               mcinst:=dm1.Query1.FieldbyName('PNF_SERIE').AsString;
               end
            else
               mcinst:=DM1.Query2.FieldByName('NSSERIE').AsString;
            mResult:=fInutilizarNFE(
                                    DM4.Qr_Ped01P1CHAVE.Asinteger,
                                    DM4.Qr_Ped01P1LOTSEQ.Asinteger,
                                    DM4.Qr_Ped01P1CODEMP.Asinteger,

            mMotivo_Exclusao,
            mcinst,valint(formatDateTime('yyyy',DM1.Query2.FieldbyName('NSDTEMIS').AsDateTime)),
            DM1.Query2.fieldbyName('NSNUMERO').AsInteger,
            DM1.Query2.fieldbyName('NSNUMERO').AsInteger,true);
            if mResult<>0 then
               begin
               fmensagem('erro '+IntTostr(mResult)+' ao validar o xml!',0,['0'],0);
               exit;
               end;



            if valint(DM1.Query2.FieldByName('NSSERIE').AsString)=0  then  //  serie
               begin
               DM1.Query1.close;
               DM1.Query1.SQL.clear;
               DM1.Query1.SQL.Add('Select PNF_SERIE from CADPAR_NF where PNF_CODEMP=:CODEMP '
                                 +' and PNF_CHAVE=:CHAVE ');
               DM1.Query1.ParamByName('CODEMP').AsInteger:=DM4.Qr_Ped01P1CODEMP.AsInteger;
               DM1.Query1.ParamByName('CHAVE').Value     :=DM1.Query2.fieldbyname('NSTIPDOC').AsString;
               DM1.Query1.Open;
               mcinst:=dm1.Query1.FieldbyName('PNF_SERIE').AsString;
               end
            else
               mcinst:=DM1.Query2.FieldByName('NSSERIE').AsString;
            mResult:=fInutilizarNFE(
                                    DM4.Qr_Ped01P1CHAVE.Asinteger,
                                    DM4.Qr_Ped01P1LOTSEQ.Asinteger,
                                    DM4.Qr_Ped01P1CODEMP.Asinteger,

            mMotivo_Exclusao,
            mcinst,valint(formatDateTime('yyyy',DM1.Query2.FieldbyName('NSDTEMIS').AsDateTime)),
            DM1.Query2.fieldbyName('NSNUMERO').AsInteger,
            DM1.Query2.fieldbyName('NSNUMERO').AsInteger,false);
            if mResult<>0 then
               begin
               fmensagem('erro '+IntTostr(mResult)+' ao Inutilizar NFE!',0,['0'],0);
               exit;
               end;
            end;
         end;
      end;

   if (Qr_Ped01P1LTACERTO.Value>0) then
      begin
      if (mPd_EntraRVenda) or (mPd_EntraCons) then
         begin
         fAjustaAcerto(Qr_Ped01P1LTACERTO.Value,0);
         end
      else if (mPd_SaiRVenda) or (mPd_SaiCons) then
         begin
         fAjustaAcerto(Qr_Ped01P1LTACERTO.Value,1);
         end
      else
         fAjustaAcerto(Qr_Ped01P1LTACERTO.Value,2);
      end;

   fped01gant(9,Qr_ped01);
   Qr_Ped01.Next;
   end;
Qr_Ped01.First;
if Qr_Ped01P1NFE_ENVXML.AsFloat=9 then
   fExcluirPedido(9,mMotivo_Exclusao,frm_ped_02.Qr_Ped01)
else
   fExcluirPedido(8,mMotivo_Exclusao,frm_ped_02.Qr_Ped01);

//TERMINO
if not QryItem_Nota.IsEmpty then
   begin
   QryItem_Nota.First;
   while not QryItem_Nota.Eof do
      begin
      varItem := QryItem_Nota.RecordCount;
