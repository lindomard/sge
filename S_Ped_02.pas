   begin
   if (DM1.Tb_CliCCNPJ.AsFloat=0) and (DM1.Tb_CliCCPF.AsFloat=0) then
      begin
      Frm_Sintegra_Advert.Memo_NFSNaoEnc.Lines.Add('CNPJ ou CPF do Cliente Campo Obrigatorio e nao Esta Preenchido!');
      end
   else if (DM1.Tb_CliCCNPJ.AsFloat>0) then
      begin
      if length(DM1.Tb_CliCIE.AsString)<2 then
         Frm_Sintegra_Advert.Memo_NFSNaoEnc.Lines.Add('Inscricao Estadual do Cliente Campo Obrigatorio e nao Esta Preenchido!');
      end
   else if (DM1.Tb_CliCCPF.AsFloat>0) then
      begin
      if length(DM1.Tb_CliCRG.AsString)<2 then
         Frm_Sintegra_Advert.Memo_NFSNaoEnc.Lines.Add('RG(Identidade) do Cliente Campo Obrigatorio e nao Esta Preenchido!');
      end
   end;
if pLocal<1 then
   begin
   if (CB_RCLI_ASSESSOR.Checked) and (fSonumero(edt_assessor.Text)=0) then
      Frm_Sintegra_Advert.Memo_NFSNaoEnc.Lines.Add('Codigo do Assessor Campo Obrigatorio e nao Esta Preenchido!');
   if pTabPv='AP' then
      begin
      if (CB_RCLI_INFCOMP.Checked) then
         begin
         if (not (DM4.Tb_Cli_IC.Active)) or (DM1.Tb_CliCCODCLI.AsFloat<>DM4.Tb_ICliCI_CODCLI.AsFloat) then
            begin
            if not flcadcli_ic(1,0,DM1.Tb_CliCCODCLI.AsString) then
               Frm_Sintegra_Advert.Memo_NFSNaoEnc.Lines.Add('Informacoes Complementar Campo Obrigatorio e nao Esta Preenchido!');
            end
         end;
      if (CB_RCLI_INFPES.Checked) then
         begin
         if (not (DM4.Tb_Cli_RefPes.Active)) or (DM1.Tb_CliCCODCLI.AsFloat<>DM4.Tb_Cli_RefPesRP_CODCLI.AsFloat) then
            begin
            if not flcadcli_ic(1,0,DM1.Tb_CliCCODCLI.AsString) then
               Frm_Sintegra_Advert.Memo_NFSNaoEnc.Lines.Add('Informacoes Complementar Campo Obrigatorio e nao Esta Preenchido!');
            end
         end;

      if (CB_RCLI_DADCHQ.Checked) then
         begin
         if (length(trim(edt_obs1.Text))<2) and
            (length(trim(edt_obs2.Text))<2) and
            (length(trim(edt_obs3.Text))<2) then
             Frm_Sintegra_Advert.Memo_NFSNaoEnc.Lines.Add('Observacao do Pedido Campo Obrigatorio e nao Esta Preenchido!');
         end;
      end;
   end;
if length(trim(Frm_Sintegra_Advert.Memo_NFSNaoEnc.Text))>2 then
   begin
   fAtualizaForm(0);
   Frm_Sintegra_Advert.FormStyle:=fsNormal;
   Frm_Sintegra_Advert.Visible:=false;

   Frm_Sintegra_Advert.ShowModal;
   Frm_Sintegra_Advert.free;
   Frm_Sintegra_Advert:=nil;
   result:=false;
   exit;
   end;
Frm_Sintegra_Advert.free;
Frm_Sintegra_Advert:=nil;
result:=true;
end;

