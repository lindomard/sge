          exit;
          end;
        end;
      fMaiorDevol(1,edt_codproduto.Text,edt_lote.Text,edt_dtvcto.Text);
      end;
    if (mPd_Oper_item=1) and (QryItem_NotaP2CODPRO.AsFloat<>pRet_CodPro) then
      edt_precounitario.Value  := pRet_Preco_Unit
    else if ((cb_tipopreco.ItemIndex=2) or (cb_tipopedido.ItemIndex=7))  and ((mpd_ant_codpro<>0) and (mpd_ant_codpro<>pRet_codpro)) then
      edt_precounitario.Value  := pRet_Preco_Unit
    else if cb_tipopreco.itemindex<>2 then
      edt_precounitario.Value  := pRet_Preco_Unit
    else if edt_precounitario.Value=0 then
      edt_precounitario.Value  := pRet_Preco_Unit;
    edt_codproduto.Text        := FloatToStr(pRet_Codpro);
    if (cb_tipopreco.ItemIndex=3) then
      begin
      if ((mpd_ant_codpro=0) or (mpd_ant_codpro<>pRet_codpro)) then
        begin
        edt_desc1.Value          := pRet_DescI01;
        edt_desc2.Value          := pRet_DescI02;
        edt_desc3.Value          := pRet_DescI03;
        edt_descfin.Value        := pRet_DescFin;
        if mpd_pvtc<>5 then
          edt_comissao.Value     := pRet_PComV01;
        end;
      if (cb_tipopreco.ItemIndex=3) or (cb_tipopreco.ItemIndex=7)  then
        edt_desc1Exit(self);
      edt_precounitarioExit(self);
      end
    else
      begin
      edt_desc1.Value          := pRet_DescI01;
      edt_desc2.Value          := pRet_DescI02;
      edt_desc3.Value          := pRet_DescI03;
      edt_descfin.Value        := pRet_DescFin;
      if mpd_pvtc<>5 then
        edt_comissao.Value     := pRet_PComV01;
      end;
    end;
  end
else
  begin
  edt_lote.Clear;
  edt_descricao.Clear;
  edt_secao.Clear;
  edt_refer.Clear;
  edt_complemento.Clear;
  edt_ambiente.Clear;
