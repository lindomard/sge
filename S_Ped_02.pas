         begin
         if (mpd_Estoque[0]-fQtdBlqSac(codemp,DM1.Tb_ProPDCODPRO.AsFloat
                                     ,edt_lote.Text))<=0 then
             begin
             if mAceita_pergunta then
                begin
                if fmensagem('Produto bloqueado pelo Controle de Qualidade ou SAC, Venda não Permitida',0,['0'],0)=mrYes then
                   begin
                   if not mPd_FaturandoPedido then
                     edt_quantidade.SetFocus;
                   abort;
                   exit;
                   end;
                end;
             end;

         end;
      end;
   end;
