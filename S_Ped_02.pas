function tFrm_Ped_02.fcalcSubMod(pTipo: Integer; pValor: Real; pRestPro,pRestFor,pRestCon,pfracao: Integer): Real;
{
ptipo=0 quantidade
      1 valor
}
var
mRetorno: Real;
begin
mRetorno:=0;
if (mPed_SubMod=99) then
   begin
   if (pRestPro=1) then
      mRetorno    :=pValor
   else
      mRetorno    :=0;
   end
else
   begin
   if pRestPro=4 then // so pf
      mRetorno    :=pValor
   else if pRestPro=3 then // so menor 99
      mRetorno    :=0
   else if (pRestPro=2) and (pRestCon<>0) then // se a restricao for por controle e bloqueado
      begin
      if pRestCon=2 then // se pf
         mRetorno    :=pValor
      else if pRestCon=1 then // se menor 99
         mRetorno    :=0;
      end
   else if (pRestPro=1) and (pRestFor<>0) then // se a restricao for por fornecedor e bloqueado
      begin
      if pRestFor=2 then // se pf
         mRetorno    :=pValor
      else if pRestfor=1 then // se menor 99
         mRetorno    :=pValor
      end
   else
      begin
      if ptipo=0 then
         begin
         mRetorno    :=pValor*mPed_SubMod/100;
         if pfracao=0 then
            mRetorno:=Arredonda(mRetorno,0);
         if mRetorno>pValor then
            mRetorno:=pValor;
         end
      else
         begin
         mRetorno    :=pValor*mPed_SubMod/100;
         mRetorno:=Arredonda(mRetorno, mQtdCas_arredpu);
         if mRetorno>pValor then
            mRetorno:=pValor;
         end;
      end;
   end;
result:=mRetorno;
end;


