procedure TFrm_Ped_02.bbGravarServClick(Sender: TObject);
var
  x_falta: Real;
  x_baixa: Real;
  mProcura_lote: Boolean;

begin
if fdeixanum2(txts_codpro.Text)='' then
   begin
   if (not mpd_RestaurandoPedido) and (not mPd_FaturandoPedido) and (mAceita_pergunta) then

      txts_codpro.SetFocus;
   exit;
   end;

txts_quantExit(Self);
if txts_quant.Value<=0 then
   begin
   if mAceita_pergunta then
      fmensagem('Favor Digitar uma Quantidade válida!',0,['0'],0);
   if (not mpd_RestaurandoPedido) and (not mPd_FaturandoPedido) and (mAceita_pergunta) then
      txts_quant.SetFocus;
   exit;
   end;


if not QryServico_Nota.Active then
   begin
   QryServico_Nota.Active := True;
   if mPd_Oper_Serv=0 then
      QryServico_Nota.First;
   end;

mProcura_lote:=false;
if not mpd_RestaurandoPedido then
   begin

//limite de credito


   if (not mlib_limcred)  and (mlcred>0) and (mPd_Venda_Devol<>1) and (mpd_ptipop<>0)
      and (not mPd_FaturandoPedido)  then
      begin
      if (mPd_Oper_Serv=1) then
         begin
         if mPosReg_Serv<>nil then
            QryServico_Nota.GotoBookmark(mPosReg_Serv);
         end;
      mReal:=0;
      if mPd_Oper_Serv=1 then
         mReal:=QryServico_Notatotal_liq.AsFloat;

      if (txts_vltotal.Value-mReal)+ValFloat(st_totliquido.Caption)>mlcred then
         begin
         if not mAceita_pergunta then
            begin
            mlib_codbloq      :=fAdicionaRemoveTexto(0,mlib_codbloq,'01');
            mlib_bloqPend     :=2;
            end
         else
            begin
            if (not DM1.Tb_Cli.Active) or (mPed_Cli_CodCli<>DM1.Tb_CliCCODCLI.AsFloat) then
                flcadcli(1,0,FloatToStr(mPed_Cli_CodCli));
