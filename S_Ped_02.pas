procedure TFrm_Ped_02.edt_codvendedorKeyPress(Sender: TObject; var Key: Char);
begin
   if (key in ['A'..'Z']) or (key in ['a'..'z']) or (key = '%') then begin
      edt_codvendedor.Text := fchamaven(0,'frm_Ped_02',key);

      if valint(edt_codvendedor.Text) <> 0 then
         edt_codvendedorExit(Self);
         key:=#0;
   end else
      if not (key in ['0'..'9']) and (key<>#8) then key:=#0;
end;

procedure TFrm_Ped_02.edt_codvendaKeyPress(Sender: TObject; var Key: Char);
begin
if (key in ['A'..'Z']) or (key in ['a'..'z']) or (key = '%') then
   begin
   edt_codvenda.Text:=fChamaPV(0,'frm_rdev',key);
   if valint(edt_codvenda.Text)<>0 then
      begin
      cb_tabelavenda.Text:=DM1.Tb_PVPVCODTIP.AsString;
      edt_codvendaExit(self);
      with cb_tabelavenda do
         ItemIndex := items.IndexOf(cb_tabelavenda.Text);
      end;
   key:=#0
   end
else
   if not (key in ['0'..'9']) and (key<>#8) then key:=#0;
end;

procedure TFrm_Ped_02.edt_codvendaKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
if key = 113 then
   begin
   edt_codvenda.Text:=fChamaPV(0,'frm_rdev','');
   if valint(edt_codvenda.Text)<>0 then
      begin
      cb_tabelavenda.Text:=DM1.Tb_PVPVCODTIP.AsString;
      edt_codvendaExit(self);
      with cb_tabelavenda do
         ItemIndex := items.IndexOf(cb_tabelavenda.Text);
      end;
   end;
end;

function tFrm_Ped_02.fPed01tarbanpd(ptipo: Integer; Var pTarBan0: Real; Var pTarBan1: Real): Boolean;
{
0-Todos
1-
101
}
var
  tb_codemp_ant : Integer;
  tb_qtddup     : Integer;
begin
pTarBan0:=0;
pTarBan1:=0;


if mPed_Cli_CTarBan=1 then
   begin
   edt_outrasdespesas.Caption  :=Formatfloat(mcasas, 0);
   edt_outdesp.Value           :=0;
   result:=true;
   exit;
   end;

if (ValFloat(edt_codbanco.Text) = 0) and  (ValFloat(edt_codbanco2.Text) = 0) then
   begin
   edt_outrasdespesas.Caption := Formatfloat(mcasas, 0);
   edt_outdesp.Value          :=0;   
   result := True;
   end
else
   begin
   edt_outrasdespesas.Caption := Formatfloat(mcasas, 0);
   edt_outdesp.Value          :=0;
   tb_qtddup := 1;
   if not form_pvo_ped_02.Tb_Po99_nov.Active then
      tb_qtddup := 1
   else
      tb_qtddup := form_pvo_ped_02.Tb_Po99_nov.RecordCount;
   if tb_qtddup < 1 then
      tb_qtddup := 1;
   if ptipo <> 100 then
      begin
      if (ValFloat(edt_submod.Text) < 100) then
         begin
         flcadpar01(0,codemp,'1');
         if DM4.Tb_Par01PINCTB.AsInteger > 0 then
            begin
            if  mPed_Cli_TarBan > 0 then
               begin
               edt_outrasdespesas.Caption  := Formatfloat(mcasas, mPed_Cli_TarBan*(tb_qtddup));
               edt_outdesp.Value           := mPed_Cli_TarBan*(tb_qtddup);
               end
            else
               begin
               if flcadbco(1,0,0,trim(edt_codbanco.Text)) then
                  begin
                  edt_outrasdespesas.Caption := Formatfloat(mcasas, DM1.Tb_BcoBCTARIFA.Value*(tb_qtddup));
                  edt_outdesp.Value          := DM1.Tb_BcoBCTARIFA.Value*(tb_qtddup);
                  end;
               end;
            pTarBan0:=ValFloat(edt_outrasdespesas.Caption);
            end;                                           
         end;
      end;

      if ptipo <> 1 then
         begin
         if (Valfloat(edt_submod.Text) <> 0) then
            begin
            tb_codemp_ant := DM4.Tb_Par01PCODEMP.AsInteger;
            flcadpar01(0,iif(tb_codemp_ant>100,tb_codemp_ant-100,tb_codemp_ant+100),'1');

            if DM4.Tb_Par01PINCTB.AsInteger > 0 then
               begin
               if mPed_Cli_TarBan > 0 then
                  begin
                  edt_outrasdespesas.Caption  :=Formatfloat(mcasas, ValFloat(edt_outrasdespesas.Caption)+(mPed_Cli_TarBan*(tb_qtddup)));
                  edt_outdesp.Value           :=edt_outdesp.Value+(mPed_Cli_TarBan*(tb_qtddup));
                  pTarBan1:=DM1.Tb_BcoBCTARIFA.Value*(tb_qtddup);
                  end
               else
                  begin
                 if flcadbco(1,0,0,trim(edt_codbanco2.Text)) then
                    begin
                    edt_outrasdespesas.Caption := Formatfloat(mcasas, ValFloat(edt_outrasdespesas.Caption)+(DM1.Tb_BcoBCTARIFA.Value*(tb_qtddup)));
                    edt_outdesp.Value          := edt_outdesp.Value+(DM1.Tb_BcoBCTARIFA.Value*(tb_qtddup));
                    pTarBan1:=DM1.Tb_BcoBCTARIFA.Value*(tb_qtddup);
                    end;
                 end;
               end;
            flcadpar01(0,codemp,'1');
            flcadbco(1,0,0,trim(edt_codbanco.Text));
         end;
      end;
   end;
   FExibirtotais(0);
   result := True;
end;


procedure TFrm_Ped_02.edt_codprodutoExit(Sender: TObject);
begin
//pTipo: Integer = 0-Inclusao 1-Alteraçao
//pValRest = 0-Valida Restricoes 1-Nao valida
//plibProm=0-Promocao somente de acordo com parametros estabelicidos
//         1-libera promocao idenpendente de parametros minimos
// pLocal=0-codpro 1-Lote 2-Dtvcto 3-Gravando;

 mQtdMinPromo         :=0;
 mPromo_pRet_PCOFPG   :=0;
 mSemPromo_pRet_PCOFPG:=0;


edt_codproduto.Text:=fdeixanum2(edt_codproduto.Text);
{
if (cb_leitor.Checked) and (Log_TipoLote=2) and (length(edt_codproduto.Text)>2) then
   begin
   edt_lote.Text:=copy(edt_codproduto.Text,length(edt_codproduto.Text)-1,2);
   edt_codproduto.Text:=copy(edt_codproduto.Text,1,length(edt_codproduto.Text)-2);
   end;

}
if (Trim(edt_codproduto.Text)='') and (((edt_lote.visible and edt_lote.focused)
      or (((not edt_lote.visible) or (edt_lote.TabStop=false)) and (edt_quantidade.focused)))
      or ((edt_complemento.Visible) and (edt_complemento.Focused))) then
  begin
  edt_codproduto.Setfocus;
  exit;
  end;
if mpd_ant_codpro>0 then
  begin
  if ((mpd_ant_codpro<>fsonumero(edt_codproduto.Text)) and (Log_TipoLote=1)) then
    begin
    edt_lote.Text:='';
    edt_dtvcto.Text:='/  /';
    end;
  end;

if Trim(edt_codproduto.Text) <> '' then
  begin
  if cb_leitor.checked then
    begin
    if (Valint(copy(mpseg,4,2))=2) and (Valint(copy(DM1.Tb_PargerPSEGMENTO.Value,4,2))>0)
      or (DM1.Tb_PargerPPCOGRA.Value=1) then  // Grades cores tamanhos
      begin
      if (DM1.Tb_PargerPPCOGRA.Value=1) then
        begin
        if (Length(edt_codproduto.Text)>9) then
          begin
          edt_lote.Text  :=UpperCase(copy(edt_codproduto.Text,5,length(edt_codproduto.Text)-4));
          edt_codproduto.Text:=copy(edt_codproduto.Text,1,4);
          end;
        end
      else
        begin
        edt_lote.Text:=copy(Trim(edt_codproduto.Text),length(Trim(edt_codproduto.Text))-1,2);
        edt_codproduto.Text:=copy(Trim(edt_codproduto.Text),1,length(Trim(edt_codproduto.Text))-2);
        end;
      end;
    end;
  if not fDadosPro(0,mPd_Oper_item,0,IIF(cb_leitor.checked = True,1,0),0,0,mpd_pvppori,cb_tipopreco.ItemIndex,
                   edt_tipopco.AsInteger,edt_codproduto.Text,edt_lote.Text,cb_tabelavenda.Text,edt_codvenda.Text,
                   '1',pDatanula,edt_quantidade.Value,ValFloat(edt_codvendedor02.text),valFloat(edt_codvendedor03.Text),0,True, cb_sepamb.Checked) then
    begin
    edt_lote.text:='';
    edt_codproduto.SetFocus;
    Exit;
    end
  else
    begin
    edt_codproduto.Text      := FloatToStr(pRet_Codpro);
    edt_descricao.Text       := pRet_NomePro;
    edt_marca.Text           := pRet_MarcaPro;
    edt_secao.Text           := pRet_SecaoPro;
    edt_cfop.Text            := FloatToStr(mRet0_CFOP);
    if mpd_ant_codpro<>fsonumero(edt_codproduto.Text) then
      begin
      edt_und.Text             := pRet_UndPro;
      edt_precounitario.Value  := pRet_Preco_Unit;
      end
    else if (chk_orcamento.Checked) and (Trim(edt_und.Text)='') then
      begin
      edt_und.Text             := pRet_UndPro;
      end;
    if (mPd_FaturandoPedido = false) and (pRet_Qtd<>0) then
      begin
      edt_lote.Text            := pRet_Lote;
      edt_quantidade.Text      := FloatToStr(pRet_Qtd);
      edt_quantidadeExit(self);
      end;
    if fSonumero(edt_codproduto.Text)=0 then
      begin
      edt_codproduto.SetFocus;
      exit;
      end;
    if (mPd_Venda_Devol=1) and (not CB_PEDORI.Checked) and (not Tb_DevCli.IsEmpty) then
      begin
      if Tb_DevCli.Locate('P2CODPRO;P2LOTE',VarArrayOf([edt_codproduto.Text,edt_lote.Text]),[]) then
        begin
        pRet_Preco_Unit:=Tb_DevCliP2PRECO.AsFloat;
        pRet_DescI01   :=Tb_DevCliP2DESC1.AsFloat;
        pRet_DescI02   :=Tb_DevCliP2DESC2.AsFloat;
        pRet_DescI03   :=Tb_DevCliP2DESC3.AsFloat;
        pRet_DescFin   :=Tb_DevCliP2PDESCF.AsFloat;
        pRet_PComV01   :=Tb_DevCliP2PCOMIS.AsFloat;
        pRet_PComV02   :=Tb_DevCliP2PCOM02.AsFloat;
        pRet_PComV03   :=Tb_DevCliP2PCOM03.AsFloat;
        pRet_PComV04   :=0;
        if Tb_DevCliP2DTVCTO.AsDateTime>pdatanula then
          edt_dtvcto.Text:=FormatDatetime(fdt2, Tb_DevCliP2DTVCTO.AsDateTime);
        end
      else
        begin
        if Tb_DevCli.Locate('P2CODPRO',edt_codproduto.Text,[]) then
          begin
          pRet_Preco_Unit:=Tb_DevCliP2PRECO.AsFloat;
          pRet_DescI01   :=Tb_DevCliP2DESC1.AsFloat;
          pRet_DescI02   :=Tb_DevCliP2DESC2.AsFloat;
