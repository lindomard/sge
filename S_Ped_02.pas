function tFrm_Ped_02.fGravarPend(pCodpro,pCodVen,pQtdPed,pQtdEnv,pDesci01,pDesci02,pDesci03,
                                 pValDes,pPreco: Real; pGrade: String):Boolean;
begin

if (not mem_CADPEN.active) then
   mem_CADPEN.Open;

if DM4.Tb_Par01PGRAPEN.AsInteger<>1 then
   begin
   result:=true;
   exit;
   end;
if mem_CADPEN.Locate('PECODPRO;PEGRADE',vararrayof([pcodpro,pgrade]),[]) then
   begin
   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;
   DM1.Query1.SQL.Add('Update CADPEN_TEMP set '
                     +' PEQTDPED=:QTDPED '
                     +',PEQTDENV=:QTDENV '
                     +',PEQTDPEN=:QTDPEN '
                     +',PEDESC01=:DESC01 '
                     +',PEDESC02=:DESC02 '
                     +',PEDESC03=:DESC03 '
                     +',PEVALDES=:VALDES '
                     +',PEPRECO =:PRECO '
                     +' where '
                     +' PETERM=:TERM '
                     +' and PEDATHOR=:DATHOR '
                     +' and PECODPRO=:CODPRO ' );
   if Log_TipoLote=2 then
      begin
      DM1.Query1.SQL.Add(' and PEGRADE=:GRADE ' );
      DM1.Query1.ParamByName('GRADE').AsString     := pGrade;
      end;
   DM1.Query1.ParamByName('DATHOR').AsDateTime := mPd_DatHor_Eve;
   DM1.Query1.ParamByName('TERM').AsString     := mPd_NomeComputador;
   DM1.Query1.ParamByName('CODPRO').AsFloat    := pCodpro;
   DM1.Query1.ParamByName('QTDPED').AsFloat :=pQtdPed;
   DM1.Query1.ParamByName('QTDENV').AsFloat :=pQtdEnv;
   DM1.Query1.ParamByName('QTDPEN').AsFloat :=pQtdPed-pQtdEnv;
   DM1.Query1.ParamByName('DESC01').AsFloat :=pDesci01;
   DM1.Query1.ParamByName('DESC02').AsFloat :=pDesci02;
   DM1.Query1.ParamByName('DESC03').AsFloat :=pDesci03;
   DM1.Query1.ParamByName('VALDES').AsFloat :=pValDes;
   DM1.Query1.ParamByName('PRECO').AsFloat  :=pPreco;
   try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      DM1.Query1.SQL.savetofile('c:\sql.txt');
      end;
   mem_CADPEN.Edit;
   end
else
   begin
   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;
   DM1.Query1.SQL.Add('Insert into CADPEN_TEMP  ( '
                     +' PEQTDPED'
                     +',PEQTDENV'
                     +',PEQTDPEN'
                     +',PEDESC01'
                     +',PEDESC02'
                     +',PEDESC03'
                     +',PEVALDES'
                     +',PEPRECO '
                     +',PETERM '
                     +',PEDATHOR '
                     +',PECODVEN '
                     +',PECODPRO ' );
      DM1.Query1.SQL.Add(', PEGRADE' );
      DM1.Query1.SQL.Add(' ) Values (' );
      DM1.Query1.SQL.Add(' :QTDPED '
                     +',:QTDENV '
                     +',:QTDPEN '
                     +',:DESC01 '
                     +',:DESC02 '
                     +',:DESC03 '
                     +',:VALDES '
                     +',:PRECO '
                     +',:TERM '
                     +',:DATHOR '
                     +',:CODVEN'
                     +',:CODPRO ' );
   DM1.Query1.SQL.Add(',:GRADE ' );
   DM1.Query1.SQL.Add(' ) ' );
   DM1.Query1.ParamByName('GRADE').AsString     := pGrade;
   DM1.Query1.ParamByName('DATHOR').AsDateTime := mPd_DatHor_Eve;
   DM1.Query1.ParamByName('TERM').AsString     := mPd_NomeComputador;
   DM1.Query1.ParamByName('CODPRO').AsFloat    := pCodpro;
   DM1.Query1.ParamByName('CODVEN').AsFloat    := pCodVen;
   DM1.Query1.ParamByName('QTDPED').AsFloat :=pQtdPed;
   DM1.Query1.ParamByName('QTDENV').AsFloat :=pQtdEnv;
   DM1.Query1.ParamByName('QTDPEN').AsFloat :=pQtdPed-pQtdEnv;
   DM1.Query1.ParamByName('DESC01').AsFloat :=pDesci01;
   DM1.Query1.ParamByName('DESC02').AsFloat :=pDesci02;
   DM1.Query1.ParamByName('DESC03').AsFloat :=pDesci03;
   DM1.Query1.ParamByName('VALDES').AsFloat :=pValDes;
   DM1.Query1.ParamByName('PRECO').AsFloat  :=pPreco;

   try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      DM1.Query1.SQL.savetofile('c:\sql.txt');
      end;


   mem_CADPEN.First;
   mem_CADPEN.Insert;
   end;
mem_CADPENPECODPRO.Value  :=pCodpro;
mem_CADPENPECODVEN.Value  :=pCodVen;
mem_CADPENPEQTDPED.Value  :=pQtdPed;
mem_CADPENPEQTDENV.Value  :=pQtdEnv;
mem_CADPENPEQTDPEN.Value  :=pQtdPed-pQtdEnv;
mem_CADPENPEDESC01.Value  :=edt_desc1.Value;
mem_CADPENPEDESC02.Value  :=edt_desc2.Value;
mem_CADPENPEDESC03.Value  :=edt_desc3.Value;
mem_CADPENPEVALDES.Value  :=0;
mem_CADPENPEPRECO.Value   :=edt_precounitario.Value;
mem_CADPENPEGRADE.Value   :=pGrade;
mem_CADPENNOMPRO.Value    :=edt_descricao.Text;
mem_CADPENPEUND.Value     :=edt_und.Text;
mem_CADPENMARCAPRO.Value  :=edt_marca.Text;
mem_CADPEN.Post;
result:=true;
end;


function tFrm_Ped_02.fRemovePendencia(pCodpro,pQtd: Real; pGrade: String):Boolean;
var
mAchou: Boolean;
begin
if (not mem_CADPEN.active) then
   mem_CADPEN.Open;
if DM4.Tb_Par01PGRAPEN.AsInteger<>1 then
   begin
   result:=true;
   exit;
   end;
mAchou:=false;

if (valint(copy(mpseg,4,2))=02) then
   begin
   if mem_CADPEN.Locate('PECODPRO;PEGRADE',vararrayof([pcodpro,pgrade]),[]) then
      mAchou:=true;
   end
else
   begin
   if mem_CADPEN.Locate('PECODPRO',pcodpro,[]) then
      mAchou:=true;
   end;



if mAchou then
   begin
   if mem_CADPENPEQTDPEN.AsFloat<=pQtd then
      begin
      DM1.Query1.Close;
      DM1.Query1.SQL.Clear;
      DM1.Query1.SQL.Add('Delete from CADPEN_TEMP '
                        +' where '
                        +' PETERM=:TERM '
                        +' and PEDATHOR=:DATHOR '
                        +' and PECODPRO=:CODPRO ' );
      if Log_TipoLote=2 then
         begin
         DM1.Query1.SQL.Add(' and PEGRADE=:GRADE ' );
         DM1.Query1.ParamByName('GRADE').AsString     := pGrade;
         end;
      DM1.Query1.ParamByName('DATHOR').AsDateTime := mPd_DatHor_Eve;
      DM1.Query1.ParamByName('TERM').AsString     := mPd_NomeComputador;
      DM1.Query1.ParamByName('CODPRO').AsFloat    :=pCodpro;
      try
         DM1.Query1.ExecSQL;
         fdm1StartCommit;
      except
         DM1.Query1.SQL.savetofile('c:\sql.txt');
         end;
      mem_CADPEN.Delete;
      end
   else
      begin
      DM1.Query1.Close;
      DM1.Query1.SQL.Clear;
      DM1.Query1.SQL.Add('Update CADPEN_TEMP set '
                        +' PEQTDENV=PEQTDENV+:QTDENV '
                        +',PEQTDPEN=PEQTDPEN-:QTDPEN '
                        +' where '
                        +' PETERM=:TERM '
                        +' and PEDATHOR=:DATHOR '
                        +' and PECODPRO=:CODPRO ' );
      if Log_TipoLote=2 then
         begin
         DM1.Query1.SQL.Add(' and PEGRADE=:GRADE ' );
         DM1.Query1.ParamByName('GRADE').AsString     := pGrade;
         end;
      DM1.Query1.ParamByName('DATHOR').AsDateTime := mPd_DatHor_Eve;
      DM1.Query1.ParamByName('TERM').AsString     := mPd_NomeComputador;
      DM1.Query1.ParamByName('QTDENV').AsFloat    :=pQtd;
      DM1.Query1.ParamByName('QTDPEN').AsFloat    :=pQtd;
      DM1.Query1.ParamByName('CODPRO').AsFloat    :=pCodpro;
      try
         DM1.Query1.ExecSQL;
         fdm1StartCommit;
      except
         DM1.Query1.SQL.savetofile('c:\sql.txt');
         end;
      mem_CADPEN.Edit;
      mem_CADPENPEQTDENV.AsFloat:=mem_CADPENPEQTDENV.AsFloat+pQtd;
      mem_CADPENPEQTDPEN.AsFloat:=mem_CADPENPEQTDPEN.AsFloat-pQtd;
      mem_CADPEN.Post;
      end;
   end;
result:=true;
end;

procedure TFrm_Ped_02.edt_dtvctoExit(Sender: TObject);
begin
{
if trim(edt_dtvcto.Text)='/  /' then
   mdtv:=''
else
   mdtv:=edt_dtvcto.Text;
if trim(edt_lote.text)<>'' then
   begin
   if flcadlgc(0,1,0,edt_codproduto.Text,edt_lote.Text,mdtv) then
      begin
      if (trim(edt_dtvcto.Text)='/  /') and (DM1.Tb_LGCCLDTVCTO.AsDateTime>pdatanula) then
         edt_dtvcto.Text:=FormatDateTime(fdt2, DM1.Tb_LGCCLDTVCTO.Value);
      end
   else
      begin
       if mPd_Venda_Devol=0 then
          begin
          fmensagem('Vencimento não Encontrado!',0,['0'],0);
          edt_dtvcto.SetFocus;
          exit;
          end;
      end;
