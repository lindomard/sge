if (cb_tabelavenda.Text = 'PO') and (edt_codvenda.Text = '99') then
   begin
   edt_nomevenda.Text := 'Plano Opcional(Digitado)';
   edt_nomevenda.Hint := edt_nomevenda.Text;
   if not mpd_RestaurandoPedido then
      begin
      fpd_CarregaPlanoVendas(2);
      fAtualizaForm(0);
      form_pvo_ped_02.ShowModal;
      fpd_CarregaPlanoVendas(1);
      end;

   if form_pvo_ped_02.Tb_Po99_nov.IsEmpty then
      mcinst4 := 'AV'
   else
      begin
      form_pvo_ped_02.Tb_Po99_nov.first;
      mcinst4 := '';
      while not form_pvo_ped_02.Tb_Po99_nov.Eof do
         begin
         if trim(mcinst4) <> '' then
            mcinst4:=mcinst4+'/';
         if form_pvo_ped_02.Tb_Po99_novPOPRAZO.AsFloat = 0 then
            mcinst4 := mcinst4 + 'AV'
         else
            mcinst4 := mcinst4+form_pvo_ped_02.Tb_Po99_novPOPRAZO.AsString;
         form_pvo_ped_02.Tb_Po99_nov.Next;
         end;
      end;
   form_pvo_ped_02.Tb_Po99_nov.first;
   edt_nomevenda.Text := 'Plano Opcional(Digitado) - '+mcinst4;
   edt_nomevenda.Hint := edt_nomevenda.Text;
   end
else
   begin
   if not flcadpv(1,0,cb_tabelavenda.Text,edt_codvenda.Text) then
      begin
      if not mpd_RestaurandoPedido then
         begin
         verteclado(0);
         fMensagem('Plano de Vendas não Cadastrado',0,['0'],0);
         if DM1.Tb_PargerPUPVESP.Asinteger = 1 then
            edt_codvenda.SetFocus
         else
            cb_tabelavenda.SetFocus;
         end;
      exit;
      end
   else
      begin
      mpacreconv := 0;
      if cb_tabelavenda.Text = 'CV' then
         begin
         if DM1.Tb_CliCCODCV.Value <= 0 then
            begin
            if not mpd_RestaurandoPedido then
               begin
               verteclado(0);
               fMensagem('Cliente não Possui Convênio!',0,['0'],0);

               if DM1.Tb_PargerPUPVESP.Asinteger=1 then
                  edt_codvenda.SetFocus
               else
                  cb_tabelavenda.SetFocus;
               exit;
               end;

            if flqr1('CVRAZAO,CVACFIN','CV','CADCV','N','CVCODCV',DM1.Tb_CliCCODCV.AsString) then
               mpacreconv := DM1.Query1.Fields[1].AsFloat;
            end;
         end;
      if DM1.Tb_PVPVPRAZOS.IsNull then
         edt_nomevenda.Text := DM1.Tb_PVPVNOME.Value+'/'+DM1.Tb_PVprazos.Value+' Prazo Médio: '+DM1.Tb_PVPVPRAZOMED.AsString+iif(DM1.Tb_PVPVPRAZOMED.AsInteger>1,' dias ','dia')
      else
         edt_nomevenda.Text := DM1.Tb_PVPVNOME.Value+'/'+DM1.Tb_PVPVPRAZOS.Value+' Prazo Médio: '+DM1.Tb_PVPVPRAZOMED.AsString+iif(DM1.Tb_PVPVPRAZOMED.AsInteger>1,' dias ','dia');

      edt_nomevenda.Hint := edt_nomevenda.Text;

      fpd_CarregaPlanoVendas(0);

      form_pvo_ped_02.Tb_Po99_nov.Close;
      form_pvo_ped_02.Tb_Po99_nov.SQL.Clear;
      form_pvo_ped_02.Tb_Po99_nov.SQL.add('Select PV2CODEMP as POCODEMP, '
                             +' PV2PRAZO as POPRAZO from CADPV2 '
                             +' where ');

      form_pvo_ped_02.Tb_Po99_nov.SQL.add(fla_EmpBaixaAlta(0,'CADPV','',codemp,'PV2CODEMP',' and '));
      form_pvo_ped_02.Tb_Po99_nov.SQL.add(' PV2CODTIP='+chr(39)+DM1.Tb_PVPVCODTIP.Value+chr(39)
                              +' and PV2CODPV=0'+DM1.Tb_PVPVCODPV.AsString
                             +' order by PV2PRAZO');
      form_pvo_ped_02.Tb_Po99_nov.Open;
      if form_pvo_ped_02.Tb_Po99_nov.IsEmpty then
         begin
         form_pvo_ped_02.Tb_Po99_nov.Close;
         form_pvo_ped_02.Tb_Po99_nov.SQL.Clear;
         form_pvo_ped_02.Tb_Po99_nov.SQL.add('Select '+IntToStr(codemp)+' as POCODEMP, '
                                +' 0 as POPRAZO from DUAL ');
         form_pvo_ped_02.Tb_Po99_nov.Open;
         end;

      end;
   end;

if (ant_codpv <> '') and (trim(cb_tabelavenda.Text)+FormatFloat('0000',ValFloat(edt_codvenda.Text)) <> ant_codpv)
   and (not mpd_RestaurandoPedido) then
   begin
   if fValidaSenha(0,codusr,32,0,DM1.Tb_CliCCODCLI.Value,0,0,0, 'Senha para Confirmar a alteração do Plano de Vendas Padrão','') <> 0 then
      begin
      verteclado(0);
      fMensagem('Alteração não Aceita!',0,['0'],0);
      cb_tabelavenda.Text := copy(ant_codpv,1,2);
      edt_codvenda.Text   :=copy(ant_codpv,3,length(ant_codpv)-2);

      if DM1.Tb_PargerPUPVESP.Asinteger = 1 then
         edt_codvenda.SetFocus
      else
         cb_tabelavenda.SetFocus;

      exit;
      end;
   if (not QryItem_Nota.IsEmpty) or (not QryItem_Nota.IsEmpty) and (mpd_ptipop<2) then
      begin
      if (mem_cadpfp.Active) and (not mem_cadpfp.IsEmpty) then
