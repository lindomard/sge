   if (key = vk_delete) and (not QryItem_NotaP2CODPRO.IsNull) then
      begin
      ExluirItem1Click(Self);
      edt_codproduto.SetFocus;
      end
   else if (key=119) and (DM1.Tb_PargerPINDUSTRIA.Value=5) then
///   else if (key=119) and (DM1.Tb_PargerPINDUSTRIA.Value>4) then
