procedure TFrm_Ped_02.txts_codproExit(Sender: TObject);
begin
if (Trim(txts_codpro.Text) ='') and  (txts_quant.focused)   then
    begin
    txts_codpro.Setfocus;
    exit;
    end;

if Trim(txts_codpro.Text) <> '' then
   begin
   if (Valint(copy(mpseg,4,2))=2) and (Valint(copy(DM1.Tb_PargerPSEGMENTO.Value,4,2))>0)
      or (DM1.Tb_PargerPPCOGRA.Value=1) then  // Grades cores tamanhos
      begin
      if (DM1.Tb_PargerPPCOGRA.Value=1) then
         begin
         if (Length(txts_codpro.Text)>9) then
            begin
            txts_codpro.Text:=copy(txts_codpro.Text,1,4);
            end;
         end
      else
         begin
         txts_codpro.Text:=copy(Trim(txts_codpro.Text),1,length(Trim(txts_codpro.Text))-2);
         end;
      end;
   if not fDadosPro(1,mPd_Oper_Serv,0,IIF(cb_leitor.checked = True,1,0),0,0,mpd_pvppori,cb_tipopreco.ItemIndex,
                     CB_TPP.ItemIndex,   txts_codpro.Text,
                     '',cb_tabelavenda.Text,edt_codvenda.Text,'1',pDatanula,txts_quant.Value,ValFloat(edt_codvendedor02.text),
                     valFloat(edt_codvendedor03.Text),0,True, cb_sepamb.Checked) then
       txts_codpro.SetFocus
    else
       begin
       txts_descricao.Text       := pRet_NomePro;
       txts_und.Text             := pRet_UndPro;
       txts_pcouni.Value         := pRet_Preco_Unit;

       txts_desci01.Value        := pRet_DescI01;
       txts_desci02.Value        := pRet_DescI02;
       txts_desci03.Value        := pRet_DescI03;
       txts_descfin.Value        := pRet_DescFin;
       txts_comis.Value          := pRet_PComV01;

       end;
   end;

end;

procedure TFrm_Ped_02.txts_quantExit(Sender: TObject);
var
  xQtde : Real;
begin
if ((txts_pcouni.focused) or (txts_codpro.focused)) and (txts_quant.value=0) then
   exit;

xQtde := 0;
xQtde := txts_quant.Value;


if (not DM1.Tb_Pro.Active) or (DM1.Tb_ProPDCODPRO.AsFloat<>valFloat(txts_codpro.Text)) then
   flcadpro(1,0,0,txts_codpro.Text);
if not mpd_RestaurandoPedido then
   begin
   if not mPd_FaturandoPedido then
      begin
      if (DM1.Tb_ProPDFRACAO.Value<>1) then
         begin
         if Trunc(xQtde)<>xQtde then
            begin
            fMensagem('Não é permitido fracionar este produto!',0,['0'],0);
            txts_quant.SetFocus;
            exit;
            end;
         end;
      end;
   if (DM1.Tb_ProPDUNDVDA.AsFloat<>0) then
      begin
      if fsonumero(FloatToStr(xQtde/DM1.Tb_ProPDUNDVDA.Value))<>
         (xQtde/DM1.Tb_ProPDUNDVDA.Value) then
         begin
         fMensagem('Não é uma quantidade válida! multipla de '+floatToStr(DM1.Tb_ProPDUNDVDA.Value)+#13
                +' Quantidade Proxima: '+FloatToStr(
                 round(xQtde/DM1.Tb_ProPDUNDVDA.Value)*DM1.Tb_ProPDUNDVDA.value)
                ,0,['0'],0);
         abort;
         exit;
         end;
      end;
   end;
// INICIO

if mPd_SaiNor then
   begin
   if (DM1.Tb_ProPDVDAMAXM.Value>0)   then
      begin
      DM1.Query1.Close;
      DM1.Query1.SQL.clear;
      DM1.Query1.SQL.Add('Select sum(P2QTD) as quant from '
                        +' CADP02,CADP01 where P1STATUS<>9 and '
                        +iif(DM1.Qr_TID.Locate('TINOME','CADPED',[]),'',' P2CODEMP=0'+InttoStr(codemp)+' and P1CODEMP=P2CODEMP and ')
                        +' P2LOTSEQ=0'+IntToStr(mPd_LotSeq)+' and '
                        +' P1LOTSEQ=P2LOTSEQ '
                        +' and P1CHAVE=P2CHAVE and P1ORDEM=P2ORDEM '
                        +' and P2CODPRO=0'+DM1.Tb_ProPDCODPRO.AsString
                        +' and P1CODCLI=0'+floatToStr(mPed_Cli_CodCli)
                        +' and P1TIPO=1 '
                        +' and P1DATAP>='+chr(39)+FormatDateTime(fdt,StrToDate('01/'+FormatDateTime('mm/yyyy',pdatasis)))+chr(39)
                        +' and P1DATAP<='+chr(39)+FormatDateTime(fdt, fdatafinal(0,pdatasis))+chr(39));
      if mPd_Oper_Ped=1 then
         begin
         DM1.Query1.SQL.add(' and P1CHAVE<>0'+Trim(edt_chave.Text));
         end;
      dm1.Query1.Open;
      if (DM1.Query1.Fields[0].AsFloat+QryItem_NotaP2QTD.AsFloat)>DM1.Tb_ProPDVDAMAXM.Value then
         begin
         fmensagem('Quantidade Máxima no mes permitida: '+FormatFloat(mcasqtd, DM1.Tb_ProPDVDAMAXM.AsFloat)
                  +iif(DM1.Query1.Fields[0].AsFloat>0,' Ja  Atendida: '+FormatFloat(mcasqtd, DM1.Query1.Fields[0].AsFloat),'')
                  +'. Invalido!',0,['0'],0);
         abort;
         exit;
         end;
      end;
   end;
txts_vltotal.Value := txts_pcouni.value * txts_quant.Value;

end;

