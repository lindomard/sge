function fCriarviewCustoFabricacaoMercadorias: boolean;
var
query_fab: TQuery;

begin
query_fab:=TQuery.create(nil);
query_fab.DatabaseName:='SG_ASSOC';
query_fab.SQL.clear;
query_fab.SQL.Add('Create or replace view CUSTOFABRICACAOPROD AS ');


query_fab.SQL.Add('SELECT PDNOME,PDCODPRO,TOTGER, TOTALFORMULA,TOTVENDA,TOTCUSTO,pumin,TOTGER-TOTVENDA AS CUSTO_ACUM '
                 +' FROM ( '
                 +' select CPCODPRO,TOTGER+TOTVENDA AS TOTGER,pumin,TOTALFORMULA,TOTVENDA,TOTCUSTO '
                 +' FROM ( '
                 +' select CPCODPRO,SUM(ROUND(((TOTGER*CUPERC)/100),4)) TOTVENDA, max(TOTCUSTO)+max(pumin) as TOTCUSTO'
                 +' ,max(TOTGER) AS TOTGER,max(pumin) as pumin '
                 +' ,max(TOTALFORMULA) as TOTALFORMULA '
                 +' from ( '
                 +' select CPCODPRO,max(CUINCPCOMIN) as pumin,sum(TOTCUSTO) as TOTCUSTO, '
                 +' sum(TOTCUSTO)+max(TOTALFORMULA)+max(CUINCPCOMIN) AS TOTGER '
                 +',max(TOTALFORMULA) as TOTALFORMULA '
                 +' from ( '
                 +' select CPCODPRO,PCCODIGO,PCNOME,PCAPLS,PCOPCIO,PCFATOR,PFORMULA,CUPERC '
                 +' ,NVL( (select max(CUINCPCOMIN) from CADCUS2 where CUCODIGO=CPCODPRO),0) as CUINCPCOMIN '
                 +',ROUND (((TOTALFORMULA*CUPERC)/100),4) TOTCUSTO '
                 +',TOTALFORMULA '
                 +' from ( '
                 +' Select CPCODPRO,SUM(ROUND((CPQUANT*CPPU),3)) AS TOTALFORMULA from CADCOMP  '
                 +' GROUP BY CPCODPRO '
                 +') '
                 +'totfor '
                 +',cadpcus,cadcus '
                 +'  Where cucodpcu=pccodigo '
                 +'    and (CUTIPO(+)=0) and (CUCODEMP(+)=1) '
                 +'               and (CUCODIGO(+)=CPCODPRO) and pcopcio(+)=0 '
                 +' )  GROUP BY CPCODPRO '
                 +') totcus '
                 +',cadpcus,cadcus '
                 +' Where cucodpcu=pccodigo '
                 +'  and (CUTIPO(+)=0) and (CUCODEMP(+)=1) '
                 +'  and (CUCODIGO(+)=CPCODPRO) and pcopcio(+)=1 '
                 +' GROUP BY CPCODPRO '
                 +')) ,CADPRO WHERE  CPCODPRO=PDCODPRO '
                 );
try
   query_fab.ExecSQL;
   except on e : exception do
   ex_erroSql_Novo(query_fab,25357,'SGE '+e.Message,'CADVER');
   end;
query_fab.close;
freeandnil(query_fab);
// MATERIAS PRIMAS
{Select  CPCODMAT, SUM(ROUND((CPQUANT*CPPU),4)) AS TOTALFORMULA from CADCOMP
where
EXISTS (SELECT P2CODPRO FROM CADP02 WHERE P2CHAVE=39863 AND P2CODPRO=CPCODPRO)
GROUP BY CPCODMAT}


{
Select  CUCODPCU, SUM(CUVALOR) AS TOTALFORMULA from CADCUS
where
EXISTS (SELECT P2CODPRO FROM CADP02 WHERE P2CHAVE=39863 AND P2CODPRO=CUCODIGO)
GROUP BY CUCODPCU
 }

end;


