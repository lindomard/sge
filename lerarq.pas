function fTestarVendaMaximaPorCliente(pDadosValidarVdaMax: DadosValidarVdaMax): DadosValidarVdaMaxResultado;
var
mDadosValidarVdaMaxResultado: DadosValidarVdaMaxResultado;
query_vda: tQuery;
mQtdJaComprada: real;
mTiposPedidos: String;

begin

mDadosValidarVdaMaxResultado.pAceito := true;

if (  (pDadosValidarVdaMax.pValidarOrcam=true) and (pDadosValidarVdaMax.pTipoPed=0) )  or
   (pDadosValidarVdaMax.pTipoPed=1) or
   (pDadosValidarVdaMax.pTipoPed=2) or
   (pDadosValidarVdaMax.pTipoPed=4) or
   (pDadosValidarVdaMax.pTipoPed=9) or
   (pDadosValidarVdaMax.pTipoPed=16) or
   (pDadosValidarVdaMax.pTipoPed=25) or
   (pDadosValidarVdaMax.pTipoPed=26)  then
   begin
   mTiposPedidos := '1,2,4,9,16,25,26';
   if pDadosValidarVdaMax.pValidarOrcam then
      mTiposPedidos := '0,'+mTiposPedidos;
   mQtdJaComprada:=pDadosValidarVdaMax.pQtdNovaPedido-pDadosValidarVdaMax.pQtdAntes;

   query_vda:=tQuery.create(nil);
   query_vda.databasename:=DM1.SG_ASSOC.databasename;
   query_vda.Sql.add('select SUM(P2QTD) as qtd from CADP02,CADP01 '
                  +' WHERE P1CODEMP=P2CODEMP AND P1CHAVE=P2CHAVE '
                  +' AND P1LOTSEQ=P2LOTSEQ '
                  +' AND P1CODCLI='+FloatToStr(pDadosValidarVdaMax.pcodcli)
                  +fFormatdatetimeParaConsulta('P1DATAP',true,StrTodate('01/'+formatdateTime('mm/yyyy', date)))
                  +fFormatdatetimeParaConsulta('P1DATAP',false,fultdiames(Date))
                  +' AND P1TIPO in ('  + mTiposPedidos +' )') ;
   try
    query_vda.open;
   except on e : exception do
     begin
     ex_erroSql_Novo(query_vda,35477,'SGE','CADP01');
     query_vda.Close;
     freeandnil(query_vda);
     end;
     end;
//  ex_erroSql_Novo(query_vda,35477,'SGE','CADP01');

   mQtdJaComprada:=mQtdJaComprada + query_vda.fieldbyname('QTD').asfloat;
   if mQtdJaComprada>pDadosValidarVdaMax.pQtdMax then
    begin
    if pDadosValidarVdaMax.pMostrarMensagem then
       begin
       MessageDlg('Quantidade maxima permitida '+FloatToStr(pDadosValidarVdaMax.pQtdMax)
               +' Total Vendido '+floattostr(mQtdJaComprada),mtWarning,[mbOk],0);
       end;
    mDadosValidarVdaMaxResultado.pAceito:=false;
    end;

   query_vda.Close;
   freeandnil(query_vda);
   end;
result :=mDadosValidarVdaMaxResultado;


end;



