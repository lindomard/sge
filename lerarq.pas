function flcadp01V(ptipo,pcodemp,plotseq: Integer; pvalor1,pvalor2: String): Boolean;
begin
{ Parametros ptipo =
  0-Leitura normal

}
DM1.Tb_Ped01V.Close;
DM1.Tb_Ped01V.Sql.clear;
if ptipo=0 then
   begin
   DM1.Tb_Ped01V.Sql.add('Select * from CADP01V '
                       +' where ');
   if (DM1.Qr_Tid.Locate('TINOME','CADPED',[]))  then
      begin
      DM1.Tb_Ped01v.SQl.Add(' P1VLOTSEQ=0'+IntToStr(plotseq)
                           +' and P1VCHAVE=0'+pvalor1
                           +iif(Trim(PVALOR2)='','',' and P1VORDEM=0'+pvalor2)
                           +' order by P1VCHAVE,P1VORDEM,P1VDATAV');
      end
   else
      begin
      DM1.Tb_Ped01V.SQL.add(' P1VCODEMP=0'+iif(pcodemp>0,IntToStr(pcodemp),IntTosTr(codemp))+' and '
                           +' P1VLOTSEQ=0'+InttoStr(plotseq)
                           +' and P1VCHAVE=0'+pvalor1
                           +iif(Trim(PVALOR2)='','',' and P1VORDEM=0'+pvalor2)
                           +' order by P1VCHAVE,P1VORDEM,P1VDATAV');
      end;
   end;
DM1.Tb_Ped01v.open;
if DM1.Tb_Ped01v.Eof then
   Result:=False
else
   Result:=True;
end;

