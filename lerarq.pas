   if pGerar.pChaveOld<>0 then
      begin
      Query_exe.SQL.Add(IntToStr(pGerar.pChaveOld));
      mcinst:=',';
      end;

   if trim(pGerar.pCampoDatHor)<>'' then
      begin
      Query_exe.SQL.Add(mcinst+':'+pGerar.pCampoDatHor);
