function fTestarDup(pLotSeq,pChave,pOrdem,pCodemp: Real):Boolean;
begin
DM1.Query2.Close;
DM1.Query2.Sql.Clear;
DM1.Query2.Sql.Add(' select * from cadp01 where p1chave=:chave '
                  +' and p1codemp=:codemp and p1lotseq=:lotseq ');
