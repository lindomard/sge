   query_temp.sql.add('MERGE INTO CADREMBCO t1 '
                     +'  USING (   SELECT RECODEMP_DUP,RELOTSEQ,RECODECF,RENUMDUP,REDESD,RETIPO,RECODCLI '
                     +',MAX(CRNUMERO) AS CRNUMERO,MAX(CRCHAVE_ID) AS CRCHAVE_ID,MAX(CRCHAVE_ID_ANO) AS CRCHAVE_ID_ANO '
                     +'           FROM CADREMBCO,CADDAR WHERE NVL(CADREMBCO.RETIT_CHAVE_ID,0)=0 AND RENUMDUP>0 '
                     +'           AND CRCODEMP=RECODEMP_DUP and CRNUMERO=RENUMDUP '
                     +'           AND CRDESD=REDESD '
                     +'           AND CRDUP=RETIPO '
                     +'           AND CRCODCLI=RECODCLI '
                     +'          GROUP BY RECODEMP_DUP,RELOTSEQ,RECODECF,RENUMDUP,REDESD,RETIPO,RECODCLI   ) ss '
                     +'     ON (t1.RECODEMP_DUP = ss.RECODEMP_DUP AND t1.RECODECF = ss.RECODECF '
                     +'        AND t1.RENUMDUP = ss.RENUMDUP '
                     +'         AND t1.RELOTSEQ = ss.RELOTSEQ '
                     +'         AND t1.RETIPO = ss.RETIPO '
                     +'         AND t1.RECODCLI = ss.RECODCLI '
                     +'          AND t1.REDESD= ss.REDESD '

                     +'         ) '
                     +'   WHEN MATCHED THEN '
                     +'     UPDATE SET t1.RETIT_CHAVE_ID = ss.CRCHAVE_ID '
                     +'                ,t1.RETIT_CHAVE_ID_ANO = ss.CRCHAVE_ID_ANO ');

