// somando
function fdeixanomecampo(ptexto : String): String;
var
 xpos: Integer;
 xpos2: Integer;
begin
xpos := Pos('(', ptexto);
if xpos < 1 then
  Result := ptexto
else
  begin
  xpos:=xpos+1;
  xpos2:=Pos(',',ptexto);
  Result := Copy (ptexto,xpos,xpos2-xpos);
  end;
end;

function fretiraas(ptexto : String): String;
var
 xpos: Integer;
begin
xpos := Pos(' AS ' , UpperCase(ptexto));
if xpos < 1 then
  Result := ptexto
else
  Result := trim(Copy(ptexto,1,xpos));
end;


