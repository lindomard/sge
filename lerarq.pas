else if DM4.Tb_ParGer02PG2FORMALOTEFAB.AsInteger=2 then
   mSiglaLote:=FormatDateTime('yyyymm', pData)
else if DM4.Tb_ParGer02PG2FORMALOTEFAB.AsInteger=1 then
   mSiglaLote:=FormatDateTime('yyyy', pData)
else
   begin
   mSiglaTemp:=FormatDateTime('yyyy', pData);
   mSiglaLote:='';
   for x:=length(mSiglaTemp) downto 1 do
      begin
      mSiglaLote:=mSiglaLote+mSiglaTemp[x];
      end;
   end;
if mSiglaLote<>DM4.Tb_ParGer02PG2ULTFORLOTFAB.Value then
   begin
   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;
   DM1.Query1.SQL.add('Update PARGER02 set PG2ULTFORLOTFAB='+chr(39)+mSiglaLote+chr(39)
                     +', PG2PROXLOTFAB=1');
   try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      end;
   flparger02(0,0,'1');
   end;
if pTipo=2 then
   begin
   mSiglaLote:=mSiglaLote+FormatFloat('000', DM4.Tb_ParGer02PG2PROXLOTFAB.Value);


   DM4.Tb_ParGer02.Edit;
   DM4.Tb_ParGer02PG2PROXLOTFAB.Value:=DM4.Tb_ParGer02PG2PROXLOTFAB.Value-1;
   DM4.Tb_ParGer02.Post;
   end
else if pTipo=0 then
   begin
   mSiglaLote:=mSiglaLote+FormatFloat('000', DM4.Tb_ParGer02PG2PROXLOTFAB.Value);

   DM4.Tb_ParGer02.Edit;
   DM4.Tb_ParGer02PG2PROXLOTFAB.Value:=DM4.Tb_ParGer02PG2PROXLOTFAB.Value+1;
   DM4.Tb_ParGer02.Post;
   end
else
   begin
   mSiglaLote:=mSiglaLote+FormatFloat('000', DM4.Tb_ParGer02PG2PROXLOTFAB.Value-1);
   end;
if DM4.Tb_ParGer02PG2FORMALOTEFAB_MASC.AsInteger=1 then
   mSiglaLote:=Formatfloat('0"."000"-"000',  ValFloat(mSiglaLote))
else if DM4.Tb_ParGer02PG2FORMALOTEFAB_MASC.AsInteger=2 then
   mSiglaLote:=Formatfloat('0000',  ValFloat(mSiglaLote));

result:=mSiglaLote;
end;

