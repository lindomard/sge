                    + '   MAX(QTDEXCLUIDOS) AS QTDEXCLUIDOS, '
                    + '   MAX(RES03.QTD_CADDAR) AS QTD_CADDAR, '
                    + '   MAX(RES03.QTDPAGOS) AS QTDPAGOS, '
                    + '   MAX(RES03.QTDPEDEXCLUIDO) AS QTDPEDEXCLUIDO, '
                    + '   MAX(RES03.CRCODEMP) AS CRCODEMP, '
                    + '   MAX(RES03.CRDATHOR_EVE) AS CRDATHOR_EVE, '
                    + '   MAX(RES03.CRLOCAL) AS CRLOCAL, '
                    + '   MAX(RES03.CRCHAVEP) AS CRCHAVEP, '
                    + '   MAX(RES03.CRORDEMP) AS CRORDEMP, '
                    + '   MAX(RES03.CRLOTSEQ) AS CRLOTSEQ, '
                    + '   MAX(RES03.CRNUMERO) AS CRNUMERO, '
                    + '   MAX(RES03.CRDESD) AS CRDESD, '
                    + '   MAX(RES03.CRDUP) AS CRDUP, '
                    + '   MAX(RES03.CRTIPO) AS CRTIPO, '
                    + '   MAX(RES03.CRDTEMIS) AS CRDTEMIS, '
                    + '   MAX(RES03.CRCODCLI) AS CRCODCLI, '
                    + '   MAX(RES03.CRVALOR) AS CRVALOR, '
                    + '   MAX(RES03.CRCHAVE_ID) AS CRCHAVE_ID, '
                    + '   MAX(RES03.CRCHAVE_ID_ANO) AS CRCHAVE_ID_ANO, '
                    + '   MAX(RES03.CRNOMEPCLOGADO) AS CRNOMEPCLOGADO, '
                    + '   MAX(RES03.CRNOMEUSRLOGADO) AS CRNOMEUSRLOGADO, '
                    + '   MAX(RES03.CRPROGRAMAORIGEM) AS CRPROGRAMAORIGEM '
                    + '   ,NVL(MAX(OLD.CRCHAVE_ID),0) AS CHAVE_ID '
                    + '   ,NVL(MAX(OLD.CRCHAVE_ID_ANO),0) AS CHAVE_ID_ANO '
                    + '   ,NVL(MAX(OLD.CRCODEMP),0) AS CODEMP '
                    + ' from  '+mNomeTabelaTemp01+' RES03 '
                    + ' LEFT JOIN OLD_CADDAR OLD ON (OLD.CRNUMERO = RES03.CRNUMERO  '
                    + ' AND OLD.CRDESD = RES03.CRDESD AND OLD.CRCODEMP = RES03.CRCODEMP  '
                    + ' AND OLD.CRDTEMIS = RES03.CRDTEMIS) '
                    + ' where CRCHAVEP>0 '
                    + ' group by CHAVEID ');

try
