                     +' WHEN PCOPCIO=1 THEN '+QuotedStr('PERCCUS_')
                     +' else '+QuotedStr('NAO_IDEN_')+' END || '
                     +'   ROW_NUMBER() OVER (PARTITION BY PCOPCIO ORDER BY PCOPCIO,PCNOME) AS ITEM '
                     +' , PCOPCIO from CADPCUS ');
   Query_Pcus.Open;



              mLinha_C100_insert:='INSERT ('
                        +' T1.CUCODEMP '
                        +',T1.CUTIPO '
                        +',T1.CUCODIGO '
                        +',T1.CUCODPCU '
                        +',T1.CUPERC'
                        +',T1.CUBASECALC '
                        +',T1.CUVALOR '
                        +',T1.CUAPLS '
                        +',T1.CUFATOR '
                        +',T1.CUOPCIO '
                        +') values ('
                        +' SS.CUCODEMP '
                        +',SS.CUTIPO '
                        +',SS.CUCODIGO '
                        +',SS.CUCODPCU '
                        +',SS.CUPERC'
                        +',SS.CUBASECALC '
                        +',SS.CUVALOR '
                        +',SS.CUAPLS '
                        +',SS.CUFATOR '
                        +',SS.CUOPCIO '
                                 +') ';




              mLinha_C100_update:='UPDATE set T1.CUPERC=SS.CUPERC'
                                 +',T1.CUBASECALC=SS.CUBASECALC '
                                 +',T1.CUVALOR=SS.CUVALOR '
                                 +',T1.CUAPLS=SS.CUAPLS '
                                 +',T1.CUFATOR=SS.CUFATOR '
                                 +',T1.CUOPCIO=SS.CUOPCIO '

                                 +' ';

   mLista:='Select '+inttostr(iif(codemp>100,codemp-100,codemp))+' as CUCODEMP ';
   mLista:=mlista+', 0  as CUTIPO ';
   mLista:=mlista+', '+floattostr(pcodpro)+' as CUCODIGO ';



   if Query_Pcus.Locate('ITEM',Query_Temp.fieldbyName('FPCOMP').AsString,[]) then
      begin
      mLista:=mLista+','+Query_Pcus.FieldbyName('PCCODIGO').AsString+' as CUCODPCU ';
      mLista:=mLista+','+mudavp(query_temp.fieldbyname('FPVALOR').AsString)+' as CUPERC ';
