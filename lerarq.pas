function fAtualizaQtdDev(ptipo,pChave,pLotSeq,pCodEmp,pItem: Integer;pLote: String; pCodPro,pQtd: Real): Boolean;
var
Query_Exe: TQuery;
begin
Query_Exe:=TQuery.Create(nil);
Query_Exe.DatabaseName:='SG_ASSOC';
if (Log_TipoLote=1) and (DM1.Tb_PargerPFORPEDPAD.asinteger=3) then
   begin
   Query_Exe.Close;
   Query_Exe.SQL.Clear;
   Query_Exe.SQL.Add('Update CADP02_LOTES set '
                    +'P2LM_QTDDEV=nvl(P2LM_QTDDEV,0)');
   if ptipo=0 then // se entra
      Query_Exe.SQL.Add('+')
   else
      Query_Exe.SQL.Add('-');
   Query_Exe.SQL.Add(':QTDDEV where P2LM_CHAVE=:CHAVE '
                    +' and P2LM_LOTSEQ=:LOTSEQ '
                    +' and P2LM_CODEMP=:CODEMP '
                    +' and P2LM_CODPRO=:CODPRO '
                    +' and P2LM_ITEM=:ITEM ');
   if trim(pLote)='' then
      query_exe.SQL.Add(' and (P2LM_LOTE is null or P2LM_LOTE='+QuotedStr(' ')+' or P2LM_LOTE=:LOTE )')
   else
      query_exe.SQL.Add(' and P2LM_LOTE=:LOTE ');
   query_exe.ParamByName('QTDDEV').AsFloat:=pQtd;
   query_exe.ParamByName('CHAVE').AsInteger:=pChave;
   query_exe.ParamByName('LOTSEQ').AsInteger:=pLotSeq;
   query_exe.ParamByName('CODEMP').AsInteger:=pCodEmp;
   query_exe.ParamByName('CODPRO').AsFloat:=pCodPro;
   query_exe.ParamByName('QTDDEV').AsFloat:=pQtd;
   query_exe.ParamByName('ITEM').AsInteger:=pItem;
   query_exe.ParamByName('LOTE').AsString:=pLote;
   try
      Query_Exe.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql_Novo(Query_Exe,19231,'lerarq','CADP02_LOTES');
      result:=false;
      end;
   end;


Query_Exe.Close;
Query_Exe.SQL.Clear;
Query_Exe.SQL.Add('Update CADP02 set '
                 +'P2QTDDEV=nvl(P2QTDDEV,0)');
if ptipo=0 then // se entra
   Query_Exe.SQL.Add('+')
else
   Query_Exe.SQL.Add('-');
Query_Exe.SQL.Add(':QTDDEV where P2CHAVE=:CHAVE '
                 +' and P2LOTSEQ=:LOTSEQ '
                 +' and P2CODEMP=:CODEMP '
                 +' and P2CODPRO=:CODPRO '
                 +' and P2ITEM=:ITEM ');
query_exe.ParamByName('QTDDEV').AsFloat:=pQtd;
query_exe.ParamByName('CHAVE').AsInteger:=pChave;
query_exe.ParamByName('LOTSEQ').AsInteger:=pLotSeq;
query_exe.ParamByName('CODEMP').AsInteger:=pCodEmp;
query_exe.ParamByName('CODPRO').AsFloat:=pCodPro;
query_exe.ParamByName('ITEM').AsInteger:=pItem;
try
   Query_Exe.ExecSQL;
   fdm1StartCommit;
except
   ex_erroSql_Novo(Query_Exe,19231,'lerarq','CADP02_LOTES');
   result:=false;
   end;

end;
