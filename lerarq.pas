function fAjustarEstoque(pEntSai, plocArmaz: Integer; pCodPro,pQtd: Real; pLote,pMotivo: String;pDtFab,pDtVcto: TDateTime): Integer;
var
query_aju: TQuery;
mChaveAju: Integer;
pBaixar: pBaixarLotes;
mIdNew: Integer;
begin

query_aju:=TQuery.create(nil);
query_aju.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
mIdNew := fBuscarProximoid('CADAJU_SEQ');

mChaveAju:=fBuscaCADAJU(0);
query_aju.close;
query_aju.Sql.Clear;
query_aju.sql.Add('Insert into CADAJU ('
                  +' AJCODEMP '
                  +',AJFILIAL '
                  +',AJSEQ '
                  +',AJLOTSEQ '
                  +',AJDATA '
                  +',AJDATAREF '
                  +',AJCODPRO '
                  +',AJLOTE '
                  +',AJDTFAB '
                  +',AJDATAV '
                  +',AJDTFAB '
                  +',AJQTD '
                  +',AJTIPOM '
                  +',AJMOTIVO '
                  +',AJCODUSR '
                  +',AJESTMOV '
                  +',AJID_NEW '
                  +') Values  ( '
                  +':AJCODEMP '
                  +',:AJFILIAL '
                  +',:AJSEQ '
                  +',:AJLOTSEQ '
                  +',SYSDATE '

                  +',SYSDATE '
                  +',:AJCODPRO '
                  +',:AJLOTE '
                  +',:AJDATAV '
                  +',:AJDTTAB '
                  +',:AJQTD '
                  +',:AJTIPOM '
                  +',:AJMOTIVO '
                  +',:AJCODUSR '
                  +',:AJESTMOV '
                  +',:AJID_NEW '
                  +')');


query_aju.ParamByName('AJCODEMP').AsInteger:=codemp;
query_aju.ParamByName('AJFILIAL').AsInteger:=plocArmaz;
query_aju.ParamByName('AJSEQ').AsInteger   :=mChaveAju;
query_aju.ParamByName('AJLOTSEQ').AsInteger:=ls_cadaju;
query_aju.ParamByName('AJCODPRO').AsFloat  :=pCodpro;
query_aju.ParamByName('AJLOTE').AsString   :=pLote;
query_aju.ParamByName('AJDTFAB').AsDateTime:=pDtVcto;
query_aju.ParamByName('AJDATAV').AsDateTime:=pDtVcto;
query_aju.ParamByName('AJQTD').AsFloat     :=pQtd;
query_aju.ParamByName('AJTIPOM').AsInteger :=pEntSai;
query_aju.ParamByName('AJMOTIVO').AsString :=pMotivo;
query_aju.ParamByName('AJCODUSR').AsInteger:=codusr;
query_aju.ParamByName('AJESTMOV').AsInteger:=0;
query_aju.ParamByName('AJID_NEW').AsInteger:=mIdNew;
try
   query_aju.ExecSQL;
   fdm1StartCommit;
except on e : exception do
   ex_erroSql_Novo(query_aju,28811,'erro ao criar o cadaju'+e.Message ,'CADAJU');
   end;
query_aju.Close;
freeandnil(query_aju);



pBaixar.pCodemp := codemp;
pBaixar.pFilial := plocArmaz;
pBaixar.pItem   := 0;
pBaixar.pDocOri := 04;
pBaixar.pCodUsr  := codusr;
pBaixar.pContEsp := 0;
pBaixar.pTipoProd := Log_TipoProdPad;
pBaixar.pChave   := mChaveAju;
pBaixar.pChave_ano := ls_cadaju;
pBaixar.pQtd       := pQtd;
pBaixar.pCodPro    := FloatTostr(pCodPro);
pBaixar.pEstNor       := iif(pEntSai=0,'E','S'); // estnor
pBaixar.pEstReservado := 'N';
pBaixar.pLote         := pLote;
pBaixar.pDtVcto       := pDtVcto;
pBaixar.pDtFab        := pDtFab;   
pBaixar.pLoteRe       := '';
pBaixar.pObs          := '';
PBaixar.pChaveIdNew   := mIdNew;

fBaixarMercadorias(pBaixar);

{


fBaixarMercadorias(codemp
         ,plocArmaz
         ,0 // item
         ,04 // docori / ordem de producao
         ,codusr
         ,0 //pcontesp
         ,0 //ptipoprod
         ,mChaveAju
         ,ls_cadaju
         ,pQtd
         ,FloattoStr(pCodPro)
         ,iif(pEntSai=0,'E','S') // estnor
         ,'N' // estreversado
         ,pLote
         ,pDtVcto
         ,'' // lote re
         ,pMotivo // obs
         );
}
result:=mChaveAju;
end;



function fRetirarBloqueados(pTabBloq: array of string): String;
var
mSaida: String;
x_tab: integer;
x_qtdtab: integer;
begin
x_qtdtab:=high(pTabBloq);
mSaida:='';

for x_tab:=0 to x_qtdtab do
   begin
   if pTabBloq[x_tab]='CADBCO' then
      mSaida:=mSaida+' and NVL(BCSITCAD,0) < 7 '
   else if pTabBloq[x_tab]='CADDEP' then
      mSaida:=mSaida+' and NVL(DSITCAD,0) < 7 '
   else if pTabBloq[x_tab]='CADCCU' then
      mSaida:=mSaida+' and NVL(CCSITCAD,0) < 7 '
   else if pTabBloq[x_tab]='CADUSR_CX' then
      mSaida:=mSaida+' and (TIPO='+QuotedStr('US')+' and NVL(USR_SITCAD,0) < 7 or TIPO<>'+QuotedStr('US')+')';
   end;
result := msaida;

end;


