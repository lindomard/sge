   Query_exe.ParamByName('EXT_CODPRO').AsFloat   :=pCodPro;
   Query_exe.ParamByName('EXT_QTD').AsFloat      := pqtd;
   Query_exe.ParamByName('EXT_DATHOR').AsDateTime:=now;
   Query_exe.ParamByName('EXT_NOME_COMP').AsString:=nomecomputador;
   Query_exe.ParamByName('EXT_CODUSR').AsInteger :=codusr;
   Query_exe.ParamByName('EXT_ORIGEM').AsString  :=pformulario;
   Query_exe.ParamByName('EXT_TIPOMOV').AsString :=pTipoMov;
   Try
      Query_exe.ExecSQL;
      fdm1StartCommit;
      break;
   except
      if x=1 then
         begin
         ex_erroSql_Novo(Query_exe,14464,'func2','CADEST');
         end
      else
         fSequenceTestaeAjusta('EXTPRO'+FormatDateTime('YYYY',DATE),1);
//         fCriarSequencia('EXTPRO'+FormatDateTime('YYYY',DATE),1);
      end;
   end;

result:=true;
FreeAndNil(Query_exe);
end;

function fCriarSequencia(pNomeSeq: String; pValorIni: Integer): Boolean;
var
  Query_chave: TQuery;
     procedure pfechartudo;
     begin
     if query_chave<>nil then
        begin
        query_chave.close;
        freeandnil(query_chave);
        end;
     end;
begin
if pvalorini<=1 then
  pValorIni:=1;


Query_chave:=TQuery.Create(nil);
Query_chave.DatabaseName:='SG_ASSOC';

Query_chave.Close;
Query_chave.SQL.clear;
query_chave.SQL.Add('select count(*) as qtd from user_objects '
                   +' where object_type='+QuotedStr('SEQUENCE')
                   +' and object_name='+QuotedStr(pNomeSeq));
try
   Query_chave.open;
except on e : exception do
   begin
   ex_erroSql_Novo(query_chave,177790,'frm lrs'+e.Message ,'CADEST');
   pfechartudo;
   result:=false;
   exit;
   end;
   end;

if Query_chave.FieldByName('qtd').AsInteger<1 then
   begin
   Query_chave.Close;
   Query_chave.SQL.clear;
   Query_chave.SQL.Add('create sequence '+pNomeSeq+' start with '+IntTostr(pValorIni)+' increment by 1 nocache');
   try
      Query_chave.execsql;
      fdm1StartCommit;
   except on e : exception do
      begin
      ex_erroSql_Novo(query_chave,17815,'frm lrs'+e.Message ,'CADEST');
      pfechartudo;
      result:=false;
      exit;
      end;
      end;
   end;
pfechartudo;
result:=true;
end;

function fAjustarSequenceNova(pDadosSequence: tDadosSequence): Integer;
var
Query_chave: TQuery;
x: Integer;
mRetorno:Integer;
begin
mRetorno:=0;
Query_chave:=TQuery.Create(nil);
Query_chave.DatabaseName:='SG_ASSOC';
Query_chave.sql.add('Select nvl(max(' + pDadosSequence.nomeChaveId+'),0)+1 as chave_id from '+pDadosSequence.nomeTabela);
try
   Query_chave.open;
   mRetorno:=Query_chave.fieldbyName('chave_id').AsInteger;
   Query_chave.Close;
   Query_chave.sql.clear;
   Query_chave.sql.add('drop sequence '+pDadosSequence.nomeSequence);
   Query_chave.ExecSQL;

   Query_chave.Close;
   Query_chave.sql.clear;
   Query_chave.sql.add('create sequence '+pDadosSequence.nomeSequence
                      +' start with '+inttostr(mRetorno)
                      + ' increment by 1 ');
   Query_chave.ExecSQL;
   Result := mRetorno;

except on e : exception do
   begin
   ex_erroSql_Novo(Query_chave,18855,'lerarq '+e.message ,'');
   result :=0;
   end;
   end;
Query_chave.close;
freeandnil(query_chave);
end;




