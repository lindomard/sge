function fReecupomCancelaEmpresAnterior(pCodemp,pLotSeq,pChave,pOrdem: Real): Boolean;
var
query_dar: TQuery;
query_fpcrdup: TQuery;
query_exe: TQuery;
begin
result:=true;
query_dar:=TQuery.create(nil);
query_dar.DatabaseName:=DM1.SG_ASSOC.DatabaseName;

query_fpcrdup:=TQuery.create(nil);
query_fpcrdup.DatabaseName:=DM1.SG_ASSOC.DatabaseName;

query_exe:=TQuery.create(nil);
query_exe.DatabaseName:=DM1.SG_ASSOC.DatabaseName;

query_dar.Close;
query_dar.SQL.Clear;
query_dar.SQL.Add('Select CRNUMERO,CRDESD,CRDUP,CRCODLDR,CRCODEMP,CRLOTSEQ_FC,CRCODECF,CRDTEMIS '
                  +' from CADDAR where '
                  +' CRCODEMP=0'+FloatToStr(pCodemp)
                  +' and CRLOTSEQ_CP=0'+FloatToStr(pLotseq)
                  +' and CRNPED=0'+FloatToStr(pChave)
                  +' and CRORDEM=0'+FloatToStr(pOrdem));
query_dar.Open;
While not query_dar.Eof do
   begin

   query_fpcrdup.Close;
   query_fpcrdup.SQL.Clear;
   query_fpcrdup.SQL.Add('Select FPLOTE,FPJUROS,FPDESC,FPCODEMP from FPCRDUP where '
                     +' FPCODEMP=0'+FloatToStr(pCodemp)
                     +' and FPDUP_CODEMP=0'+query_dar.FieldByName('CRCODEMP').AsString
                     +' and FPCODECF=0'+query_dar.FieldByName('CRCODECF').AsString
                     +' and FPNUMERO=0'+query_dar.FieldByName('CRNUMERO').AsString
                     +' and FPDESD='+chr(39)+query_dar.FieldByName('CRDESD').AsString+chr(39)
                     +' and FPTIPO=0'+query_dar.FieldByName('CRDUP').AsString
                     +' and FPDTEMIS='+chr(39)+query_dar.FieldByName('CRDTEMIS').AsString+chr(39));
   query_fpcrdup.Open;



   While not query_fpcrdup.Eof do
      begin
      DM1.Query4.close;
      DM1.Query4.Sql.Clear;
      DM1.Query4.Sql.Add('Select FPLOTE,FPCODEMP,FPCODLDR,FPLOTSEQ_FC from FPCR where '
                        +' FPCODEMP=0'+query_fpcrdup.fieldbyName('FPCODEMP').AsString
                        +' and FPLOTE=0'+query_fpcrdup.FieldByName('FPLOTE').AsString);
      DM1.query4.Open;
      While not DM1.Query4.eof do
         begin
         query_exe.Close;
         query_exe.SQL.Clear;
         query_exe.SQL.Add('Delete from CADLDR where '
                     +' CODEMP=0'+DM1.Query4.FieldByName('FPCODEMP').AsString
                     +' and LOTSEQ=0'+DM1.Query4.FieldByName('FPLOTSEQ_FC').AsString
                     +' and CODLDR=0'+DM1.Query4.FieldByName('FPCODLDR').AsString);
         Try
            query_exe.ExecSQL;
            fdm1StartCommit;
         except
            verteclado(0);
            fmensagem('Erro 250 ao excluir o CADLDR!',0,['0'],0);
            end;
         DM1.Query4.Next;
         end;

      query_exe.Close;
      query_exe.SQL.Clear;
      query_exe.SQL.Add('Delete from FPCR where '
                        +' FPCODEMP=0'+query_fpcrdup.FieldbyName('FPCODEMP').AsString
                        +' and FPLOTE=0'+query_fpcrdup.FieldbyName('FPLOTE').AsString);
      Try
         query_exe.ExecSQL;
         fdm1StartCommit;
      except
         verteclado(0);
         fmensagem('Erro 301!',0,['0'],0);
         end;
      query_exe.Close;
      query_exe.SQL.Clear;
      query_exe.SQL.Add('Delete from CADCHQ where '
                        +' CHCODEMP=0'+query_fpcrdup.FieldbyName('FPCODEMP').AsString
                        +' and CHLOTE=0'+query_fpcrdup.FieldbyName('FPLOTE').AsString);
      Try
         query_exe.ExecSQL;
         fdm1StartCommit;
      except
         verteclado(0);
         fmensagem('Erro 312!',0,['0'],0);
         end;
      query_fpcrdup.Next;
      end;

   query_fpcrdup.Close;
   query_fpcrdup.SQL.Clear;
   query_fpcrdup.SQL.Add('Delete from FPCRDUP where '
                     +' FPCODEMP=0'+FloatToStr(pCodemp)
                     +' and FPDUP_CODEMP=0'+query_dar.FieldByName('CRCODEMP').AsString
                     +' and FPCODECF=0'+query_dar.FieldByName('CRCODECF').AsString
                     +' and FPNUMERO=0'+query_dar.FieldByName('CRNUMERO').AsString
                     +' and FPDESD='+chr(39)+query_dar.FieldByName('CRDESD').AsString+chr(39)
                     +' and FPTIPO=0'+query_dar.FieldByName('CRDUP').AsString
                     +' and FPDTEMIS='+chr(39)+query_dar.FieldByName('CRDTEMIS').AsString+chr(39));
   Try
      query_fpcrdup.ExecSQL;
      fdm1StartCommit;
   except
      verteclado(0);
      fmensagem('Erro 328!',0,['0'],0);
      end;
   query_dar.Next;
   end;

      mGerarOldCadDar.pStatus:=9;
      mGerarOldCadDar.pNumero:=0;
      mGerarOldCadDar.pCodcli:=0;
      mGerarOldCadDar.pDup:=0;
      mGerarOldCadDar.pDesd:='';
      mGerarOldCadDar.pMotivo:='EXCLUSAO 31491';
      mGerarOldCadDar.pCodEmp:=trunc(pcodemp);
      mGerarOldCadDar.pChavePed:=trunc(pchave);
      mGerarOldCadDar.pLotseqPed:=trunc(plotseq);
      mGerarOldCadDar.pDtEmis:=pdatanula;

       fGerarOldCadDar(mGerarOldCadDar);


query_fpcrdup.Close;
query_fpcrdup.SQL.Clear;
query_fpcrdup.SQL.Add('Delete from CADDAR where '
                  +' CRCODEMP=0'+FloatToStr(pcodemp)
                  +' and CRLOTSEQ_CP=0'+FloatToStr(plotseq)
                  +' and CRNPED=0'+FloatToStr(pChave)
                  +' and CRORDEM=0'+FloatToStr(pOrdem));
Try
   query_fpcrdup.ExecSQL;
   fdm1StartCommit;
except
   verteclado(0);
   fmensagem('Erro 342!',0,['0'],0);
   end;

query_fpcrdup.Close;
query_fpcrdup.SQL.Clear;
query_fpcrdup.SQL.Add('Delete from CADNS where '
                  +' NSCODEMP=0'+FloatToStr(pcodemp)
                  +' and NSLOTSEQ_CP=0'+FloatToStr(pLotseq)
                  +' and NSCHAVEP=0'+FloatToStr(pChave)
                  +' and NSORDEMP=0'+FloatToStr(pOrdem)
                  +' and NSNFCF=1');
Try
   query_fpcrdup.ExecSQL;
   fdm1StartCommit;
except
   verteclado(0);
   fmensagem('Erro 355!',0,['0'],0);
   end;


query_dar.close;
freeandnil(query_dar);


query_fpcrdup.close;
freeandnil(query_fpcrdup);

query_exe.close;
freeandnil(query_exe);


end;


