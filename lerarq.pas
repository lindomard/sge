      mcinst:=',';
      end;

   if trim(pGerar.pCampoNomUsr)<>'' then
      begin
      Query_exe.SQL.Add(mcinst+':'+pGerar.pCampoNomUsr);
      mcinst:=',';
      end;

   if trim(pGerar.pCampoStatus)<>'' then
      begin
      Query_exe.SQL.Add(mcinst+':'+pGerar.pCampoStatus);
      mcinst:=',';
      end;


   if trim(pGerar.pCampoMotivo)<>'' then
      begin
      Query_exe.SQL.Add(mcinst+':'+pGerar.pCampoMotivo);
      mcinst:=',';
      end;



   While not Query_Old.Eof do
      begin
      if pGerar.pCampoChaveOld=Query_Old.fieldbyName('COLUMN_NAME').asString then
         begin
         Query_Old.Next;
         Continue;
         end;

      Query_exe.SQL.Add(mcinst+Query_Old.fieldbyName('COLUMN_NAME').asString);
      mcinst:=',';
      Query_Old.Next;
      end;
   Query_exe.SQL.Add(' ');
   Query_exe.SQL.Add(' from '+pGerar.pTabela);
   if trim(pGerar.pCondicao)<>'' then
      Query_exe.SQL.add(pGerar.pCondicao);


   if trim(pGerar.pCampoDatHor)<>'' then
      Query_exe.ParamByName(pGerar.pCampoDatHor).AsDateTime:=Now;

