query_movprod.ParamByName('DOCORI').AsInteger     :=pBaixar.pDocOri;
query_movprod.ParamByName('CODPRO').AsString      :=pBaixar.pcodPro;
query_movprod.ParamByName('QTD').AsFloat          :=pBaixar.pQtd;
query_movprod.ParamByName('ESTNOR').AsString      :=pBaixar.pEstNor;
query_movprod.ParamByName('ESTRESERVADO').AsString:=pBaixar.pEstReservado;
query_movprod.ParamByName('CODUSR').AsInteger     :=pBaixar.pCodUsr;
query_movprod.ParamByName('CONTESP').AsInteger    :=pBaixar.pContEsp;
query_movprod.ParamByName('TIPOPROD').AsInteger   :=pBaixar.pTipoProd;
query_movprod.ParamByName('LOTE').AsString        :=pBaixar.pLote;
query_movprod.ParamByName('DTVCTO').AsDatetime    :=pBaixar.pDtvcto;
query_movprod.ParamByName('DTFAB').AsDatetime      :=pBaixar.pDtFab;
query_movprod.ParamByName('CMP_QTDDEC_QTD').AsInteger :=iif(DM1.Tb_PargerPCASIND.AsInteger>DM1.Tb_PargerPCASQTD.AsInteger,DM1.Tb_PargerPCASIND.AsInteger,
DM1.Tb_PargerPCASQTD.AsInteger);
query_movprod.ParamByName('CMP_ID_DOC_NEW').AsInteger :=pBaixar.pChaveIdNew;
try
   query_movprod.ExecSQL;
   fdm1StartCommit;
except on e : exception do
   ex_erroSql_Novo(query_movprod,1111,'func Erro:'+e.Message ,'CADEST');
   end;
freeandnil(query_movProd);
end;
function flbaientPen(ptipo,pcodemp: Integer; pvalor: String; pqtd: real): Boolean;
//PTIPO=0 INCLUIR(SOMAR) 1-EXCLUIR(DIMINUIR)
var
query_pfor02: tQuery;
begin
query_pfor02:=tQuery.Create(nil);
Query_Pfor02.DatabaseName:='SG_ASSOC';

Query_Pfor02.Close;
Query_Pfor02.sql.clear;
Query_Pfor02.sql.add('Update CADPRO set PDENTPEN=PDENTPEN+:QTD where PDCODPRO=:CODPRO '
                    +fCondicoesMultiEmpresa('CADEST','PDCODEMP'));
query_pfor02.ParamByName('CODPRO').AsFloat:=Fsonumero(pvalor);
if pTipo=0 then
   query_pfor02.ParamByName('QTD').AsFloat:=pQtd
else
   query_pfor02.ParamByName('QTD').AsFloat:=pQtd*-1;

try
   query_pfor02.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
   result:=false;
   end;

result:=true;
end;


