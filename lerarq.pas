                    +' OR (CRDATHOR_EVE>'+quotedstr('01/01/2018')+' and NVL(CRTIPEVE,0)=0) '
                    +' ) '
                    +'  ) AS QTDEXCLUIDOS, '
                    +' (SELECT COUNT(*) FROM CADDAR DENTRO '
                    +' where DENTRO.CRCODEMP=FORA.CRCODEMP '
                    +' AND DENTRO.CRNUMERO=FORA.CRNUMERO '
                    +' AND DENTRO.CRDESD=FORA.CRDESD '
                    +' AND DENTRO.CRDUP=FORA.CRDUP '
                    +'  ) AS QTD_CADDAR, '
                    +' (SELECT COUNT(*) FROM FPCRDUP DENTRO '
                    +' where DENTRO.FPCODEMP=FORA.CRCODEMP '
                    +' AND DENTRO.FPNUMERO=FORA.CRNUMERO '
                    +' AND DENTRO.FPDESD=FORA.CRDESD '
                    +' AND DENTRO.FPTIPO=FORA.CRDUP '
                    +'  ) AS QTDPAGOS, '
                    +' (SELECT COUNT(*) FROM CADP01 DENTRO '
                    +' where DENTRO.P1CODEMP=FORA.CRCODEMP '
                    +' AND DENTRO.P1CHAVE=FORA.CRCHAVEP '
                    +' AND DENTRO.P1ORDEM=FORA.CRORDEMP '
                    +' AND P1STATUS>2 '
                    +'  ) AS QTDPEDEXCLUIDO, '
                    +'  FORA.* '
                    +'   from CADDAR_EVE FORA '
                    +'   WHERE CRDATHOR_EVE>'+quotedstr('25/02/2019')
                    +'  )  '
                    +'  group by   CRCODEMP,  '
                    +'   CRCHAVEP, '
                    +'   CRORDEMP, '
                    +'   CRLOTSEQ, '
                    +'   CRNUMERO, '
                    +'   CRDESD  , '
                    +'   CRDUP, '
                    +'   CRTIPO, '
                    +'   CRDTEMIS '
                    +' ) t1 ');


try
