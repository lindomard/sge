procedure fCorrigirCaddar;
var
query_duplicadas: tQuery;
query_titulo: tQuery;
mchave_id: integer;
mchave_id_ano: integer;

begin

if not flfilpad(0,'_coorecoes','corrigirCaddar6') then
   begin
   fGravaPadroes(0,'corrigirCaddar6'    ,'text' ,'_coorecoes','sim');
   query_duplicadas:=tQuery.create(nil);
   query_titulo    :=tQuery.create(nil);
   query_duplicadas.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
   query_titulo.DatabaseName    :=DM1.SG_ASSOC.DatabaseName;
   query_titulo.sql.clear;
   query_titulo.sql.add('Update CADDAR set CRCHAVE_ID=0, CRCHAVE_ID_ANO=0 WHERE CRCHAVE_ID IS NULL OR CRCHAVE_ID_ANO IS NULL');
   try
     query_titulo.execsql;
     fdm1StartCommit;
   except on e : exception do
      begin
      ex_erroSql_Novo(query_titulo,34971,'SGE','CADDAR');
      query_titulo.Close;
      freeandnil(query_titulo);
      exit;
      end;
      end;




   query_duplicadas.SQL.add('SELECT * FROM ( '
                       +' select T1.*,CADDAR.ROWID AS COLUNA_ID_ATUAL '
                       +' ,CADDAR.CRDTEMIS AS DTEMIS '
                       +'                   FROM ( '
                       +' SELECT CRCHAVE_ID,CRCHAVE_ID_ANO,CRCODEMP,MIN(CRDTEMIS) AS MINDTEMIS, MAX(CRDTEMIS) AS MAXDTEMIS, '
                       +' MIN(CRSTATUS) AS MINSTATUS,MAX(CRSTATUS) AS MAXSTATUS, '
                       +' COUNT(*) AS QTD,MAX(CADDAR.ROWID) AS COLUNA_ID_MAXIMA '
                       +'  FROM '
                       +' CADDAR '
                       +' GROUP BY CRCHAVE_ID,CRCHAVE_ID_ANO,CRCODEMP '
                       +' HAVING COUNT(*)>1 '
                       +' ) T1,CADDAR WHERE CADDAR.CRCHAVE_ID=T1.CRCHAVE_ID '
                       +' AND CADDAR.CRCHAVE_ID_ANO=T1.CRCHAVE_ID_ANO '
                       +' ORDER BY T1.CRCHAVE_ID_ANO,T1.CRCHAVE_ID '
                       +' ) WHERE COLUNA_ID_MAXIMA<>COLUNA_ID_ATUAL ');

   try
     query_duplicadas.open;
   except on e : exception do
      begin
      ex_erroSql_Novo(query_duplicadas,35003,'SGE','CADDAR');
      query_duplicadas.Close;
      freeandnil(query_duplicadas);
      exit;
      end;
      end;

   While not query_duplicadas.eof do
      begin
      mchave_id_ano:=valint(formatDateTime('yyyy', query_duplicadas.fieldbyName('DTEMIS').asDateTime));
      mchave_id    :=fBuscareTestarID('CADDAR_'+FormatFloat('0000', mchave_id_ano));

      query_titulo.close;
      query_titulo.sql.clear;
      query_titulo.sql.Add('Update caddar SET CRCHAVE_ID='+Inttostr(mchave_id)
      +' , CRCHAVE_ID_ANO='+Inttostr(mchave_id_ano)
      +' where ROWID=:CHAVE_ROWID ');
      query_titulo.ParamByName('CHAVE_ROWID').AsString := query_duplicadas.fieldbyName('COLUNA_ID_ATUAL').Asstring;
      try
         query_titulo.ExecSQL;
         fdm1StartCommit;
      except on e : exception do
         begin
         ex_erroSql_Novo(query_titulo,35027,'SGE','CADDAR');
         query_titulo.Close;
         freeandnil(query_titulo);
         query_duplicadas.Close;
         freeandnil(query_duplicadas);
         exit;
         end;
         end;
      query_duplicadas.next;
      end;

   query_titulo.close;
   query_duplicadas.Close;

   freeandnil(query_titulo);
   freeandnil(query_duplicadas);

   end;




end;




