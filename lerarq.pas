procedure fExecutarAlterTable(pComando: String);
var
query_alter: tQuery;
i: integer;
begin
query_alter:= tQuery.Create(nil);
query_alter.DatabaseName := DM1.SG_ASSOC.DatabaseName;
pComando:=fRetirarEspacosDuplos(pComando);
pComando:=UpperCase(pcomando);
for i:=0 to 2 do
   begin
   query_alter.close;
   query_alter.sql.clear;
   query_alter.sql.add(pComando);
   try
      query_alter.ExecSQL;
      fdm1StartCommit;
      break;

    except ON E: Exception do
       begin
       if pos('01442',e.Message)>0 then
          begin
          pComando:=fSubstituirTexto(pComando,'NOT NULL','');
          pComando:=fSubstituirTexto(pComando,'NULL','');
          end;
       end;   
       end;
   end;

query_alter.close;
freeandnil(query_alter);

end;

procedure verificarQrTid;
var
query_tid: tQuery;

begin
query_tid:=tQuery.Create(nil);;
query_tid.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_tid.SQL.add('select COUNT(*) AS QTD from USER_TAB_COLUMNS WHERE TABLE_NAME='+QuotedStr('CADTID')
                  +' AND COLUMN_NAME='+QuotedStr('TINOME')+' AND DATA_LENGTH<>30 ');
try
   query_tid.open;
   if (query_tid.fieldbyname('qtd').AsInteger>0) then
      begin
      query_tid.close;
      query_tid.SQL.CLEAR;
      query_tid.sql.add('alter table CADTID MODIFY TINOME VARCHAR2(30)');
      query_tid.ExecSQL;
      end;
except ON E: Exception do
   begin
   ex_erroSql_Novo(query_tid,39891,'_stru '+e.message,'user');
   end;
   end;
query_tid.close;
freeandnil(query_tid);


end;




