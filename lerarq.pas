query_temp.SQL.add('CREATE TABLE ' + mNomeTabelaTemp01 +' AS '
                    +' SELECT ROWNUM AS CHAVEID, T1.* FROM ( '
                    +' select max(QTDEXCLUIDOS) as QTDEXCLUIDOS, '
                    +'   max(QTD_CADDAR) as QTD_CADDAR, '
                    +'   max(QTDPAGOS) as QTDPAGOS, '
                    +'   max(QTDPEDEXCLUIDO) as QTDPEDEXCLUIDO, '
                    +'   max(CRDATHOR_EVE) as CRDATHOR_EVE, '
                    +'   max(CRLOCAL) as CRLOCAL, '
                    +'   max(CRCODCLI) as CRCODCLI, '
                    +'   max(CRVALOR) as CRVALOR, '
                    +'   max(CRCHAVE_ID) as CRCHAVE_ID, '
                    +'   max(CRCHAVE_ID_ANO) as CRCHAVE_ID_ANO, '
                    +'   max(CRNOMEPCLOGADO) as CRNOMEPCLOGADO, '
                    +'   max(CRNOMEUSRLOGADO) as CRNOMEUSRLOGADO, '
                    +'   max(CRPROGRAMAORIGEM) as CRPROGRAMAORIGEM, '
