   begin
   DM1.Tb_Dar.Sql.Add(' and CDENOM like '+chr(39)+pDadosCadDar.pFantasia+'%'+chr(39));
   mOrdem:=mOrdem+iif(trim(mOrdem)='','',',')+ 'CDENOM';
   end;
if pDadosCadDar.pNumDup<>0 then
   DM1.Tb_Dar.Sql.Add(' and CRNUMERO='+inttoStr(pDadosCadDar.pNumDup));

if pDadosCadDar.pCodcli<>0 then
   DM1.Tb_Dar.Sql.Add(' and CRCODCLI='+inttoStr(pDadosCadDar.pCodcli));
if pDadosCadDar.pCodVen<>0 then
   DM1.Tb_Dar.Sql.Add(' and CRCODVEN='+inttoStr(pDadosCadDar.pCodVen));


if pDadosCadDar.pDtemis<>pdatanula then
   begin
   Try
      DM1.Tb_Dar.SQL.Add(fFormatdatetimeParaConsulta_unica('CRDTEMIS',pDadosCadDar.pDtemis));
   except
      fmensagem('Data Invalida. Favor digitar no formato dd/mm/aaaa com as barras',0,['0'],0);
      end;
   end;

if pDadosCadDar.pDtVcto<>pdatanula then
   begin
   Try
      DM1.Tb_Dar.SQL.Add(fFormatdatetimeParaConsulta_unica('CRDTVCTO',pDadosCadDar.pDtVcto));
   except
      fmensagem('Data Invalida. Favor digitar no formato dd/mm/aaaa com as barras',0,['0'],0);
      end;
   end;

if trim(pDadosCadDar.pDesd)<>'' then
   DM1.Tb_Dar.Sql.Add(' and CRDESD='+QuotedStr(pDadosCadDar.pDesd));
if pDadosCadDar.pDup<>'' then
