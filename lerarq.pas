                              +iif(DM1.Qr_TID.Locate('TINOME','CADPRO',[]),'',' PDCODEMP=0'+IntToStr(codemp)+' and ')
                              +' PDCODBAR=0'+mcinst4
                              +' and PDCODFOR=0'+DM1.Query2.fieldbyName('FCODFOR').AsString);
