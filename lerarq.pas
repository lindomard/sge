   pQtdvias:=1;
if Qr_Dup.mem_dup.Active=false then
   Qr_Dup.mem_dup.open;
Qr_Dup.mem_dup.EmptyTable;

DM2.Tb_Dar.first;
While not DM2.Tb_Dar.eof do
   begin
   for x_vias:=1 to pqtdvias do
      begin
      Qr_Dup.mem_dup.Append;
      Qr_Dup.mem_dupCRTOTNF.value := DM2.Tb_DarCRTOTNF.AsFloat;
      Qr_Dup.mem_dupCRDTEMIS.value := DM2.Tb_DarCRDTEMIS.asdatetime;
