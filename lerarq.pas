DM1.Query1.parambyName('LOTSEQ').AsFloat:=pLotSeq;
DM1.Query1.parambyName('CODEMP').AsFloat:=pCodEmp;
DM1.Query1.Open;

if ((DM1.Tb_PargerPCRDOC.Value = 1) and
    (DM1.Query1.FieldByName('CRNPED').AsString<>DM1.Query1.FieldByName('CRNUMERO').AsString))
    or ((DM1.Tb_PargerPCRDOC.Value=0) and (DM1.Query2.FieldByName('P1NUMNF').AsFloat>0) and
    (DM1.Query2.FieldByName('P1NUMNF').AsString<>DM1.Query1.FieldByName('CRNUMERO').AsString))
    or (DM1.Query1.IsEmpty) then
  begin
