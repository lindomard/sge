function fTestarServidor_NFE(pcodemp: integer;pSerie: String; out pmensagem: string; out pEletronica: boolean): Boolean;

var
Query_xml: TSQLQuery;
Query_Cons: TQuery;
Form_Nfe_Aguarde:TFrm_Nfe_Aguarde;
x_nfe: integer;
begin
pmensagem:='';
Query_Cons:=TQuery.Create(nil);
Query_Cons.DatabaseName:='SG_ASSOC';
Query_Cons.close;
Query_Cons.SQL.clear;
Query_Cons.SQL.Add('SELECT PNF_SERVIDOR01,PNF_SERVIDOR02,PNF_SERVIDOR03,PNF_TIPOFORM '
                  +' FROM CADPAR_NF where PNF_CODEMP=:CODEMP '
                  +' AND PNF_CHAVE=:CHAVE ');
Query_Cons.ParamByName('CODEMP').Value:=pcodemp;
Query_Cons.ParamByName('CHAVE').Value :=pSerie;
try
   Query_Cons.Open;
except
   result:=false;
   freeandnil(query_cons);
   exit;
   end;
result:=true;

pEletronica:=false;
if query_cons.fieldbyname('PNF_TIPOFORM').asinteger=1 then
   begin
   pEletronica:=true;
   if fdadosconfig_geral('VERSAO_GERENCIADOR_NFE')='a partir maio/2017' then
      begin
      Application.createform(TFrm_Nfe_Aguarde, Form_Nfe_Aguarde);
      form_nfe_aguarde.mNFEretorno.mentra_operacao:=Nfe_GerenciadorAtivo;
      form_nfe_aguarde.mNFEretorno.mentra_evento:=Nfe_GerenciadorAtivo;
      for x_nfe:=1 to 4 do
         begin
         if x_nfe=1 then
            mendip_Servidor_nfe_ativo:=mNFE_HostName
         else if x_nfe>2 then
            if flfilpad(0,'_principal','SERVNFE'+formatfloat('00',x_nfe)) then
               mendip_Servidor_nfe_ativo:=DM4.Tb_FilPad2FPVALOR.AsString
         else
            if flfilpad(0,'_principal','SERVNFE') then
               mendip_Servidor_nfe_ativo:=DM4.Tb_FilPad2FPVALOR.AsString;

         form_nfe_aguarde.Timer_processar.enabled:=true;
         Form_Nfe_Aguarde.ShowModal;
         if copy(form_nfe_aguarde.mNFEretorno.msaida_cstat_motivo,1,2)='OK' then
            begin
            mNFE_HostName:=mendip_Servidor_nfe_ativo;
            result:=true;
            break;
            end
         else
            begin
            result:=false;
            end;
         end;
      freeandnil(form_nfe_aguarde);

     if result=false then
        begin
        pmensagem:='Servidor de Nota Fiscal Eletronica Não Encontrado!';
        exit;
        end;

      end
   else
      begin

      Query_xml:=TSQLQuery.Create(nil);
      Query_xml.SQLConnection:=DM_MYSQL.SQLConnection_NFE;
      While true do
         begin
         Query_xml.Close;
         Query_xml.SQL.clear;
         Query_xml.SQL.Add('Select TIMESTAMPDIFF(MINUTE, cs_dathor_consulta, CURRENT_TIMESTAMP ) MINUTOS '
                          +' from intersys_cadserv '
                          +' where (cs_chave=:SERV01 '
                          +' or cs_chave=:SERV02 '
                          +' or cs_chave=:SERV03 )');
         Query_xml.ParamByName('SERV01').AsInteger:=Query_Cons.fieldbyName('PNF_SERVIDOR01').AsInteger;
         Query_xml.ParamByName('SERV02').AsInteger:=Query_Cons.fieldbyName('PNF_SERVIDOR02').AsInteger;
         Query_xml.ParamByName('SERV03').AsInteger:=Query_Cons.fieldbyName('PNF_SERVIDOR03').AsInteger;

         try
            query_xml.open;
            result:=true;
            break;
         except
            if not DM_MYSQL.fAbreNFE(0) then
               begin
               result:=false;
               FreeAndNil(Query_xml);
               freeandnil(query_cons);
               exit;
               end;
            end;
         end;
      freeandnil(query_cons);

      result:=false;
      pmensagem:=pmensagem+' servidor não encontrado!';
      While not Query_xml.Eof do
         begin
         if Query_xml.FieldByName('MINUTOS').AsInteger<2 then
            result:=true;
         Query_xml.Next;
         end;
      FreeAndNil(Query_xml);
      end;
   end;
end;

