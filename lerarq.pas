      pRet_Qtd:=0;
      exit;
      end
   else
      begin
      result:=0;
      pRet_Qtd:=0;
      While not DM1.Query2.Eof do
         begin
         if (DM1.Query2.FieldByName('FCB_POSCOD').AsFloat=0) or (DM1.Query2.FieldByName('FCB_TAMCOD').AsFloat=0) then
            begin
            DM1.Query2.Next;
            Continue;
