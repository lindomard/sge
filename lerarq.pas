   if trim(pGerar.pCampoMotivo)<>'' then
      begin
      Query_exe.ParamByName(pGerar.pCampoMotivo).AsString:=pGerar.pMotivo;
      end;

   try
      Query_exe.ExecSQL;
      fdm1StartCommit;
      break;
   except
      on e: Exception do
      begin
      ex_erroSql_Novo(Query_exe,35878,'lerarq:'+e.message ,pGerar.pTabela);
      mQtdTent:=mQtdTent+1;
//      ex_erroSql_Novo(Query_exe,17213,'lerarq:'+e.message ,pTabela);
//      fAjustarCamposTabela_old(pTabela);
      break;
      end;
      end;
   if mQtdTent>1 then
      break;
   end;

FreeAndNil(query_exe);
FreeAndNil(query_old);
result:=pGerar.pChaveOld;
end;

