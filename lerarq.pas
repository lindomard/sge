function fcrialgc(pfilial,ptipo,pcodemp: Integer; pcodpro,pnumero,pdatav: String): boolean;
var
query_lgc:tquery;
begin
if pfilial=0 then
   pfilial:=log_filial_padrao;
query_lgc:=TQuery.Create(nil);
query_lgc.DatabaseName:='SG_ASSOC';
Query_lgc.Close;
Query_lgc.SQL.Clear;
Query_lgc.SQL.Add('Insert into CADLGC ('
                  +' CLCODEMP, '
                  +' CLFILIAL, '
                  +' CLCODPRO, '
                  +' CLDTVCTO, '
                  +' CLNUMERO, '
                  +' CLQTD,'
                  +' CLQTD_DEP,'
                  +' CLQTD_PRAT,'
                  +' CLQTD_REP,'
                  +' CLQTDC,'
                  +' CLQTDR,'
                  +' CLQTDT,'
                  +' CLPRECO1, '
                  +' CLPRECO2, '
                  +' CLPRECO3, '
                  +' CLPRECOA1, '
                  +' CLPRECOA2, '
                  +' CLPRECOA3, '
                  +' CLPCUSTO, '
                  +' CLESTMAX, '
                  +' CLESTMIN, '
                  +' CLDTUATP1, '
                  +' CLDTUATP2, '
                  +' CLDTUATP3) values ('
                  +iif(pcodemp>0,intToStr(pcodemp),intToStr(codemp))+','
                  +':FILIAL, '
                  +trim(pcodpro)+','
                  +':DTVCTO, '
                  +':LOTE, '
                  +'0,'
                  +'0,'
                  +'0,'
                  +'0,0,0'
                  +',0' // preco 01
                  +',0' // preco 02
                  +',0' // preco 03
                  +',0' // preco 03
                  +',0' // preco 01a
                  +',0' // preco 02a
                  +',0' // preco 03a
                  +',0' // preco de custo
                  +',0' // estmax
                  +',0' // estmin
                  +',:DTUATP1 '
                  +',:DTUATP2 '
                  +',:DTUATP3'
                  +')');
query_lgc.ParamByName('FILIAL').AsInteger := pfilial;

if (trim(pdatav)<>'') and (trim(pdatav)<>'/  /') then
   begin
   if strtoDate(pdatav)<=pdatanula then
      Query_lgc.ParamByName('DTVCTO').AsString:=FormatDateTime(fdt, pdatanula)
   else
      Query_lgc.ParamByName('DTVCTO').AsString:=pdatav;
   end
else
   Query_lgc.ParamByName('DTVCTO').AsString:=FormatDateTime(fdt, pdatanula);
if trim(pnumero)='' then
   Query_lgc.ParamByName('LOTE').AsString     :=''
else
   Query_lgc.ParamByName('LOTE').AsString     :=pnumero;


Query_lgc.ParamByName('DTUATP1').AsString:=FormatDateTime(fdt, pdatanula);
Query_lgc.ParamByName('DTUATP2').AsString:=FormatDateTime(fdt, pdatanula);
Query_lgc.ParamByName('DTUATP3').AsString:=FormatDateTime(fdt, pdatanula);

Try
   Query_lgc.ExecSQL;
   fdm1StartCommit;
except
   ex_erroSql(01,4903,'lerarq','CADLGC');
   end;
FreeAndNil(query_lgc);
result:=True;
end;
