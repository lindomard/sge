   procedure fGerarCadUFSt;
   var
   query_uf_st: tQuery;

   begin
   query_uf_st:=tquery.Create(nil);
   query_uf_st.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
   query_uf_st.SQL.add('MERGE INTO CADUF_ST T1 USING ( '
                      +'SELECT PCODEMP AS UF_ST_CODEMP,PUF AS UF_ST_UF,PICMSC AS UF_ST_ICMSCRED_NOR '
                      +','+quotedstr('A')+' AS UF_ST_TABELA '
                      +',PICMSC_SN AS UF_ST_ICMSCRED_SN '
                      +',PICMSD  AS UF_ST_ICMSDEB_NOR '
                      +',PICMSD_SN  AS UF_ST_ICMSDEB_SN '
                      +',PIVAPOS AS UF_ST_IVA_POS_NOR '
                      +',PIVANEG AS UF_ST_IVA_NEG_NOR '
                      +',PIVAINA AS UF_ST_IVA_INA_NOR '
                      +',PIVAPOS_SN AS UF_ST_IVA_POS_SN '
                      +',PIVANEG_SN AS UF_ST_IVA_NEG_SN '
                      +',PIVAINA_SN AS UF_ST_IVA_INA_SN '
                      +'FROM CADUF '
                      +') SS ON (SS.UF_ST_CODEMP = T1.UF_ST_CODEMP AND SS.UF_ST_UF=T1.UF_ST_UF AND SS.UF_ST_TABELA=T1.UF_ST_TABELA) '
                      +'WHEN MATCHED THEN '
                      +'   UPDATE SET T1.UF_ST_ICMSCRED_SN = T1.UF_ST_ICMSCRED_SN '
                      +'   ,T1.UF_ST_ICMSDEB_NOR = T1.UF_ST_ICMSDEB_NOR '
                      +'   ,T1.UF_ST_ICMSDEB_SN = T1.UF_ST_ICMSDEB_SN '
                      +'   ,T1.UF_ST_IVA_POS_NOR = T1.UF_ST_ICMSDEB_SN '
                      +'   ,T1.UF_ST_IVA_NEG_NOR = T1.UF_ST_IVA_NEG_NOR '
                      +'   ,T1.UF_ST_IVA_INA_NOR = T1.UF_ST_IVA_INA_NOR '
                      +'   ,T1.UF_ST_IVA_POS_SN = T1.UF_ST_IVA_POS_SN '
                      +'   ,T1.UF_ST_IVA_NEG_SN = T1.UF_ST_IVA_NEG_SN '
                      +'   ,T1.UF_ST_IVA_INA_SN = T1.UF_ST_IVA_INA_SN '
                      +'WHEN NOT MATCHED THEN '
                      +'INSERT (T1.UF_ST_CODEMP, '
                      +'        T1.UF_ST_UF, '
                      +'        T1.UF_ST_TABELA '
                      +'       ,T1.UF_ST_ICMSCRED_SN '
                      +'       ,T1.UF_ST_ICMSDEB_NOR '
                      +'       ,T1.UF_ST_ICMSDEB_SN '
                      +'       ,T1.UF_ST_IVA_POS_NOR '
                      +'       ,T1.UF_ST_IVA_NEG_NOR '
                      +'       ,T1.UF_ST_IVA_INA_NOR '
                      +'       ,T1.UF_ST_IVA_POS_SN '
                      +'       ,T1.UF_ST_IVA_NEG_SN '
                      +'       ,T1.UF_ST_IVA_INA_SN )  VALUES ( '
                      +'        SS.UF_ST_CODEMP, '
                      +'        SS.UF_ST_UF, '
                      +'        SS.UF_ST_TABELA '
                      +'       ,SS.UF_ST_ICMSCRED_SN '
                      +'       ,SS.UF_ST_ICMSDEB_NOR '
                      +'       ,SS.UF_ST_ICMSDEB_SN '
                      +'       ,SS.UF_ST_IVA_POS_NOR '
                      +'       ,SS.UF_ST_IVA_NEG_NOR '
                      +'       ,SS.UF_ST_IVA_INA_NOR '
                      +'       ,SS.UF_ST_IVA_POS_SN '
                      +'       ,SS.UF_ST_IVA_NEG_SN '
                      +'       ,SS.UF_ST_IVA_INA_SN ) ');
    try
       query_uf_st.ExecSQL;
       fdm1StartCommit;
   except on e : exception do
      begin
      ex_erroSql_Novo(query_uf_st,20697,'SGE'+e.message,'CADUF_ST');
      end;
      end;
   query_uf_st.close;
   freeandnil(query_uf_st);





   end;


