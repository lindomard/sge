function fBaixarMercadorias(pBaixar: pBaixarLotes): boolean;
{
function fBaixarMercadorias(pCodEmp,pFilial,pItem,pDocOri,pCodUsr,pContEsp,pTipoProd: Integer; pChave,pChave_Ano,pQtd: Real; pcodPro,pEstNor,pEstReversado,pLote: String;
                             pDtVcto: TdateTime;pLoteRE,pObs: String): Boolean;
}
var
{
PDOCORI
00-Ped Vendas
01-Ped Compras
02-Ajustes
03-Balanço
04-ORDEM DE PRODUCAO cadop03
05-Zerar Estoque
06-sobras e devolucoes

}
query_movprod: tQuery;




begin
if ((pBaixar.pEstNor='N') and (pBaixar.pEstReservado='N')) or (pBaixar.pcodPro='') or (pBaixar.pQtd=0) then
   begin
   result:=true;
   exit;
   end;

pBaixar.pLote:=trim(pBaixar.pLote);
result:=true;
Query_MovProd:=tQuery.Create(nil);
Query_MovProd.DatabaseName:='SG_ASSOC';
Query_MovProd.SQL.add('insert into CADMOV_PROD ( '
+'       CMP_CODEMP '
+'      ,CMP_FILIAL '
+'      ,CMP_CHAVE '
+'      ,CMP_CHAVE_ANO '
+'      ,CMP_ITEM '
+'      ,CMP_DOCORI '
+'      ,CMP_CODPRO '
+'      ,CMP_DATHOR '
+'      ,CMP_QTD '
+'      ,CMP_ESTNOR '
+'      ,CMP_ESTRESERVADO '
+'      ,CMP_CODUSR '
+'      ,CMP_CONTESP '
+'      ,CMP_TIPOPROD '
+'      ,CMP_LOTE '
+'      ,CMP_DTFAB '
+'      ,CMP_DTVCTO '
+'      ,CMP_QTDDEC_QTD '
+'      ,CMP_ID_NEW '
+'      ,CMP_ID_DOC_NEW '
+'      ) values ( '
+'       :CODEMP '
+'      ,:FILIAL '
+'      ,:CHAVE '
+'      ,:CHAVE_ANO '
+'      ,:ITEM '
+'      ,:DOCORI '
+'      ,:CODPRO '
+'      ,SYSDATE '
+'      ,:QTD '
+'      ,:ESTNOR '
+'      ,:ESTRESERVADO '
+'      ,:CODUSR '
+'      ,:CONTESP '
+'      ,:TIPOPROD '
+'      ,:LOTE '
+'      ,:DTFAB '
+'      ,:DTVCTO '
+'      ,:CMP_QTDDEC_QTD '
+'      ,CADMOV_PROD_SEQ.NEXTVAL'
+'      ,:CMP_ID_DOC_NEW '

+')');
query_movprod.ParamByName('CODEMP').AsInteger     :=pBaixar.pCodEmp-iif(pBaixar.pCodemp>100,100,0) ;
query_movprod.ParamByName('FILIAL').AsInteger     :=pBaixar.pFilial;
