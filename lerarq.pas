      function fgravarAliquotas(pTipo_Reg: Integer;pTabIcm: String;
          pAliqTrib,pAliqRet,pAliqRed,pStIcmsCred,pStIcmsDeb,pStIVA_Ina,pStIVA_Pos,pStIVA_Neg,pISSQN
          ,pRepas,pAliqPis,pAliqCofins: Real;
          pCfo_Indus_Ret,pCfo_Indus_Trib,pCfo_Indus_Isento,pCfo_rev_Ret,pCfo_rev_Trib,pCfo_rev_Isento
          ,pCfo_SubEcf_Ret,pCfo_SubEcf_Trib,pCfo_SubEcf_Isento,pcfo_servico,pmodBcST: Integer;
          pal_stAliqRed,pal_inss,pal_inss_pred,pal_irrf,pal_irrf_pred,pStAliqRed,pP2CPUFDEST,pP2ICMSUFDEST,pP2ICMSINTER,pDeduzirIcmsBcPisCofins: Real
          ; prequer_pedori: integer;
          pAliqIbsUf,pAliqIbsMun,pAliqCbs: Real): Boolean;


      begin
      if not pAliquotas.Active then
         pAliquotas.Open;

      if pAliquotas.Locate('tipo_reg;al_tabicm',vararrayof([pTipo_Reg,pTabIcm]),[]) then
         pAliquotas.edit
      else
         begin
         pAliquotas.Append;
         pAliquotas.FieldByName('al_credsn').Value:=DM4.Tb_ParGer02PG2PACREDICMS.AsFloat;
         end;
      pAliquotas.fieldbyName('tipo_reg').AsInteger:=pTipo_Reg;
      pAliquotas.fieldbyName('al_tabicm').AsString:=pTabIcm;
      if pAliqTrib<>-1 then
         pAliquotas.fieldbyName('al_IcmsTrib').AsFloat:=iif(ptipo_reg=1,0,pAliqTrib);
      if pAliqRet<>-1 then
         pAliquotas.fieldbyName('al_icmsRet').AsFloat:=iif(ptipo_reg=1,0,pAliqRet);

      if pStAliqRed<>-1 then
         pAliquotas.fieldbyName('al_stAliqRed').AsFloat:=iif(ptipo_reg=1,0,pStAliqRed);

      if pAliqRed<>-1 then
         pAliquotas.fieldbyName('al_aliqredut').AsFloat:=iif(ptipo_reg=1,0,pAliqRed);

      if pStIcmsCred<>-1 then
         pAliquotas.fieldbyName('al_stIcmsCred').AsFloat:=iif(ptipo_reg=1,0,pStIcmsCred);
      if pStIcmsDeb<>-1 then
         pAliquotas.fieldbyName('al_stIcmsDeb').AsFloat:=iif(ptipo_reg=1,0,pStIcmsDeb);
      if pStIVA_Ina<>-1 then
         pAliquotas.fieldbyName('al_stIVA_Ina').AsFloat:=iif(ptipo_reg=1,0,pStIVA_Ina);
      if pStIVA_Pos<>-1 then
         pAliquotas.fieldbyName('al_stIVA_Pos').AsFloat:=iif(ptipo_reg=1,0,pStIVA_Pos);
      if pStIVA_Neg<>-1 then
         pAliquotas.fieldbyName('al_stIVA_Neg').AsFloat:=iif(ptipo_reg=1,0,pStIVA_Neg);
      if pISSQN<>-1 then
         pAliquotas.fieldbyName('al_issqn').AsFloat:=iif(ptipo_reg=1,0,pISSQN);
      if pRepas<>-1 then
         pAliquotas.fieldbyName('al_repasse').AsFloat:=iif(ptipo_reg=1,0,pRepas);
      if pAliqPis<>-1 then
