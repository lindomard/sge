function fRaterDescontosBematechCadp02(pChave,pOrdem,pCodEmp,pLotSeq,pDescRat,pTotBru: Real): Boolean;
var
query_Exe: TQuery;
begin
query_Exe:=TQuery.Create(nil);
Query_Exe.DatabaseName:='SG_ASSOC';
Query_Exe.SQL.Clear;
Query_Exe.SQL.Add('Update CADP02 ORIGEM set '
                 +'    P2DESCRAT=TRUNC( ((  (TRUNC((P2QTD*P2PRECO),2)-(P2TOTDES-P2DESCRAT)) *:DESCRAT)/100),2) '
                 +'    + nvl(  ( select TRUNC((  (SUM((TRUNC((P2QTD*P2PRECO),2)-(P2TOTDES-P2DESCRAT))) * :DESCRAT) / 100),2)'
                 +' -sum(TRUNC( (((TRUNC((P2QTD*P2PRECO),2)-(P2TOTDES-P2DESCRAT)) * :DESCRAT) / 100),2))  AS CT52I_TOTLIQ '
                 +' FROM CADP02 CONS where ORIGEM.P2ALIQ=CONS.P2ALIQ '
                 +' and CONS.P2CHAVE=ORIGEM.P2CHAVE '
                 +' AND CONS.P2LOTSEQ=ORIGEM.P2LOTSEQ '
                 +' AND CONS.P2CODEMP=ORIGEM.P2CODEMP '
                 +' AND CONS.P2ORDEM=ORIGEM.P2ORDEM '
                 +'    HAVING MIN(CONS.P2ITEM)=ORIGEM.P2ITEM) ,0) '
                 +'  + CASE WHEN P2ITEM=(SELECT ITEMMAX  FROM ( '
                 +'  select P2ITEM AS ITEMMAX from ( '
                 +' select P2ITEM,(TRUNC((P2QTD*P2PRECO),2)-(P2TOTDES-P2DESCRAT)) AS VALOR_TOT '
                 +' FROM CADP02 '
