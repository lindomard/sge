if trim(pDadosCadDar.pNosNum)<>'' then
   DM1.Tb_Dar.Sql.Add(' and CRNOSNUM like  '+QuotedStr(pDadosCadDar.pNosNum));

try
   DM1.Tb_Dar.Open;
//   ex_erroSql_Novo(DM1.Tb_Dar,2302,'SGE' ,'FPCPDUP');
except on e : exception do
