function flCadOrPed(pTipo: Integer; pCodigo: String): Boolean;
var
x: Integer;
begin
DM6.Tb_OrPed.Close;
DM6.Tb_OrPed.SQL.Clear;
DM6.Tb_OrPed.SQL.Add('Select * from CADORPED ');
if trim(pCodigo)<>'' then
   begin
   if ptipo=1 then
      DM6.Tb_OrPed.SQL.Add(' where COCODIGO=0'+trim(pcodigo))
   else
      DM6.Tb_OrPed.SQL.Add(' where CONOMORI like '+chr(39)+pCodigo+'%'+chr(39));
   end;
try
   DM6.Tb_OrPed.Open;
except
   DM6.Tb_OrPed.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
   end;
if DM6.Tb_OrPed.Eof then
   begin
   if trim(pCodigo)='' then
      begin
      DM1.Query1.Close;
      DM1.Query1.SQL.Clear;
      DM1.Query1.Params.CreateParam(ftString,'CODIGO',ptInput);
      DM1.Query1.Params.CreateParam(ftString,'NOMORI',ptInput);
      DM1.Query1.Params.CreateParam(ftString,'VINCULO',ptInput);
      DM1.Query1.Params .Clear;
      DM1.Query1.Sql.add('Insert into CADORPED (');
      DM1.Query1.Sql.add(' COCODIGO');
      DM1.Query1.Sql.add(',CONOMORI');
      DM1.Query1.Sql.add(',COVINCULO');
      DM1.Query1.Sql.add(' ) values (');
      DM1.Query1.Sql.add(' :CODIGO');
      DM1.Query1.Sql.add(',:NOMORI');
      DM1.Query1.Sql.add(',:VINCULO )');
      for x:=0 to 4 do
         begin
         DM1.Query1.ParamByName('CODIGO').AsFloat :=x;
         if x=0 then
            DM1.Query1.ParamByName('NOMORI').asString:='Vendedor'
         else if x=1 then
            DM1.Query1.ParamByName('NOMORI').asString:='Televendas'
         else if x=2 then
            DM1.Query1.ParamByName('NOMORI').asString:='Internet(Ped.Eletronico)'
         else if x=3 then
            DM1.Query1.ParamByName('NOMORI').asString:='Disp.Movel'
         else if x=4 then
            DM1.Query1.ParamByName('NOMORI').asString:='Outros';
         DM1.Query1.ParamByName('VINCULO').AsFloat:=x;
         try
            DM1.query1.ExecSQL;
            fdm1StartCommit;
         except
            end;
         end;
    DM6.Tb_OrPed.Close;
    DM6.Tb_OrPed.Open;
    if DM6.Tb_OrPed.Eof then
       result:=false
    else
       result:=true;
      end;
   end
else
   result:=true;


end;
