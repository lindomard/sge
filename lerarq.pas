function fTestarParCaixaCliDar(tb_dar: tquery; ptipo,pPagRec: Integer;pNomPar: String): Boolean;
{
pTipo=0 Caddar e Cadcli
      1 Cadcli
pPagRec=0 Recebimento
        1 Pagagamento
}
begin
if pPagRec=1 then
   begin
   flparldr(0,pNomPar);
   if ptipo=0 then
      begin
      if trim(Tb_dar.Fieldbyname('CRDESCMV').AsString)<>'' then
         mdesc_mov:=Tb_dar.Fieldbyname('CRDESCMV').AsString
      else if trim(DM1.Tb_CliCDESCMVD.AsString)<>'' then
         mdesc_mov:=DM1.Tb_CLICDESCMVD.AsString
      else
         mdesc_mov:=DM1.Par_LDRNOME.Value;
      if trim(Tb_dar.Fieldbyname('CRCODCC').AsString)<>'' then
         begin
         mcodccu:=Tb_dar.Fieldbyname('CRCODCC').AsString;
         mnomccu:=Tb_dar.Fieldbyname('CRNOMCC').AsString;
         mnatdc :=Tb_dar.Fieldbyname('CRNATDC').AsString;
         end
      else if Trim(DM1.Tb_CliCCODCCD.AsString)<>'' then
         begin
         mcodccu :=DM1.Tb_CliCCODCCD.AsString;
         mnomccu :=DM1.Tb_CliCNOMCCD.AsString;
         mnatdc  :=DM1.Tb_CliCNOMCCD.Value;
         if (trim(DM1.Tb_CliCNATDCD.AsString)='')  or
            (trim(DM1.Tb_CliCNATDCD.AsString)='_') then
             mnatdc :='D'
         else
            mnatdc :=DM1.Tb_CliCNATDCD.AsString;
         end
      else
         begin
         if flcadccu(1,0,DM1.Par_LDRCODCC.Value) then
            begin
            mnomccu:=DM1.Tb_CCUCCNOME.Value;
            mcodccu:=DM1.Tb_CCUCCCODCCU.Value;
            mnatdc:=DM1.Tb_CCUCCNAT.Value;
            end;
         end;
      if trim(Tb_dar.Fieldbyname('CRCODDEP').AsString)<>'' then
         begin
         mcoddep:=Tb_dar.Fieldbyname('CRCODDEP').AsString;
         mnomdep:=Tb_dar.Fieldbyname('CRNOMDEP').AsString;
         end
      else if (trim(DM1.Tb_CliCCODDEPD.AsString)<>'') and
         (trim(DM1.Tb_CliCCODDEPD.AsString)<>'_') then
         begin
         mcoddep:=DM1.Tb_CliCCODDEPD.Value;
         mnomdep:=DM1.Tb_CliCNOMDEPD.Value;
         end
      else
         begin
         if flcaddep_ldr(1,0,DM1.Par_LDRCODDEP.Value) then
            begin
            mnomdep:=DM1.Tb_Dep_LdrDNOME.Value;
            mcoddep:=DM1.Tb_Dep_LdrDCODDEP.Value;
            end;
         end;
      end
   else
      begin
      if trim(DM1.Tb_CliCDESCMVD.AsString)<>'' then
