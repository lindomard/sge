function fgravpar02(ptipo,pCodusr: Integer): Boolean;
var
mcod: Integer;
begin

if DM1.Qr_TID.Locate('TINOME','CADUSR',[]) then
   begin
   DM1.Query4.Close;
   DM1.Query4.SQL.Clear;
   DM1.Query4.SQL.Add('Select PA2CODEMP,PA2CODUSR,PA2CODIGO,PA2PDSN,PA2SENHA '
                     +' from CADPAR02 ');

   DM1.Query4.SQL.Add(' where PA2CODUSR=0'+IntToStr(pCodUsr));
   DM1.Query4.Open;


   for mcod:=0 to 99 do
      begin
      if not DM1.Query4.Locate('PA2CODUSR;PA2CODIGO',vararrayof([pcodusr,mcod]),[]) then
         begin
         DM1.Query1.Close;
         DM1.Query1.SQL.Clear;
         DM1.Query1.SQL.add('Insert into CADPAR02 ('
                           +' PA2CODEMP,PA2CODUSR,PA2CODIGO,PA2PDSN,PA2SENHA) Values ('
                           +IntToStr(iif(codemp>100,codemp-100,codemp))+','
                           +IntToStr(pcodusr)+','
                           +IntToStr(mcod)+','
                           +chr(39)+'S'+chr(39)+','
                           +':SENHA)');
         DM1.Query1.ParamByName('SENHA').AsString:=Crip('1',mcod);
         Try
            DM1.Query1.ExecSQL;
            fdm1StartCommit;
         except
            ex_erroSql(01,3331,'lerarq','CADPAR02');
            end;
         DM1.Query1.Close;
         end
      end;
   end
else
   begin
   flcademp(0,0,'');
   DM1.Query4.Close;
   DM1.Query4.SQL.Clear;
   DM1.Query4.SQL.Add('Select PA2CODEMP,PA2CODUSR,PA2CODIGO,PA2PDSN,PA2SENHA '
                     +' from CADPAR02 ');
   DM1.Query4.SQL.Add(' where PA2CODUSR=0'+IntToStr(pCodUsr)
                     +' order by PA2CODEMP,PA2CODUSR,PA2CODIGO');
   DM1.Query4.Open;

   While not DM2.Tb_Emp.Eof do
      begin
{
      if DM2.Tb_EmpCODEMP.Asfloat>99 then
         begin
         DM2.Tb_Emp.Next;
         Continue;
         end;
}
      for mcod:=0 to 99 do
         begin
         if not DM1.Query4.Locate('PA2CODEMP;PA2CODUSR;PA2CODIGO',
                                 vararrayof([DM2.Tb_EmpCODEMP.AsInteger,pcodusr,mcod]),[]) then
            begin
            DM1.Query1.Close;
            DM1.Query1.SQL.Clear;
            DM1.Query1.SQL.add('Insert into CADPAR02 ('
                              +' PA2CODEMP,PA2CODUSR,PA2CODIGO,PA2PDSN,PA2SENHA) Values ('
                              +DM2.Tb_EmpCODEMP.AsString+','
                              +IntToStr(pCodUsr)+','
                              +IntToStr(mcod)+','
                              +chr(39)+'S'+chr(39)+','
                              +':SENHA)');
            DM1.Query1.ParamByName('SENHA').AsString:=Crip('1',mcod);
            Try
               DM1.Query1.ExecSQL;
               fdm1StartCommit;
            except
               ex_erroSql(01,3361,'lerarq','CADPAR02');
               end;
            DM1.Query1.Close;
            end
         end;
      DM2.Tb_Emp.Next;
      end;
   end;
result:=True;
end;

