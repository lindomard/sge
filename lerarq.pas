                  +',EXT_ORIGEM'
                  +',EXT_TIPOMOV'
                  +') values ('
                  +' :EXT_CODEMP'
                  +',:EXT_FILIAL'
                  +',:EXT_CODPRO'
                  +','+FormatDateTime('YYYY',DATE)
                  +',EXTPRO'+FormatDateTime('YYYY',DATE)+'.NEXTVAL'
                  +',:EXT_QTD'
                  +',(SELECT SUM(CESALDO) FROM CADEST WHERE CECODEMP=:EXT_CODEMP and CECODPRO=:EXT_CODPRO and (CEFILIAL=:EXT_FILIAL or CEFILIAL is null))'
                  +',:EXT_DATHOR'
                  +',:EXT_NOME_COMP'
                  +',:EXT_CODUSR'
                  +',:EXT_ORIGEM'
                  +',:EXT_TIPOMOV'
                  +')');
