      DM1.Query1.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
      fmensagem('Salvo: sql01.txt ',0,['0'],0);
      exit;
      end;
   if DM1.Query1.Fields[0].AsInteger<=0 then
      begin
      result:=pdatanula;
      end
   else
      begin
      DM1.Query1.Close;
      DM1.Query1.SQL.Clear;
      DM1.Query1.SQL.add(' Select CED_ANO,CED_MES');
      for x:=1 to 31 do
         begin
         DM1.Query1.SQL.Add(', sum('+mCampoEstoque+FormatFloat('00',x)+') as '+mCampoEstoque+FormatFloat('00',x));
         end;
      DM1.Query1.SQL.add(' from CADEDIA ');
