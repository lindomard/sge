               begin
               if (DM1.Query2.FieldByName('FCB_POSVCT').AsFloat<>0) and
                  (DM1.Query2.FieldByName('FCB_TAMVCT').AsFloat<>0) then
                  begin
                  mcinst:=copy(pCodigo,DM1.Query2.fieldByName('FCB_POSVCT').AsInteger,02);
