        Reset(xArq);

        xlinha := 0;

        while not Eof(xArq) do begin
              readln(xArq,xArq1);
              Append(xArq);
              Writeln(xArq,FormatFloat('0000000000',DM1.Query1.FieldByName('CCODCLI').AsFloat));
              CloseFile(xArq);

              Result := xArq1;
              Exit;
        end;

     end;
  end;
