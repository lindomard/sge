function flcadcomd(ptipo,ppre: Integer; pvalor: String): Boolean;
{
ppre= precisao da informacao
0-Exata
1-Aproximado
}
begin
DM1.Tb_ComD.Close;
DM1.Tb_ComD.SQl.Clear;
DM1.Tb_ComD.SQL.Add('Select * from CADCOMD ');
if DM1.Qr_tid.locate('TINOME','CADCOMD',[]) then
   begin
   if PTIPO<1 then
      begin
      if (trim(pvalor)='') and (ppre=1) then
         DM1.Tb_ComD.Sql.add(' order by CDDESC')
      else
         DM1.Tb_ComD.Sql.add(' where CDDESC=0'+mudavp(ValReal(pvalor))
                           +' order by CDDESC');
      end
   else
      begin
      if (trim(pvalor)='') and (ppre=1) then
         DM1.Tb_ComD.Sql.add(' order by CDCOMIS')
      else
         DM1.Tb_ComD.Sql.add(' where CDCOMIS=0'+mudavp(ValReal(pvalor))
                           +' order by CDCOMIS');
      end;
   end
else
   begin
   DM1.Tb_ComD.SQL.Add(' where CDCODEMP=0'+IntTostr(codemp));
   if PTIPO<1 then
      begin
      if (trim(pvalor)='') and (ppre=1) then
         DM1.Tb_ComD.Sql.add(' order by CDCODEMP,CDDESC')
      else
         DM1.Tb_ComD.Sql.add(' and CDDESC=0'+mudavp(ValReal(pvalor))
                           +' order by CDCODEMP,CDDESC');
      end
   else if ptipo=1 then
      begin
      if (trim(pvalor)='') and (ppre=1) then
         DM1.Tb_ComD.Sql.add(' order by CDCODEMP,CDCOMIS')
      else
         DM1.Tb_ComD.Sql.add(' and CDCOMIS=0'+mudavp(ValReal(pvalor))
                           +' order by CDCODEMP,CDCOMIS');
      end;
   end;
DM1.Tb_ComD.Open;
if DM1.Tb_ComD.eof then
   Result:=False
else
   Result:=True;
end;


function flcadcomd2(pDesconto: Real): Boolean;
{
Busca o Desconto mais proximo
}
begin
DM1.Tb_ComD.Close;
DM1.Tb_ComD.SQl.Clear;
DM1.Tb_ComD.SQL.Add('Select * from CADCOMD where '
                   +iif(DM1.Qr_tid.locate('TINOME','CADCOMD',[]),'',' CDCODEMP=0'+IntTostr(codemp)+' and ')
                   +' CDDESC=(Select min(CDDESC) from cadcomd where '
                   +iif(DM1.Qr_tid.locate('TINOME','CADCOMD',[]),'',' CDCODEMP=0'+IntTostr(codemp)+' and ')
                   +' CDDESC>='+mudavp(FloatToStr(pDesconto))+')');
DM1.Tb_ComD.Open;
if DM1.Tb_ComD.IsEmpty then
   begin
   DM1.Tb_ComD.Close;
   DM1.Tb_ComD.SQl.Clear;
   DM1.Tb_ComD.SQL.Add('Select * from CADCOMD where '
                   +iif(DM1.Qr_tid.locate('TINOME','CADCOMD',[]),'',' CDCODEMP=0'+IntTostr(codemp)+' and ')
                   +' CDDESC=(Select max(CDDESC) from cadcomd where '
                   +iif(DM1.Qr_tid.locate('TINOME','CADCOMD',[]),'',' CDCODEMP=0'+IntTostr(codemp)+' and ')
                   +' CDDESC<='+mudavp(FloatToStr(pDesconto))+')');
   DM1.Tb_ComD.Open;
   end;
if DM1.Tb_ComD.eof then
   Result:=False
else
   Result:=True;
end;


