function fAchaCodigoProdutonoFornecedor(pCodfor: Real; pCodPFor,pCodpro: String): Real;
var
query_pfor: tQuery;
query_temp: tQuery;
begin

query_pfor:=tQuery.Create(nil);
query_pfor.DatabaseName:='SG_ASSOC';

pRet_DtVcto :=pDatanula;
pRet_Dtfab :=pDatanula;
pRet_Lote   :='';
pRet_Qtd    :=0;

query_pfor.Close;
query_pfor.SQL.Clear;
query_pfor.SQL.Add('Select PFCODPRO,PFFATOR,PFCODFOR,PFCODPFORN from CODPFOR where '

                   +' 1=1 '+ fFiltrosMultiEmpresa('PFCODEMP','CADPRO',codemp)
                 +' and PFCODFOR=0'+FloatToStr(pcodfor));
if trim(pCodPfor)<>'' then
   begin
   Query_pFor.sql.add(' and PFCODPFORN=:CODPFOR ');
   query_pfor.ParambyName('CODPFOR').AsString:=pCodPFor;
   end;

if trim(pCodPro)<>'' then
   begin
   Query_pFor.sql.add(' and PFCODPRO=:CODPRO ');
   query_pfor.ParambyName('CODPRO').AsString:=pCodPro;
   end;
try
   query_pfor.Open;
except
  query_pfor.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
   end;
if query_pfor.IsEmpty then
  begin
  query_pfor.Close;
  query_pfor.SQL.Clear;
  query_pfor.SQL.Add('Select PFCODPRO,PFFATOR,PFCODFOR,PFCODPFORN from CODPFOR where '
                    +' 1=1 '+ fFiltrosMultiEmpresa('FCODEMP','CADPRO',codemp)
                   +' and PFCODFOR=0'+FloatToStr(pcodfor));

  if trim(pCodPfor)<>'' then
     begin
     Query_pFor.sql.add(' and PFCODPFORN=:CODPFOR ');
     query_pfor.ParambyName('CODPFOR').AsString:=QuotedStr(pCodPFor);
     end;

  if trim(pCodPro)<>'' then
     begin
     Query_pFor.sql.add(' and PFCODPRO=:CODPRO ');
     query_pfor.ParambyName('CODPRO').AsString:=pCodPro;
     end;
  try
     query_pfor.Open;
  except
     query_pfor.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
     end;
  end;
if query_pfor.IsEmpty then
   result:=0
else
   begin
   result:=0;
   query_temp:=tQuery.Create(nil);
   query_temp.DatabaseName:='SG_ASSOC';

   While not Query_pfor.eof do
      begin
      query_temp.Close;
      query_temp.SQL.clear;
      query_temp.SQL.Add('Select PDCODPRO from CADPRO where PDCODPRO=:CODPRO '
                         +' and  1=1 '+ fFiltrosMultiEmpresa('FCODEMP','CADPRO',codemp));
      query_temp.ParamByName('CODPRO').value:=query_pfor.fieldbyName('PFCODPRO').AsFloat;
      query_temp.Open;
      if query_temp.IsEmpty then
         begin
         query_temp.Close;
         query_temp.SQL.clear;
         query_temp.SQL.Add('Delete from CODPFOR where '
                            +' 1=1 '+ fFiltrosMultiEmpresa('PFCODEMP','CADPRO',codemp)

                           +' and  PFCODFOR=:CODFOR '
                           +' and PFCODPRO=:CODPRO '
                           +' and PFCODPFORN=:CODPFORN ');
         query_temp.ParamByName('CODFOR').Value  :=query_pfor.fieldbyName('PFCODFOR').AsFloat;
         query_temp.ParamByName('CODPRO').Value  :=query_pfor.fieldbyName('PFCODPRO').AsFloat;
         query_temp.ParamByName('CODPFORN').Value:=query_pfor.fieldbyName('PFCODPFORN').AsString;
         try
            query_temp.ExecSQL;
            fdm1StartCommit;
         except
            end;
         query_pfor.next;
         end
      else
         begin
         if query_pfor.fieldbyName('PFFATOR').AsFloat=0 then
            pRet_Qtd:=1
         else
            pRet_Qtd:=query_pfor.fieldbyName('PFFATOR').AsFloat;
//            pRet_Qtd:=Arredonda( (1*query_pfor.fieldbyName('PFFATOR').AsFloat), DM1.Tb_PargerPCASQTD.AsInteger);
         result:=query_pfor.fieldbyName('PFCODPRO').AsFloat;
         freeandnil(query_temp);
         FreeandNil(query_pfor);
         exit;
         end;
      end;
   end;
FreeandNil(query_pfor);

end;

