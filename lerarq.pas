                            +'  where '+iif(la_empresas='','',la_empresas+' and ')
                            +' P2LOTSEQ=0'+query_pedidos_origem.fieldbyname('LOTSEQ').AsString
                            +' and P2CHAVE=0'+query_pedidos_origem.fieldbyname('CHAVE').AsString);
