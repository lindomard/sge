function fEncontradoNoFPCRDUPEmAbertoNoCaddar: boolean;

var
Query_temp: tQuery;
begin
Query_temp:=tQuery.create(nil);
query_temp.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_temp.sql.add('MERGE INTO CADDAR T1 USING ( '
                  +' SELECT FPNUMERO,FPDESD,FPCODCLI,CRCODCLI,FPVALOR,FPDTBX,FPDATPAG,FPDEVOL '
                  +',FPDESC,FPJUROS,FPCODUSR,FPCAIXA,FPNR '
                  +' ,FPLOTE '
                  +',CRNPED,CRVALOR,CRDTEMIS,FPDTEMIS '
                  +',FPDUP_CHAVE_ID,CRCHAVE_ID,CRCHAVE_ID_ANO ,CRCODEMP '
                  +' FROM FPCRDUP,CADDAR '
                  +' WHERE CRNUMERO=FPNUMERO AND CRDESD=FPDESD '
                  +' AND CRCODCLI=FPCODCLI '
                  +' AND CRSTATUS<2 '
                  +' ORDER BY FPNUMERO ) ss '
                  +' on (T1.CRCHAVE_ID=SS.CRCHAVE_ID AND t1.CRCHAVE_ID_ANO=SS.CRCHAVE_id_ano AND t1.CRCODEMP=SS.CRCODEMP) '
                  +'  WHEN MATCHED THEN '
                  +'  UPDATE SET T1.CRVALPAG=T1.CRVALPAG + SS.FPVALOR '
                  +'  ,T1.CRDTBX=SS.FPDTBX, T1.CRDTPAG=SS.FPDATPAG '
                  +'  ,T1.CRDESC=T1.CRDESC+SS.FPDESC '
                  +'  ,T1.CRJUROS=T1.CRJUROS+SS.FPJUROS '
                  +'  ,T1.CRLOTE=SS.FPLOTE '
                  +'  ,T1.CRNR=SS.FPNR '
                  +'  ,T1.CRDEVOL=T1.CRDEVOL + SS.FPDEVOL '
                  +'  ,T1.CRUSRBX=SS.FPCODUSR '
                  +'  ,T1.CRSTATUS=case when (T1.CRVALPAG + SS.FPVALOR  + T1.CRDESC+SS.FPDESC + T1.CRDEVOL + SS.FPDEVOL ) - (T1.CRJUROS+SS.FPJUROS) >=CRVALOR THEN 2 ELSE 1 END ');

try
   Query_temp.ExecSQL;
   fdm1StartCommit;
except on e : exception do
   begin
   ex_erroSql_Novo(query_temp,36575,'fpcrdup','fpcrdup');
   exit;
   end;
   end;

query_temp.close;
freeandnil(query_temp);





end;


