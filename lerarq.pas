function Valida_CheckList(pCheckList: TCheckListBox): TCheckListBox;
var
x: Integer;
begin
if pCheckList.ItemIndex=pCheckList.Count-1 then
   begin
   for x := 0 to pCheckList.Count -2 do
      begin
      if pCheckList.Checked[pCheckList.count-1] then
         pCheckList.Checked[x] := true
      else
         pCheckList.Checked[x]:=false;
      end;
   end
else
   begin
   pCheckList.Checked[pCheckList.Count-1]:=False;
   for x:=0 to pCheckList.Count-2 do
      begin
      pCheckList.Checked[pCheckList.Count-1]:=true;
      if not pCheckList.Checked[x] then
         begin
         pCheckList.Checked[pCheckList.Count-1]:=False;
         break;
         end;
      end;
   end;
result:=pCheckList;
end;

