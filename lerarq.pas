function VerIEst(IEst, UF: string): boolean;
var
  IRet, IOk, IErro, IPar    : Integer;

  LibHandle                 : THandle;
  ConsisteInscricaoEstadual : TConsisteInscricaoEstadual;
  xVerificaIsencao          : String;
begin
   xVerificaIsencao := '';
   if Trim(IEst) = '' then
      xVerificaIsencao := 'ISENTO';

   if xVerificaIsencao <> 'ISENTO' then begin

      {Retira máscara - pontos e barras se a digitação foi com máscara}
      while Pos('.', IEst) <> 0 do begin
         Delete(IEst, Pos('.', IEst), 1);
      end;
      while Pos('-', IEst) <> 0 do begin
         Delete(IEst, Pos('-', IEst), 1);
      end;
      while Pos('/', IEst) <> 0 do begin
         Delete(IEst, Pos('/', IEst), 1);
      end;
      while Pos(' ', IEst) <> 0 do begin
         Delete(IEst, Pos(' ', IEst), 1);
      end;

      try
        LibHandle :=  LoadLibrary (PChar (Trim ('DllInscE32.Dll')));
        if  LibHandle <=  HINSTANCE_ERROR then
            raise Exception.Create ('Dll não carregada');

        @ConsisteInscricaoEstadual  :=  GetProcAddress (LibHandle,
                                                        'ConsisteInscricaoEstadual');
        if  @ConsisteInscricaoEstadual  = nil then
            raise Exception.Create('Entrypoint Download não encontrado na Dll');



        IRet := ConsisteInscricaoEstadual (Iest,Uf);
        if Iret = 0 then
           Result := True
        else if Iret = 1 then
           Result := False;
      finally
        FreeLibrary (LibHandle);
      end;
   end;
end;
