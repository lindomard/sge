function fLiberadoVendaDoGrupoDeProdutosParaOCliente(pCodcli,pCodpro: Real; pMensagem: boolean; out pResposta: String): boolean;
var
query_cli_blq_gru: tQuery;
begin
query_cli_blq_gru:=tQuery.Create(nil);
query_cli_blq_gru.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_cli_blq_gru.sql.add('select CRAZAO,PDCODGRU,PDNOME from CADPRO,CADCLI_BLQ_GRU_PRO,CADCLI WHERE CBGP_CODCLI='+FloatToStr(pCodcli)
                         +' AND CCODCLI=CBGP_CODCLI '
                         +' and CBGP_CODGRU=PDCODGRU '
                         +' AND PDCODPRO='+FloatTostr(pcodpro));
try
   query_cli_blq_gru.Open;
   if not query_cli_blq_gru.IsEmpty then
      begin
      pResposta:='Produto: '+query_cli_blq_gru.fieldbyName('PDNOME').AsString+'/'+FloatToStr(pCodpro)
                 +' Grupo: '+query_cli_blq_gru.fieldbyName('PDCODGRU').AsString
                 +' Restrita a Venda para o cliente '+query_cli_blq_gru.fieldbyName('CRAZAO').AsString;
      if (pMensagem) then
         begin
         MessageDlg(pResposta,mtWarning,[mbOk],0);
         end;
      result:=false;
      end
   else
      result:=true;
except on e : exception do
   begin
   ex_erroSql_Novo(query_cli_blq_gru,40549,'SGE','CADCLI_BLQ_GRU_PRO');
   result:=false;
   end;
   end;


query_cli_blq_gru.close;
freeandnil(query_cli_blq_gru);



end;




