   function fincluirtarban_codccu(pcodemp: integer; pnatdc, pnome:string) : string;
   var
   mid: integer;
   query_ccu: tquery;
      procedure pfecharnafuncao;
      begin
      query_ccu.Close;
      freeandnil(query_ccu);
      end;
   begin
   Result:='000';
   query_ccu:=tquery.create(nil);
   query_ccu.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
   mid:=1;
   While true do
      begin
      query_ccu.close;
      query_ccu.sql.clear;
      query_ccu.sql.add('Select count(*) from cadccu where CCCODEMP=0'+Inttostr(pcodemp)
                       +' and CCCODCCU='+QuotedStr(formatfloat('000', mid)));
      try
         query_ccu.Open;
         if query_ccu.Fields[0].AsInteger<=0 then
            begin
            break;
            end
         else
            mid:=mid+1;
      except on e : exception do
         begin
         ex_erroSql_Novo(query_exe,19639,'SGE'+e.message,'CADccu');
         pfecharnafuncao;
         exit;
         end;
         end;
      end;
   query_ccu.close;
   query_ccu.sql.clear;
   Query_ccu.sql.add('Insert into CADCCU ('
                    +'CCCODEMP '
                    +',CCCODCCU '
                    +',CCNOME '
                    +',CCNAT '
                    +') values ('
                    +' :CCCODEMP '
                    +',:CCCODCCU '
                    +',:CCNOME '
                    +',:CCNAT '
                    +') ');

   query_ccu.ParamByName('CCCODEMP').AsInteger:=pcodemp;
   query_ccu.ParamByName('CCCODCCU').AsString :=formatfloat('000', mid);
   query_ccu.ParamByName('CCNOME').AsString   :=pnome;
   query_ccu.ParamByName('CCNAT').AsString    :=pnatdc;
   try
      query_ccu.ExecSQL;
   except on e : exception do
      begin
      ex_erroSql_Novo(query_exe,19675,'SGE'+e.message,'CADccu');
      pfecharnafuncao;
      exit;
      end;
      end;
   pfecharnafuncao;
   result:=formatfloat('000', mid);
   end;


