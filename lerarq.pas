function fDesmembrarTitulo(pChaveId_ano,pChaveid,pCodEmp: Integer; pValpago: Real; out pDesdNovo: String;
                           out pChaveId_ano_nova: integer; out pChaveId_nova: integer; pNumero: integer; pDesd: String): boolean;

var
query_dup: tQuery;
query_exe: tQuery;
query_temp: tQuery;
mcrnped: integer;
mCRLOTSEQ_CP: integer;
mCRDESD: String;
mCRORDEM: integer;
mCRCODEMP: integer;
mCondicao_old: string;
mChave_Old: integer;
mCRQTDPARC: Integer;
mObs_ant: String;
mObs_nov: String;

   procedure pfechartudo;
   begin
   query_dup.close;
   freeandnil(query_dup);

   query_exe.close;
   freeandnil(query_exe);

   query_temp.close;
   freeandnil(query_temp);

   end;

   function fBuscarNovoDesd(pNped,pCodEmp: integer; pDesd: String): String;
   var
   mdesd1: String;
   mdesd2: String;
   mSeq: Integer;
   x_desd: integer;
       function fExisteTitulo(pDesd: String): boolean;
       begin
       query_exe.close;
       query_exe.sql.clear;
       query_exe.sql.add('Select count(*) as qtd from caddar where '
                        +' CRNPED=:CRNPED '
                        +' and CRORDEM=:CRORDEM '
                        +' and CRLOTSEQ_CP=:CRLOTSEQ_CP '
                        +' and CRCODEMP=:CRCODEMP '
                        +' and CRDESD=:CRDESD ');
       query_exe.parambyname('CRNPED').AsInteger :=mcrnped;
       query_exe.parambyname('CRORDEM').AsInteger :=mcrORDEM;
       query_exe.parambyname('CRDESD').AsString :=pDESD;
       query_exe.parambyname('CRLOTSEQ_CP').AsInteger :=mCRLOTSEQ_CP;
       query_exe.parambyname('CRCODEMP').AsInteger :=mCRCODEMP;

       try
          query_exe.Open;
       except on e : exception do
          begin
          ex_erroSql_Novo(query_exe,33347,'func Erro:'+e.Message ,'CADEST');
          mdesd2:='';
          result:=false;
          exit;
          end;
          end;
       result:=query_exe.FieldByName('qtd').AsInteger>0;
       end;

   begin
   mDesd1:=pDesd[1];
   mDesd2:='';
   for x_desd:=48 to 90 do
      begin
      if (x_desd>57) and (x_desd<65) then
         continue;
      mdesd2:=char(x_desd);
      if not fexistetitulo(mdesd1+mdesd2) then
         break;
      mdesd2:='';
      end;
    if mdesd2='' then
       begin
       result:=pdesd;
       end
    else
       result:=mdesd1+mdesd2;
    end;

    function fGerarNovoCaddar: boolean;
    var
    mValues: string;
    mVirg: String;
    begin
    pChaveId_ano_nova:=valint(formatDateTime('yyyy', pdatasis));
    pChaveId_nova    :=fBuscareTestarID('CADDAR_'+formatfloat('9999', pChaveId_ano_nova));
    query_temp.Close;
    query_temp.sql.clear;
    query_temp.sql.add('select column_name,data_type from user_tab_columns '
                      +' where table_name='+QuotedStr('CADDAR')
                      +' and DATA_TYPE<>'+QuotedStr('LONG')+' and DATA_TYPE<>'+QuotedStr('LONG RAW')
                      +' and DATA_TYPE<>'+Quotedstr('CLOB')

                      );
    try
       query_temp.Open;
    except on e : exception do
       begin
       ex_erroSql_Novo(query_temp,36771,'func Erro:'+e.Message ,'CADDAR');
       result:=false;
       exit;
       end;
       end;
    mVirg:='';
    query_exe.Close;
    query_exe.sql.clear;
    query_exe.sql.add('Insert into CADDAR (');
    mValues :='select ';
    While not query_temp.Eof do
       begin
       query_exe.sql.add(mVirg+query_temp.FieldByName('COLUMN_NAME').AsString);
       if query_temp.FieldByName('COLUMN_NAME').AsString='CRCHAVE_ID' then
          mValues:=mValues+mVirg+Inttostr(pChaveId_nova)+' as CRCHAVE_ID '
       else if query_temp.FieldByName('COLUMN_NAME').AsString='CRID_NEW' then
          mValues:=mValues+mVirg+'CADDAR_SEQ.NEXTVAL as CRID_NEW '
       else if query_temp.FieldByName('COLUMN_NAME').AsString='CRCHAVE_ID_ANO' then
          mValues:=mValues+mVirg+Inttostr(pChaveId_ano_nova)+' as CRCHAVE_ANO '
       else if query_temp.FieldByName('COLUMN_NAME').AsString='CRQTDPARC' then
          mValues:=mValues+mVirg+Inttostr(mCRQTDPARC)+' as CRQTDPARC '
       else if query_temp.FieldByName('COLUMN_NAME').AsString='CRNUMPARC' then
          mValues:=mValues+mVirg+Inttostr(mCRQTDPARC)+' as CRNUMPARC '
       else if query_temp.FieldByName('COLUMN_NAME').AsString='CRDESD' then
          mValues:=mValues+mVirg+QuotedStr(pDesdNovo)+' as CRDESD '
       else if query_temp.FieldByName('COLUMN_NAME').AsString='CRVALOR' then
          mValues:=mValues+mVirg+mudaVP(floattostr(pValpago))+' as CRVALOR '
       else if query_temp.FieldByName('COLUMN_NAME').AsString='CRCODLDR' then
          mValues:=mValues+mVirg+'0 as CRCODLDR '
       else if query_temp.FieldByName('COLUMN_NAME').AsString='CROBS' then
          mValues:=mValues+mVirg+QuotedStr(mObs_nov)+' as CROBS '

       else
          begin
          mValues:=mValues+mVirg+query_temp.fieldbyname('COLUMN_NAME').AsString;
          end;
       mVirg:=',';
       query_temp.Next;
       end;
    mValues:=mValues+' from CADDAR where CRCHAVE_ID_ANO='+IntToStr(pChaveId_ano)
                    +' and CRCHAVE_ID='+inttostr(pChaveid)
                    +' and CRCODEMP='+inttostr(pCodEmp)
                    +' and CRNUMERO='+inttostr(pNumero)
                    +' and CRDESD='+QuotedStr(pDesd)

                    ;
    query_exe.Sql.add(') '+mValues);
    try
       query_exe.ExecSQL;
       fdm1StartCommit;

       result:=true;
    except on e : exception do
       begin
       ex_erroSql_Novo(query_temp,36825,'func Erro:'+e.Message ,'CADDAR');
       result:=false;
       exit;
       end;
       end;
    end;


       function fReordenarParcelas: boolean;
       begin
       query_exe.close;
       query_exe.sql.clear;
       query_exe.sql.add('Update CADDAR set CRQTDPARC=:CRQTDPARC,CRVALOR=CRVALOR -  '
                        +'  case when CRCHAVE_ID_ANO='+Inttostr(pChaveId_ano)
                        +' and CRCHAVE_ID='+inttostr(pChaveid)+' then :VALORPARC else 0 end '
                        +', CROBS=case when CRCHAVE_ID_ANO='+Inttostr(pChaveId_ano)

                        +' and CRCHAVE_ID='+inttostr(pChaveid)+' then :OBS else CROBS end '
                        +'  where '
                        +' CRNPED=:CRNPED '
                        +' and CRORDEM=:CRORDEM '
                        +' and CRLOTSEQ_CP=:CRLOTSEQ_CP '
                        +' and CRCODEMP=:CRCODEMP '
                        +' and not (CRCHAVE_ID_ANO=:CRCHAVE_ID_ANO AND CRCHAVE_ID=:CRCHAVE_ID) '
                        );
       query_exe.parambyname('CRNPED').AsInteger :=mcrnped;
       query_exe.parambyname('CRLOTSEQ_CP').AsInteger :=mCRLOTSEQ_CP;
       query_exe.parambyname('CRCODEMP').AsInteger :=mCRCODEMP;
       query_exe.parambyname('CRORDEM').AsInteger :=mCRORDEM;
       query_exe.parambyname('CRQTDPARC').AsInteger :=mCRQTDPARC;
       query_exe.parambyname('VALORPARC').AsFloat :=pValpago;
       query_exe.parambyname('OBS').AsString      :=mObs_ant;

       query_exe.parambyname('CRCHAVE_ID').AsInteger     :=pChaveId_nova;
       query_exe.parambyname('CRCHAVE_ID_ANO').AsInteger := pChaveId_ano_nova;
       try
          query_exe.ExecSQL;
          fdm1StartCommit;
       except on e : exception do
          begin
          ex_erroSql_Novo(query_exe,33347,'func Erro:'+e.Message ,'CADEST');
          result:=false;
          exit;
          end;
          end;
// corrigir percentual

       query_exe.close;
       query_exe.sql.clear;
