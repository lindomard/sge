function fExecutarComandoSQL(pSalvarSql: Boolean;pComando: String; out pmensagem: string; pLinha: Integer): Boolean;

var
query_exe: tQuery;

begin
query_exe:=tQuery.Create(nil);
query_exe.DatabaseName:='SG_ASSOC';
query_exe.Close;
query_exe.SQL.clear;

query_exe.sql.Add(pComando);
try
   query_exe.ExecSQL;
   fdm1StartCommit;
   result:=true;
except on e : exception do
   begin
   if pSalvarSql then
      begin
      ex_erroSql_Novo(Query_Exe,pLinha,'lerarq '+e.message ,'');
      end;
   pMensagem:=e.message;
   result:=false;
   end;
   end;
freeandnil(query_exe);


end;


