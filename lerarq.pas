function fBloqDesPedido(pTipo: Integer;pCodemp,pLotSeq,pChave: Real): Boolean;
{
pTipo=0 Desbloqueia
      1 Bloqueia
}
var
query_exe: TQuery;
begin
query_exe:=TQuery.Create(nil);
query_exe.DatabaseName:='SG_ASSOC';

query_exe.Close;
query_exe.SQL.Clear;
query_exe.SQL.Add('Update CADP01 set P1SITPED='+IntTostr(pTipo)
                  +',P1DATHOR_ULTEVE=:DATHOR_ULTEVE '
                     +',P1CODUSR_ULTEVE=:CODUSR_ULTEVE '
                     +',P1COMP_ULTEVE=:COMP_ULTEVE '
                  +' where (P1CODEMP=:CODEMP or P1CODEMP=:CODEMP_FILIAL) '
                  +' and P1LOTSEQ=0'+FloatToStr(pLotseq)
                  +' and P1CHAVE=0'+FloatToStr(pChave));
query_exe.ParamByName('CODEMP').AsFloat:=pcodemp;
if pcodemp>100 then
   query_exe.ParamByName('CODEMP_FILIAL').AsFloat:=pcodemp-100
else
   query_exe.ParamByName('CODEMP_FILIAL').AsFloat:=pcodemp+100;


query_exe.ParamByName('DATHOR_ULTEVE').AsDateTime:=now;
query_exe.ParamByName('CODUSR_ULTEVE').AsInteger:=codusr;
query_exe.ParamByName('COMP_ULTEVE').AsString:=copy(NomeComputador,1,30);

try
   query_exe.ExecSQL;
   fdm1StartCommit;
except
//   ex_erroSql_Novo(query_exe,10484,'func2','CADP01');
   end;
FreeAndNil(query_exe);
result:=true;
end;

function fPed01ExcluiPagamento(pTipo: Integer;pTabela: TDataSet): Boolean;
var
mtotdup,mtotfp: Real;
begin
mtotdup:=0;
mtotfp :=0;
result:=True;
pTabela.First;
While not pTabela.Eof do
   begin
   DM1.Query7.Close;
   DM1.Query7.SQL.clear;
   DM1.Query7.SQL.Add('Select CRSTATUS,CRNUMERO,CRLOTE,CRCODCLI,CRCODEMP,CRDUP,CRVALOR,CRVALPAG,'
                     +' CRLOTSEQ_LB,CRNUMERO,CRDESD,CRDUP,CRDTEMIS,CRNPED '
                     +'  from CADDAR where '
                  +iif(DM1.Qr_TID.Locate('TINOME','CADDAR',[]),'',' CRCODEMP=0'+pTabela.FieldbyName('P1CODEMP').AsString+' and ')
                  +' CRLOTSEQ_CP=0'+pTabela.FieldbyName('P1LOTSEQ').AsString
                  +' and CRNPED=0'+pTabela.FieldbyName('P1CHAVE').AsString
                  +' and CRORDEM=0'+pTabela.FieldbyName('P1ORDEM').AsString);
   DM1.Query7.Open;
   if DM1.Query7.Eof then
      begin
      pTabela.Next;
      Continue;
      end;
   While not DM1.Query7.Eof do
      begin
      if (DM1.Query7.FieldByName('CRSTATUS').AsFloat<>1)
          and (DM1.Query7.FieldByName('CRSTATUS').AsFloat<>2) then
         begin
         DM1.Query7.Next;
         Continue;
         end;
      mnomccu:=pldr_nomccu;
      mnatdc :=pldr_natdc;
      mcodccu:=pldr_codccu;
      mcoddep:=pldr_coddep;
      mnomdep:=pldr_nomdep;
      if not DM1.Tb_Cli.Active then
         flcadcli(1,0,DM1.Query7.FieldByName('CRCODCLI').AsString)
      else if DM1.Query7.FieldByName('CRCODCLI').Value=DM1.Tb_CliCCODCLI.AsFloat then
         flcadcli(1,0,DM1.Query7.FieldByName('CRCODCLI').AsString);
      if DM1.Query7.FieldByName('CRDUP').AsFloat=5 then
         begin
         if DM1.Query7.FieldByName('CRNPED').AsFloat>0 then
            fTestarParCaixaCliDar(DM1.Tb_dar,1,1,'CADDARD')
         else
            fTestarParCaixaCliDar(DM1.Tb_dar,1,1,'CADDARN');
         end;
      mtotdup:=mtotdup+DM1.Query7.FieldByName('CRVALPAG').Asfloat;
      DM1.Query4.Close;
      DM1.Query4.SQL.Clear;
      DM1.Query4.SQL.Add('Select * from FPCRDUP where '
                  +iif(DM1.Qr_TID.Locate('TINOME','CADDAR',[]),'',' FPCODEMP=0'+DM1.Query7.FieldByName('CRCODEMP').AsString+' and ')
                     +' FPLOTSEQ=0'+DM1.Query7.FieldByName('CRLOTSEQ_LB').AsString
                     +' and FPNUMERO=0'+DM1.Query7.FieldByName('CRNUMERO').AsString
                     +' and FPDESD='+chr(39)+Trim(DM1.Query7.FieldByName('CRDESD').AsString)+chr(39)
                     +' and FPTIPO=0'+DM1.Query7.FieldByName('CRDUP').AsString
                     +' and FPDTEMIS='+chr(39)+FormatDatetime(fdt, DM1.Query7.FieldByName('CRDTEMIS').Value)+chr(39));
      DM1.Query4.Open;
      if DM1.Query4.Eof then
         begin
         DM1.Query7.Next;
         Continue;
         end;
      While not DM1.Query4.Eof do
         begin
         mtotfp:=mtotfp+DM1.Query4.fieldbyName('FPVALOR').AsFloat;
         DM1.Query4.Next;
         end;
      mtotfp :=Arredonda(mtotfp,2);
      mtotdup:=Arredonda(mtotdup,2);
      if mtotdup<>mtotfp then
         begin
         DM1.Query7.Next;
         Continue;
         end;
      DM1.Query4.First;
      While not DM1.Query4.Eof do
         begin
         DM1.Query5.Close;
         DM1.Query5.SQL.Clear;
         DM1.Query5.SQL.Add('Select * From FPCR where '
              +iif(DM1.Qr_TID.Locate('TINOME','CADDAR',[]),'',' FPCODEMP=0'+DM1.Query4.fieldbyName('FPCODEMP').AsString+' and ')
                +' FPLOTSEQ=0'+DM1.Query4.FieldbyName('FPLOTSEQ').AsString
                +' and   FPLOTE=0'+DM1.Query4.FieldbyName('FPLOTE').AsString);
         DM1.Query5.Open;
         DM1.Query3.Close;
         DM1.Query3.SQL.Clear;
         DM1.Query3.SQL.add('Select FPCODEMP,FPNUMERO,FPBANCO,FPSERIE,FPCC,FPLOTE,FPVALOR from  FPCR where '
                    +iif(DM1.Qr_TID.Locate('TINOME','CADDAR',[]),'',' FPCODEMP=0'+DM1.Query4.fieldbyName('FPCODEMP').AsString+' and ')
                    +' FPLOTSEQ=0'+DM1.Query4.FieldbyName('FPLOTSEQ').AsString
                    +' and FPLOTE=0'+DM1.Query4.Fieldbyname('FPLOTE').AsString
                    +' and FPNUMERO>0 and FPBANCO>0');
         DM1.Query3.Open;
         if not DM1.Query5.Eof then
            begin
            DM1.Query1.Close;
            DM1.Query1.SQL.clear;
            if not DM1.Qr_TID.Locate('TINOME','CADCHQ',[]) then
               DM1.Query1.Params.CreateParam(ftString,'CHCODEMP',ptInput);
               DM1.Query1.Params.CreateParam(ftString,'CHLOTE',ptInput);
               DM1.Query1.SQL.add('Delete from CADCHQ where '+
                        iif(DM1.Qr_TID.Locate('TINOME','CADCHQ',[]),'',' CHCODEMP=:CHCODEMP and ')
                        +' CHLOTE  =:CHLOTE ');
            While not DM1.Query3.Eof do
               begin
               if not DM1.Qr_TID.Locate('TINOME','CADCHQ',[]) then
                  DM1.Query1.ParamByName('CHCODEMP').AsFloat:=dm1.Query3.fieldbyName('FPCODEMP').AsFloat;
               DM1.Query1.ParamByName('CHLOTE').AsFloat  :=dm1.Query3.fieldbyName('FPLOTE').AsFloat;
               try
                  DM1.Query1.ExecSQL;
                  fdm1StartCommit;
               except
                  end;
               DM1.Query3.Next;
               end;
            end;
         DM1.Query1.Close;
         DM1.Query1.SQL.Clear;
         DM1.Query1.SQL.Add('Delete From FPCRDUP where '
                         +iif(DM1.Qr_TID.Locate('TINOME','CADDAR',[]),'',' FPCODEMP=0'+DM1.Query4.Fieldbyname('FPCODEMP').AsString+' and ')
                        +' FPLOTSEQ=0'+DM1.Query4.FieldbyName('FPLOTSEQ').AsString
                        +' and FPLOTE=0'+DM1.Query4.FieldbyName('FPLOTE').AsString);
         try
            DM1.Query1.ExecSQL;
            fdm1StartCommit;
         except
            end;
         DM1.Query5.First;
         While not DM1.Query5.eof do
            begin
            DM1.Query1.Close;
            DM1.Query1.SQL.Clear;
            DM1.Query1.SQL.Add('Delete From CADLDR where '
                              +iif(DM1.Qr_TID.Locate('TINOME','CADLDR',[]),'',' CODEMP=0'+DM1.Query4.fieldbyName('FPCODEMP').AsString+' and ')
                             +' LOTSEQ=0'+DM1.Query5.fieldByName('FPLOTSEQ_FC').AsString
                             +' and CODLDR=0'+DM1.Query5.fieldByName('FPCODLDR').AsString);
            try
               DM1.Query1.ExecSQL;
               fdm1startCommit;
            except
               end;
            DM1.Query5.Next;
            end;

         if not flcaddar(8,DM1.Query4.fieldByName('FPDUP_CODEMP').AsInteger,0
               ,DM1.Query4.fieldByName('FPCODECF').AsInteger,0,
               DM1.Query4.fieldByName('FPNUMERO').AsString,DM1.Query4.fieldByName('FPDESD').AsString,DM1.Query4.fieldByName('FPTIPO').AsString,DM1.Query4.fieldByName('FPDTEMIS').AsDateTime,'')  then
            begin
            DM1.Query4.Next;
            Continue;
            end
         else
            begin
            DM1.Tb_Dar.Edit;
            DM1.Tb_DarCRCODCTA.Value   :=codcai;
            DM1.Tb_DarCRNOMCTA.Value   :=pldr_nombco;
            DM1.Tb_DarCRNOMCC.Value    :=mnomccu;
            DM1.Tb_DarCRCODCC.Value    :=mcodccu;
            DM1.Tb_DarCRNATDC.Value    :=mnatdc;
            DM1.Tb_DarCRNOMDEP.Value   :=mnomdep;
            DM1.Tb_DarCRCODDEP.Value   :=mcoddep;
            DM1.Tb_DarCRVALPAG.Value:=DM1.Tb_DarCRVALPAG.Value-DM1.Query4.fieldByName('FPVALOR').AsFloat;
            DM1.Tb_DarCRDESC.Value  :=DM1.Tb_DarCRDESC.Value  -DM1.Query4.fieldByName('FPDESC').AsFloat;
            DM1.Tb_DarCRJUROS.Value :=DM1.Tb_DarCRJUROS.Value -DM1.Query4.fieldByName('FPJUROS').AsFloat;
            if DM1.Tb_DarCRVALPAG.Value<0 then
               DM1.Tb_DarCRVALPAG.Value:=0;
            if DM1.Tb_DarCRDESC.Value<0 then
               DM1.Tb_DarCRDESC.Value:=0;
            if DM1.Tb_DarCRJUROS.Value<0 then
               DM1.Tb_DarCRJUROS.Value:=0;
            if DM1.Tb_DarCRVALPAG.Value>0 then
               DM1.Tb_DarCRSTATUS.Value:=1
            else
               begin
               DM1.Tb_DarCRSTATUS.Value:=0;
               DM1.Tb_DarCRCODLDR.Value:=0;
               DM1.Tb_DarCRLOTSEQ_FC.Value:=0;
               DM1.Tb_DarCRDTPAG.Value :=pdatanula;
               DM1.Tb_DarCRDTBX.Value  :=pdatanula;
              end;
           if not DM1.Tb_LDR.Active then
              flcadldr(0,0,0,'9999999');
           DM1.Tb_LDR.Append;
           DM1.Tb_LDRCODEMP.Value :=DM1.Tb_DarCRCODEMP.Value;
           DM1.Tb_LDRDATADP.Value :=DM1.Tb_DarCRDTVCTO.Value;
           DM1.Tb_LDRDATAREF.Value:=DM1.Tb_DarCRDTEMIS.Value;
           DM1.Tb_LDRVALORP.Value :=DM1.Tb_DarCRVALOR.Value;
           DM1.Tb_LDRNUMDOC.Value :=DM1.Tb_PargerPCRDOCSIG.Value+FormatFloat('000000',iif(DM1.Tb_PargerPCRDOC.Value=1,DM1.Tb_DarCRNPED.Value,DM1.Tb_DarCRNUMERO.Value))+'-'+DM1.Tb_DarCRDESD.Value;
           DM1.Tb_LDRSTATUS.Value:=0;
           DM1.Tb_LDRORIGEM.Value:=03;
           DM1.Tb_LDRTIPO.Value  :='CL';
           DM1.Tb_LDRCODIGO.Value:=DM1.Tb_DarCRCODCLI.Value;
            if DM1.Tb_DarCRNPED.Value>0 then
               DM1.Tb_LDRLOCDEP.Value:=3
            else
               DM1.Tb_LDRLOCDEP.Value:=4;
            DM1.Tb_LDRDESCMV.Value:=mdesc_mov;
            DM1.Tb_LDRCODCC.Value :=mcodccu;
            DM1.Tb_LDRCODDEP.Value:=mcoddep;
            DM1.Tb_LDRNOMBCO.Value:=pldr_nombco;
            DM1.Tb_LDRNOMDEP.Value:=mnomdep;
            DM1.Tb_LDRNOMCCU.Value:=mnomccu;
            DM1.Tb_LDRNATDC.Value :=mnatdc;
            DM1.Tb_LDRLOTMOV.Value:=lotmov;
            if Trim(DM1.Tb_LDRNUMDOC.AsString)<>'' then
               DM1.Tb_LDRDESCMV.Value:=trim(DM1.Tb_LDRDESCMV.Value)+' No.'+DM1.Tb_LDRNUMDOC.Value
            else
               DM1.Tb_LDRDESCMV.Value:=trim(DM1.Tb_LDRDESCMV.Value);
            DM1.Tb_LDRDESCMV.Value:=Trim(DM1.Tb_LDRDESCMV.Value)+' '+DM1.Tb_LDRNOME.Value;
            if length(DM1.Tb_LDRDESCMV.Value)>50 then
               DM1.Tb_LDRDESCMV.Value:=copy(DM1.Tb_LDRDESCMV.Value,1,50);
            DM1.Tb_LDRDESCMV.Value  :=DM1.Tb_LDRDESCMV.Value;
            DM1.Tb_LDR.Post;
            DM1.Tb_DarCRCODLDR.Value:=DM1.Tb_LDRCODLDR.Value;
            DM1.Tb_Dar.Post;
            end;
         DM1.Query4.Next;
         end;
      DM1.Query7.Next;
      end;
   pTabela.Next;
   end;
end;

function fAjustaAcerto(pLote: Real;pTipoMov: Integer): Boolean;
var
mQtdEnv:Real;
mVlrenv:Real;
mQtdDev:Real;
mVlrDev:Real;
mQtdFat:Real;
mVlrFat:Real;
mOrdemAr2:Integer;
mtipoMov: Integer;
mCodcli: Real;
mDataAc: TDatetime;
begin
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.add('Delete from CADACRE01 where '
                  +iif(DM1.Qr_TID.Locate('TINOME','CADPED',[]),'',' AR1CODEMP=0'+InttoStr(codemp)+' and ')
                  +' AR1CHAVE=0'+FloatToStr(pLote));
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   ex_erroSql(01,798,'func2','CADACRE01');
   end;

DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.add('Delete from CADACRE02 where '
                  +iif(DM1.Qr_TID.Locate('TINOME','CADPED',[]),'',' AR2CODEMP=0'+InttoStr(codemp)+' and ')
                  +' AR2CHAVE=0'+FloatToStr(pLote));
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   ex_erroSql(01,17379,'func2','CADACRE02');
   end;


mQtdEnv  :=0;
mVlrenv  :=0;
mQtdDev  :=0;
mVlrDev  :=0;
mQtdFat  :=0;
mVlrFat  :=0;
mOrdemAr2:=0;
if plote<>0 then
   begin
   DM1.Query3.Close;
   DM1.Query3.Sql.Clear;
   DM1.Query3.SQL.Add('select max(P1DATAP) as P1DATAP,max(P1CODCLI) as P1CODCLI,'
                     +' max(P1TIPO) as P1TIPO, sum(CASE WHEN P2QTD_ATEN IS NULL THEN P2QTD WHEN P2QTD_ATEN=0 THEN P2QTD ELSE P2QTD_ATEN END) as QTD,'
                     +' sum(P2TOTLIQ) AS TOTAL,P1CODEMP,P1LOTSEQ,P1CHAVE,P1ORDEM '
                     +' from CADP01,CADP02 where '
                     +iif(DM1.Qr_TID.Locate('TINOME','CADPED',[]),'',
                     ' P1CODEMP=0'+IntToStr(codemp)+' and ' )
                     +' P1LTACERTO=0'+FloattoStr(pLote)
                     +iif(DM1.Qr_TID.Locate('TINOME','CADPED',[]),'',
                     ' and P2CODEMP=P1CODEMP')
                     +' and P2LOTSEQ=P1LOTSEQ '
                     +' and P2CHAVE=P1CHAVE '
                     +' and P2ORDEM=P1ORDEM '
                     +' group by P1CODEMP,P1LOTSEQ,P1CHAVE,P1ORDEM ');
   DM1.Query3.Open;
   mOrdemAr2:=0;
   mcodcli:=0;
   While not DM1.Query3.Eof do
      begin
      DM1.Query1.Close;
      DM1.Query1.SQL.clear;
      DM1.Query1.SQL.add('Select  TPENTRADA_NORMAL, '
                        +'        TPENTRADA_CONSIGNADO, '
                        +'        TPENTRADA_REM_VENDA, '
                        +'        TPENTRADA_EST_TERC '
                        +'        ,TPSAIDA_NORMAL '
                        +'        ,TPSAIDA_CONSIGNADO '
                        +'        ,TPSAIDA_REM_VENDA '
                        +'        ,TPSAIDA_EST_TERC from CADTIPPED '
                        +' where TPCODIGO=0'+DM1.Query3.FieldByName('P1TIPO').AsString);
      DM1.Query1.Open;
      mtipoMov:=0;
      if not DM1.Query1.IsEmpty then
         begin
         if ( (DM1.Query1.FieldbyName('TPSAIDA_CONSIGNADO').AsInteger=1) and
              (DM1.Query1.FieldbyName('TPENTRADA_NORMAL').AsInteger=0) )   or
           ( (DM1.Query1.FieldbyName('TPSAIDA_REM_VENDA').AsInteger=1) and
              (DM1.Query1.FieldbyName('TPENTRADA_NORMAL').AsInteger=0) )   then
            mtipoMov:=2
         else if (DM1.Query1.FieldbyName('TPENTRADA_NORMAL').AsInteger=1) or
             ( (DM1.Query1.FieldbyName('TPSAIDA_CONSIGNADO').AsInteger=1) and
              (DM1.Query1.FieldbyName('TPENTRADA_NORMAL').AsInteger=1) )   or
           ( (DM1.Query1.FieldbyName('TPSAIDA_REM_VENDA').AsInteger=1) and
              (DM1.Query1.FieldbyName('TPENTRADA_NORMAL').AsInteger=1) )   then
            mtipoMov:=1;
         end;
      mOrdemAr2:=mOrdemAr2+1;
      DM1.Query2.Close;
      DM1.Query2.SQL.Clear;
      DM1.Query2.Sql.Add('Insert into CADACRE02 ('
                        +'AR2LOTSEQ_AR '
                        +',AR2CODEMP '
                        +',AR2CHAVE '
                        +',AR2SEQ '
                        +',AR2TIPOMOV '
                        +',AR2LOTSEQ '
                        +',AR2CHAVEPED '
                        +',AR2ORDEM '
                        +',AR2DATA '
                        +',AR2QTD '
                        +',AR2VLR '
                        +') values ('
                        +'0'+FloatToStr(ls_numped)
                        +','+InttoStr(Codemp)
                        +','+FloatToStr(pLote)
                        +','+InttoStr(mOrdemAr2)
                        +','+IntToStr(mTipoMov)
                        +',0'+DM1.Query3.FieldbyName('P1LOTSEQ').AsString
                        +',0'+DM1.Query3.FieldbyName('P1CHAVE').AsString
                        +',0'+DM1.Query3.FieldbyName('P1ORDEM').AsString
                        +','+chr(39)+FormatDateTime(fdt, DM1.Query3.FieldbyName('P1DATAP').asDateTime)+chr(39)
                        +','+mudavp(DM1.Query3.FieldbyName('QTD').asString)
                        +','+mudavp(DM1.Query3.FieldbyName('TOTAL').asString)
                        +')');
      try
         DM1.Query2.ExecSQL;
         fdm1StartCommit;
      except
   //      ex_erroSql(02,798,'Frm_RDev','CADP02');
         end;
      IF mTipoMov=1 then
         begin
         mVlrDev:=mVlrDev+DM1.Query3.FieldbyName('TOTAL').AsFloat;
         mQtdDev:=mQtdDev+DM1.Query3.FieldbyName('QTD').AsFloat;
         end
      else if mtipoMov=2 then
         begin
         mDataAc:=DM1.Query3.FieldbyName('P1DATAP').AsDateTime;
         mcodcli:=DM1.Query3.FieldbyName('P1CODCLI').AsFloat;
         mVlrFat:=mVlrFat+DM1.Query3.FieldbyName('TOTAL').AsFloat;
         mQtdFat:=mQtdFat+DM1.Query3.FieldbyName('QTD').AsFloat;
         end
      else
         begin
         mVlrenv:=mVlrEnv+DM1.Query3.FieldbyName('TOTAL').AsFloat;
         mQtdEnv:=mQtdEnv+DM1.Query3.FieldbyName('QTD').AsFloat;
         end;
      DM1.Query3.Next;
      end;
   end;
if (mVlrenv+mVlrDev+mVlrFat+mQtdEnv+mQtdDev+mQtdFat)<>0 then
   begin
   DM1.Query2.Close;
   DM1.Query2.SQL.Clear;
   DM1.Query2.Sql.Add('Insert into CADACRE01 ('
                   +' AR1CODEMP '
                   +',AR1LOTSEQ_AR '
                   +',AR1CHAVE '
                   +',AR1TIPO '
                   +',AR1DATA '
                   +',AR1QTDENV '
                   +',AR1VLRENV '
                   +',AR1QTDDEV '
                   +',AR1VLRDEV '
                   +',AR1QTDFAT '
                   +',AR1VLRFAT '
                   +',AR1CODCLI '
                   +',AR1DATHOR_EVE'
                   +') values ('
                   +IntToStr(codemp)
                   +','+FloatToStr(ls_numped)
                   +','+FloatToStr(pLote)
                   +','+IntToStr(pTipoMov)
                   +','+chr(39)+FormatDateTime(fdt, mDataAc)+chr(39)
                   +','+mudaVP(FloatToStr(mQtdEnv))
                   +','+mudaVP(FloatToStr(mVlrenv))
                   +','+mudaVP(FloatToStr(mQtdDev))
                   +','+mudaVP(FloatToStr(mVlrDev))
                   +','+mudaVP(FloatToStr(mQtdfat))
                   +','+mudaVP(FloatToStr(mvlrFat))
                   +','+FloatToSTr(mcodcli)
                   +',:AR1DATHOR_EVE'
                   +')');
   DM1.Query2.ParambyName('AR1DATHOR_EVE').AsDateTime:=Now;
   try
      DM1.Query2.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql(02,874,'Frm_RDev','CADACRE01');
      end;
   end;
result:=true;
end;
function fExcluirPedido(pTipo: Integer;pMotivo:String; PTabela: TDataSet): Boolean;
// 8 inutilizado 9-Excluido
begin
PTabela.First;
While not PTabela.Eof do
   begin
   DM1.Query1.Close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.Params.CreateParam(ftString,'MOTIVO',ptInput);
   DM1.Query1.Sql.add('Update CADP01 set P1STATUS= 9'
                     +',P1NFCE_SITUACAO=case when P1NFCE_NUMERO>0 then 9 else P1NFCE_SITUACAO end '
                      +' ,P1USRMOD=0'+IntTostr(codusr)+','
                      +' P1DTMOD='+chr(39)+FormatDatetime(fdt,pdatasis)+chr(39)+','
                      +' P1HRMOD='+chr(39)+FormatDateTime(fhr, time)+chr(39)
                      +' ,P1MOTIVO=:MOTIVO'
                      +'  where P1CODEMP=0'+PTabela.FieldByName('P1CODEMP').AsString
                      +' and P1LOTSEQ=0'+PTabela.FieldByName('P1LOTSEQ').AsString
                      +' and P1CHAVE=0'+PTabela.FieldByName('P1CHAVE').AsString
                      +' and P1ORDEM=0'+PTabela.FieldByName('P1ORDEM').AsString);
   DM1.Query1.ParamByName('MOTIVO').AsString:=copy(pMotivo,1,60);
   Try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;

   except
      ex_erroSql(01,7966,'func2','CADP01');
      end;

   DM1.Query1.Close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.Sql.add('Update CADP02 set P2STATUS=9 '
                      +'  where P2CODEMP=0'+PTabela.FieldByName('P1CODEMP').AsString
                      +' and P2LOTSEQ=0'+PTabela.FieldByName('P1LOTSEQ').AsString
                      +' and P2CHAVE=0'+PTabela.FieldByName('P1CHAVE').AsString
                      +' and P2ORDEM=0'+PTabela.FieldByName('P1ORDEM').AsString);
   Try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql(01,8324,'func2','CADP01');
      end;

// EXCLUIR O CADLDR
   DM1.Query3.Close;
   DM1.Query3.Sql.Clear;
   DM1.Query3.Sql.add('Select CRCODEMP,CRCODLDR,CRLOTSEQ_FC FROM CADDAR '
                     +' where CRCODEMP=0'+PTabela.FieldByName('P1CODEMP').AsString
                     +' and CRLOTSEQ_CP=0'+PTabela.FieldByName('P1LOTSEQ').AsString
                     +' and CRNPED=0'+PTabela.FieldByName('P1CHAVE').AsString
                     +' and CRORDEM=0'+PTabela.FieldByName('P1ORDEM').AsString);
   DM1.Query3.Open;
   While not DM1.Query3.Eof do
      begin
      DM1.Query1.Close;
      DM1.Query1.SQL.Clear;
      DM1.Query1.Params.CreateParam(ftString,'DTHREXC',ptInput);
      DM1.Query1.SQL.Add('Update CADLDR set STATUS=9, '
                        +' USREXC=0'+IntToStr(codusr)+','
                        +' DTHREXC=:DTHREXC '
                        +' where CODEMP=0'+DM1.Query3.fieldbyName('CRCODEMP').AsString
                        +' and LOTSEQ=0'+DM1.Query3.fieldbyName('CRLOTSEQ_FC').AsString
                        +' and CODLDR=0'+DM1.Query3.fieldbyName('CRCODLDR').AsString);
      DM1.Query1.ParamByName('DTHREXC').AsDateTime:=now;
      Try
         DM1.Query1.ExecSQL;
         fdm1StartCommit;
      except
         ex_erroSql(01,10526,'func2','CADLDR');
         end;
      DM1.Query3.Next;
      end;

// TERMINO DO CADLDR

   DM1.Query1.Close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.Sql.add('Update CADDAR SET CRSTATUS=9, '
                     +' CRUSRALT=0'+IntTostr(codusr)+','
                     +' CRDTALT=:DTALT'
                     +' where CRCODEMP=0'+PTabela.FieldByName('P1CODEMP').AsString
                     +' and CRLOTSEQ_CP=0'+PTabela.FieldByName('P1LOTSEQ').AsString
                     +' and CRNPED=0'+PTabela.FieldByName('P1CHAVE').AsString
                     +' and CRORDEM=0'+PTabela.FieldByName('P1ORDEM').AsString);
   DM1.Query1.ParambyName('DTALT').AsDateTime:=now;
   Try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql(01,7979,'func2','CADDAR');
      end;
   DM1.Query1.Close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.Sql.add('Update CADNS SET NSSTATUS=case when NSNUMERO>0 then '+IntTostr(pTipo)+' else NSSTATUS end '
                      +',NSNFCE_SITUACAO=case when NSNFCE_NUMERO>0 then '+IntTostr(pTipo)+' else NSNFCE_SITUACAO end '
                     +' where NSCODEMP=0'+PTabela.FieldByName('P1CODEMP').AsString
                     +' and NSLOTSEQ_CP=0'+PTabela.FieldByName('P1LOTSEQ').AsString
                     +' and NSCHAVEP=0'+PTabela.FieldByName('P1CHAVE').AsString
                     +' and NSORDEMP=0'+PTabela.FieldByName('P1ORDEM').AsString
                            +'  and NSTIPO<2 ' );
   Try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql(01,7989,'func2','CADNS');
      end;
   DM1.Query1.Close;
   PTabela.Next;
   end;
end;
