Function fAtualizarPrecosFormula(pCodpro,pCodMat: real): Boolean;
begin
DM1.Query1.Close;
DM1.Query1.sql.Clear;
DM1.Query1.sql.Add('Update CADCOMP set CPPU='
                  +' (Select DECODE(PDPRECOC,0,'
                  +'  DECODE(PDPCOFAB,0,'
                  +'  DECODE(PDUCPR,0,PDPRECOC,PDUCPR)'
                  +'  ,PDPCOFAB)'
                  +'  ,PDPRECOC)'
                  +'from CADPRO where '
                  +iif(DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' PDCODEMP=CPCODEMP and ')
                  +' PDCODPRO=CPCODMAT )');
DM1.Query1.sql.Add(' WHERE EXISTS (Select DECODE(PDPRECOC,0,PDPCOFAB,PDPRECOC) from CADPRO where '
                  +iif(DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' PDCODEMP=CPCODEMP and ')
                  +' PDCODPRO=CPCODMAT ');

// Antigo
{DM1.Query1.sql.Add('Update CADCOMP set CPPU='
                  +' (Select DECODE( '
                  +' PDPCOFAB,0, DECODE(PDUCPR,0, '
                  +' PDPRECOC,PDUCPR),PDPCOFAB) from CADPRO where '
                  +iif(DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' PDCODEMP=CPCODEMP and ')
                  +' PDCODPRO=CPCODMAT )');
DM1.Query1.sql.Add(' WHERE EXISTS (Select DECODE(PDPRECOC,0,PDPCOFAB,PDPRECOC) from CADPRO where '
                  +iif(DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' PDCODEMP=CPCODEMP and ')
                  +' PDCODPRO=CPCODMAT '); }
if pCodMat<>0 then
   DM1.Query1.sql.Add(' and CPCODMAT=0'+FloatToStr(pcodmat));
if pCodPro<>0 then
   DM1.Query1.sql.Add(' and CPCODPRO=0'+FloatToStr(pcodPro));
DM1.Query1.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
DM1.Query1.sql.Add(') ');
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   DM1.Query1.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
   FMensagem('Erro 1983 ao Atualizar Formulas!',0,['0'],0);
   exit;
   end;

DM1.Query1.Close;
DM1.Query1.sql.Clear;
DM1.Query1.sql.Add('Update CADCOMP set CPVLRINC=(Select PDVLRINC from CADPRO where '
                  +iif(DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' PDCODEMP=CPCODEMP and ')
                  +' PDCODPRO=CPCODMAT )');
DM1.Query1.Sql.add(' where exists (Select PDVLRINC from CADPRO where '
                  +iif(DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' PDCODEMP=CPCODEMP and ')
                  +' PDCODPRO=CPCODMAT ');
if pCodMat<>0 then
   DM1.Query1.sql.Add(' and CPCODMAT=0'+FloatToStr(pcodmat));
if pCodPro<>0 then
   DM1.Query1.sql.Add(' and CPCODPRO=0'+FloatToStr(pcodPro));
DM1.Query1.sql.Add(') ');
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   DM1.Query1.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
   FMensagem('Erro 1983 ao Atualizar Formulas!',0,['0'],0);
   exit;
   end;

DM1.Query1.Close;
DM1.Query1.sql.Clear;
DM1.Query1.sql.Add('Update CADCOMP set CPALIQORI=(Select PDICMSCRED from CADPRO where '
                  +iif(DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' PDCODEMP=CPCODEMP and ')
                  +' PDCODPRO=CPCODMAT )');
DM1.Query1.sql.add(' where exists (Select PDICMSCRED from CADPRO where '
                  +iif(DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' PDCODEMP=CPCODEMP and ')
                  +' PDCODPRO=CPCODMAT ');
if pCodMat<>0 then
   DM1.Query1.sql.Add(' and CPCODMAT=0'+FloatToStr(pcodmat));
if pCodPro<>0 then
   DM1.Query1.sql.Add(' and CPCODPRO=0'+FloatToStr(pcodPro));
DM1.Query1.sql.Add(') ');

try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   DM1.Query1.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
   FMensagem('Erro 1983 ao Atualizar Formulas!',0,['0'],0);
   exit;
   end;

DM1.Query1.Close;
DM1.Query1.sql.Clear;
DM1.Query1.sql.Add('Update CADCOMP set CPALICMSCRED=ROUND( ( ( ( (CPVLRINC*CPALIQORI)/100 ) * 100 ) / CPPU) ,2) '
                  +' where '
                  +iif( DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' CPCODEMP=0'+IntTostr(codemp)+'and ')
                  +' CPVLRINC<>0 and not CPVLRINC is null AND CPALIQORI<>0 and not CPALIQORI is null ');
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   DM1.Query1.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
   FMensagem('Erro 1983 ao Atualizar Formulas!',0,['0'],0);
   exit;
   end;


DM1.Query1.Close;
DM1.Query1.sql.Clear;
DM1.Query1.sql.Add('Update CADCOMP set CPALICMSCRED=0 '
                  +' where '
                  +iif(DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' CPCODEMP=0'+IntTostr(codemp)+'and ')
                  +' CPVLRINC=0 OR CPVLRINC is null or CPALIQORI=0 or CPALIQORI is null ');
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   DM1.Query1.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
   FMensagem('Erro 1983 ao Atualizar Formulas!',0,['0'],0);
   exit;
   end;

DM1.Query1.Close;
DM1.Query1.sql.Clear;
DM1.Query1.sql.Add('Update CADCOMP set CPICMSCRED=ROUND(  (ROUND( CPQUANT*CPPU ,'+DM1.Tb_PargerPCASPUIND.AsString+' )'
                                                 +' * CPALICMSCRED /100 ) ,'+DM1.Tb_PargerPCASPUIND.AsString+' )'
                  +' where '
                  +iif(DM1.Qr_TID.locate('TINOME','CADPRO',[]),'',' CPCODEMP=0'+IntTostr(codemp)+' and ')
                  +' CPALICMSCRED<>0 and not CPALICMSCRED is null ');
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   DM1.Query1.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
   FMensagem('Erro 1983 ao Atualizar Formulas!',0,['0'],0);
   exit;
   end;
result:=true;
end;

