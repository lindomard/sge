function fLimiteCredCliente(pCodCli: Real):String;
{
Valores de Retorno: as duas primeiras posiçoes indica o resultado,
                    o restante é observacoes

00-Liberado Não Verifica Bloqueio
01-Valor Disponivel de Credito
02-Bloqueado


}
var
mfunc_totdeb: Real;
mfunc_totcred: Real;
mfunc_limcred: Real;
mResposta: String;
mCod_Resposta: Integer;
mfunc_chqdev: boolean;

begin
mResposta    :='';
mCod_Resposta:=1;
mfunc_totdeb :=0;
mfunc_totcred:=0;
mfunc_chqdev :=false;


DM1.Query4.close;
DM1.Query4.SQL.Clear;
DM1.Query4.SQL.add('Select CSITCLI,CLCRED from CADCLI '
                  +' where '+iif(DM1.Qr_TID.Locate('TINOME','CADCLI',[]),'',' CCODEMP=0'+IntToStr(codemp)+' and ')
                  +' CCODCLI=0'+FloatToStr(pCodCli));
try
   DM1.Query4.Open;
except
   end;
mfunc_limcred :=DM1.Query4.fieldbyName('CLCRED').AsFloat;

if DM1.Query4.fieldbyName('CSITCLI').AsInteger>0 then
   begin
   mCod_Resposta:=02;
   mResposta    :='Bloqueado Pelo Cadastro';
   result:=Formatfloat('00',mCod_Resposta)+'-'+mResposta;
   exit;
   end
else
   begin
   la_Empresas:=fla_EmpBaixaAlta(0,'CADDAR','',codemp,'CRCODEMP','');
   DM1.Query2.Close;
   DM1.Query2.Sql.Clear;
   DM1.Query2.Sql.add('Select CRCODEMP,CRNUMERO,CRDESD,CRDUP,CRDTEMIS,'
                 +'       CRDTVCTO,CRDTPAG,CRDTBX,CRCODVEN,CRVALOR,'
                 +'       CRSTATUS,CRCODBCO,CRCODCLI,CRVALPAG '
                 +'       ,CRJUROS,CRDESC,CRDEVOL,CRTITPROT FROM CADDAR '
                 +'       WHERE '+iif(la_Empresas='','',la_Empresas+' and ')
                 +'       CRSTATUS<>9 '
                 +' and CRCODCLI=0'+FloatTostr(pcodcli));
   DM1.Query2.Sql.add(' order by CRDTVCTO');
   DM1.Query2.Open;

   While not DM1.Query2.Eof do
      begin
      if (DM1.Query2.fieldbyName('CRDUP').AsInteger=1) or (DM1.Query2.fieldbyName('CRDUP').AsInteger=2) then
         begin
         if DM1.Query2.fieldbyName('CRSTATUS').AsInteger<2 then
            mfunc_chqdev:=true;
         end
      else if DM1.Query2.fieldbyName('CRDUP').AsInteger=5 then
         begin
         if DM1.Query2.fieldbyName('CRSTATUS').AsInteger<2 then
            begin
            mfunc_totcred:=mfunc_totcred+(DM1.Query2.fieldbyName('CRVALOR').AsFloat
                                        -DM1.Query2.fieldbyName('CRVALPAG').AsFloat);
            end;
         end
      else if DM1.Query2.fieldbyName('CRSTATUS').AsInteger<2 then
         begin
         mfunc_totdeb:=mfunc_totdeb+(DM1.Query2.fieldbyName('CRVALOR').AsFloat
                                        -DM1.Query2.fieldbyName('CRVALPAG').AsFloat);
         end;
      DM1.Query2.Next;
      end;

   if mfunc_chqdev then
      begin
      mCod_Resposta:=02;
      mResposta    :='Possui Cheque Devolvido em Aberto';
      result:=Formatfloat('00',mCod_Resposta)+'-'+mResposta;
      exit;
      end;

   if mfunc_limcred<=0 then
      begin
      mCod_Resposta:=00;
      mResposta    :='Cliente sem limite de crédito';
      result:=Formatfloat('00',mCod_Resposta)+'-'+mResposta;
      exit;
      end;
   end;




la_Empresas:=fla_EmpBaixaAlta(0,'CADCHQ','',codemp,'CHCODEMP','');


DM1.Query3.Close;
DM1.Query3.SQL.Clear;
DM1.Query3.SQL.add(' Select CHCODEMP,CHNUMERO,CHBANCO,CHSERIE,CHVALOR, '
              +' CHDTEMIS,CHDTDEP,CHCODCLI '
              +'  from CADCHQ where '+iif(la_Empresas='','',la_Empresas+' and ')
              +'       CHCODCLI=0'+FloatToStr(pcodcli));
DM1.Query3.SQL.Add(' and (CHSTATUS<1 or  CHDTDEP>='+chr(39)+FormatDateTime(fdt, Date-DM1.Tb_PargerPPRZCOMP.AsInteger)+chr(39)+')');
DM1.Query3.Open;
la_Empresas:=fla_EmpBaixaAlta(0,'CADP01','',codemp,'P1CODEMP','');

DM1.Query4.Close;
DM1.Query4.SQL.Clear;
DM1.Query4.SQl.add('Select P1CHAVE,P1ORDEM,P1CODVEN,P1TOTALL, '
              +'       P1CODCLI,P1DATAP,P1TIPO from '
              +'       CADP01 where '+iif(la_Empresas='','',la_Empresas+' and ')
              +' P1CODCLI=0'+FloatToStr(pcodcli)
              +' and P1EMIDOC < 1 and P1TIPO>0 ');
DM1.Query4.Sql.add(' order by P1DATAP ');
DM1.Query4.Open;
While not DM1.Query4.Eof do
   begin
   mfunc_totdeb:=mfunc_totdeb+DM1.Query4.fieldbyName('P1TOTALL').AsFloat;
   DM1.Query4.Next;
   end;

While not DM1.Query3.Eof do
   begin
   mfunc_totdeb:=mfunc_totdeb+(DM1.Query3.fieldbyName('CHVALOR').AsFloat);
   DM1.Query3.Next;
   end;

mCod_Resposta:=01;
mResposta    :=insere(FloatToStr((mfunc_limcred+mfunc_totcred-mfunc_totdeb)*100),' ',14);
result:=Formatfloat('00',mCod_Resposta)+'-'+mResposta;

end;


Function fCarregarPO99(pvtabpv: String; pcodemp,plotseq,pchave: Real): Boolean;
begin
if pvtabpv='PO' then
   begin
   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;
   DM1.Query1.SQL.add('Select POCODEMP as POCODEMP, '
                     +' POPRAZO as POPRAZO from CADPO99 '
                     +' where '
                     +iif(DM1.Qr_Tid.Locate('TINOME','CADPED',[]),'',' POCODEMP=0'+FloatToStr(pcodemp)+' and ')
                     +' POLOTSEQ=0'+FloatTostr(plotseq)
                     +' and POCHAVE=0'+FloatToStr(pchave)
                     +' order by POPRAZO');
   DM1.Query1.Open;
   end
else
   begin
   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;
   DM1.Query1.SQL.add('Select PV2CODEMP as POCODEMP, '
                     +' PV2PRAZO as POPRAZO from CADPV2 '
                     +' where '
                     +iif(DM1.Qr_Tid.Locate('TINOME','CADPV',[]),'',' PV2CODEMP=0'+IntToStr(codemp)+' and ')
                     +' PV2CODTIP='+chr(39)+pvtabpv+chr(39)
                     +' and PV2CODPV=0'+FloatToStr(pchave)
                     +' order by PV2PRAZO');
   DM1.Query1.Open;
   end;
DM4.Tb_Po99.Close;
DM4.Tb_Po99.Open;
While not DM1.Query1.Eof do
   begin
   DM4.Tb_Po99.Append;
   DM4.Tb_Po99POCODEMP.Value:=DM1.Query1.fieldbyName('POCODEMP').AsFloat;
   DM4.Tb_Po99POPRAZO.Value :=DM1.Query1.fieldbyName('POPRAZO').AsFloat;
   DM4.Tb_Po99.Post;
   DM1.Query1.Next;
   end;

if DM4.Tb_Po99.IsEmpty then
   result:=False
else
   result:=True;
end;

function fRetInstMECadastro(pTabela,pCampo: String; pCodemp: Integer): String;
begin
