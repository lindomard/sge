         pRet_Qtd:=1
      else
         pRet_Qtd:=DM1.Query1.fieldbyName('CBQTDMULT').AsFloat;
      exit;
      end;
   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;
   DM1.Query1.SQL.Add('Select PDNOME,PDCODBAR,PDEMBPAD,PDCODPRO from CADPRO where '
                     +iif(DM1.Qr_TID.Locate('TINOME','CADPRO',[]),'',' PDCODEMP=0'+IntToStr(codemp)+' and ')
                     +' PDCODBAR_EMBPAD='+chr(39)+pCodigo+chr(39));
   DM1.Query1.Open;
   if not DM1.Query1.IsEmpty then
      begin
      result:=DM1.Query1.fieldbyName('PDCODPRO').AsFloat;
      if DM1.Query1.fieldbyName('PDEMBPAD').AsFloat=0 then
         pRet_Qtd:=1
      else
         pRet_Qtd:=DM1.Query1.fieldbyName('PDEMBPAD').AsFloat;
      exit;
      end;
   mcinst2:=IntToStr(length(pCodigo));
   DM1.Query2.Close;
   DM1.Query2.Sql.Clear;
   DM1.Query2.SQL.add('SELECT fcodfor, '
                     +' fcb_tam,fcb_poscod,fcb_tamcod,fcb_posvct,fcb_tamvct,fcb_tamqtd,fcb_posqtd '
                     +' ,fcb_tamlot,fcb_poslot from cadfor where '
                     +iif(DM1.Qr_TID.Locate('TINOME','CADFOR',[]),'',' FCODEMP=0'+IntTostr(codemp)+' and ')
                     +' FCB_TAM=0'+mcinst2);
   DM1.Query2.Open;
   if not DM1.Query2.IsEmpty then
