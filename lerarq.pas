function fdadosconfig_geral(pChave: string): string;
var
query_config: TQuery;
begin

query_config:=TQuery.create(nil);
query_config.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_config.sql.clear;
query_config.sql.Add('select CG_VALOR from CADCONFIG_GERAL where CG_CHAVE=:CHAVE ');
query_config.parambyname('CHAVE').AsString:=pChave;

try
   query_config.open;
   if query_config.IsEmpty then
      result:=''
   else
      result:=query_config.fieldbyname('CG_VALOR').AsString;
except on e: Exception do
   begin
   result:='';
   ex_erroSql_Novo(Query_config,29184,'lerarq:'+e.message ,'CADCONFIG_GERAL');
   end;
   end;

query_config.close;
freeandnil(query_config);

end;



function fGravarconfig_geral(pChave,pValor: string): boolean;
var
query_config: TQuery;
begin

query_config:=TQuery.create(nil);
query_config.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_config.sql.clear;
query_config.sql.Add('MERGE INTO CADCONFIG_GERAL T1 '
                    +' USING (SELECT '+QuotedStr(pchave)+' AS CHAVE, '+QuotedStr(pvalor)+' AS VALOR '
                    +'       FROM DUAL) ss '
                    +'  ON (t1.CG_CHAVE = ss.CHAVE)  '
                    +'   WHEN MATCHED THEN '
                    +'   UPDATE SET t1.CG_VALOR = ss.VALOR '
                    +'   WHEN NOT MATCHED THEN '
                    +'   INSERT( t1.CG_CHAVE, t1.CG_VALOR ) '
                    +'    VALUES( ss.CHAVE, ss.VALOR ) ');
{query_config.parambyname('CHAVE').AsString:=pChave;
query_config.parambyname('VALOR').AsString:=pValor;
}
try
   query_config.ExecSQL;
   fdm1StartCommit;
   result:=true;
except on e: Exception do
   begin
   result:=false;
   ex_erroSql_Novo(Query_config,29184,'lerarq:'+e.message ,'CADCONFIG_GERAL');
   end;
   end;
query_config.close;
freeandnil(query_config);

end;






function fCarregarQrDup(pQtdVias: Integer):boolean;
var
