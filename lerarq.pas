      procedure fLerCadUfSt(pCodEmp: Integer; pUf: String; pIcmsDebStSn,pIcmsDebNormal: Real);
      begin
      query_uf_st.close;
      query_uf_st.sql.clear;
      query_uf_st.sql.add(' select '
                +'  UF_ST_CODEMP, '
                +'  UF_ST_UF, '
                +'  UF_ST_TABELA, '





                +'  UF_ST_ICMSCRED_NOR , '
                +'  UF_ST_ICMSCRED_SN, '
                +'  UF_ST_ICMSDEB_NOR , '
                +'  UF_ST_ICMSDEB_SN, '
                +'  UF_ST_IVA_POS_NOR , '
                +'  UF_ST_IVA_NEG_NOR , '
                +'  UF_ST_IVA_INA_NOR, '
                +'  UF_ST_IVA_POS_SN , '
                +'  UF_ST_IVA_NEG_SN , '
                +'  UF_ST_IVA_INA_SN, '

{


                +'  case when UF_ST_ICMSCRED_NOR=0 then '+mudaVP(DM1.Tb_UFPICMSC.AsString)+' else  UF_ST_ICMSCRED_NOR END AS UF_ST_ICMSCRED_NOR , '
                +'  case when UF_ST_ICMSCRED_SN=0 then '+mudaVP(DM1.Tb_UFPICMSC_SN.AsString)+' else UF_ST_ICMSCRED_SN end as UF_ST_ICMSCRED_SN, '
                +'  case when UF_ST_ICMSDEB_NOR=0 then ' + mudavp(floattoStr(pIcmsDebNormal))+' else UF_ST_ICMSDEB_NOR end as UF_ST_ICMSDEB_NOR , '
                +'  case when UF_ST_ICMSDEB_SN=0 then ' + mudavp(floattostr(pIcmsDebStSn))+' else UF_ST_ICMSDEB_SN end as UF_ST_ICMSDEB_SN, '
                +'  case when UF_ST_IVA_POS_NOR=0 then ' + mudaVP(DM1.Tb_UFPIVAPOS.AsString)+' else UF_ST_IVA_POS_NOR end as UF_ST_IVA_POS_NOR , '
                +'  case when UF_ST_IVA_NEG_NOR=0 then ' + mudaVP(DM1.Tb_UFPIVANEG.AsString)+' else UF_ST_IVA_NEG_NOR end as UF_ST_IVA_NEG_NOR , '
                +'  case when UF_ST_IVA_INA_NOR=0 then ' + mudaVp(DM1.Tb_UFPIVAPOS.AsString)+' else UF_ST_IVA_INA_NOR end as UF_ST_IVA_INA_NOR, '

                +'  case when UF_ST_IVA_POS_SN=0 then ' + mudaVP(DM1.Tb_UFPIVAPOS_SN.AsString)+' else UF_ST_IVA_POS_SN end as UF_ST_IVA_POS_SN , '
                +'  case when UF_ST_IVA_NEG_SN=0 then ' + mudaVP(DM1.Tb_UFPIVANEG_SN.AsString)+' else UF_ST_IVA_NEG_SN end as UF_ST_IVA_NEG_SN , '
                +'  case when UF_ST_IVA_INA_SN=0 then ' + mudaVp(DM1.Tb_UFPIVAPOS_SN.AsString)+' else UF_ST_IVA_INA_SN end as UF_ST_IVA_INA_SN, '

}


                +'  UF_ST_MOD_BCST, '
                +'  UF_ST_SOB_LIQ '
                +'  from CADUF_ST where UF_ST_CODEMP='+ inttostr(codemp)+' AND UF_ST_UF='+QuotedStr(DM1.Tb_CliCUF.AsString)
                +' AND UF_ST_TABELA<>'+QuotedStr('J')
                +' union all '
                +' select '
                +'  '+inttostr(CodEmp)+' as UF_ST_CODEMP, '
                +'  '+QuotedStr(DM1.Tb_CliCUF.AsString)+' AS UF_ST_UF, '
                +'  chr(level+64) as UF_ST_TABELA, '
                +'  0 as UF_ST_ICMSCRED_NOR, '
                +'  0 as UF_ST_ICMSCRED_SN, '
                +'  0 as UF_ST_ICMSDEB_NOR, '
                +'  0 as UF_ST_ICMSDEB_SN, '
                +'  0 as UF_ST_IVA_POS_NOR, '
                +'  0 as UF_ST_IVA_NEG_NOR, '
                +'  0 as UF_ST_IVA_INA_NOR, '

                +'  0 as UF_ST_IVA_POS_SN, '
                +'  0 as UF_ST_IVA_NEG_SN, '
                +'  0 as UF_ST_IVA_INA_SN, '

                +'  -1 as UF_ST_MOD_BCST, '
                +'  -1 as UF_ST_SOB_LIQ '
                +'  from DUAL CONNECT BY LEVEL <= 9 ');

query_uf_st.sql.text:=' select '
                +'  UF_ST_CODEMP, '
                +'  UF_ST_UF, '
                +'  UF_ST_TABELA, '
                +'  MAX(UF_ST_ICMSCRED_NOR) AS UF_ST_ICMSCRED_NOR, '
                +'  MAX(UF_ST_ICMSCRED_SN) AS UF_ST_ICMSCRED_SN, '
                +'  MAX(UF_ST_ICMSDEB_NOR) AS UF_ST_ICMSDEB_NOR, '
                +'  MAX(UF_ST_ICMSDEB_SN) AS UF_ST_ICMSDEB_SN, '

                +'  MAX(UF_ST_IVA_POS_NOR) AS UF_ST_IVA_POS_NOR, '
                +'  MAX(UF_ST_IVA_NEG_NOR) AS UF_ST_IVA_NEG_NOR, '
                +'  MAX(UF_ST_IVA_INA_NOR) AS UF_ST_IVA_INA_NOR, '


                +'  MAX(UF_ST_IVA_POS_SN) AS UF_ST_IVA_POS_SN, '
                +'  MAX(UF_ST_IVA_NEG_SN) AS UF_ST_IVA_NEG_SN, '
                +'  MAX(UF_ST_IVA_INA_SN) AS UF_ST_IVA_INA_SN, '


                +'  MAX(UF_ST_MOD_BCST) AS UF_ST_MOD_BCST, '
                +'  MAX(UF_ST_SOB_LIQ) AS UF_ST_SOB_LIQ '
                +'  from ( ' + query_uf_st.sql.text +' ) t1 '
                +' group by   UF_ST_CODEMP, '
                +'  UF_ST_UF, '
                +'  UF_ST_TABELA '
                +' order by UF_ST_TABELA ';



try
   query_uf_st.Open;
except ON E: Exception do
   begin
   ex_erroSql_Novo(query_uf_st,2695,'_stru'+e.message,'user');
   end;
   end;
//  ex_erroSql_Novo(query_uf_st,2695,'_stru','user');



      end;
