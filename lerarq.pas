      Query_exe.SQL.clear;
      mCampo_Novo:=Query_old.fieldbyName('COLUMN_NAME').AsString;
      mCampo_Novo:=mCampo_Novo+' '+Query_old.fieldbyName('DATA_TYPE').AsString;
