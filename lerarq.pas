      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1ICMS_BCIPI') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1ICMS_VLIPI') or

      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1COMV04') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1TOTCGRU') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1TOTSGRU') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1TOTSERLIQ')  or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1TOTPIS') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1TOTCOFINS') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1RED_BCISSQN') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1BCINSS') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1RED_BCINSS') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1VINSS') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1BCIRRF') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1RED_BCIRRF') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1VIRRF') or
      (Query_cons.FieldByName('COLUMN_NAME').AsString='P1COMISS') then
      begin
      mValues:=mValues+','+Query_cons.FieldByName('COLUMN_NAME').AsString;
      end
   else
      begin
      mValues:=mValues+','+Query_cons.FieldByName('COLUMN_NAME').AsString;
      end;
   Query_cons.Next;
   end;


Query_Exe.SQL.add(' ) '+mValues+' from CADP01 ' );
Query_Exe.SQL.add(' where P1CHAVE=:CHAVE and P1CODEMP=:CODEMP and P1LOTSEQ=:LOTSEQ and P1ORDEM=:ORDEM ');
Query_Exe.ParamByName('CHAVE').AsFloat:=pChave_ori;
Query_Exe.ParamByName('CODEMP').AsFloat:=pCodEmp_Ori;
Query_Exe.ParamByName('LOTSEQ').AsFloat:=pLotSeq_Ori;
Query_Exe.ParamByName('ORDEM').AsFloat:=01;


try
   Query_Exe.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
   ex_erroSql_Novo(Query_Exe,1111,'frm_venda','CADP01');
   FreeAndNil(Query_Exe);
   FreeAndNil(Query_cons);
   result:=false;
   exit;
   end;

/// cadp02
pLotseq_nov:=pLotSeq_Ori;
pCodEmp_Nov:=pCodEmp_Nov;
freeandnil(query_cons);
freeandnil(query_exe);

end;

function fAjustaTributacoesPed52(pDataIni,pDataFin: TDateTime; pCodEcf: Integer): Boolean;
var
Qr_Cat52: tQuery;
Qr_CupomArred: tQuery;

Qr_exe: tQuery;
mMeioComando: String;
mItem_Trib: Integer;
mItem_Ret: Integer;

begin
Qr_Cat52:=tQuery.Create(nil);
Qr_Cat52.DatabaseName:='SG_ASSOC';
Qr_CupomArred:=tQuery.Create(nil);
Qr_CupomArred.DatabaseName:='SG_ASSOC';

Qr_exe:=tQuery.Create(nil);
Qr_exe.DatabaseName:='SG_ASSOC';

Qr_Cat52.close;
Qr_Cat52.SQL.Clear;
Qr_Cat52.SQL.Add('Select * from (');
Qr_Cat52.SQL.Add('SELECT CM2CODEMP,CM2CODIMP,CM2DATA '
                  +'       ,sum(MP_VDALIQ)  AS MP_VDALIQ '
                  +'       ,SUM(MP_CANCELADOS) AS MP_CANCELADOS '
                  +'       ,sum(MP_ACREC) AS MP_ACREC '
                  +'       ,sum(MP_DESC)  AS MP_DESC'
                  +'       ,sum(MP_ISENTAS) AS MP_ISENTAS '
                  +'       ,sum(MP_NAOINC) AS MP_NAOINC '
                  +'       ,sum(MP_SUBTRI)  AS MP_SUBTRI '
                  +'       ,SUM(MP_TOTTRIB) AS MP_TOTTRIB '
                  +'       ,max(ORIGEMINF) AS ORIGEMINF '
                  +'       ,sum(CAT52_VDALIQ) AS CAT52_VDALIQ'
                  +'       ,sum(MP_VDALIQ-CAT52_VDALIQ) AS DIFMP_CAT52_VDALIQ '
                  +'       ,sum(CAT52_CANCELADOS) AS CAT52_CANCELADOS '
                  +'       ,sum(CAT52_ACREC) AS CAT52_ACREC '
                  +'       ,sum(CAT52_DESC) AS CAT52_DESC '
                  +'       ,sum(CAT52_ISENTAS) AS CAT52_ISENTAS '
                  +'       ,sum(MP_ISENTAS-CAT52_ISENTAS) AS DIFMP_CAT52_ISENTAS '
                  +'       ,sum(CAT52_NAOINC) AS CAT52_NAOINC '
                  +'       ,sum(MP_NAOINC-CAT52_NAOINC) AS DIFMP_CAT52_NAOINC '
                  +'       ,sum(CAT52_SUBTRI) AS CAT52_SUBTRI '
                  +'       ,sum(MP_SUBTRI-CAT52_SUBTRI) AS DIFMP_CAT52_SUBTRI '
                  +'       ,sum(CAT52_TOTTRIB) AS CAT52_TOTTRIB '
                  +'       ,sum(MP_TOTTRIB-CAT52_TOTTRIB) AS DIFMP_CAT52_TOTTRIB '
                  +'       ,sum(PED2_VDALIQ) AS PED2_VDALIQ '
                  +'       ,sum(MP_VDALIQ-PED2_VDALIQ) AS DIFMP_PED2_VDALIQ '
                  +'       ,sum(PED2_CANCELADOS) AS PED2_CANCELADOS '
                  +'       ,sum(PED2_ACREC) AS PED2_ACREC '
                  +'       ,sum(PED2_DESC) AS PED2_DESC '
                  +'       ,sum(PED2_ISENTAS) AS PED2_ISENTAS '
                  +'       ,sum(MP_ISENTAS-PED2_ISENTAS) AS DIFMP_PED2_ISENTAS '
                  +'       ,sum(PED2_NAOINC) AS PED2_NAOINC '
                  +'       ,sum(MP_NAOINC-PED2_NAOINC) AS DIFMP_PED2_NAOINC '
                  +'       ,sum(PED2_SUBTRI) AS PED2_SUBTRI '
                  +'       ,sum(MP_SUBTRI-PED2_SUBTRI) AS DIFMP_PED2_SUBTRI '
                  +'       ,sum(PED2_TOTTRIB) AS PED2_TOTTRIB '
                  +'       ,sum(MP_TOTTRIB-PED2_TOTTRIB) AS DIFMP_PED2_TOTTRIB '
                  +' from ( ');

Qr_Cat52.SQL.Add('SELECT CM2CODEMP,CM2CODIMP,CM2DATA '
                  +'       ,CMVDALIQ AS MP_VDALIQ '
                  +'       ,CMCUPCAN AS MP_CANCELADOS '
                  +'       ,CMACRECUP AS MP_ACREC '
                  +'       ,CMDESCUP AS MP_DESC'
                  +'       ,CMISENTAS AS MP_ISENTAS '
                  +'       ,CMNAOINC AS MP_NAOINC '
                  +'       ,CMSUBTRI AS MP_SUBTRI '
                  +'       ,SUM(CM2VALOR) AS MP_TOTTRIB '
                  +'       ,'+QuotedStr('MP')+' AS ORIGEMINF '
                  +'       ,0 AS CAT52_VDALIQ'
                  +'       ,0 AS CAT52_CANCELADOS '
                  +'       ,0 AS CAT52_ACREC '
                  +'       ,0 AS CAT52_DESC '
                  +'       ,0 AS CAT52_ISENTAS '
                  +'       ,0 AS CAT52_NAOINC '
                  +'       ,0 AS CAT52_SUBTRI '
                  +'       ,0 AS CAT52_TOTTRIB '
                  +'       ,0 AS PED2_VDALIQ '
                  +'       ,0 AS PED2_CANCELADOS '
                  +'       ,0 AS PED2_ACREC '
                  +'       ,0 AS PED2_DESC '
                  +'       ,0 AS PED2_ISENTAS '
                  +'       ,0 AS PED2_NAOINC '
                  +'       ,0 AS PED2_SUBTRI '
                  +'       ,0 AS PED2_TOTTRIB '
                  +'        FROM CADMI01,CADMI02 '
                  +'       WHERE CM2CODEMP=CMCODEMP AND CM2CODIMP=CMCODIMP AND CM2DATA=CMDATA '
                  +'       AND CMDATA>=:DATAINI and CMDATA<=:DATAFIN '
                  +' AND CMCODEMP=:CODEMP '
                  +' AND CMCODIMP=:CODIMP '
                  +' GROUP BY '
                  +' CM2CODEMP,CM2CODIMP,CM2DATA '
                  +'       ,CMVDALIQ '
                  +'       ,CMCUPCAN '
                  +'       ,CMACRECUP '
                  +'       ,CMDESCUP '
                  +'       ,CMISENTAS '
                  +'       ,CMNAOINC '
                  +'       ,CMSUBTRI '
                     +' union '
                     +' SELECT P1CODEMP AS CM2CODEMP '
                     +'       ,P1CODECF AS CM2CODIMP '
                     +'       ,P1DATACF AS CM2DATA '
                     +'       ,0 AS MP_VDALIQ '
                     +'       ,0 AS MP_CANCELADOS '
                     +'       ,0 AS MP_ACREC '
                     +'       ,0 AS MP_DESC '
                     +'       ,0 AS MP_ISENTAS '
                     +'       ,0 AS MP_NAOINC '
                     +'       ,0 AS MP_SUBTRI '
                     +'       ,0 AS MP_TOTTRIB '
                     +'       ,'+QuotedStr('PED2')+' AS ORIGEMINF '
                     +'       ,0 AS CAT52_VDALIQ '
                     +'       ,0 AS CAT52_CANCELADOS '
                     +'       ,0 AS CAT52_ACREC '
                     +'       ,0 AS CAT52_DESC '
                     +'       ,0 AS CAT52_ISENTAS '
                     +'       ,0 AS CAT52_NAOINC '
                     +'       ,0 AS CAT52_SUBTRI '
                     +'       ,0 AS CAT52_TOTTRIB '
                     +'       ,sum(CASE WHEN P1STATUS>='+mstatus_excluido+' THEN 0 ELSE P2TOTLIQ END) AS PED2_VDALIQ '
                     +'       ,sum(CASE WHEN P1STATUS>='+mstatus_excluido+' THEN P2TOTLIQ ELSE 0 END) AS PED2_CANCELADOS '
                     +'       ,sum(CASE WHEN P1STATUS>='+mstatus_excluido+' THEN 0 ELSE 0 END) AS  PED2_ACREC '
                     +'       ,sum(CASE WHEN P1STATUS>='+mstatus_excluido+' THEN 0 ELSE P2TOTDES END) AS  PED2_DESC'
                     +'       ,sum(CASE WHEN P1STATUS>='+mstatus_excluido+' THEN 0 WHEN SUBSTR(P2SIT,2,2)='+QuotedStr('40')+' THEN P2TOTLIQ ELSE 0 END) AS  CAT52_ISENTAS '
                     +'       ,sum(CASE WHEN P1STATUS>='+mstatus_excluido+' THEN 0 WHEN SUBSTR(P2SIT,2,2)='+QuotedStr('41')+' THEN P2TOTLIQ ELSE 0 END) AS  CAT52_NAOINC '
                     +'       ,sum(CASE WHEN P1STATUS>='+mstatus_excluido+' THEN 0 WHEN SUBSTR(P2SIT,2,1) in ('+QuotedStr('1')+','+QuotedStr('3')+','+QuotedStr('7')+','+QuotedStr('6')+') THEN P2TOTLIQ ELSE 0 END) AS  CAT52_SUBTRI '
                     +'       ,sum(CASE WHEN P1STATUS>='+mstatus_excluido+' THEN 0 WHEN P2ALIQ>0 THEN P2TOTLIQ ELSE 0 END) AS  CAT52_TOTTRIB '
                     +'       FROM CADP01,CADP02 WHERE'
                     +'       P2CODEMP=P1CODEMP AND P2CHAVE=P1CHAVE AND P2LOTSEQ=P1LOTSEQ '
                     +'       AND P1CODEMP=:CODEMP '
                     +'       AND P1DATACF>=:DATAINI AND P1DATACF<=:DATAFIN '

//                     +'       AND P1NUMCF<>:NUMCF '

                     +' GROUP BY  P1CODEMP '
                     +'       ,P1CODECF '
                     +'       ,P1DATACF ');

Qr_Cat52.parambyname('CODEMP').asinteger:=codemp;
Qr_Cat52.parambyname('DATAINI').asDateTime:=pDataIni;
Qr_Cat52.parambyname('DATAFIN').asDateTime:=pDataFin;
Qr_Cat52.parambyname('CODIMP').asinteger:=pCodEcf;

Qr_Cat52.SQL.add(' ) ');
Qr_Cat52.SQL.add(' group by CM2CODEMP,CM2CODIMP,CM2DATA ');
Qr_Cat52.SQL.add(' ) where  DIFMP_CAT52_VDALIQ=0 '
                +' AND (DIFMP_CAT52_TOTTRIB+DIFMP_CAT52_SUBTRI)=0 '
                +' AND DIFMP_CAT52_TOTTRIB<>0 AND DIFMP_CAT52_SUBTRI<>0 ');

Qr_Cat52.SQL.add('  order by CM2DATA,CM2CODIMP ');
//Qr_Cat52.sql.savetofile(mpastatemp + 'SQLcat52.txt');

try
   Qr_Cat52.open;
except on e : exception do
   begin
   ex_erroSql_Novo(Qr_Cat52,9921,'lerarq'+e.Message ,'CADECF_CAT52_ITENS');
   result:=false;
   exit;
   end;
   end;
if Qr_Cat52.IsEmpty then
   begin
   result:=true;
   exit;
   end;
While not Qr_Cat52.Eof do
   begin
   mMeioComando:='select TESTE.*,ROUND( ((TOTTRIB_CAT52*100) / TOTRET_CAT52),0) AS PERC from '
             +'( select '
             +' P1CODEMP,P1CHAVE,P1ORDEM,P1LOTSEQ, '
             +' SUM(CASE WHEN P2ALIQ>0 THEN '
             +'  P2TOTLIQ+P2DESCRAT '
             +'   else 0 END) AS TOTTRIB_CAT52 '
             +'       ,sum(CASE WHEN P1STATUS>='+mstatus_excluido+' THEN 0 WHEN SUBSTR(P2SIT,2,1) in ('+QuotedStr('1')+','+QuotedStr('3')+','+QuotedStr('7')+','+QuotedStr('6')
                 +') THEN P2TOTLIQ+P2DESCRAT ELSE 0 END) AS  TOTRET_CAT52 '
             +' FROM CADP01,CADP02 '
             +' WHERE P1DATACF='+quotedstr(FormatDateTime(fdt2, Qr_Cat52.fieldbyname('CM2DATA').AsDateTime))
             +' AND P1STATUS<'+mstatus_excluido
             +' and  P2DESCRAT>0 '
             +' GROUP BY P1CODEMP,P1CHAVE,P1ORDEM,P1LOTSEQ '
             +' ) TESTE where TOTTRIB_CAT52>0 AND TOTRET_CAT52>0 ORDER BY TOTTRIB_CAT52 DESC ';

   Qr_CupomArred.Close;
   Qr_CupomArred.SQL.clear;
   Qr_CupomArred.Sql.add('SELECT * FROM ( '
                     +mMeioComando
                     +') WHERE PERC>50 AND PERC<150 ');
   Qr_CupomArred.Open;
   if Qr_CupomArred.IsEmpty then
      begin
      Qr_CupomArred.Close;
      Qr_CupomArred.SQL.clear;
      Qr_CupomArred.Sql.add(
                           mMeioComando
                           );
      Qr_CupomArred.Open;
      end;
   Qr_exe.close;
   Qr_exe.sql.clear;
   Qr_exe.sql.Add('Select P2ITEM,P2TOTLIQ from CADP02 '
                 +' WHERE '
                 +' SUBSTR(P2SIT,2,1) in ('+QuotedStr('1')+','+QuotedStr('3')+','+QuotedStr('7')+','+QuotedStr('6')
                 +') and P2CHAVE=:CHAVE and P2LOTSEQ=:LOTSEQ and P2ORDEM=:ORDEM and P2CODEMP=:CODEMP '
                  +' order by P2TOTLIQ DESC ');
   Qr_exe.ParamByName('CHAVE').Value   :=Qr_CupomArred.fieldbyname('P1CHAVE').AsFloat;
   Qr_exe.ParamByName('LOTSEQ').Value  :=Qr_CupomArred.fieldbyname('P1LOTSEQ').AsInteger;
   Qr_exe.ParamByName('ORDEM').Value   :=Qr_CupomArred.fieldbyname('P1ORDEM').AsInteger;
   Qr_exe.ParamByName('CODEMP').Value  :=Qr_CupomArred.fieldbyname('P1CODEMP').AsInteger;
   qr_exe.open;
   mItem_Ret:=Qr_exe.fieldbyname('P2ITEM').AsInteger;
   Qr_exe.close;
   Qr_exe.sql.clear;
   Qr_exe.sql.Add('Select P2ITEM,P2TOTLIQ from CADP02 '
                 +' WHERE '
                 +' P2ALIQ>0 '
                 +') and P2CHAVE=:CHAVE and P2LOTSEQ=:LOTSEQ and P2ORDEM=:ORDEM and P2CODEMP=:CODEMP '
                  +' order by P2TOTLIQ DESC ');
   Qr_exe.ParamByName('CHAVE').Value   :=Qr_CupomArred.fieldbyname('P1CHAVE').AsFloat;
   Qr_exe.ParamByName('LOTSEQ').Value  :=Qr_CupomArred.fieldbyname('P1LOTSEQ').AsInteger;
   Qr_exe.ParamByName('ORDEM').Value   :=Qr_CupomArred.fieldbyname('P1ORDEM').AsInteger;
   Qr_exe.ParamByName('CODEMP').Value  :=Qr_CupomArred.fieldbyname('P1CODEMP').AsInteger;
   qr_exe.open;
   mItem_Trib:=Qr_exe.fieldbyname('P2ITEM').AsInteger;

   Qr_exe.close;
   Qr_exe.sql.clear;
   Qr_exe.sql.Add('Update CADP02 SET P2DESCRAT=P2DESCRAT- :MDIFER '
                 +', P2TOTDES=P2TOTDES- :MDIFER '
                 +', P2TOTLIQ=P2TOTLIQ+ :MDIFER '
                 +' where P2CHAVE=:CHAVE and P2LOTSEQ=:LOTSEQ and P2ORDEM=:ORDEM and P2CODEMP=:CODEMP '
                 +' and P2ITEM=:ITEM ');
   Qr_exe.ParamByName('CHAVE').Value   :=Qr_CupomArred.fieldbyname('P1CHAVE').AsFloat;
   Qr_exe.ParamByName('LOTSEQ').Value  :=Qr_CupomArred.fieldbyname('P1LOTSEQ').AsInteger;
   Qr_exe.ParamByName('ORDEM').Value   :=Qr_CupomArred.fieldbyname('P1ORDEM').AsInteger;
   Qr_exe.ParamByName('CODEMP').Value  :=Qr_CupomArred.fieldbyname('P1CODEMP').AsInteger;
   Qr_exe.ParamByName('ITEM').Value    :=mItem_Ret;
   Qr_exe.ExecSQL;
   fdm1StartCommit;


   Qr_exe.close;
   Qr_exe.sql.clear;

   Qr_exe.sql.Add('Update CADP02 SET P2DESCRAT=P2DESCRAT- :MDIFER '
                 +', P2TOTDES=P2TOTDES- :MDIFER '
                 +', P2TOTLIQ=P2TOTLIQ+ :MDIFER '
                 +', P2BASEN=P2BASEN+ :MDIFER '
                 +' where P2CHAVE=:CHAVE and P2LOTSEQ=:LOTSEQ and P2ORDEM=:ORDEM and P2CODEMP=:CODEMP '
                 +' and P2ITEM=:ITEM ');
   Qr_exe.ParamByName('CHAVE').Value   :=Qr_CupomArred.fieldbyname('P1CHAVE').AsFloat;
   Qr_exe.ParamByName('LOTSEQ').Value  :=Qr_CupomArred.fieldbyname('P1LOTSEQ').AsInteger;
   Qr_exe.ParamByName('ORDEM').Value   :=Qr_CupomArred.fieldbyname('P1ORDEM').AsInteger;
   Qr_exe.ParamByName('CODEMP').Value  :=Qr_CupomArred.fieldbyname('P1CODEMP').AsInteger;
   Qr_exe.ParamByName('ITEM').Value    :=mItem_trib;

   Qr_exe.ExecSQL;
   fdm1StartCommit;
   Qr_Cat52.Next;
   end;

end;

function fGravarArquivoParticionadoBlob(pArquivo,pNomeRel,pTabela,pCampo_Emp,pCampo_NomRel,pCampo_Ordem,pCampo_Dados,pCampo_NomeOri: String;pCamposExtras: array of string; pValoresCampoosExtras: array of string): Boolean;

var
Ado_Cadop: TADOQuery;
x: Integer;
mQtdParte: Integer;
pArquivosCompactar: TStrings;
mExtensao: String;
 x_extra: Integer;
begin
if not FileExists(pArquivo) then
   begin
   result:=false;
   exit;
   end;
mExtensao:=UpperCase( ExtractFileExt(pArquivo));
pArquivo:=fRetiraExtensao(pArquivo);


if mExtensao <> '.ZIP' then
   begin
   pArquivosCompactar:=TStringList.Create;
   pArquivosCompactar.Add(pArquivo+mExtensao);
   fZiparArquivos(pArquivosCompactar,pArquivo+'.ZIP','');
   FreeAndNil(pArquivosCompactar);
   end;
Ado_Cadop:=TADOQuery.Create(NIL);
Ado_Cadop.Connection:=DM1_ADO.ADOConnection1;
Ado_Cadop.Close;
Ado_Cadop.SQL.Clear;
Ado_Cadop.Close;
Ado_Cadop.SQL.Clear;
Ado_Cadop.SQL.Add('Delete from CADDW_CFG where DW_CODEMP=:CODEMP '
                     +' and DW_NOMREL=:NOMREL ');
for x_extra:=0 to high(pCamposExtras) do
   Ado_Cadop.SQL.Add(' and '+pcamposExtras[x_extra]+'=:'+pcamposExtras[x_extra]) ;

Ado_Cadop.Parameters.ParamByName('CODEMP').Value := codemp;
Ado_Cadop.Parameters.ParamByName('NOMREL').Value := pNomeRel;
for x_extra:=0 to high(pCamposExtras) do
   Ado_Cadop.Parameters.ParamByName(pcamposExtras[x_extra]).Value:=pValoresCampoosExtras[x_extra];

try
   Ado_Cadop.execsql;
   fdm1startcommit;
except
   end;

mQtdParte:=fPartionarArquivo(pArquivo+'.ZIP');
Ado_Cadop.Close;
Ado_Cadop.SQL.Clear;
Ado_Cadop.SQL.Add('Select * from '+pTabela+'  where '+pCampo_Emp+'=:CODEMP and '+pCampo_NomRel+'=:NOMREL');
for x_extra:=0 to high(pCamposExtras) do
   Ado_Cadop.SQL.Add(' and '+pcamposExtras[x_extra]+'=:'+pcamposExtras[x_extra]) ;
Ado_Cadop.Parameters.ParamByName('CODEMP').Value:=codemp;
Ado_Cadop.Parameters.ParamByName('NOMREL').Value:=pNomeRel;
for x_extra:=0 to high(pCamposExtras) do
   Ado_Cadop.Parameters.ParamByName(pcamposExtras[x_extra]).value:=pValoresCampoosExtras[x_extra];

Ado_Cadop.Open;
if not Ado_Cadop.IsEmpty then
   begin
   Ado_Cadop.Close;
   Ado_Cadop.SQL.Clear;
   Ado_Cadop.SQL.Add('Delete from '+pTabela+' where '+pCampo_Emp+'=:CODEMP and '+pCampo_NomRel+'=:NOMREL');
   for x_extra:=0 to high(pCamposExtras) do
      Ado_Cadop.SQL.Add(' and '+pcamposExtras[x_extra]+'=:'+pcamposExtras[x_extra]) ;

   Ado_Cadop.Parameters.ParamByName('CODEMP').Value:=codemp;
   Ado_Cadop.Parameters.ParamByName('NOMREL').Value:=pNomeRel;
   for x_extra:=0 to high(pCamposExtras) do
      Ado_Cadop.Parameters.ParamByName(pcamposExtras[x_extra]).Value:=pValoresCampoosExtras[x_extra];

   Ado_Cadop.ExecSQL;
   fdm1StartCommit;
   end;
for x:=1 to mQtdParte do
   begin
   if not FileExists(pArquivo+'PARTE'+IntToStr(x)+'.DAT') then
      continue;
   Ado_Cadop.Close;
   Ado_Cadop.SQL.Clear;
   Ado_Cadop.SQL.Add('Insert into '+pTabela+' ('
                    +' '+pCampo_Emp
                    +','+pCampo_NomRel
                    +','+pCampo_Ordem
                    +','+pCampo_Dados
                    +','+pCampo_NomeOri);
   for x_extra:=0 to high(pCamposExtras) do
      begin
      Ado_Cadop.SQL.Add(','+pcamposExtras[x_extra]);
      end;

   Ado_Cadop.SQL.Add(') values ('
                    +' :CODEMP'
                    +',:NOMREL'
                    +',:ORDEM'
                    +',:DADOS'
                    +',:NOMEORI');
   for x_extra:=0 to high(pCamposExtras) do
      begin
      Ado_Cadop.SQL.Add(',:'+pcamposExtras[x_extra]);
      end;
   Ado_Cadop.SQL.Add(')');
   Ado_Cadop.parameters.ParamByName('CODEMP').Value:=codemp;
   Ado_Cadop.parameters.ParamByName('NOMREL').Value:=pNomeRel;
   Ado_Cadop.parameters.ParamByName('ORDEM').Value:=X;
   Ado_Cadop.parameters.ParamByName('DADOS').LoadFromFile(pArquivo+'PARTE'+IntToStr(x)+'.DAT',ftBlob);
   Ado_Cadop.parameters.ParamByName('NOMEORI').Value := Fnomearq_Pasta(0,pArquivo)+mExtensao;

   for x_extra:=0 to high(pValoresCampoosExtras) do
      begin
      Ado_Cadop.parameters.ParamByName(pcamposExtras[x_extra]).Value:=pValoresCampoosExtras[x_extra];
      end;


   try
      Ado_Cadop.ExecSQL;
      fdm1StartCommit;
   except
      verteclado(0);
      MessageDlg('Erro ao Gravar no Banco de Dados!',mtWarning,[mbOk],0);
      FreeAndNil(Ado_Cadop);
      result:=false;
      exit;
      end;
   end;
if mExtensao<>'.ZIP' then
   DeleteFile(pchar(pArquivo+'.ZIP'));
for x:=1 to mQtdParte do
   begin
   DeleteFile(pchar(pArquivo+'PARTE'+IntToStr(x)+'.DAT'));
   end;

FreeAndNil(Ado_Cadop);

result:=true;
end;




