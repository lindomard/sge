         else
            begin
            mcinst4:=copy(pCodigo,DM1.Query2.fieldbyName('FCB_POSCOD').AsInteger
                                 ,DM1.Query2.fieldbyName('FCB_TAMCOD').AsInteger);
            DM1.Query1.Close;
            DM1.Query1.SQL.Clear;
