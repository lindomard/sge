function fPegarDadosCaixa(pChaveCaixa,pOrigemCod,pNatDC:string;pCodigo: Real;pcodBco: Integer; out pDadosCaixa:tDadosCaixa): Boolean;
var
query_temp: TQuery;
mTabela: string;
mCodccu_deb: string;
mCodDep_deb: String;
mCodccu_cred: string;
mCodDep_cred: String;
mCampoCodigo: String;

begin
mDadosCaixa.pldr_nombco :='';
mDadosCaixa.pldr_nomdep :='';
mDadosCaixa.pldr_nomccu :='';
mDadosCaixa.pldr_natdc  :='';
mDadosCaixa.pldr_codccu :='';
mDadosCaixa.pldr_coddep :='';
mDadosCaixa.pldr_descmov:='';


if not fLerGenerico_query('CADBCO','BCBANCO','BCCODBCO=0'+IntToStr(pcodBco),query_consulta) then
   begin
   result:=false;
   exit;
   end;

pldr_nombco:=query_consulta.fieldbyname('BCBANCO').AsString;
mDadosCaixa.pldr_nombco:=query_consulta.fieldbyname('BCBANCO').AsString;
query_temp:=TQuery.Create(nil);
query_temp.databasename:='SG_ASSOC';

query_temp.Close;
query_temp.SQL.clear;
if (pOrigemCod='CL') or (pOrigemCod='FR') then // cliente
   begin
   if (pOrigemCod='CL') then
      begin
      mTabela:='CADCLI';
      mCodccu_deb:='CCODCCD';
      mCodDep_deb:='CCODDEPD';
      mCodccu_Cred:='CCODCCC';
      mCodDep_Cred:='CCODDEPC';
      mCampoCodigo:='CCODCLI';
      end
   else
      begin
      mTabela:='CADFOR';
      mCodccu_deb:='FCODCCD';
      mCodDep_deb:='FCODDEPD';
      mCodccu_Cred:='FCODCCC';
      mCodDep_Cred:='FCODDEPC';
      mCampoCodigo:='FCODFOR';
      end;
   query_temp.SQL.Add('select dadosfc.* '
                     +' ,(select DNOME from CADDEP where DCODDEP=CODDEP and rownum<2 ) as NOMDEP '
                     +',CCNOME,CCNAT '
                     +' from ( '
                     +' select '
                     +' case when NATDC='+QuotedStr('D')+' then '
                     +'      case when length('+mCodccu_deb+')> 1 then '+mCodccu_deb+' else CODCC  end '
                     +' else '
                     +'      case when length('+mCodccu_Cred+')> 1 then '+mCodccu_Cred+' else CODCC end '
                     +' end as CODCC '
                     +', '
                     +' case when NATDC='+QuotedStr('D')+' then '
                     +'      case when length('+mCodDep_deb+')> 1 then '+mCodDep_deb+' else CODDEP  end '
                     +' else '
                     +'      case when length('+mCodDep_cred+')> 1 then '+mCodDep_cred+' else CODDEP end '
                     +' end as CODDEP,NOME '
                     +'  from '
                     +' ( '
                     +' select NOME,CODCC,CODDEP,:NATDC as natdc from parldr where CDOC=:CHAVECAIXA'
                     +'  AND ROWNUM<2 order by CODEMP  '
                     +' ) df,'+mTabela+' where '+mCampoCodigo+'=:CODIGO '
                     +') dadosfc,cadccu where CCCODCCU=CODCC ');
   query_temp.ParamByName('CHAVECAIXA').AsString:=pChaveCaixa;
   query_temp.ParamByName('NATDC').AsString     :=pnatdc;
   query_temp.ParamByName('CODIGO').AsFloat     :=pCodigo;
   end
else
   begin
   query_temp.SQL.Add('select dadosfc.* '
                     +' ,(select DNOME from CADDEP where DCODDEP=CODDEP and rownum<2 ) as NOMDEP '
                     +',CCNOME,CCNAT,NOME '
                     +'  from '
                     +' ( '
                     +' select NOME,CODCC,CODDEP,:NATDC as natdc from parldr where CDOC=:CHAVECAIXA'
                     +'  AND ROWNUM<2 order by CODEMP  '
                     +') dadosfc,cadccu where CCCODCCU=CODCC ');
   query_temp.ParamByName('CHAVECAIXA').AsString:=pChaveCaixa;
   query_temp.ParamByName('NATDC').AsString     :=pnatdc;
   end;
try
   query_temp.open;
except on e : exception do
   begin
   ex_erroSql_Novo(query_temp,24674,'lerarq:'+e.Message ,'PARLDR');
   freeandnil(query_temp);
   result:=false;
   exit;
   end;
   end;

//   ex_erroSql_Novo(query_temp,24674,'lerarq:','PARLDR');




mDadosCaixa.pldr_descmov:=query_temp.fieldbyname('NOME').AsString;
mDadosCaixa.pldr_codccu :=query_temp.fieldbyname('CODCC').AsString;
mDadosCaixa.pldr_nomccu :=query_temp.fieldbyname('CCNOME').AsString;
mDadosCaixa.pldr_natdc  :=query_temp.fieldbyname('CCNAT').AsString;
mDadosCaixa.pldr_coddep :=query_temp.fieldbyname('CODDEP').AsString;
mDadosCaixa.pldr_nomdep :=query_temp.fieldbyname('NOMDEP').AsString;

mDadosCaixa.pldr_codbco := pcodbco;

FreeAndNil(query_temp);
result:=true;
end;



