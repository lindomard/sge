   if DM1.Query1.fields[0].AsInteger>0 then
      begin
      result:=true;
      exit;
      end;

   DM1.Query1.close;
   DM1.Query1.sql.clear;
   DM1.Query1.sql.add('Select count(*) as qtd from CADAJU where '
                     +iif(DM1.Qr_tid.locate('TINOME','CADEST',[]),'',' AJCODEMP=0'+Inttostr(Codemp)+' and ')
                     +' AJCODPRO=0'+pCodpro);
   DM1.Query1.Open;
   if DM1.Query1.fields[0].AsInteger>0 then
      begin
      result:=true;
      exit;
      end;
   end
else if ptipo=0 then
   begin
   DM1.Query1.close;
   DM1.Query1.sql.clear;
   DM1.Query1.sql.add('Select count(*) as qtd from CADP02 where '
                     +iif(DM1.Qr_tid.locate('TINOME','CADPED',[]),'',' P2CODEMP=0'+Inttostr(Codemp)+' and ')
                     +' P2CODPRO=0'+pCodpro
                     +' and P2LOTE='+chr(39)+pGrade+chr(39));
   DM1.Query1.Open;
   if DM1.Query1.fields[0].AsInteger>0 then
      begin
      result:=true;
      exit;
      end;

   DM1.Query1.close;
   DM1.Query1.sql.clear;
   DM1.Query1.sql.add('Select count(*) as qtd from CADPF2 where '
                     +iif(DM1.Qr_tid.locate('TINOME','CADPFOR',[]),'',' PF2CODEMP=0'+Inttostr(Codemp)+' and ')
                     +' PF2CODPRO=0'+pCodpro
                     +' and PF2LOTE='+chr(39)+pGrade+chr(39));
   DM1.Query1.Open;
   if DM1.Query1.fields[0].AsInteger>0 then
      begin
      result:=true;
      exit;
      end;

   DM1.Query1.close;
   DM1.Query1.sql.clear;
   DM1.Query1.sql.add('Select count(*) as qtd from CADAJU where '
                     +iif(DM1.Qr_tid.locate('TINOME','CADEST',[]),'',' AJCODEMP=0'+Inttostr(Codemp)+' and ')
                     +' AJCODPRO=0'+pCodpro
                     +' and AJLOTE='+chr(39)+pGrade+chr(39));
   DM1.Query1.Open;
   if DM1.Query1.fields[0].AsInteger>0 then
      begin
      result:=true;
      exit;
      end;
   end;
end;

function fCriargrade(pCodemp, pCodPro, pQtd, pQtdR, pQtdc, pPco01, pPco02,pPco03,pPcoa01, pPcoa02,pPcoa03,
                   pPcus,pEstmax,pEstMin: Real;pNumero: String;  pDtVcto: TDateTime): Boolean;
begin
if pDtVcto<=pdatanula then
   pDtVcto:=pdatanula;
DM1.Query1.Close;
DM1.Query1.sql.clear;
DM1.Query1.Params.CreateParam(ftString,'DTVCTO',ptInput);
DM1.Query1.Params.CreateParam(ftString,'NUMERO',ptInput);
DM1.Query1.Params.CreateParam(ftstring,'DTUATP1',ptinput);
DM1.Query1.Params.CreateParam(ftstring,'DTUATP2',ptinput);
DM1.Query1.Params.CreateParam(ftstring,'DTUATP3',ptinput);
DM1.Query1.SQL.Add('Insert into CADLGC ('
                  +' CLCODEMP '
                  +',CLCODPRO '
                  +',CLDTVCTO '
                  +',CLNUMERO '
                  +',CLQTD '
                  +',CLQTD_DEP '
                  +',CLQTD_PRAT '
                  +',CLQTD_REP '
                  +',CLQTDR '
                  +',CLQTDC '
                  +',CLQTDT '
                  +',CLPRECO1 '
                  +',CLPRECO2 '
                  +',CLPRECO3 '
                  +',CLPRECOA1 '
                  +',CLPRECOA2 '
                  +',CLPRECOA3 '
                  +',CLPCUSTO '
                  +',CLESTMAX '
                  +',CLESTMIN '
                  +',CLDTUATP1 '
                  +',CLDTUATP2 '
                  +', CLDTUATP3) values ('
                  +FloatToStr(pCodemp)
                  +','+FloatToStr(pCodPro)
                  +',:DTVCTO'
                  +',:NUMERO'
                  +','+mudavp(FloatToStr(pQtd))
                  +',0'
                  +',0'
                  +','+mudavp(FloatToStr(pQtd))
                  +','+mudavp(FloatToStr(pQtdR))
                  +','+mudavp(FloatToStr(pQtdC))
                  +',0' // quantidade terceiros
                  +','+mudavp(FloatToStr(pPco01))
                  +','+mudavp(FloatToStr(pPco02))
                  +','+mudavp(FloatToStr(pPco03))
                  +','+mudavp(FloatToStr(pPcoa01))
                  +','+mudavp(FloatToStr(pPcoa02))
                  +','+mudavp(FloatToStr(pPcoa03))
                  +','+mudavp(FloatToStr(pPcus))
                  +','+mudavp(FloatToStr(pEstmax))
                  +','+mudavp(FloatToStr(pEstMin))
                  +',:DTUATP1 '
                  +',:DTUATP2 '
                  +',:DTUATP3'
                  +')');
DM1.Query1.ParamByName('DTVCTO').AsDateTime:=pDtVcto;
DM1.Query1.ParamByName('NUMERO').AsString  :=pNumero;
DM1.Query1.ParamByName('DTUATP1').AsString:=FormatDateTime(fdt, pdatanula);
DM1.Query1.ParamByName('DTUATP2').AsString:=FormatDateTime(fdt, pdatanula);
DM1.Query1.ParamByName('DTUATP3').AsString:=FormatDateTime(fdt, pdatanula);

try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
   ex_erroSql(01,6026,'lerarq','CADLGC');
   result:=false;
   end;
end;

