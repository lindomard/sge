   begin
   freeandnil(query_temp);
   result:=true;
   exit;
   end;
Query_Pcus:=tQuery.Create(nil);
Query_Pcus.DatabaseName:='SG_ASSOC';

Query_Exe:=tQuery.Create(nil);
Query_Exe.DatabaseName:='SG_ASSOC';
fGerarEvento('24157 codigo do produto '+floattostr(pCodPro) );

While not Query_Temp.Eof do
   begin
   fGerarEvento('24161 loop codigo do produto '+floattostr(pCodPro) );
   Query_Pcus.Close;
