                       );

           fGerarEvento('31322');


           query_fat.ParamByName('CODEMP').AsInteger:=query_pedidos_origem.Fieldbyname('CODEMP').AsInteger;
           query_fat.ParamByName('LOTSEQ').AsInteger:=query_pedidos_origem.Fieldbyname('LOTSEQ').AsInteger;
           query_fat.ParamByName('CHAVE').AsInteger:=query_pedidos_origem.Fieldbyname('CHAVE').AsInteger;
           query_fat.SQL.Text:='Select P2.*,QTD-QTDFAT AS FATURAR from ('
                         +query_fat.sql.text
