procedure fGravarDownload_XML_NFE(pchacesso,pXml: string);
var
query_exe: TQuery;

begin

query_exe:=TQuery.create(nil);
query_exe.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_exe.SQL.clear;
query_exe.SQL.add('Select count(*) from CADNE_NFE_DOWNLOAD '
                 +' where NED_CHACESSO=:CHACESSO ');
query_exe.parambyname('CHACESSO').AsString := pchacesso;
try
   query_exe.open;
except on e : exception do
   ex_erroSql_Novo(query_exe,779,'func Erro:'+e.Message ,'CADNE_NFE_DOWNLOAD');
   end;
if query_exe.Fields[0].asinteger>0 then
   begin
   query_exe.close;
   query_exe.SQL.Clear;
   query_exe.SQL.add('Update CADNE_NFE_DOWNLOAD set '
                    +' NED_CODEMP =:CODEMP '
                    +',NED_DATOR_DOWLOAD =SYSDATE '
                    +',NED_XML_NFE=:XML_NFE'
                    +' where NED_CHACESSO=:CHACESSO ');
   end
else
   begin
   query_exe.close;
   query_exe.SQL.Clear;
   query_exe.SQL.add('Insert into  CADNE_NFE_DOWNLOAD ('
                    +' NED_CODEMP '
                    +',NED_CHACESSO '
                    +',NED_DATOR_DOWLOAD '
                    +',NED_XML_NFE'
                    +') values ('
                    +' :CODEMP '
                    +',:CHACESSO '
                    +',SYSDATE '
                    +',:XML_NFE '
                    +') ');
   end;
query_exe.ParamByName('CODEMP').AsInteger  := codemp;
query_exe.ParamByName('CHACESSO').AsString := pchacesso;
query_exe.ParamByName('XML_NFE').AsString  := pXml;
try
   query_exe.ExecSQL;
   fdm1StartCommit;
except on e : exception do
   ex_erroSql_Novo(query_exe,814,'func Erro:'+e.Message ,'CADNE_NFE_DOWNLOAD');
   end;
query_exe.Close;
freeandnil(query_exe);


end;

