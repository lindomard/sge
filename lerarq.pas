function flBuscarCodigos(pcodemp: Integer; pvalor: String): Real;
var
query_parcod: TQuery;
mComp_Sql: String;
mCodRet: Real;
begin

query_parcod:=TQuery.create(nil);
query_parcod.DatabaseName:='SG_ASSOC';
While true do
   begin
   query_parcod.Close;
   query_parcod.SQL.clear;

   query_parcod.SQL.add('Select * from CADPARCOD ');
   mComp_Sql:=' where ';
   if pcodemp<>0 then
      begin
      query_parcod.SQL.Add(mComp_Sql+' PCCODEMP=0'+IntToStr(pcodemp));
      mComp_Sql:=' and ';
      end
   else if (trim(pvalor)<>'') and (DM1.Qr_TID.Locate('TINOME',pvalor,[])) then
      begin
      query_parcod.SQL.Add(mComp_Sql+' PCCODEMP=0'+IntToStr(codemp));
      mComp_Sql:=' and ';
      end;
   if trim(pvalor)<>'' then
      query_parcod.SQL.Add(mComp_Sql+' PCTABELA='+chr(39)+pvalor+chr(39));
   query_parcod.Open;
   if query_parcod.IsEmpty then
      fAjustarcodigos(0)
   else
      break;
   end;
mCodRet:=query_parcod.fieldbyName('PCCODIGO').AsFloat;

query_parcod.Close;
query_parcod.SQL.clear;
query_parcod.SQL.Add('UPDATE CADPARCOD set PCCODANT=:CODANT,PCCODIGO=:CODIGO ');
mComp_Sql:=' where ';
if pcodemp<>0 then
   begin
   query_parcod.SQL.Add(mComp_Sql+' PCCODEMP=0'+IntToStr(pcodemp));
   mComp_Sql:=' and ';
   end
else if (trim(pvalor)<>'') and (DM1.Qr_TID.Locate('TINOME',pvalor,[])) then
   begin
   query_parcod.SQL.Add(mComp_Sql+' PCCODEMP=0'+IntToStr(codemp));
   mComp_Sql:=' and ';
   end;
if trim(pvalor)<>'' then
   query_parcod.SQL.Add(mComp_Sql+' PCTABELA='+chr(39)+pvalor+chr(39));
query_parcod.ParamByName('CODANT').Value:=mCodRet;
query_parcod.ParamByName('CODIGO').Value:=mCodRet+1;

try
   query_parcod.execsql;
   fdm1startcommit;
except
   end;
freeandnil(query_parcod);
result:=mCodRet;
end;


function flBuscarChave(pTipo,pCodEmp: Integer; pNomDoc: String): Real;
{
ptipo=0 Busca o Numero e incrementa 1
      1 busca o nUmero e nao incrementa;
}
var
mChave: Real;
begin
if pCodEmp=0 then
   pcodemp:=codemp;
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.Params.CreateParam(ftString,'NOMDOC',ptInput);
DM1.Query1.SQL.Add('Select CC_CHAVE,CC_OBS from CADCHAVE where '
                  +' CC_CODEMP=0'+IntToStr(pcodemp)
                  +' and CC_NOMDOC=:NOMDOC');
DM1.Query1.ParamByName('NOMDOC').AsString:=pNomDoc;

DM1.Query1.Open;
if DM1.Query1.IsEmpty then
   begin
   mchave:=1;
   if pNomDoc='LOTE_RE' then
      begin
      DM1.Query1.Close;
      DM1.Query1.sql.Clear;
      DM1.Query1.sql.Add('Select max(PF2LOTE_RE) as LOTE from CADPF2 where '
                        +iif(DM1.Qr_Tid.Locate('TINOME','CADPF2',[]),'',
                        '  PF2CODEMP=0'+IntToStr(pCodEmp)+' and ')
                        +' PF2CHAVE=(Select max(PF1CHAVE) from CADPF1 where '+
                        +iif(DM1.Qr_Tid.Locate('TINOME','CADPF1',[]),'',
                        '  PF1CODEMP=0'+IntToStr(pCodEmp)+' and ')
                        +' PF1STATUS>0 and PF1STATUS<9 )');
      try
         DM1.Query1.Open;
      except
         DM1.Query1.SQL.SaveToFile(SALVA_NOME('ErroSql\','EX'));
         end;
      mChave:=ValFloat(DM1.Query1.fieldbyName('LOTE').AsString)+1;
      end;

   DM1.Query2.Close;
   DM1.Query2.SQL.Clear;
   DM1.Query2.Params.CreateParam(ftString,'NOMDOC',ptInput);
   DM1.Query2.Params.CreateParam(ftString,'OBS',ptInput);
   DM1.Query2.SQL.Add('Insert into CADCHAVE ('
                     +' CC_CODEMP '
                     +',CC_NOMDOC '
                     +',CC_OBS '
                     +',CC_LOTSEQ '
                     +',CC_CHAVE '
                     +') values ('
                     +IntTostr(pCodEmp)
                     +',:NOMDOC '
                     +',:OBS '
                     +',0'
                     +','+FloatTostr(mChave+1)
                     +')');
   DM1.Query2.ParambyName('NOMDOC').AsString:=pNomDoc;
   DM1.Query2.ParambyName('OBS').AsString   :='';
   try
      DM1.Query2.ExecSQL;
      fdm1StartCommit;
   except
      end;

   end
else
   begin
   mChave:=DM1.Query1.fieldbyName('CC_CHAVE').AsFloat;
   if pTipo=0 then
      begin
      DM1.Query2.Close;
      DM1.Query2.SQL.Clear;
      DM1.Query2.Params.CreateParam(ftString,'NOMDOC',ptInput);
      DM1.Query2.SQL.Add('Update CADCHAVE set CC_CHAVE=CC_CHAVE+1 '
                        +' where CC_CODEMP='+IntToStr(pCodEmp)
                        +' and CC_NOMDOC=:NOMDOC ');
      DM1.Query2.ParambyName('NOMDOC').AsString:=pNomDoc;
      try
         DM1.Query2.ExecSQL;
         fdm1StartCommit;
      except
         end;
      end;   
   end;
result:=mChave;

end;

function flDesfazerCodigos(pcodemp: Integer; pvalor: String; pCodigo:Real): Boolean;
var
  mcodigo : real;
  mcod    : String;
begin
mcodigo := pCodigo;

if ((pValor = 'CADFOR') and (DM1.Tb_PargerPDCADFOR.Value=1)) or
   ((pValor = 'CADCLI') and (DM1.Tb_PargerPDCADCLI.Value=1)) or
   ((pValor = 'CADCAR') and (DM1.Tb_PargerPDCADCAR.Value=1)) or
   ((pValor = 'CADCV')  and (DM1.Tb_PargerPDCADCV.Value=1))  or
   ((pValor = 'CADGRU') and (DM1.Tb_PargerPDCADGRU.Value=1)) or
   ((pValor = 'CADLOC') and (DM1.Tb_PargerPDCADLOC.Value=1)) or
   ((pValor = 'CADPRO') and (DM1.Tb_PargerPDCADPRO.Value=1)) or
   ((pValor = 'CADRAM') and (DM1.Tb_PargerPDCADRAM.Value=1)) or
   ((pValor = 'CADRED') and (DM1.Tb_PargerPDCADRED.Value=1)) or
   ((pValor = 'CADTRA') and (DM1.Tb_PargerPDCADTRA.Value=1)) or
   ((pValor = 'CADVEN') and (DM1.Tb_PargerPDCADVEN.Value=1)) or
   ((pValor = 'CADSUP') and (DM1.Tb_PargerPDCADSUP.Value=1)) or
   ((pValor = 'CADUSR') and (DM1.Tb_PargerPDCADUSR.Value=1)) or
   ((pValor = 'CADCON') and (DM1.Tb_PargerPDCADCON.Value=1)) or
   ((pValor = 'CADGFOR') and (DM1.Tb_PargerPDCADGRU.Value=1)) then begin

      mcod := FloatToStr(mcodigo);
      mcod := Copy(mcod,1,Length(mcod)-1);
      mcodigo := valFloat(mcod);
end;

if not flcadparCod(pcodemp,pvalor) then
   begin
   fAjustarcodigos(0);
   flcadparCod(pcodemp,pvalor);
   end;
if mcodigo=DM4.Tb_ParCodPCCODANT.Value then
   begin
   DM4.Tb_ParCod.Edit;
   DM4.Tb_ParCodPCCODIGO.Value:=DM4.Tb_ParCodPCCODANT.Value;
   DM4.Tb_ParCodPCCODANT.Value:=DM4.Tb_ParCodPCCODANT.Value-1;
   DM4.Tb_ParCod.Post;
   fSequenceTestaeAjusta(pvalor+'_SEQ',DM4.Tb_ParCodPCCODIGO.AsInteger);
   end;
result:=true;
end;

