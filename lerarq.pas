function fGerarEvento(pMensagem: String): boolean;
var
x_tent: integer;
mdados_eventos: tstringlist;
begin

if fileexists(mpastaaplicacao+'eventos.sge') then
   begin
    if mNomeEvento='' then
       begin
       x_tent:=0;
       While true do
          begin
          if fileexists(mpastaaplicacao+'evento'+inttostr(x_tent)+'.txt') then
             x_tent:=x_tent+1
          else
             begin
             mNomeEvento:=mpastaaplicacao+'evento'+inttostr(x_tent)+'.txt';
             break;
             end;
          end;
       showmessage('vai ter eventos nome '+mNomeEvento);    
       end;
    mdados_eventos:=tstringlist.create;
    if fileexists(mNomeEvento) then
       mdados_eventos.loadfromfile(mnomeevento);
    mdados_eventos.add(pmensagem);
    mdados_eventos.savetofile(mnomeevento);
    freeandnil(mdados_eventos);
    end;
end;


