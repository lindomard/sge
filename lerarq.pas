query_lotes.SQL.Add('SELECT P2CHAVE,P2CODEMP,P2ITEM,P2LM_CHAVE,P2LM_CODEMP,P2LM_ITEM from CADP02,CADP02_LOTES '
                   +'    WHERE P2LM_CHAVE=P2CHAVE(+) AND P2LM_CODEMP=P2CODEMP(+) '
                   +'    AND P2LM_ITEM=P2ITEM(+) '
                   +'    AND (P2LM_CHAVE IS NULL OR P2CHAVE IS NULL ) ');
try
   query_lotes.open;
except on e : exception do
   begin
   ex_erroSql_Novo(query_lotes,26062,'frm lrs'+e.Message ,'CADP02');
   result:=false;
   exit;
   end;
   end;


query_altera.close;
query_altera.SQL.Clear;
query_altera.SQL.Add('Update CADP02_LOTES set P2LM_CODEMP=(select max(P2CODEMP) from CADP02 '
                    +' where P2CHAVE=P2LM_CHAVE and P2LOTSEQ=P2LM_LOTSEQ AND P2ITEM=P2LM_ITEM )'
                    +' WHERE P2LM_CHAVE=:CHAVE and P2LM_CODEMP=:CODEMP and P2LM_ITEM=:ITEM ');


query_deleta.close;
query_deleta.SQL.Clear;
query_deleta.SQL.Add('Delete from CADP02_LOTES '
                    +' WHERE P2LM_CHAVE=:CHAVE and P2LM_CODEMP=:CODEMP and P2LM_ITEM=:ITEM ');

While not query_lotes.Eof do
   begin
   query_altera.close;
   query_altera.ParamByName('CHAVE').AsFloat   :=query_lotes.fieldbyname('P2LM_CHAVE').AsFloat;
   query_altera.ParamByName('CODEMP').AsInteger:=query_lotes.fieldbyname('P2LM_CODEMP').AsInteger;
   query_altera.ParamByName('ITEM').AsInteger  :=query_lotes.fieldbyname('P2LM_ITEM').AsInteger;
   try
      query_altera.ExecSQL;
      fdm1StartCommit;
   except
      query_deleta.Close;
      query_deleta.ParamByName('CHAVE').AsFloat   :=query_lotes.fieldbyname('P2LM_CHAVE').AsFloat;
      query_deleta.ParamByName('CODEMP').AsInteger:=query_lotes.fieldbyname('P2LM_CODEMP').AsInteger;
      query_deleta.ParamByName('ITEM').AsInteger  :=query_lotes.fieldbyname('P2LM_ITEM').AsInteger;
      try
         query_deleta.ExecSQL;
         fdm1StartCommit;
      except on e : exception do
         begin
         ex_erroSql_Novo(query_deleta,5958,'frm lrs'+e.Message ,'CADEST');
         result:=false;
         exit;
         end;
         end;
      end;
  query_lotes.Next;
  end;


query_altera.close;
query_deleta.close;
query_lotes.close;


end;

function fBuscarTipoPreco(pTpPreco: Integer; pIcmsST: Boolean): String;
var
mDados_Valor: String;
begin
mDados_Valor:='';
if pTpPreco=0 then //00-Atual-Preço 01 Tabela de Produto
   mdados_valor:='PDPRECO1*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=1 then //01-Atual-Preço 02 Tabela de Produto
   mdados_valor:='PDPRECO2*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=2 then //02-Atual-Preço 03 Tabela de Produto
   mdados_valor:='PDPRECO3*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=3 then //03-Atual-Preço de Custo
   mdados_valor:='PDPRECOC*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=4 then //04-Atual-Preço Maximo 01 Tabela de Produto
   mdados_valor:='PDPMC*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=5 then //05-Atual-Preço Maximo 02 Tabela de Produto
   mdados_valor:='PDPMC02*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=6 then //06-Atual-Preço Maximo 03 Tabela de Produto
   mdados_valor:='PDPMC03*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=7 then //07-Atual-Preço Medio de Custo Tabela de Produto
   mdados_valor:='PDPCOMC*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=8 then //08-Atual-Ultimo Preço de Compra Tabela de Produto
   mdados_valor:='PDUCPR*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=9 then //09-Hora do Pedido-Preço da Forma de Pagamento
   mdados_valor:='P2PCOFPG*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=10 then //10-Hora do Pedido-Preço da Tabela
   mdados_valor:='P2PCOTAB*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=11 then //11-Hora do Pedido-Preço de Custo
   mdados_valor:='P2PCOCUS*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=12 then //12-Hora do Pedido-Preço Maximo
   mdados_valor:='P2PCOMAX*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)'
else if pTpPreco=12 then //13-Hora do Pedido-Ultimo Preço de Compra
   mdados_valor:='P2UCPR*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD)';
if mDados_Valor='' then
   begin
   if  pIcmsST then
        mdados_valor:='(DECODE(P1TIPO_ENTSAI,1,P2TOTLIQ*-1,P2TOTLIQ)+P2ICMSR)'
//        mdados_valor:='((P2PRECO*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD))+P2ICMSR)-P2TOTDES'
   else
       begin
       mdados_valor:='(DECODE(P1TIPO_ENTSAI,1,P2TOTLIQ*-1,P2TOTLIQ))';
//       mdados_valor:='(P2PRECO*DECODE(P1TIPO_ENTSAI,1,P2QTD*-1,P2QTD))-P2TOTDES';
       end
   end
else
   mdados_valor:='('+mdados_valor+')'+'-P2TOTDES';

Result:='sum(CASE WHEN P1TRUNCARREND=1 THEN TRUNC(('+mDados_Valor+'),2) ELSE ROUND(('+mDados_Valor+'),2) end)  ';

end;


