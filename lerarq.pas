function fAbaterPositivoOndeNegativo(pCodpro:real): boolean;

var
mQtdFalta,mQtdProc:Real;
query1: tQuery;
query2: tQuery;
query3: tQuery;
form_agde: tFrm_Agde;
begin
result:=true;

if fmensagem('Quer Realmente Abater os Lotes Negativos onde a Positivos? '
               ,0,['1','2'],1)<>mryes then
   begin
   exit;
   end;
query1:=tQuery.Create(nil);
query1.DatabaseName:='SG_ASSOC';
query2:=tQuery.Create(nil);
query2.DatabaseName:='SG_ASSOC';
query3:=tQuery.Create(nil);
query3.DatabaseName:='SG_ASSOC';

Application.CreateForm(Tfrm_agde,form_agde);
form_agde.Label1.Caption:='Fazendo Abatimentos dos Produtos Negativos Aguarde...';
form_agde.gb_progres.Visible:=true;
form_agde.Show;
Frm_Stru.Update;


Query2.Close;
Query3.SQL.Clear;
Query3.SQL.Add('Select CLCODEMP,CLCODPRO,CLNUMERO,CLQTD,CLFILIAL FROM '
                  +' CADLGC where CLQTD<0 ');
if pcodpro<>0 then
   begin
   Query3.SQL.add(' and CLCODPRO=:CODPRO ');
   Query3.ParamByName('CODPRO').Value:=pcodpro;
   end;
Query3.Open;
mplid:=0;
mpqtd:=Query3.RecordCount;
While not Query3.Eof do
   begin
   mplid:=mplid+1;
   form_agde.Gauge1.Progress:=mpqtd*100 div mplid;
   form_agde.Update;
   Query2.Close;
   Query2.SQL.Clear;
   Query2.SQL.Add('Select CLCODEMP,CLCODPRO,CLNUMERO,CLFILIAL,CLQTD FROM '
                     +' CADLGC where CLQTD>0 '
                     +' and CLCODPRO=:CODPRO '
                     +' and CLCODEMP=:CODEMP '
                     +' and CLFILIAL=:FILIAL '
                     +' order by CLQTD desc ');
   Query2.ParamByName('CODEMP').AsFloat:=Query3.fieldbyName('CLCODEMP').AsFloat;
   Query2.ParamByName('CODPRO').AsFloat:=Query3.fieldbyName('CLCODPRO').AsFloat;
   Query2.ParamByName('FILIAL').AsFloat:=Query3.fieldbyName('CLFILIAL').AsFloat;
   try
      Query2.open;
   except
      exit;
      end;
   mQtdFalta:=Query3.FieldbyName('CLQTD').asfloat*-1;


   While (not Query2.Eof) and (mqtdFalta>0) do
      begin
      if mQtdFalta>=Query2.fieldbyName('CLQTD').AsFloat then
         mQtdProc:=Query2.fieldbyName('CLQTD').AsFloat
      else
         mQtdProc:=mQtdFalta;
      Query1.Close;
      Query1.SQL.Clear;
      Query1.SQL.Add('Update CADLGC set CLQTD=CLQTD-:QTD_ABAT, '
                        +' CLQTD_PRAT=CLQTD_PRAT-:QTD_ABAT '
                        +' where CLQTD=:QTD '
                     +' and CLCODPRO=:CODPRO '
                     +' and CLCODEMP=:CODEMP '
                     +' and ( CLFILIAL=:FILIAL or CLFILIAL is null ) ');

      if Query2.FieldByName('CLNUMERO').IsNull then
         Query1.SQL.Add(' and CLNUMERO is null')
      else
         begin
         Query1.SQL.Add(' and CLNUMERO=:NUMERO ');
         Query1.ParamByName('NUMERO').AsString:=Query2.fieldbyName('CLNUMERO').AsString;
         end;
      Query1.ParamByName('QTD_ABAT').AsFloat:=mQtdProc;
      Query1.ParamByName('QTD').AsFloat     :=Query2.fieldbyName('CLQTD').AsFloat;
      Query1.ParamByName('CODPRO').AsFloat  :=Query2.fieldbyName('CLCODPRO').AsFloat;
      Query1.ParamByName('CODEMP').AsFloat  :=Query2.fieldbyName('CLCODEMP').AsFloat;
      Query1.ParamByName('FILIAL').Value    :=Query2.fieldbyName('CLFILIAL').AsInteger;
      try
         Query1.ExecSQL;
         fdm1StartCommit;
      except
         ex_erroSql_Novo(Query1,86141,'frm_stru','CADLGC');
         end;
      mQtdFalta:=mQtdFalta-mQtdProc;
      Query2.Next;
      end;

   mQtdProc:=(Query3.FieldbyName('CLQTD').asfloat*-1)-mQtdFalta;
   Query1.Close;
   Query1.SQL.Clear;
   Query1.SQL.Add('Update CADLGC set CLQTD=CLQTD+:QTD_ABAT, '
                     +' CLQTD_PRAT=CLQTD_PRAT+:QTD_ABAT '
                     +' where CLQTD=:QTD '
                  +' and CLCODPRO=:CODPRO '
                  +' and CLCODEMP=:CODEMP '
                  +' and ( CLFILIAL=:FILIAL or CLFILIAL is null ) ');
   if Query3.FieldByName('CLNUMERO').IsNull then
      Query1.SQL.Add(' and CLNUMERO is null')
   else
      begin
      Query1.SQL.Add(' and CLNUMERO=:NUMERO ');
      Query1.ParamByName('NUMERO').AsString:=Query3.fieldbyName('CLNUMERO').AsString;
      end;
   Query1.ParamByName('QTD_ABAT').AsFloat:=mQtdProc;
   Query1.ParamByName('QTD').AsFloat     :=Query3.fieldbyName('CLQTD').AsFloat;
   Query1.ParamByName('CODPRO').AsFloat  :=Query3.fieldbyName('CLCODPRO').AsFloat;
   Query1.ParamByName('CODEMP').AsFloat  :=Query3.fieldbyName('CLCODEMP').AsFloat;
   Query1.ParamByName('FILIAL').Value    :=Query3.fieldbyName('CLFILIAL').AsFloat;
   try
      Query1.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql_Novo(Query1,86141,'frm_stru','CADLGC');
      end;
   Query3.Next;
   end;
Query1.close;
Query1.SQL.Clear;
Query1.SQL.add('delete from CADLGC WHERE CLQTD=0');
try
   Query1.ExecSQL;
   fdm1StartCommit;
except
   ex_erroSql_Novo(Query1,86155,'frm_stru','CADLGC');
   end;
query2.close;
query2.SQL.clear;
query2.SQL.Add('select CLCODPRO,CLNUMERO,CLFILIAL '
              +', min(CLCODEMP) as CLCODEMP '
              +',max(CLDTVCTO) as CLDTVCTO '
              +',sum(CLQTD) as CLQTD '
              +',sum(CLQTDR) as CLQTDR '
              +',sum(CLQTDC) as CLQTDC '
              +',sum(CLQTDT) as CLQTDT '
              +',sum(CLQTD_PRAT) as CLQTD_PRAT '
              +',sum(CLQTD_DEP) as CLQTD_DEP '
              +',sum(CLQTD_REP) as CLQTD_REP '
              +',max(CLPRECO1) as CLPRECO1 '
              +',max(CLPRECO2) as CLPRECO2 '
              +',max(CLPRECO3) as CLPRECO3 '
              +',max(CLPRECOA1) as CLPRECOA1 '
              +',max(CLPRECOA2) as CLPRECOA2 '
              +',max(CLPRECOA3) as CLPRECOA3 '
              +',max(CLPRECOA3) as CLPRECOA3 '
              +',max(CLPCUSTO) as CLPCUSTO '
              +',max(CLESTMAX) as CLESTMAX '
              +',max(CLESTMIN) as CLESTMIN '
              +',max(CLDTUATP1) as CLDTUATP1 '
              +',max(CLDTUATP2) as CLDTUATP2 '
              +',max(CLDTUATP3) as CLDTUATP3 '
              +',max(CLDTENTRADA) as CLDTENTRADA '
              +',max(CLLOTE_RE) as CLLOTE_RE '
              +'FROM CADLGC '
              +'group by clcodpro,clnumero,CLFILIAL having count(*)>1 ');
query2.open;
While not Query2.Eof do
   begin
   query1.close;
   query1.SQL.clear;
   query1.SQL.Add('Delete from CADLGC where '
                 +' CLCODPRO=:CODPRO '
                 +' and (CLNUMERO=:NUMERO ');
   if query2.fieldbyName('CLNUMERO').AsString='' then
      query1.SQL.Add(' or CLNUMERO is null )')
   else
      query1.SQL.Add(' )');
   query1.SQL.Add(' and (CLFILIAL=:FILIAL or CLFILIAL is null )');
   query1.parambyName('CODPRO').asfloat:=Query2.FieldbyName('CLCODPRO').Asfloat;
   query1.parambyName('NUMERO').Value  :=Query2.FieldbyName('CLNUMERO').AsString;
   query1.parambyName('FILIAL').Value  :=Query2.FieldbyName('CLFILIAL').AsInteger;
   try
      query1.execsql;
      fdm1StartCommit;
   except
      ex_erroSql_Novo(Query1,97440,'frm_stru','CADLGC');
      end;

   query1.close;
   query1.SQL.clear;
   query1.SQL.Add('Insert into CADLGC ( '
                 +'CLCODEMP '
                 +',CLFILIAL '
                 +',CLCODPRO '
                 +',CLDTVCTO  '
                 +',CLNUMERO  '
                 +',CLQTD '
                 +',CLQTDR '
                 +',CLQTDC '
                 +',CLPRECO1'
                 +',CLPRECO2'
                 +',CLPRECO3'
                 +',CLPRECOA1'
                 +',CLPRECOA2'
                 +',CLPRECOA3 '
                 +', CLPCUSTO '
                 +',CLESTMAX '
                 +',CLESTMIN '
                 +',CLDTUATP1 '
                 +',CLDTUATP2 '
                 +',CLDTUATP3 '
                 +',CLQTDT '
                 +',CLQTD_PRAT '
                 +',CLQTD_DEP '
                 +',CLQTD_REP '
                 +',CLDTENTRADA '
                 +',CLLOTE_RE '
                 +') values ('
                 +':CLCODEMP '
                 +',:CLFILIAL '
                 +',:CLCODPRO '
                 +',:CLDTVCTO  '
                 +',:CLNUMERO  '
                 +',:CLQTD '
                 +',:CLQTDR '
                 +',:CLQTDC '
                 +',:CLPRECO1'
                 +',:CLPRECO2'
                 +',:CLPRECO3'
                 +',:CLPRECOA1'
                 +',:CLPRECOA2'
                 +',:CLPRECOA3 '
                 +',:CLPCUSTO '
                 +',:CLESTMAX '
                 +',:CLESTMIN '
                 +',:CLDTUATP1 '
                 +',:CLDTUATP2 '
                 +',:CLDTUATP3 '
                 +',:CLQTDT '
                 +',:CLQTD_PRAT '
                 +',:CLQTD_DEP '
                 +',:CLQTD_REP '
                 +',:CLDTENTRADA '
                 +',:CLLOTE_RE '
                 +')');

   Query1.ParamByName('CLCODEMP').Value   :=query2.FieldbyName('CLCODEMP').AsInteger;
   Query1.ParamByName('CLFILIAL').Value   :=query2.FieldbyName('CLFILIAL').AsFloat;
   Query1.ParamByName('CLCODPRO').Value   :=query2.FieldbyName('CLCODPRO').AsFloat;
   Query1.ParamByName('CLDTVCTO').Value   :=query2.FieldbyName('CLDTVCTO').AsDateTime;
   Query1.ParamByName('CLNUMERO').Value   :=query2.FieldbyName('CLNUMERO').AsString;
   Query1.ParamByName('CLQTD').Value      :=query2.FieldbyName('CLQTD').AsFloat;
   Query1.ParamByName('CLQTDR').Value     :=query2.FieldbyName('CLQTDR').AsFloat;
   Query1.ParamByName('CLQTDC').Value     :=query2.FieldbyName('CLQTDC').AsFloat;
   Query1.ParamByName('CLPRECO1').Value   :=query2.FieldbyName('CLPRECO1').AsFloat;
   Query1.ParamByName('CLPRECO2').Value   :=query2.FieldbyName('CLPRECO2').AsFloat;
   Query1.ParamByName('CLPRECO3').Value   :=query2.FieldbyName('CLPRECO3').AsFloat;
   Query1.ParamByName('CLPRECOA1').Value  :=query2.FieldbyName('CLPRECOA1').AsFloat;
   Query1.ParamByName('CLPRECOA2').Value  :=query2.FieldbyName('CLPRECOA2').AsFloat;
   Query1.ParamByName('CLPRECOA3').Value  :=query2.FieldbyName('CLPRECOA3').AsFloat;
   Query1.ParamByName('CLPCUSTO').Value   :=query2.FieldbyName('CLPCUSTO').AsFloat;
   Query1.ParamByName('CLESTMAX').Value   :=query2.FieldbyName('CLESTMAX').AsFloat;
   Query1.ParamByName('CLESTMIN').Value   :=query2.FieldbyName('CLESTMIN').AsFloat;
   Query1.ParamByName('CLDTUATP1').Value  :=query2.FieldbyName('CLDTUATP1').AsDateTime;
   Query1.ParamByName('CLDTUATP2').Value  :=query2.FieldbyName('CLDTUATP2').AsDateTime;
   Query1.ParamByName('CLDTUATP3').Value  :=query2.FieldbyName('CLDTUATP3').AsDateTime;
   Query1.ParamByName('CLQTDT').Value     :=query2.FieldbyName('CLQTDT').AsFloat;
   Query1.ParamByName('CLQTD_PRAT').Value :=query2.FieldbyName('CLQTD_PRAT').AsFloat;
   Query1.ParamByName('CLQTD_DEP').Value  :=query2.FieldbyName('CLQTD_DEP').AsFloat;
   Query1.ParamByName('CLQTD_REP').Value  :=query2.FieldbyName('CLQTD_REP').AsFloat;
   Query1.ParamByName('CLDTENTRADA').Value:=query2.FieldbyName('CLDTENTRADA').AsDateTime;
   Query1.ParamByName('CLLOTE_RE').Value  :=query2.FieldbyName('CLLOTE_RE').AsString;

   try
      query1.execsql;
      fdm1StartCommit;
   except
      ex_erroSql_Novo(Query1,97440,'frm_stru','CADLGC');
