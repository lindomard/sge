                    +' where ( (substr(P2SIT,2,2) IN ('+QuotedStr('10')+','+QuotedStr('30')+','+QuotedStr('60')+','+QuotedStr('70')+')) '
                    +' or P2ICMSR<>0) and p2chave=:chave '
                    +' and p2lotseq=:lotseq  '
                    +' and p2ordem=:ordem '
                    +' and p2codemp=:codemp ');
query_AtuNcm.ParamByName('chave').AsInteger:=pChavePed;
query_AtuNcm.ParamByName('lotseq').AsInteger:=pLotseq;
query_AtuNcm.ParamByName('ordem').AsInteger:=pOrdem;
query_AtuNcm.ParamByName('codemp').AsInteger:=pCodemp;
try
   query_AtuNcm.ExecSQL;
   fdm1StartCommit;
except on e : exception do
   ex_erroSql_Novo(query_AtuNcm,28380,'func Erro:'+e.Message ,'CADP02');
   end;
result:=true;

end;




