function fAjustarCabecalhodoPedidoDiferentedosItens(pDatIni,pDatFin: tDatetime; pSoTotais: Boolean): boolean;

var
query_exe: TQuery;
begin
query_exe:=TQuery.create(nil);

query_exe.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
if psoTotais=false then
   begin
   query_exe.close;
   query_exe.sql.clear;
   query_exe.sql.add('delete from cadp01 where p1codemp<=0 ');
   try
      query_exe.ExecSQL;
      fdm1StartCommit;
   except on e : exception do
      ex_erroSql_Novo(query_exe,32529,'SGE '+e.Message ,'CADP01');
      end;
   end;

{
query_exe.close;
query_exe.sql.clear;
query_exe.sql.add('update cadp01 set p1totall=(select round(sum(P2TOTLIQ),2) from CADP02 WHERE P2CHAVE=P1CHAVE '
                 +' AND P2LOTSEQ=P1LOTSEQ AND P2CODEMP=P1CODEMP) '
                 +' WHERE exists ( '
                 +' select sum(p2totliq) as totalped02,p1totall '
                 +' ,p1chave,p1codemp,p1datap '
                 +' ,max(p1status) as status '
                 +' ,max(p1nfce_numero) as numnfce '
                 +' ,max(p1nfce_serie) as serie_nfce '
                 +' ,max(p1numnf) as numnf '
                 +' ,max(p1numcf) as numcf '
                 +',max(p1serie) as serienfce '
                 +' from cadp02 '
                 +'where p2chave=p1chave '
                 +'and p2codemp=p1codemp '
                 +'and p2lotseq=p1lotseq  ');
if pDatIni>pdatanula then
  query_exe.SQL.add( fFormatdatetimeParaConsulta(' P1DATAP ',true, pDatIni ) );

Query_exe.SQL.add( '  '
                +' group by p1totall '
                +' ,p1chave,p1codemp,p1datap '
                +' having (round( sum(p2totliq),2)<>round(p1totall,2)) '
                +' ) ');
try
   query_exe.ExecSQL;
   fdm1StartCommit;
except on e : exception do
   ex_erroSql_Novo(query_exe,32547,'SGE '+e.Message ,'CADP01');
   end;
}


query_exe.close;
query_exe.sql.clear;
query_exe.sql.Add('MERGE INTO CADP01 t1 '
                 +'  USING ( '
                 +'   select sum(p2totliq) as totalped02,p1totall '
                 +' ,p1chave,p1codemp,p1lotseq,p1datap '
                 +' ,max(p1status) as status '
                 +' ,max(p1nfce_numero) as numnfce '
                 +' ,max(p1nfce_serie) as serie_nfce '
                 +' ,max(p1numnf) as numnf '
                 +' ,max(p1numcf) as numcf '
                 +',max(p1serie) as serienfce '
                 +' from cadp01,cadp02 '
                 +' where p2chave=p1chave '
                 +' and p2codemp=p1codemp '
                 +' and p2lotseq=p1lotseq ');
if pDatIni>pdatanula then
  query_exe.SQL.add( fFormatdatetimeParaConsulta(' P1DATAP ',true, pDatIni ) );
if pDatFin>pdatanula then
  query_exe.SQL.add( fFormatdatetimeParaConsulta(' P1DATAP ',false, pDatFin ) );
query_exe.SQL.add(' and p1status<7 '
                 +' group by p1totall,p1chave,p1codemp,p1lotseq,p1datap '
                 +' having (round( sum(p2totliq),2)<>round(p1totall,2))  ) ss '
                 +'   ON (t1.p1codemp= ss.p1codemp '
                 +'   and t1.p1lotseq= ss.p1lotseq '
                 +'   and t1.p1chave= ss.p1chave) '
                 +'   WHEN MATCHED THEN '
                 +'   UPDATE SET t1.P1TOTALL = ss.totalped02 ');
try
   query_exe.ExecSQL;
   fdm1StartCommit;
except on e : exception do
   ex_erroSql_Novo(query_exe,32643,'SGE '+e.Message ,'CADP01');
   end;




if psoTotais=false then
   begin
   query_exe.close;
   query_exe.sql.clear;
   query_exe.sql.add('Delete from cadp01 '
                    +' where not exists '
                    +' (select p2chave from cadp02 '
                    +' where p2chave=p1chave '
                    +' and p2lotseq=p1lotseq '
                    +' and p2codemp=p1codemp ) ');
   try
      query_exe.ExecSQL;
      fdm1StartCommit;
   except on e : exception do
      ex_erroSql_Novo(query_exe,32566,'SGE '+e.Message ,'CADP01');
      end;

   query_exe.close;
   query_exe.sql.clear;
   query_exe.sql.add('Delete from cadp02 '
                    +' where not exists '
                    +' (select p1chave from cadp01 '
                    +' where p1chave=p2chave '
                    +' and p1lotseq=p2lotseq '
                    +' and p1codemp=p2codemp ) ');
   try
      query_exe.ExecSQL;
      fdm1StartCommit;
   except on e : exception do
      ex_erroSql_Novo(query_exe,32566,'SGE '+e.Message ,'CADP01');
      end;
   end;   



query_exe.Close;
freeandnil(query_exe);




end;



function fExistemOutraComissaodeVendas(pChave,pChave_ano,pCodemp,pChaveComis,pCodven: Integer): boolean;
var
query_exe: TQuery;
begin
query_exe:=TQuery.create(nil);
query_exe.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_exe.sql.clear;
query_exe.sql.Add('Select CL2CHAVE, '
                    +'  case when CL1TIPO=0 then '+QuotedStr('Recebimento Vendedor')
                    +'            when CL1TIPO=1 then '+QuotedStr('Recebimdnto Supervisor')
                    +'            when CL1TIPO=2 then '+QuotedStr('Recebimento Televendas')
                    +'            when CL1TIPO=4 then '+QuotedStr('Recebimento Vendedor/Produtos')
                    +'            when CL1TIPO=5 then '+QuotedStr('Vendas Vendedor')
                    +'            when CL1TIPO=6 then '+QuotedStr('Vendas Supervisor')
                    +'            when CL1TIPO=7 then '+QuotedStr('Vendas Televendas')
                    +'            when CL1TIPO=9 then '+QuotedStr('Vendas Vendedor/Produtos')
                    +'            else '+QuotedStr('desconhecido')+' end as tipocom '

                 +' FROM CADCL02,CADCL01 '
                 +'            WHERE CL1CODEMP=CL2CODEMP '
                 +'            AND nvl(CL1LOTSEQ,0)=nvl(CL2LOTSEQ ,0)'
                 +'      AND CL1CHAVE=CL2CHAVE '
                 +'      AND CL2CODEMPD=:CODEMP  '
                 +'      AND nvl(CL2LOTSEQ,0)=:LOTSEQ '
                 +'      AND CL2CHAVEP=:CHAVE '
                 +'      AND CL1CODIGO=:CODVEN '
                 +' and CL2CHAVE<>:CHAVECOMIS');

query_exe.ParamByName('CODEMP').AsInteger := pCodemp;
query_exe.ParamByName('CHAVE').AsInteger := pChave;
query_exe.ParamByName('LOTSEQ').AsInteger := pChave_ano;
query_exe.ParamByName('CHAVECOMIS').AsInteger := pChaveComis;
query_exe.ParamByName('CODVEN').AsInteger := pCodven;

if fileExists('C:\SGE\SERVIDORLDC.TXT') then
   ex_erroSql_Novo(query_exe,32663,'SGE ' ,'CADP02');


try
   query_exe.Open;
except on e : exception do
   ex_erroSql_Novo(query_exe,32663,'SGE '+e.Message ,'CADP02');
   end;
result:=false;

if query_exe.IsEmpty=false then
   begin
   MessageDlg('Comissão Paga '+query_exe.fieldbyname('tipocom').asstring + ' Lote ' +query_exe.fieldbyname('CL2CHAVE').AsString,mtWarning,[mbOk],0);
   result:=true;
   exit;
   end;

query_exe.Close;
freeandnil(query_exe);

end;







