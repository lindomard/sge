function fSequenceTestaeAjusta(pNomeSeq: String; pValor: Integer): Boolean;
var
mErro: Boolean;
query_testa: TQuery;
query_executa: TQuery;
mIncrem: Integer;
mValorAtual: Integer;
begin
mErro:=false;
query_testa:=TQuery.Create(nil);
query_executa:=TQuery.Create(nil);

query_testa.DatabaseName:='SG_ASSOC';
query_executa.DatabaseName:='SG_ASSOC';
query_testa.Close;
query_testa.SQL.clear;
query_testa.SQL.Add('select count(*) from user_objects where object_type='+QuotedStr('SEQUENCE')
                   +' and OBJECT_NAME=:NOME ');
query_testa.ParamByName('NOME').AsString:=pNomeSeq;
try
   query_testa.Open;
except
   mErro:=true;
   end;
if query_testa.Fields[0].AsInteger<1 then
   begin
   query_executa.Close;
   query_executa.SQL.Clear;
   if pValor<1 then
      pValor:=1;
   query_executa.SQL.Add('create sequence '+pNomeSeq+' start with '+IntTostr(pValor)+' increment by 1 nocache');
   try
      query_executa.ExecSQL;
   except
      mErro:=true;
      end;
   end
else
   begin
   mValorAtual:=fSequenceCorrenteValor(pNomeSeq);
   if not mErro then
      begin
      if mValorAtual<> pValor then
         begin
         query_executa.Close;
         query_executa.SQL.Clear;
         query_executa.SQL.Add('DROP SEQUENCE '+pNomeSeq);
         try
            query_executa.ExecSQL;
         except
            mErro:=true;
            end;

         query_executa.Close;
         query_executa.SQL.Clear;
         if pValor<1 then
            pValor:=1;
         query_executa.SQL.Add('create sequence '+pNomeSeq+' start with '+IntTostr(pValor)+' increment by 1 nocache');
         try
            query_executa.ExecSQL;
         except
            mErro:=true;
            end;
         end;
      end;
   end;
freeandnil(query_executa);
freeandnil(query_testa);
result:=mErro;

end;
function fSequenceCorrenteValor(pNomeSeq: String): Integer;
var
query_executa: TQuery;

begin
query_executa:=TQuery.Create(nil);
query_executa.DatabaseName:='SG_ASSOC';



query_executa.Close;
query_executa.SQL.Clear;
query_executa.SQL.Add('SELECT LAST_NUMBER FROM USER_SEQUENCES WHERE SEQUENCE_NAME=:NOMESEQ');
query_executa.ParamByName('NOMESEQ').AsString:=pNomeSeq;
try
   query_executa.Open;
except
   end;
if query_executa.IsEmpty then
   result:=1
else
   result:=query_executa.fields[0].Asinteger;
freeandnil(query_executa);
end;

