mSeparador: String;
mPosIni,mPosFin: Integer;
mResultado: String;
mEncontrou: Boolean;
begin
mResultado:='';
mSeparador:='.';
mPar:=0;
mTam:=length(pTexto);

mQtdCampos:=0;
mEncontrou:=false;
for x:=1 to mtam do
   begin
   if (mpar=0) then
      begin
      if (x=1) or (pTexto[x-1]=mSeparador) then
         begin
         mPosIni:=x;
         mpar:=mpar+1;
         if (x=mtam) then
            begin
            mpar:=mpar+1;
            mPosFin:=x
            end;
         end;
      end
   else if mpar=1 then
      begin
      if (x=mtam) or (pTexto[x]=mSeparador) then
         begin
         mpar:=mpar+1;
         if x=mtam then
            mPosFin:=x
         else
            mPosFin:=x-1
         end;
      end;
   if mpar=2 then
      begin
      if pValor=copy(pTexto,mposini,(mposfin-mPosIni)+1) then
         begin
         mEncontrou:=true;
         if ptipo=0 then
            begin
            if trim(mResultado)<>'' then
               mResultado:=mResultado+'.';
            mResultado:=mResultado+copy(pTexto,mposini,(mposfin-mPosIni)+1);
            end
         end
      else
         begin
         if trim(mResultado)<>'' then
            mResultado:=mResultado+'.';
         mResultado:=mResultado+copy(pTexto,mposini,(mposfin-mPosIni)+1);
         end;
      mpar:=0;
      end;
   end;
if mpar=1 then
   begin
   mpar:=0;
   if mposini>mtam then
      mposini:=mtam;
   mposfin:=mtam;
   if pValor=copy(pTexto,mposini,(mposfin-mPosIni)+1) then
      begin
      mEncontrou:=true;
      if ptipo=0 then
         begin
         if trim(mResultado)<>'' then
            mResultado:=mResultado+'.';
         mResultado:=mResultado+copy(pTexto,mposini,(mposfin-mPosIni)+1);
         end
      end
   else
      begin
      if trim(mResultado)<>'' then
         mResultado:=mResultado+'.';
      mResultado:=mResultado+copy(pTexto,mposini,(mposfin-mPosIni)+1);
      end;
   mpar:=0;
   end;
if (ptipo=2) then
    begin
    if mEncontrou then
       mresultado:='-1'
    else
       mresultado:=''
    end
else if (ptipo=0) and (not mEncontrou) then
   begin
   if Trim(pTexto)<>'' then
      pTexto:=pTexto+'.';
   mResultado:=pTexto+pValor;
   end;
result:=mResultado;
end;

