function fCadEle_Atualizada(pItemExcluido: Boolean; pTabela,pcodigo: String): boolean;
var
query_ele: tQuery;
begin
query_ele:=tQuery.Create(nil);
query_ele.DatabaseName:='SG_ASSOC';

query_ele.Close;
query_ele.SQL.clear;


if pItemExcluido=false then
   begin
   query_ele.SQL.Add('Delete from CADELE_EXCLUIDO where PE_TABELA=:TABELA and PE_CODIGO=:CODIGO ');
   query_ele.ParamByName('TABELA').AsString:=pTabela;
   query_ele.ParamByName('CODIGO').AsString:=pcodigo;
   try
      query_ele.ExecSQL;
      fdm1StartCommit;
      result:=true;
   except
      result:=false;
      end;
   end
else
   begin
   query_ele.SQL.Add('select count(*) from CADELE_EXCLUIDO where PE_TABELA=:TABELA and PE_CODIGO=:CODIGO ');
   query_ele.ParamByName('TABELA').AsString:=pTabela;
   query_ele.ParamByName('CODIGO').AsString:=pcodigo;
   try
      query_ele.Open;
   except
      result:=false;
      freeandnil(query_ele);
      exit;
      end;
   if query_ele.Fields[0].AsInteger>0 then
      begin
      query_ele.Close;
      query_ele.SQL.clear;
      query_ele.SQL.Add('Update CADELE_EXCLUIDO set PE_DATHOR_EVE=SYSDATE where PE_TABELA=:TABELA and PE_CODIGO=:CODIGO ');
      query_ele.ParamByName('TABELA').AsString:=pTabela;
      query_ele.ParamByName('CODIGO').AsString:=pcodigo;
      try
         query_ele.ExecSQL;
         fdm1StartCommit;
         result:=true;
      except
         result:=false;
         end;
      end
   else
      begin
      query_ele.Close;
      query_ele.SQL.clear;
      query_ele.SQL.Add('insert into CADELE_EXCLUIDO ('
                       +'PE_TABELA'
                       +',PE_CODIGO '
                       +',PE_DATHOR_EVE '
                       +') values ('
                       +':TABELA'
                       +',:CODIGO '
                       +',SYSDATE '
                       +')');
      query_ele.ParamByName('TABELA').AsString:=pTabela;
      query_ele.ParamByName('CODIGO').AsString:=pcodigo;
      try
         query_ele.ExecSQL;
         fdm1StartCommit;
         result:=true;
      except
         result:=false;
         end;
      end;
   end;
end;

