function fProcNomeEmail(pTipo: Integer;pExtensao:String): String;
var
mPasta: String;
mtabtemp: String;
x: Integer;
begin
x:=0;
mPasta:='\SGE';
if not DirectoryExists(mPasta) then
   CreateDir(mPasta);
While true do
   begin
   if ptipo=20 then
      mtabtemp:=mPasta+'\TMPO'+Formatfloat('00000',x)
   else if ptipo=21 then
      mtabtemp:=mPasta+'\TEM'+Formatfloat('00000',x)
   else if ptipo=22 then
      mtabtemp:=mPasta+'\TEMPOR'+Formatfloat('00000',x)
   else if ptipo=23 then
      mtabtemp:=mPasta+'\TTT'+Formatfloat('00000',x)
   else
      mtabtemp:=mPasta+'\PED'+Formatfloat('00000',x);
   if pExtensao<>'' then
      mtabtemp:=mtabtemp+'.'+pExtensao;
   mtabtemp:=mtabtemp;
   if FileExists(mtabtemp) then
      x:=x+1
   else
      break;
   end;

result:=mtabtemp;
end;



function fProcTemp(pTipo: Integer): String;
var
mPasta: String;
mtabtemp: String;
x: Integer;
begin
x:=0;
if pbanco=3 then
   begin
//   mPasta:=IncludeTrailingPathDelimiter(ExtractFilePath(Application.ExeName))+'TEMP';
   mPasta:='\SGE\TEMP';
   if not DirectoryExists(mPasta) then
      CreateDir(mPasta);
   end;
if ptipo<10 then
   begin
   While true do
      begin
      if ptipo=0 then
         mtabtemp:='TMPO'+Formatfloat('00000',x)
      else if ptipo=1 then
         mtabtemp:='TEM'+Formatfloat('00000',x)
      else if ptipo=2 then
         mtabtemp:='TEMPOR'+Formatfloat('00000',x)
      else if ptipo=3 then
         mtabtemp:='TTT'+Formatfloat('00000',x);
      DM1.Query1.close;
      DM1.Query1.SQL.clear;
      if (pbanco=1) or (pbanco=2) then
         begin
         DM1.Query1.SQL.Add('SELECT count(*) FROM RDB$USER_PRIVILEGES '
                           +' where RDB$RELATION_NAME='+chr(39)+mtabtemp+chr(39));
         DM1.Query1.Open;
         if DM1.Query1.Fields[0].AsInteger>0 then
            x:=x+1
         else
            break;
         end
      else if pbanco=0 then
         begin
         DM1.Query1.SQL.Add('SELECT count(*) FROM user_objects '
                           +' where object_name='+chr(39)+mtabtemp+chr(39));
//                           +' where object_type='+chr(39)+'TABLE'+chr(39)
//                           +' and object_name='+chr(39)+mtabtemp+chr(39));

         DM1.Query1.Open;
         if DM1.Query1.Fields[0].AsInteger>0 then
            x:=x+1
         else
            break;
         end
      else if pbanco=3 then
         begin
         if FileExists(mtabtemp+'.DB') then
            x:=x+1
         else
            break;
         end
      end;
   end
