function flCadSGPro(ptipo,pcodemp: Integer; pCodpro,pCodGru: String): Boolean;
begin
DM2.Tb_SGPro.Close;
DM2.Tb_SGPro.Sql.Clear;
DM2.Tb_SGPro.Sql.Add('Select SGPCODEMP,SGPCODPRO,SGPCODGRU,TNOME '
                     +' from CADSGPRO,CADTP where ');
if pcodemp=0 then
   pcodemp:=codemp;
DM2.Tb_SGPro.Sql.add(fla_EmpBaixaAlta(0,'CADPRO','',pcodemp,'SGPCODEMP',' and '));
if trim(pCodpro)<>'' then
   DM2.Tb_SGPro.SQL.add(' SGPCODPRO=0'+pCodpro+' and ');
if trim(pCodGru)<>'' then
   DM2.Tb_SGPro.SQL.add(' SGPCODGRU=0'+pCodGru+' and ');
if not DM1.Qr_TID.Locate('TINOME','CADPRO',[]) then
   DM2.Tb_SGPro.SQL.add(' TCODEMP=SGPCODEMP and ');
DM2.Tb_SGPro.sql.Add(' TCODTIP=SGPCODGRU ');
DM2.Tb_SGPro.SQL.add(' Order by TNOME ');
DM2.Tb_SGPro.Open;

if DM2.Tb_SGPro.Eof then
   result:=false
else
   result:=true;
end;
