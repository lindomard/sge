                           +' where P1CODEMP=0'+IntToStr(pDadosPedido.pCodEmp)
                           +' and P1LOTSEQ=0'+IntToStr(pDadosPedido.pLotSeq)
                           +' and P1CHAVE=0'+IntToStr(pDadosPedido.pChave)
                           +' and P1ORDEM=0'+IntToStr(pDadosPedido.pOrdem)
                           +' and P1STATUS=0'+IntToStr(pDadosPedido.pStatus_Nov)
                           );
            Try
               query_fecped.ExecSQL;
               fdm1StartCommit;
            except
               end;
            end;
         end;
         end;
      end;
      end;
   query_fecped.Close;
   end;

freeandnil(query_fecped);
end;



