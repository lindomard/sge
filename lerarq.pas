function fbuscaeSetarCodigos(pChave: String): Integer;
var
mQuery1:  TQuery;
mQuery2: TQuery;
mFiltro: String;
begin
while true do
   begin
   mQuery1:=TQuery.Create(nil);
   mQuery1.DatabaseName:='SG_ASSOC';
   mQuery1.Close;
   mQuery1.SQL.Clear;
   mQuery1.SQL.Add('Select PG_VALOR_INTEIRO from paf_cadpar_ger where' +
                           ' PG_CODEMP=:CODEMP '
                          +' and PG_CHAVE=:CHAVE '
                          +' for update ');
   mQuery1.ParamByName('CODEMP').AsInteger:=codemp;
   mQuery1.ParamByName('CHAVE').AsString  :=pChave;
   try
      mQuery1.Open;
   except
     if not fVerificaRedeAtiva(true) then
        begin
        result:=0;
        exit;
        end
     else
        begin
         result:=0;
         exit;
        end;
      end;
   if mQuery1.IsEmpty then
      begin
      mQuery2:=TQuery.Create(nil);
      mQuery2.DatabaseName:='SG_ASSOC';
      mQuery2.Close;
      mQuery2.SQL.Clear;
      mQuery2.SQL.Add('insert into paf_cadpar_ger '
                                +'( PG_CODEMP '
                                +',PG_CHAVE '
                                +',PG_VALOR_INTEIRO '
                                +') values ('
                                +' :CODEMP '
                                +',:CHAVE '
                                +',:VALOR_INTEIRO '
                                +')');
      mQuery2.ParamByName('CODEMP').AsInteger          :=codemp;
      mQuery2.ParamByName('CHAVE').AsString            :=pChave;
      mQuery2.ParamByName('VALOR_INTEIRO').AsInteger:=1;

      try
         mQuery2.ExecSQL
      except
         if not fVerificaRedeAtiva(true) then
            begin
            result:=0;
            exit;
            end
         else
            begin
            result:=0;
            exit;
            end;
         end;

      end
   else
      begin
      mQuery2:=TQuery.Create(nil);
      mQuery2.DatabaseName:='SG_ASSOC';

      mQuery2.Close;
      mQuery2.SQL.Clear;
      mQuery2.SQL.Add('Update paf_cadpar_ger '
                                +'set PG_VALOR_INTEIRO=PG_VALOR_INTEIRO+1 '
                                +' where'
                                +' PG_CODEMP=:CODEMP '
                                +' and PG_CHAVE=:CHAVE '
                                +'');
      mQuery2.ParamByName('CODEMP').AsInteger          :=codemp;
      mQuery2.ParamByName('CHAVE').AsString            :=pChave;
      try
         mQuery2.ExecSQL;
      except
        if not fVerificaRedeAtiva(true) then
           begin
           result:=0;
           exit;
           end
         else
           begin
           result:=0;
           exit;
           end;
         end;
      Result:=mQuery1.fieldbyName('PG_VALOR_INTEIRO').asinteger;



      mQuery2.Free;
      break;
      end;
   mQuery1.Free;

   end;

end;
