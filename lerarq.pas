function flcaddap(ptipo,pcodemp,pOrdem: Integer; pvalor1,pvalor2,pvalor3,pvalor4,pvalor5,pEmpresa: String): Boolean;
begin
{
 PARAMETRO PTIPO:
 ptipo=0 numero
 ptipo=1 codigo do fornecedor
 ptipo=2 data de emissao
 ptipo=3 data de vencimento
 ptipo=4 chave do pedido
 ptipo=5 numero, desdobramento
 ptipo=6 numero, desdobramento, codigo fornecedor e data de emissao
 ptipo=7 Valor


}
//if (DM1.Tb_PargerPMTE.AsInteger<>2) then
//   begin
if ptipo<6 then
   la_empresas:=pEmpresa
else
   la_empresas:='';

if trim(la_empresas)='' then
   begin
   if pcodemp<>0 then
      la_Empresas:=' CACODEMP=0'+IntTostr(pcodemp);
   end;

mcinst2:='';
if pOrdem<>0 then
   begin
   if pOrdem=1 then
      mcinst2:='CADTEMIS,CANUMERO'
   else if pOrdem=2 then
      mcinst2:='CANUMERO'
   else
      mcinst2:='CADTVCTO,CANUMERO';

   end;


if ptipo=8 then
   begin
   if trim(mcinst2)<>'' then
      mcinst2:=mcinst2+',';
   DM1.Tb_CP.Close;
   DM1.Tb_CP.Sql.clear;
   DM1.Tb_CP.Params.CreateParam(ftString,'RAZAO',ptInput);
   DM1.Tb_CP.Sql.add('Select CADDAP.*,CADDAP.ROWID AS IDDAP from CADDAP,CADFOR where ');
   if la_Empresas<>'' then
      DM1.Tb_CP.SQL.Add(la_Empresas+' and ');
   DM1.Tb_CP.Sql.add(iif(DM1.Qr_TID.Locate('TINOME','CADFOR',[]),'','  FCODEMP=CACODEMP AND ')
                    +' FCODFOR=CACODFOR '
                    +' and FRAZAO like :RAZAO'
                    +' order by '+mcinst2+'FRAZAO ');
   DM1.Tb_CP.ParambyName('RAZAO').AsString:=pvalor1+'%';
   DM1.Tb_CP.Open;
   end
else
   begin
   DM1.Tb_CP.Close;
   DM1.Tb_CP.Sql.clear;
   DM1.Tb_CP.Sql.add('Select CADDAP.*,ROWID AS IDDAP from CADDAP ');
   mcinst:=' where ';
   if la_Empresas<>'' then
      begin
      DM1.Tb_CP.SQL.Add(mcinst+la_Empresas);
      mcinst:=' and ';
      end;
   if PTIPO<1 then
      begin
      if Trim(pvalor1)<>'' then
         begin
         DM1.Tb_CP.SQL.Add(mcinst+'CANUMERO=0'+pvalor1 );
         mcinst:=' and ';
         end;
      if trim(mcinst2)<>'' then
         DM1.Tb_CP.SQL.Add(' order by '+mcinst2);
      end
   else if ptipo=1 then
      begin
      if Trim(pvalor1)<>'' then
         begin
         if trim(mcinst2)<>'' then
            mcinst2:=mcinst2+',';


         DM1.Tb_CP.SQL.Add(mcinst+' CACODFOR=0'+pvalor1 );
         mcinst:=' and ';
         DM1.Tb_CP.SQL.Add(' order by '+mcinst2+'CACODFOR');
         end
      else if trim(mcinst2)<>'' then
         DM1.Tb_CP.SQL.Add(' order by '+mcinst2);
      end
   else if ptipo=2 then
      begin
      if trim(mcinst2)<>'' then
         mcinst2:=mcinst2+',';

      if Trim(pvalor1)<>'' then
         begin
         Try
            DM1.Tb_CP.SQL.Add(mcinst+' CADTEMIS='+chr(39)+FormatDateTime(fdt,StrToDate(pvalor1))+chr(39));
            mcinst:=' and ';
         except
            fmensagem('Data Invalida. Favor digitar no formato dd/mm/aaaa com as barras',0,['0'],0);
            end;
         end;

      DM1.Tb_CP.SQL.Add(' order by '+mcinst2+'CADTEMIS');
      end
   else if ptipo=3 then
      begin
      if trim(mcinst2)<>'' then
         mcinst2:=mcinst2+',';

      if Trim(pvalor1)<>'' then
         begin
         Try
            DM1.Tb_CP.SQL.Add(mcinst+' CADTVCTO='+chr(39)+FormatDateTime(fdt,StrToDate(pvalor1))+chr(39));
            mcinst:=' and '
         except
            fmensagem('Data Invalida. Favor digitar no formato dd/mm/aaaa com as barras',0,['0'],0);
            end;
         end;
      DM1.Tb_CP.SQL.Add(' order by '+mcinst2+'CADTVCTO');
      end
   else if ptipo=6 then
      begin
      DM1.Tb_CP.SQL.Add(mcinst+'CANUMERO=0'+pvalor1
                       +' and CADESD='+chr(39)+pvalor2+chr(39)
                       +' and CADUP=0'+pvalor5
                       +' and CACODFOR=0'+pvalor3
                       +' and CADTEMIS='+chr(39)+FormatDateTime(fdt,StrtoDate(pvalor4))+chr(39));

       if valint(pEmpresa)>0 then
          DM1.Tb_CP.sql.add(' and CACHAVE_ID='+fdeixanum(pEmpresa));

      if trim(mcinst2)<>'' then
         DM1.Tb_CP.SQL.Add(' order by '+mcinst2);
     end
  else if ptipo=4 then
     begin
     DM1.Tb_CP.SQL.Add(mcinst+' CALOTSEQ_CP=0'+pvalor2
                      +' and CACHAVEP=0'+pvalor1);
     if trim(mcinst2)<>'' then
        DM1.Tb_CP.SQL.Add(' order by '+mcinst2);
     mcinst:=' and ';
     end
  else if ptipo=5 then
     begin
     DM1.Tb_CP.SQL.Add(mcinst+' CANUMERO=0'+pvalor1
                       +' and CADESD='+chr(39)+pvalor2+chr(39));
     if trim(mcinst2)<>'' then
        DM1.Tb_CP.SQL.Add(' order by '+mcinst2);

     end
  else if ptipo=7 then
     begin
     if trim(pvalor1)='' then
        pvalor1:='0';
     DM1.Tb_CP.SQL.Add(mcinst+' CAVALOR='+mudavp(FloatToStr(ValFloat(pvalor1))));
     if trim(mcinst2)<>'' then
        DM1.Tb_CP.SQL.Add(' order by '+mcinst2);
     end
 end;
try
   DM1.Tb_CP.Open
except on e : exception do
   ex_erroSql_Novo(DM1.Tb_CP,4631,'SGE','CADDAP ' + E.Message );
   end;
if DM1.Tb_CP.Eof then
   Result:=False
else
   Result:=True;
end;

