function fRetornaEmpresas(pCheckOrigem:TCheckListBox): TCheckListBox;
begin
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('Select CODEMP, RAZAO from CADEMP '
              +' where STATUS<>9  '
              +' order by CODEMP ');
DM1.Query1.Open;
pCheckOrigem.Clear;
While not DM1.Query1.Eof do
   begin
   pCheckOrigem.Items.Add('['+FormatFloat('000', DM1.Query1.fieldbyName('CODEMP').AsInteger)+'] - '+DM1.Query1.FieldbyName('RAZAO').AsString);
   if DM1.Query1.FieldByName('CODEMP').AsInteger=codemp then
      pCheckOrigem.Checked[pCheckOrigem.Items.Count-1]:=true
   else if DM1.Tb_PargerPMTE.AsInteger=2 then
      begin
      if (DM1.Query1.FieldByName('CODEMP').AsInteger+100=codemp) or
         (DM1.Query1.FieldByName('CODEMP').AsInteger-100=codemp) then
         pCheckOrigem.Checked[pCheckOrigem.Items.Count-1]:=true;
      end;
   DM1.Query1.Next;
   end;
pCheckOrigem.Items.Add('Todas');

result:=pCheckOrigem;
end;



