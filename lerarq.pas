            begin
            result:=DM1.Query1.fieldbyName('PDCODPRO').AsFloat;
            pRet_Qtd:=1;
            exit;
            end;
         end
      else
         begin
         result:=DM1.Query1.fieldbyName('PDCODPRO').AsFloat;
         pRet_Qtd:=1;
         exit;
         end;
      end;
   DM1.Query1.close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.Sql.Add('Select CBCODPRO,CBQTDMULT from CADPRO_CODBAR where '
                      +iif(DM1.Qr_TID.Locate('TINOME','CADPRO',[]),'',' CBCODEMP=0'+IntToStr(codemp)+' and ')
