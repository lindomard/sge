         begin
         ex_erroSql_Novo(query_exe,17089,'SGE','CADVER');
         exit;
         end;
         end;
      end;
   Query_old.Next;
   end;

Query_old.Close;
Query_old.SQL.Clear;
Query_old.SQL.Add('select * from USER_TAB_COLUMNS where '
                 +' TABLE_NAME=:NOMTAB'
                 +' order by COLUMN_NAME ');
Query_old.ParamByName('NOMTAB').AsString:='OLD_'+pNomeTab;
Query_old.Open;


Query_Normal.first;
While not Query_Normal.Eof do
   begin
   if not Query_old.locate('COLUMN_NAME',Query_Normal.fieldbyName('COLUMN_NAME').AsString,[]) then
      begin
      Query_exe.close;
      Query_exe.SQL.clear;
      mCampo_Novo:=Query_Normal.fieldbyName('COLUMN_NAME').AsString;
      mCampo_Novo:=mCampo_Novo+' '+Query_Normal.fieldbyName('DATA_TYPE').AsString;
      if Query_Normal.fieldbyName('DATA_TYPE').AsString='VARCHAR2' then
         mCampo_Novo:=mCampo_Novo+' ('+Query_Normal.fieldbyName('DATA_LENGTH').AsString+')';
      Query_exe.SQL.Add('alter table OLD_'+pNomeTab+' add('+mCampo_Novo+')');
      try
         Query_exe.ExecSQL;
         fdm1StartCommit;
      except on e : exception do
         begin
         ex_erroSql_Novo(query_exe,17089,'SGE','CADVER');
         exit;
         end;
         end;
      end;
   Query_Normal.Next;
   end;

FreeAndNil(Query_Normal);
FreeAndNil(Query_exe);
FreeAndNil(Query_old);



result:=true;
end;



