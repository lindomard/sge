function fIncluirCodPFor(pCodpFor: tCodPFor): Boolean;
var
query_temp: TQuery;

begin
if pCodpFor.PFCODEMP>100 then
   pCodpFor.PFCODEMP:=pCodpFor.PFCODEMP-100;
query_temp:=TQuery.create(nil);
query_temp.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_temp.close;
query_temp.SQL.Clear;
query_temp.SQL.Add('MERGE INTO CODPFOR t1 '
                  +'  USING (SELECT '+Inttostr(pCodpFor.PFCODEMP)+' AS PFCODEMP '
                  +'        ,'+FloatToStr(pCodpFor.PFCODFOR)+' AS PFCODFOR '
                  +'        ,'+FloatToStr(pCodpFor.PFCODPRO)+' AS PFCODPRO '
                  +'        ,'+QuotedStr(pCodpFor.PFCODPFORN)+' AS PFCODPFORN '
                  +'        ,'+mudaVP(FloatToStr(pCodpFor.PFFATOR))+' AS PFFATOR '
                  +'        ,'+QuotedStr(copy(fRetAspas(pCodpFor.PFUNDFOR),1,3))+' AS PFUNDFOR '
                  +'        ,'+QuotedStr(fRetAspas(pCodpFor.PFNOMPROFOR))+' AS PFNOMPROFOR '


                  +'           FROM DUAL) ss '
                  +'     ON (t1.PFCODPRO = ss.PFCODPRO '
                  +'        and t1.PFCODFOR = ss.PFCODFOR  )  '
                  +'   WHEN MATCHED THEN '
                  +'    UPDATE SET t1.PFCODEMP = ss.PFCODEMP '
                  +'               ,t1.PFCODPFORN = ss.PFCODPFORN '
                  +'               ,t1.PFFATOR = ss.PFFATOR '
                  +'               ,t1.PFUNDFOR = ss.PFUNDFOR '
                  +'               ,t1.PFNOMPROFOR = ss.PFNOMPROFOR '

                  +'   WHEN NOT MATCHED THEN '
                  +'     INSERT( t1.PFCODEMP, t1.PFCODFOR, t1.PFCODPRO '
                  +'           ,t1.PFCODPFORN, t1.PFFATOR, t1.PFUNDFOR, t1.PFNOMPROFOR    ) '
                  +'       VALUES( ss.PFCODEMP, ss.PFCODFOR, ss.PFCODPRO '
                  +'           ,ss.PFCODPFORN, ss.PFFATOR, ss.PFUNDFOR, ss.PFNOMPROFOR ) '


                  );
try
   query_temp.ExecSQL;
   fdm1StartCommit;
except on e : exception do
   begin
   ex_erroSql_Novo(query_temp,32161,'SGE '+ e.Message ,'CODPFOR');
   result:=false;
   end;
   end;
query_temp.close;
freeandnil(query_temp);



end;


function fGravarCadp01_Anexos(pCadp01_Anexos: tCadp01_Anexos): Boolean;
var
qr_cont_imagem: TQuery;
   procedure pfechartudo;
   begin
   qr_cont_imagem.close;
   freeandnil(qr_cont_imagem);
   end;

begin
result:=true;
if PCadp01_Anexos.P1A_CODEMP>100 then
   PCadp01_Anexos.P1A_CODEMP:=PCadp01_Anexos.P1A_CODEMP-100;


qr_cont_imagem:=TQuery.create(Nil);
qr_cont_imagem.databaseName:='SG_ASSOC';

if pCadp01_Anexos.P1A_SEQ>0 then
   begin
   qr_cont_imagem.Close;
   qr_cont_imagem.sql.clear;
   qr_cont_imagem.sql.add('delete from CADP01_ANEXOS where '
                         +' P1A_CODEMP='+Inttostr(pCadp01_Anexos.P1A_CODEMP)
                         +' and P1A_CHAVE='+Floattostr(pCadp01_Anexos.P1A_CHAVE)
                         +' and P1A_CHAVE_ANO='+Floattostr(pCadp01_Anexos.P1A_CHAVE_ANO)
                         +' and P1A_SEQ='+Floattostr(pCadp01_Anexos.P1A_SEQ));

   try
      qr_cont_imagem.ExecSQL;
      fdm1StartCommit;
   except on e : exception do
      begin
      ex_erroSql_Novo(qr_cont_imagem,32213,'SGE '+ e.Message ,'CADP01_ANEXOS');
      pfechartudo;
      result:=false;
      exit;
      end;
      end;
   end
else
   begin
   qr_cont_imagem.Close;
   qr_cont_imagem.sql.clear;
   qr_cont_imagem.sql.add('Select nvl(max(P1A_SEQ),0) +1 AS SEQ from CADP01_ANEXOS where '
                         +' P1A_CODEMP='+Inttostr(pCadp01_Anexos.P1A_CODEMP)
                         +' and P1A_CHAVE='+Floattostr(pCadp01_Anexos.P1A_CHAVE)
                         +' and P1A_CHAVE_ANO='+Floattostr(pCadp01_Anexos.P1A_CHAVE_ANO));

   try
      qr_cont_imagem.Open;
      pCadp01_Anexos.P1A_SEQ:=qr_cont_imagem.Fieldbyname('SEQ').AsInteger;
   except on e : exception do
      begin
      ex_erroSql_Novo(qr_cont_imagem,32240,'SGE '+ e.Message ,'CADP01_ANEXOS');
      pfechartudo;
      result:=false;
      exit;
      end;
      end;
   end;
if trim(pCadp01_Anexos.P1A_OBS)='' then
    pCadp01_Anexos.P1A_OBS:='IMAGEM '+Floattostr(pCadp01_Anexos.P1A_SEQ);

qr_cont_imagem.close;
qr_cont_imagem.SQL.clear;
qr_cont_imagem.SQL.add('Insert into CADP01_ANEXOS ('
                      +'P1A_CODEMP '
                      +',P1A_CHAVE_ANO '
                      +',P1A_CHAVE '
                      +',P1A_SEQ '
                      +',P1A_OBS'
                      +',P1A_NOMEORI '
                      +',P1A_IMAGEM'
                      +',P1A_ID_NEW'
                      +',P1A_ID_PED01_NEW'
                      +') values ('
                      +':P1A_CODEMP '
                      +',:P1A_CHAVE_ANO '
                      +',:P1A_CHAVE '
                      +',:P1A_SEQ '
                      +',:P1A_OBS'
                      +',:P1A_NOMEORI '
                      +',:P1A_IMAGEM'
                      +',:P1A_ID_NEW'
                      +',:P1A_ID_PED01_NEW'

                      +' ) ');

qr_cont_imagem.ParamByName('P1A_CODEMP').AsInteger:=pCadp01_Anexos.P1A_CODEMP;
qr_cont_imagem.ParamByName('P1A_CHAVE_ANO').AsFloat:=pCadp01_Anexos.P1A_CHAVE_ANO;
qr_cont_imagem.ParamByName('P1A_CHAVE').AsFloat:=pCadp01_Anexos.P1A_CHAVE;
qr_cont_imagem.ParamByName('P1A_SEQ').AsFloat:=pCadp01_Anexos.P1A_SEQ;
qr_cont_imagem.ParamByName('P1A_OBS').AsString:=copy(pCadp01_Anexos.P1A_OBS,1,254);
qr_cont_imagem.ParamByName('P1A_NOMEORI').AsString:=copy(pCadp01_Anexos.P1A_NOMEORI,1,254);
qr_cont_imagem.ParamByName('P1A_IMAGEM').LoadFromStream(pCadp01_Anexos.P1A_IMAGEM, ftBlob);
qr_cont_imagem.ParamByName('P1A_ID_NEW').AsFloat:=pCadp01_Anexos.P1A_ID_NEW;
qr_cont_imagem.ParamByName('P1A_ID_PED01_NEW').AsFloat:=pCadp01_Anexos.P1A_ID_PED01_NEW;
try
   qr_cont_imagem.ExecSQL;
   fdm1StartCommit;
except on e : exception do
   begin
   ex_erroSql_Novo(qr_cont_imagem,32285,'SGE '+ e.Message ,'CADP01_ANEXOS');
   pfechartudo;
   result:=false;
   exit;
   end;
   end;
pfechartudo;
end;






