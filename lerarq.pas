                            +'  where '+iif(la_empresas='','',la_empresas+' and ')
                            +' P1LOTSEQ=0'+query_pedidos_origem.fieldbyname('LOTSEQ').AsString
                            +' and P1CHAVE=0'+query_pedidos_origem.fieldbyname('CHAVE').AsString);
          Try
             query_atuorigem.ExecSQL;
             fdm1StartCommit;
           except on e : exception do
              begin
              ex_erroSql_Novo(query_atuorigem,1206,'func '+E.Message ,'CADP02');
              result:=false;
              end;
              end;
          if mStatus=9 then
             begin
             query_atuorigem.Close;
             query_atuorigem.Sql.Clear;
