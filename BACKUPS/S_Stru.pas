procedure TFrm_Stru.bbCancelMonitoraClick(Sender: TObject);
begin
minstru:='Tem Certeza que quer cancelar o monitoramento '+#13
        +'de estoque dos produtos?';
if fMensagem(pchar(minstru),0,['1','2'],2)<>mrYes then
   begin
   fmensagem('Não vai excluir',0,['0'],0);
   exit;
   end;

DM1.Query2.Close;
DM1.Query2.SQL.Clear;
DM1.Query2.SQL.Add('SELECT object_name, object_type FROM user_objects '
                    +' where object_type='+chr(39)+'TRIGGER'+chr(39)
                    +' and object_name like '+chr(39)+'MON_%'+chr(39));
DM1.Query2.Open;
While not DM1.Query2.Eof do
   begin
   DM1.Query1.Close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.SQL.add('Drop Trigger '+DM1.Query2.fieldbyName('OBJECT_NAME').AsString);
   Try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      MessageDlg('Erro 60789 ao excluir a trigger: '+DM1.Query2.fieldbyName('OBJECT_NAME').AsString,mtError,[mbOk],0);
      exit;
      end;
  DM1.Query2.Next;
  end;
marqatual:='CADMONEST';

DM1.Query2.Close;
DM1.Query2.SQL.Clear;
DM1.Query2.SQL.Add('SELECT count(*) FROM user_objects '
                    +' where object_type='+chr(39)+'TABLE'+chr(39)
                    +' and object_name = '+chr(39)+marqatual+chr(39));
DM1.Query2.Open;
if DM1.Query2.Fields[0].AsInteger>0 then
   begin
   DM1.Query1.Close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.SQL.add('Drop table '+marqatual);
   Try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      MessageDlg('Erro 60080 ao excluir a tabela '+marqatual+'!',mtError,[mbOk],0);
      exit;
      end;
   end;
fMensagem('Monitoramento Excluido!',0,['0'],0);
end;

