procedure TFrm_Stru.bbItensBelezaClick(Sender: TObject);
begin
if Application.messagebox('Quer Fazer Correção nos arquivos inconsistentes?','Confirmação',MB_YESNO+MB_DEFBUTTON2)<>mrYes then
   exit;
fAjustarDescontos;




{


Query_Exe.Close;
Query_Exe.Sql.Clear;
Query_Exe.Sql.Add('drop table LDC ');
try
   query_exe.execsql;
   fdm1startcommit;
except
   end;

Query_Exe.Close;

Query_Exe.Sql.Clear;
Query_Exe.Sql.Add('CREATE TABLE LDC AS ( '
                 +' SELECT P1CODEMP,P1LOTSEQ,P1NUMCF,P1CHAVE,P1DATACF,P1ECF_SERIE,TOTPED02,P1TOTALL,VALOR_ITEM_MAX,(P1TOTALL-TOTPED02) AS DIFER,CODPRO,ITEMMAX '
                 +' FROM '
                 +'( SELECT PEDNOR.*,(SELECT P2TOTLIQ FROM CADP02 WHERE P2CODEMP=P1CODEMP AND P2CHAVE=P1CHAVE AND P2LOTSEQ=P1LOTSEQ '
                 +'  AND P2ITEM=ITEMMAX) '
                 +'AS VALOR_ITEM_MAX '
                 +',(SELECT P2CODPRO FROM CADP02 WHERE P2CODEMP=P1CODEMP AND P2CHAVE=P1CHAVE AND P2LOTSEQ=P1LOTSEQ '
                 +'  AND P2ITEM=ITEMMAX) '
                 +'AS CODPRO '
                 +' FROM '
                 +' (SELECT P1DATAP,P1DATACF,P1CHAVE,P1LOTSEQ,P1CODEMP,P1TOTALL,P1NUMCF,P1ECF_SERIE, '
                 +' (SELECT SUM(P2TOTLIQ) FROM CADP02 WHERE P2LOTSEQ=P1LOTSEQ '
                 +' AND P2CHAVE=P1CHAVE AND P2CODEMP=P1CODEMP) AS TOTPED02 '
                 +' ,(SELECT max(P2ITEM) FROM CADP02 WHERE P2LOTSEQ=P1LOTSEQ '
                 +' AND P2CHAVE=P1CHAVE AND P2CODEMP=P1CODEMP) AS ITEMMAX '
                 +' FROM CADP01 WHERE P1CUPOM=1 AND P1STATUS<>9 '
                 +' ) PEDNOR '
                 +'  WHERE ROUND(P1TOTALL,2)<>ROUND(TOTPED02,2) '
                 +') '
                 +' WHERE ROUND( (VALOR_ITEM_MAX+(P1TOTALL-TOTPED02)),2)=0 '
                 +') ');
try
   query_exe.execsql;
   fdm1startcommit;
except
   MessageDlg('Erro ao criar tabela temporaria!',mtError,[mbOk],0);
   freeandnil(query_exe);
   exit;
   end;
Query_Exe.Close;
Query_Exe.Sql.Clear;
Query_Exe.Sql.Add('DELETE FROM CADP02 WHERE EXISTS (SELECT P1CODEMP '
                 +' FROM LDC WHERE P1CODEMP=P2CODEMP AND P1CHAVE=P2CHAVE AND P1LOTSEQ=P2LOTSEQ AND ITEMMAX=P2ITEM) ');

try
   query_exe.execsql;
   fdm1startcommit;
except
   MessageDlg('Erro Delete registros sobrando!',mtError,[mbOk],0);
   freeandnil(query_exe);
   exit;
   end;

Query_Exe.Close;
Query_Exe.Sql.Clear;
Query_Exe.Sql.Add('drop table LDC ');
try
   query_exe.execsql;
   fdm1startcommit;
except
   MessageDlg('Erro Deletar temporaria!',mtError,[mbOk],0);
   freeandnil(query_exe);
   exit;
   end;

freeandnil(query_exe);
freeandnil(query_cons);

 }

MessageDlg('Concluido!',mtInformation,[mbOk],0);


end;

