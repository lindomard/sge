frm_agde.gb_progres.Visible:=true;
mplid:=0;

DM1.Query3.Close;
DM1.Query3.SQL.Clear;
DM1.Query3.SQL.add('Select * from CADPRO_SIMILAR');
DM1.Query3.Open;
mpqtd:=DM1.Query3.RecordCount;
While not DM1.Query3.Eof do
   begin
   mplid:=mplid+1;
   Frm_Agde.Gauge1.Progress:=mplid*100  div mpqtd;
   Frm_Agde.update;
   if not flcadpro2(1,1,0,DM1.Query3.fieldByName('PDSIM_CODPRO').AsString+DM1.Query3.fieldByName('PDSIM_REF').AsString,'','') then
      begin
