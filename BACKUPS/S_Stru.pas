      DM1.Query3.fieldByName('PDSIM_CODPRO').AsString);
      DM1.Query4.SQL.Add(mcinst2);
      DM1.Query4.Open;
      DM1.Tb_Pro.Append;
      DM1.Tb_ProPDCODPRO.Value:=fSonumero(DM1.Query3.fieldByName('PDSIM_CODPRO').AsString+DM1.Query3.fieldByName('PDSIM_REF').AsString);
      for x:=0 to DM1.Tb_Pro.FieldCount-1 do
         begin
         if DM1.Tb_Pro.fields[x].FieldKind=fkCalculated then
            continue;

         DM1.Tb_Pro.Fields[x].Value:=DM1.Query4.fieldbyName(DM1.Tb_Pro.Fields[x].FieldName).value;
         end;
      DM1.Tb_ProPDCODPRO.Value:=fSonumero(DM1.Query3.fieldByName('PDSIM_CODPRO').AsString+DM1.Query3.fieldByName('PDSIM_REF').AsString);
      DM1.Tb_ProPDNOME.Value :=DM1.Query3.fieldbyName('PDSIM_DESCRICAO').AsString;
      DM1.Tb_ProPDPRECO1.Value:=Arredonda(DM1.Query4.fieldbyName('PDPRECO1').AsFloat*0.70,DM1.Tb_PargerPCASASPU.AsInteger);
      if DM1.Query4.FieldByName('PDPRECO2').AsFloat>0 then
         DM1.Tb_ProPDPRECO2.Value:=Arredonda(DM1.Query4.fieldbyName('PDPRECO2').AsFloat*0.70,DM1.Tb_PargerPCASASPU.AsInteger);
      if DM1.Query4.FieldByName('PDPRECO3').AsFloat>0 then
         DM1.Tb_ProPDPRECO2.Value:=Arredonda(DM1.Query4.fieldbyName('PDPRECO3').AsFloat*0.70,DM1.Tb_PargerPCASASPU.AsInteger);
      if DM1.Query4.FieldByName('PDPMC').AsFloat>0 then
         DM1.Tb_ProPDPRECO2.Value:=Arredonda(DM1.Query4.fieldbyName('PDPMC').AsFloat*0.70,DM1.Tb_PargerPCASASPU.AsInteger);
      if DM1.Query4.FieldByName('PDPRECOA1').AsFloat>0 then
         DM1.Tb_ProPDPRECOA1.Value:=Arredonda(DM1.Query4.fieldbyName('PDPRECOA1').AsFloat*0.70,DM1.Tb_PargerPCASASPU.AsInteger);
      if DM1.Query4.FieldByName('PDPRECOA2').AsFloat>0 then
         DM1.Tb_ProPDPRECOA2.Value:=Arredonda(DM1.Query4.fieldbyName('PDPRECOA2').AsFloat*0.70,DM1.Tb_PargerPCASASPU.AsInteger);
      if DM1.Query4.FieldByName('PDPRECOA3').AsFloat>0 then
         DM1.Tb_ProPDPRECOA3.Value:=Arredonda(DM1.Query4.fieldbyName('PDPRECOA3').AsFloat*0.70,DM1.Tb_PargerPCASASPU.AsInteger);
      if DM1.Query4.FieldByName('PDPRECOC').AsFloat>0 then
         DM1.Tb_ProPDPRECOC.Value:=Arredonda(DM1.Query4.fieldbyName('PDPRECOC').AsFloat*0.70,DM1.Tb_PargerPCASASPU.AsInteger);
      if DM1.Query4.FieldByName('PDPCOMC').AsFloat>0 then
         DM1.Tb_ProPDPCOMC.Value:=Arredonda(DM1.Query4.fieldbyName('PDPCOMC').AsFloat*0.70,DM1.Tb_PargerPCASASPU.AsInteger);
      if DM1.Query4.FieldByName('PDPCOFAB').AsFloat>0 then
         DM1.Tb_ProPDPCOFAB.Value:=Arredonda(DM1.Query4.fieldbyName('PDPCOFAB').AsFloat*0.70,DM1.Tb_PargerPCASASPU.AsInteger);
      DM1.Tb_Pro.Post;
      end;
   DM1.Query3.next;
   end;
MessageDlg('Concluido!',mtInformation,[mbOk],0);
end;

