procedure TFrm_Stru.bbMonitoraClick(Sender: TObject);
begin
minstru:='Esta opção so podera ser usada se todos os usuários'+#13
        +'Estiverem   fora  do  sistema.  Pode  causar  danos'+#13
        +'irreparáveis. Posso Continuar?';
if fMensagem(pchar(minstru),0,['1','2'],2)<>mrYes then
   exit;
if mComRelatorio then
   RDprint1.Abrir;
DM1.Query2.Close;
DM1.Query2.SQL.Clear;
DM1.Query2.SQL.Add('SELECT object_name, object_type FROM user_objects '
                    +' where object_type='+chr(39)+'TRIGGER'+chr(39)
                    +' and object_name like '+chr(39)+'MON_%'+chr(39));
DM1.Query2.Open;
While not DM1.Query2.Eof do
   begin
   DM1.Query1.Close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.SQL.add('Drop Trigger '+DM1.Query2.fieldbyName('OBJECT_NAME').AsString);
   Try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      MessageDlg('Erro 60789 ao excluir a trigger: '+DM1.Query2.fieldbyName('OBJECT_NAME').AsString,mtError,[mbOk],0);
      exit;
      end;
  DM1.Query2.Next;
  end;
marqatual:='CADMONEST';

DM1.Query2.Close;
DM1.Query2.SQL.Clear;
DM1.Query2.SQL.Add('SELECT count(*) FROM user_objects '
                    +' where object_type='+chr(39)+'TABLE'+chr(39)
                    +' and object_name = '+chr(39)+marqatual+chr(39));
DM1.Query2.Open;
if DM1.Query2.Fields[0].AsInteger>0 then
   begin
   DM1.Query1.Close;
   DM1.Query1.Sql.Clear;
   DM1.Query1.SQL.add('Drop table '+marqatual);
   Try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      MessageDlg('Erro 60080 ao excluir a tabela '+marqatual+'!',mtError,[mbOk],0);
      exit;
      end;
   end;
DM1.Query2.Close;
DM1.Query2.SQL.Clear;
DM1.Query2.SQL.Add(' Update CADP02 set P2STATUS_PED1= '
                  +' (Select max(P1STATUS) from cadp01 '
                  +'  where '+iif(DM1.Qr_TID.Locate('TINOME','CADPED',[]),'',' P1CODEMP=P2CODEMP and ')
                  +'  P1LOTSEQ=P2LOTSEQ '
                  +'  and P1CHAVE=P2CHAVE '
                  +'  and P1ORDEM=P2ORDEM )');
//                  +'  and P1STATUS<>P2STATUS_PED1) ');
Try
   DM1.Query2.ExecSQL;
   fdm1StartCommit;
except
   MessageDlg('Erro 60825 ao atualizar a tabela CADP02!',mtError,[mbOk],0);
   exit;
   end;

DM1.Query2.Close;
DM1.Query2.SQL.Clear;
DM1.Query2.SQL.Add(' Update CADP02 set P2TIPO= '
                  +' (Select max(P1TIPO) from cadp01 '
                  +'  where '+iif(DM1.Qr_TID.Locate('TINOME','CADPED',[]),'',' P1CODEMP=P2CODEMP and ')
                  +'  P1LOTSEQ=P2LOTSEQ '
                  +'  and P1CHAVE=P2CHAVE '
                  +'  and P1ORDEM=P2ORDEM )');
//                  +'  and P1TIPO<>P2TIPO) ');
Try
   DM1.Query2.ExecSQL;
