   DM1.Query6.SQL.Add(' and P1DATAP>='+chr(39)+FormatDatetime(fdt, StrToDate(MDT1.Text))+chr(39));
if trim(MDT2.Text)<>'/  /' then
   DM1.Query6.SQL.Add(' and P1DATAP<='+chr(39)+FormatDatetime(fdt, StrToDate(MDT2.Text))+chr(39));
DM1.Query6.SQL.Add(' GROUP BY P1CODEMP,P1CHAVE,P1TOTALL '
                  +' HAVING SUM(PFPVALOR)<>P1TOTALL ');
DM1.Query6.Open;
//DM1.Query6.sql.savetofile('c:\sqlqr6.sql');
//fMensagem('query6',0,['0'],0);
While not DM1.Query6.Eof do
   begin
   DM1.Query5.close;
   DM1.Query5.SQL.Clear;
   DM1.Query5.SQL.Add('select pfpcodemp,pfpchave,pfpvalor,pfpseq,rownum '
                     +' from CADPFP '
                     +' where pfpcodemp=0'+DM1.Query6.fieldbyName('P1CODEMP').AsString
                     +' and PFPCHAVE=0'+DM1.Query6.fieldbyName('P1CHAVE').AsString
