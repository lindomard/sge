procedure TFrm_Stru.btn_ChaveClick(Sender: TObject);
begin
try
  DM1.Query1.Close;
  DM1.Query1.SQL.Clear;
  DM1.Query1.SQL.Add(' update CADP01 set P1STATUS=2 where P1STATUS=9 '
                    +' and trim(P1MOTIVO) like '+QuotedStr('Resumido/Faturado no Pedido:%'+edt_chave1.Text+'.'));
  DM1.Query1.ExecSQL;

  DM1.Query1.Close;
  DM1.Query1.SQL.Clear;
  DM1.Query1.SQL.Add(' update CADP01 set P1STATUS=9 where p1codemp='+IntToStr(codemp)+' and P1CHAVE='+edt_chave1.Text);
  DM1.Query1.ExecSQL;

  DM1.Query1.Close;
  DM1.Query1.SQL.Clear;
  DM1.Query1.SQL.Add(' select * from caddar where crcodemp='+IntToStr(codemp)+' and crnped='+edt_chave1.Text);
  DM1.Query1.Open;

  if DM1.Query1.FieldByName('crcodldr').AsInteger>0 then
    begin
    DM1.Query2.Close;
    DM1.Query2.SQL.Clear;
    DM1.Query2.SQL.Add(' delete from cadldr where codemp='+IntToStr(codemp)
                      +' and codldr='+DM1.Query1.FieldByName('crcodldr').AsString);
    DM1.Query2.ExecSQL;
    end;

  DM1.Query1.Close;
  DM1.Query1.SQL.Clear;
  DM1.Query1.SQL.Add(' delete from caddar where crcodemp='+IntToStr(codemp)+' and crnped='+edt_chave1.Text);
  DM1.Query1.ExecSQL;
except
  DM1.Query1.SQL.SaveToFile('C:\SGE\ERROSQL.TXT');
  end;
end;

