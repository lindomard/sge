procedure TFrm_Stru.BBNIVPROClick(Sender: TObject);
begin

DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('drop table temporx ');
try
  DM1.Query1.ExecSQL;
except
  end;

DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('create table temporx as  ');
DM1.Query1.SQL.Add('  select                          ');
DM1.Query1.SQL.Add('  pdcodpro, pdcodemp,             ');
DM1.Query1.SQL.Add('  case when pdnivel=0 then 4      ');
DM1.Query1.SQL.Add('       when pdnivel=1 then 9      ');
DM1.Query1.SQL.Add('       when pdnivel=2 then 0      ');
DM1.Query1.SQL.Add('       when pdnivel=3 then 3      ');
DM1.Query1.SQL.Add('       when pdnivel=4 then 1      ');
DM1.Query1.SQL.Add('       when pdnivel=5 then 10     ');
DM1.Query1.SQL.Add('       when pdnivel=6 then 6      ');
DM1.Query1.SQL.Add('       when pdnivel=7 then 99     ');
DM1.Query1.SQL.Add('  end as pdnivel                  ');
DM1.Query1.SQL.Add('  from cadpro                     ');
try
  DM1.Query1.ExecSQL;
except
  fmensagem('Erro ao criar tabela temporaria!',0,['0'],0);
  DM1.Query1.SQL.SaveToFile('C:\SQL.TXT');
  Exit;
  end;


DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add(' UPDATE CADPRO                               ');
DM1.Query1.SQL.Add(' SET PDNIVEL=(SELECT TEMPORX.PDNIVEL         ');
DM1.Query1.SQL.Add('    FROM TEMPORX                             ');
DM1.Query1.SQL.Add('    WHERE TEMPORX.PDCODPRO=CADPRO.PDCODPRO   ');
DM1.Query1.SQL.Add('    AND TEMPORX.PDCODEMP=CADPRO.PDCODEMP)    ');
try
  DM1.Query1.ExecSQL;
except
  fmensagem('Erro corrigir o cadastro de produto!',0,['0'],0);
  DM1.Query1.SQL.SaveToFile('C:\SQL.TXT');
  Exit;
  end;
fmensagem('Concluido!!!',0,['0'],0);

end;

procedure TFrm_Stru.recriar_tabelaClick(Sender: TObject);
var
  x: Integer;
  nomtab_temp: String;
begin

x:=0;
nomtab_temp:=MNOMTAB.Text+FormatDateTime('DDMMYYYY',Now);

if trim(MNOMTAB.Text)='' then
  begin
  fmensagem('Favor selecionar uma tabela valida!',0,['0'],0);
  Exit;
  end;

DM1.Query2.Close;
DM1.Query2.SQL.Clear;
DM1.Query2.SQL.Add(' select * from user_tab_columns ');
DM1.Query2.SQL.Add(' where TABLE_NAME='+chr(39)+MNOMTAB.Text+chr(39));
DM1.Query2.Open;

if not DM1.Query2.IsEmpty then
  begin
  DM1.Query2.Close;
  DM1.Query2.SQL.Clear;
  DM1.Query2.SQL.Add(' select * from user_tab_columns ');
  DM1.Query2.SQL.Add(' where TABLE_NAME='+chr(39)+MNOMTAB.Text+chr(39));
  DM1.Query2.SQL.Add(' and DATA_TYPE='+chr(39)+'LONG'+chr(39));
  DM1.Query2.Open;
  if DM1.Query2.IsEmpty then
    begin
    try
      DM1.Query1.Close;
      DM1.Query1.SQL.Clear;
      DM1.Query1.SQL.Add(' create table temp_'+nomtab_temp+' as ');
      DM1.Query1.SQL.Add(' select * from '+MNOMTAB.Text);
      DM1.Query1.ExecSQL;
    except
      DM1.Query1.SQL.SaveToFile('C:\SQL.TXT');
      fmensagem('Erro ao Selecionar dados!',0,['0'],0);
      end;
    end
  else
    begin
    try
      DM1.Query1.Close;
      DM1.Query1.SQL.Clear;
      DM1.Query1.SQL.Add(' create table temp_'+nomtab_temp+' as ');
      DM1.Query1.SQL.Add(' select ');

      DM1.Query2.Close;
      DM1.Query2.SQL.Clear;
      DM1.Query2.SQL.Add(' select COLUMN_NAME from user_tab_columns ');
      DM1.Query2.SQL.Add(' where TABLE_NAME='+chr(39)+MNOMTAB.Text+chr(39));
      DM1.Query2.SQL.Add(' and DATA_TYPE<>'+chr(39)+'LONG'+chr(39));
      DM1.Query2.Open;
      x:=0;
      while not DM1.Query2.Eof do
        begin
        if x=0 then
          DM1.Query1.SQL.Add(DM1.Query2.FieldByName('COLUMN_NAME').AsString)
        else
          DM1.Query1.SQL.Add(','+DM1.Query2.FieldByName('COLUMN_NAME').AsString);
        X:=X+1;
        DM1.Query2.Next;
        end;

      DM1.Query1.SQL.Add(' from '+MNOMTAB.Text);
      DM1.Query1.ExecSQL;
    except
      DM1.Query1.SQL.SaveToFile('C:\SQL.TXT');
      fmensagem('Erro ao Gerar tabela!',0,['0'],0);
      end;
    end;

  X:=0;

  DM1.Query2.Close;
  DM1.Query2.SQL.Clear;
  DM1.Query2.SQL.Add(' select * from user_tables '
                    +' where table_name ='+chr(39)+nomtab_temp+'_'+IntToStr(x)+chr(39));
  DM1.Query2.Open;
  while not DM1.Query2.IsEmpty do
    begin
    X:=X+1;
    DM1.Query2.Close;
    DM1.Query2.SQL.Clear;
    DM1.Query2.SQL.Add(' select * from user_tables '
                      +' where table_name ='+chr(39)+nomtab_temp+'_'+IntToStr(X)+chr(39));
    DM1.Query2.Open;
    end;

  DM1.Query1.Close;
  DM1.Query1.SQL.Clear;
  DM1.Query1.SQL.Add(' rename '+MNOMTAB.Text+' to '+nomtab_temp+'_'+IntToStr(X));
  DM1.Query1.ExecSQL;

  DM1.Query1.Close;
  DM1.Query1.SQL.Clear;
  DM1.Query1.SQL.Add(' rename temp_'+nomtab_temp+' to '+MNOMTAB.Text);
  DM1.Query1.ExecSQL;

  CB_ALTCAMPOS.Checked;
  bbSoEstruturasClick(Self);
  end;
end;

