      begin
      WriteLn(f,'   Frm_Stru.STG1.Cells[01,mlinha]:=pcBlob;');
      WriteLn(f,'   Frm_Stru.STG1.Cells[02,mlinha]:='+chr(39)+''+chr(39)+';');
      WriteLn(f,'   Frm_Stru.STG1.Cells[03,mlinha]:='+chr(39)+''+chr(39)+';');
      end
   else if DM1.Query2.fieldbyName('DATA_TYPE').AsString='NUMBER' then
      begin
      WriteLn(f,'   Frm_Stru.STG1.Cells[01,mlinha]:=pcFloat;');
      if DM1.Query2.FieldByName('DATA_PRECISION').AsInteger>0 then
         WriteLn(f,'   Frm_Stru.STG1.Cells[02,mlinha]:='+chr(39)+DM1.Query2.fieldbyName('DATA_PRECISION').AsString+chr(39)+';')
      else
      WriteLn(f,'   Frm_Stru.STG1.Cells[02,mlinha]:='+chr(39)+''+chr(39)+';');
      WriteLn(f,'   Frm_Stru.STG1.Cells[03,mlinha]:='+chr(39)+''+chr(39)+';');
