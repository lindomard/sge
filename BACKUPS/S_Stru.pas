function TFrm_Stru.fcortab(ptipo: Integer): Boolean;
var
f: TextFile;
marq: String;
mqtd: Integer;
begin
Frm_Stru.Label2.Visible:=True;
DM1.Qr_TID.Close;
DM1.Qr_TID.SQL.Clear;
DM1.Qr_TID.SQL.Add('Select * from CADTID');
DM1.Qr_TID.open;

DM1.Query1.Close;
DM1.Query1.Sql.Clear;
DM1.Query1.SQl.add('UPDATE CADCLI SET CTPPESSOA=CTIPOC '
                  +' where CTPPESSOA is null and not CTIPOC is null');
Try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   ex_erroSql(01,28504,'Frm_Stru','CADCLI');
   end;



DM1.Query1.Close;
DM1.Query1.Sql.Clear;
DM1.Query1.SQl.add('UPDATE CADPV SET PVCODTIP='+chr(39)+'AP'+chr(39)
                  +' where PVCODTIP is null ');
Try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except                                                                  
   ex_erroSql(01,28515,'Frm_Stru','CADPV');
   end;


DM1.Query1.Close;
DM1.Query1.Sql.Clear;
DM1.Query1.SQl.add('UPDATE CADPV2 SET PV2CODTIP='+chr(39)+'AP'+chr(39)
                  +' where PV2CODTIP is null ');
Try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   ex_erroSql(01,28515,'Frm_Stru','CADPV');
   end;
DM1.Query2.Close;
DM1.Query2.SQL.Clear;
DM1.Query2.SQl.Add('Select TABLE_NAME,COLUMN_NAME,DATA_TYPE,DATA_SCALE from USER_TAB_COLUMNS '
                  +' where DATA_TYPE='+chr(39)+'DATE'+chr(39)
                  +' AND not (TABLE_NAME like '+chr(39)+'BIN$%'+chr(39)+')');
//                  +' AND not (TABLE_NAME like '+chr(39)+'BIN$6+pgbv%'+chr(39)+')');
DM1.Query2.Open;
if not DirectoryExists('C:\SGE\LOG') then
   begin
   CreateDir('C:\SGE\LOG');
   end;
mqtd:=0;
marq:='\SGE\LOG\LOG'+FormatFloat('00000',mqtd);

While true do
   begin
   mqtd:=mqtd+1;
   marq:='C:\SGE\LOG\LOG'+FormatFloat('00000',mqtd);
   if not FileExists(marq) then
      break;
   end;
AssignFile(f,marq);
Rewrite(f);

While not DM1.Query2.Eof do
   begin
