procedure TFrm_Stru.Memo_Triggers_DuplicChange(Sender: TObject);
begin
{
CREATE OR REPLACE TRIGGER CADECF_CAT52_CAB_TRIG01 AFTER UPDATE ON CADECF_CAT52_CAB

FOR EACH ROW



declare mDescRat NUMBER;


CURSOR c_cadecf_grupo_aliq IS

SELECT TOTLIQ,TRUNC((TOTLIQ*mdescrat),2) AS VALPRE_RAT , ALIQ,NUMCF, VALRAT
     , (select MAX(CT52I_ITEM) FROM
       CADECF_CAT52_ITENS  WHERE CT52I_NUMCF=1 AND  CT52I_ALIQ=ALIQ
       and CT52I_DATACF=:NEW.CT52CAB_DATACF
       and CT52I_CODECF=:NEW.CT52CAB_CODECF
       and CT52I_CODEMP=:NEW.CT52CAB_CODEMP
       and NVL(CT52I_INDCANC,'N'<>'S'
       AND CT52I_TOTLIQ=(select MAX(CT52I_TOTLIQ) FROM CADECF_CAT52_ITENS
       WHERE CT52I_NUMCF=:NEW.CT52CAB_NUMCF AND  CT52I_ALIQ=ALIQ
       and CT52I_DATACF=:NEW.CT52CAB_DATACF
       and CT52I_CODECF=:NEW.CT52CAB_CODECF
       and NVL(CT52I_INDCANC,'N')<>'S'
       and CT52I_CODEMP=:NEW.CT52CAB_CODECF )
       )  ITEMMAIOR
       FROM ( 
       SELECT SUM(CT52I_TOTLIQ) AS TOTLIQ,SUM(CT52I_VALDES_GER) AS VALRAT,
              CT52I_ALIQ AS ALIQ, MAX(CT52I_NUMCF) AS NUMCF 
              FROM CADECF_CAT52_ITENS 
              WHERE CT52I_NUMCF=:NEW.CT52CAB_NUMCF
              and CT52I_DATACF=:NEW.CT52CAB_DATACF
              and CT52I_CODECF=:NEW.CT52CAB_CODECF
              and CT52I_CODEMP=:NEW.CT52CAB_CODEMP
              and NVL(CT52I_INDCANC,'N')<>'S'
              GROUP BY CT52I_ALIQ) order by TOTLIQ DESC, ITEMMAIOR;
 mOper VARCHAR2(01);
 mNv_ParcDif Integer; -- parcela onde pode aplicar a diferenca de arredondamentos

begin




IF NVL(:NEW.CT52CAB_DESC_VALOR,0)>0 then
   if :NEW.CT52CAB_STATUS=1 then
      if :NEW.CT52CAB_IMPRESSORA='BEMATECH' then
          mDescRat:=trunc( (:NEW.CT52CAB_DESC_VALOR*100 /  :NEW.CT52CAB_SUBTOT) ,2);
          Update CADECF_CAT52_ITENS set CT52I_VALACRE_GER=0,
                          CT52I_VALDES_GER=TRUNC( ((CT52I_TOTLIQ*mDescRat)/100),2)
                         , CT52I_ARRED=0,CT52I_PADESCRAT=mDescRat
                          where CT52I_NUMCF=:NEW_CT52CAB_NUMCF
                          and CT52I_DATACF=:NEW_CT52CAB_DATACF
                          and CT52I_CODECF=:NEW_CT52CAB_CODECF
                          and CT52I_CODEMP=:NEW_CT52CAB_CODEMP
                          and NVL(CT52I_INDCANC,'N')<>'S';

     FOR v_cadecf_grupo_aliq in c_cadecf_grupo_aliq LOOP
         if v_cadecf_grupo_aliq.VALPRE_RAT<>v_cadecf_grupo_aliq.VALRAT then
            mdifRat:=v_cadecf_grupo_aliq.VALPRE_RAT-v_cadecf_grupo_aliq.VALRAT then
            Update CADECF_CAT52_ITENS set CT52I_VALDES_GER=CT52I_VALDES_GER+mDifRat
                       ,CT52I_ARRED=CT52I_ARRED+mDifRat
                       WHERE CT52I_NUMCF=:NEW_CT52CAB_NUMCF
                       and CT52I_DATACF=:NEW_CT52CAB_DATACF
                       and CT52I_CODECF=:NEW_CT52CAB_CODECF
                       and CT52I_CODEMP=:NEW_CT52CAB_CODEMP
                       and CT52I_ITEM=v_cadecf_grupo_aliq.ITEMMAIOR;
         end if;
     end loop;


try


      end if;
   end if;

end if;

}
end;

