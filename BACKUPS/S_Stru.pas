procedure TFrm_Stru.bbGerarGradeClick(Sender: TObject);
var
mGrade,mLav, mTec: String;
nv_tec: array of string;
nv_lav: array of string;
x,y,mQtdItens: Integer;

begin
Application.Createform(TFrm_Agde, Frm_Agde);
Frm_Agde.Label1.Caption:='Criando grades inexistentes!';
Frm_Agde.gb_progres.Visible:=True;
Frm_agde.Show;
mplid:=0;
mpqtd:=0;
// CRIANDO AS GRADES
setlength(nv_tec,2);
setlength(nv_lav,2);
flcadpro(0,1,0,'');
mpqtd:=DM1.Tb_Pro.RecordCount;
While not DM1.Tb_Pro.Eof do
   begin
   mplid:=mplid+1;
   Frm_Agde.Gauge1.Progress:=mplid*100 div mpqtd;
   Frm_Agde.Update;
   flcadGraPro(0,0,0,DM1.Tb_ProPDCODPRO.AsString);
   setlength(nv_tec,2);
   setlength(nv_lav,2);
   nv_tec[0]:='';
   nv_tec[1]:='';
   nv_lav[0]:='';
   nv_lav[1]:='';
   While not DM4.Tb_GraPro.Eof do
      begin
      if DM4.Tb_GraProGPCODMAS.Value='02' then
         begin
         mQtdItens:=high(nv_tec);
         setlength(nv_tec,mQtdItens+2);
         nv_tec[mQtdItens]:=DM4.Tb_GraProGPGRADE.Value;
         end
      else if DM4.Tb_GraProGPCODMAS.Value='03' then
         begin
         mQtdItens:=high(nv_lav);
         setlength(nv_lav,mQtdItens+2);
         nv_lav[mQtdItens]:=DM4.Tb_GraProGPGRADE.Value;
         end;
      DM4.Tb_GraPro.Next;
      end;
   if (high(nv_tec)>=0) and (High(nv_lav)>=0) then
      begin
      for x := 0 to high(nv_tec) do
         begin
         mtec:=nv_tec[x];
         if trim(mtec)='' then
            continue;
         for y := 0 to high(nv_lav) do
            begin
            mlav:=nv_lav[y];
            if trim(mlav)='' then
               continue;
            DM4.Tb_GraPro.First;
            While not DM4.Tb_GraPro.Eof do
               begin
               if DM4.Tb_GraProGPCODMAS.Value<>'04' then
                  begin
                  DM4.Tb_GraPro.Next;
                  Continue;
                  end;
               mgrade:=mtec+mlav+DM4.Tb_GraProGPGRADE.Value;
               if not flcadlgc(0,1,0,DM1.Tb_ProPDCODPRO.AsString,mgrade,'') then
                  begin
                  if not fCriargrade(codemp,
                                     DM1.Tb_ProPDCODPRO.Value,
                                    0, // quantidade
                                    0, // qtd revenda
                                    0, // qtd consignado
                                    0, // preco 01
                                    0, // preco 02
                                    0, // preco 03
                                    0, // preco 01 a
                                    0, // preco 02 a
                                    0, // preco 03 a
                                    0, // preco custo
                                    0, // estoque maximo
                                    0, // estoque minimo
                                    mGrade,
                                   pdatanula) then
                     begin
                     MessageDlg('Erro ao Criar as grades',mtError,[mbOk],0);
                     exit;
                     end;
                  end;
               DM4.Tb_GraPro.Next;
               end;
            end;
         end;
      end;
   DM1.Tb_Pro.Next;
   end;
Frm_Agde.Label1.Caption:='Concluido!';
Frm_Agde.Update;
end;

