function TFrm_Stru.fTestaCampos(pTipo: Integer;pTabela: String): boolean;
var
x,y: Integer;

mAchou: Boolean;
begin
Result:=True;
if ptipo=0 then
   begin
   if pbanco=0 then
      begin
      DM1.Query2.Close;
      DM1.Query2.SQL.Clear;
      DM1.Query2.SQl.Add('Select * from USER_TAB_COLUMNS '
                        +' where TABLE_NAME='+chr(39)+uppercase(pTabela)+chr(39));
      DM1.Query2.Open;

      for x:=0 to Frm_Stru.STG1.RowCount-1 do
         begin
         if Trim(Frm_Stru.STG1.Cells[0,x])='' then
            Continue;

         if valint(Frm_Stru.STG1.Cells[3,x])>0 then
            begin
            if pos(',',Frm_Stru.STG1.Cells[2,x])=0 then
              Frm_Stru.STG1.Cells[2,x]:=Frm_Stru.STG1.Cells[2,x]+','+Frm_Stru.STG1.Cells[3,x];
            end;


         if DM1.Query2.Locate('COLUMN_NAME',upperCase(Frm_Stru.STG1.Cells[0,x]),[]) then
            begin
            if Frm_Stru.CB_ALTCAMPOS.Checked then
               fTestarTipoTamanho(pTabela,x,y)
            else
               begin
               if DM1.Query2.FieldByName('DATA_TYPE').AsString='VARCHAR2' then
                  begin
                  if DM1.Query2.FieldByName('CHAR_COL_DECL_LENGTH').AsInteger<
                     valint(Frm_Stru.STG1.Cells[2,x]) then
                     fAumentarTamanhoString(pTabela,x,y);
                  end
               else if DM1.Query2.FieldByName('DATA_TYPE').AsString='NUMBER' then
                  begin
                  if (DM1.Query2.FieldByName('DATA_PRECISION').AsInteger>0) and
                     (valint(Frm_Stru.STG1.Cells[2,x])=0 ) then
                     begin
//                     ShowMessage('Achou: '+Frm_Stru.STG1.Cells[0,x]+' TamanhO:0 antes '+DM1.Query2.FieldByName('DATA_PRECISION').AsString);
                     fAumentarTamanhoString(pTabela,x,y);
                     end
                  else  if (valint(Frm_Stru.STG1.Cells[3,x])>0) and
                           (DM1.Query2.FieldByName('DATA_SCALE').AsInteger=0) then
                     fAumentarTamanhoString(pTabela,x,y);

                  end

               end;
            end
         else
            begin
            if not fCriarCampos(pTipo,x,pTabela) then
               begin
               result:=false;
               exit;
               end;
            end;
         end;
      if Frm_Stru.CB_ALTCAMPOS.Checked then
         begin
         DM1.Query2.First;
         While not DM1.Query2.Eof do
            begin
            for x:=0 to Frm_Stru.STG1.RowCount-1 do
               begin
               if Trim(Frm_Stru.STG1.Cells[0,x])='' then
                  Continue;
//               if  DM1.Query2.FieldByName('COLUMN_NAME').AsString='CDEP01' then
//                   SHOWMESSAGE('ACHOU');

               if upperCase(DM1.Query2.FieldByName('COLUMN_NAME').AsString)
                  =upperCase(Frm_Stru.STG1.Cells[0,x]) then
                  begin
                  mAchou:=true;
                  break;
                  end;
               end;
            if not mAchou then
               begin
               if not fDeletarCampo(pTipo,y,pTabela) then
                  begin
                  result:=false;
                  exit;
                  end;
               end;
            machou:=false;
            DM1.Query2.Next;

            end;
         end;
      end
   else
      begin
      DM1.Query2.close;
      DM1.Query2.Sql.Clear;
      DM1.Query2.Sql.add('Select * from '+pTabela+' where '+Frm_Stru.STG1.Cells[0,0]+' is null');
      try
         DM1.Query2.Open;
      except
         DM1.Query2.Sql.Clear;
         DM1.Query2.Sql.add('Select * from '+pTabela);
         DM1.Query2.Open;
         end;
      for x:=0 to Frm_Stru.STG1.RowCount-1 do
         begin
         if Trim(Frm_Stru.STG1.Cells[0,x])='' then
            Continue;
         mAchou:=false;
         for y:=0 to DM1.Query2.fieldcount-1 do
            begin
            if LowerCase(Frm_Stru.STG1.Cells[0,x])=LowerCase(DM1.Query2.Fields[y].FieldName) then
               begin
               mAchou:=true;
               if Frm_Stru.CB_ALTCAMPOS.Checked then
                  fTestarTipoTamanho(pTabela,x,y);
               break;
               end;
            end;
         if not mAchou then
            begin
            if not fCriarCampos(pTipo,x,pTabela) then
               begin
               result:=false;
               exit;
               end;
            end;
         end;
      if Frm_Stru.CB_ALTCAMPOS.Checked then
         begin
         for y:=0 to DM1.Query2.fieldcount-1 do
            begin
            mAchou:=false;
            for x:=0 to Frm_Stru.STG1.RowCount-1 do
               begin
               if Trim(Frm_Stru.STG1.Cells[0,x])='' then
                  Continue;
               if LowerCase(DM1.Query2.Fields[y].FieldName)=LowerCase(Frm_Stru.STG1.Cells[0,x]) then
                  begin
                  mAchou:=true;
                  break;
                  end;
               end;
            if not mAchou then
               begin
               if not fDeletarCampo(pTipo,y,pTabela) then
                  begin
                  result:=false;
                  exit;
                  end;
               end;
            end;
         end;
      end;
   end;
end;
function TFrm_Stru.fTestarTipoTamanho(pTabela: String;pPosSTG,pPosTab: Integer): boolean;
begin

Frm_Stru.Label2.Caption:='Verificando tabela: '+pTabela+' Campo: '+Frm_Stru.STG1.Cells[0,pPosSTG];
Frm_Stru.Update;

if pbanco=0 then
   begin
   if Frm_Stru.STG1.Cells[1,pPosSTG]=pcData then
      begin
      if DM1.Query2.FieldByName('DATA_TYPE').AsString<>'DATE' then
         fAjustarCampo(pTabela,pPosSTG,pPosTab);
      end
   else if Frm_Stru.STG1.Cells[1,pPosSTG]=pcDatahora then
      begin
      if DM1.Query2.FieldByName('DATA_TYPE').AsString<>'TIME' then
         fAjustarCampo(pTabela,pPosSTG,pPosTab);
      end
   else if Frm_Stru.STG1.Cells[1,pPosSTG]=pcFloat then
      begin
      if (DM1.Query2.FieldByName('DATA_TYPE').AsString<>'NUMBER')
         or (DM1.Query2.FieldByName('DATA_SCALE').AsInteger<>valint(Frm_Stru.STG1.Cells[3,pPosSTG])) then
         fAjustarCampo(pTabela,pPosSTG,pPosTab);
      end
   else if Frm_Stru.STG1.Cells[1,pPosSTG]=pcInteger then
      begin
      if DM1.Query2.FieldByName('DATA_TYPE').AsString<>'INTEGER' then
         fAjustarCampo(pTabela,pPosSTG,pPosTab);
      end
   else if Frm_Stru.STG1.Cells[1,pPosSTG]=pcBlob then
      begin
      if DM1.Query2.FieldByName('DATA_TYPE').AsString<>'LONG ROW' then
         fAjustarCampo(pTabela,pPosSTG,pPosTab);
      end
   else if Frm_Stru.STG1.Cells[1,pPosSTG]=pcString then
      begin
      if (DM1.Query2.FieldByName('DATA_TYPE').AsString<>'VARCHAR2') and
         (DM1.Query2.FieldByName('DATA_TYPE').AsString<>'LONG') and
         (DM1.Query2.FieldByName('DATA_TYPE').AsString<>'CHAR') then
         begin
         fAjustarCampo(pTabela,pPosSTG,pPosTab)
         end
      else
         begin
         if valint(DM1.Query2.FieldByName('CHAR_COL_DECL_LENGTH').AsString)>0 then
            begin
            if ValInt(Frm_Stru.STG1.Cells[02,pPosSTG])<>
               valint(DM1.Query2.FieldByName('CHAR_COL_DECL_LENGTH').AsString) then
               begin
               fAjustarCampo(pTabela,pPosSTG,pPosTab);
               end;
            end;
         end;
      end
   else if Frm_Stru.STG1.Cells[1,pPosSTG]=pcMemo then
      begin
      if (DM1.Query2.FieldByName('DATA_TYPE').AsString<>'LONG')  then
         fAjustarCampo(pTabela,pPosSTG,pPosTab);
      end;
   end;
result:=true;
end;
function TFrm_Stru.fCriarCampos(pTipo,pLin: Integer;pTabela: String): boolean;
var
mNulDefault: String;
begin
if not pexecutar then
   fStruimp(2,plin,0,pTabela,Frm_Stru.STG1.Cells[0,plin]);
if (pBanco<>0) then
   begin
   if (Frm_Stru.STG1.Cells[1,plin]=pcInteger) or
      (Frm_Stru.STG1.Cells[1,plin]=pcFloat) then
       Frm_Stru.STG1.Cells[2,plin]:='';
   end;

if copy(frm_stru.STG1.cells[4,plin],1,7)='DEFAULT' then
   mNulDefault:=frm_stru.STG1.cells[4,plin]
else
   mNulDefault:='';


DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('alter table '+pTabela+' add '+Frm_Stru.STG1.Cells[0,plin]
                  +' '+Frm_Stru.STG1.Cells[1,plin]
                  +iif(Frm_Stru.STG1.Cells[2,plin]='',' ','('+Frm_Stru.STG1.Cells[2,plin]+')')
                  +' '+mnuldefault
                  );

try
   DM1.Query1.ExecSQL;
   result:=true;
except
{
   Frm_Stru.Memo2.Lines.add('Tabela: '+ptabela);
   Frm_Stru.Memo2.Lines.add('0= '+Frm_Stru.STG1.Cells[0,plin]);
   Frm_Stru.Memo2.Lines.add('1= '+Frm_Stru.STG1.Cells[1,plin]);
   Frm_Stru.Memo2.Lines.add('2= '+Frm_Stru.STG1.Cells[2,plin]);
   Frm_Stru.Memo2.Lines.add(' ');
}
   DM1.query1.sql.SaveTofile('c:\sqlAG.txt');
   result:=false;
   end;
end;

function TFrm_Stru.fDeletarCampo(pTipo,pLin: Integer;pTabela: String): boolean;
begin
if not pexecutar then
   fStruimp(3,mlidos-1,plin,pTabela,DM1.Query2.Fields[plin].FieldName);
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('alter table '+pTabela+' drop '+
                   iif(pbanco=0,PCUpdDropEsq+DM1.Query2.fieldbyName('COLUMN_NAME').AsString+PCUpdDropDir,
                   PCUpdDropEsq+(DM1.Query2.Fields[plin].FieldName)+PCUpdDropDir));
try
   DM1.Query1.ExecSQL;
   result:=true;
except
   DM1.Query1.SQL.SAVETOFILE('C:\SQL.TXT');

   result:=false;
   end;
end;

function TFrm_Stru.fAjustarCampo(pTabela: String; pPosSTG,pPosTab: Integer): Boolean;
var
mNulDefault: String;

begin
if not pexecutar then
   fStruimp(1,pPosSTG,pPosTab,pTabela,Frm_Stru.STG1.Cells[0,pPosSTG]);
if (pBanco<>0) then
   begin
   if (Frm_Stru.STG1.Cells[1,pPosSTG]=pcInteger) or
      (Frm_Stru.STG1.Cells[1,pPosSTG]=pcFloat) then
      Frm_Stru.STG1.Cells[2,pPosSTG]:='';
   end;

if copy(frm_stru.STG1.cells[4,pPosSTG],1,7)='DEFAULT' then
   mNulDefault:=frm_stru.STG1.cells[4,pPosSTG]
else
   mNulDefault:='';

DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('alter table '+pTabela+' add ANTERIOR_'+Frm_Stru.STG1.Cells[0,pPosSTG]
                  +' '+Frm_Stru.STG1.Cells[1,pPosSTG]
                  +iif(Frm_Stru.STG1.Cells[2,pPosSTG]='','','('+Frm_Stru.STG1.Cells[2,pPosSTG]+')'));
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
   end;
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('Update '+pTabela+' SET ANTERIOR_'+Frm_Stru.STG1.Cells[0,pPosSTG]
                  +'='+Frm_Stru.STG1.Cells[0,pPosSTG]);
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
   end;
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('alter table '+pTabela+' drop '+PCUpdDropEsq+Frm_Stru.STG1.Cells[0,pPosSTG]+PCUpdDropDir);
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   end;
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('alter table '+pTabela+' add '+Frm_Stru.STG1.Cells[0,pPosSTG]
                  +' '+Frm_Stru.STG1.Cells[1,pPosSTG]
                  +iif(Frm_Stru.STG1.Cells[2,pPosSTG]='','','('+Frm_Stru.STG1.Cells[2,pPosSTG]+')')
                  +' '+mnuldefault
                  );
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
   end;
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('Update '+pTabela+' SET '+Frm_Stru.STG1.Cells[0,pPosSTG]
                  +'=ANTERIOR_'+Frm_Stru.STG1.Cells[0,pPosSTG]);
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
   end;
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('alter table '+pTabela+' drop '+PCUpdDropEsq+'ANTERIOR_'+Frm_Stru.STG1.Cells[0,pPosSTG]+PCUpdDropDir);
try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
except
   end;
result:=True;
end;


