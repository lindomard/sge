      WriteLn(f,'   Frm_Stru.STG1.Cells[01,mlinha]:=pcMemo;');
      WriteLn(f,'   Frm_Stru.STG1.Cells[02,mlinha]:='+chr(39)+''+chr(39)+';');
      WriteLn(f,'   Frm_Stru.STG1.Cells[03,mlinha]:='+chr(39)+''+chr(39)+';');
