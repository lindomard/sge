function tFrm_Stru.findex(ptipo: Integer;pnome: String):Boolean;
var
machou: Boolean;
begin
Frm_Stru.Label2.Caption:='Processando Tabela: '+marqatual;
Frm_Stru.Label2.Update;
Frm_Stru.Update;

//  if marqatual<>'CADEST' then
//   exit;


for mlidos:=1 to mtotcam do
   begin
   if ptipo<>2 then
      begin
      mcanind:=true;
      machou:=True;
      if pbanco=0 then
         begin
         DM1.Query2.Close;
         DM1.Query2.SQL.Clear;
         DM1.Query2.SQL.Add('Select count(*) from user_objects '
                          +' where object_type='+chr(39)+'INDEX'+chr(39)
                          +' and object_name='+chr(39)+Frm_Stru.STG1.Cells[1,mlidos-1]+chr(39));
         DM1.Query2.Open;
         if DM1.Query2.fields[0].asinteger>0 then
            machou:=True
         else
            machou:=False;
         end;
      if machou then
         begin
         DM1.Query1.Close;
         DM1.Query1.SQL.Clear;
         DM1.Query1.SQL.Add('Drop index '+Frm_Stru.STG1.Cells[1,mlidos-1]);
         minstru:=DM1.Query1.Text;
         Try
            DM1.Query1.ExecSQL;
            fdm1StartCommit;
            machou:=True;
         except
//            ex_erroSql(01,28381,'Frm_Stru',marqatual);
            machou:=False;
            end;
         end;
      end;
//   if machou then
//      fStruimp(7);
   if ptipo=0 then
      begin
      minstru:='Create'+iif(Frm_Stru.STG1.Cells[2,mlidos-1]='PRIMARIO',' UNIQUE ',' ')
                       +' index '+Frm_Stru.STG1.Cells[1,mlidos-1]+' on '+marqatual;
{   if pbanco=0 then
      minstru:=minstru+'('+Frm_Stru.STG1.Cells[3,mlidos-1]+Frm_Stru.STG1.Cells[0,mlidos-1]+')'
   else }
//      if (Frm_Stru.STG1.Cells[2,mlidos-1]='PRIMARIO') or (pbanco<>0) then
//      if (Frm_Stru.STG1.Cells[2,mlidos-1]='PRIMARIO') then
//         minstru:=minstru+'('+iif(DM1.Qr_Tid.Locate('TINOME',pnome,[]),'',Frm_Stru.STG1.Cells[3,mlidos-1])+Frm_Stru.STG1.Cells[0,mlidos-1]+')';
//      else
//         minstru:=minstru+'('+Frm_Stru.STG1.Cells[0,mlidos-1]+')';

      minstru:=minstru+'('+Frm_Stru.STG1.Cells[0,mlidos-1];
      mcinst:='';
      if not DM1.Qr_Tid.Locate('TINOME',pnome,[]) then
         begin
         if trim(Frm_Stru.STG1.Cells[3,mlidos-1])<>'' then
            begin
            mcinst:=trim(Frm_Stru.STG1.Cells[3,mlidos-1]);
            if copy(mcinst,length(mcinst),1)=',' then
               mcinst:=copy(mcinst,1,length(mcinst)-1);
            minstru:=minstru+','+mcinst;
            end;
         end
      else if DM1.Qr_TIDTIQTD.AsInteger>0 then
         begin
         if trim(Frm_Stru.STG1.Cells[3,mlidos-1])<>'' then
            begin
            mcinst:=trim(Frm_Stru.STG1.Cells[3,mlidos-1]);
            if copy(mcinst,length(mcinst),1)=',' then
               mcinst:=copy(mcinst,1,length(mcinst)-1);
            minstru:=minstru+','+mcinst;
            end;
         end;


      minstru:=minstru+')';
      DM1.Query1.Close;
      DM1.Query1.SQL.Clear;
      DM1.Query1.SQL.Add(minstru);

//   ShowMessage('Comando: '+DM1.Query1.Text);
      Try
         DM1.Query1.ExecSQL;
         fdm1StartCommit;
         machou:=True;
      except
         DM1.Query1.SQL.SAVETOFILE('C:\SQL.TXT');

//         ex_erroSql(01,27410,'Frm_Stru',marqatual);
         machou:=False;
         end;

      if not (machou) and (Trim(mStru_ori)='')  then
         fStruimp(8,mlidos-1,0,marqatual,Frm_Stru.STG1.Cells[0,mlidos-1]);

      end;
   if ptipo=2 then
      begin
      mboolean:=true;
      if pbanco=0 then
         begin
         DM1.Query1.Close;
         DM1.Query1.SQL.Clear;
         DM1.Query1.SQL.Add('Select count(*) from user_objects '
                             +' where object_type='+chr(39)+'INDEX'+chr(39)
                             +' and object_name='+chr(39)+Frm_Stru.STG1.Cells[1,mlidos-1]+chr(39));
         DM1.Query1.Open;
         if DM1.Query1.Fields[0].AsInteger<=0 then
            mboolean:=false;
         end
      else
         begin
         DM1.Query1.Close;
         DM1.Query1.SQL.Clear;
         DM1.Query1.SQL.Add('ALTER INDEX '+Frm_Stru.STG1.Cells[1,mlidos-1]+' ACTIVE');
         try
            DM1.Query1.ExecSQL;
            fdm1StartCommit;
         except
            mboolean:=false;
            end;
         end;
     if  not mboolean then
         begin
         if trim(mStru_ori)='' then
            fStruimp(11,mlidos-1,0,Frm_Stru.STG1.Cells[0,mlidos-1],marqatual);
         minstru:='Select count(*) as qtd, ';
         if (Frm_Stru.STG1.Cells[2,mlidos-1]='PRIMARIO') or (pbanco<>0)  then
            mcinst:=+iif(DM1.Qr_Tid.Locate('TINOME',pnome,[]),'',Frm_Stru.STG1.Cells[3,mlidos-1])+Frm_Stru.STG1.Cells[0,mlidos-1]
         else
            mcinst:=Frm_Stru.STG1.Cells[0,mlidos-1];
         minstru:=minstru+mcinst;
         minstru:=minstru+' From '+marqatual+' Group by ';
         minstru:=minstru+mcinst+' having count(*)>1 ';
         DM1.Query2.Close;
         DM1.Query2.SQL.Clear;
         DM1.Query2.SQL.Add(minstru);
         DM1.Query2.Open;
         While not DM1.Query2.Eof do
            begin
            if trim(mStru_ori)='' then
               fStruimp(10,mlidos-1,0,marqatual,Frm_Stru.STG1.Cells[0,mlidos-1]);
            DM1.Query2.Next;
            end;
         end;
      end;
   end;
result:=True;
end;
