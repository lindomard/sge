for x:=0 to Frm_Stru.STG1.RowCount-1 do
   begin
   if Trim(Frm_Stru.STG1.Cells[0,x])='' then
      Continue;
   if (pBanco<>0) then
      begin
      if (Frm_Stru.STG1.Cells[1,x]=pcInteger) or
