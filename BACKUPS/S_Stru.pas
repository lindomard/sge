DM1.Query3.SQL.Clear;
DM1.Query3.SQL.add('Select CACODEMP AS FPCODEMP, CACODLDR AS FPCODLDR,'
                  +'CANUMERO AS FPNUMERO,CADESD AS FPDESD, '
                  +'CACODFOR AS FPCODFOR,CADTEMIS AS FPDTEMIS, '
                  +'CADUP AS FPTIPO,CACODEMP AS FPDUP_CODEMP '
                  +',CODBCO,NOMBCO,CODCC,NOMCCU,CODDEP,NOMDEP,NATDC '
                  +',VALORP,CAVALOR AS FPDUP_VALOR '
                  +'FROM CADDAP,CADLDR '
                  +' WHERE  CODEMP = CACODEMP '
                  +' AND CODLDR=CACODLDR '
                  +' and CASTATUS<2 '
                  +' and CACODLDR<>0 '
                  );
