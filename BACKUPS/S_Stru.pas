      WriteLn(f,'   Frm_Stru.STG1.Cells[02,mlinha]:='+chr(39)+DM1.Query2.fieldbyName('CHAR_COL_DECL_LENGTH').AsString+chr(39)+';');
      WriteLn(f,'   Frm_Stru.STG1.Cells[03,mlinha]:='+chr(39)+''+chr(39)+';');
