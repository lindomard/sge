function TFrm_Stru.fErroTrigger(pCodigo: Integer;pTexto: String): boolean;
begin
{
AssignFile(f,'c:\TRIG_'+IntToStr(pcodigo)+'.TXT');
rewrite(f);
WriteLn(f,'Erro ao testar trigger: '+IntTostr(pcodigo)+' Texto: '+pTexto);
closefile(f);
}
result:=true;

end;
procedure TFrm_Stru.bbCriarTriggersClick(Sender: TObject);
begin
{
if (pbanco=1) or (pbanco=2) then
   begin

   if not ftestainterb(0) then
      exit;
   end;
}
FCriarTriggers(1); // excluir
FCriarTriggers(0); // Criar
if (pbanco=1) or (pbanco=2) then
   begin
   Frm_Stru2.Free;
   end;

end;
function TFrm_Stru.ftestainterb(ptipo: Integer): Boolean;
begin

   if Frm_Stru2=nil then
      Application.CreateForm(TFrm_Stru2, Frm_Stru2)
   else
      begin
      Frm_Stru2.Free;
      Frm_Stru2:=nil;
      Application.CreateForm(TFrm_Stru2, Frm_Stru2);
      end;

Frm_Stru2.ShowModal;
Frm_Stru2.Free;
Frm_Stru2:=nil;

result:=true;
if not Frm_Stru2.IBDatabase1.Connected then
   begin
   try
      Frm_Stru2.IBDatabase1.Connected:=True;
   except
      MessageDlg('Não Foi possível abrir o Banco de Dados!',mtError,[mbOk],0);
      result:=False;
      end;
   end;
end;



