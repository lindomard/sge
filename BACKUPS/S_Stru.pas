//   fMensagem('query5',0,['0'],0);

   mtotalProc:=0;

   While not DM1.Query5.Eof do
      begin

      if Arredonda(mtotalProc,2)>=Arredonda(DM1.Query6.FieldByName('P1TOTALL').AsFloat,2) then
         begin
         DM1.Query1.Close;
         DM1.Query1.sql.Clear;
         DM1.Query1.sql.Add('Delete from CADPFP where PFPCODEMP=0'+DM1.Query5.fieldbyName('PFPCODEMP').AsString
                           +' and PFPCHAVE=0'+DM1.Query5.fieldbyName('PFPCHAVE').AsString
                           +' and PFPSEQ=0'+DM1.Query5.fieldbyName('PFPSEQ').AsString);
//         fmensagem('Tentoue deletar '+DM1.Query1.Text,0,['0'],0);
         try
            DM1.Query1.ExecSQL;
            fdm1StartCommit;
         except
            exit;
            end;
         end
      else
         begin
         mtotalProc:=mtotalProc+DM1.Query5.fieldbyName('PFPVALOR').AsFloat;
//         fMensagem('query5 mtotalproc '+FloatToStr(mtotalProc)+' valor '+
//         DM1.Query5.FieldByName('PFPVALOR').AsString  ,0,['0'],0);

         end;
//      DM1.Query1.sql.savetofile('c:\sqlqr1.sql');
//      fMensagem('query1',0,['0'],0);

      DM1.Query5.Next;
      end;
   DM1.Query6.Next;
   end;
