function TFrm_Stru.fCriarTabelaDestino(ptipo: Integer; pTabela: String): Boolean;
{
o objetivo desta funcao é de criar uma tabela em paradox a partir dos
campos da tabela em oracle
}
var
mTamCpo: Integer;
begin
DM1.Query5.Close;
DM1.Query5.SQL.Clear;
DM1.Query5.SQL.add('SELECT * FROM USER_TAB_COLUMNS '
                  +' WHERE TABLE_NAME='+chr(39)+ptabela+chr(39));
DM1.Query5.Open;
if Tb_Destino.Active then
   Tb_Destino.Close;
Tb_Destino.FieldDefs.Clear;

While not DM1.Query5.Eof do
   begin
   if DM1.Query5.FieldByName('DATA_TYPE').AsString='VARCHAR2' then
      begin
      mTamCpo:=valint(DM1.Query5.FieldByName('CHAR_COL_DECL_LENGTH').AsString);
      Tb_Destino.FieldDefs.Add(DM1.Query5.FieldByName('COLUMN_NAME').AsString,ftString,mTamCpo,false);
      end
   else if DM1.Query5.FieldByName('DATA_TYPE').AsString='NUMBER' then
      begin
      mTamCpo:=valint(DM1.Query5.FieldByName('DATA_PRECISION').AsString);
      mTamCpo:=0;
      Tb_Destino.FieldDefs.Add(DM1.Query5.FieldByName('COLUMN_NAME').AsString,ftFloat,mTamCpo,false);
      end
   else if DM1.Query5.FieldByName('DATA_TYPE').AsString='LONG' then
      begin
      mTamCpo:=0;
      Tb_Destino.FieldDefs.Add(DM1.Query5.FieldByName('COLUMN_NAME').AsString,ftMemo,mTamCpo,false);
      end
   else if DM1.Query5.FieldByName('DATA_TYPE').AsString='LONG RAW' then
      begin
      mTamCpo:=0;
      Tb_Destino.FieldDefs.Add(DM1.Query5.FieldByName('COLUMN_NAME').AsString,ftBlob,mTamCpo,false);
      end
   else if DM1.Query5.FieldByName('DATA_TYPE').AsString='DATE' then
      begin
      mTamCpo:=0;
      Tb_Destino.FieldDefs.Add(DM1.Query5.FieldByName('COLUMN_NAME').AsString,ftDateTime,mTamCpo,false);
      end;
   DM1.Query5.Next;
   end;
Tb_Destino.CreateTable;
result:=true;
end;
