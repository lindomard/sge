procedure TFrm_Stru.bb_AnchietaClick(Sender: TObject);
var
x,nao_enc,mqtd, mlid: Integer;
mdata: TDateTime;
mchave: Real;
begin
minstru:='Confirma a Substituição do CFO dos Pedidos de Entrada?';
if fMensagem(pchar(minstru),0,['1','2'],2)<>mrYes then
   exit;

Application.Createform(TFrm_Agde, frm_Agde);
Frm_Agde.Label1.Caption:='Selecionando os CFOPS dos Pedidos de Entradas, aguarde...';
Frm_Agde.gb_progres.Visible:=True;
Frm_Agde.Show;
DM1.Query3.Close;
DM1.Query3.SQL.Clear;
DM1.Query3.SQL.Add('select pf2cfo from cadpf2 '
                  +' where pf2cfo>5000 '
                  +' group by pf2cfo ');
DM1.Query3.Open;
mplid:=0;
mpqtd:=DM1.Query3.RecordCount;

DM1.Query2.Close;
DM1.Query2.SQL.Clear;
DM1.Query2.Params.CreateParam(ftString,'CFOANT',ptInput);
DM1.Query2.Params.CreateParam(ftString,'CFONOV',ptInput);
DM1.Query2.SQL.add('Update CADPF2 set PF2CFO=:CFONOV '
                  +' where PF2CFO=:CFOANT ');
While not DM1.Query3.Eof do
   begin
   mplid:=mplid+1;
   Frm_Agde.Gauge1.Progress:=mplid*100 div mpqtd;
   if not flcadcfo(1,1,DM1.Query3.Fields[0].AsString) then
      begin
      DM1.Query3.Next;
      Continue;
      end;
   if DM1.Tb_CfoCFCFOENT.Value>0 then
      begin
      DM1.Query2.ParamByName('CFOANT').AsFloat := DM1.Query3.Fields[0].AsFloat;
      DM1.Query2.ParamByName('CFONOV').AsFloat := DM1.Tb_CfoCFCFOENT.Value;
      try
         DM1.Query2.ExecSQL;
         fdm1StartCommit;
      except
         end;
      end;
   DM1.Query3.Next;
   end;
Frm_Agde.gb_progres.Visible:=False;
Frm_Agde.Label1.Caption:='Concluido!';
end;

