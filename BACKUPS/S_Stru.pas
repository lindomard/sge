function TFrm_Stru.fstruveremp(pcampo: String): Boolean;
var
mpos: Integer;
mtam: Integer;
mtem: Boolean;
begin
mtam:=length(pcampo);
mtem:=False;
for mpos:=1 to mtam-5 do
   begin
   if LowerCase(copy(pcampo,mpos,6))='codemp' then
      begin
      mtem:=True;
      break;
      end;
   end;
result:=mtem;
end;

