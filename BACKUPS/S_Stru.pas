      fmensagem('Tipo do Campo: '+DM1.Query2.fieldbyName('DATA_TYPE').AsString+' Desconhecido '
               +'Nome do Campo: '+DM1.Query2.fieldbyName('COLUMN_NAME').AsString,0,['0'],0);
