unit S_Stru;
{

MELHOR RATEIO BEMATECH


SELECT VALOR,ALIQ,TRUNC(VALOR*8.95/100) AS DESC_RAT
,NVL(
(
select   sum(TRUNC( (VALOR*8.95/100),2))- TRUNC((SUM(VALOR)*8.95/100),2) AS TOTAL
FROM TESTE_ECF CONS WHERE CONS.ALIQ=ORIGEM.ALIQ
HAVING MIN(CONS.ITEM)=ORIGEM.ITEM
),0) AS DIF FROM TESTE_ECF ORIGEM

UPDATE CADPRO SET PDPRECO1=ROUND(PDPRECO1,2)
WHERE PDPRECO1<>ROUND(PDPRECO1,2)


UPDATE CADP02 SET P2PRECO=ROUND(P2PRECO,2)
WHERE P2PRECO<>ROUND(P2PRECO,2)
                                                                   

ALTER SEQUENCE PED2011 INCREMENT BY 1
SELECT PED2011.CURRVAL FROM DUAL
SELECT PED2011.NEXTVAL FROM DUAL

ALTER TABLESPACE "DADOS" 
    ADD 
    DATAFILE 'D:\ORACLE\PRODUCT\10.2.0\oradata\DADOUNDG\DADOS1.ora' SIZE 6G
}
