Function TFrm_Stru.fHabDes_trigger(ptipo: Integer; ptabela: String): Boolean;
// O-HABILITA 1-DESABILITA
var
pcomando: String;
begin
if pbanco<>0 then
   begin
   if ptipo=0 then
      pcomando:='ACTIVE'
   else
      pcomando:='INACTIVE';
   end
else
   begin
   if ptipo=0 then
      pcomando:='ENABLE'
   else
      pcomando:='DISABLE';
   end;


DM1.Query1.Close;
DM1.Query1.SQL.Clear;
if (pbanco=1) or (pbanco=2) then
   begin
   DM1.Query1.SQL.Add('SELECT RDB$TRIGGER_NAME FROM RDB$TRIGGERS ');
   if trim(pTabela)<>'' then
      DM1.Query1.SQL.Add(' where RDB$TRIGGER_NAME like '+chr(39)+pTabela+'%'+chr(39));
   end
else
   begin
   DM1.Query1.SQL.Add('SELECT object_name FROM user_objects '
                     +' where object_type='+chr(39)+'TRIGGER'+chr(39));
   if trim(pTabela)<>'' then
      DM1.Query1.SQL.Add(' and object_name like '+chr(39)+pTabela+'%'+chr(39));
   end;
DM1.Query1.Open;
While not DM1.Query1.Eof do
   begin
   if copy(DM1.Query1.Fields[0].AsString,1,4)='RDB$' then
      begin
      DM1.Query1.Next;
      Continue;
      end;
   DM1.Query2.Close;
   DM1.Query2.SQL.Clear;
   DM1.Query2.SQL.Add('ALTER TRIGGER '+DM1.Query1.Fields[0].AsString+' '+pcomando);
   Try
      DM1.Query2.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql(02,32927,'Frm_Stru','TRIGGERS');
      end;
   DM1.Query1.Next;
   end;
result:=True;
end;
