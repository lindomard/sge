procedure TFrm_Stru.bbProcessar_cadp02Click(Sender: TObject);
var
mTamanho: Integer;
mValues: String;
begin
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.add('SELECT COUNT(*) FROM ALL_USERS '
                   +' where USERNAME='+chr(39)+edt_usuario.Text+chr(39));
try
   DM1.query1.Open;
except
   MessageDlg('Erro ao Abrir ALL_USERS',mtWarning,[mbOk],0);
   exit;
   end;
if DM1.Query1.fields[0].AsInteger<1 then
   begin
   DM1.query1.SQL.SaveToFile('c:\sql.txt');

   MessageDlg('Não Foi Encontrado o Usuário: '+edt_usuario.Text+'!',mtWarning,[mbok],0);
   exit;
   end;


DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.add('SELECT COUNT(*) FROM '+edt_usuario.Text+'.'+edt_nomtab.Text);
try
   DM1.query1.Open;
except
   DM1.query1.SQL.SaveToFile('c:\sql.txt');
   MessageDlg('Erro ao Abrir '+edt_usuario.Text+'.'+edt_nomtab.Text,mtWarning,[mbOk],0);
   exit;
   end;
if DM1.Query1.fields[0].AsInteger<1 then
   begin
   MessageDlg('Não Foi Encontrado a Tabela: '+edt_usuario.Text+'.'+edt_nomtab.Text+'!',mtWarning,[mbok],0);
   exit;
   end;
Memo_historico.Lines.Clear;
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.add('Select COLUMN_NAME,DATA_TYPE,DATA_LENGTH,DATA_PRECISION,DATA_SCALE,CHAR_COL_DECL_LENGTH  '
                  +' from USER_TAB_COLUMNS where TABLE_NAME='+chr(39)+'CADP02'+chr(39));
try
   DM1.Query1.Open;
except
   DM1.query1.SQL.SaveToFile('c:\sql.txt');
   MessageDlg('Erro ao abrir user tab_columns!!',mtWarning,[mbOk],0);
   exit;
   end;
While not DM1.Query1.Eof do
   begin
   if (DM1.Query1.FieldByName('DATA_TYPE').AsString='NUMBER') then
      begin
      DM1.Query2.Close;
      DM1.Query2.SQL.clear;
      DM1.Query2.SQL.Add('UPDATE '+edt_usuario.Text+'.'+edt_nomtab.Text
                        +' SET '+DM1.Query1.fieldbyName('COLUMN_NAME').AsString
                        +'=round('+DM1.Query1.fieldbyName('COLUMN_NAME').AsString+',3)');
      try
         DM1.Query2.ExecSQL;
         fdm1StartCommit;
      Except
         end;
      if DM1.Query1.FieldByName('DATA_PRECISION').Asinteger>0 then
         begin
         DM1.Query2.Close;
         DM1.Query2.SQL.clear;
         DM1.Query2.SQL.Add('ALTER TABLE CADP02 modify '+DM1.Query1.fieldbyName('COLUMN_NAME').AsString
                           +' NUMBER ');
         try
            DM1.Query2.ExecSQL;
            fdm1StartCommit;
         Except
            end;
         end;
      end;

   DM1.Query1.Next;
   end;

DM1.Query1.First;


While not DM1.Query1.Eof do
   begin
   if (DM1.Query1.FieldByName('DATA_TYPE').AsString='LONG') or
      (DM1.Query1.FieldByName('DATA_TYPE').AsString='LONG RAW') or
      (DM1.Query1.FieldByName('DATA_TYPE').AsString='DATE') then
      begin
      DM1.Query1.Next;
      Continue;
      end;
   mTamanho:=0;
   if DM1.Query1.FieldByName('DATA_TYPE').AsString='NUMBER' then
      begin
      if DM1.Query1.FieldByName('DATA_PRECISION').AsInteger>0 then
         mTamanho:=DM1.Query1.FieldByName('DATA_PRECISION').AsInteger;
      end
   else
      mTamanho:=DM1.Query1.FieldByName('CHAR_COL_DECL_LENGTH').AsInteger;
   if mTamanho<=0 then
      begin
      DM1.Query1.Next;
      Continue;
      end;
   DM1.Query2.Close;
   DM1.Query2.SQL.Clear;
   DM1.Query2.SQL.add('SELECT MAX('+DM1.Query1.fieldbyName('COLUMN_NAME').AsString+') AS TAMANHO from '
                     +edt_usuario.Text+'.'+edt_nomtab.Text+' CADP02');
   DM1.Query2.Open;
   if length(DM1.Query2.FieldByName('TAMANHO').AsString)>mTamanho then
      begin
      Memo_historico.Lines.Add('Campo: '+DM1.Query1.fieldbyName('COLUMN_NAME').AsString+' Tamanho Esperado: '+IntToStr(mTamanho));
      Memo_historico.Lines.Add('Tamanho Encontrado: '+IntToStr(length(DM1.Query2.FieldByName('TAMANHO').AsString)));
      Memo_historico.Lines.Add(insere2('=','=',80));
      end;

   DM1.Query1.Next;
   end;

DM1.Query2.Close;
DM1.Query2.SQL.clear;
DM1.Query1.First;
DM1.query2.SQL.Add('Insert into CADP02 ('+DM1.Query1.FieldbyName('COLUMN_NAME').AsString);
mValues:=DM1.Query1.FieldbyName('COLUMN_NAME').AsString;
DM1.Query1.Next;
While not DM1.Query1.Eof do
   begin
   DM1.query2.SQL.Add(','+DM1.Query1.FieldbyName('COLUMN_NAME').AsString);
   mValues:=mValues+','+DM1.Query1.FieldbyName('COLUMN_NAME').AsString;
   DM1.Query1.Next;
   end;
DM1.Query2.sql.Add(') Select  '+mValues+' from '+edt_usuario.Text+'.'+edt_nomtab.Text);
try
   DM1.Query2.ExecSQL;
   fdm1StartCommit;
except
   DM1.Query2.SQL.SaveToFile('c:\sql.txt');
   end;


end;

