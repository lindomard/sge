procedure TFrm_Stru.bbCap02_LotesClick(Sender: TObject);
var
Query_lote: Tquery;
Query_exe: TQuery;
Query_temp: TQuery;
mQtd_Falta: Real;
mQtd_Proc: Real;
begin
Application.CreateForm(TFrm_Agde, Frm_Agde);
Frm_Agde.gb_progres.Visible:=true;
Frm_Agde.Label1.Caption:='Aguarde enquanto é verificado os lotes das mercadorias';
Frm_Agde.Show;
mpqtd:=0;
mplid:=0;
Query_Temp:=TQuery.create(nil);
Query_Temp.DatabaseName:='SG_ASSOC';

Query_lote:=TQuery.create(nil);
Query_lote.DatabaseName:='SG_ASSOC';
Query_exe:=TQuery.create(nil);
Query_exe.DatabaseName:='SG_ASSOC';

query_lote.close;
Query_lote.Sql.Clear;
Query_lote.Sql.Add('select SUM(P2LM_QTD) AS QTDLOTE,P2QTD '
                  +' ,P2LM_CHAVE,P2LM_LOTSEQ,P2LM_CODEMP,P2LM_CODPRO,P2LM_ITEM '
                  +' FROM CADP02_LOTES,CADP02  '
                  +' WHERE P2CODEMP=P2LM_CODEMP '
                  +' AND P2CHAVE=P2LM_CHAVE '
                  +' AND P2LOTSEQ=P2LM_LOTSEQ '
                  +' AND P2CODPRO=P2LM_CODPRO '
                  +' AND P2ITEM=P2LM_ITEM '
                  +' GROUP BY P2QTD,P2LM_CHAVE,P2LM_LOTSEQ,P2LM_CODEMP,P2LM_CODPRO,P2LM_ITEM '
                  +' HAVING SUM(P2LM_QTD)<>P2QTD ');
Query_Lote.Open;
mpqtd:=Query_lote.RecordCount;
While not Query_Lote.eof do
   begin
   mplid:=mplid+1;
   Frm_Agde.Gauge1.Progress:=mplid*100 div mpQTD;
   verteclado(0);
   query_temp.Close;
   query_temp.sql.clear;
   query_temp.sql.Add('Select * from CADP02_LOTES where '
                     +' P2LM_CODEMP=:CODEMP '
                     +' and P2LM_CHAVE=:CHAVE '
                     +' and P2LM_LOTSEQ=:LOTSEQ '
                     +' and P2LM_CODPRO=:CODPRO '
                     +' and P2LM_ITEM=:ITEM ');
   query_temp.ParamByName('CODEMP').AsInteger:=Query_Lote.fieldbyName('P2LM_CODEMP').AsInteger;
   query_temp.ParamByName('CHAVE').AsInteger :=Query_Lote.fieldbyName('P2LM_CHAVE').AsInteger;
   query_temp.ParamByName('LOTSEQ').AsInteger :=Query_Lote.fieldbyName('P2LM_LOTSEQ').AsInteger;
   query_temp.ParamByName('CODPRO').AsFloat  :=Query_Lote.fieldbyName('P2LM_CODPRO').AsFloat;
   query_temp.ParamByName('ITEM').AsFloat    :=Query_Lote.fieldbyName('P2LM_ITEM').AsFloat;
   Query_Temp.Open;


   if Query_Lote.FieldByName('QTDLOTE').AsFloat<Query_Lote.FieldByName('P2QTD').AsFloat then
      begin
      mQtd_Proc:=Query_Lote.FieldByName('QTDLOTE').AsFloat-Query_Lote.FieldByName('P2QTD').AsFloat;

      query_exe.Close;
      query_exe.sql.clear;
      query_exe.sql.Add('Update CADP02_LOTES set P2LM_QTD=P2LM_QTD-:QTD_FALTA where '
                        +' P2LM_CODEMP=:CODEMP '
                        +' and P2LM_CHAVE=:CHAVE '
                        +' and P2LM_LOTSEQ=:LOTSEQ '
                        +' and P2LM_CODPRO=:CODPRO '
                        +' and P2LM_ITEM=:ITEM ');
      query_exe.ParamByName('QTD_FALTA').AsFloat  :=mQtd_Proc;
      query_exe.ParamByName('CODEMP').AsInteger:=Query_Lote.fieldbyName('P2LM_CODEMP').AsInteger;
      query_exe.ParamByName('CHAVE').AsInteger :=Query_Lote.fieldbyName('P2LM_CHAVE').AsInteger;
      query_exe.ParamByName('LOTSEQ').AsInteger :=Query_Lote.fieldbyName('P2LM_LOTSEQ').AsInteger;
      query_exe.ParamByName('CODPRO').AsFloat  :=Query_Lote.fieldbyName('P2LM_CODPRO').AsFloat;
      query_exe.ParamByName('ITEM').AsFloat  :=Query_Lote.fieldbyName('P2LM_ITEM').AsFloat;
      try
         Query_Exe.ExecSQL;
         fdm1StartCommit;
      except
         ex_erroSql_Novo(query_Exe,99554,'frm_venda_pre','CADP02_LOTES');
         exit;
         end;
      Query_lote.Next;
      Continue;
      end;


   query_exe.Close;
   query_exe.sql.clear;
   query_exe.sql.Add('Delete from CADP02_LOTES where '
                     +' P2LM_CODEMP=:CODEMP '
                     +' and P2LM_CHAVE=:CHAVE '
                     +' and P2LM_LOTSEQ=:LOTSEQ '
                     +' and P2LM_CODPRO=:CODPRO '
                     +' and P2LM_ITEM=:ITEM ');
   query_exe.ParamByName('CODEMP').AsInteger:=Query_Lote.fieldbyName('P2LM_CODEMP').AsInteger;
   query_exe.ParamByName('CHAVE').AsInteger :=Query_Lote.fieldbyName('P2LM_CHAVE').AsInteger;
   query_exe.ParamByName('LOTSEQ').AsInteger :=Query_Lote.fieldbyName('P2LM_LOTSEQ').AsInteger;
   query_exe.ParamByName('CODPRO').AsFloat  :=Query_Lote.fieldbyName('P2LM_CODPRO').AsFloat;
   query_exe.ParamByName('ITEM').AsFloat  :=Query_Lote.fieldbyName('P2LM_ITEM').AsFloat;
   try
      Query_Exe.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql_Novo(query_Exe,99554,'frm_venda_pre','CADP02_LOTES');
      exit;
      end;
   mQtd_Falta:=Query_Lote.fieldbyName('P2QTD').AsFloat;
   While (not Query_temp.Eof) and (mQtd_Falta>0) do
      begin
      if Query_temp.FieldByName('P2LM_QTD').asfloat>mQtd_Falta then
         mQtd_Proc:=mQtd_Falta
      else
         mQtd_Proc:=Query_temp.FieldByName('P2LM_QTD').asfloat;

      Query_Exe.Close;
      Query_Exe.SQL.Clear;
      Query_Exe.SQL.Add('Insert into CADP02_LOTES ('
                         +' P2LM_CODEMP '
                         +',P2LM_CODPRO '
                         +',P2LM_LOTSEQ '
                         +',P2LM_CHAVE '
                         +',P2LM_ITEM '
                         +',P2LM_LOTE '
                         +',P2LM_DTFAB '
                         +',P2LM_DTVCTO '
                         +',P2LM_QTD '
                         +') values ('
                         +' :P2LM_CODEMP '
                         +',:P2LM_CODPRO '
                         +',:P2LM_LOTSEQ '
                         +',:P2LM_CHAVE '
                         +',:P2LM_ITEM '
                         +',:P2LM_LOTE '
                         +',:P2LM_DTFAB '
                         +',:P2LM_DTVCTO '
                         +',:P2LM_QTD '
                         +') ');

      Query_Exe.ParambyName('P2LM_CODEMP').AsInteger :=Query_temp.FieldByName('P2LM_CODEMP').AsInteger;
      Query_Exe.ParambyName('P2LM_CODPRO').AsFloat   :=Query_temp.FieldByName('P2LM_CODPRO').asfloat;
      Query_Exe.ParambyName('P2LM_LOTSEQ').AsFloat   :=Query_temp.FieldByName('P2LM_LOTSEQ').asfloat;
      Query_Exe.ParambyName('P2LM_CHAVE').AsFloat    :=Query_temp.FieldByName('P2LM_CHAVE').asfloat;
      Query_Exe.ParambyName('P2LM_ITEM').AsFloat     :=Query_temp.FieldByName('P2LM_ITEM').asfloat;
      Query_Exe.ParambyName('P2LM_LOTE').AsString    :=Query_temp.FieldByName('P2LM_LOTE').asstring;
      Query_Exe.ParambyName('P2LM_DTFAB').AsDateTime :=Query_temp.FieldByName('P2LM_DTFAB').asDateTime;
      Query_Exe.ParambyName('P2LM_DTVCTO').AsDateTime:=Query_temp.FieldByName('P2LM_DTVCTO').asDateTime;
      Query_Exe.ParambyName('P2LM_QTD').AsFloat      :=mQtd_Proc;
      try
         Query_Exe.ExecSQL;
         fdm1StartCommit;
      except
         ex_erroSql_Novo(query_Exe,99588,'frm_venda_pre','CADP02_LOTES');
         exit;
         end;
      mQtd_Falta:=mQtd_Falta-mQtd_proc;
      Query_Temp.Next;
      end;
   Query_lote.Next;
   end;
// AJUSTANDO AS QUANTIDADE MENORES

//



FreeAndNil(Query_Temp);
FreeAndNil(Query_lote);
FreeAndNil(Query_exe);

Frm_Agde.Label1.Caption:='Concluido!';

end;

