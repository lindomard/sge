var
mtotalProc: Real;
begin
if (trim(MDT1.Text)='/  /') or (trim(MDT2.Text)='/  /') then
   begin
   fmensagem('Favor Digitar um Periodo valido!',0,['0'],0);
   exit;
   end;
DM1.Query6.Close;
