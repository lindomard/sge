procedure TFrm_Stru.bbdelTempClick(Sender: TObject);
var
x: Integer;
begin

DM1.Query3.Close;
if (pbanco=1) or (pbanco=2) then // interbase
   begin
   DM1.Query3.Close;
   DM1.Query3.SQL.Clear;
   DM1.Query3.SQL.add('SELECT RDB$RELATION_NAME FROM RDB$USER_PRIVILEGES '
                     +'       WHERE '
                     +'(RDB$RELATION_NAME LIKE '+chr(39)+'TEMP%'+chr(39)+') or '
                     +' (RDB$RELATION_NAME LIKE '+chr(39)+'TMPO%'+chr(39)+') or '
                     +' (RDB$RELATION_NAME LIKE '+chr(39)+'TEM%'+chr(39)+') or '
                     +' (RDB$RELATION_NAME LIKE '+chr(39)+'TTT%'+chr(39)+') '
                     +' group by RDB$RELATION_NAME ');
   DM1.Query3.Open;
   end
else if (pbanco=0) then // oracle
   begin
   DM1.Query3.Close;
   DM1.Query3.SQL.Clear;
   DM1.Query3.SQL.add('SELECT TABLE_NAME FROM USER_TAB_COLUMNS '
                     +' WHERE '
                     +' (TABLE_NAME LIKE '+chr(39)+'TEMP%'+chr(39)+') or '
                     +' (TABLE_NAME LIKE '+chr(39)+'TMPO%'+chr(39)+') or '
                     +' (TABLE_NAME LIKE '+chr(39)+'TEM%'+chr(39)+') or '
                     +' (TABLE_NAME LIKE '+chr(39)+'TTT%'+chr(39)+') ');
   DM1.Query3.SQL.add(' or TABLE_NAME LIKE '+chr(39)+'%_LT%'+chr(39));

   DM1.Query3.Open;
   end;
if DM1.Query3.Active then
   begin
   While not DM1.Query3.Eof do
      begin
      DM1.Query1.Close;
      DM1.Query1.SQL.Clear;
      DM1.Query1.SQL.add('drop table '+DM1.Query3.Fields[0].AsString);
      try
         DM1.Query1.ExecSQL;
         fdm1StartCommit;
      except
        DM1.Query1.Close;
        DM1.Query1.SQL.Clear;
        DM1.Query1.SQL.add('drop view '+DM1.Query3.Fields[0].AsString);
        try
           DM1.Query1.ExecSQL;
           fdm1StartCommit;
        except
          end;
        end;
      DM1.Query3.Next;
      end;
   end;
FileListBox1.Directory:='\SGE\TEMP';
FileListBox1.Mask:='t*.*';
FileListBox1.Update;
for x:=0 to FileListBox1.Count-1 do
   begin
   try
      DeleteFile(FileListBox1.Items[x]);
   except
      end;
   end;

FileListBox1.Directory:='\SGE\LOG';
FileListBox1.Mask:='L*.*';
FileListBox1.Update;
for x:=0 to FileListBox1.Count-1 do
   begin
   try
      DeleteFile(FileListBox1.Items[x]);
   except
      end;
   end;

FileListBox1.Directory:='\SGE\ERROSQL';
FileListBox1.Mask:='E*.*';
FileListBox1.Update;
for x:=0 to FileListBox1.Count-1 do
   begin
   try
      DeleteFile(FileListBox1.Items[x]);
   except
      end;
   end;
MessageDlg('Concluido!',mtWarning,[mbOk],0);

end;

procedure TFrm_Stru.bbAjuspedClick(Sender: TObject);
var
mpu:Real;
begin
if trim(MDT1.Text)='/  /' then
   begin
   MessageDlg('Favor Digitar a data Inicial!',mtWarning,[mbOk],0);
   MDT1.SetFocus;
   exit;
   end;

if fmensagem('Quer Realmente Ajustar o Preço de Compra dos Produtos?',0,['1','2'],2)<>mrYes  then
   exit;
Application.CreateForm(TFrm_Agde, Frm_Agde);
Frm_Agde.Label1.Caption:='Atualizando os Preços de Compra das Mercadorias! aguarde...';
Frm_Agde.gb_progres.Visible:=true;
Frm_Agde.Show;
Frm_Agde.Update;
DM1.Query3.Close;
DM1.Query3.SQL.Clear;
DM1.Query3.SQL.Add('Select PF2QTDP, PF2PU,PF2TOTDES,PF2CODPRO from CADPF1,CADPF2 '
                  +' where PF1CODEMP>0 '
                  +' and PF2CODEMP=PF1CODEMP '
                  +' AND PF2LOTSEQ=PF1LOTSEQ '
                  +' AND PF2CHAVE=PF1CHAVE '
                  +' and PF1DATA>='+chr(39)+FormatDatetime(fdt, StrToDate(MDT1.Text))+chr(39));
if trim(MDT2.Text)<>'/  /' then
   DM1.Query3.Sql.add(' and PF1DATA<='+chr(39)+FormatDatetime(fdt, DM1.Query3.fieldbyName('PF1DATAP').AsDateTime)+chr(39));
DM1.Query3.Sql.add(' and PF1STATUS>0 AND PF1STATUS<9');

DM1.Query3.Open;
mpqtd:=DM1.query3.RecordCount;
if mpqtd<0 then
   begin
   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;
   DM1.Query1.SQL.Add('Select count(*) from CADPF1,CADPF2 '
                     +' where PF1CODEMP>0 '
                     +' and PF2CODEMP=PF1CODEMP '
                     +' AND PF2LOTSEQ=PF1LOTSEQ '
                     +' AND PF2CHAVE=PF1CHAVE '
                     +' and PF1DATA>='+chr(39)+FormatDatetime(fdt, StrToDate(MDT1.Text))+chr(39));
   if trim(MDT2.Text)<>'/  /' then
      DM1.Query1.Sql.add(' and PF1DATA<='+chr(39)+FormatDatetime(fdt, DM1.Query3.fieldbyName('PF1DATAP').AsDateTime)+chr(39));
   DM1.Query1.Sql.add(' and PF1STATUS>0 AND PF1STATUS<9');
   DM1.Query1.Open;
   mpqtd:=DM1.Query1.Fields[0].AsInteger;
   end;
mplid:=0;
