function TFrm_Stru.fRetTruncado(PValor:String): Integer;
var
  x: integer;
  maux: string;
begin
maux:='0';
pValor:=Trim(Pvalor);
for x:=1 to Length(PValor) do
   begin
   If PValor[x] in ['0'..'9'] then
      maux:=maux+PValor[x]
   else if PValor[x] in [',','.'] then
      break;
   end;
Result:=StrToInt(maux);
end;
