   mTot_Dif_ValSeg     := mTot_Ped02_ValSeg     - mTot_pItem_ValSeg;
   mTot_Dif_TotDes     := mTot_Ped02_TotDes     - mTot_pItem_TotDes;
   mTot_Dif_ValRepas   := mTot_Ped02_ValRepas   - mTot_pItem_ValRepas;
   mTot_Dif_Basen      := mTot_Ped02_Basen      - mTot_pItem_Basen;
   mTot_Dif_Icmsn      := mTot_Ped02_Icmsn      - mTot_pItem_Icmsn;
   mTot_Dif_Icmsr      := mTot_Ped02_Icmsr      - mTot_pItem_Icmsr;
   mTot_Dif_Baser      := mTot_Ped02_Baser      - mTot_pItem_Baser;
   mTot_Dif_ValIPI     := mTot_Ped02_ValIPI     - mTot_pItem_ValIPI;
   mTot_Dif_ICMS_SN    := mTot_Ped02_ICMS_SN    - mTot_pItem_ICMS_SN;

   if (mTot_Dif_DescCab<>0) or (mTot_Dif_TotDescRat<>0) or
      (mTot_Dif_TotAcrecRat<>0) or (mTot_Dif_DespAces<>0) or
      (mTot_Dif_ValSeg<>0) or (mTot_Dif_TotDes<>0) or
      (mTot_Dif_ValRepas<>0) or (mTot_Dif_Basen<>0) or
      (mTot_Dif_Icmsn<>0) or (mTot_Dif_Icmsr<>0) or
      (mTot_Dif_Baser<>0) or (mTot_Dif_ValIPI<>0) or
      (mTot_Dif_ICMS_SN<>0)  then
      Update CADP02_CMET set P2CM_PITEM_DESC_CAB=P2CM_PITEM_DESC_CAB+mTot_Dif_DescCab
                          ,P2CM_PITEM_DESCRAT=P2CM_PITEM_DESCRAT+mTot_Dif_TotDescRat
                          ,P2CM_PITEM_DESPACES=P2CM_PITEM_DESPACES+mTot_Dif_DespAces
                          ,P2CM_PITEM_VALSEG=P2CM_PITEM_VALSEG+mTot_Dif_ValSeg
                          ,P2CM_PITEM_TOTDES=P2CM_PITEM_TOTDES+mTot_Dif_TotDes
                          ,P2CM_PITEM_PREPAS=P2CM_PITEM_PREPAS+mTot_Dif_ValRepas
                          ,P2CM_PITEM_BASEN=P2CM_PITEM_BASEN+mTot_Dif_Basen
                          ,P2CM_PITEM_ICMSN=P2CM_PITEM_ICMSN+mTot_Dif_Icmsn
                          ,P2CM_PITEM_ICMSR=P2CM_PITEM_ICMSR+mTot_Dif_Icmsr
                          ,P2CM_PITEM_BASER=P2CM_PITEM_BASER+mTot_Dif_Baser
                          ,P2CM_PITEM_VALIPI=P2CM_PITEM_VALIPI+mTot_Dif_ValIPI
                          ,P2CM_PITEM_VLRICMS_SN=P2CM_PITEM_VLRICMS_SN+mTot_Dif_ICMS_SN
                          ,P2CM_PITEM_ACRECRAT=P2CM_PITEM_ACRECRAT+mTot_Dif_TotAcrecRat
       where P2CM_CODEMP=:NEW.P2T_CODEMP and
         P2CM_CHAVE=:NEW.P2T_CHAVE and
         P2CM_LOTSEQ=:NEW.P2T_CHAVE_ANO and
          P2CM_ITEM=:NEW.P2T_ITEM
          and P2CM_CODIGO=mItemPed;
      end if;
   end if;




/* TERMINO DO CONTROLE ESPECIAL CMET */


Select sum(P2VCOMIS) into mTotalCOMIS
from CADP02
WHERE P2CODEMP=:NEW.P2T_CODEMP
  and P2CHAVE=:NEW.P2T_CHAVE
  and P2LOTSEQ=:NEW.P2T_CHAVE_ANO;




update CADP01 set P1TOTALL=
                  nvl(:NEW.P2T_PED1_VALSEG,0)+:NEW.P2T_PED1_TARBAN
                  +:NEW.P2T_PED1_VALFRE+:NEW.P2T_PED1_DESPACES
                  +mTotalPed+mTotIPI,P1TOTALB=mTOTMER+MTOTSER
                  ,P1TOTSERLIQ=MTOTSER
                ,P1COMIS=mTotalCOMIS
                ,P1BASEN=mTotalBCICMS,p1ICMSN=mTotalICMS,P1TOTDES=mTotalDesc_Prod+mTotalDesc_Serv
                ,P1BASER=mTotalBCST
                ,P1DATHOR_UEVE=SYSDATE
                ,P1ICMSR=mTotalICMSR
                ,P1VLRDES=mTotalDescRat_Prod+mTotalDescRat_Serv
                ,P1IPIINA=mtotipi
                ,P1VALSEG=:NEW.P2T_PED1_VALSEG
                ,P1TARBAN=:NEW.P2T_PED1_TARBAN
                ,P1DESPACES=:NEW.P2T_PED1_DESPACES
                ,P1VALFRE=:NEW.P2T_PED1_VALFRE
                where P1CODEMP=:NEW.P2T_CODEMP AND P1CHAVE=:NEW.P2T_CHAVE AND
                P1LOTSEQ=:NEW.P2T_CHAVE_ANO;


BEGIN
        update CADP01 SET P1PCOMIS=round(nvl(P1COMIS,0)/NVL(P1TOTALL,0)*100,2)
                where P1CODEMP=:NEW.P2T_CODEMP AND P1CHAVE=:NEW.P2T_CHAVE AND
                P1LOTSEQ=:NEW.P2T_CHAVE_ANO;

EXCEPTION
  WHEN OTHERS THEN
--         RAISE_APPLICATION_ERROR(-20000, 'ATRIBUIU NULO P1PCOMIS' );
          RAISE;
      END;


IF :NEW.P2T_ALTDUP<>'N' then

   if :NEW.P2T_QTDDUP>0 then

     Select sum(P1TOTALL) into mTotalPed from CADP01
                                 WHERE P1CODEMP=:NEW.P2T_CODEMP
                                 and P1CHAVE=:NEW.P2T_CHAVE
                                 and P1LOTSEQ=:NEW.P2T_CHAVE_ANO;


      mValorDup := trunc( (mTotalPed / :NEW.P2T_QTDDUP) ,2);
      mDifDup := mTotalPed - (mValorDup * :NEW.P2T_QTDDUP);


      if mvalordup is null then
         mvalordup:=0;
         end if;

      if :NEW.P2T_QTDDUP!=:NEW.P2T_QTDDUP_ANT THEN
         delete from CADPFP where PFPCODEMP=:NEW.P2T_CODEMP
                                 and PFPCHAVE=:NEW.P2T_CHAVE
                                 and PFPLOTSEQ=:NEW.P2T_CHAVE_ANO;
         while l_loop < :NEW.P2T_QTDDUP loop
            l_loop := l_loop +  1;
            insert into CADPFP (PFPCODEMP,PFPCHAVE,PFPORDEM,PFPLOTSEQ
                           ,PFPSEQ
                           ,PFPQTDPARC
                          ,PFPFORMA
                          ,PFPVALOR
                          ,PFPBAIXA
                          ,PFPNOMFOR
                          ,PFPPRAZO
                          ,PFPDATA
                          ,PFPFPGTO
                          ,PFPVINCULO

                          ) values (
                           :NEW.P2T_CODEMP,:NEW.P2T_CHAVE,01,:NEW.P2T_CHAVE_ANO
                          ,l_loop
                          ,:NEW.P2T_QTDDUP
                          ,:NEW.P2T_CODFP
                          ,mValorDup+mDifDup
                          ,:NEW.P2T_BAIXA
                          ,:NEW.P2T_NOMFP
                          ,substr(:NEW.P2T_PRAZOS,pos_ini,4)
                          ,:NEW.P2T_DATAPED+TO_NUMBER(substr(:NEW.P2T_PRAZOS,pos_ini,4))
                          ,100/:NEW.P2T_QTDDUP
                          ,(select MAX(fpvinculo) from cadfp where fpcodigo=:NEW.P2T_CODFP)
                          );
            pos_ini := pos_ini + 4;
            mDifDup := 0;
         end loop;
      else
         if mvalordup is null then
            mvalordup:=0;
            end if;
         Update CADPFP set PFPVALOR=mValorDup + case when  pfpSEQ=1 then
         mDifDup else 0 end
                                  where PFPCODEMP=:NEW.P2T_CODEMP
                                  and PFPCHAVE=:NEW.P2T_CHAVE
                                  and PFPLOTSEQ=:NEW.P2T_CHAVE_ANO;

      end if;
   end if;
end if;

end;
}
