      FieldName = 'PDNOMGRU'
      Size = 40
    end
    object qr_relCODIGO_PRODUTO: TFloatField
      FieldName = 'CODIGO_PRODUTO'
    end
    object qr_relNOME_PRODUTO: TStringField
      FieldName = 'NOME_PRODUTO'
      Size = 53
    end
    object qr_relPDNOME_MP: TStringField
      FieldName = 'PDNOME_MP'
      Size = 53
