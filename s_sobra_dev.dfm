  object INF_CLIENTE: TQuery
    OnCalcFields = INF_CLIENTECalcFields
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      'SELECT '
      '    CCODCLI, CRAZAO,CCPF,CRG,CTPPESSOA,CCNPJ,CIE, '
      '    P1S_CHAVE, P1S_DATA_INC'
      'FROM CADP01_SOBRAS,CADCLI '
      'WHERE P1S_CODCLI=CCODCLI')
    Left = 352
    Top = 320
    object INF_CLIENTERG_IE: TStringField
