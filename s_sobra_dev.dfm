  object qr_rel: TQuery
    OnCalcFields = qr_relCalcFields
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      'Select '
      '        P2SMP_CODEMP, '
      '        P2SMP_LOTSEQ, '
      '        P2SMP_CHAVE, '
      '        P2SMP_ITEM,  '
      '        P2SMP_CODPRO,  '
      '        P2SMP_CODPRO_ORI,  '
      '        P2SMP_ORIGEM,'
      '        P2SMP_CODPRO_ORI,'
      '        P2SMP_PRECO_UNI, '
      '        P2SMP_PRECO_VEN, '
      '        P2SMP_PRECO_CUS, '
      '        P2SMP_QTD_SOBRA,  '
      '        P2SMP_QTD_VEN,  '
      '        P2SMP_QTD_DEV,  '
      '        P2SMP_QTD_QUE,'
      '        P2S_CODEMP, '
      '        P2S_LOTSEQ, '
      '        P2S_CHAVE, '
      '        P2S_ITEM,  '
      '        P2S_CODPRO,  '
      '        P2S_ORIGEM,'
      '        P2S_PRECO_UNI, '
      '        P2S_PRECO_VEN, '
      '        P2S_PRECO_CUS,'
      '        P2S_QTD_SOBRA,  '
      '        P2S_QTD_VEN,  '
      '        P2S_QTD_DEV,  '
      '        P2S_QTD_QUE,'
      'CASE '
      '  WHEN P2SMP_CODPRO IS NULL '
      '    THEN NULL '
      '  WHEN P2SMP_CODPRO IS NOT NULL '
      '    THEN P2SMP_CODPRO_ORI '
      'END AS CODIGO_AGRUPAMENTO,'
      'CASE '
      '  WHEN P2SMP_CODPRO IS NULL '
      
        '    THEN (SELECT PDCODGRU FROM CADPRO WHERE  PDCODPRO=P2S_CODPRO' +
        ')'
      '  WHEN P2SMP_CODPRO IS NOT NULL '
      
        '    THEN (SELECT PDCODGRU FROM CADPRO WHERE  PDCODPRO=P2SMP_CODP' +
        'RO) '
      'END AS PDCODGRU,'
      'CASE '
      '  WHEN P2SMP_CODPRO IS NULL '
      
        '    THEN (SELECT PDNOMGRU FROM CADPRO WHERE  PDCODPRO=P2S_CODPRO' +
        ')'
      '  WHEN P2SMP_CODPRO IS NOT NULL '
      
        '    THEN (SELECT PDNOMGRU FROM CADPRO WHERE  PDCODPRO=P2SMP_CODP' +
        'RO) '
      'END AS PDNOMGRU,'
      'CASE '
      '  WHEN P2SMP_CODPRO IS NULL '
      '    THEN P2S_CODPRO '
      '  WHEN P2SMP_CODPRO IS NOT NULL '
      '    THEN P2SMP_CODPRO '
      'END AS CODIGO_PRODUTO,'
      
        'CASE                                                            ' +
        '        '
      
        '   WHEN P2SMP_CODPRO IS NULL                                    ' +
        '         '
      
        '     THEN P2S_LOTSEQ                                            ' +
        '         '
      
        '  WHEN P2SMP_CODPRO IS NOT NULL                                 ' +
        '        '
      
        '     THEN P2SMP_LOTSEQ                                          ' +
        '         '
      
        ' END AS SEQ_GRUPO,                                              ' +
        '         '
      'CASE '
      '  WHEN P2SMP_CODPRO IS NULL '
      '    THEN (SELECT PDNOME FROM CADPRO WHERE  PDCODPRO=P2S_CODPRO) '
      '  WHEN P2SMP_CODPRO IS NOT NULL '
      
        '    THEN (SELECT PDNOME FROM CADPRO WHERE  PDCODPRO=P2SMP_CODPRO' +
        ')'
      'END AS NOME_PRODUTO,'
      
        '(SELECT PDNOME FROM CADPRO WHERE  PDCODPRO=P2SMP_CODPRO) AS PDNO' +
        'ME_MP,'
      
        '(SELECT PDNOME FROM CADPRO WHERE  PDCODPRO=P2S_CODPRO) AS PDNOME' +
        '_PA'
      'from   '
      #9'CADP02_SOBRAS,'#9'CADPRO,'#9'CADP02_SOBRAS_MP              '
      'Where  '
      
        '        PDCODPRO=P2s_CODPRO and  P2sMP_CODEMP(+)=P2s_CODEMP and ' +
        'P2sMP_LOTSEQ(+)=P2s_LOTSEQ and P2sMP_CHAVE(+)=P2s_CHAVE and '
      
        'P2sMP_CODPRO_ORI(+)=P2s_CODPRO and (P2S_CODEMP=01 or P2S_CODEMP=' +
        '0101)  ')
    Left = 320
    Top = 320
    object qr_relP2SMP_CODEMP: TFloatField
      FieldName = 'P2SMP_CODEMP'
    end
    object qr_relP2SMP_LOTSEQ: TFloatField
      FieldName = 'P2SMP_LOTSEQ'
    end
    object qr_relP2SMP_CHAVE: TFloatField
      FieldName = 'P2SMP_CHAVE'
    end
    object qr_relP2SMP_ITEM: TFloatField
      FieldName = 'P2SMP_ITEM'
    end
    object qr_relP2SMP_CODPRO: TFloatField
      FieldName = 'P2SMP_CODPRO'
    end
    object qr_relP2SMP_CODPRO_ORI: TFloatField
      FieldName = 'P2SMP_CODPRO_ORI'
    end
    object qr_relP2SMP_ORIGEM: TFloatField
      FieldName = 'P2SMP_ORIGEM'
    end
    object qr_relP2SMP_CODPRO_ORI_1: TFloatField
      FieldName = 'P2SMP_CODPRO_ORI_1'
    end
    object qr_relP2SMP_PRECO_UNI: TFloatField
      FieldName = 'P2SMP_PRECO_UNI'
    end
    object qr_relP2SMP_PRECO_VEN: TFloatField
      FieldName = 'P2SMP_PRECO_VEN'
    end
