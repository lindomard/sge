    object Memo_comando: TMemo
      Left = 526
      Top = -40
      Width = 627
      Height = 89
      Lines.Strings = (
        'SELECT '
        ''
        
          'PDCODPRO AS CODIGO_PRODUTO, PDNOME AS NOME_PRODUTO, PDUND AS UNI' +
          'DADE,PDCODBAR AS '
        'CODIGO_BARRAS, '
        
          'PDCODNCM AS CODNCM, PDCEST AS CEST, PDDTULTSAI AS DATA_ULT_SAIDA' +
          ', PDTABICM,'
        '(SELECT CALIQA FROM CADCLI WHERE CCODCLI=1 ) AS ALIQ_ICMS,'
        ''
        
          'PDFIS_ORIGEM AS ORIGEM_PRODUTO, PDFIS_CST_ICMS_EST_REV AS CST_RE' +
          'VENDA_DENTRO_ESTADO, '
        'PDFIS_CST_ICMS_EST_CF AS CST_REV_DENTRO_EST_CONSUFINAL,'
        'PDFIS_CST_ICMS_INT_REV AS CST_REVENDA_FORA_ESTADO,'
        'PDFIS_CST_ICMS_INT_CF AS CST_REV_FORA_EST_CONSFINAL,'
        
          'PDFIS_CST_PISCOF_ENTRADA AS PISCOFINS_ENTRADA, PDFIS_PIS_ALIQ_EN' +
          'TRADA AS ALIQUOTA_PIS_ENTRADA,'
        
          'PDFIS_COFINS_ALIQ_ENTRADA AS ALIQUOTA_COFINS_ENTRADA, PDFIS_COFI' +
          'NS_ALIQ_SAIDA AS '
        'ALIQUOTA_COFINS_SAIDA,'
        
          'PDFIS_CST_PISCOF_SAIDA AS PISCOFINS_SAIDA, PDFIS_PIS_ALIQ_SAIDA ' +
          'AS ALIQUOTA_PIS_SAIDA,'
        
          'PDCBENEF_CST_FORAE_REV AS CODBENEF_REV_FORAEST, PDCBENEF_CST_FOR' +
          'AE_CONSFIN AS '
        'CODBENEF_CONSF_FORAEST,'
        
          'PDCBENEF_CST_DENTROE_REV AS CODBENEF_REV_DENTROEST, PDCBENEF_CST' +
          '_DENTROE_CONSFIN AS '
        'CODBENEF_CONSF_DENTROEST'
        'FROM CADPRO'
        'WHERE PDDTULTSAI>:DTULTSAI'
        'ORDER BY PDNOME')
      TabOrder = 1
      Visible = False
    end
