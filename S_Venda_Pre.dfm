  object Tb_Ped02_Lotes: TQuery
    CachedUpdates = True
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      'Select '
      'SUM(P2LM_QTD) AS P2LM_QTD,'
      
        ' sum( CASE WHEN P2LM_CODEMP<100 THEN P2LM_QTD ELSE 0 END ) AS P2' +
        'LM_QTD_001 '
      
        '                   ,sum(  CASE WHEN P2LM_CODEMP<100 THEN 0 ELSE ' +
        'P2LM_QTD END) AS P2LM_QTD_101 '
      '                   ,P2LM_ITEM '
      '                   ,P2LM_LOTE '
      '                   ,P2LM_DTFAB,P2LM_DTVCTO,P2LM_CODPRO '
      '                   from CADP02_LOTES '
      '                    where (P2LM_CODEMP=1 or P2LM_CODEMP=101) '
      '                      and P2LM_CHAVE>1 '
      '                      and P2LM_LOTSEQ=0 '
      
        '                   GROUP BY P2LM_ITEM,P2LM_LOTE,P2LM_DTFAB,P2LM_' +
        'DTVCTO,P2LM_CODPRO ')
    UpdateObject = U_Ped02_Lotes
    Left = 846
    Top = 367
