  object U_Pend: TUpdateSQL
    ModifySQL.Strings = (
      'update CADPEN'
      'set'
      '  PECODEMP = :PECODEMP,'
      '  PELOTSEQ = :PELOTSEQ,'
      '  PECHAVE = :PECHAVE,'
      '  PECODCLI = :PECODCLI,'
      '  PECODVEN = :PECODVEN,'
      '  PEDATA = :PEDATA,'
      '  PEITEM = :PEITEM,'
      '  PECODPRO = :PECODPRO,'
      '  PEGRADE = :PEGRADE,'
      '  PEQTDPED = :PEQTDPED,'
      '  PEQTDENV = :PEQTDENV,'
      '  PEQTDPEN = :PEQTDPEN,'
      '  PEDESC01 = :PEDESC01,'
      '  PEDESC02 = :PEDESC02,'
      '  PEDESC03 = :PEDESC03,'
      '  PEVALDES = :PEVALDES,'
      '  PEPRECO = :PEPRECO,'
      '  PE_CHAVE_NIVEL = :PE_CHAVE_NIVEL'
      '   ,PEID_NEW =:PEID_NEW'
      '   ,PEID_PED01_NEW =:PEID_PED01_NEW'
      ''
      'where'
      '  PECODEMP = :OLD_PECODEMP and'
      '  PELOTSEQ = :OLD_PELOTSEQ and'
      '  PECHAVE = :OLD_PECHAVE and'
      '  PEITEM = :OLD_PEITEM and'
      '  PECODPRO = :OLD_PECODPRO')
    InsertSQL.Strings = (
      'insert into CADPEN'
      
        '  (PECODEMP, PELOTSEQ, PECHAVE, PECODCLI, PECODVEN, PEDATA, PEIT' +
        'EM, PECODPRO, '
      
        '   PEGRADE, PEQTDPED, PEQTDENV, PEQTDPEN, PEDESC01, PEDESC02, PE' +
        'DESC03, '
      '   PEVALDES, PEPRECO, PE_CHAVE_NIVEL'
      '   ,PEID_NEW'
      '   ,PEID_PED01_NEW'
      '   )'
      'values'
      
        '  (:PECODEMP, :PELOTSEQ, :PECHAVE, :PECODCLI, :PECODVEN, :PEDATA' +
        ', :PEITEM,'
      
        '   :PECODPRO, :PEGRADE, :PEQTDPED, :PEQTDENV, :PEQTDPEN, :PEDESC' +
        '01, :PEDESC02,'
      '   :PEDESC03, :PEVALDES, :PEPRECO, :PE_CHAVE_NIVEL'
      '   ,:PEID_NEW'
      '   ,:PEID_PED01_NEW'
      '   )')
    DeleteSQL.Strings = (
      'delete from CADPEN'
      'where'
      '  PECODEMP = :OLD_PECODEMP and'
      '  PELOTSEQ = :OLD_PELOTSEQ and'
      '  PECHAVE = :OLD_PECHAVE and'
      '  (PEITEM = :OLD_PEITEM OR PEITEM IS NULL)  and'
      '  PECODPRO = :OLD_PECODPRO')
    Left = 134
    Top = 191
  end
