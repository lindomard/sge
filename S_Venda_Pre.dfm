  object U_ped02S_pre: TUpdateSQL
    ModifySQL.Strings = (
      'update CADPFP'
      'set'
      '  PFPCODEMP = :PFPCODEMP,'
      '  PFPCHAVE = :PFPCHAVE,'
      '  PFPCHAVE_ANO = :PFPCHAVE_ANO,'
      '  PFPPARCELA = :PFPPARCELA,'
      '  PFPQTDPARC = :PFPQTDPARC,'
      '  PFPCODBCO_BOL = :PFPCODBCO_BOL,'
      '  PFPCODFP = :PFPCODFP,'
      '  PFPBAIXA = :PFPBAIXA,'
      '  PFPVALOR = :PFPVALOR,'
      '  PFPNOMFP = :PFPNOMFP,'
      '  PFPDATA = :PFPDATA,'
      '  PFPPRAZO = :PFPPRAZO,'
      '  PFPNUMDOC = :PFPNUMDOC,'
      '  PFPCODBCO_DOC = :PFPCODBCO_DOC,'
      '  PFPSERIE_DOC = :PFPSERIE_DOC,'
      '  PFPCC_DOC = :PFPCC_DOC,'
      '  PFPCOMP_DOC = :PFPCOMP_DOC,'
      '  PFPAGENCIA_DOC = :PFPAGENCIA_DOC,'
      '  PFPEMITENTE_DOC = :PFPEMITENTE_DOC,'
      '  PFPVINCULO_DOC = :PFPVINCULO_DOC,'
      '  PFPCNPJ_CPF_DOC = :PFPCNPJ_CPF_DOC,'
      '  PFPIE_RG = :PFPIE_RG'
      'where'
      '  PFPCODEMP = :OLD_PFPCODEMP and'
      '  PFPCHAVE = :OLD_PFPCHAVE and'
      '  PFPCHAVE_ANO = :OLD_PFPCHAVE_ANO and'
      '  PFPPARCELA = :OLD_PFPPARCELA')
    InsertSQL.Strings = (
      'insert into CADPFP'
      '  (PFPCODEMP, PFPCHAVE, PFPCHAVE_ANO, PFPPARCELA, PFPQTDPARC, '
      'PFPCODBCO_BOL, '
      '   PFPCODFP, PFPBAIXA, PFPVALOR, PFPNOMFP, PFPDATA, PFPPRAZO, '
      'PFPNUMDOC, '
      '   PFPCODBCO_DOC, PFPSERIE_DOC, PFPCC_DOC, PFPCOMP_DOC, '
      'PFPAGENCIA_DOC, '
      '   PFPEMITENTE_DOC, PFPVINCULO_DOC, PFPCNPJ_CPF_DOC, PFPIE_RG)'
      'values'
      
        '  (:PFPCODEMP, :PFPCHAVE, :PFPCHAVE_ANO, :PFPPARCELA, :PFPQTDPAR' +
        'C, '
      ':PFPCODBCO_BOL, '
      
        '   :PFPCODFP, :PFPBAIXA, :PFPVALOR, :PFPNOMFP, :PFPDATA, :PFPPRA' +
        'ZO, '
      ':PFPNUMDOC, '
      '   :PFPCODBCO_DOC, :PFPSERIE_DOC, :PFPCC_DOC, :PFPCOMP_DOC, '
      ':PFPAGENCIA_DOC, '
      
        '   :PFPEMITENTE_DOC, :PFPVINCULO_DOC, :PFPCNPJ_CPF_DOC, :PFPIE_R' +
        'G)')
    DeleteSQL.Strings = (
