  object Tb_Ped02_Lotes_Ant: TQuery
    CachedUpdates = True
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      'Select min(P2LM_CODEMP) as P2LM_CODEMP '
      '                      ,P2LM_CODPRO '
      '                      ,P2LM_LOTSEQ '
      '                      ,P2LM_CHAVE '
      '                      ,P2LM_ITEM '
      '                      ,P2LM_LOTE '
      '                      ,P2LM_DTFAB '
      
        '                      , CASE WHEN MAX(P2LM_DTVCTO)<'#39'01/01/1901'#39' ' +
        'THEN NULL ELSE MAX(P2LM_DTVCTO) END  AS  P2LM_DTVCTO '
      
        '                      , sum(case when P2LM_CODEMP<100 THEN P2LM_' +
        'QTD ELSE 0 END) as P2LM_QTD_001 '
      
        '                      , sum(case when P2LM_CODEMP<100 THEN 0 ELS' +
        'E P2LM_QTD END) as P2LM_QTD_101 '
      ''
      '                    from CADP02_LOTES '
      '                    where (P2LM_CODEMP=1 or P2LM_CODEMP=101) '
      '                    and P2LM_CHAVE=1'
      '                    and P2LM_LOTSEQ=2'
      '                    and P2LM_ITEM=1 '
      'group by P2LM_CODPRO '
      '                      ,P2LM_LOTSEQ '
      '                      ,P2LM_CHAVE '
      '                      ,P2LM_ITEM '
      '                      ,P2LM_LOTE '
      '                      ,P2LM_DTFAB '
      '                    ')
    Left = 806
    Top = 383
    object Tb_Ped02_Lotes_AntP2LM_CODEMP: TFloatField
      FieldName = 'P2LM_CODEMP'
    end
    object Tb_Ped02_Lotes_AntP2LM_CODPRO: TFloatField
