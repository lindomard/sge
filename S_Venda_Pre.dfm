  object UpPed01_AddExt: TUpdateSQL
    ModifySQL.Strings = (
      'update CADP01_ADDEXT'
      'set'
      '  P1AE_CODEMP = :P1AE_CODEMP,'
      '  P1AE_LOTSEQ = :P1AE_LOTSEQ,'
      '  P1AE_CHAVE = :P1AE_CHAVE,'
      '  P1AE_CHAVE_NIVEL = :P1AE_CHAVE_NIVEL,'
      '  P1AE_ORIGEM = :P1AE_ORIGEM,'
      '  P1AE_ITEM = :P1AE_ITEM,'
      '  P1AE_NOME = :P1AE_NOME,'
      '  P1AE_VALOR = :P1AE_VALOR'
      '  ,P1AE_ID_NEW = :P1AE_ID_NEW'
      '  ,P1AE_ID_PED01_NEW = :P1AE_ID_PED01_NEW'
      'where'
      '  P1AE_CODEMP = :OLD_P1AE_CODEMP and'
      '  P1AE_LOTSEQ = :OLD_P1AE_LOTSEQ and'
      '  P1AE_CHAVE = :OLD_P1AE_CHAVE and'
      '  P1AE_CHAVE_NIVEL = :OLD_P1AE_CHAVE_NIVEL and'
      '  P1AE_ORIGEM = :OLD_P1AE_ORIGEM and'
      '  P1AE_ITEM = :OLD_P1AE_ITEM')
    InsertSQL.Strings = (
      'insert into CADP01_ADDEXT'
      '  (P1AE_CODEMP, P1AE_LOTSEQ, P1AE_CHAVE, P1AE_CHAVE_NIVEL, '
      'P1AE_ORIGEM, '
      '   P1AE_ITEM, P1AE_NOME, P1AE_VALOR'
      '   ,P1AE_ID_NEW,P1AE_ID_PED01_NEW)'
      'values'
      '  (:P1AE_CODEMP, :P1AE_LOTSEQ, :P1AE_CHAVE, :P1AE_CHAVE_NIVEL,'
      ':P1AE_ORIGEM,'
      '   :P1AE_ITEM, :P1AE_NOME, :P1AE_VALOR'
      '   ,:P1AE_ID_NEW,:P1AE_ID_PED01_NEW)')
    DeleteSQL.Strings = (
      'delete from CADP01_ADDEXT'
      'where'
      '  P1AE_CODEMP = :OLD_P1AE_CODEMP and'
      '  P1AE_LOTSEQ = :OLD_P1AE_LOTSEQ and'
      '  P1AE_CHAVE = :OLD_P1AE_CHAVE and'
      '  P1AE_CHAVE_NIVEL = :OLD_P1AE_CHAVE_NIVEL and'
      '  P1AE_ORIGEM = :OLD_P1AE_ORIGEM and'
      '  P1AE_ITEM = :OLD_P1AE_ITEM')
    Left = 214
    Top = 361
  end
