  object Qr_itens_pedori: TQuery
    CachedUpdates = True
    BeforePost = Qr_itens_pedoriBeforePost
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      
        'Select P2QTD,P2QTDDEV,P2QTD-P2QTD AS QTDSEL,P2ITEM,P2TOTLIQ,P2TO' +
        'TDES,P2CODEMP'
      ',  case when (P2TOTLIQ-P2DESCRAT>0) and (P2QTD>0) THEN '
      '                  (P2TOTLIQ-P2DESCRAT)/P2QTD'
      '                  else 0 end  AS PcoLiqDev'
      
        ',P2PRECO,P2PCOMAX,P2DESC1,P2DESC2,P2DESC3,P2PDESCF,P2PCOMIS,P2PC' +
        'OM02,P2PCOM03,P2VALDES'
      
        ',P2ST_IVA,P2ST_REDUT,P2ST_ICMCRED,P2ST_ICMDEB,P2REDUTICM,P2SIT,P' +
        '2ALIQ, P2ALIQICMSDES'
      
        ',P2ALIPI,P2DESCRAT, P2LOTSEQ,P2CHAVE, P2ORDEM ,PDCODPRO,PDNOME,P' +
        'DUND,PDMARCA'
      
        ',P2CSOSN_ORI,to_char(P2CSOSN) as P2CSOSN,P2MODBCST,P2PCOTAB,P2UC' +
        'PR,P2PCOCUS'
      
        ',P2ALPIS,P2ALCOFINS,P2PCRED_SN,P2CST_PIS,P2CST_COFINS,P2CST_IPI,' +
        'P2CODVEN'
      ',P2CONTESP,P2TIPOPROD'
      'FROM CADP01,CADP02,CADPRO'
      'WHERE P2CHAVE=P1CHAVE AND P2ORDEM=P1ORDEM'
      'AND P2CODEMP=P1CODEMP AND P2LOTSEQ=P1LOTSEQ'
      'AND PDCODPRO=P2CODPRO')
    UpdateObject = U_itens_pedori
    Left = 262
    Top = 353
