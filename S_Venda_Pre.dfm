  object Tb_ped02S_pre: TQuery
    CachedUpdates = True
    BeforeInsert = Tb_ped02S_preBeforeInsert
    AfterInsert = Tb_ped02S_preAfterInsert
    BeforeEdit = Tb_ped02S_preBeforeEdit
    AfterEdit = Tb_ped02S_preAfterEdit
    BeforePost = Tb_ped02S_preBeforePost
    AfterPost = Tb_ped02S_preAfterPost
    AfterCancel = Tb_ped02S_preAfterCancel
    BeforeDelete = Tb_ped02S_preBeforeDelete
    OnCalcFields = Tb_ped02S_preCalcFields
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      
        'Select P2SCODEMP,P2SCHAVE,P2SLOTSEQ AS P2SCHAVE_ANO,P2SITEM,P2SC' +
        'ODPRO AS P2SCODSER,P2SQTD,'
      '                            P2SDESC1 AS P2SPDESC01,'
      '                            P2SDESC2 AS P2SPDESC02,'
      '                            P2SDESC3 AS P2SPDESC03,'
      '                            P2SPRECO, P2SDESC_COMP'
      '                            ,P2SSIT AS P2SCST'
      '                            ,P2SCSOSN'
      '                            ,P2SCSOSN_ORI'
      '                            ,P2SBCISSQN,P2SVISSQN'
      '                            ,P2SALIQ AS P2SALIQISSQN'
      '                            ,P2SSTATUS_PED1 AS P2SSITUACAO'
      '                            ,P2SPCOTAB,P2SPCOCUS,P2STOTDES,'
      '                                      P2SDESCRAT'
      
        '                                      ,P2SPDESCF AS P2SDESCFIN_P' +
        'ERC'
      
        '                                      ,P2SVDESCF AS  P2SDESCFIN_' +
        'VALOR'
      
        '                                      ,P2SBCINSS,P2SREDINSS AS P' +
        '2SPREDINSS,'
      
        '                                      ROUND( ((P2SBCINSS*P2SREDI' +
        'NSS)/100),2) P2SVREDINSS'
      '                                      ,P2SALIQINSS,'
      '                                      P2SREDIRRF AS P2SPREDIRRF,'
      
        '                                      ROUND( ((P2SBCIRRF*P2SREDI' +
        'RRF)/100),2) P2SVREDIRRF,'
      
        '                                      P2SALIQIRRF,P2SQTD*P2SPREC' +
        'O AS VALOR_TOTAL,'
      
        '                                      P2SCFO AS P2SCFOP_NF, P2SC' +
        'FO AS P2SCFOP_ECF,P2SCODFUN AS P2SCODVEN,'
      
        '                                      PDNOME,PDUND FROM cadp02S,' +
        'cadpro'
      '                                       where'
      '                                       PDCODPRO =P2SCODPRO'
      '                                       and PDCODEMP=P2SCODEMP'
      '                                       and P2sCODEMP=-9999'
      '')
    UpdateObject = U_ped02S_pre
    Left = 862
    Top = 207
