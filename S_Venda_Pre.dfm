  object U_Ped02_Lotes: TUpdateSQL
    ModifySQL.Strings = (
      'update CADP02_LOTES'
      'set'
      '  P2LM_QTD = :P2LM_QTD,'
      '  P2LM_ITEM = :P2LM_ITEM,'
      '  P2LM_LOTE = :P2LM_LOTE,'
      '  P2LM_DTFAB = :P2LM_DTFAB,'
      '  P2LM_DTVCTO = :P2LM_DTVCTO,'
      '  P2LM_CODPRO = :P2LM_CODPRO'
      'where'
      '  P2LM_ITEM = :OLD_P2LM_ITEM and'
      '  P2LM_LOTE = :OLD_P2LM_LOTE and'
      '  P2LM_CODPRO = :OLD_P2LM_CODPRO')
    InsertSQL.Strings = (
      'insert into CADP02_LOTES'
      '  (P2LM_QTD, P2LM_ITEM, P2LM_LOTE, P2LM_DTFAB, P2LM_DTVCTO, '
      'P2LM_CODPRO)'
      'values'
      
        '  (:P2LM_QTD, :P2LM_ITEM, :P2LM_LOTE, :P2LM_DTFAB, :P2LM_DTVCTO,' +
        ' '
      ':P2LM_CODPRO)')
    DeleteSQL.Strings = (
      'delete from CADP02_LOTES'
      'where'
      '  P2LM_ITEM = :OLD_P2LM_ITEM and'
      '  P2LM_LOTE = :OLD_P2LM_LOTE and'
      '  P2LM_CODPRO = :OLD_P2LM_CODPRO')
    Left = 806
    Top = 207
  end
