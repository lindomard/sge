  object Qr_Sel: TQuery
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      
        'Select P1CHAVE,P1ORDEM,P1DATAP,P1CODCLI,P1TOTALL,P1TIPO,P1LOTSEQ' +
        ',CRAZAO'
      '       from CADP01,CADCLI where'
      '       P1CODEMP is null'
      '       and CCODCLI=P1CODCLI'
