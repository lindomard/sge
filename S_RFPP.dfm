  object Qr_FP: TQuery
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      'select fpforma,fpdesc,sum(fpvalor) as TOTAL from FPCP,CADFP'
      'where FPCODIGO=FPFORMA'
