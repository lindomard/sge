      '  PF2CSOSN = :PF2CSOSN,'
      '  PF2CFO = :PF2CFO,'
      '  PF2DESC_COMPL = :PF2DESC_COMPL,'
      '  VALOR_TOTAL = :VALOR_TOTAL,'
      '  PF2CSOSN_ORI = :PF2CSOSN_ORI,'
      '  PF2ICMS_PRED = :PF2ICMS_PRED,'
      '  PF2MODBCST = :PF2MODBCST,'
      '  PF2ST_IVA = :PF2ST_IVA,'
      '  PF2ST_PERCRED = :PF2ST_PERCRED,'
      '  PF2ST_ICMSCRED = :PF2ST_ICMSCRED,'
      '  PF2ST_ICMSDEB = :PF2ST_ICMSDEB,'
      '  PF2PRECO_MAXCONS = :PF2PRECO_MAXCONS,'
      '  PF2IPI_PERC = :PF2IPI_PERC,'
      '  PF2ICMS_PERC = :PF2ICMS_PERC,'
      '  PF2COFINS_PERC = :PF2COFINS_PERC,'
      '  PF2PIS_PERC = :PF2PIS_PERC,'
      '  PF2ICMSSN_PERC = :PF2ICMSSN_PERC,'
      '  PF2IPI_CST = :PF2IPI_CST,'
      '  PF2PIS_CST = :PF2PIS_CST,'
      '  PF2COFINS_CST = :PF2COFINS_CST,'
      '  PF2IPI_VALOR = :PF2IPI_VALOR,'
      '  PF2ST_BASE = :PF2ST_BASE,'
      '  PF2ST_ICMS = :PF2ST_ICMS,'
      '  PF2ICMS_BASE = :PF2ICMS_BASE,'
      '  PF2ICMS_VALOR = :PF2ICMS_VALOR,'
      '  PF2ICMS_RED_VLR = :PF2ICMS_RED_VLR,'
      '  PF2DESC_CABEC = :PF2DESC_CABEC,'
      '  PF2DESC_TOTDES = :PF2DESC_TOTDES,'
      '  PF2PIS_VALOR = :PF2PIS_VALOR,'
      '  PF2TOTLIQ = :PF2TOTLIQ,'
      '  PF2ICMSSN_VALOR = :PF2ICMSSN_VALOR,'
      '  PF2COFINS_VALOR = :PF2COFINS_VALOR,'
      '  PF2DESC_VALOR = :PF2DESC_VALOR,'
      '  NOMPRO_FOR = :NOMPRO_FOR,'
      '  UNDPRO_FOR = :UNDPRO_FOR,'
      '  NOMPRO_INT = :NOMPRO_INT,'
      '  UNDPRO_INT = :UNDPRO_INT,'
      '  PF2CODBAR = :PF2CODBAR,'
      '  PF2CODPRO_EXT = :PF2CODPRO_EXT,'
      '  PF2QTDP_EXT = :PF2QTDP_EXT,'
      '  PF2PU_EXT = :PF2PU_EXT,'
      '  PDNIVEL = :PDNIVEL'
      '  ,PF2VICMSDESON=:PF2VICMSDESON'
      '  ,PF2CBENEF = :PF2CBENEF'
      '  ,PF2DESONERACAO_DEDUZ = :PF2DESONERACAO_DEDUZ'
      '  ,PF2DESONERACAO_MOTIVO = :PF2DESONERACAO_MOTIVO'
      'where'
      '  PF2CODEMP = :OLD_PF2CODEMP and'
      '  PF2CHAVE = :OLD_PF2CHAVE and'
      '  PF2LOTSEQ = :OLD_PF2LOTSEQ and'
      '  PF2ITEM = :OLD_PF2ITEM')
    InsertSQL.Strings = (
      'insert into CADPF2'
      
        '  (PF2CODEMP, PF2CHAVE, PF2LOTSEQ, PF2ITEM, PF2QTDP, PF2DESC_PER' +
        'C01, PF2DESC_PERC02, '
      
        '   PF2CODPRO_INT, PF2FRERAT, PF2DESC_PERC03, PF2PU_INT, PF2SIT, ' +
        'PF2CSOSN, '
      
        '   PF2CFO, PF2DESC_COMPL, VALOR_TOTAL, PF2CSOSN_ORI, PF2ICMS_PRE' +
        'D, PF2MODBCST, '
      
        '   PF2ST_IVA, PF2ST_PERCRED, PF2ST_ICMSCRED, PF2ST_ICMSDEB, PF2P' +
        'RECO_MAXCONS, '
      
        '   PF2IPI_PERC, PF2ICMS_PERC, PF2COFINS_PERC, PF2PIS_PERC, PF2IC' +
        'MSSN_PERC, '
      
        '   PF2IPI_CST, PF2PIS_CST, PF2COFINS_CST, PF2IPI_VALOR, PF2ST_BA' +
        'SE, PF2ST_ICMS, '
      
        '   PF2ICMS_BASE, PF2ICMS_VALOR, PF2ICMS_RED_VLR, PF2DESC_CABEC, ' +
        'PF2DESC_TOTDES, '
      
        '   PF2PIS_VALOR, PF2TOTLIQ, PF2ICMSSN_VALOR, PF2COFINS_VALOR, PF' +
        '2DESC_VALOR, '
      
        '   NOMPRO_FOR, UNDPRO_FOR, NOMPRO_INT, UNDPRO_INT, PF2CODBAR, PF' +
        '2CODPRO_EXT, '
      '   PF2QTDP_EXT, PF2PU_EXT, PDNIVEL,PF2VICMSDESON,PF2CBENEF'
      '   ,PF2DESONERACAO_DEDUZ,PF2DESONERACAO_MOTIVO)'
      'values'
      
        '  (:PF2CODEMP, :PF2CHAVE, :PF2LOTSEQ, :PF2ITEM, :PF2QTDP, :PF2DE' +
        'SC_PERC01,'
      
        '   :PF2DESC_PERC02, :PF2CODPRO_INT, :PF2FRERAT, :PF2DESC_PERC03,' +
        ' :PF2PU_INT,'
      
        '   :PF2SIT, :PF2CSOSN, :PF2CFO, :PF2DESC_COMPL, :VALOR_TOTAL, :P' +
        'F2CSOSN_ORI,'
      
        '   :PF2ICMS_PRED, :PF2MODBCST, :PF2ST_IVA, :PF2ST_PERCRED, :PF2S' +
        'T_ICMSCRED,'
      
        '   :PF2ST_ICMSDEB, :PF2PRECO_MAXCONS, :PF2IPI_PERC, :PF2ICMS_PER' +
        'C, :PF2COFINS_PERC,'
      
        '   :PF2PIS_PERC, :PF2ICMSSN_PERC, :PF2IPI_CST, :PF2PIS_CST, :PF2' +
        'COFINS_CST,'
      
        '   :PF2IPI_VALOR, :PF2ST_BASE, :PF2ST_ICMS, :PF2ICMS_BASE, :PF2I' +
        'CMS_VALOR,'
      
        '   :PF2ICMS_RED_VLR, :PF2DESC_CABEC, :PF2DESC_TOTDES, :PF2PIS_VA' +
        'LOR, :PF2TOTLIQ,'
      
        '   :PF2ICMSSN_VALOR, :PF2COFINS_VALOR, :PF2DESC_VALOR, :NOMPRO_F' +
        'OR, :UNDPRO_FOR,'
      
        '   :NOMPRO_INT, :UNDPRO_INT, :PF2CODBAR, :PF2CODPRO_EXT, :PF2QTD' +
        'P_EXT,'
      '   :PF2PU_EXT, :PDNIVEL,:PF2VICMSDESON,:PF2CBENEF'
      '   ,:PF2DESONERACAO_DEDUZ,:PF2DESONERACAO_MOTIVO)')
    DeleteSQL.Strings = (
      'delete from CADPF2'
      'where'
      '  PF2CODEMP = :OLD_PF2CODEMP and'
      '  PF2CHAVE = :OLD_PF2CHAVE and'
      '  PF2LOTSEQ = :OLD_PF2LOTSEQ and'
      '  PF2ITEM = :OLD_PF2ITEM')
    Left = 542
    Top = 212
