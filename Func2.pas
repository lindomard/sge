   begin
   DM1.Query1.SQL.add('Insert into ECFABERTO ('
                     +'EA_NOMECOMP, '
                     +'EA_DATA,   '
                     +'EA_CODUSR,  '
                     +'EA_CODECF, '
                     +'EA_PEDIDO, '
                     +'EA_ESTAGIO) values ('
                     +chr(39)+pNomTer+chr(39)+','
                     +chr(39)+FormatDateTime(fdt, date)+chr(39)+','
                     +InttoStr(codusr)+','
                     +IntToStr(codecf)+','
                     +'0'+','
                     +'0'+')');

   end
