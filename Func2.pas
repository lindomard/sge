DM4.Qr_IncLDR.ParambyName('VINCULO').AsFloat    := pVinculo;
DM4.Qr_IncLDR.ParambyName('STATUS').AsFloat     := pStatus;
DM4.Qr_IncLDR.ParambyName('ORIGEM').AsFloat     := pOrigem;
DM4.Qr_IncLDR.ParambyName('LOCDEP').AsFloat     := pLocdep;
DM4.Qr_IncLDR.ParambyName('TIPO').AsString      := ptipo;
DM4.Qr_IncLDR.ParambyName('CODIGO').AsFloat     := pcodigo;
