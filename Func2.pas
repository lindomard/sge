DM4.Qr_IncLDR.ParambyName('CODDEP').AsString    := pcoddep;
DM4.Qr_IncLDR.ParambyName('NATDC').AsString     := pnatdc;
DM4.Qr_IncLDR.ParambyName('DESCMV').AsString    := pdescmv;
DM4.Qr_IncLDR.ParambyName('NUMDOC').AsString    := pnumdoc;
