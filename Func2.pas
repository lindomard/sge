function fAjustaChAcRem(ptipo: Integer):Boolean;
begin
DM1.Query1.Close;
DM1.Query1.SQL.Clear;
DM1.Query1.SQL.Add('Select MAX(P1LTACERTO) from CADP01 '
                  +iif(DM1.Qr_tid.Locate('TINOME','CADPED',[]),'',' where P1CODEMP=0'+IntToStr(iif(codemp>100,codemp-100,codemp))));
DM1.Query1.Open;
if flcadpar01(0,iif(codemp>100,codemp-100,codemp),'1') then
   begin
   DM4.Tb_Par01.Edit;
   DM4.Tb_Par01PCHACREM_LS.Value:=0;
   DM4.Tb_Par01PCHACREM.Value   :=DM1.Query1.Fields[0].AsFloat+1;
   DM4.Tb_Par01.Post;
   fSequenceTestaeAjusta('CHACREM_2012',DM1.Query1.Fields[0].AsInteger+1);
   result:=true;
   end
else
   result:=False;
end;

function fbuscaChAcRem(ptipo: Integer): Real;
begin
if flcadpar01(0,iif(codemp>100,codemp-100,codemp),'1') then
   begin
   if (DM4.Tb_Par01PCHACREM.IsNull) or (DM4.Tb_Par01PCHACREM.Value=0) then
      begin
      fAjustaChAcRem(0);
      flcadpar01(0,iif(codemp>100,codemp-100,codemp),'1');
      end;
   DM1.Query1.Close;
   DM1.Query1.SQl.Clear;
   DM1.Query1.SQl.add('Update CADPAR set PCHACREM=PCHACREM+1 where '
                      +iif(DM1.Qr_Tid.Locate('TINOME','CADPAR',[]),'',' PCODEMP=0'+IntTostr(iif(codemp>100,codemp-100,codemp))+' and ')
                      +' PCODSEQ=1');
   Try
      DM1.Query1.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql(01,4742,'func2','CADPAR');
      end;
   result:=DM4.Tb_Par01PCHACREM.Value;
   fBuscarSequencia('CHACREM_2012');
   end
else
   Fmensagem('Erro ao Buscar a Chave de Acerto de Remessa!',0,['0'],0);
end;

