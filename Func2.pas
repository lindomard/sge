mMensagem_certficado: string;
mdatacertificado: TDateTime;
begin
if pDataHoraVencCertificado>pdatanula then
   begin
   mdatacertificado:=pDataHoraVencCertificado;
   if mdatacertificado<now+30 then
      begin
      if not flfilpad(-2,'VCTO_CERT_DIG',FormatDateTime(fdt2, date)) then
         begin
         if mdatacertificado<now then
            mMensagem_certficado:='Certificado digital vencido em ' +Formatdatetime(fdathor, mdatacertificado)
         else
            mMensagem_certficado:='O Seu Certificado Digital ira vencer em: '+formatdatetime(fdathor, mdatacertificado);
         if Application.MessageBox(pchar(mMensagem_certficado+'. Avisar Novamente?'),'Confirmação',MB_YESNO+MB_DEFBUTTON2)=mrno then
            begin
            fGravaPadroes(-2,FormatDateTime(fdt2, date) ,'aviso'
                  ,'VCTO_CERT_DIG'
                      ,'SIM');
            end;
         end;
      end;
   end;
end;



function fSalvarTextoparaArquivoComNome(pNomeEntra: string; pTextoEntra: tStringList  ): string;
var
x_tent: Integer;
mNomeSaida: string;
begin

try
   x_tent:=0;
   while true do
      begin
      mNomeSaida:=pNomeEntra+iif(x_tent>0,'_'+inttostr(x_tent),'');

      if fileExists(mNomeSaida) then
         begin
         if not DeleteFile(pchar(mNomeSaida)) then
            begin
            x_tent:=x_tent+1;
            continue;
            end;
         end;
      try
         pTextoEntra.SaveToFile(mNomeSaida);
         break;
      except
         begin
         x_tent:=x_tent+1;
         continue;
         end;
         end;
      end;
Except
   result:='';
   end;
RESULT:=mNomeSaida;
end;


