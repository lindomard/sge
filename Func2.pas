function fCalcDigNFEMod11(Numero: String): String; // BRADESCO

var
  dv,z,x, y,i, soma, somat: Integer;
  nr, ind   : string;
begin
nr:=Trim(Numero);
ind:='';
y:=Length(nr);
x:=2;
for z:=1 to y do
   begin
   ind:=FormatFloat('0',x)+ind;
   x:=x+1;
   if x>9 then
      x:=2;
   end;

soma:=0; x:=1;
While y>0 do
   begin
   z:=StrToInt(Copy(nr,y,1))*StrToInt('0'+Copy(Trim(ind),y,1));
   soma:=soma+z;
   y:=y-1;
   x:=x+1;
   end;
somat:=soma mod 11;  //10 ou 11
dv    :=11-somat;
if (dv=1) or (dv>9)  then
   result:='0'
else
   Result:=IntToStr(dv);
end;
}


function fCalcDigNFEMod11(Numero: String): String; // BRADESCO
var
i,j,k : Integer;
Soma : Integer;
Digito : Integer;
CNPJ : Boolean;
begin
Result := '';
Try
Soma := 0; k:= 2;
for i := Length(Numero) downto 1 do begin
Soma := Soma + (StrToInt(Numero[i])*k);
inc(k);
if k > 9 then k := 2;
end;
Digito := 11 - Soma mod 11;
if Digito >= 10 then
   Digito := 0;
Result := Result + Chr(Digito + Ord('0'));
except
Result := 'X';
end;
end;

