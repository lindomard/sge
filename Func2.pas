function fAjustarDataHoraDeSaida(pChave,pLotseq,pCodEmp: integer): boolean;
const
mDifHoras = 1;
var
query_atu: tQuery;
begin
result:=false;
if flfilpad(0,'_VENDA_PRE','CB_DATSAIAUTO') then
   begin
   if DM4.Tb_FilPad2FPVALOR.AsString='true' then
      begin
      query_atu:=tQuery.Create(nil);
      query_atu.databaseName:=DM1.SG_ASSOC.DatabaseName;
      query_atu.sql.clear;
      query_atu.sql.add('UPDATE CADP01 SET P1PREVENT = SYSDATE + :DIFMINUTOS / 1440 '
                      +' WHERE  24*60*(P1PREVENT-SYSDATE) < :DIFMINUTOS '
                      +' AND P1CHAVE=:CHAVE '
                      +' AND P1LOTSEQ=:LOTSEQ '
                      +' AND P1CODEMP=:CODEMP ');
      query_atu.parambyname('CHAVE').asinteger:=pChave;
      query_atu.parambyname('LOTSEQ').asinteger:=pLotSeq;
      query_atu.parambyname('CODEMP').asinteger:=pCodEmp;
      query_atu.parambyname('DIFMINUTOS').asinteger:=mDifHoras*60;


      try
         query_atu.execsql;
         fdm1StartCommit;
         result:=true;
      except on e : exception do
         begin
         ex_erroSql_Novo(query_atu,29724,'func Erro:'+e.Message ,'CADP01');
         result:=false;
         end;
         end;

      query_atu.close;
      freeandnil(query_atu);
      end;
   end;
end;


