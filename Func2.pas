// EMITIR DUPLICATAS
function FEmiteDP(ptipo,pcodemp: Integer): Boolean;
var
mlMax,mqtd: Integer;
mlin2: Integer;

mdoc,mnome, moper: String;
mcont: String;
mincrem: String;
begin
mdoc :='NF';
mnome:='Duplicata';
if DM1.Qr_TID.Locate('TINOME','CADTAB',[]) then
   flcadtdv(0,0,mdoc,mnome,'','','CADTAB')
else
   flcadtdv(0,pcodemp,mdoc,mnome,'','','CADTAB');


if DM1.Qr_Tid.Locate('TINOME','CADTAB',[]) then
   fltdvca(0,0,mdoc,mnome,'CADTAB')
else
   fltdvca(0,pcodemp,mdoc,mnome,'CADTAB');

