      result:=query_ncm.fieldbyname('PDCODNCM').asstring;
   except on e : exception do
      begin
      result:='99999999';
      ex_erroSql_Novo(query_ncm,16991,'func2 '+e.Message,'CADP02');
      end;
      end;
   query_ncm.close;
   freeandnil(query_ncm);


   end;


