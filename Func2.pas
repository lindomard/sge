DM4.Qr_IncLDR.ParambyName('HRALT').AsString     := ' ';
DM4.Qr_IncLDR.ParambyName('COMPENS').AsFloat    := 0;
//DM4.Qr_IncLDR.ParambyName('COMPENS').AsFloat    := 0;
DM4.Qr_IncLDR.ParambyName('USREXC').AsFloat     := 0;
DM4.Qr_IncLDR.ParambyName('DTCOMP').AsDateTime  := pdatasis;
DM4.Qr_IncLDR.ParambyName('DTHREXC').AsDateTime := pdatanula;
DM4.Qr_IncLDR.ParambyName('NOMDEP').AsString    := pnomdep;
DM4.Qr_IncLDR.ParambyName('NOMBCO').AsString    := pnombco;
DM4.Qr_IncLDR.ParambyName('NOMCCU').AsString    := pnomccu;
DM4.Qr_IncLDR.ParambyName('NOME').AsString      := pnome;
DM4.Qr_IncLDR.ParambyName('FC_OBSFIN').AsString   :=Copy(pObsDar,1,40);
