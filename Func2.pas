function printCanvas(print: TPrinter; Linha: Integer; Texto: String) : Integer;
begin
if ((Linha) > ((print.PageHeight-150)/130)) then
  begin
  Linha := 1;
  print.NewPage();
  Sleep(1000);
  end;


if Linha = 1 then
  begin
  print.Canvas.TextOut(20,20,Texto);
  end
else
  begin
  print.Canvas.TextOut(20,Linha*130+20,Texto);
  end;
Result := Linha + 1;
end;


function fLerImagemGravaStream(pNomeImagem: String; out pImagemjpeg: TJPEGImage): Boolean;
var
 query_fig : TAdoquery;
 mStream: TMemoryStream;

begin
query_fig := TADOQuery.Create(nil);
query_fig.Connection:=DM1_ADO.ADOConnection1;
query_fig.SQL.Add('Select LSLOGO from CADLOGSIS where (LSCODEMP=0'+IntToStr(codemp)+' or LSCODEMP is null)'
                   +' and LSCHAVE=:CHAVE '
                   +' and not LSLOGO is null ' );
query_fig.Parameters.ParamByName('CHAVE').Value:=pNomeImagem;
query_fig.Open;
if query_fig.IsEmpty then
   result:=false
else
   begin
   try
       mStream:=TMemoryStream.Create;
      (query_fig.FieldByName('LSLOGO') as TBlobField).SaveToStream(mStream);
      mStream.Position := 0;

      pImagemjpeg.LoadFromStream(mStream);
      freeandnil(mStream);
      result:=true
   except
      result:=false;
      end;
   end;
freeandnil(query_fig);
end;



function FGerarTagDI(pCodemp: Integer;pChave,pChave_ano,pCodpro: Real): string;
var
mRetorno: string;
query_ped_di: tquery;
query_ped_di_adic: tquery;

begin
query_ped_di_adic:=tquery.create(nil);
query_ped_di_adic.DatabaseName:='SG_ASSOC';

query_ped_di:=tquery.create(nil);
query_ped_di.DatabaseName:='SG_ASSOC';
query_ped_di.SQL.Clear;
query_ped_di.SQL.Add('Select * from CADPED_DI where '
                    +' PDI_CODEMP=:CODEMP '
                    +' and PDI_CHAVE=:CHAVE '
                    +' and PDI_CHAVE_ANO=:CHAVE_ANO '
                    +' and PDI_CODPRO=:CODPRO ');
query_ped_di.parambyname('CODEMP').asinteger:=codemp;
query_ped_di.parambyname('CHAVE').AsFloat    :=pChave;
query_ped_di.parambyname('CHAVE_ANO').AsFloat:=pChave_ano;
query_ped_di.parambyname('CODPRO').AsFloat:=pCodpro;
try
   query_ped_di.open;
except on e : exception do
   ex_erroSql_Novo(query_ped_di,28259,'func Erro:'+e.Message ,'CADP02_LOTES');
   end;
mRetorno:='';

if not query_ped_di.Eof then
   begin
   While not query_ped_di.Eof do
      begin
      mRetorno:=mRetorno+'<DI>';
      mRetorno:=mRetorno+fGeraXMLString(0,'nDI', query_ped_di.FieldbyName('PDI_NDI').AsString);
      if query_ped_di.FieldbyName('PDI_DDI').Asdatetime>pdatanula then
         mRetorno:=mRetorno+fGeraXMLData('dDI', query_ped_di.FieldbyName('PDI_DDI').Asdatetime);
      if length(query_ped_di.FieldbyName('PDI_XLOCDESEMB').AsString)>0 then
         mRetorno:=mRetorno+fGeraXMLString(0,'xLocDesemb', query_ped_di.FieldbyName('PDI_XLOCDESEMB').AsString);
      if length(query_ped_di.FieldbyName('PDI_UFDESEMB').AsString)>0 then
         mRetorno:=mRetorno+fGeraXMLString(0,'UFDesemb', query_ped_di.FieldbyName('PDI_UFDESEMB').AsString);
      if query_ped_di.FieldbyName('PDI_DDESEMB').Asdatetime>pdatanula then
         mRetorno:=mRetorno+fGeraXMLData('dDesemb', query_ped_di.FieldbyName('PDI_DDESEMB').Asdatetime);
       mRetorno:=mRetorno+fGeraXMLString(0,'tpViaTransp', query_ped_di.FieldbyName('PDI_TPVIATRANSP').Asstring);
      if query_ped_di.FieldbyName('PDI_TPVIATRANSP').AsInteger=1 then
         mRetorno:=mRetorno+fGeraXMLString(0,'vAFRMM', query_ped_di.FieldbyName('PDI_VAFRMM').Asstring);
       mRetorno:=mRetorno+fGeraXMLString(0,'tpIntermedio', query_ped_di.FieldbyName('PDI_TPINTERMEDIARIO').Asstring);
                          
      if fsonumero(query_ped_di.FieldbyName('PDI_CNPJ').AsString)>0 then
         mRetorno:=mRetorno+fGeraXMLString(0,'CNPJ', fdeixanum(query_ped_di.FieldbyName('PDI_CNPJ').Asstring));


//      if length(query_ped_di.FieldbyName('PDI_cExportador').AsString)>0 then
         mRetorno:=mRetorno+fGeraXMLString(0,'cExportador', query_ped_di.FieldbyName('PDI_cExportador').AsString);


      query_ped_di_adic.SQL.Clear;
      query_ped_di_adic.SQL.Add('Select * from CADPED_DI_ADIC where '
                          +' PDIAD_CODEMP=:CODEMP '
                          +' and PDIAD_CHAVE=:CHAVE '
                          +' and PDIAD_CHAVE_ANO=:CHAVE_ANO '
                          +' and PDIAD_CODPRO=:CODPRO ');
      query_ped_di_adic.parambyname('CODEMP').asinteger:=codemp;
      query_ped_di_adic.parambyname('CHAVE').AsFloat    :=pChave;
      query_ped_di_adic.parambyname('CHAVE_ANO').AsFloat:=pChave_ano;
      query_ped_di_adic.parambyname('CODPRO').AsFloat:=query_ped_di.fieldbyname('PDI_CODPRO').AsFloat;
      try
         query_ped_di_adic.open;
      except on e : exception do
         ex_erroSql_Novo(query_ped_di_adic,28259,'func Erro:'+e.Message ,'CADP02_LOTES');
         end;
      if query_ped_di_adic.isempty=false then
         begin
         mRetorno:=mRetorno+'<adi>';
         While not query_ped_di_adic.Eof do
            begin
            mRetorno:=mRetorno+fGeraXMLString(0,'nAdicao', query_ped_di_adic.FieldbyName('PDIAD_NADICAO').AsString);
            mRetorno:=mRetorno+fGeraXMLString(0,'nSeqAdic', query_ped_di_adic.FieldbyName('PDIAD_NSEQADIC').AsString);
            mRetorno:=mRetorno+fGeraXMLString(0,'cFabricante', query_ped_di_adic.FieldbyName('PDIAD_CFABRICANTE').AsString);
            if query_ped_di_adic.FieldbyName('PDIAD_VDESCDI').AsFloat>0 then
               mRetorno:=mRetorno+fGeraXMLReal(0,'vDescDI', query_ped_di_adic.FieldbyName('PDIAD_VDESCDI').AsFloat);
            query_ped_di_adic.Next;
            end;
         mRetorno:=mRetorno+'</adi>';
         end;

      mRetorno:=mRetorno+'</DI>';
      query_ped_di.next;
      end;
   end;
result:=mretorno;
freeandnil(query_ped_di);
end;





