   form_impres_func2.RDPrint1.ImpF(DM2.Qr_TDVCPTLIN.AsInteger+(mlin-1)+plin,DM2.Qr_TDVCPTCOL.AsInteger,maux,[mfonte]);
   DM2.Qr_TDVCP.Next;
