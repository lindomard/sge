if pdatareal>pdatanula then
   DM4.Qr_IncLDR.ParambyName('DTSALDO').AsDateTime  := pdatareal
else
   DM4.Qr_IncLDR.ParambyName('DTSALDO').AsDateTime  := pdatanula;
DM4.Qr_IncLDR.ParambyName('CODUSR_CX').AsFloat   := codusr;






Try
   DM4.Qr_IncLDR.ExecSQL;
   fdm1StartCommit;
except ON E: Exception do
   begin
   ex_erroSql_Novo(DM4.Qr_IncLDR,12013,'_stru '+e.message,'user');
   end;
   end;


if (not DM1.Tb_Bco.Active) or (DM1.Tb_BcoBCCODBCO.AsFloat<>pcodbco) then
   flcadbco(1,0,0,FloatToStr(pcodbco));

if (DM1.Tb_BcoBCREPLICARCX.AsFloat=1) then
