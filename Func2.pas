   fltdvop(0,0,mdoc,mnome,'CADTAB','','','')
else
   fltdvop(0,pcodemp,mdoc,mnome,'CADTAB','','','');

While not DM2.Tb_OP.Eof do
   begin
   mtopper[DM2.Tb_OPTOCODIGO.AsInteger]:=0;
   DM2.Tb_OP.Next;
   end;



//   testeform := FindGlobalComponent('form_impres_func2');

//   if testeform=nil

if form_impres_func2=nil then
   begin
   Application.CreateForm(TFrm_Impres, form_impres_func2);
   end;

form_impres_func2.RDPrint1.TamanhoQteLinhas:=DM1.Tb_TDVCATCQTDLIN.AsInteger;
form_impres_func2.RDPrint1.TamanhoQteColunas:=DM1.Tb_TDVCATCQTDCOL.AsInteger;
if DM1.Tb_TDVCATCQTDLPP.Value=0 then
   form_impres_func2.RDPrint1.TamanhoQteLPP:=Seis
else
   form_impres_func2.RDPrint1.TamanhoQteLPP:=Oito;
if DM1.Tb_TDVCATCFPADRAO.Value=5 then
   form_impres_func2.RDPrint1.FonteTamanhoPadrao:=S05cpp
else if DM1.Tb_TDVCATCFPADRAO.Value=4 then
   form_impres_func2.RDPrint1.FonteTamanhoPadrao:=S05cpp
else if DM1.Tb_TDVCATCFPADRAO.Value=3 then
   form_impres_func2.RDPrint1.FonteTamanhoPadrao:=S20cpp
else if DM1.Tb_TDVCATCFPADRAO.Value=2 then
   form_impres_func2.RDPrint1.FonteTamanhoPadrao:=S17cpp
else if DM1.Tb_TDVCATCFPADRAO.Value=1 then
   form_impres_func2.RDPrint1.FonteTamanhoPadrao:=S12cpp
else
   form_impres_func2.RDPrint1.FonteTamanhoPadrao:=S10cpp;
form_impres_func2.RDPrint1.OpcoesPreview.Preview:=False;



mcinst:='DUPLIC_PER';
form_impres_func2.RDPrint1.Impressora:=Epson;

form_impres_func2.RDPrint1.OpcoesPreview.Preview:=False;

if Trim(mcinst)<>'' then
   begin
   if flcadimp_sys(1,pcodemp,0,mcinst) then
      begin
      if DM4.Tb_Imp_SysCIPORTA.IsNull then
         form_impres_func2.RDPrint1.SetPrinterbyName(impressora_padrao(0))
      else
          begin
          if not form_impres_func2.RDprint1.SetPrinterbyName(DM4.Tb_Imp_SysCIPORTA.Value) then
             form_impres_func2.RDPrint1.PortaComunicacao:=DM4.Tb_Imp_SysCIPORTA.Value;
          end;
      if DM4.Tb_Imp_SysCIMODELO.Value=0 then
         form_impres_func2.RDPrint1.Impressora      :=Epson
      else if DM4.Tb_Imp_SysCIMODELO.Value=1 then
         form_impres_func2.RDPrint1.Impressora      :=Grafico
      else if DM4.Tb_Imp_SysCIMODELO.Value=2 then
         form_impres_func2.RDPrint1.Impressora      :=HP
      else if DM4.Tb_Imp_SysCIMODELO.Value=3 then
         form_impres_func2.RDPrint1.Impressora      :=Personalizado
      else if DM4.Tb_Imp_SysCIMODELO.Value=4 then
         form_impres_func2.RDPrint1.Impressora      :=Rima;
      end
   else
      begin
      form_impres_func2.RDPrint1.SetPrinterbyName(impressora_padrao(0));
      end;
   end
else
   form_impres_func2.RDPrint1.SetPrinterbyName(impressora_padrao(0));

{
if DM1.Tb_TDVCATCVIS.Value=1 then
   form_impres_func2.RDPrint1.UsaGerenciadorImpr:=False
else
   form_impres_func2.RDPrint1.UsaGerenciadorImpr:=true;
}
form_impres_func2.RDPrint1.Abrir;

// impressao do cabecalho da nota fiscal
While not DM2.Tb_Dar.Eof do
   begin
   DM1.Tb_TDV.First;
   While not DM1.Tb_TDV.Eof do
      begin
      if Trim(DM1.Tb_TDVTCOND01.Value)<>'' then
         begin
         mcinst :='';
         mcinst2:='';
         mcinst3:='';
         mcinst4:='';

         if trim(DM1.Tb_TDVTCOND_02_02.AsString)<>'' then
            begin
            mcinst:=DM2.Tb_Dar.fieldbyName(Trim(DM1.Tb_TDVTCOND_02_01.Value)).AsString;
            if Trim(DM1.Tb_TDVTCOND_02_T2.AsString)='V' then
               mcinst2:=DM1.Tb_TDVTCOND_02_02.AsString
            else
               mcinst2:=DM2.Tb_Dar.fieldbyName(Trim(DM1.Tb_TDVTCOND_02_02.Value)).AsString;
            end;

         if trim(DM1.Tb_TDVTCOND_03_02.AsString)<>'' then
            begin
            mcinst3:=DM2.Tb_Dar.fieldbyName(Trim(DM1.Tb_TDVTCOND_03_01.Value)).AsString;
            if Trim(DM1.Tb_TDVTCOND_03_T2.AsString)='V' then
               mcinst4:=DM1.Tb_TDVTCOND_03_02.AsString
            else
               mcinst4:=DM2.Tb_Dar.fieldbyName(Trim(DM1.Tb_TDVTCOND_03_02.Value)).AsString;
            end;

         if DM1.Tb_TDVTCONDT2.Value='V' then
            begin
            if not FIRPERCond(DM1.Tb_TDVTCONDT1.Value,DM1.Tb_TDVTCONDT2.Value,
                              DM2.Tb_Dar.fieldbyName(Trim(DM1.Tb_TDVTCOND01.Value)).AsString,
                              DM1.Tb_TDVTCOND02.Value,
                              DM1.Tb_TDVTCONDOP.Value,
                              DM1.Tb_TDVTCOND_CONT.Value,
                              DM1.Tb_TDVTCOND_02_T1.Value,DM1.Tb_TDVTCOND_02_T2.Value,
                              mcinst,
                              mcinst2,
                              DM1.Tb_TDVTCOND_02_OP.Value,

                              DM1.Tb_TDVTCOND_CONT03.Value,
                              DM1.Tb_TDVTCOND_03_T1.Value,DM1.Tb_TDVTCOND_03_T2.Value,
                              mcinst3,
                              mcinst4,
                              DM1.Tb_TDVTCOND_03_OP.Value) then
               begin
               DM1.Tb_TDV.Next;
               Continue;
               end;
           end
         else
            begin
            if not FIRPERCond(DM1.Tb_TDVTCONDT1.Value,DM1.Tb_TDVTCONDT2.Value,
                              DM2.Tb_Dar.fieldbyName(Trim(DM1.Tb_TDVTCOND01.Value)).AsString,
                              DM2.Tb_Dar.fieldbyName(Trim(DM1.Tb_TDVTCOND02.Value)).AsString,
                              DM1.Tb_TDVTCONDOP.Value,
                              DM1.Tb_TDVTCOND_CONT.Value,
                              DM1.Tb_TDVTCOND_02_T1.Value,DM1.Tb_TDVTCOND_02_T2.Value,
                              mcinst,
