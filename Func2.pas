function fListaCampos(pFase: Integer;pSigla,pNomeNode: String; pNode: IXMLNode): Boolean;

var
NodeNivelY,NodeNivelX,NodeNivelW,NodeNivelZ: IXMLNode;
NomeNivelY,NomeNivelX,NomeNivelW,NomeNIvelZ: String;
y,x,w,z: Integer;
msigla_localY,msigla_localX,msigla_localW,msigla_localZ,msigla_localzTeste: string;
par_Sigla: String;
mLocal:Integer; //0-Cabecalho 1-Detalhes 2-Cobranca
begin
NomeNivelY:=pNomeNode;
if UpperCase(NomeNivelY)='DET' then
   mLocal:=1
else if UpperCase(NomeNivelY)='COBR' then
   mLocal:=2
else
   mLocal:=0;


NodeNivelY  := pNode.ChildNodes[nomeNivelY];
msigla_localY:='';
msigla_localX:='';
msigla_localW:='';
msigla_localZ:='';

While (NodeNivelY<>Nil) and (NodeNivelY.NodeName=NomeNivelY)  do
   begin
   if UpperCase(NomeNivelY)='COBR' then
      pSigla:='';

   if mlocal=1 then
      begin
      fIncluirDetNFE(pFase, 1, '','');
      mNFE_Params_Det:=nil;
      SetLength(mNFE_Params_Det,1);
      end;

   for y:=0 to NodeNivelY.ChildNodes.Count-1 do
      begin
      if NodeNivelY.ChildNodes[y].IsTextElement then
         begin
         if mlocal=0 then
            fIncluirCabNFE(pFase, 0, pSigla+msigla_localy+NodeNivelY.ChildNodes[y].NodeName,NodeNivelY.ChildNodes[y].Text)
         else if mlocal=1 then
            fIncluirDetNFE(pFase, 0, pSigla+msigla_localy+NodeNivelY.ChildNodes[y].NodeName,NodeNivelY.ChildNodes[y].Text)
         else if mlocal=2 then
            fIncluirDupNFE(pFase, 0, pSigla+msigla_localy+NodeNivelY.ChildNodes[y].NodeName,NodeNivelY.ChildNodes[y].Text);
         fExisteCampo(mLocal,pSigla+msigla_localy+NodeNivelY.ChildNodes[y].NodeName,NodeNivelY.ChildNodes[y].Text);
         end
      else
         begin
         NodeNivelX:=NodeNivelY.ChildNodes[NodeNivelY.ChildNodes[y].NodeName];
         NomeNivelX:=NodeNivelY.ChildNodes[y].NodeName;
         msigla_localX:=UpperCase(NomeNivelX);
         if (pSigla='TRANSP') and (mSigla_LocalX='TRANSPORTA') then
            begin
            par_Sigla:='TT_';
            msigla_localX:='';
            end
         else
            par_Sigla:=pSigla;
         if mSigla_LocalX='DUP' then
            mSigla_LocalX:='';

         While (NodeNivelX<>Nil) and (NodeNivelX.NodeName=NomeNivelX)  do
            begin
            if mlocal=2 then
              begin
              fIncluirDupNFE(pFase, 1, '','');
              mNFE_Params_Dup:=nil;
              SetLength(mNFE_Params_Dup,1);
              end;

            for x:=0 to NodeNivelX.ChildNodes.Count-1 do
               begin
               if NodeNivelX.ChildNodes[x].IsTextElement then
                  begin
                  if mlocal=0 then
                     fIncluirCabNFE(pFase,0, par_Sigla+msigla_localx+NodeNivelX.ChildNodes[x].NodeName,NodeNivelX.ChildNodes[x].Text)
                  else if mlocal=1 then
                     fIncluirDetNFE(pFase,0, par_Sigla+msigla_localx+NodeNivelX.ChildNodes[x].NodeName,NodeNivelX.ChildNodes[x].Text)
                  else if mlocal=2 then
                     fIncluirDupNFE(pFase,0, par_Sigla+msigla_localx+NodeNivelX.ChildNodes[x].NodeName,NodeNivelX.ChildNodes[x].Text);

                  try
                     fExisteCampo(mLocal,par_Sigla+msigla_localX+NodeNivelX.ChildNodes[x].NodeName,NodeNivelX.ChildNodes[x].Text);
                  except
                     end;
                  end
               else
                  begin
                  NodeNivelW:=NodeNivelX.ChildNodes[NodeNivelX.ChildNodes[x].NodeName];
                  NomeNivelW:=NodeNivelX.ChildNodes[x].NodeName;
                  msigla_localW:=UpperCase(NomeNivelW);
                  if msigla_localW='MED' then
                     msigla_localW:=uppercase(NodeNively.ChildNodes[y].NodeName)+msigla_localW;

                  While (NodeNivelW<>Nil) and (NodeNivelW.NodeName=NomeNivelW)  do
                     begin
                     for w:=0 to NodeNivelW.ChildNodes.Count-1 do
                        begin
                        if NodeNivelW.ChildNodes[w].IsTextElement then
                           begin
                           if mlocal=0 then
                             fIncluirCabNFE(pFase,0, par_Sigla+msigla_localw+NodeNivelW.ChildNodes[w].NodeName,NodeNivelW.ChildNodes[w].Text)
