//   function fGerarTagLote(pDtVcto,pDtFab: TDatetime; pnLote,pcProdANVISA: string; pqLote,pPMC: Real) : boolean;
   function fGerarTagLote(pQuery: tQuery;pcProdANVISA: String;pPMC: Real) : boolean;
   begin
   if (length(pQuery.fieldbyname('P2LM_LOTE').AsString)>1) and
      (pQuery.fieldbyname('P2LM_DTVCTO').AsDateTime>pDataNula) then
      begin
      if (valint(fdeixanum(DM4.Tb_ParGer02PG2VERSAOXML.AsString))>310) then
         begin
         While not pQuery.eof do
            begin
            mXmlString.Add('<rastro>');
            mXmlString.Add(fGeraXMLString(0,'nLote', pQuery.fieldbyname('P2LM_LOTE').AsString));
            mXmlString.Add(fGeraXMLReal(3,'qLote', pQuery.fieldbyname('P2LM_QTD').asfloat));
            if (pQuery.fieldbyname('P2LM_DTFAB').AsDateTime<=pdatanula) then
               begin
               if pQuery.fieldbyname('P2LM_DTVCTO').AsDateTime-180>date then
                  mXmlString.Add(fGeraXMLString(0,'dFab',FormatDateTime('yyyy-mm-dd', date)))
               else
                  mXmlString.Add(fGeraXMLString(0,'dFab',FormatDateTime('yyyy-mm-dd', pQuery.fieldbyname('P2LM_DTVCTO').AsDateTime-180)));

{               pQuery.fieldbyname('P2LM_DTVCTO').AsDateTime
               mXmlString.Add(fGeraXMLString(0,'dFab',FormatDateTime('yyyy-mm-dd', date)));
}               end
            else
               mXmlString.Add(fGeraXMLString(0,'dFab',FormatDateTime('yyyy-mm-dd', pQuery.fieldbyname('P2LM_DTFAB').AsDateTime)));
            mXmlString.Add(fGeraXMLString(0,'dVal',FormatDateTime('yyyy-mm-dd', pQuery.fieldbyname('P2LM_DTVCTO').AsDateTime)));
            mXmlString.Add('</rastro>');
            pquery.next;
            end;

         if (trim(pcProdANVISA)<>'') and (length(pcProdANVISA)>12) then
            begin
            mXmlString.Add('<med>');
            mXmlString.Add(fGeraXMLString(0,'cProdANVISA',pcProdANVISA));
            mXmlString.Add(fGeraXMLReal(2,'vPMC',  pPMC));
//            mXmlString.Add('</cProdANVISA>');
            mXmlString.Add('</med>');
            end;
         end

      else

         begin
{
         mXmlString.Add('<med>');
         mXmlString.Add(fGeraXMLString(0,'nLote',pnLote));
         mXmlString.Add(fGeraXMLReal(3,'qLote',pqLote));
         if (pDtFab<=pdatanula) then
            mXmlString.Add(fGeraXMLString(0,'dFab',FormatDateTime('yyyy-mm-dd', date)))
         else
            mXmlString.Add(fGeraXMLString(0,'dFab',FormatDateTime('yyyy-mm-dd', pDtFab)));
         mXmlString.Add(fGeraXMLString(0,'dVal',FormatDateTime('yyyy-mm-dd', pDtVcto)));
         mXmlString.Add(fGeraXMLReal(2,'vPMC', pPMC ));
         mXmlString.Add('</med>');
}         
         end;

      end;
// termino


   end;



   function  fGerarTagArma(pCodPro: String;pCodEmp,pLotSeq,pChave,pOrdem,pItem: Integer): Boolean;

   var
   Query_arma: tQuery;
   mMensagem: string;
   begin

   Query_arma:=TQuery.Create(nil);
   Query_arma.DatabaseName:='SG_ASSOC';

   query_arma.SQL.Clear;
   query_arma.SQL.Add('Select * from CADP02_ARMAS '
                     +'  where  P2ARMA_LOTSEQ=:LOTSEQ '
                     +'  and P2ARMA_CHAVE=:CHAVE '
                     +'  and P2ARMA_CODPRO=:CODPRO '
                     +'  and P2ARMA_CODEMP=:CODEMP '
                     +'  and P2ARMA_ITEM=:ITEM '
                     +'  order by P2ARMA_SEQ ');
   query_arma.ParamByName('LOTSEQ').AsInteger:=DM2.Qr_CorP2LOTSEQ.AsInteger;
   query_arma.ParamByName('CHAVE').AsInteger :=DM2.Qr_CorP2CHAVE.AsInteger;
   query_arma.ParamByName('CODEMP').AsInteger:=DM2.Qr_CorP2CODEMP.AsInteger;
   query_arma.ParamByName('CODPRO').AsFloat  :=DM2.Qr_CorP2CODPRO.AsFloat;
   query_arma.ParamByName('ITEM').AsFloat    :=DM2.Qr_CorP2ITEM.AsInteger;
   try
      query_arma.Open;
   except
      end;
   Query_arma.First;
   While not Query_arma.Eof do
      begin
      mXmlString.Add('<arma>');
      mXmlString.Add(fGeraXMLString(0,'tpArma',Query_arma.fieldbyName('P2ARMA_TPARMA').AsString));

      if length(trim(Query_arma.fieldbyName('P2ARMA_NSERIE').AsString))>9 then
         mXmlString.Add(fGeraXMLString(0,'nSerie',copy(Query_arma.fieldbyName('P2ARMA_NSERIE').AsString,length(Query_arma.fieldbyName('P2ARMA_NSERIE').AsString)-8,9)))
      else
         mXmlString.Add(fGeraXMLString(0,'nSerie',Query_arma.fieldbyName('P2ARMA_NSERIE').AsString));
      if length(trim(Query_arma.fieldbyName('P2ARMA_NCANO').AsString))>2 then
         begin
          if length(trim(Query_arma.fieldbyName('P2ARMA_NCANO').AsString))>9 then
             mXmlString.Add(fGeraXMLString(0,'nCano',copy(Query_arma.fieldbyName('P2ARMA_NCANO').AsString,length(Query_arma.fieldbyName('P2ARMA_NCANO').AsString)-8,9)))
          else
             mXmlString.Add(fGeraXMLString(0,'nCano',Query_arma.fieldbyName('P2ARMA_NCANO').AsString));
         end
      else
         mXmlString.Add(fGeraXMLString(0,'nCano',''));
      mXmlString.Add(fGeraXMLString(0,'descr',Query_arma.fieldbyName('P2ARMA_DESCR').AsString));
      mXmlString.Add('</arma>');
      query_arma.Next;
      end;
   result:=true;
   end;

