                    ,pcoddep
                    ,pnomdep
                    ,pnome
                    ,ptipo
                    ,pnombco
                    ,pdescmv
                    ,result.idNew

                    ); // origem


   end;


//Result:=mChaveIdLdr;
end;

function fCriarLDR_Replica(pTipoInc,pcodemp: Integer;pvalorr,pvalorp,pcodigo,pVinculo :Real;
                   pdatap, pdatareal, pdataref, pdataalt: TDateTime;
                   pcodcc,pcoddep,pnatdc,pdescmv,pnumdoc,pnumdoc2,ptipo,
                   pnombco,pnomdep,pnomccu,pnome,pobsDar : String;
                   pLocdep,pcodbco,plotmov,pStatus,pOrigem: Integer;
                   // valores anteriores
                   pcodigo_ant,pcodbco_ant,pCodLdr_ant: Real;
                   pcodcc_ant,pnomccu_ant,pnatdc_ant,pcoddep_ant,pnomdep_ant,pnomesac_ant
                   ,ptipo_ant,pnombco_ant,pdescmv_ant: String; pIdLdrNew: Real ): tChaveIdLdr;
// pTipoInc=0 pelo dm4 execsql, 1 pelo DM1.Tb_LDR direto
begin

if pcodbco=0 then
   begin
   pcodbco:=round(pcodbco_ant);
   pnombco:=pnombco_ant;
   end;
if pcodigo=0 then
   begin
   ptipo       := ptipo_ant;
   pcodigo_ant := pcodigo_ant;
   pnomesac_ant:= pnomesac_ant;
   end;

if (trim(pcodcc)='') or (Trim(pcodcc)='_') then
   begin
   pnatdc   := pnatdc_ant;
   pcodcc   := pcodcc_ant;
   pnomccu  := pnomccu_ant;
   end;
if (trim(pcoddep)='') or (Trim(pcoddep)='_') then
   begin
   pcoddep  := pcoddep_ant;
   pnomdep  := pnomdep_ant;
   end;
if trim(pdescmv)='' then
   pdescmv:=pdescmv_ant;
if pTipoInc=1 then
   begin
   DM1.Tb_LDR.Append;
   DM1.Tb_LDRCODEMP.AsFloat     := pCodEmp;
   DM1.Tb_LDRDATADP.AsDateTime  := pDatap;
   DM1.Tb_LDRDATAREAL.AsDateTime:= pDataReal;
   DM1.Tb_LDRDATAREF.AsDateTime := pDataRef;
   DM1.Tb_LDRVALORP.AsFloat     := pvalorp;
   DM1.Tb_LDRVALORR.AsFloat     := pvalorr;
   DM1.Tb_LDRTIPO.AsString      := ptipo;
   DM1.Tb_LDRCODIGO.AsFloat     := pcodigo;
   DM1.Tb_LDRNOME.AsString      := pnome;
   DM1.Tb_LDRFC_OBSFIN.Value    := pobsDar;
   DM1.Tb_LDRNATDC.AsString     := pnatdc;
   DM1.Tb_LDRCODCC.AsString     := pcodcc;
   DM1.Tb_LDRNOMCCU.AsString    := pnomccu;
   DM1.Tb_LDRCODDEP.AsString    := pcoddep;
   DM1.Tb_LDRNOMDEP.AsString    := pnomdep;
   DM1.Tb_LDRCODBCO.AsFloat     := pcodbco;
   DM1.Tb_LDRNOMBCO.AsString    := pnombco;
   DM1.Tb_LDRNUMDOC.AsString    := pnumdoc;
   DM1.Tb_LDRNUMDOC2.AsString   := pnumdoc2;
   DM1.Tb_LDRSTATUS.AsFloat     := pStatus;
   DM1.Tb_LDRORIGEM.AsFloat     := pOrigem;
   DM1.Tb_LDRLOCDEP.AsFloat     := pLocdep;
   DM1.Tb_LDRUSRALT.AsFloat     := 0;
   DM1.Tb_LDRDTALT.AsDateTime      := pdatanula;
   DM1.Tb_LDRHRALT.AsString     := ' ';
   DM1.Tb_LDRCOMPENS.AsFloat    := 0;
   DM1.Tb_LDRUSREXC.AsFloat     := 0;
   DM1.Tb_LDRDTCOMP.AsDateTime  := pdatasis;
   DM1.Tb_LDRDTHREXC.AsDateTime := pdatanula;
   DM1.Tb_LDRLOTSEQ.AsFloat     := ls_codldr;
   DM1.Tb_LDRLOTMOV.AsFloat     := plotmov;
