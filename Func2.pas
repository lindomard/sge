                                ,0 -- origem
                                ,2 -- LOCDEP
                                ,'CL' -- tipo 
                                ,:NEW.P1CODCLI




termino
           end if;

  

--    RAISE_APPLICATION_ERROR(-20000, 'Entrou noa funcao lindomar ANTES CADP01 ' ||  mExisteDup );

           if mExisteDup=0 then
              Insert into CADDAR (
              CRCODEMP
              ,CRCODECF
              ,CRNUMERO
              ,CRDESD
              ,CRDUP
              ,CRCODCLI
              ,CRNUMCUP
