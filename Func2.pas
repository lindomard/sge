function fGeraXMLString(pTipo: Integer;pNomeCampo,pValor: String): String;
var
mResult: String;
mtam,x: Integer;
mTextoSai: String;
mpos: Integer;
begin

if ptipo=1 then
   mTextoSai:=pValor
else
   begin
   mtam:=length(pValor);
   pvalor:=AnsiToAscii(pValor);

   mTextoSai:='';
   for x:=1 to mtam do
      begin
      if (x<mtam) and (pValor[x]=' ') and (pValor[x+1]=' ') then
      else
         begin
         if pValor[x]='&' then
            mTextoSai:=mTextoSai+'e'
         else if (pValor[x] in ['a'..'z']) or
            (pValor[x] in ['A'..'Z']) or
            (pValor[x] in ['0'..'9']) or
            (pValor[x] in ['?','[',']','-','_','*','%','$','@',' ','/','.',',','+',':','#','\']) then
             mTextoSai:=mTextoSai+pvalor[x]
         else
             mTextoSai:=mTextoSai+'';
         end;
    mTextoSai:=fSubstituirtexto(mTextoSai,' / ','/');
    mTextoSai:=fSubstituirtexto(mTextoSai,' /','/');
    mTextoSai:=fSubstituirtexto(mTextoSai,')/',') ');


      end;
   end;


if trim(mTextoSai)='' then
   mResult:='<'+pNomeCampo+'/>'
else
   mResult:='<'+pNomeCampo+'>'+trim(mTextoSai)+'</'+pNomeCampo+'>';
result:=mResult;
end;

   {
      if pValor[x]='>' then
         mTextoSai:=mTextoSai+'&lt;'
      else if pValor[x]='/' then
         mTextoSai:=mTextoSai+'-'
      else if pValor[x]='\' then
         mTextoSai:=mTextoSai+'-'
      else if pValor[x]='<' then
         mTextoSai:=mTextoSai+'&gt;'
      else if pValor[x]='&' then
         mTextoSai:=mTextoSai+'&amp;'
      else if pValor[x]='"' then
         mTextoSai:=mTextoSai+'&quot;'
      else if pValor[x]=chr(39)+chr(39)+chr(39) then
         mTextoSai:=mTextoSai+'&#39;'
      else if pValor[x]='°' then
         mTextoSai:=mTextoSai+'o.'
      else
         mTextoSai:=mTextoSai+pvalor[x];
   }




