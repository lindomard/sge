function fValidaXML(pTipo: Integer;pTabela: TDataSet): Boolean;
var
mPosPedido: TBookmark;
begin

if ((not pTabela.active) or (pTabela.IsEmpty)) and (pTabela.FieldbyName('P1TIPO').Asinteger<90)  then
   begin
   fMensagem('Favor Selecionar um arquivo valido!',0,['0'],0);
   Result:=false;
   exit;
   end;

if valint(fdeixanum(mNFEVersao))>=20 then
   begin
   if (trim(dm4.Tb_ParGer02PG2VALXMLENVIO.AsString)='') or
      (trim(dm4.Tb_ParGer02PG2VALXMLRETORNO.AsString)='') then
      begin
      fmensagem('o Seu Sistema não esta configurado para Validar Arquivo XML!',0,['0'],0);
      Result:=false;
      exit;
      end;

   if (not DirExists(dm4.Tb_ParGer02PG2VALXMLENVIO.AsString)) then
      begin
      fmensagem('o Caminho: '+dm4.Tb_ParGer02PG2VALXMLENVIO.AsString+' Não Foi Encontrado. Seu Sistema não esta configurado Corretamente para Validar Arquivo XML!',0,['0'],0);
      Result:=false;
      exit;
      end;

   if (not DirExists(dm4.Tb_ParGer02PG2VALXMLRETORNO.AsString)) then
      begin
      fmensagem('o Caminho: '+dm4.Tb_ParGer02PG2VALXMLENVIO.AsString+' Não Foi Encontrado. Seu Sistema não esta configurado Corretamente para Validar Arquivo XML!',0,['0'],0);
      Result:=false;
      exit;
      end;
   end;
mPosPedido:=pTabela.GetBookMark;
pTabela.First;
if pTabela.Eof then
   begin
   result:=false;
   exit;
   end;
result:=false;
if not fTestaNFE(pTabela.Fieldbyname('P1CODEMP').AsFloat,pTabela.Fieldbyname('P1CODCLI').AsFloat,
                pTabela.FieldbyName('P1LOTSEQ').AsFloat,
                pTabela.FieldbyName('P1CHAVE').AsFloat,
                pTabela.FieldbyName('P1ORDEM').AsFloat) then
   begin
   pTabela.GotoBookmark(mPosPedido);
   Result:=false;
   exit;
   end;


if ptipo<>1 then
   begin
   if Fmensagem('Quer Realmente Validar o XML?',0,['1','2'],2)<>mrYes then
      begin
      pTabela.GotoBookmark(mPosPedido);
      Result:=false;
      exit;
      end;
   end;
pTabela.First;

While not pTabela.eof do
   begin
   if pTabela.Fieldbyname('P1CODEMP').AsInteger>100 then
      begin
      pTabela.Next;
      Continue;
      end;
   if not FPedEmiteNf(0,pTabela.Fieldbyname('P1CODSER').AsInteger,0,pTabela.Fieldbyname('P1LOTSEQ').AsInteger,
        pTabela.Fieldbyname('P1CHAVE').AsInteger,pTabela.Fieldbyname('P1ORDEM').AsInteger,
        pTabela.Fieldbyname('P1CODEMP').AsInteger,0,
        pTabela.Fieldbyname('P1FORMACE').AsInteger,false,true,true,1,0,0) then  // Reemisao de Nota fiscal
      begin
      result:=false;
      exit;
      end;
   pTabela.next
   end;
pTabela.First;
try
   pTabela.GotoBookmark(mPosPedido);
except
   end;


result:=true;
end;




function fConsultaProtocolo(pChave_NFE: String;pNumNF: Integer;pValidaXML: Boolean): Integer; // 0-Ok 1-Erro Xml
var
mPastaEnvio_NFE, mPastaRetorno_NFE,mArqRetorno: String;
pNumDoc:Real;
mNomeArq_Xml: String;
f_xml: TextFile;
mRetorno: Integer;




mLinha_lid: String;
mPosIgual,x : Integer;
mErroXml  : Boolean;

begin

if valint(fdeixanum(mNFEVersao))<20 then
   begin
   result:=2;
   exit;
   end;


if not fGerenciadorNFEAtivo then
   begin
   result:=1;
   exit;
   end;



if valint(fdeixanum(mNFEVersao))>=20 then
   begin
   if length(trim(DM4.Tb_ParGer02PG2NFEPASTAMASTER.AsString))<2 then
      mPastaEnvio_NFE:='C:\INTERSYS_NFE\NFE'
   else
      mPastaEnvio_NFE:=DM4.Tb_ParGer02PG2NFEPASTAMASTER.AsString;
   mPastaEnvio_NFE:=mPastaEnvio_NFE+'\'+insere(DM1.Tb_EmpCGC.AsString,'0',14);

   if PValidaXML then
      begin
      mPastaEnvio_NFE:=mPastaEnvio_NFE+'\VALIDARXML';
      pNumDoc:=StrtoFloat(FormatDateTime('ddmmhhnnss',now));
      end
   else
      begin
      pNumDoc:=StrtoFloat(FormatDateTime('ddmmhhnnss',now));
      if DM4.Tb_ParGer02PG2NFETPEMIS.AsInteger=3 then
         mPastaEnvio_NFE:=mPastaEnvio_NFE+'\SCAN';
      end;
   mNomeArq_Xml:=FloattoStr(pNumDoc)+'-ped-sit';

   if not DirExists(mPastaEnvio_NFE) then
      CreateDir(mPastaEnvio_NFE);
   mPastaRetorno_NFE:=mPastaEnvio_NFE+'\RETORNO';
   if not DirExists(mPastaRetorno_NFE) then
      CreateDir(mPastaRetorno_NFE);
   mPastaEnvio_NFE:=mPastaEnvio_NFE+'\ENVIO';
   if not DirExists(mPastaEnvio_NFE) then
      CreateDir(mPastaEnvio_NFE);
   mPastaEnvio_NFE:=mPastaEnvio_NFE+'\';
   mPastaRetorno_NFE:=mPastaRetorno_NFE+'\';
   end
else if PValidaXML then
   begin

   if (trim(dm4.Tb_ParGer02PG2VALXMLENVIO.AsString)='') then
       mPastaEnvio_NFE:='C:\SGE\NFE'
    else
       mPastaEnvio_NFE:=DM4.Tb_ParGer02PG2VALXMLENVIO.AsString;
    if not DirExists(mPastaEnvio_NFE) then
       CreateDir(mPastaEnvio_NFE);
    if mPastaEnvio_NFE[length(mPastaEnvio_NFE)]<>'\' then
       mPastaEnvio_NFE:=mPastaEnvio_NFE+'\';

    if (trim(dm4.Tb_ParGer02PG2VALXMLRETORNO.AsString)='') then
       mPastaRetorno_NFE:='C:\SGE\NFE'
    else
       mPastaRetorno_NFE:=DM4.Tb_ParGer02PG2VALXMLRETORNO.AsString;
    if not DirExists(mPastaRetorno_NFE) then
       CreateDir(mPastaRetorno_NFE);
    if mPastaRetorno_NFE[length(mPastaRetorno_NFE)]<>'\' then
       mPastaRetorno_NFE:=mPastaRetorno_NFE+'\';
    pNumDoc:=StrtoFloat(FormatDateTime('ddmmhhnnss',now));
    mNomeArq_Xml:=FloattoStr(pNumDoc)+'-ped-sit'
    end
else
   begin
   if (trim(dm4.Tb_ParGer02PG2PASTAENVIO.AsString)='') then
       mPastaEnvio_NFE:='C:\SGE\NFE'
    else
       mPastaEnvio_NFE:=DM4.Tb_ParGer02PG2PASTAENVIO.AsString;
    if not DirExists(mPastaEnvio_NFE) then
       CreateDir(mPastaEnvio_NFE);
    if mPastaEnvio_NFE[length(mPastaEnvio_NFE)]<>'\' then
       mPastaEnvio_NFE:=mPastaEnvio_NFE+'\';

    if (trim(dm4.Tb_ParGer02PG2PASTARETORNO.AsString)='') then
       mPastaRetorno_NFE:='C:\SGE\NFE'
    else
       mPastaRetorno_NFE:=DM4.Tb_ParGer02PG2PASTARETORNO.AsString;
    if not DirExists(mPastaRetorno_NFE) then
       CreateDir(mPastaRetorno_NFE);
    if mPastaRetorno_NFE[length(mPastaRetorno_NFE)]<>'\' then
       mPastaRetorno_NFE:=mPastaRetorno_NFE+'\';
    pNumDoc:=StrtoFloat(FormatDateTime('ddmmhhnnss',now));
    mNomeArq_Xml:=FloattoStr(pNumDoc)+'-ped-sit'
    end;


if FileExists(mPastaEnvio_NFE+mNomeArq_Xml+'.$$$') then
   begin
   if not DeleteFile(pchar(mPastaEnvio_NFE+mNomeArq_Xml+'.$$$')) then
      begin
      fmensagem('Erro 12169 Nao Foi Possivel Gerar o arquivo XML',0,['0'],0);
      Result:=1;
      exit;
      end;
   end;


assignfile(f_xml,mPastaEnvio_NFE+mNomeArq_Xml+'.$$$');
rewrite(f_xml);
Writeln(f_xml,'<?xml version="1.0" encoding="UTF-8"?>');
//Writeln(f_xml,'<?xml version="1.0" encoding="UTF-8" ?>');


if valint(fdeixanum(DM4.Tb_ParGer02PG2VERSAOXML.AsString))>=20 then
   Writeln(f_xml,'<consSitNFe xmlns="http://www.portalfiscal.inf.br/nfe" versao="'+DM4.Tb_ParGer02PG2VERSAOXML.AsString+'">')
else
   Writeln(f_xml,'<consSitNFe xmlns="http://www.portalfiscal.inf.br/nfe" versao="1.07">');

if DM4.Tb_ParGer02PG2USANFE.AsInteger<2 then
   Writeln(f_xml,fGeraXMLreal(0,'tpAmb',2))  // homologacao
else
   Writeln(f_xml,fGeraXMLreal(0,'tpAmb',1)); // producao
Writeln(f_xml,'<xServ>CONSULTAR</xServ>');
Writeln(f_xml,fGeraXMLString(0,'chNFe',pChave_NFE));

Writeln(f_xml,'</consSitNFe>');
closefile(f_xml);
copyfile(pchar(mPastaEnvio_NFE+mNomeArq_Xml+'.$$$')
       ,pchar('C:\SGE\'+mNomeArq_Xml+'.xml'),false);

RenameFile(pchar(mPastaEnvio_NFE+mNomeArq_Xml+'.$$$')
          ,pchar(mPastaEnvio_NFE+mNomeArq_Xml+'.xml'));

mArqRetorno:=pchar(mPastaRetorno_NFE+mNomeArq_Xml+'.ret');
if FileExists(mArqRetorno) then
   DeleteFile(pchar(mArqRetorno));



Application.CreateForm(TFrm_Agde_Nfe, Frm_Agde_nfe);
mNomeArqRet:=mArqRetorno;
Frm_Agde_nfe.lbl_cliente.Caption    :='';
Frm_Agde_nfe.lbl_cidade_uf.Caption  :='';
Frm_Agde_nfe.lbl_valornumero.Caption:='Consulta NFE: '+FormatFloat('000000', pNumNF);
Frm_Agde_nfe.lbl_arqenv.Caption:='Arquivo Enviado: '+mPastaEnvio_NFE+mNomeArq_Xml+'.xml';
Frm_Agde_nfe.lbl_arqesperado.Caption:='Arquivo Esperado: '+mArqRetorno;


Frm_Agde_nfe.Animate1.Active:=true;
mArquivoRetornou:=false;
Frm_Agde_nfe.ShowModal;
if not mArquivoRetornou then
   begin
   Frm_Agde_nfe.free;
   Frm_Agde_nfe:=nil;
   mRetorno:=1;
   end
else
   begin
   AssignFile(f_xml,mArqRetorno);
   Reset(f_xml);
   while not eof(f_xml) do
      begin
      readln(f_xml,mlinha_lid);
      for x:=1 to length(mlinha_lid) do
         begin
         if mlinha_lid[x]='=' then
            begin
            mposigual:=x;
            break;
            end;
         end;
      mposigual:=mposigual+1;
      if UpperCase(copy(mlinha_lid,1,length('[VALIDACAO]')))='[VALIDACAO]' then
         begin
         mcinst4:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)));
         if mcinst4='OK' then
            begin
            mErroXml:=false;
            mRetorno:=0;
            end
         else
            begin
            mErroXml:=true;
            mRetorno:=2;
            end


         end
      else if UpperCase(copy(mlinha_lid,1,18))='[STATUS_PROTOCOLO]' then
         begin
         mnfe_stat_Prot:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)));
         end
      else if UpperCase(copy(mlinha_lid,1,09))='[STATUS]' then
         begin
         mRetorno:=0;
         mnfe_status:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)));
         if (valint(mnfe_status)=110)  // uso denegadoor
             or (valint(mnfe_status)=241)
             or (valint(mnfe_status)=256) then // ja inutilizada anteriormente
            mRetorno:=2
         else if (valint(mnfe_status)=108) or (valint(mnfe_status)=109)
              or (valint(mnfe_status)=207) or (valint(mnfe_status)=800) then // contigencia
            mnfe_contigencia:='1'
         else
            mnfe_contigencia:='0';
         end
     else if UpperCase(copy(mlinha_lid,1,18))='[NUMERO_PROTOCOLO]' then
        begin
        mnfe_Num_Protolo:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)));
        end

     else if UpperCase(copy(mlinha_lid,1,17))='[DIGITO_VALIDADO]' then
        begin
        mnfe_DigVal:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)));
        end;
      end;
   closefile(f_xml);

   Frm_Agde_nfe.free;
   Frm_Agde_nfe:=nil;
   if (PValidaXML) and (mErroXml)  then
      begin
      Application.CreateForm(TFrm_Sintegra_Advert, Frm_Sintegra_Advert);
      Frm_Sintegra_Advert.tsXml.TabVisible:=true;
      Frm_Sintegra_Advert.Memo_NFSNaoEnc.Lines.LoadFromFile(mArqRetorno);
      Frm_Sintegra_Advert.Memo_Xml.Lines.LoadFromFile('C:\SGE\'+mNomeArq_Xml+'.xml');
      Deletefile(pchar('C:\SGE\'+mNomeArq_Xml+'.xml'));
      Frm_Sintegra_Advert.ShowModal;
      Frm_Sintegra_Advert.Free;
      Frm_Sintegra_Advert:=nil;
      result:=2;
      exit;
      end
   else
      Deletefile(pchar('C:\SGE\'+mNomeArq_Xml+'.xml'));


   DeleteFile(pchar(marqRetorno));
   DeleteFile(pchar(mnfe_nomarqlot));
   DeleteFile(pchar(mnfe_nomarqrec));
//lindomar
   end;
result:=mRetorno;

end;



