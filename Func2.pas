end;

function fimprg(ptipo,plin: Integer;pgrupoa:String): Integer;
// Impressao do rodade do grupo da nota opçao complementar
var
mMaiorLin: Integer;
begin
mMaiorLin:=0;



While not DM2.Qr_TDVCP.Eof do
   begin
   if Trim(DM2.Qr_TDVCPTCOND01.Value)<>'' then
      begin
      if Trim(DM2.Qr_TDVCPTCOND01.Value)='Especial(Grupo Anterior)' then
         pdiversos:=pgrupoa
      else
         pdiversos:=DM2.Qr_Cab.fieldbyName(Trim(DM2.Qr_TDVCPTCOND01.Value)).AsString;
      if DM2.Qr_TDVCPTCONDT2.Value='V' then
         begin
         if not FIRPERCond(DM2.Qr_TDVCPTCONDT1.Value,DM2.Qr_TDVCPTCONDT2.Value,
                          pdiversos,
                           DM2.Qr_TDVCPTCOND02.Value,
                           DM2.Qr_TDVCPTCONDOP.Value,'','','','','',''
                           ,'','','','','','') then
            begin
            DM2.Qr_TDVCP.Next;
            Continue;
            end;
         end
      else
         begin
         if not FIRPERCond(DM2.Qr_TDVCPTCONDT1.Value,DM2.Qr_TDVCPTCONDT2.Value,
                           pdiversos,
                           DM2.Qr_Cab.fieldbyName(Trim(DM2.Qr_TDVCPTCOND02.Value)).AsString,
                           DM2.Qr_TDVCPTCONDOP.Value,'','','','','',''
                           ,'','','','','','') then
            begin
            DM2.Qr_TDVCP.Next;
            Continue;
            end;
         end;
      end;

   if DM2.Qr_TDVCPTTAM.IsNull then
      mtam:=0
   else
      mtam:=DM2.Qr_TDVCPTTAM.AsInteger;
   maux:='';
   if DM2.Qr_TDVCPTTIPO.Value=0 then
      begin
      if DM2.Qr_TDVCPTTIPOC.Value='D' then
         begin
         if Trim(DM2.Qr_TDVCPTFORMATO.Value)='' then
            maux:=FormatDateTime(fdt2,DM2.Qr_Cab.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsDateTime)
         else
            maux:=FormatDateTime(Trim(DM2.Qr_TDVCPTFORMATO.Value),
                  DM2.Qr_Cab.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsDateTime);
         end
      else if DM2.Qr_TDVCPTTIPOC.Value='H' then
         begin
         if Trim(DM2.Qr_TDVCPTFORMATO.Value)='' then
            maux:=FormatDateTime(fhr,DM2.Qr_Cab.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsDateTime)
         else
            maux:=FormatDateTime(Trim(DM2.Qr_TDVCPTFORMATO.Value),
                  DM2.Qr_Cab.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsDateTime);
         end
      else if DM2.Qr_TDVCPTTIPOC.Value='N' then
         begin
         if Trim(DM2.Qr_TDVCPTFORMATO.Value)='' then
            maux:=DM2.Qr_Cab.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsString
         else
            maux:=FormatFloat(Trim(DM2.Qr_TDVCPTFORMATO.Value),
                  DM2.Qr_Cab.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsFloat);
         end
      else
         begin
         maux:=DM2.Qr_Cab.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsString;
         end;
      end
   else if DM2.Qr_TDVCPTTIPO.Value=1 then
      maux:=DM2.Qr_TDVCPTCAMPO.Value
   else if DM2.Qr_TDVCPTTIPO.Value=2 then
      begin
      if DM2.Qr_TDVCPTCAMPO.Value='Data' then
         begin
         if Trim(DM2.Qr_TDVCPTFORMATO.Value)='' then
            maux:=FormatDateTime(Trim(DM2.Qr_TDVCPTFORMATO.Value),date)
         else
            maux:=FormatDateTime(fdt2,date);
         end
      else if DM2.Qr_TDVCPTCAMPO.Value='Hora' then
         begin
         if Trim(DM2.Qr_TDVCPTFORMATO.Value)='' then
            maux:=FormatDateTime(Trim(DM2.Qr_TDVCPTFORMATO.Value),time)
         else
            maux:=FormatDateTime(fhr,date);
         end
      else if DM2.Qr_TDVCPTCAMPO.Value='Pagina' then
         begin
         if Trim(DM2.Qr_TDVCPTFORMATO.Value)<>'' then
            maux:=FormatFloat(Trim(DM2.Qr_TDVCPTFORMATO.Value),rppag)
         else
            maux:=IntToStr(rppag);
         end
      else if DM2.Qr_TDVCPTCAMPO.Value='Total de Pagina' then
         begin
         if Trim(DM2.Qr_TDVCPTFORMATO.Value)<>'' then
            maux:=FormatFloat(Trim(DM2.Qr_TDVCPTFORMATO.Value),rpqtdpagtot)
         else
            maux:=IntToStr(rpqtdpagtot);
         end;
      end
   else if DM2.Qr_TDVCPTTIPO.Value=3 then
      maux:=insere2(copy(DM2.Qr_TDVCPTCAMPO.Value,1,1),DM2.Qr_TDVCPTCAMPO.Value[1],mtam)
   else if DM2.Qr_TDVCPTTIPO.Value=4 then
      begin
      if Trim(DM2.Qr_TDVCPTFORMATO.Value)='' then
         maux:=FloatToStr(mtopper[DM2.Qr_TDVCPTCAMPO.AsInteger])
      else
         maux:=FormatFloat(Trim(DM2.Qr_TDVCPTFORMATO.Value),mtopper[DM2.Qr_TDVCPTCAMPO.AsInteger]);
      if DM2.Qr_TDVCPTZERVAR.Value=1 Then
         mtopper[DM2.Qr_TDVCPTCAMPO.AsInteger]:=0;
      end
// inicio 5
   else if DM2.Qr_TDVCPTTIPO.Value=5 then
      begin
      if DM2.Qr_TDVCPTTIPOC.Value='D' then
         begin
         if Trim(DM2.Qr_TDVCPTFORMATO.Value)='' then
            maux:=FormatDateTime(fdt2,DM1.Tb_Emp.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsDateTime)
         else
            maux:=FormatDateTime(Trim(DM2.Qr_TDVCPTFORMATO.Value),
                  DM1.Tb_Emp.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsDateTime);
          end
      else if DM2.Qr_TDVCPTTIPOC.Value='H' then
         begin
         if Trim(DM2.Qr_TDVCPTFORMATO.Value)='' then
            maux:=FormatDateTime(fhr,DM1.Tb_Emp.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsDateTime)
         else
            maux:=FormatDateTime(Trim(DM2.Qr_TDVCPTFORMATO.Value),
                DM1.Tb_Emp.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsDateTime);
         end
      else if DM2.Qr_TDVCPTTIPOC.Value='N' then
         begin
         if Trim(DM2.Qr_TDVCPTFORMATO.Value)='' then
            maux:=DM1.Tb_Emp.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsString
         else
            maux:=FormatFloat(Trim(DM2.Qr_TDVCPTFORMATO.Value),
            DM1.Tb_Emp.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsFloat);
         end
      else
         begin
         maux:=DM1.Tb_Emp.fieldbyName(Trim(DM2.Qr_TDVCPTCAMPO.AsString)).AsString;
        end;
      end
 // fim 5


   else if DM2.QR_TDVCPTTIPO.Value=7 then
      begin
      maux:='';
      mcinst:='';
      if DM2.Tb_JC.Locate('JCNOMCAM',DM2.QR_TDVCPTCAMPO.Value,[]) then
         begin
         if Trim(DM2.Tb_JCJCCAMPO01.Value)<>'' then
            begin
            mcinst:='';
            if DM2.Tb_JCJCESPACO01.Value>0 then
               maux:=maux+insere(' ',' ',DM2.Tb_JCJCESPACO01.AsInteger);
            if DM2.Tb_JCJCTCAMPO1.Value=0  then
               mcinst:=DM2.Qr_Cab.fieldbyName(Trim(DM2.Tb_JCJCCAMPO01.AsString)).AsString
            else if DM2.Tb_JCJCTCAMPO1.Value=1 then
               mcinst:=DM2.Tb_JCJCCAMPO01.AsString
            else if DM2.Tb_JCJCTCAMPO1.Value=2  then
               mcinst:=DM1.Tb_Emp.fieldbyName(Trim(DM2.Tb_JCJCCAMPO01.AsString)).AsString;
            if DM2.Tb_JCJCBRANCOS01.Value=1 then
               mcinst:=TrimLeft(mcinst)
            else if DM2.Tb_JCJCBRANCOS01.Value=2 then
               mcinst:=TrimRight(mcinst)
            else if DM2.Tb_JCJCBRANCOS01.Value=3 then
               mcinst:=Trim(mcinst);
            if (DM2.Tb_JCJCTAMMAX01.Value>0) and (length(mcinst)>DM2.Tb_JCJCTAMMAX01.Value) then
               mcinst:=copy(mcinst,1,DM2.Tb_JCJCTAMMAX01.AsInteger);
            maux:=maux+mcinst;
            end;

         if Trim(DM2.Tb_JCJCCAMPO02.Value)<>'' then
            begin
            mcinst:='';
            if DM2.Tb_JCJCESPACO02.Value>0 then
               maux:=maux+insere(' ',' ',DM2.Tb_JCJCESPACO02.AsInteger);
            if DM2.Tb_JCJCTCAMPO2.Value=0  then
               mcinst:=DM2.Qr_Cab.fieldbyName(Trim(DM2.Tb_JCJCCAMPO02.AsString)).AsString
            else if DM2.Tb_JCJCTCAMPO2.Value=1 then
               mcinst:=DM2.Tb_JCJCCAMPO02.Value
            else if DM2.Tb_JCJCTCAMPO2.Value=2  then
               mcinst:=DM1.Tb_Emp.fieldbyName(Trim(DM2.Tb_JCJCCAMPO02.AsString)).AsString;
            if DM2.Tb_JCJCBRANCOS02.Value=1 then
               mcinst:=TrimLeft(mcinst)
            else if DM2.Tb_JCJCBRANCOS02.Value=2 then
               mcinst:=TrimRight(mcinst)
            else if DM2.Tb_JCJCBRANCOS02.Value=3 then
               mcinst:=Trim(mcinst);
            if (DM2.Tb_JCJCTAMMAX02.Value>0) and (length(mcinst)>DM2.Tb_JCJCTAMMAX02.Value) then
               mcinst:=copy(mcinst,1,DM2.Tb_JCJCTAMMAX02.AsInteger);
            maux:=maux+mcinst;
            end;

         if Trim(DM2.Tb_JCJCCAMPO03.Value)<>'' then
            begin
            mcinst:='';
            if DM2.Tb_JCJCESPACO03.Value>0 then
               maux:=maux+insere(' ',' ',DM2.Tb_JCJCESPACO03.AsInteger);
            if DM2.Tb_JCJCTCAMPO3.Value=0  then
               mcinst:=DM2.Qr_Cab.fieldbyName(Trim(DM2.Tb_JCJCCAMPO03.AsString)).AsString
            else if DM2.Tb_JCJCTCAMPO3.Value=1 then
               mcinst:=DM2.Tb_JCJCCAMPO03.AsString
            else if DM2.Tb_JCJCTCAMPO3.Value=2  then
               mcinst:=DM1.Tb_Emp.fieldbyName(Trim(DM2.Tb_JCJCCAMPO03.AsString)).AsString;
            if DM2.Tb_JCJCBRANCOS03.Value=1 then
               mcinst:=TrimLeft(mcinst)
            else if DM2.Tb_JCJCBRANCOS03.Value=2 then
               mcinst:=TrimRight(mcinst)
            else if DM2.Tb_JCJCBRANCOS03.Value=3 then
               mcinst:=Trim(mcinst);
            if (DM2.Tb_JCJCTAMMAX03.Value>0) and (length(mcinst)>DM2.Tb_JCJCTAMMAX03.Value) then
               mcinst:=copy(mcinst,1,DM2.Tb_JCJCTAMMAX03.AsInteger);
            maux:=maux+mcinst;
            end;

         if Trim(DM2.Tb_JCJCCAMPO04.Value)<>'' then
            begin
            mcinst:='';
            if DM2.Tb_JCJCESPACO04.Value>0 then
               maux:=maux+insere(' ',' ',DM2.Tb_JCJCESPACO04.AsInteger);
            if DM2.Tb_JCJCTCAMPO4.Value=0  then
               mcinst:=DM2.Qr_Cab.fieldbyName(Trim(DM2.Tb_JCJCCAMPO04.AsString)).AsString
            else if DM2.Tb_JCJCTCAMPO4.Value=1 then
               mcinst:=DM2.Tb_JCJCCAMPO04.AsString
            else if DM2.Tb_JCJCTCAMPO4.Value=2  then
               mcinst:=DM1.Tb_Emp.fieldbyName(Trim(DM2.Tb_JCJCCAMPO04.AsString)).AsString;
            if DM2.Tb_JCJCBRANCOS04.Value=1 then
               mcinst:=TrimLeft(mcinst)
            else if DM2.Tb_JCJCBRANCOS04.Value=2 then
               mcinst:=TrimRight(mcinst)
            else if DM2.Tb_JCJCBRANCOS04.Value=3 then
               mcinst:=Trim(mcinst);
            if (DM2.Tb_JCJCTAMMAX04.Value>0) and (length(mcinst)>DM2.Tb_JCJCTAMMAX04.Value) then
               mcinst:=copy(mcinst,1,DM2.Tb_JCJCTAMMAX04.AsInteger);
            maux:=maux+mcinst;
            end;
         end;
      end;


   if DM2.Qr_TDVCPTFONTE.Value=0 then
      mfonte:=normal
   else if DM2.Qr_TDVCPTFONTE.Value=1 then
      mfonte:=comp12
   else if DM2.Qr_TDVCPTFONTE.Value=2 then
      mfonte:=comp17
   else if DM2.Qr_TDVCPTFONTE.Value=3 then
      mfonte:=comp20
   else if DM2.Qr_TDVCPTFONTE.Value=4 then
      mfonte:=negrito
   else if DM2.Qr_TDVCPTFONTE.Value=5 then
      mfonte:=expandido;

   if mtam>0 then
      begin
      if length(trim(maux))>mtam then
         begin
         if DM2.Qr_TDVCPTCCORTARDE.Value=1 then
            maux:=copy(maux,length(trim(maux))-(mtam-1),mtam)
         else
