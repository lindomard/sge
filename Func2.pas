function falterdesc(ptipo: Integer): Integer;
// Impressao do corpo da nota lindomar
begin
DM1.Tb_Ped02D.Close;
DM1.Tb_Ped02d.SQL.Clear;
DM1.Tb_Ped02d.SQL.Add('Select * from CADP02D where  P2DCODEMP=0'+Inttostr(par_codemp)
                     +' and P2DTIPO=0'+IntToStr(ptipo)
                     +' and P2DLOTSEQ=0'+Inttostr(par_lotseq)
                     +' and P2DCHAVE=0'+Inttostr(par_chave)
                     +' and P2DORDEM=0'+IntTostr(par_ordem)
                     +' and P2DCODPRO=0'+FloatTostr(par_codpro)
                     +' and P2DITEM=0'+FloatTostr(par_item)
                     +' order by P2DCODEMP,P2DCHAVE,P2DORDEM,P2DLINHA');
DM1.Tb_Ped02d.Open;
result:=0;
While not DM1.Tb_Ped02d.Eof do
   begin
   if DM1.Tb_TDVTTAM.IsNull then
      mtam:=0
   else
      mtam:=DM1.Tb_TDVTTAM.AsInteger;
   maux:=DM1.Tb_Ped02DP2DESC.Value;
   if DM1.Tb_TDVTFONTE.Value=0 then
      mfonte:=normal
   else if DM1.Tb_TDVTFONTE.Value=1 then
      mfonte:=comp12
   else if DM1.Tb_TDVTFONTE.Value=2 then
      mfonte:=comp17
   else if DM1.Tb_TDVTFONTE.Value=3 then
      mfonte:=comp20
   else if DM1.Tb_TDVTFONTE.Value=4 then
      mfonte:=negrito
   else if DM1.Tb_TDVTFONTE.Value=5 then
      mfonte:=expandido;

   if mtam>0 then
      begin
      if length(trim(maux))>mtam then
         begin
         if DM1.Tb_TDVTCCORTARDE.Value=1 then
            maux:=copy(maux,length(trim(maux))-(mtam-1),mtam)
         else
            maux:=copy(maux,1,mtam);
         end
      else
         begin
         if DM1.Tb_TDVTALINHAR.Value=0 then
            maux:=insere2(maux,' ',mtam)
         else if DM1.Tb_TDVTALINHAR.Value=1 then
            maux:=insere(maux,' ',mtam)
         else if DM1.Tb_TDVTALINHAR.Value=2 then
            maux:=Centra(maux,' ',mtam);
         end;
      end;
   form_impres_func2.RDPrint1.ImpF(DM1.Tb_TDVTLIN.AsInteger+mlin,DM1.Tb_TDVTCOL.AsInteger,maux,[mfonte]);
   DM1.Tb_Ped02D.Next;
   mlin:=mlin+1;
   result:=1;
   end;
//if flin>0 then
//   flin:=flin-1;
end;



