    function fGerarTagICMSUFDEST(pUf, pCodNcm: String;
                                 pGerarTagDifal
                                , pVBCUFDEST
                                ,pPFCPUFDEST
                                ,pPICMSUFDEST
                                ,pPICMSINTER
                                ,pPICMSINTERPART
                                ,pVFCPUFDEST
                                ,pVICMSUFDEST
                                ,pVICMSUFREMET: Real): String;
    var
      mRetorno: String;
      query_difal: tQuery;
    begin
    mretorno:='';


    if ((pVICMSUFDEST=0) and (pvFCPUFDest=0) or (pGerarTagDifal=0))  then
       mretorno:=''
    else
       begin
       query_difal := tQuery.Create(nil);
       query_difal.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
       query_difal.SQL.clear;
       query_difal.SQL.Add('SELECT * FROM CADUF_EXCETONCM '
                          +' where DEUF_SIGLA='+QuotedStr(pUf)+' AND DEUF_CODNCM='+QuotedStr(pCodNcm));
       try
          query_difal.Open;
        except on e : exception do
           begin
           ex_erroSql_Novo(query_difal,16299,'SGE','CADUF_EXCETONCM');
           end;
           end;
        if query_difal.IsEmpty then
           begin
           pvFCPUFDest:=Arredonda(pvFCPUFDest,2);
           pVICMSUFDEST:=Arredonda(pVICMSUFDEST,2);

           pvICMSUFRemet:=Arredonda(pvICMSUFRemet,2);
           pVBCUFDEST:=Arredonda(pVBCUFDEST,2);
           pvFCPUFDest:=Arredonda(pvFCPUFDest,2);
           pvICMSUFRemet:=Arredonda(pvICMSUFRemet,2);

           mvFCPUFDest  :=mvFCPUFDest+pvFCPUFDest;
           mvICMSUFDest :=mvICMSUFDest+pVICMSUFDEST;
           mvICMSUFRemet:=mvICMSUFRemet+pvICMSUFRemet;

           mTot_VBCUFDEST   :=mTot_VBCUFDEST+pVBCUFDEST;
           mTot_vFCPUFDest  :=mTot_vFCPUFDest+pvFCPUFDest;
           mTot_vICMSUFDest :=mTot_vICMSUFDest+pVICMSUFDEST;
           mTot_vICMSUFRemet:=mTot_vICMSUFRemet+pvICMSUFRemet;
           mRetorno := '<ICMSUFDest>';
           mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(2, 'vBCUFDest', pVBCUFDEST);
           if (valint(fdeixanum(DM4.Tb_ParGer02PG2VERSAOXML.AsString))>310) then
              mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(2, 'vBCFCPUFDest', pVBCUFDEST);
           mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(4, 'pFCPUFDest', pPFCPUFDEST);
           mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(4, 'pICMSUFDest', ppICMSUFDest);
           if arredonda(pPICMSINTER,2)=pPICMSINTER then
              mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(2, 'pICMSInter', ppICMSInter)
          else if arredonda(pPICMSINTER,3)=pPICMSINTER then
              mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(3, 'pICMSInter', ppICMSInter)
          else
             mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(4, 'pICMSInter', ppICMSInter);


          mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(4, 'pICMSInterPart', pPICMSINTERPART);
          mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(2, 'vFCPUFDest', pvFCPUFDest);
          mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(2, 'vICMSUFDest', pVICMSUFDEST);
          mRetorno := mRetorno + #13 + ' ' + fGeraXMLReal(2, 'vICMSUFRemet', pvICMSUFRemet);

          mRetorno := mRetorno + #13 + ' ' + '</ICMSUFDest>';
          end;
       query_difal.close;
       freeandnil(query_difal);

       end;


    result := mRetorno;

    end;




