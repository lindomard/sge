DM4.Qr_IncLDR.ParambyName('DATAREF').AsDateTime := pDataRef;
DM4.Qr_IncLDR.ParambyName('VALORP').AsFloat     := pvalorp;
DM4.Qr_IncLDR.ParambyName('VALORR').AsFloat     := pvalorr;
