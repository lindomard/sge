function fBaixarArquivoFtp(pNomeArq: String): boolean;
var
mArquivoLote: TStrings;
mServer: String;
mArquivoSalvar: String;
mArqFtp: String;
x_serv: integer;
begin

mArqFtp:='ftpsgetemp';




try
   mArquivoSalvar := mNomeProjettoJavaExterno;
   mArquivoLote:=TStringList.Create;


   for x_serv:=0 to 1 do
      begin
      if x_serv=1 then
         mServer:='localhost'
      else
        mServer:='intersysnet1.sytes.net';
      mArquivoLote.clear;
      mArquivoLote.Add('open');
      mArquivoLote.Add(mServer);
      mArquivoLote.Add('suporte');
      mArquivoLote.Add('landscape');

      mArquivoLote.Add('cd programasauxiliares/');
      mArquivoLote.Add('get '+mArquivoSalvar+' '+mpastaaplicacao+mArquivoSalvar);
      mArquivoLote.Add('quit');
      mArquivoLote.SaveToFile(mpastaaplicacao+mArqFtp+'.txt');

      mArquivoLote.Clear;


      mArquivoLote.Add('@echo off');
      if copy(mpastaaplicacao,2,1)=':' then
         begin
         mArquivoLote.Add(copy(mpastaaplicacao,1,2));
         mArquivoLote.Add('cd ' + copy(mpastaaplicacao,3,length(mpastaaplicacao)-2));
         end;
      mArquivoLote.Add('ftp -s:'+mArqFtp+'.txt');
      mArquivoLote.Add('quit');
      mArquivoLote.Add('exit');
      mArquivoLote.SaveToFile(mpastaaplicacao+mArqFtp+'.bat');
      result:=fexecprog_espera(mpastaaplicacao+mArqFtp+'.bat',0)=0;
      if FileExists(mpastaaplicacao+mArquivoSalvar ) then
         break;

      end;
   if not FileExists(mpastaaplicacao+mArquivoSalvar ) then
      begin
      MessageDlg('Nao Conseguiu Baixar o Arquivo '+mArquivoSalvar ,mtWarning,[mbOk],0);
      result:=false;
      end;

except on e : exception do
   begin
   MessageDlg('Erro '+ e.Message+#13+' ao baixar o arquivo '+pNomeArq,mtError,[mbOk],0);
   result:=false;
   end;
   end;


end;

