function fAjustaTexto(pTextoAcumulado,pTextoNovo: String; pFontePadrao,pFonteTexto,pcoluna: Integer):String;
var
mTamPad  :Integer;
mTamEste : Real;
mTamCampo: Real;
begin
{
if mTamCampo<1 then
   begin
   result:=pTextoNovo;
   exit;
   end;
}
if pFontePadrao=0 then
   mtampad:=10
else if pFontePadrao=1 then
   mtampad:=12
else if pFontePadrao=2 then
   mtampad:=17
else if pFontePadrao=3 then
   mtampad:=20
else if pFontePadrao=4 then
   mtampad:=10
else if pFontePadrao=5 then
   mtampad:=05
else
   mtampad:=0;
if pFonteTexto=0 then
   mTamEste:=10
else if pFonteTexto=1 then
   mTamEste:=12
else if pFonteTexto=2 then
   mTamEste:=17
else if pFonteTexto=3 then
   mTamEste:=20
else if pFonteTexto=4 then
   mTamEste:=10
else if pFonteTexto=5 then
   mTamEste:=05
else
   mtamEste:=0;

if (mTamPad=0) or (mTamEste=0) then
   mTamCampo:=pcoluna
else if pcoluna<2 then
   mTamCampo:=1
else
   begin
   mTamCampo:=pcoluna*(mtameste/mTamPad);
   mTamCampo:=round(mTamCampo);
   end;
if mtamcampo=1 then
   result:=pTextoNovo
else
   result:=insere2(pTextoAcumulado,' ',round(mTamCampo))+pTextoNovo;
end;

