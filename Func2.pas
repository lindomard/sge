   function fbuscarcodigoncmorigem(plotseq,pcodemp,pchave,pItem: Integer): string;
   var
   query_ncm: TQuery;
   begin
   mQtdDup:=0;
   query_ncm:=TQuery.create(nil);
   query_ncm.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
   query_ncm.sql.add('Select PDCODNCM from CADP02,CADPRO where '
                    +' P2CODEMP=:CODEMP '
                    +' and P2LOTSEQ=:LOTSEQ '
                    +' and P2CHAVE=:CHAVE  '
                    +' and PDCODPRO=P2CODPRO ');
   if pItem>0 then
      begin
      query_ncm.sql.add(' and P2ITEM=:ITEM ');
      query_ncm.ParamByName('ITEM').AsInteger:=pItem;
      end;
   query_ncm.sql.add(' and rownum<2');
   query_ncm.ParamByName('CODEMP').AsInteger:=pcodemp;
