//carta de correcao
function fAguardaReciboNFE(pNumNf: Real;pRetNumRec: String): boolean;
var
f_xml: TextFile;
mPastaEnvio_NFE,mNomeArq_Xml,mArqRetorno, mPastaRetorno_NFE,mlinha_lid : String;
mposigual,x: Integer;
mdados_string:String;
begin



if valint(fdeixanum(mNFEVersao))>=20 then
   begin
   if length(trim(DM4.Tb_ParGer02PG2NFEPASTAMASTER.AsString))<2 then
      mPastaEnvio_NFE:='C:\INTERSYS_NFE\NFE'
   else
      mPastaEnvio_NFE:=DM4.Tb_ParGer02PG2NFEPASTAMASTER.AsString;
   mPastaEnvio_NFE:=mPastaEnvio_NFE+'\'+insere(DM1.Tb_EmpCGC.AsString,'0',14);

   if DM4.Tb_ParGer02PG2NFETPEMIS.AsInteger=3 then
     mPastaEnvio_NFE:=mPastaEnvio_NFE+'\SCAN';
   if not DirExists(mPastaEnvio_NFE) then
      CreateDir(mPastaEnvio_NFE);
   mPastaRetorno_NFE:=mPastaEnvio_NFE+'\RETORNO';
   if not DirExists(mPastaRetorno_NFE) then
      CreateDir(mPastaRetorno_NFE);
   mPastaEnvio_NFE:=mPastaEnvio_NFE+'\ENVIO';
   if not DirExists(mPastaEnvio_NFE) then
      CreateDir(mPastaEnvio_NFE);
   mPastaEnvio_NFE:=mPastaEnvio_NFE+'\';
   mPastaRetorno_NFE:=mPastaRetorno_NFE+'\';
   end
else
   begin
   if (trim(dm4.Tb_ParGer02PG2PASTAENVIO.AsString)='') then
       mPastaEnvio_NFE:='C:\SGE\NFE'
   else
      mPastaEnvio_NFE:=DM4.Tb_ParGer02PG2PASTAENVIO.AsString;
   if not DirExists(mPastaEnvio_NFE) then
      CreateDir(mPastaEnvio_NFE);

   if (trim(dm4.Tb_ParGer02PG2PASTARETORNO.AsString)='') then
      mPastaRetorno_NFE:='C:\SGE\NFE'
   else
      mPastaRetorno_NFE:=DM4.Tb_ParGer02PG2PASTARETORNO.AsString;
   if not DirExists(mPastaRetorno_NFE) then
      CreateDir(mPastaRetorno_NFE);
   end;
if mPastaEnvio_NFE[length(mPastaEnvio_NFE)]<>'\' then
   mPastaEnvio_NFE:=mPastaEnvio_NFE+'\';
if mPastaRetorno_NFE[length(mPastaRetorno_NFE)]<>'\' then
   mPastaRetorno_NFE:=mPastaRetorno_NFE+'\';

mNomeArq_Xml:=FloattoStr(pNumNf)+'-ped-rec';


if FileExists(mPastaEnvio_NFE+mNomeArq_Xml+'.$$$') then
   begin
   if not DeleteFile(pchar(mPastaEnvio_NFE+mNomeArq_Xml+'.$$$')) then
      begin
      fmensagem('Erro 12169 Nao Foi Possivel Gerar o arquivo XML',0,['0'],0);
      Result:=false;
      exit;
      end;
   end;
Application.CreateForm(TFrm_Agde_Nfe, Frm_Agde_nfe);

While true do
   begin
   assignfile(f_xml,mPastaEnvio_NFE+mNomeArq_Xml+'.$$$');
   rewrite(f_xml);
{//   Writeln(f_xml,'<?xml version="1.0" encoding="UTF-8"?>');
   Writeln(f_xml,'<?xml version="1.0" encoding="UTF-8" ?>');
   if DM4.Tb_ParGer02PG2VERSAOXML.AsString='2.00' then
      Writeln(f_xml,'<consReciNFe xmlns="http://www.portalfiscal.inf.br/nfe" versao="'+DM4.Tb_parger02PG2VERSAOXML.AsString+'">')
   else
      Writeln(f_xml,'<consReciNFe xmlns="http://www.portalfiscal.inf.br/nfe" versao="1.10">');
   if DM4.Tb_ParGer02PG2USANFE.AsInteger<2 then
      Writeln(f_xml,fGeraXMLreal(0,'tpAmb',2)) // homologacao
   else
      Writeln(f_xml,fGeraXMLreal(0,'tpAmb',1)); // producao

   Writeln(f_xml,fGeraXMLString(0,'nRec',pRetNumRec));
   Writeln(f_xml,'</consReciNFe>');
}

  mdados_string:='<?xml version="1.0" encoding="UTF-8" ?>';


  if valint(fdeixanum(DM4.Tb_ParGer02PG2VERSAOXML.AsString))>=20 then
     mdados_string:=mdados_string+'<consReciNFe xmlns="http://www.portalfiscal.inf.br/nfe" versao="2.00">'
  else
     mdados_string:=mdados_string+'<consReciNFe xmlns="http://www.portalfiscal.inf.br/nfe" versao="1.10">';
  if DM4.Tb_ParGer02PG2USANFE.AsInteger<2 then
     mdados_string:=mdados_string+fGeraXMLreal(0,'tpAmb',2) // homologacao
  else
     mdados_string:=mdados_string+fGeraXMLreal(0,'tpAmb',1); // producao
  mdados_string:=mdados_string+fGeraXMLString(0,'nRec',pRetNumRec);
  mdados_string:=mdados_string+'</consReciNFe>';
  Writeln(f_xml,mdados_string);
  CloseFile(f_xml);





   mArqRetorno:=pchar(mPastaRetorno_NFE+mNomeArq_Xml+'.ret');
   if FileExists(mArqRetorno) then
      DeleteFile(pchar(mArqRetorno));
   copyfile(pchar(mPastaEnvio_NFE+mNomeArq_Xml+'.$$$')
     ,pchar('C:\SGE\'+mNomeArq_Xml+'.xml'),false);

   RenameFile(pchar(mPastaEnvio_NFE+mNomeArq_Xml+'.$$$')
             ,pchar(mPastaEnvio_NFE+mNomeArq_Xml+'.xml'));


   mNomeArqRet:=mArqRetorno;
   Frm_Agde_nfe.lbl_doc.Caption:='Aguardando Recibo';
   Frm_Agde_nfe.lbl_cliente.Caption    :=DM2.Qr_CabP1CODCLI.AsString+'-'+DM2.Qr_CabCRAZAO.AsString;
   Frm_Agde_nfe.lbl_cidade_uf.Caption  :=DM2.Qr_CabCCIDADE.AsString+'-'+DM2.Qr_CabCUF.AsString;
   Frm_Agde_nfe.lbl_valornumero.Caption:='Número da Nota Fiscal: '+FormatFloat('000000', DM2.Qr_CabP1NUMNF.Value)+' Valor: '+FormatFloat(mcasas, DM2.Qr_CabP1TOTALL.Value);
   Frm_Agde_nfe.lbl_arqenv.Caption:='Arquivo Enviado: '+mPastaEnvio_NFE+mNomeArqRet+'.xml';
   Frm_Agde_nfe.lbl_arqesperado.Caption:='Arquivo Esperado: '+mArqRetorno;

   Frm_Agde_nfe.Animate1.Active:=true;
   mArquivoRetornou:=false;
   Frm_Agde_nfe.ShowModal;

   if not mArquivoRetornou then
      begin
      Frm_Agde_nfe.free;
      Frm_Agde_nfe:=nil;
      result:=false;
      exit;
      end
   else
      begin
      AssignFile(f_xml,mArqRetorno);
      Reset(f_xml);
      while not eof(f_xml) do
         begin
         readln(f_xml,mlinha_lid);
         for x:=1 to length(mlinha_lid) do
            begin
            if mlinha_lid[x]='=' then
               begin
               mposigual:=x;
               break;
               end;
            end;
         mposigual:=mposigual+1;
         if UpperCase(copy(mlinha_lid,1,14))='[CHAVE ACESSO]' then
            mnfe_chaveacesso:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)))

         else if UpperCase(copy(mlinha_lid,1,13))='[STATUS_SCAN]' then
            mnfe_Status_SCan:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)))
         else if UpperCase(copy(mlinha_lid,1,23))='[STATUS_SCAN_DESCRICAO]' then
            mnfe_Status_SCan_Descricao:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)))
         else if UpperCase(copy(mlinha_lid,1,11))='[STATUS_UF]' then
            mnfe_Status_SCan:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)))
         else if UpperCase(copy(mlinha_lid,1,21))='[STATUS_UF_DESCRICAO]' then
            mnfe_Status_SCan_Descricao:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)))
         else if UpperCase(copy(mlinha_lid,1,18))='[DIG CHAVE ACESSO]' then
            mnfe_dchaveacesso:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)))
         else if UpperCase(copy(mlinha_lid,1,09))='[NRECIBO]' then
            mnfe_nrecibo:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)))
         else if UpperCase(copy(mlinha_lid,1,10))='[DHRECIBO]' then
            mnfe_dh_recibo:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)))
         else if UpperCase(copy(mlinha_lid,1,18))='[STATUS_PROTOCOLO]' then
            begin
            // 204 nota duplicada
            mnfe_stat_Prot:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)));
            end
         else if UpperCase(copy(mlinha_lid,1,18))='[MOTIVO_PROTOCOLO]' then
            begin
            mnfe_stat_Prot_Desc:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)));
            end
         else if UpperCase(copy(mlinha_lid,1,15))='[STATUS_RECIBO]' then
            begin
            // 105 - arquivo ainda em processamento no sefaz
            mnfe_stat_rec:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)));
            end
         else if UpperCase(copy(mlinha_lid,1,15))='[MOTIVO_RECIBO]' then
            begin
            mnfe_stat_Rec_Desc:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)));
            end

         else if UpperCase(copy(mlinha_lid,1,18))='[NUMERO_PROTOCOLO]' then
            begin
            mnfe_Num_Protolo:=trim(copy(mlinha_lid,mposigual,length(mlinha_lid)-(mposigual-1)));
            end

