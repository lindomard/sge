function fAchaChaveNfe(pCodEmp,pNumNf:Real; pDtemis: TDateTime): Boolean;
begin

DM1.Query3.Close;
DM1.Query3.SQL.Clear;
DM1.Query3.SQL.Add('Select CHAVE_ACESSO from NFE_CADCAB where '
                  +'IDENNF='+FloatToStr(pNumNf)
                  +' and IDEDEMI=:DTEMIS ');
DM1.Query3.ParamByName('DTEMIS').AsDateTime:=pDtemis;
DM1.Query3.Open;
if DM1.Query3.IsEmpty then
   begin
   result:=false;
   exit;
   end;
mcinst2:=copy(DM1.Query3.fieldbyName('CHAVE_ACESSO').AsString,1,length(DM1.Query3.fieldbyName('CHAVE_ACESSO').AsString)-1);
mcinst3:=copy(DM1.Query3.fieldbyName('CHAVE_ACESSO').AsString,length(DM1.Query3.fieldbyName('CHAVE_ACESSO').AsString)-1,1);


DM1.Query1.close;
DM1.Query1.sql.clear;
DM1.Query1.sql.add('Update CADNS set NSNFE_CHAVEACESSO=:CHAVEACESSO '
                  +'NSNFE_DCHAVEACESSO=:DCHAVEACESSO where '
                  +' NSCODEMP=0'+FloatToStr(pcodemp)
                  +' and NSNUMERO=0'+FloatToStr(pNUmNf)
                  +' and NSDTEMIS=:DTEMIS ');
DM1.Query1.ParamByName('CHAVEACESSO').AsString :=mcinst2;
DM1.Query1.ParamByName('DCHAVEACESSO').AsString:=mcinst3;
DM1.Query1.ParamByName('DTEMIS').AsDateTime:=pDtemis;
try
   DM1.Query1.execsql;
   fdm1StartCommit;
   result:=true;
except
   DM1.Query1.sql.savetofile(mpastatemp + 'SQL.txt');
   result:=false;
   end;

end;
}

