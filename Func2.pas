function fCriarTriggersDuplic(pChave,pLotseq,pCodemp: Integer): Boolean;
begin

CREATE OR REPLACE TRIGGER CADP01_TRIG01_DUPLIC AFTER UPDATE OR DELETE OR INSERT ON CADP01
FOR EACH ROW
declare mCriardup VARCHAR2(01);
        pldr_nombco VARCHAR2(60);
        pldr_nomdep VARCHAR2(60);
        pldr_nomccu VARCHAR2(60);
        pldr_nome VARCHAR2(60);
        pldr_natdc VARCHAR2(01);
        pldr_codccu VARCHAR2(10);
        pldr_coddep VARCHAR2(10);
        pldr_descmov VARCHAR2(60);
        pldr_doc VARCHAR2(10);
        pldr_codcai NUMBER;
        mGerarDuplic NUMBER;
        mTotalDup NUMBER;
        mVarTipoPed VARCHAR2(100);
        mQtdDupExist NUMBER;
        mQtdDupGer NUMBER;
        mIncluirReg VARCHAR2(01);
        mOperDup VARCHAR2(01);
        mExisteDup NUMBER;
        mTotal_Temp NUMBER;
        mTotal_FPAG NUMBER;
        mNumeroDup NUMBER;

        mDtEmis DATE;
        mDtPag DATE;
        mValorPag NUMBER;

        mPJurm NUMBER;
        mPDescM NUMBER;
        mPMulta NUMBER;
        mQtdDM NUMBER;
        mUsrBX INTEGER;
        mCodLDR INTEGER;
        mCodEmp_Chave: Integer;
        mNR INTEGER;


        mDup NUMBER;
        mCusBco NUMBER;
        CURSOR c_Cadp01v IS

        Select max(ROWNUM) AS P1VORDEM,
               sum(PFPSEQ)  AS P1VSEQ,
               sum(PFPVALOR) AS P1VVALOR,
               max(PFPCHAVE_NIVEL) AS P1VCHAVE_NIVEL,
               PFPCODEMP as P1VCODEMP,
               PFPLOTSEQ as P1VLOTSEQ,
               PFPCHAVE as P1VCHAVE,
               PFPDATA as P1VDATAV
               ,PFPVINCULO as P1VVINC02
               ,PFPNOMFOR as P1VNOMFPGTO
               ,PFPFORMA AS  P1VCODFP
               ,PFPFPGTO AS P1VPFPGTO

               from CADPFP
               where PFPCODEMP=:NEW.P1CODEMP
               and  PFPORDEM =:NEW.P1ORDEM
               and  PFPLOTSEQ =:NEW.P1LOTSEQ
               and  PFPCHAVE  =:NEW.P1CHAVE
               group by
               PFPCODEMP,
               PFPCHAVE,
               PFPLOTSEQ,
                PFPDATA
               ,PFPVINCULO
               ,PFPNOMFOR
               ,PFPFORMA
               ,PFPFPGTO
               order by  PFPDATA;

BEGIN


IF (UPDATING) OR (INSERTING)   THEN
   mCriardup:='N';
    -- mVarTipoPed:='max(PDUPTIP'|| to_char(:NEW.P1TIPO)||')';
   -- execute immediate 'select mvartipoped from PARGER' into mGerarDuplic;

   if :NEW.P1TIPO<1 OR :NEW.P1TIPO>25 then
      mVarTipoPed:='select max(PDUPTIP'|| 1||') from PARGER ';
   else
      mVarTipoPed:='select max(PDUPTIP'|| to_char(:NEW.P1TIPO)||') from PARGER ';
   end if;


   execute immediate mvartipoped into mGerarDuplic;

   if mgerarduplic=0 then
      mCriardup:='S';
   end IF;

   if :NEW.P1CODEMP>100 then 
      mCodEmp_Chave:=:NEW.P1CODEMP-100;
   else 
      mCodEmp_Chave:=:NEW.P1CODEMP;
   end if;


--  RAISE_APPLICATION_ERROR(-20000, 'EMIDOC ' || :NEW.P1EMIDOC ||   ' NUMCF ' || :NEW.P1NUMCF    ||' NUMNF ' || :NEW.P1NUMNF   || ' NUM SERV ' || :NEW.P1NUMNF_SERV );

   if  (  (INSERTING) and (:NEW.P1EMIDOC=1) and
            (
                 (:NEW.P1NUMCF<>0) or
                 (:NEW.P1NUMNF<>0) or
                 (:NEW.P1NUMNF_SERV<>0)
               ) )
            or ( (UPDATING) and (:NEW.P1EMIDOC=1) and
              (  (:NEW.P1NUMCF<>0) or
                 (:NEW.P1NUMNF<>0) or
                 (:NEW.P1NUMNF_SERV<>0)
               ) and  (
                      (:NEW.P1EMIDOC<>:OLD.P1EMIDOC) or
                         (
                             (:NEW.P1NUMCF<>:OLD.P1NUMCF) or
                             (:NEW.P1NUMNF<>:OLD.P1NUMNF) or
                             (:NEW.P1NUMNF_SERV<>:OLD.P1NUMNF_SERV)
                          ) or
                       mtotaldup<>:NEW.P1TOTALL
                       )  )

                        then

      if :NEW.P1STATUS<>9 then
         mCriardup:='S';
      END IF;

   else
      mcriardup:='N';
   END IF;





   if mcriardup='S' then
      if :NEW.P1NUMNF>0 then
         mNumeroDup:=:NEW.P1NUMNF;
         mDtEmis   :=:NEW.P1DATANF;
      elsif :NEW.P1NUMCF>0 then
         mNumeroDup:=:NEW.P1NUMCF;
         mDtEmis   :=:NEW.P1DATACF;
      elsif :NEW.P1NUMNF_SERV>0 then
         mNumeroDup      :=:NEW.P1NUMNF_SERV;
         mDtemis         :=:NEW.P1DATANF_SERV;
      end if;

      Select sum(PFPVALOR) into mTotal_FPAG
               from CADPFP
               where PFPCODEMP=:NEW.P1CODEMP
               and  PFPLOTSEQ =:NEW.P1LOTSEQ
               and  PFPORDEM =:NEW.P1ORDEM
               and  PFPCHAVE  =:NEW.P1CHAVE;
      if mtotal_FPAG is null then
         mTotal_FPAG:=0;
      end if;
      if mTotal_FPAG<:NEW.P1TOTALL then
         delete from CADPFP
               where PFPCODEMP=:NEW.P1CODEMP
               and  PFPLOTSEQ =:NEW.P1LOTSEQ
               and  PFPORDEM =:NEW.P1ORDEM
               and  PFPCHAVE  =:NEW.P1CHAVE;
         mtotal_FPAG:=0;
      end if;
      mtotal_temp:=:NEW.P1TOTALL;
      if mTotal_FPAG=0 then
         Select sum(P1VVALOR) into mTotal_Temp
              from CADP01V
               where P1VCODEMP=:NEW.P1CODEMP
               and  P1VLOTSEQ =:NEW.P1LOTSEQ
               and  P1VCHAVE  =:NEW.P1CHAVE
               and  P1VORDEM  =:NEW.P1ORDEM;
         if mtotal_temp is null then
            mTotal_temp:=0;
         end if;

      end if;
      if mTotal_temp<:NEW.P1TOTALL then
            delete from CADP01V
               where P1VCODEMP=:NEW.P1CODEMP
               and  P1VLOTSEQ =:NEW.P1LOTSEQ
               and  P1VCHAVE  =:NEW.P1CHAVE
               and  P1VORDEM  =:NEW.P1ORDEM;
            mtotal_temp:=0;
            mtotal_fpag:=:NEW.P1TOTALL;
      end if;

--   RAISE_APPLICATION_ERROR(-20000, 'Total FP '+to_char(mtotal_fpag)+' temp: '+to_char(mtotal_temp)+' titulo '+to_char(:new.p1totall));


--   RAISE_APPLICATION_ERROR(-20000, 'Total FP '|| mtotal_fpag  || ' temp: ' || mtotal_temp || ' titulo ' || :new.p1totall);


      if mtotal_fpag=0 then  -- cria-se um titulo com valor a vista
         insert into CADPFP  (
                            PFPORDEM
                           ,PFPSEQ
                           ,PFPVALOR
                           ,PFPCHAVE_NIVEL
                           ,PFPCODEMP
                           ,PFPLOTSEQ
                           ,PFPCHAVE
                           ,PFPDATA
                           ,PFPVINCULO
                           ,PFPNOMFOR
                           ,PFPFORMA
                           ,PFPFPGTO
                           ) Select  P1VORDEM
                             ,P1VSEQ
                             ,P1VVALOR
                             ,P1VCHAVE_NIVEL
                             ,P1VCODEMP
                             ,P1VLOTSEQ
                             ,P1VCHAVE
                             ,P1VDATAV
                             ,P1VVINC02
                             ,P1VNOMFPGTO
                             ,P1VCODFP
                             ,P1VPFPGTO
                             from CADP01V
                             where P1VCODEMP=:NEW.P1CODEMP
                             and  P1VLOTSEQ =:NEW.P1LOTSEQ
                             and  P1VCHAVE  =:NEW.P1CHAVE
                             and  P1VORDEM  =:NEW.P1ORDEM;
      end if;


      if mtotal_temp=0 then
         insert into CADPFP  (
                            PFPORDEM
                           ,PFPSEQ
                           ,PFPVALOR
                           ,PFPCHAVE_NIVEL
                           ,PFPCODEMP
                           ,PFPLOTSEQ
                           ,PFPCHAVE
                           ,PFPDATA
                           ,PFPVINCULO
                           ,PFPNOMFOR
                           ,PFPFORMA
                           ,PFPFPGTO
                           ) values (
                           :NEW.P1ORDEM
                           ,1
                           ,:NEW.P1TOTALL
                           ,:NEW.P1CHAVE_NIVEL
                           ,:NEW.P1CODEMP
                           ,:NEW.P1LOTSEQ
                           ,:NEW.P1CHAVE
                           ,mdtemis
                           ,(select max(fpvinculo) from cadfp where  fpcodigo = ( select min(fpcodigo) as codpv from cadfp))
                           ,(select max(fpdesc) from cadfp where  fpcodigo = ( select min(fpcodigo) as codpv from cadfp))
                           ,(select max(fpcodigo) from cadfp where  fpcodigo = ( select min(fpcodigo) as codpv from cadfp))
                           ,100
                           );

      end if;
   end if;


   mtotaldup:=0;
   mQtdDupGer:=0;
   mQtdDupExist:=0;
   mOperDup:='I';
   mUsrBx:=0;
   mCodLDR:=0;
   mValorPag:=0;

   mNR:=0;
   mCusBco:=0;


   if :NEW.P1TIPO=8 then
      mDup:=5;
   elsif :NEW.P1TIPO=17 then
      mDup:=5;
   else
      mDup:=0;
   end if;


   if mCriarDup='S' then
      select sum(CRVALOR),count(*) into mtotaldup,mQtdDupExist from CADDAR where CRCODEMP=:NEW.P1CODEMP
             and CRNPED=:NEW.P1CHAVE and CRORDEM=:NEW.P1ORDEM and CRLOTSEQ_CP=:NEW.P1LOTSEQ;
      if mtotaldup=null then
         mtotaldup:=0;
         mQtdDupExist:=0;
      end IF;
   end IF;

   if mCriarDup='S' then
      select count(*) into mQtdDupGer from CADP01V where P1VCODEMP=:NEW.P1CODEMP
             and P1VCHAVE=:NEW.P1CHAVE and P1VORDEM=:NEW.P1ORDEM and P1VLOTSEQ=:NEW.P1LOTSEQ;
      if mQtdDupGer=null then
         mQtdDupGer:=0;
      end IF;
   end IF;

   if mcriardup='S' then
      if mCriarDup='S' then

         Select max(PJURM),max(PDESCM),max(PMULTA),max(PQTDDM) into mPJurm,mPDescM,mPMulta,mQtdDM from CADPAR where PCODEMP=:NEW.P1CODEMP
                 and PCODSEQ=1;
         if mPJurm=null then
            Select max(PJURM),max(PDESCM),max(PMULTA),max(PQTDDM) into mPJurm,mPDescM,mPMulta,mQtdDM from CADPAR where PCODSEQ=1;
         end if;

         pldr_codcai:=:NEW.P1CX_CODCAI;
         if pldr_codcai=0 or pldr_codcai is null then
            pldr_codcai:=1;
         end IF;
         select max(BCBANCO) into pldr_nombco from CADBCO where BCCODEMP=:NEW.P1CODEMP and BCCODBCO=pldr_codcai;
         if trim(pldr_nombco)='' then
            select max(BCBANCO) into pldr_nombco from CADBCO where  BCCODBCO=pldr_codcai;
         end IF;
         if trim(pldr_nombco)='' then
            pldr_nombco:='NAO ENCONTRADO '+to_char(pldr_codcai);
         end IF;
         pldr_doc:='CADDAR0';
         if :NEW.P1TIPO_ENTSAI=1 then
            pldr_doc:='CADDARD';
         END IF;
         Select NOME,CODCC,CODDEP into pldr_descmov,pldr_codccu,pldr_coddep from PARLDR where CODEMP=:NEW.P1CODEMP and
                         CDOC=pldr_doc;
         if pldr_descmov is null then
            Select NOME,CODCC,CODDEP into pldr_descmov,pldr_codccu,pldr_coddep from PARLDR where
                         CDOC=pldr_doc;
         end IF;
         if not pldr_codccu is null then
            Select CCNOME into pldr_nomccu from CADCCU where CCCODEMP=:NEW.P1CODEMP
              and CCCODCCU=pldr_codccu;
         END IF;
         if pldr_nomccu is null then
            Select CCNOME into pldr_nomccu from CADCCU where CCCODCCU=pldr_codccu;
         end IF;
        if not pldr_coddep is null then
           Select DNOME into pldr_nomdep from CADDEP where DCODEMP=:NEW.P1CODEMP
              and DCODDEP=pldr_coddep;
           if pldr_nomdep is null then
              Select DNOME into pldr_nomdep from CADDEP where DCODDEP=pldr_coddep;
           end IF;
        end IF;


        if mQtdDupExist=0 then
           mOperDup:='I';
        elsif mQtdDupExist>mQtdDupGer then
           Delete from CADDAR where CRNUMPARC>mQtdDupGer and
              CRNPED=:NEW.P1CHAVE and CRORDEM=:NEW.P1ORDEM and CRCODEMP=:NEW.P1CODEMP
              and CRLOTSEQ_cp=:NEW.P1LOTSEQ;
           mOperDup:='S';
        end IF;

        FOR v_Cadp01v in c_Cadp01v LOOP



           if mOperDup='I' then
              mExisteDup:=0;
           else
              select count(*),CRCODLDR into mExisteDup,mCodLDR from CADDAR where CRNUMPARC= v_Cadp01v.P1VSEQ
                 and CRNPED=:NEW.P1CHAVE and CRORDEM=:NEW.P1ORDEM and CRCODEMP=:NEW.P1CODEMP
                 and CRLOTSEQ_CP=:NEW.P1LOTSEQ;
           end if;
           if mcodldr=null then 
              mcodldr=0;
           end if;
           if mcodldr=0 then 
              select PCODLDR into mcODLDR from CADpar where pcodemp=mCodEmp_Chave and PCODSEQ=1;
              Update CADPAR set PCODLDR=PCODLDR+1 where pcodemp=mCodEmp_Chave and PCODSEQ=1;

