function fChecarCNPJ_IE(pLocal: Integer;pCnpj,pCPF,pIE,pUF: String):Boolean;
// plocal 0-Cliente 1-Transportadora
var
mErroCNPJ,mErroCPF,mErroIE: Boolean;
begin;
if puf='EX' then
   begin
   result:=true;
   exit;
   end;
mErroCNPJ:=False;
mErroCPF :=False;
mErroIE  :=False;

if (fsonumero(pCnpj)=0) and (fsonumero(pCPF)=0) then
   begin
   mErroCNPJ:=true;
   mErroCPF:=true;
   end;


if fSonumero(pCnpj)>0 then
   begin
   if not FCGC(fsonumero(pcnpj) ) then
      begin
      mErroCNPJ:=true;
      if (fsonumero(pCnpj)=fSonumero(pCPF)) then
          begin
          if Fcpf(FORMATFLOAT('00000000000',fsonumero(pCPF))) then
             begin
             pCnpj:='0';
             mErroCNPJ:=false;
             end;
          end;
      end;
   end;

if fsonumero(pCPF)>0 then
   begin
   if not Fcpf(FORMATFLOAT('00000000000',fSonumero(pCPF))) then
      begin
      mErroCPF:=true;
      if fSonumero(pCNPJ)=fSonumero(pCPF) then
         begin
         if not mErroCNPJ then
            begin
            mErroCPF:=false;
            pCPF:='0';
            end;
         end;
      end;

   end;

if (fsonumero(pIE)=0) and (fsonumero(pCnpj)>0) then
   mErroIE:=true
else
   begin
   if not ChkInscEstadual(fdeixanum(pie),pUF) then
      mErroIE:=true;
   end;

if ((mErroCNPJ) and (mErroCPF) and (mErroIE)) or ((mErroIE) and ((mErroCNPJ) or (mErroCPF))) then
   begin
   MessageDlg(iif(pLocal=1,'Transportadora ','Cliente ')+' com o CNPJ/CPF/Incrição possivelmente errado!!',mtError,[mbOk],0);
   result:=false;
   exit;
   end;
mcinst2:='';
if mErroCNPJ then
   mcinst2:='Foi Encontrado irregularidadas no CNPJ Cadastro '+iif(pLocal=1,'Transportadora ','Cliente ')+' , posso consultar no SEFAZ-'+pUF+'?'
else if mErroCPF then
   mcinst2:='Foi Encontrado irregularidadas no CPF Cadastro '+iif(pLocal=1,'Transportadora ','Cliente ')+', posso consultar no SEFAZ-'+pUF+'?'
else if mErroIE then
   mcinst2:='Possivelmente a um erro na Inscricao Estadual Cadastro '+iif(pLocal=1,'Transportadora ','Cliente ')+', posso consultar no SEFAZ-'+pUF+'?';

mRetChecar_IE  :=pIE;
mRetChecar_Cnpj:=pCnpj;
mRetChecar_Cnpf:=pCPF;

if trim(mcinst2)<>'' then
   begin
   if Application.MessageBox(pchar(mcinst2),'Confirmação',MB_YESNO+MB_DEFBUTTON2)=mrYes then
      begin
      Application.CreateForm(TFrm_NFe_ConsCad, Frm_NFe_ConsCad);
       Frm_NFe_ConsCad.mOrigemInfo:=1;

      Frm_NFe_ConsCad.edt_cnpj_dig.Text:=FormatFloat(pDFCNPJ, fsonumero(pCnpj));
      Frm_NFe_ConsCad.edt_cpf_dig.Text :=FormatFloat(pDFCNPF, fSonumero(PCPF));
      Frm_NFe_ConsCad.edt_ie_dig.Text  :=pIe;
      Frm_NFe_ConsCad.cb_uf.Text:=pUF;
      Frm_NFe_ConsCad.bbAceitar.Visible:=true;
      if (mErroCNPJ) or (mErroCPF) then
         Frm_NFe_ConsCad.edt_ie.Text:=fdeixanum(pie)
      else if (mErroIE) then
         begin
         if fSonumero(pCnpj)>0 then
            Frm_NFe_ConsCad.edt_cnpj.Text:=FormatFloat(pDFCNPJ, fSonumero(pCnpj))
         else
            Frm_NFe_ConsCad.edt_cpf.Text:=FormatFloat(pDFCNPF, fSonumero(pCPF));
         end;
      Frm_NFe_ConsCad.bbconsultar.Click;
      if (Frm_NFe_ConsCad.edt_status.Text='111') or
         (Frm_NFe_ConsCad.edt_status.Text='112') then
         begin
         if mErroCNPJ then
            Frm_NFe_ConsCad.lbl_obscli.Caption:='Foi Digitado o Seguinte CNPJ: '+Frm_NFe_ConsCad.edt_cnpj_dig.Text
                                          +' no Sefaz Foi Encontrado Este: '+Frm_NFe_ConsCad.edt_enc_cnpj.Text
         else if mErroCPF then
            Frm_NFe_ConsCad.lbl_obscli.Caption:='Foi Digitado o Seguinte CPF: '+Frm_NFe_ConsCad.edt_cpf_dig.Text
                                          +' no Sefaz Foi Encontrado Este: '+Frm_NFe_ConsCad.edt_enc_cpf.Text
         else
            Frm_NFe_ConsCad.lbl_obscli.Caption:='Foi Digitado o Seguinte Inscricao: '+Frm_NFe_ConsCad.edt_ie_dig.Text
                                          +' no Sefaz Foi Encontrado Este: '+Frm_NFe_ConsCad.edt_enc_ie.Text;
         Frm_NFe_ConsCad.lbl_obscli.Caption:=Frm_NFe_ConsCad.lbl_obscli.Caption+
                                          ' [CLICK NO BOTAO AO LADO PARA ACEITAR O ENCONTRADO!]';
         Frm_NFe_ConsCad.lbl_obscli.Visible:=true;
         Frm_NFe_ConsCad.gb_digitados.Visible:=true;
         Frm_NFe_ConsCad.ShowModal;
         if (Frm_NFe_ConsCad.mTipoOper=1) and ((fsonumero(Frm_NFe_ConsCad.edt_enc_cnpj.Text)>0)
            or (fsonumero(Frm_NFe_ConsCad.edt_enc_CPF.Text)>0) ) then
            begin
            if (fsonumero(Frm_NFe_ConsCad.edt_enc_cnpj.Text)>0) then
               mRetChecar_Cnpj:=fdeixanum(Frm_NFe_ConsCad.edt_enc_cnpj.Text);
            if fsonumero(Frm_NFe_ConsCad.edt_enc_cnpj.Text)>0 then
               begin
               mRetChecar_Cnpf:=fDeixanum(Frm_NFe_ConsCad.edt_enc_cpf.Text);
               end;
            mRetChecar_IE:=Frm_NFe_ConsCad.edt_enc_ie.Text;
            mRetChecar_IE:=Mascara_Inscricao(mRetChecar_IE, pUF);
            Frm_NFe_ConsCad.Free;
            Frm_NFe_ConsCad:=nil;
            result:=true;
            exit;
            end
         else
            begin
            Frm_NFe_ConsCad.Free;
            Frm_NFe_ConsCad:=nil;
            result:=false;
            exit;
            end;
         end
      else
         begin
         IF COPY(mRetChecar_IE,1,3)='ISE' then
            begin
            result:=true;
            exit;
            end
         else
            begin
            MessageDlg(Frm_NFe_ConsCad.edt_status.Text+' - '+Frm_NFe_ConsCad.edt_status_descricao.Text+'. SEFAZ-'+puf,mtError,[mbOk],0);
            Frm_NFe_ConsCad.Free;
            Frm_NFe_ConsCad:=nil;
            result:=false;
            exit;
            end;
         end;
      end
   else
      begin
      result:=false;
      exit;
      end;
   end
else
   begin
   result:=true;
   end;

end;


function fBuscarNUMNF(pCodEmp: Integer; pTipoForm: String; out pSerieNF: String; out pModelo: String; Origem: Integer): Integer;
// plocal 0-Cliente 1-Transportadora
var
mNumNF: Integer;
//mannf_aceito: Boolean;  ESTA EM DUPLICIDADE
mChave: String;
query_parnf: tquery;
begin
mChave:=pTipoForm;
query_parnf:=tquery.create(nil);
query_parnf.databasename:=DM1.sg_assoc.DATABASENAME;
query_parnf.close;
query_parnf.SQL.clear;
query_parnf.SQL.Add('SELECT * FROM CADPAR_NF where PNF_CODEMP=:CODEMP '
                  +' AND PNF_CHAVE=:CHAVE ');
query_parnf.ParamByName('CODEMP').Value:=pCodEmp;
query_parnf.ParamByName('CHAVE').Value:=pTipoForm;
query_parnf.Open;
if ( (DM4.Tb_ParGer02PG2NFETPEMIS.AsInteger=3) or (DM4.Tb_ParGer02PG2NFETPEMIS.AsInteger=5) )
     and (query_parnf.fieldbyName('PNF_TIPOFORM').Asinteger=1) then
    begin
    if DM4.Tb_ParGer02PG2NFETPEMIS.AsInteger=3 then
       mChave:='SCAN'
    else
       mChave:='SVC-RS';

    query_parnf.close;
    query_parnf.SQL.clear;
    query_parnf.SQL.Add('SELECT * FROM CADPAR_NF where PNF_CODEMP=:CODEMP '
                      +' AND PNF_CHAVE=:CHAVE ');
    query_parnf.ParamByName('CODEMP').Value:=pCodEmp;
    query_parnf.ParamByName('CHAVE').Value:=mchave;
    mChave:='SCAN';
    query_parnf.Open;
    end;

mnumnf:=query_parnf.fieldbyName('PNF_NUMNF').asinteger;
if query_parnf.fieldbyName('PNF_MANNNF').Asinteger=1 then
  begin
  if Frm_ManNF=nil then
    Application.CreateForm(TFrm_ManNF, Frm_ManNF)
  else
    begin
    Frm_ManNF.Free;
    Frm_ManNF:=nil;
    Application.CreateForm(TFrm_ManNF, Frm_ManNF);
    end;
  Frm_ManNF.Origem:=Origem;
  mannf_aceito:=False;
  Frm_ManNF.NUMNF.Text:=FloatToStr(mnumnf);
  Frm_ManNF.NOVNUM.Text:=FloatToStr(mnumnf);
  Frm_ManNF.ShowModal;
  if Frm_ManNF.Origem=-99 then
    begin
    freeandnil(Frm_ManNF);
    Origem:=-99;
    end
  else
    begin
    if mannf_aceito then
      mnumnf:=Valint(Frm_ManNF.NOVNUM.Text);
    Frm_ManNF.Free;
    Frm_ManNF:=nil;
    query_parnf.close;
    query_parnf.SQL.clear;
    query_parnf.SQL.Add('SELECT * FROM CADPAR_NF where PNF_CODEMP=:CODEMP '
                      +' AND PNF_CHAVE=:CHAVE ');
    query_parnf.ParamByName('CODEMP').Value:=pCodEmp;
    query_parnf.ParamByName('CHAVE').Value:=mChave;
    query_parnf.Open;
    end;
  end;

if (mnumnf=query_parnf.fieldbyName('PNF_NUMNF').asinteger) and (Origem<>-99) then
   begin
   DM1.Query2.Close;
   DM1.Query2.SQl.Clear;
   DM1.Query2.SQl.add('Update CADPAR_NF set PNF_NUMNF=PNF_NUMNF+1 where PNF_CODEMP=:CODEMP '
                  +' AND PNF_CHAVE=:CHAVE ');
   DM1.Query2.ParamByName('CODEMP').Value:=pCodEmp;
   DM1.Query2.ParamByName('CHAVE').Value:=mChave;
   Try
      DM1.Query2.ExecSQL;
      fdm1StartCommit;
   except
      ex_erroSql(01,8403,'Frm_Ped','CADPAR');
      end;
   fBuscarSequencia('NF_'+mChave+'_'+FormatFloat('0000', pCodEmp)+'_2012');

   end;
pSerieNF:=query_parnf.fieldbyName('PNF_SERIE').AsString;
pModelo:=query_parnf.fieldbyName('PNF_MODELO').AsString;
query_parnf.close;
freeandnil(query_parnf);
if Origem<>-99 then
  result:=mNumNF
else
  Result:=-99;
end;


function fTestarCNPJ_IE(pAceitaMensagem: boolean;pTipo: Integer; pCodigo: Real;pMensagem: string): Boolean;
// ptipo=0 Cliente
//       1 transportadora
var
Query: TQuery;
Query_upd: TQuery;
begin
 pMensagem:='';

if (pTipo=0) then
   begin
   Query:=TQuery.Create(nil);
   Query.DatabaseName:='SG_ASSOC';

   if flquery('CRAZAO,CUF,CCNPJ,CCPF,CIE,CRG,CCNPJ_CONSISTE,CUF,CCODEMP','C','CADCLI','N','CCODCLI',FloatToStr(pCodigo),query) then
//function flquery(pcampo,psigtab,ptabela,ptpcp,pcampes,pvalor: String; out query:TQuery): Boolean;
      begin
      if (Query.FieldByName('CCNPJ').AsFloat=0) and
         (Query.FieldByName('CCPF').AsFloat=0) and
         (fSonumero(Query.FieldByName('CIE').AsString)=0) AND
         (Query.FieldByName('CUF').AsString<>'EX') THen
         begin
         pMensagem:='Cliente sem CNPJ/CPF Cadastro incompleto, favor corrigir!';
         result:=false;
         query.Close;
         FreeAndNil(query);
         result:=false;
         exit;
         end
      else
         begin
         if Query.FieldByName('CCNPJ_CONSISTE').AsString='S' then
            begin
            query.Close;
            FreeAndNil(query);
            result:=true;
            exit;
            end;
         if pAceitaMensagem=true then
            begin
             if fChecarCNPJ_IE(ptipo,Query.FieldByName('CCNPJ').AsString,Query.FieldbyName('CCPF').AsString,
                     Query.FieldbyName('CIE').AsString,
                     Query.FieldbyName('CUF').AsString) then
                begin
                Query_upd:=TQuery.Create(nil);
                Query_upd.DatabaseName:='SG_ASSOC';
                Query_upd.SQL.Clear;
                Query_upd.sql.Add('Update CADCLI set CCNPJ=:CNPJ '
                                  +' ,CCPF=:CPF '
                                  +' ,CIE=:IE '
                                  +' ,CCNPJ_CONSISTE='+chr(39)+'S'+chr(39)
                                  +' where CCODCLI=:CODCLI '
                                  +' and CCODEMP=:CODEMP ');
                Query_upd.ParamByName('CNPJ').Value:=fSonumero(mRetChecar_Cnpj);
                Query_upd.ParamByName('CPF').Value:=fSonumero(mRetChecar_Cnpf);
                Query_upd.ParamByName('IE').Value:=mRetChecar_IE;
                Query_upd.ParamByName('CODCLI').Value:=pCodigo;
                Query_upd.ParamByName('CODEMP').Value:=query.fieldbyName('CCODEMP').AsInteger;
                try
                   Query_upd.ExecSQL;
                   fdm1StartCommit;
                except
                   end;
                query.Close;
                freeandnil(Query_upd);
                FreeAndNil(query);
                result:=true;
                exit;
                end
             else
                begin
                if Application.MessageBox(pchar('Possivelmente ainda ha erros em CPJ/CPF ou Inscricao, Continuar Mesmo Assim?'),'Confirmação',MB_YESNO+MB_DEFBUTTON2)=mrYes then
                   result:=true
                else
                   result:=false;
                query.Close;
                FreeAndNil(query);
                exit;
                end;
             end;
         end;
      end
   else
      begin
      result:=false;
      exit;
      end;
   end
else
   begin
   Query:=TQuery.Create(nil);
   Query.DatabaseName:='SG_ASSOC';
   if flquery('TRRAZTRA,TRUF,TRCNPJ,TRCNPJ_CONSISTE,TRUF,TRIE,TRCODEMP','TR','CADTRA','N','TRCODTRA',FloatToStr(pCodigo),query) then
      begin
      if (Query.FieldByName('TRCNPJ').AsFloat=0) and
         (fSonumero(Query.FieldByName('TRIE').AsString)=0) then
         begin

         result:=true;
         query.Close;
         FreeAndNil(query);
         exit;
         end
      else
         begin
         if Query.FieldByName('TRCNPJ_CONSISTE').AsString='S' then
            begin
            query.Close;
            FreeAndNil(query);
            result:=true;
            exit;
            end;
         if pAceitaMensagem=true then
            begin
            if fChecarCNPJ_IE(ptipo,Query.FieldByName('TRCNPJ').AsString,'',
                    Query.FieldbyName('TRIE').AsString,
                    Query.FieldbyName('TRUF').AsString) then
               begin
               Query_upd:=TQuery.Create(nil);
               Query_upd.DatabaseName:='SG_ASSOC';

               Query_upd.Close;
               Query_upd.SQL.Clear;
               Query_upd.sql.Add('Update CADTRA set TRCNPJ=:CNPJ '
                                 +' ,TRIE=:IE '
                                 +' ,TRCNPJ_CONSISTE='+chr(39)+'S'+chr(39)
                                 +' where TRCODTRA=:CODTRA '
                                 +' and TRCODEMP=:CODEMP ');
               Query_upd.ParamByName('CNPJ').Value:=fSonumero(mRetChecar_Cnpj);
               Query_upd.ParamByName('IE').Value:=mRetChecar_IE;
               Query_upd.ParamByName('CODTRA').Value:=pCodigo;
               Query_upd.ParamByName('CODEMP').Value:=query.fieldbyName('TRCODEMP').AsInteger;
               try
                  Query_upd.ExecSQL;
                  fdm1StartCommit;
               except
                  end;
               query.Close;
               freeandnil(Query_upd);
               FreeAndNil(query);
               result:=true;
               exit;
               end
            else
               begin
               if Application.MessageBox(pchar('Possivelmente ainda ha erros em CPJ/CPF ou Inscricao, Continuar Mesmo Assim?'),'Confirmação',MB_YESNO+MB_DEFBUTTON2)=mrYes then
                  result:=true
               else
                  result:=false;
               query.Close;
               FreeAndNil(query);
               exit;
               end;
            end;
         end;
      end
   else
      begin
      query.Close;
      FreeAndNil(query);
      result:=false;
      exit;
      end;
   end
end;

