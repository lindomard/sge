                             fIncluirDetNFE(pFase,0, par_Sigla+msigla_localw+NodeNivelW.ChildNodes[w].NodeName,NodeNivelW.ChildNodes[w].Text)
                           else if mlocal=2 then
                             fIncluirDupNFE(pFase,0, par_Sigla+msigla_localw+NodeNivelW.ChildNodes[w].NodeName,NodeNivelW.ChildNodes[w].Text);
                           fExisteCampo(mLocal,par_Sigla+msigla_localw+NodeNivelw.ChildNodes[w].NodeName,NodeNivelw.ChildNodes[w].Text);


                           end
                        else
                           begin
                           NodeNivelZ:=NodeNivelW.ChildNodes[NodeNivelW.ChildNodes[w].NodeName];
                           NomeNivelZ:=NodeNivelW.ChildNodes[w].NodeName;
//                           msigla_localZ:=UpperCase(NomeNIvelZ);
                           msigla_localZ:=uppercase(NodeNivelX.ChildNodes[x].NodeName)+UpperCase(NomeNIvelZ);

                           if pSigla='DET' then
                              par_Sigla:='DI_'
                           else
                              par_Sigla:=pSigla;



                           While (NodeNivelZ<>Nil) and (NodeNivelZ.NodeName=NomeNivelZ)  do
                              begin
                              for z:=0 to NodeNivelZ.ChildNodes.Count-1 do
                                 begin
                                 if NodeNivelZ.ChildNodes[z].IsTextElement then
                                    begin
                                    fExisteCampo(mLocal,par_Sigla+msigla_localZ+NodeNivelZ.ChildNodes[z].NodeName,NodeNivelZ.ChildNodes[z].Text);
                                    if mlocal=0 then
                                       fIncluirCabNFE(pFase,0, par_Sigla+msigla_localz+NodeNivelZ.ChildNodes[z].NodeName,NodeNivelZ.ChildNodes[z].Text)
                                    else if mlocal=1 then
                                       fIncluirDetNFE(pFase,0, par_Sigla+msigla_localz+NodeNivelZ.ChildNodes[z].NodeName,NodeNivelZ.ChildNodes[z].Text)
                                    else if mlocal=2 then
                                       fIncluirDupNFE(pFase,0, par_Sigla+msigla_localz+NodeNivelZ.ChildNodes[z].NodeName,NodeNivelZ.ChildNodes[z].Text);

                                    end
                                 else
                                    begin
                                    fExisteCampo(mLocal,par_Sigla+msigla_localZ+NodeNivelZ.ChildNodes[z].NodeName,NodeNivelZ.ChildNodes[z].Text);
                                    end;

                                 end;
                              NodeNivelZ:=NodeNivelZ.NextSibling;
                              end;
                           end;
                        end;
                     NodeNivelW:=NodeNivelW.NextSibling;
                     end;
                  end;
               end;
            if mlocal=2 then
               fIncluirDupNFE(pFase, 2, '','');
            NodeNivelX:=NodeNivelX.NextSibling;
            end;
         end;
//      if mlocal=2 then
//         break;
      end;
   NodeNivelY:=NodeNivelY.NextSibling;
   if mlocal=1 then
     fIncluirDetNFE(pFase, 2, '','');
   end;
result:=true;
end;




function fExisteCampo(pLocal: Integer;pNomCpo,pValor: String): String;

var
mTabela: String;
mEData: Boolean;
//mNome: String;
begin
{
mNome:=copy(pnomcpo,length(pNomCpo)-8,9);

if uppercase(mNome)='INFADPROD' then
   ShowMessage('Achou');
}
pNomCpo:=UpperCase(pNomCpo);
if not DM6.Query_NFECampos.Active then
   DM6.Query_NFECampos.Open;
if pLocal=0 then
   mTabela:='NFE_CADCAB'
else if pLocal=1 then
   mTabela:='NFE_CADDET'
else if pLocal=2 then
   mTabela:='NFE_CADDUP'
else
   begin
   ShowMessage('Local Desconhecido: '+IntToStr(pLocal)+' valor: '+pValor+' Nome Campo: '+pNomCpo);
   result:='ERRO';
   exit;
   end;


try

if DM6.Query_NFECampos.Locate('TABLE_NAME;COLUMN_NAME',VarArrayOf([mTabela,pNomCpo]),[]) then
   begin
   result:=' encontrado ';
   end
else
   begin
   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;
   if ENumero(pValor) then
      DM1.Query1.SQL.Add('alter table '+mTabela+' add('+pNomCpo+' NUMBER)')
   else
      begin
      mEdata:=false;
      if (length(pValor)=10) and (pValor[5]='-') then
         begin
         try
           mcinst:=DateToStr(StrToDate(copy(pValor,9,2)+'/'+copy(pValor,06,02)+'/'+copy(pValor,1,4)));
           mEdata:=true;
         except
            mEdata:=false;
            end;
         end;   

      if mEdata then
         DM1.Query1.SQL.Add('alter table '+mTabela+' add('+pNomCpo+' DATE)')
      else
         DM1.Query1.SQL.Add('alter table '+mTabela+' add('+pNomCpo+' VARCHAR2('+IntToStr(length(pValor)+30)+'))');
      end;
   try
      DM1.Query1.ExecSQL;
   except
      DM1.Query1.SQl.savetofile(mpastatemp + 'SQL.txt');
      end;
   DM6.Query_NFECampos.Close;
   DM6.Query_NFECampos.Open;
   Result:=' NAO ENCONTRADO ';
   end;
except
   ShowMessage('Local Desconhecido: '+IntToStr(pLocal)+' valor: '+pValor+' Nome Campo: '+pNomCpo);
   Result:=' ERRO ';
   end;
end;


function fIncluirDupNFE(pFase,pTipo: Integer;pCampo,pValor: String): Boolean;
//pFase 0-Definindo os Campos 1-Atualizando os parametros
var
x: integer;
begin
pCampo:=uppercase(pCampo);
if pTipo=1 then // inicializa a insercao
   begin
   DM6.Query_NFEDup.Close;
   DM6.Query_NFEDup.SQL.Clear;
   DM6.Query_NFEDup.SQL.add('Insert into NFE_CADDUP (CHAVE');
   mNFE_Values_Dup:=IntToStr(mNFE_Chave);



   result:=true;
   end
else if pTipo=2 then // conclui a insercao
   begin
   DM6.Query_NFEDup.SQL.Add(') values (');
   DM6.Query_NFEDup.SQL.add(mNFE_Values_Dup);
   DM6.Query_NFEDup.SQL.Add(') ');
   for x:=0 to high(mNFE_Params_Dup)-1 do
      begin
      if (length(mNFE_Params_Dup[x])=10) and (mNFE_Params_Dup[x][5]='-') then
         begin
         try
            DM6.Query_NFEDup.Params[x].AsDateTime:=StrToDate(copy(mNFE_Params_Dup[x],9,2)+'/'+copy(mNFE_Params_Dup[x],06,02)+'/'+copy(mNFE_Params_Dup[x],1,4));
         except
            DM6.Query_NFEDup.Params[x].Value:=mNFE_Params_Dup[x];
            end;
         end
      else
         begin
         if ENumero(mNFE_Params_Dup[x]) then
            DM6.Query_NFEDup.Params[x].Value:=mudapv(mNFE_Params_Dup[x])
         else
            DM6.Query_NFEDup.Params[x].Value:=mNFE_Params_Dup[x];
         end;
      end;

   try
      DM6.Query_NFEDup.ExecSQL;
      fdm1StartCommit;
      result:=true;
   except
      DM6.Query_NFEDup.sql.savetofile(mpastatemp + 'SQL.txt');
      ex_erroSql_Novo(DM6.Query_NFEDup,312,'form1','NFE_CADDUP');
      result:=false;
      end;
   end
else
   begin
   if trim(pValor)<>'' then
      begin
      SetLength(mNFE_Params_Dup, High(mNFE_Params_Dup)+2);
      mNFE_Params_Dup[High(mNFE_Params_Dup)-1]:=pValor;
      DM6.Query_NFEDup.SQL.add(','+pCampo);
      mNFE_Values_Dup:=mNFE_Values_Dup+',:'+pCampo;
      end;
   result:=true;
   end;

end;



