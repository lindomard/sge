            else if DM2.Tb_JCJCBRANCOS04.Value=2 then
               mcinst:=TrimRight(mcinst)
            else if DM2.Tb_JCJCBRANCOS04.Value=3 then
               mcinst:=Trim(mcinst);
            if (DM2.Tb_JCJCTAMMAX04.Value>0) and (length(mcinst)>DM2.Tb_JCJCTAMMAX04.Value) then
               mcinst:=copy(mcinst,1,DM2.Tb_JCJCTAMMAX04.AsInteger);
            maux:=maux+mcinst;
            end;
         end;
      end;




      if DM1.Tb_TDVTFONTE.Value=0 then
         mfonte:=normal
      else if DM1.Tb_TDVTFONTE.Value=1 then
         mfonte:=comp12
      else if DM1.Tb_TDVTFONTE.Value=2 then
         mfonte:=comp17
      else if DM1.Tb_TDVTFONTE.Value=3 then
         mfonte:=comp20
      else if DM1.Tb_TDVTFONTE.Value=4 then
         mfonte:=negrito
      else if DM1.Tb_TDVTFONTE.Value=5 then
         mfonte:=expandido;

      if mtam>0 then
         begin
         if length(trim(maux))>mtam then
            begin
            if DM1.Tb_TDVTCCORTARDE.Value=1 then
               maux:=copy(maux,length(trim(maux))-(mtam-1),mtam)
            else
               maux:=copy(maux,1,mtam);
            end
         else
            begin
            if DM1.Tb_TDVTALINHAR.Value=0 then
               maux:=insere2(maux,' ',mtam)
            else if DM1.Tb_TDVTALINHAR.Value=1 then
               maux:=insere(maux,' ',mtam)
            else if DM1.Tb_TDVTALINHAR.Value=2 then
               maux:=Centra(maux,' ',mtam);
            end;
         end;

      form_impres_func2.RDPrint1.ImpF(DM1.Tb_TDVTLIN.AsInteger,DM1.Tb_TDVTCOL.AsInteger,maux,[mfonte]);
      DM1.Tb_TDV.Next;
      end;
   form_impres_func2.RDPrint1.Novapagina;
   DM2.Tb_Dar.Next;
   end;
if DM1.Tb_TDVCATCVIS.Value=1 then
   begin
   try
      fTravaTeclado(0); // trava o teclado
      form_impres_func2.RDPrint1.Fechar;
      form_impres_func2.Free;
      form_impres_func2:=nil;

      fTravaTeclado(1); // trava o teclado
   except
      fTravaTeclado(1); // trava o teclado
      fmensagem('Erro 4652 ao Imprimir Relatorio!',0,['0'],0);
      end;
   end
else
   begin
   try
      verteclado(0);
      if form_impres_func2.RDPrint1.Setup then
         begin
         form_impres_func2.RDPrint1.Fechar;
         form_impres_func2.Free;
         form_impres_func2:=nil;
         end;

   except
      fmensagem('Erro 803 ao Imprimir Relatorio!',0,['0'],0);
      end;
   end;
Result:=True;
end;


