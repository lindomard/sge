   mcinst4:=trim(DM4.Tb_ParGer02PG2NFEPASTAMASTER.AsString)
else
   mcinst4:=trim(DM4.Tb_ParGer02PG2PASTAENVIO.AsString);

if trim(mcinst4)='' then
   begin
   fmensagem('Este Programa Não Esta configurado corretamente para Nota Fiscal Eletronica.'
            +'Falta Caminho da Impressão da NFE no Programa SGE_NFE.EXE, duvidas contactar '
            +'Suporte ',0,['0'],0);
   result:=false;
   exit;
   end;
mboolean:=false;
if flfilpad(0,'_principal','') then
   begin
   if DM4.Tb_FilPad2.Locate('FPCOMP','CB_NFEFRAME',[]) then
      mboolean:=true;
   end;
if mboolean then
   begin
   if valint(fdeixanum(mNFEVersao))>=20 then
      mcinst4:=trim(DM4.Tb_ParGer02PG2NFEPASTAMASTER.AsString)+'\'+insere(DM1.Tb_EmpCGC.AsString,'0',14)+'\ENVIO'
   else
      mcinst4:=trim(DM4.Tb_ParGer02PG2PASTAENVIO.AsString);
   end   
else
   begin
   mcinst4:=DM4.Tb_ParGer02PG2NFEPASTAIMP.AsString;
   if trim(mcinst4)='' then
      mcinst4:='C:\SGE\NFE\ENVIO';
   end;


if mcinst4[length(mcinst4)]<>'\' then
   mcinst4:=mcinst4+'\';
mcinst4:=mcinst4+'SGENFE.ATV';
if not FileExists(mcinst4) then
   begin
   fmensagem('O Programa que Imprime a NFE não Esta Ativo Favor Ativa-lo!, duvidas contactar '
            +'Suporte ',0,['0'],0);
   result:=false;
   exit;
   end;
Deletefile(pchar(mcinst4));
mdathorIni:=now;
While (not FileExists(mcinst4)) and (fQtdSegundos(mdathorIni,NOW)<10) do
   begin
   end;

if not FileExists(mcinst4) then
   begin
   fmensagem('O Programa que Imprime a NFE não Esta Ativo Favor Ativa-lo!, duvidas contactar '
            +'Suporte ',0,['0'],0);
   result:=false;
   exit;
   end
else
   result:=true;
end;


