    procedure fGerarTagTransp(pDadosTransp: tDadosTransp);
    begin


    mXmlString.Add('<transp>');



    if (pDadosTransp.pModELONF=65) then
       mXmlString.Add(fGeraXMLReal(0,'modFrete',9))
    else
       begin
       mXmlString.Add(fGeraXMLReal(0,'modFrete',pDadosTransp.pModalidadeFrete));
       mXmlString.Add('<transporta>');
       if (length(pDadosTransp.pNomeTra)>20) and  (length(fdeixanum2(pDadosTransp.pCpfCnpj))>11) then
          mXmlString.Add(fGeraXMLstring(0,'CNPJ',insere(fdeixanum2(pDadosTransp.pCpfCnpj),'0',14)))
       else if (length(pDadosTransp.pCpfCnpj)>0) and (length(fdeixanum2(pDadosTransp.pCpfCnpj))<=11) then
          mXmlString.Add(fGeraXMLstring(0,'CPF',insere(fdeixanum2(pDadosTransp.pCpfCnpj),'0',11)));
       if length(trim(pDadosTransp.pNomeTra))>1 then
       mXmlString.Add(fGeraXMLstring(0,'xNome',pDadosTransp.pNomeTra));
       if length(fdeixanum2(pDadosTransp.pIe))>1 then
          mXmlString.Add(fGeraXMLstring(0,'IE',fDeixanum2(pDadosTransp.pIe)));
       if length(trim(pDadosTransp.pEndereco))>1 then
          mXmlString.Add(fGeraXMLstring(0,'xEnder',pDadosTransp.pEndereco));
       if length(trim(pDadosTransp.pCidade))>1 then
         mXmlString.Add(fGeraXMLstring(0,'xMun',pDadosTransp.pCidade));
       if length(trim(pDadosTransp.pUfTra))>1 then
         mXmlString.Add(fGeraXMLstring(0,'UF',pDadosTransp.pUfTra));
       mXmlString.Add('</transporta>');

       if (mDadosIPINFE.idDest=2) and (DM2.Qr_CabCUF.AsString<>DM1.Tb_EmpUF.AsString)   then
       else
          begin
          if ( (length(trim(pDadosTransp.pPlacaV))>1)
             and (length(trim(pDadosTransp.pUfPlacaV))>1)) then
             begin
             mXmlString.Add('<veicTransp>');
             mXmlString.Add(fGeraXMLstring(0,'placa',pDadosTransp.pPlacaV));
             mXmlString.Add(fGeraXMLstring(0,'UF',pDadosTransp.pUfPlacaV));
             mXmlString.Add('</veicTransp>');
             end;
          end;   
       if pDadosTransp.pQtdVol>0 then
          begin
          mXmlString.Add('<vol>');
          mXmlString.Add(fGeraXMLReal(0,'qVol',pDadosTransp.pQtdVol));
          if length(pDadosTransp.pEspecie)>1 then
            mXmlString.Add(fGeraXMLstring(0,'esp',pDadosTransp.pEspecie));
          if (pDadosTransp.pPesoL>0) and (pDadosTransp.pPesoB>0) then
             begin
             mXmlString.Add(fGeraXMLReal(3,'pesoL',pDadosTransp.pPesoL));
             mXmlString.Add(fGeraXMLReal(3,'pesoB',pDadosTransp.pPesoB));
             end;
          mXmlString.Add('</vol>');
          end;
       end;
    mXmlString.Add('</transp>');

    end;

