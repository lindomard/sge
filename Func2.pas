   begin
   DM1.Query1.SQL.add('Update ECFABERTO set EA_PEDIDO=0, EA_ESTAGIO=0 '
                     +' where EA_NOMECOMP='+chr(39)+pNomTer+chr(39));
   end
else if ptipo=2 then
   begin
   DM1.Query1.SQL.add('Update ECFABERTO set EA_PEDIDO=0'+FloatTostr(pchave)+', EA_ESTAGIO=0'+IntToStr(ptipo)
                     +' where EA_NOMECOMP='+chr(39)+pNomTer+chr(39));
   end
else if ptipo=99 then
   begin
   DM1.Query1.SQL.add('Delete from ECFABERTO  '
                     +' where EA_NOMECOMP='+chr(39)+pNomTer+chr(39));
   end
else
   begin
   DM1.Query1.SQL.add('Update ECFABERTO set EA_ESTAGIO=0'+IntToStr(ptipo)
                     +' where EA_NOMECOMP='+chr(39)+pNomTer+chr(39));
   end;
Try
   DM1.Query1.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
