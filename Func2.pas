function FPedEmiteNf_Ast(ptipo,plinha: Integer): Boolean;
begin
if DM2.Tb_TDVCabDocTFONTE.Value=0 then
   mfonte:=normal
else if DM2.Tb_TDVCabDocTFONTE.Value=1 then
   mfonte:=comp12
else if DM2.Tb_TDVCabDocTFONTE.Value=2 then
   mfonte:=comp17
else if DM2.Tb_TDVCabDocTFONTE.Value=3 then
   mfonte:=comp20
else if DM2.Tb_TDVCabDocTFONTE.Value=4 then
   mfonte:=negrito
else if DM2.Tb_TDVCabDocTFONTE.Value=5 then
   mfonte:=expandido;
mtam:=DM2.Tb_TDVCabDocTTAM.AsInteger;
if mtam<0 then
   mtam:=10;
maux:=insere('*','*',mtam);
form_impres_func2.RDPrint1.ImpF(DM2.Tb_TDVCabDocTLIN.AsInteger+plinha,DM2.Tb_TDVCabDocTCOL.AsInteger,maux,[mfonte]);
result:=True;
end;

