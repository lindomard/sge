    procedure fGerarFormaPagamento;
    var
    mQtdDup: integer;


    begin
    Query_GerDup:=TQuery.Create(nil);
    Query_GerDup.DatabaseName:='SG_ASSOC';
    Query_GerDup.Close;
    Query_GerDup.sql.clear;
    if (DM2.Qr_CabP1TIPO.Asinteger<1) OR (DM2.Qr_CabP1TIPO.Asinteger>25) then
       Query_GerDup.sql.Add('Select 1 as PDUPTIP1 from PARGER ')
    else
       Query_GerDup.sql.Add('Select PDUPTIP'+DM2.Qr_CabP1TIPO.AsString+' from PARGER ');
    Query_GerDup.Open;
    if Query_GerDup.Fields[0].AsInteger=0 then
       begin
      //novo modelo
       DM4.Tb_PedFP.Close;
       DM4.Tb_PedFP.SQL.Clear;
       DM4.Tb_PedFP.SQL.add('Select * from CADPFP where PFPCODEMP=0'+DM2.Qr_CabP1CODEMP.AsString
                            +' and PFPLOTSEQ=0'+DM2.Qr_CabP1LOTSEQ.AsString
                            +' and PFPCHAVE=0'+DM2.Qr_CabP1CHAVE.AsString
                            +' and PFPORDEM=0'+DM2.Qr_CabP1ORDEM.AsString
                            +' order by PFPDATA '
                            );
       DM4.Tb_PedFP.Open;
