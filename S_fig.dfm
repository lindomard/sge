    DataSet = tb_fpro
    OnDataChange = src_fproDataChange
    Left = 384
    Top = 262
  end
  object tb_fpro: TADOQuery
    Connection = DM1_ADO.ADOConnection1
    BeforeEdit = tb_fproBeforeEdit
    Parameters = <>
    SQL.Strings = (
      'select item, CODEMP,CODPRO,CF_FOTO,'
      'CASE WHEN ITEM=0 THEN '#39'FRENTE '#39
      '     WHEN ITEM=1 THEN '#39'FUNDO'#39
      '     WHEN ITEM=2 THEN '#39'LATERAL DIREITA'#39
      '     WHEN ITEM=3 THEN '#39'LATERAL ESQUERDA'#39
      '     WHEN ITEM=4 THEN '#39'POR CIMA '#39
      '     ELSE '#39'POR BAIXO'#39' END AS POSICAO'
      ''
      ' from'
      '('
      
        'select rownum-1 as item, 1 AS CODPRO,1 AS CODEMP from user_tab_c' +
        'olumns where rownum<7'
      ') TAB01,CADFPRO'
      'WHERE CF_ORDEM(+)=TAB01.ITEM AND '
      'CF_CODEMP(+)=TAB01.CODEMP AND'
      'CF_CODPRO(+)=TAB01.CODEMP'
      '')
    Left = 352
    Top = 286
    object tb_fproITEM: TFloatField
      FieldName = 'ITEM'
    end
    object tb_fproCODEMP: TFloatField
      FieldName = 'CODEMP'
    end
    object tb_fproCODPRO: TFloatField
      FieldName = 'CODPRO'
    end
    object tb_fproCF_FOTO: TBlobField
      FieldName = 'CF_FOTO'
    end
    object tb_fproPOSICAO: TStringField
      FieldName = 'POSICAO'
      Size = 16
    end
  end
