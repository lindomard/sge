      else
         exit;
      end
   else
      begin
      mem_ped01dP1DCODEMP_OR.AsInteger:=Query_Busca.fieldbyName('P1CODEMP').AsInteger;
      mem_ped01dP1DLS_OR.AsInteger    :=Query_Busca.fieldbyName('P1LOTSEQ').AsInteger;
      mem_ped01dP1DDATAP.AsDateTime   :=Query_Busca.fieldbyName('P1DATAP').AsDateTime;
      mem_ped01dP1DOR_OR.AsInteger    :=Query_Busca.fieldbyName('P1ORDEM').AsInteger;
      end;

   Query_Busca.Close;
   Query_Busca.SQL.Clear;
   Query_Busca.SQL.Add('Select * from CADP01D where '
                     +' (P1DCODEMP='+IntTostr(mVenda_GP.mPed1_Codemp_ini)
                     +' or P1DCODEMP='+IntToStr(mVenda_GP.mPed1_Codemp_fin)+')'
                     +' and P1DCHAVE='+intTostr(mVenda_GP.mped1_Chave)
                     +' and P1DLOTSEQ='+IntTostr(mVenda_GP.mPed1_Chave_ano)
                     +' and P1DORDEM=01 '
                     +' and P1DCODEMP_OR='+mem_ped01dP1DCODEMP_OR.AsString
                     +' and P1DLS_OR='+mem_ped01dP1DLS_OR.AsString
                     +' and P1DDATAP='+QuotedStr(formatdatetime(fdt2,  mem_ped01dP1DDATAP.AsDateTime))
                     +' and P1DCH_OR='+mem_ped01dP1DCH_OR.AsString
                     +' and P1DOR_OR='+mem_ped01dP1DOR_OR.AsString
                     +' and NVL(P1DENTSAI,'+Quotedstr('S')+')=:ENTSAI ');
   if mped1_tpped=3 then
      query_busca.parambyname('ENTSAI').asstring:='E'
   else
      query_busca.parambyname('ENTSAI').asstring:='S';

   try
      Query_Busca.Open;
      if Query_Busca.IsEmpty then
        begin
        end
    except on e : exception do
       ex_erroSql_Novo(Query_Busca,21022,'func Erro:'+e.Message ,'CADEST');
       end;

    FreeAndNil(Query_Busca);
    end;
end;

