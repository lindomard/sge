         fdm1StartCommit;
      except on e : exception do
         begin
         ce_TotAddExt.Value:=0;
         ex_erroSql_Novo(query_atu,27023,'func Erro:'+e.Message ,'CADP01_ADDEXT');
         query_atu.Close;
         freeandnil(query_atu);
         exit;
         end;
