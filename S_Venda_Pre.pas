   begin
   if valint(edt_codfp.Text)=0 then
      begin
      Query_FP:=TQuery.Create(NIL);
      Query_FP.DatabaseName:='SG_ASSOC';
      Query_FP.SQL.add('Insert into CADFP ('
                      +'FPCODIGO, '
                      +'FPDESC,'
                      +'FPTIPO,'
                      +'FPNUM,'
                      +'FPVINCULO, '
                      +'FPCODCLI_EMP, '
                      +'FPCODCLI, '
                      +'FPPRAZO_FIN,'
                      +'FPORDEM,'
                      +'FPCODBCO, '
                      +'FPCODBCO_PM '
                      +' ) values ('
                      +'0, '
                      +QuotedStr('DINHEIRO')+','
                      +'0,'
                      +'0,'
                      +'0, '
                      +'0, '
                      +'0, '
                      +'0,'
                      +'0,'
                      +'0, '
                      +'0 '
                      +')');
      Query_FP.ExecSQL;
      fdm1StartCommit;
      FreeAndNil(Query_FP);
      end;
   if edt_codfp.Enabled then
      begin
      verteclado(0);
      MessageDlg('Forma de Pagamento não Cadastrado!',mtWarning,[mbOk],0);
      if sbnGravar.enabled then
         edt_codfp.SetFocus;
      exit;
      end;
   end;


if DM1.Tb_FPFPVINCULO.AsInteger=8 then
