            mVenda_GP.mPed1_Codemp:=codemp-100
         else
            mVenda_GP.mPed1_Codemp:=codemp+100;
         end;
      end;

   if (mVenda_GP.mped1_submod=100) or (mVenda_GP.mped1_submod=0) then
