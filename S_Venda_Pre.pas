   try
      Query_obs.ExecSQL;
      fdm1StartCommit;
   except
      end;
   end
else
   begin
   Query_obs.Close;
   Query_obs.SQL.Clear;
   Query_obs.SQL.Add('Update CADP01_ORC set P1ORC_OBSERV=:P1ORC_OBSERV, '
                    +' P1ORC_PRAZOENT=:P1ORC_PRAZOENT, P1ORC_VALPRO=:P1ORC_VALPRO, '
                    +' P1ORC_FORMAPAG=:P1ORC_FORMAPAG, P1ORC_LETRA=:P1ORC_LETRA, '
                    +' P1ORC_FUNDO=:P1ORC_FUNDO, P1ORC_TAMANHO=:P1ORC_TAMANHO, '
                    +' P1ORC_TABUTE=:P1ORC_TABUTE, P1ORC_PAPEL=:P1ORC_PAPEL, '
                    +' P1ORC_QTDROLO=:P1ORC_QTDROLO, P1ORC_MTROLO=:P1ORC_MTROLO, '
                    +' P1ORC_CONTATO=:P1ORC_CONTATO '
                    +',P1ORC_FONE_CONTATO=:P1ORC_FONE_CONTATO '
                    +',P1ORC_METAL_TIPOS_CORTES=:P1ORC_METAL_TIPOS_CORTES '
                    +',P1ORC_METAL_QTD_VIAS_PROD=:P1ORC_METAL_QTD_VIAS_PROD '
                    +' where '
                    +' P1ORC_CODEMP=:P1ORC_CODEMP  '
                    +' and P1ORC_LOTSEQ=:P1ORC_LOTSEQ  '
                    +' and P1ORC_CHAVE=:P1ORC_CHAVE  ');

   Query_obs.ParamByName('P1ORC_CODEMP').AsInteger :=mVenda_GP.mped1_codemp-iif(mVenda_GP.mped1_codemp>100,100,0);
   Query_obs.ParamByName('P1ORC_LOTSEQ').AsFloat   :=mVenda_GP.mPed1_Chave_ano;
   Query_obs.ParamByName('P1ORC_CHAVE').AsFloat    :=mVenda_GP.mped1_Chave;
   Query_obs.ParamByName('P1ORC_OBSERV').AsString  :=copy(Memo_obsNF.Text,1,3000);
   Query_obs.ParamByName('P1ORC_PRAZOENT').AsString:=trim(edt_prazoent.Text);
   Query_obs.ParamByName('P1ORC_VALPRO').AsString  :=trim(edt_val_proposta.Text);
   Query_obs.ParamByName('P1ORC_FORMAPAG').AsString:=' ';
   Query_obs.ParamByName('P1ORC_LETRA').AsString   :=trim(edt_pnl_letra.Text);
   Query_obs.ParamByName('P1ORC_FUNDO').AsString   :=trim(edt_pnl_fundo.Text);
   Query_obs.ParamByName('P1ORC_TAMANHO').AsString :=trim(edt_pnl_tamanho.Text);
   Query_obs.ParamByName('P1ORC_TABUTE').AsString  :=trim(edt_pnl_tabute.Text);
   Query_obs.ParamByName('P1ORC_PAPEL').AsString   :=trim(edt_pnl_papel.Text);
   Query_obs.ParamByName('P1ORC_QTDROLO').AsString :=trim(edt_pnl_rolo.Text);
   Query_obs.ParamByName('P1ORC_MTROLO').AsString  :=trim(edt_pnl_mtrolo.Text);
   Query_obs.ParamByName('P1ORC_CONTATO').AsString :=edt_contato.Text;
   Query_obs.ParamByName('P1ORC_FONE_CONTATO').AsString :=edt_fone_contato.Text;

   Query_obs.ParamByName('P1ORC_METAL_TIPOS_CORTES').AsString := edt_tpc_tipos_cortes.text;
   Query_obs.ParamByName('P1ORC_METAL_QTD_VIAS_PROD').AsInteger :=CB_METAL_QTD_VIAS_PROD.Value;

   try
