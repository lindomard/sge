      Query_Ped01D.ParamByName('P1DID_PEDORI_NEW').AsInteger := mem_ped01dP1DID_PEDORI_NEW.AsInteger;

      end
    else if ptipo=1 then
      begin
      Query_Ped01D.SQL.Add('Update CADP01D set '
                       +'P1DLS_OR=:P1DLS_OR '
                       +',P1DCODEMP_OR=:P1DCODEMP_OR '
