procedure TFrm_Venda_Pre.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
var
tString: tStringList;
begin
if (mlocalizando_pedido) or (mBloqueioGeral)  then
   begin
   mQtdbloqEve  :=mQtdBloqEve+1;
   tString:=tStringList.create;
   tString.Add(IntToStr(mQtdbloqEve));
   fSalvarTextoparaArquivoComNome('c:\sge\temp\mqtdbloq.txt',tString);
   freeandnil(tString);

   CanClose:=False;
   exit;
   end  ;

//sleep(10000);

if not mCloseQueryAcionado then
   begin
   mQtdPassouEve  :=mQtdPassouEve+1;

   tString:=tStringList.create;
   tString.Add(IntToStr(mQtdPassouEve));
   fSalvarTextoparaArquivoComNome('c:\sge\temp\mqtdpassoueve.txt',tString);
   freeandnil(tString);


//   fSalvarTextoparaArquivoComNome('c:\sge\temp\mqtdbloq.txt',inttostr(mQtdPassouEve));

   mCloseQueryAcionado:=true;

    bbSair.Enabled:=false;
    If (sbnGravar.Enabled) and (valfloat( edt_totliq.Text)>0) then
       begin
       Self.Perform(WM_NEXTDLGCTL,0,0);
       verteclado(1);

       Case fmensagem('O Pedido atual não está gravado!'+#13
                      +'Deseja gravar agora?',0,['1','2','3'],0) of
          mrYes: sbnGravar.Click;
          mrNo : begin
                 sbnCancelar.Click;
                 bbSair.Enabled:=true;
                 mCloseQueryAcionado:=false;

                 exit;
                 end;
          else
             begin
             bbSair.Enabled:=true;
             mCloseQueryAcionado:=false;

             CanClose:=False;
             exit;
             end;
          end;
       end;

    if mGravandoPedido then
       begin
    //   showmessage('cancelando canclose');
       CanClose:=False;
       mCloseQueryAcionado:=false;

       bbSair.Enabled:=true;
       exit;
       end;




    try
    if mVenda_GP.mped1_Chave>0 then
       begin
       if mped_Alterou_Cab then
          begin
          mVenda_GP.mped1_submod_grav:=0;
          if mVenda_GP.mped1_submod=100 then
             begin
             mVenda_GP.mped1_submod_grav:=100;
             if codemp>100 then
                fGravarPedido(1,-100)
             else
                fGravarPedido(1,100);
             end
          else
             begin
             if mVenda_GP.mped1_submod>0 then
                mVenda_GP.mped1_submod_grav:=100-mVenda_GP.mped1_submod;
             fGravarPedido(1,0);
             end;
          if (mVenda_GP.mped1_submod>0) and (mVenda_GP.mped1_submod<100) then
             begin
             mVenda_GP.mped1_submod_grav:=mVenda_GP.mped1_submod;
             if codemp>100 then
                fGravarPedido(1,-100)
             else
                fGravarPedido(1,100);
             end;
          mVenda_GP.mPed1_QtdParc_ant:=mVenda_GP.mPed1_QtdParc;
          fRecalcularPedido(3);
          end;
       DM1.Query1.Close;
       DM1.Query1.SQL.Clear;
       DM1.Query1.SQL.Add('Delete from cadp02_pre_temp '
                                 +' where P2T_CODEMP=:CODEMP '
                                 +' and   P2T_CHAVE=:CHAVE '
                                 +' and   P2T_CHAVE_ANO=:CHAVE_ANO '
                                   );
       DM1.Query1.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp;
       DM1.Query1.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
       DM1.Query1.ParamByName('CHAVE_ANO').AsInteger:=mVenda_GP.mPed1_Chave_ano;

       try
          DM1.Query1.ExecSQL;
          fDM1StartCommit;
       except on e : exception do

          if not fVerificaRedeAtiva(true) then
             begin
             end
          else
             begin
             ex_erroSql_Novo(dm1.QUERY1,1793,'func Erro:'+e.Message ,'CADEST');
             end;
          end;
       fAtualizarBotoes(1);
       fBloquearLiberarCampos(false);
       if (pOperacaoPedido=1) and (Tb_Ped02_pre.isempty) and (Tb_ped02S_pre.isempty) then
          pOperacaoPedido:=1
       else
          pOperacaoPedido:=2;
       sbnCancelarClick(SELF);
       end;

    if form_venda_pesqprod<>nil then
       begin
       FreeAndNil(form_venda_pesqprod);
       end;

    if Form_Pro_Nov<>nil then
       begin
       FreeAndNil(Form_Pro_Nov);
       end;
    except
      end;

    FreeAndNil(mVenda_GP);
    FreeAndNil(Query_Soma_Lote_Edit);
    FreeAndNil(cds_lotes);

    if form_cmet<>nil then
       FreeAndNil(form_cmet);
    if form_arma<>nil then
       FreeAndNil(form_arma);

    if pList_Lote<>nil then
       FreeAndNil(pList_Lote);
    if Frm_DadCli<>nil then
       freeandnil(Frm_DadCli);
    end;



end;



procedure TFrm_Venda_Pre.fVerificaTef;
var
   query_fPag: tQuery;
   formPaygoApi : TPayGoAPI;
begin
fAtualizarTipoTef;


if mTipoTef=0 then
   begin
   query_fPag := tQuery.create(nil);
   query_fPag.databasename:=DM1.SG_ASSOC.databasename;
   query_fPag.Sql.add('select count(*) as qtd from CADFP WHERE FPCODCLI>0');
   try
      query_fPag.open;
   except on e : exception do
      begin
      ex_erroSql_Novo(Query_fpag,23972,'venda_pre'+e.Message,'CADFP');
      query_fpag.close;
      FreeAndNil(query_fpag);
      end;
      end;
   if query_fpag.fieldbyname('qtd').asinteger>0 then
      begin
      formPaygoApi := TPayGoAPI.Create();
      sbnGerenciadorTef.visible:=formPaygoApi.fTefAtivo(Formatfloat('000', formPaygoApi.fPegarSeqTef)).Aprovado;
      freeandnil(formpaygoApi);
      end;
   end;

end;
