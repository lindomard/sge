function TFrm_Venda_Pre.fBuscarLotes(pItem: Integer;pCodpro: String;pQtd: Real): boolean;
var
mQtdFalta: Real;
mQtdCal: Real;
Qr_Lote_Temp: TQuery;
begin
Qr_Lote_Temp:=TQuery.Create(nil);
Qr_Lote_Temp.DatabaseName:='SG_ASSOC';
Qr_Lote_Temp.Close;
Qr_Lote_Temp.SQL.clear;
Qr_Lote_Temp.SQL.Add('Select SUM(P2LM_QTD) as QTD from CADP02_LOTES '
                  +'  where (P2LM_CODEMP=:CODEMP or P2LM_CODEMP=:CODEMP_FILIAL) '
                  +'    and P2LM_CHAVE=:CHAVE '
                 +'    and P2LM_LOTSEQ=:LOTSEQ '
                  +'    and P2LM_ITEM=:ITEM '
                  +'    and P2LM_CODPRO=:CODPRO ');
Qr_Lote_Temp.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp_ini;
Qr_Lote_Temp.ParamByName('CODEMP_FILIAL').AsInteger:=mVenda_GP.mPed1_Codemp_fin;
Qr_Lote_Temp.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
Qr_Lote_Temp.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
Qr_Lote_Temp.ParamByName('ITEM').AsInteger:=pItem;
Qr_Lote_Temp.ParamByName('CODPRO').AsFloat:=fsonumero(pCodpro);
fGerarEvento('13837 ABRINDO O QR_LOTE_TEMP');

try
   Qr_Lote_Temp.open;
except
   ex_erroSql_Novo(Qr_Lote_Temp,5835,'venda_pre','CADLGC');
   result:=false;
   exit;
   end;
mQtdFalta:=pQtd-Qr_Lote_Temp.fieldbyname('QTD').AsFloat;
if (mqtdfalta<>0) or (not Tb_Ped02_Lotes.Active) then
   fLerCadp02_Lotes(pItem,fSonumero(pcodpro));


Qr_Lote_Temp.Close;
Qr_Lote_Temp.SQL.Clear;

if ((mVenda_GP.mPed1_Tipo_Ped=8) or (mVenda_GP.mPed1_Tipo_Ped=12)
// or (mVenda_GP.mPed1_Tipo_Ped=29)
or (cds_aliquotasrequer_pedori.AsInteger>0) ) and (not cb_naoverifica.checked=true) then
   begin
   Qr_Lote_Temp.SQL.Add('SELECT P2LM_LOTE AS CLNUMERO,P2LM_DTVCTO AS CLDTVCTO, P2LM_DTFAB AS CLDTFAB,'
                      +'       P2LM_QTD AS CLQTD FROM CADP02_LOTES '
                      +' where P2LM_CHAVE=:CHAVE and P2LM_LOTSEQ=:LOTSEQ and '
                      +' (P2LM_CODEMP=:CODEMP or P2LM_CODEMP=:CODEMP_FILIAL) '
//                      +' and P2LM_CODPRO=:CODPRO  and P2LM_ITEM=:ITEM');
                      +' and P2LM_CODPRO=:CODPRO  ');
   Qr_Lote_Temp.ParamByName('CHAVE').AsFloat:=Qr_itens_pedoriP2CHAVE.AsInteger;
   Qr_Lote_Temp.ParamByName('LOTSEQ').AsFloat:=Qr_itens_pedoriP2LOTSEQ.AsInteger;
   Qr_Lote_Temp.ParamByName('CODEMP').AsFloat:=Qr_itens_pedoriP2CODEMP.AsInteger;
   if Qr_itens_pedoriP2CODEMP.AsInteger>100 then
      Qr_Lote_Temp.ParamByName('CODEMP_FILIAL').AsFloat:=Qr_itens_pedoriP2CODEMP.AsInteger-100
   else
      Qr_Lote_Temp.ParamByName('CODEMP_FILIAL').AsFloat:=Qr_itens_pedoriP2CODEMP.AsInteger+100;
   Qr_Lote_Temp.ParamByName('CODPRO').AsFloat:=Qr_itens_pedoriPDCODPRO.AsFloat;
//   Qr_Lote_Temp.ParamByName('ITEM').AsInteger:=Qr_itens_pedoriP2ITEM.AsInteger;
   end
else
   begin
   Qr_Lote_Temp.SQL.Add('Select CLNUMERO,CLDTVCTO,CLDTFAB,CLQTD from CADLGC '
                   +' where (CLCODEMP=:CODEMP or CLCODEMP=:CODEMP_FILIAL) '
                   +' and  (CLFILIAL=:FILIAL or CLFILIAL is null) '
                   +' and CLCODPRO=:CODPRO '
                   +' order by CLDTVCTO,CLNUMERO');
   Qr_Lote_Temp.parambyName('FILIAL').asinteger:=mVenda_GP.mped1_Filial;
   Qr_Lote_Temp.parambyName('CODEMP').asinteger:=codemp;
   if codemp>100 then
      Qr_Lote_Temp.parambyName('CODEMP_FILIAL').asinteger:=codemp-100
   else
      Qr_Lote_Temp.parambyName('CODEMP_FILIAL').asinteger:=codemp+100;
   Qr_Lote_Temp.parambyName('CODPRO').AsFloat:=fsonumero(pcodpro);
   end;
try
   Qr_Lote_Temp.open;
except
   ex_erroSql_Novo(Qr_Lote_Temp,5835,'venda_pre','CADLGC');
   result:=false;
   exit;
   end;
fGerarEvento('138892 MQTDFALTA= '+Floattostr(mqtdfalta)+' lote temp '+iif(Qr_Lote_Temp.IsEmpty=true,'vazio','cheio')+' codigo do produto '+pCodpro);

While (not Qr_Lote_Temp.Eof) and (mQtdFalta>0) do
   begin
   if Qr_Lote_Temp.fieldbyName('CLQTD').AsFloat<=0 then
      begin
      Qr_Lote_Temp.Next;
      Continue;
      end;
   fGerarEvento('13899 preenchendo tabela de lotes');

   Tb_Ped02_Lotes.Append;
   Tb_Ped02_LotesP2LM_ITEM.AsInteger:=Tb_Ped02_preP2ITEM.AsInteger;
   Tb_Ped02_LotesP2LM_CODPRO.Value  :=ValFloat(Tb_Ped02_preP2CODPRO.AsString);
   Tb_Ped02_LotesP2LM_LOTE.AsString :=Qr_Lote_Temp.fieldbyName('CLNUMERO').AsString;
   Tb_Ped02_LotesP2LM_DTVCTO.AsDateTime :=Qr_Lote_Temp.fieldbyName('CLDTVCTO').AsDateTime;
   Tb_Ped02_LotesP2LM_DTFAB.AsDateTime :=Qr_Lote_Temp.fieldbyName('CLDTFAB').AsDateTime;
   if mQtdFalta<=Qr_Lote_Temp.fieldbyName('CLQTD').AsFloat then
      begin
      Tb_Ped02_LotesP2LM_QTD.AsFloat   :=mQtdFalta;
      mQtdFalta:=0;
      end
   else
      begin
      Tb_Ped02_LotesP2LM_QTD.AsFloat   :=Arredonda( Qr_Lote_Temp.fieldbyName('CLQTD').AsFloat, DM1.Tb_PargerPCASQTD.AsInteger);
      mQtdFalta:=Arredonda( ( mQtdFalta-Qr_Lote_Temp.fieldbyName('CLQTD').AsFloat), DM1.Tb_PargerPCASQTD.AsInteger);
      end;
   Tb_Ped02_Lotes.Post;
   Qr_Lote_Temp.Next;
   end;
if mQtdFalta>0 then
   begin
   Tb_Ped02_Lotes.Append;
   Tb_Ped02_LotesP2LM_ITEM.AsInteger:=Tb_Ped02_preP2ITEM.AsInteger;
   Tb_Ped02_LotesP2LM_CODPRO.Value  :=ValFloat(Tb_Ped02_preP2CODPRO.AsString);
   Tb_Ped02_LotesP2LM_LOTE.AsString :='';
   Tb_Ped02_LotesP2LM_QTD.AsFloat   :=mQtdFalta;
   Tb_Ped02_Lotes.Post;
   end
else if mQtdFalta<0 then
   begin
   Tb_Ped02_Lotes.Prior;
   While (not Tb_Ped02_Lotes.Eof) and (mQtdFalta<0) do
      begin
      if Tb_Ped02_LotesP2LM_QTD.AsFloat>=(mqtdfalta*-1) then
         begin
         Tb_Ped02_Lotes.Edit;
         Tb_Ped02_LotesP2LM_QTD.AsFloat:=Tb_Ped02_LotesP2LM_QTD.AsFloat+mQtdFalta;
         mQtdFalta:=0;
         Tb_Ped02_Lotes.Post;
         Tb_Ped02_Lotes.Prior;
         end
      else
         begin
         mQtdFalta:=mQtdFalta+Tb_Ped02_LotesP2LM_QTD.AsFloat;
         Tb_Ped02_Lotes.Delete;
         end;
      end;
   end;

if mVenda_GP.mped1_submod=0 then
   begin
   if not Tb_Ped02_Lotes.Active then
      fLerCadp02_Lotes(Tb_Ped02_preP2Item.AsInteger,ValFloat(Tb_Ped02_preP2CODPRO.AsString));

   Tb_Ped02_Lotes.First;
   While not Tb_Ped02_Lotes.Eof do
      begin
      Tb_Ped02_Lotes.Edit;
      Tb_Ped02_LotesP2LM_QTD_101.Value:=0;
      Tb_Ped02_LotesP2LM_QTD_001.Value:=Tb_Ped02_LotesP2LM_QTD.AsFloat;
      Tb_Ped02_Lotes.Post;
      Tb_Ped02_Lotes.Next;
      end;
   end
else if mVenda_GP.mped1_submod=100 then
   begin
   Tb_Ped02_Lotes.First;
   While not Tb_Ped02_Lotes.Eof do
      begin
      Tb_Ped02_Lotes.Edit;
      Tb_Ped02_LotesP2LM_QTD_001.Value:=0;
      Tb_Ped02_LotesP2LM_QTD_101.Value:=Tb_Ped02_LotesP2LM_QTD.AsFloat;
      Tb_Ped02_Lotes.Post;
      Tb_Ped02_Lotes.Next;
      end;
   end
else
   begin
   Tb_Ped02_Lotes.First;
   While not Tb_Ped02_Lotes.Eof do
      begin
      Tb_Ped02_Lotes.Edit;

      if mVenda_GP.mped1_formace=1 then
         begin
         Tb_Ped02_LotesP2LM_QTD_101.Value:=0;
         mQtdCal:=Tb_Ped02_LotesP2LM_QTD.AsFloat;
         Tb_Ped02_LotesP2LM_QTD_001.Value:=mQtdCal;
         end
      else
         begin
         mQtdCal:=Tb_Ped02_LotesP2LM_QTD.AsFloat;
         mQtdCal:=Arredonda( (mQtdCal*mVenda_GP.mped1_submod/100), 0);
         Tb_Ped02_LotesP2LM_QTD_101.Value:=mQtdCal;
         mQtdCal:=Tb_Ped02_LotesP2LM_QTD.AsFloat-mQtdCal;
         Tb_Ped02_LotesP2LM_QTD_001.Value:=mQtdCal;
         end;
//      Tb_Ped02_LotesP2LM_QTD_101.Value:=Tb_Ped02_preP2QTD.AsFloat;
      Tb_Ped02_Lotes.Post;
      Tb_Ped02_Lotes.Next;
      end;
   end;

freeandnil(Qr_Lote_Temp);


result:=true;
end;
function TFrm_Venda_Pre.fExluirLoteSemEstoque(pItem: Integer;pCodPro: Real): boolean;
var
Query_lote_Sem_Est: TQuery;
Query_Del_lote: TQuery;
begin
la_tabelas  :='';
la_Join     :='';
la_instrucao:='';
fInnerJoin3(0,'CADLGC' ,'CLCODEMP','P2LM_CODEMP' ,'CLCODPRO' ,'P2LM_CODPRO' ,'CLNUMERO' ,'P2LM_LOTE');

Query_lote_Sem_Est:=tQuery.Create(nil);
Query_lote_Sem_Est.DatabaseName:='SG_ASSOC';
Query_lote_Sem_Est.Close;
Query_lote_Sem_Est.SQL.Clear;

Query_lote_Sem_Est.SQL.Add('select P2LM_CODEMP,P2LM_CODPRO,P2LM_LOTE, P2LM_DTFAB '
                          +',CLNUMERO,CLQTD,P2LM_QTD '
                          +' from CADP02_LOTES'+iif(la_tabelas='','',',')+la_tabelas
                          +'       '+la_Join
                          +'       where '+la_instrucao+iif(la_instrucao='','',' and ')
                          +' P2LM_CODPRO=:CODPRO '
                          +' and P2LM_ITEM=:ITEM '
                          +' and P2LM_CHAVE=:CHAVE '
                          +' and P2LM_LOTSEQ=:LOTSEQ '
                          +' and (P2LM_CODEMP=:CODEMP or P2LM_CODEMP=:CODEMP_FILIAL) '
                          +' and  (CLFILIAL(+)=:FILIAL ) '
                          );
Query_Lote_Sem_Est.parambyName('FILIAL').asinteger:=mVenda_GP.mped1_Filial;
Query_lote_Sem_Est.ParamByName('CODPRO').AsFloat:=pCodPro;
Query_lote_Sem_Est.ParamByName('ITEM').AsInteger:=pItem;
Query_lote_Sem_Est.ParamByName('CHAVE').AsFloat:=mVenda_GP.mped1_Chave;
Query_lote_Sem_Est.ParamByName('LOTSEQ').AsFloat:=mVenda_GP.mPed1_Chave_ano;

Query_lote_Sem_Est.parambyName('CODEMP').asinteger:=codemp;
if codemp>100 then
   Query_lote_Sem_Est.parambyName('CODEMP_FILIAL').asinteger:=codemp-100
else
   Query_lote_Sem_Est.parambyName('CODEMP_FILIAL').asinteger:=codemp+100;
try
   Query_lote_Sem_Est.Open;
except
   ex_erroSql_Novo(Query_lote_Sem_Est,7233,'venda_pre','CADP02_LOTES');
   end;


Query_Del_lote:=tQuery.Create(nil);
Query_Del_lote.DatabaseName:='SG_ASSOC';
while not Query_lote_Sem_Est.Eof do
   begin
   if Query_lote_Sem_Est.FieldByName('CLQTD').AsFloat<Query_lote_Sem_Est.FieldByName('P2LM_QTD').AsFloat then
      begin
      Query_Del_lote.Close;

      Query_Del_lote.SQL.Clear;
      Query_Del_lote.SQL.Add('Delete from CADP02_LOTES where '
                            +' P2LM_CODEMP=:CODEMP '
                            +' and P2LM_CHAVE=:CHAVE '
                            +' and P2LM_LOTSEQ=:LOTSEQ '
                            +' and P2LM_ITEM=:ITEM '
                            +' and P2LM_CODPRO=:CODPRO '
                            +' and (P2LM_LOTE=:LOTE ');
      if Query_lote_Sem_Est.FieldByName('P2LM_LOTE').Asstring='' then
         Query_Del_lote.SQL.add(' or P2LM_LOTE is null ');
      Query_Del_lote.SQL.add(' ) ');


      Query_Del_lote.ParamByName('CODEMP').AsInteger:=Query_lote_Sem_Est.FieldByName('P2LM_CODEMP').AsInteger;
      Query_Del_lote.ParamByName('CHAVE').AsInteger :=mVenda_GP.mped1_Chave;
      Query_Del_lote.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
      Query_Del_lote.ParamByName('ITEM').AsInteger  :=pItem;
      Query_Del_lote.ParamByName('CODPRO').AsFloat  :=Query_lote_Sem_Est.FieldByName('P2LM_CODPRO').AsFloat;
      Query_Del_lote.ParamByName('LOTE').AsString   :=Query_lote_Sem_Est.FieldByName('P2LM_LOTE').Asstring;
      try
         Query_Del_lote.ExecSQL;
         fdm1StartCommit;
      except
         ex_erroSql_Novo(Query_Del_lote,7263,'venda_pre','CADP02_LOTES');
         end;
      fLerCadp02_Lotes(pItem,Query_lote_Sem_Est.FieldByName('P2LM_CODPRO').AsFloat);
      fLerCadp02_Lotes_Antes(pItem,Query_lote_Sem_Est.FieldByName('P2LM_CODPRO').AsFloat);

      end;
   Query_lote_Sem_Est.Next;
   end;
FreeAndNil(Query_lote_Sem_Est);
FreeAndNil(Query_Del_lote);
result:=true;
end;



function TFrm_Venda_Pre.fAjustarLotes(pItem: Integer; pEstNor_Ant,pEstNor_Atu, pCodpro: String;pQtd_Antes,pQtd_Nova: Real): boolean;

var
Query_lote: TQuery;
mQtd_Falta: Real;
mQtdCAl: Real;
mCompChaves: String;
mQtdAnt: Real;
begin
if not Tb_Ped02_Lotes.Active then
   fLerCadp02_Lotes(pItem,ValFloat(Tb_Ped02_preP2CODPRO.AsString));

mQtd_Falta:=pQtd_Nova;
Tb_Ped02_Lotes.First;
While (not Tb_Ped02_Lotes.Eof) do
   begin
   if Arredonda( Tb_Ped02_LotesP2LM_QTD.AsFloat , DM1.Tb_PargerPCASQTD.AsInteger)
      <=Arredonda(mQtd_Falta, DM1.Tb_PargerPCASQTD.AsInteger) then
      begin
      mQtd_Falta:=mQtd_Falta-Arredonda( Tb_Ped02_LotesP2LM_QTD.AsFloat , DM1.Tb_PargerPCASQTD.AsInteger);
      end
   else
      begin
      if mQtd_Falta<=0 then
         Tb_Ped02_Lotes.Delete
      else
         begin
         Tb_Ped02_Lotes.Edit;
         Tb_Ped02_LotesP2LM_QTD.AsFloat:=mQtd_Falta;
         Tb_Ped02_Lotes.Post;
         mQtd_Falta:=0;
         end;
      end;
   Tb_Ped02_Lotes.Next;
   end;



Query_lote:=tQuery.Create(nil);
Query_lote.DatabaseName:='SG_ASSOC';
Query_lote.Close;
