mcodemp_nov: integer;

begin
if (Tb_Ped02_pre.IsEmpty and Tb_ped02S_pre.IsEmpty) or (not sbnGravar.Enabled) then
   begin
   result:=true;
   exit;
   end;
if mlocalizando_pedido then
   begin
   result:=true;
   exit;
   end;

if ((pSubMod_Ant=0) and (pSubMod_Atu=100)) or
   ((pSubMod_Ant=100) and (pSubMod_Atu=0)) then
   begin

   if pSubMod_Ant=0 then
      begin
      mcodemp_ant:=codemp;
      end
   else
      begin
      if codemp>100 then
         mcodemp_ant:=codemp-100
      else
         mcodemp_ant:=codemp+100;
      end;
   if mcodemp_ant>100 then
      mcodemp_nov:=mcodemp_ant-100
   else
      mcodemp_nov:=mcodemp_ant+100;

   fAjustarPedidosdeOrigem_codemp(mcodemp_ant,mVenda_GP.mped1_Chave,mVenda_GP.mPed1_Chave_ano,mcodemp_nov);


   query_exe:=TQuery.create(nil);
   query_exe.DatabaseName:='SG_ASSOC';
