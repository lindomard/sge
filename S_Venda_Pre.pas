    begin
    Qr_EncDet := TQuery.Create(self);
    Qr_EncDet.databasename:='SG_ASSOC';

    Qr_EncDet.Close;
    Qr_EncDet.SQL.Clear;
    Qr_EncDet.SQL.Add(' select * from ENCVOENCDET ');
    Qr_EncDet.SQL.Add(' where ENCD_CHAVE=0'+Qr_EncCab.FieldByName('ENC_CHAVE').AsString);
    Qr_EncDet.SQL.Add(' and ENCD_CODEMP='+Qr_EncCab.FieldByName('ENC_CODEMP').AsString);
    try
      Qr_EncDet.Open;
    except
      fmensagem('Erro ao buscar encomenda!!!',0,['0'],0);
      Qr_EncDet.SQL.SaveToFile(SALVA_NOME('c:\sge\errosql\','ex'));
      Exit;
      end;
    end
  else
    begin
    fmensagem('Encomenda não encontrada!!!',0,['0'],0);
    Exit;
    end;
except
  fmensagem('Erro ao buscar encomenda!!!',0,['0'],0);
  Qr_EncCab.SQL.SaveToFile(SALVA_NOME('c:\sge\errosql\','ex'));
  Exit;
  end;

cb_leitor.Checked   :=False;
cb_tppco.ItemIndex  :=2;
cb_tppcoClick(Self);
cb_tppcoExit(Self);
Tb_Ped02_preP2PRECO.ReadOnly:=False;
edt_codcli.Text             :=Qr_EncCab.FieldByName('ENC_CODCLI').AsString;
edt_codcliExit(Self);
flcadcli(1,0,Qr_EncCab.FieldByName('ENC_CODCLI').AsString);
if DM1.Tb_CliCCODCV.AsInteger>0 then
  begin
  if fmensagem('Cliente possui convênio!. Deseja Faturar como Convênio?',1,['1','2'],1)=mrYes then
    cb_tipoped.ItemIndex:=cb_tipoped.Items.IndexOf('Emprestimo de Mercadorias')
  else
    cb_tipoped.ItemIndex:=cb_tipoped.Items.IndexOf('Orcamento');
  cb_tipopedExit(self);
  end
else
  begin
  cb_tipopedExit(Self);
  end;
edt_codtra.Text :=Qr_EncCab.FieldByName('ENC_CODTRA').AsString;
edt_codtraExit(Self);
if Qr_EncCab.FieldByName('ENC_STATUS').AsInteger=0 then
  begin
  if Qr_EncCab.FieldByName('ENC_TOTENT').AsFloat=0 then
    begin
    fmensagem('Encomenda não possui valor de entrada!',0,['0'],0);
    Exit;
    end;
  Memo_ObsPed.Lines.Add('Ref. a Entrada Encomenda Nº..:'+Qr_EncCab.FieldByName('ENC_CHAVE').AsString);
  Tb_Ped02_pre.Append;
  Tb_Ped02_preP2CODPRO.AsInteger :=1;
  DBGrid_itens.OnColExit(self);
  Tb_Ped02_preP2DESC_COMP.AsString:='PEDIDOS DIVERSOS ENCOMENDA Nº..:'+Qr_EncCab.FieldByName('ENC_CHAVE').AsString;
  Tb_Ped02_preP2QTD.AsFloat:=1;
  Tb_Ped02_preP2PRECO.AsFloat:=Qr_EncCab.FieldByName('ENC_TOTENT').AsFloat;
  if Tb_Ped02_pre.State in [dsInsert, dsEdit] then
    Tb_Ped02_pre.Post;
  end
else if Qr_EncCab.FieldByName('ENC_STATUS').AsInteger=2 then
  begin
  Memo_ObsPed.Lines.Add('Ref. a Finalização da Encomenda Nº..:'+Qr_EncCab.FieldByName('ENC_CHAVE').AsString);
  Qr_EncDet.First;
  while not Qr_EncDet.Eof do
    begin
    Tb_Ped02_pre.Append;
    Tb_Ped02_preP2CODPRO.AsFloat:=Qr_EncDet.FieldByName('ENCD_CODPRO').AsFloat;
    DBGrid_itensColExit(self);
    Tb_Ped02_preP2DESC_COMP.AsString:=Qr_EncDet.FieldByName('ENCD_NOME').AsString;
    Tb_Ped02_preP2QTD.AsFloat:=Qr_EncDet.FieldByName('ENCD_QUANTIDADE').AsFloat;
    Tb_Ped02_preP2PRECO.AsFloat:=Qr_EncDet.FieldByName('ENCD_PCOUNI').AsFloat;
    DBGrid_itensColExit(self);
    if Tb_Ped02_pre.State in [dsInsert, dsEdit] then
      Tb_Ped02_pre.Post;
    Qr_EncDet.Next;
    end;
  edt_desc_valor.Text:=FormatFloat(mcasas,Qr_EncCab.FieldByName('ENC_TOTENT').AsFloat);
  edt_desc_valorExit(Self);
  end;
mGravando_Encomenda:=False;
if valfloat(edt_codcli.Text) = 1 then
  edt_nomcli.Text      :=Qr_EncCab.FieldByName('ENC_NOMCLI').AsString;
if sbnGravar.Enabled then
   edt_codven.SetFocus;
end;


function tFrm_Venda_Pre.fGravarCabecalho(pTipo: Integer): Boolean;
begin
mVenda_GP.mped1_submod_grav:=0;
if mVenda_GP.mped1_submod=100 then
   begin
   mVenda_GP.mped1_submod_grav:=100;
   if codemp>100 then
      fGravarPedido(1,-100)
   else
      fGravarPedido(1,100);
   end
else
   begin
   if mVenda_GP.mped1_submod>0 then
      mVenda_GP.mped1_submod_grav:=100-mVenda_GP.mped1_submod;
   fGravarPedido(1,0);
   end;
if (mVenda_GP.mped1_submod>0) and (mVenda_GP.mped1_submod<100) then
   begin
   mVenda_GP.mped1_submod_grav:=mVenda_GP.mped1_submod;
   if codemp>100 then
      fGravarPedido(1,-100)
   else
      fGravarPedido(1,100);
   end;
result:=true;
end;

