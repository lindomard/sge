      query_atu.close;
      freeandnil(query_atu);
      fDeletaPadroes(-9,'_VENDA_PRE','VALDIC_'+Formatfloat('000000', mVenda_GP.mped1_Chave));

      fsorecalcular(0);
      fBloqueiaLiberaPedido(0);

