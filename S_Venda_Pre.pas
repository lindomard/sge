function TFrm_Venda_Pre.fTestarDesconto(pTipo: string; out pPrecoTab: Real):Boolean;

var
query_desc: tquery;
mDescRat: Real;
mMaiorDesconto: Real;

mMaiorPermitido: Real;
mpreco_tab: string;
query_promo: TQuery;
mPrecoPromo: Real;
mPrecoAbaixoPromocao: boolean;
begin

if (mped1_tpPed_acionar_dev>0) then
   begin
   result:=true;
   exit;                               
   end;

if mVenda_GP.mped1_Chave=0 then
   fGravarPed01(0);

mpreco_tab:='case when nvl(P2PCOTAB,0)=0 then P2PRECO else P2PCOTAB end ';
if Tb_Ped02_preP2PRECO.AsFloat=0 then
   begin
   result:=true;
   exit;
   end;
if mped1_Calculando then
   begin
   result:=true;
   exit;
   end;
result:=true;

query_desc:=tquery.create(nil);
query_desc.DatabaseName:='SG_ASSOC';
query_desc.Sql.add(' SELECT * from ( ');
   begin
   query_desc.Sql.add(' SELECT P2CODPRO,P2PERCDESC_AUT,PDNOME,PDUND,P2PRECO,PRECO_CALC, :PRECO_PROMO AS PRECO_PROMO,  '
                  +' round( ((('+mpreco_tab+'-PRECO_CALC)*100)  / '+mpreco_tab+'),2)  AS DESC_MEDIO, '
                  +' case WHEN  (case when NVL(PDDESCMAX,0)>0 THEN PDDESCMAX '
                  +'      when NVL(FPDESCMAX,0)>0 THEN FPDESCMAX '
                  +'      ELSE NVL(GRPERCDESC,0) end) > :DESCMAXLIB THEN '
                  +'      (case when NVL(PDDESCMAX,0)>0 THEN PDDESCMAX '
                  +'            when NVL(FPDESCMAX,0)>0 THEN FPDESCMAX '
                  +'       ELSE NVL(GRPERCDESC,0) end) '
                  +' ELSE '
                  +'     case when NVL(PDDESCMAX,0)>0 THEN PDDESCMAX '
                  +'      when NVL(FPDESCMAX,0)>0 THEN FPDESCMAX '
                  +'    when NVL(GRPERCDESC,0)>0 THEN GRPERCDESC '
                  +' ELSE :DESCMAXLIB END '
                  +'  END '
                  +' AS DESCMAX  FROM ( '
                  +' SELECT P2CODPRO,P2PERCDESC_AUT,P2PRECO,'+mpreco_tab+' as P2PCOTAB,P1DESC_RAT,PRECO_CALC-  round((PRECO_CALC*P1DESC_RAT/100),2)  AS PRECO_CALC FROM ( '
                  +' SELECT P2CODPRO,P2PERCDESC_AUT,P2PRECO,'+mpreco_tab+' as P2PCOTAB,P1DESC_RAT,PRECO_CALC-  round((PRECO_CALC*P1DESC1/100),2)  AS PRECO_CALC FROM ( '
                  +' SELECT P2CODPRO,P2PERCDESC_AUT,P2PRECO,'+mpreco_tab+' as P2PCOTAB,P1DESC1,P1DESC_RAT,PRECO_CALC-  round((PRECO_CALC*P2DESC3/100),2)  AS PRECO_CALC FROM ( '
                  +' SELECT P2CODPRO,P2PERCDESC_AUT,P2PRECO,'+mpreco_tab+' as P2PCOTAB,P2DESC3,P1DESC1,P1DESC_RAT,PRECO_CALC-  round((PRECO_CALC*P2DESC2/100),2)  AS PRECO_CALC FROM ( '
                  +' SELECT P2CODPRO,P2PERCDESC_AUT,P2PRECO,'+mpreco_tab+' as P2PCOTAB,P2DESC2,P2DESC3,P1DESC1,P1DESC_RAT,PRECO_CALC- round( (PRECO_CALC*P2DESC1/100),2) AS PRECO_CALC FROM ( '
                  +' ( SELECT P2CODPRO,P2PERCDESC_AUT, case when NVL(P2PRECO,0)=0 then :PRECO else P2PRECO end  as P2PRECO,'
                  +' case when nvl('+mpreco_tab+',0)=0 THEN :PCOTAB else P2PCOTAB end as P2PCOTAB,P2DESC1,P2DESC2,P2DESC3,:DESCPED01 AS P1DESC1, :PERCDESCRAT AS P1DESC_RAT, '
                  +' (case when NVL(P2PRECO,0)=0 then :PRECO else P2PRECO end-P2VALDES) AS PRECO_CALC FROM CADP02 '
                  +' WHERE P2CHAVE=:CHAVE and P2LOTSEQ=:LOTSEQ and P2ORDEM=:ORDEM ');



    if (ptipo<>'G') then
       begin
       query_desc.SQL.add(' and P2CODPRO=-1111111');
       end;


    if mlib_mPDescLib>DM4.Tb_Par01PDESCMP0.asfloat then
       begin
       query_desc.parambyname('DESCMAXLIB').Asfloat:=mlib_mPDescLib+0.10;
       mMaiorPermitido:=mlib_mPDescLib+0.10;
       end
    else
       begin
       query_desc.parambyname('DESCMAXLIB').Asfloat:=IIF(mUsr_DescMax>0,mUsr_DescMax, DM4.Tb_Par01PDESCMP0.asfloat)+0.10;
       mMaiorPermitido                            :=IIF(mUsr_DescMax>0,mUsr_DescMax, DM4.Tb_Par01PDESCMP0.asfloat)+0.10;
       end;

   end;


  mPrecoPromo:=0;
if (ptipo='A') or (ptipo='I') then
   begin
   query_desc.Sql.add(' union all  '
                    +' SELECT :CODPRO AS P2CODPRO,'+mudaVP(Tb_Ped02_preP2PERCDESC_AUT.AsString)+' AS P2PERCDESC_AUT,:PRECO AS P2PRECO,:PCOTAB AS P2PCOTAB,:DESC1 AS P2DESC1,'
                    +' :DESC2 AS P2DESC2,:DESC3 AS P2DESC3,:DESCPED01 AS P1DESC1, :PERCDESCRAT AS P1DESC_RAT, '
                    +' (:PRECO - :VALDESITEM) AS PRECO_CALC FROM DUAL ');
   query_desc.parambyname('CODPRO').Asfloat:=Tb_Ped02_preP2CODPRO.AsFloat;
   if cb_tppco.ItemIndex=3 then
      begin
      query_desc.parambyname('DESC1').Asfloat     :=0;
      query_desc.parambyname('DESC2').Asfloat     :=0;
      query_desc.parambyname('DESC3').Asfloat     :=0;
      query_desc.parambyname('VALDESITEM').Asfloat:=0;
      end
   else
      begin
      query_desc.parambyname('DESC1').Asfloat:=Tb_Ped02_preP2DESC_PERC01.AsFloat;
      query_desc.parambyname('DESC2').Asfloat:=Tb_Ped02_preP2DESC_PERC02.AsFloat;
      query_desc.parambyname('DESC3').Asfloat:=Tb_Ped02_preP2DESC_PERC03.AsFloat;
      query_desc.parambyname('VALDESITEM').Asfloat:=Tb_Ped02_preP2VALDES.AsFloat;
      end;


   query_promo:=TQuery.Create(nil);
   query_promo.databasename:='SG_ASSOC';
   query_promo.SQL.Add('select PPPCOVDA -( (PPPCOVDA*(PPDESC_1)/100) +  '
                      +' ( (PPPCOVDA-(PPPCOVDA*(PPDESC_1)/100)) *(PPDESC_2)/100) '
                      +' +  ( PPPCOVDA -  ( (PPPCOVDA*(PPDESC_1)/100)+ '
                      +' (( (PPPCOVDA-(PPPCOVDA*(PPDESC_1)/100)) *(PPDESC_2)/100)))) * PPDESC_3/100 '
                      +') AS PCOLIQ ,(PPPCOVDA*(PPDESC_1)/100) AS D1 '
                      +', ( (PPPCOVDA-(PPPCOVDA*(PPDESC_1)/100)) *(PPDESC_2)/100) AS D2 '
                      +', ( PPPCOVDA -  ( (PPPCOVDA*(PPDESC_1)/100)+ '
                      +' (( (PPPCOVDA-(PPPCOVDA*(PPDESC_1)/100)) *(PPDESC_2)/100)))) * PPDESC_3/100 AS D3 '
                      +' , teste.* from '
                      +' (Select PPDATINI,PPDATFIN , CASE WHEN PPPCOVDA>0 THEN PPPCOVDA '
                      +' else :PCOTAB end as PPPCOVDA,PPDESC_1, PPDESC_2, PPDESC_3 from CADPPR '
                      +' where ppcodpro=:CODPRO '
                      +' and  (PPDATINI is null or PPDATINI<=to_date(sysdate) ) '
                      +' and  (PPDATFIN is null or PPDATFIN>=to_date(sysdate) ) '
                      +' and ( nvl(PPCODCLI,0)=0 OR PPCODCLI=:CODCLI) '
                      +' and ( nvl(PPCODREG,0)=0 OR PPCODREG=:CODREG) '
                      +' and ( nvl(PPCODRED,0)=0 OR PPCODRED=:CODRED) '
                      +' and ( length(nvl(PPUF,'+quotedstr(' ')+'))<>2 OR PPUF=:UF) '
                      +' and ( NVL(PPQTDMIN,0)=0 OR PPQTDMIN>=:QTDMIN ) '

                      +') teste ');
   if Tb_Ped02_preP2PRECO_TAB.AsFloat=0 then
      query_promo.Parambyname('PCOTAB').asfloat:=Tb_Ped02_preP2PRECO.AsFloat
   else
      query_promo.Parambyname('PCOTAB').asfloat:=Tb_Ped02_preP2PRECO_TAB.AsFloat;
   query_promo.Parambyname('CODPRO').asfloat:=Tb_Ped02_preP2CODPRO.AsFloat;
   query_promo.Parambyname('CODCLI').asfloat:= mVenda_GP.mPed1_CodCli;
   query_promo.Parambyname('CODRED').asfloat:= mPed_Cli_codred;
   query_promo.Parambyname('CODREG').asfloat:= mPed_Cli_CRota;
   query_promo.Parambyname('UF').asstring:=  mPed_UF_Cli;
   query_promo.Parambyname('QTDMIN').asfloat:=  Tb_Ped02_preP2QTD.asfloat;

//    ex_erroSql_Novo(query_promo,111,'func Erro:' ,'CADEST');
//      ldcnow
   try
      query_promo.OPen;
   except on e : exception do
      ex_erroSql_Novo(query_promo,111,'func Erro:'+e.Message ,'CADEST');
      end;
   mPrecoPromo:=query_promo.fieldbyname('PCOLIQ').Asfloat;
   freeandnil(query_promo);
   end;
query_desc.parambyname('PRECO_PROMO').Asfloat:=mPrecoPromo;
query_desc.parambyname('DESCPED01').Asfloat:=valfloat(edt_pDesc01.text);
mPrecoAbaixoPromocao := false;

// LINDOMAR
{
if musr_descmax_master>mMaiorpermitido then
   mMaiorPermitido:=musr_descmax_master;
}
query_desc.Sql.add(') ');
query_desc.Sql.add(') ');
query_desc.Sql.add(') ');
query_desc.Sql.add(') ');
query_desc.Sql.add(') ');
query_desc.Sql.add(') ');
query_desc.Sql.add('),CADPRO,CADGRU,CADFP WHERE  GRCODGRU(+)=PDCODGRU AND PDCODPRO=P2CODPRO AND FPCODIGO(+) = '+
iif(trim(edt_codfp.Text  )='','0',edt_codfp.Text));

query_desc.Sql.add(') where (DESC_MEDIO>DESCMAX) OR (PRECO_PROMO>0 AND PRECO_CALC<PRECO_PROMO)  ');
if valfloat(edt_desc_valor.text)>0 then
   mdescRat:=(valfloat(edt_desc_valor.text)*100) / valfloat(edt_totProdServ.Text)
else
   mdescRat:=0;

 query_desc.ParamByName('PERCDESCRAT').Asfloat:=mdescrat;
query_desc.ParamByName('LOTSEQ').Asfloat     :=mvenda_GP.mPed1_chave_ano;
query_desc.ParamByName('CHAVE').Asfloat      :=mvenda_GP.mPed1_chave;
query_desc.ParamByName('ORDEM').Asfloat      :=01;
query_desc.parambyname('PRECO').Asfloat:=Tb_Ped02_preP2PRECO.AsFloat;


//query_promo.open;

if mPrecoPromo>0 then
   query_desc.parambyname('PCOTAB').Asfloat:=mPrecoPromo
else if Tb_Ped02_preP2PRECO_TAB.AsFloat=0 then
   query_desc.parambyname('PCOTAB').Asfloat:=Tb_Ped02_preP2PRECO.AsFloat
else
   query_desc.parambyname('PCOTAB').Asfloat:=Tb_Ped02_preP2PRECO_TAB.AsFloat;

//Query_desc.sql.savetofile(mpastatemp +'sql.txt');


// ex_erroSql_Novo(query_desc,25927,'func Erro:' ,'CADP02');

try
   query_desc.open;
   if query_desc.IsEmpty =false then
      begin
      result:=true;
      mMaiorDesconto:=0;
      while not query_desc.eof do
         begin
          mMaiorPermitido := query_desc.fieldbyname('DESCMAX').asfloat;
         if query_desc.fieldbyname('DESC_MEDIO').asfloat>mMaiorDesconto then
            mMaiorDesconto:=query_desc.fieldbyname('DESC_MEDIO').asfloat;
         if query_desc.fieldbyname('DESCMAX').asfloat>mMaiorPermitido then
            mMaiorPermitido:=query_desc.fieldbyname('DESCMAX').asfloat;
         if (pTipo<>'G') and (Tb_Ped02_preP2PERCDESC_AUT.AsFloat>mMaiorPermitido) then
            mMaiorPermitido:=Tb_Ped02_preP2PERCDESC_AUT.AsFloat;

         if (query_desc.fieldbyname('PRECO_CALC').asfloat<query_desc.fieldbyname('PRECO_PROMO').asfloat) then
            mPrecoAbaixoPromocao := true;
         query_desc.next;
         end;
//      if (mMaiorDesconto>mlib_mPDescLib) and (mMaiorDesconto>mUsr_DescMax) and (mMaiorDesconto>mMaiorPermitido) then
      if (mMaiorDesconto>mlib_mPDescLib) and (mMaiorDesconto>mUsr_DescMax) and (mMaiorDesconto>mMaiorPermitido) and (cb_tppco.ItemIndex<4) then
         begin
          mValidarSenha.pTipo:=iif(DM1.Tb_PargerPGRAVPEDBLOQ.asinteger=0,0,1);
          mValidarSenha.pCodusr:=codusr;
          mValidarSenha.pCodSen:=2;
          mValidarSenha.pCodEmp:=0;
          mValidarSenha.pCodCli:=mPed_Cli_CodCli;
          mValidarSenha.pCodEmp:=codemp;
          mValidarSenha.pLotSeq:=ls_numped;
          mValidarSenha.pChave :=mVenda_GP.mped1_Chave;
          mValidarSenha.pOrdem :=1;
          mValidarSenha.pTexto :='% Desconto maior que o permitido L157.'+#13
                                                                                +'Desconto do Pedido: '+FormatFloat(mcasaspu, mMaiorDesconto)+#13
                                                                                +'Máximo Permitido: '+FormatFloat(mcasaspu, mMaiorPermitido)+#13
                                                                                +'Para continuar digite a senha '+#13
                                                                                +' Chave do Pedido '+FloatTostr(mVenda_GP.mped1_Chave);
          mValidarSenha.pChave_St:='';
          mValidarSenha.pDesc_requisitado :=mMaiorDesconto;
          mPd_CodResp_Senha:=fValidaSenha(mValidarSenha);
         if mPd_CodResp_Senha = 0 then
            begin
            mVenda_GP.mPed1_codusr_lbloq   := codusr;
            mVenda_GP.mPed1_codbloq        := fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq,'20');
            mVenda_GP.mPed1_codbloq_lib    := fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq_lib,'20');
            if (ptipo='G') then
               begin
               if mMaiorDesconto>mlib_mPDescLib then
                  mlib_mPDescLib      := mMaiorDesconto;
               mlib_mPDescLib_Usr  := codusr;
               end
            else
               begin
               if mMaiorDesconto>Tb_Ped02_preP2PERCDESC_AUT.AsFloat then
                  begin
  {                if Tb_Ped02_pre.active then
                     mcinst:=' 27983 tabela de pedido ativa '
                  else
                     mcinst:=' 27983 tabela de pedido fechada  ';
                  if Tb_Ped02_pre.State in [dsedit,dsinsert] then
                     mcinst:=mcinst+' tabela de pedido em edicao '
                  else
                     mcinst:=mcinst+' tabela de pedido NAO EDITANDO ';
  }

                  if (Tb_Ped02_pre.Active) then
                     begin
                     if Tb_Ped02_pre.State in [dsedit,dsinsert] then
                        begin
                        Tb_Ped02_preP2PERCDESC_AUT.AsFloat:=mMaiorDesconto;
                        Tb_Ped02_preP2PERCDESC_AUT_CODUSR.AsFloat:=mValidarSenha.pcodusr_lib;
                        Tb_Ped02_preP2PERCDESC_AUT_DATHOR.AsDateTime:=now();
//                        mcinst:=mcinst+' Alterou o peedido';
                        end;
                      end;
//                  ShowMessage(mcinst);
                  end;

               end;

            mlcred              := 0;
//            mlib_limcred        := True;
            result:=true;
            end
         else if mPd_CodResp_Senha = 2 then
            begin
            if (ptipo='G') then
               begin
               if mMaiorDesconto>mlib_mPDescLib then
                  mlib_mPDescLib      := mMaiorDesconto;
               end;
            mVenda_GP.mPed1_codbloq        := fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq,'20');
            mlib_bloqPend       := 2;
            result:=true;
            end
         else
            begin
            result:=false;
            end;
         end;

      if mPrecoAbaixoPromocao=true then
         begin
         mValidarSenha.pTipo:=iif(DM1.Tb_PargerPGRAVPEDBLOQ.asinteger=0,0,1);
         mValidarSenha.pCodusr:=codusr;
         mValidarSenha.pCodSen:=47;
         mValidarSenha.pCodEmp:=0;
         mValidarSenha.pCodCli:=mPed_Cli_CodCli;
         mValidarSenha.pCodEmp:=codemp;
         mValidarSenha.pLotSeq:=ls_numped;
         mValidarSenha.pChave :=mVenda_GP.mped1_Chave;
         mValidarSenha.pOrdem :=1;
         mValidarSenha.pTexto :='Preço Menor que preco da promoção'+#13
                                                                               +'Para continuar digite a senha '+#13
                                                                               +' Chave do Pedido '+FloatTostr(mVenda_GP.mped1_Chave);
         mValidarSenha.pChave_St:='';
         mValidarSenha.pDesc_requisitado :=mMaiorDesconto;
         mPd_CodResp_Senha:=fValidaSenha(mValidarSenha);
         if mPd_CodResp_Senha = 0 then
            begin
            result:=true;
            end
         else if mPd_CodResp_Senha = 2 then
            begin
            if (ptipo='G') then
               begin
               if mMaiorDesconto>mlib_mPDescLib then
                  mlib_mPDescLib      := mMaiorDesconto;
               end;
            mVenda_GP.mPed1_codbloq        := fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq,'47');
            mlib_bloqPend       := 2;
            result:=true;
            end
         else
            begin
            result:=false;
            end;
         end;

      end;
except on e : exception do
   begin
   ex_erroSql_Novo(query_desc,25927,'func Erro:'+e.Message ,'CADP02');
   result:=false;
   end;
   end;
//ex_erroSql_Novo(query_desc,25927,'func Erro:' ,'CADP02');

if mPrecoPromo>0 then
   pPrecoTab:=mPrecoPromo
else if Tb_Ped02_preP2PRECO_TAB.AsFloat=0 then
   pPrecoTab:=Tb_Ped02_preP2PRECO.AsFloat
else
   pPrecoTab:=Tb_Ped02_preP2PRECO_TAB.AsFloat;

freeandnil(query_desc);
end;


