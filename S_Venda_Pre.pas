function tFrm_Venda_Pre.fSituacaoCredito: Boolean;
begin
result:=true;
if mlocalizando_pedido then
   exit;

if ((Copy(edt_codCondPag.Text,1,2)='AV') and (mped1_tpPed<>9))
    or ( mCodCli_Analisado=fsonumero(edt_codcli.Text))
    or ( mped1_tpPed<1)
    or (mlimite_credito_jaLiberado>0) then
   begin
   result:=true;
   exit;
   end;

if fsonumero(edt_codcli.Text)<>DM1.Tb_CliCCODCLI.AsFloat then
   flcadcli(1,0,edt_codcli.Text);

if (DM1.Tb_PargerPVERCRE.Value=1) and (DM1.Tb_CliCCODCLI.AsInteger>2) then
   begin

   mCodCli_Analisado:=DM1.Tb_CliCCODCLI.AsFloat;

   if form_SitCre_ped_02=nil then
      Application.CreateForm(Tfrm_SitCre, form_SitCre_ped_02)
   else
      begin
      form_SitCre_ped_02.free;
      form_SitCre_ped_02:=nil;
      Application.CreateForm(Tfrm_SitCre, form_SitCre_ped_02)
      end;




   if ((Copy(edt_codCondPag.Text,1,2)='AV') or (mped1_tpPed<1)) then
      begin
      form_SitCre_ped_02.mlcred_este_pedido_chave := 0;
      form_SitCre_ped_02.mlcred_este_pedido_Valor := 0;
      end
   else
      begin
      form_SitCre_ped_02.mlcred_este_pedido_chave := mVenda_GP.mped1_Chave;
      form_SitCre_ped_02.mlcred_este_pedido_Valor := mVenda_GP.mPed1_Totall;
      end;




//mlcred_este_pedido_valor := m
   form_SitCre_ped_02.CODCLI.Text:=Trim(edt_codcli.Text);
   form_SitCre_ped_02.BBAPLICAR.Click;
   form_Sitcre_ped_02.FormStyle:=fsNormal;
   form_sitcre_ped_02.Visible:=false;
   fAtualizaForm(0);
   form_SitCre_ped_02.ShowModal;
   if form_SitCre_ped_02.mlimcre=0 then
      mlcred:=form_SitCre_ped_02.mLimCre
   else
      mlcred:=form_SitCre_ped_02.mLimCre-form_SitCre_ped_02.mTotDeb;
   mlimite_credito_cliente:=mlcred;
   mlcred_este_pedido := form_SitCre_ped_02.mlcred_este_pedido;

   mlimite_credito_jausado :=form_SitCre_ped_02.mTotDeb-(mlcred_este_pedido);
//   if (form_SitCre_ped_02.msit)  and (not mlib_limcred)then
   if (form_SitCre_ped_02.msit)  then
      begin
//      mlib_limcred  :=False;
      mValidarSenha.pTipo:=0;
      mValidarSenha.pTipo:=iif(DM1.Tb_PargerPGRAVPEDBLOQ.asinteger=0,0,1);
      mValidarSenha.pCodusr:=codusr;
      mValidarSenha.pCodSen:=17;
      mValidarSenha.pCodEmp:=0;
      mValidarSenha.pCodCli:=DM1.Tb_CliCCODCLI.Value;
      mValidarSenha.pCodEmp:=codemp;
      mValidarSenha.pLotSeq:=ls_numped;
       mValidarSenha.pChave :=mVenda_GP.mped1_Chave;
      mValidarSenha.pOrdem :=1;
      mValidarSenha.pTexto :='Cliente: '+
      DM1.Tb_CliCRAZAO.Asstring +'-'+DM1.Tb_CliCCODCLI.Asstring+' com venda Bloqueado. Para liberar digite a senha'
      +' Chave do Pedido '+FloatTostr(mVenda_GP.mped1_Chave);

      mValidarSenha.pChave_St:='';
      mValidarSenha.pDesc_requisitado :=0;

      mPd_CodResp_Senha:=fValidaSenha(mValidarSenha);
      if mPd_CodResp_Senha=0 then
         begin
         mVenda_GP.mPed1_codusr_lbloq :=codusr;
         mVenda_GP.mPed1_codbloq      :=fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq,'02');
         mVenda_GP.mPed1_codbloq_lib  :=fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq_lib,'02');
         mlcred:=0;
         mlimite_credito_jaLiberado := mVenda_GP.mPed1_Totall;
//            if (form_SitCre_ped_02.msit)  and (not mlib_limcred)then

//         mlib_limcred      :=true;
         end
      else if mPd_CodResp_Senha=2 then
         begin
         mVenda_GP.mPed1_bloqPend     :=2;
         if form_SitCre_ped_02.mBloq_LimCred then
            mVenda_GP.mPed1_codbloq      :=fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq,'01');
         if form_SitCre_ped_02.mBloq_Atraso then
            mVenda_GP.mPed1_codbloq      :=fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq,'02');
         if (form_SitCre_ped_02.mBloq_Status9) or (form_SitCre_ped_02.mBloq_Cadastro) then
            mVenda_GP.mPed1_codbloq      :=fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq,'11');
         if (form_SitCre_ped_02.mBloq_SemCompra)  then
            mVenda_GP.mPed1_codbloq      :=fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq,'12');
         end
      else
         begin
         mCodCli_Analisado   :=0;
         result:=False;
         exit;
         end;
      end;
   form_SitCre_ped_02.Free;
   form_SitCre_ped_02:=nil;
   end;
end;



