         mVenda_GP.mPed1_Perc_Frete:=DM1.Query2.FieldByName('P1VALFRE').AsFloat/(DM1.Query2.FieldByName('P1TOTALB').AsFloat
                                      +DM1.Query2.FieldByName('TARBAN_001').AsFloat
