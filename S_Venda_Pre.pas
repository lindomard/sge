function tFrm_Venda_pre.fAjustarIRRFISLL: boolean;
var
query_ncm: tQuery;
begin
Tb_Ped02_preP2IRRF_PERC.Value:=0;
Tb_Ped02_preP2CSLL_PERC.Value:=0;

if mPed_Cli_CTIPCLI>0 then
   begin
   query_ncm := tQuery.create(nil);
   query_ncm.DatabaseName := DM1.SG_ASSOC.Databasename;
   query_ncm.close;
   query_ncm.sql.clear;
   query_ncm.sql.add('SELECT PDCLAS, CIPERC_CSLL,CIPERC_IRRF FROM CADPRO '
                    +',CADCLATABICM '
                    +' WHERE PDCODPRO='+Tb_Ped02_preP2CODPRO.AsString
                    +' AND CICLASSIF=PDCLAS ');
   try
      query_ncm.Open;
   except on e : exception do
      begin
      ex_erroSql_Novo(Query_ncm,12481,'venda_pre'+e.Message,'CADP01');
      query_ncm.close;
      freeandNil(query_ncm);
      result:=false;
      exit;
      end;
      end;
   if fSonumero(query_ncm.FieldByName('PDCLAS').AsString)>0 then
      begin
      Tb_Ped02_preP2IRRF_PERC.Value:=query_ncm.fieldbyname('CIPERC_IRRF').asfloat;
      Tb_Ped02_preP2CSLL_PERC.Value:=query_ncm.fieldbyname('CIPERC_CSLL').asfloat;
      end;
   query_ncm.close;
   freeandnil(query_ncm);
   end;
end;


function tFrm_Venda_Pre.fSomaQtdDev(pCodpro: Real): Real;
var
mQtdDev:Real;
mPos_ItemDev: TBookmark;
begin
if cb_naoverifica.checked=true then
   begin
   result:=0;
   exit;
   end;
mPos_ItemDev:=Qr_itens_pedori.GetBookmark;
Qr_Itens_pedOri.first;
mQtdDev:=0;
While not Qr_Itens_PedOri.Eof do
   begin
   if pCodpro=Qr_Itens_PedoriPDCODPRO.Asfloat then
      mQtdDev:=mQtdDev+Qr_itens_pedoriP2QTD.AsFloat-Qr_itens_pedoriP2QTDDEV.AsFloat;
   Qr_Itens_PedOri.Next;

   end;
Qr_itens_pedori.GotoBookmark(mPos_ItemDev);

result:=mQtdDev;
end;
function tFrm_Venda_Pre.fFoiDigitado(ptipo: integer): Boolean;
var
Query_Cons: TQuery;
mCodigo_dig: Real;
mAmbiente_dig: String;
mQtd_Nova: Real;
begin
if (DM1.Tb_PargerPFATDPRO.AsInteger = 2) and (cb_leitor.Checked=false) then
   begin
   result:=false;
   exit;
   end;
result:=false;


Query_Cons:=TQuery.Create(nil);
Query_Cons.DatabaseName:='SG_ASSOC';
Query_Cons.close;
Query_Cons.SQL.clear;
Query_Cons.SQL.Add('Select count(*) from CADP02 where P2CHAVE=:CHAVE '
               +' and (P2CODEMP=:CODEMP or P2CODEMP=:CODEMP_FILIAL) '
               +' and P2ORDEM=:ORDEM '
               +' and P2LOTSEQ=:LOTSEQ '
               +' and P2CODPRO=:CODPRO ');
if trim(Tb_Ped02_preP2AMBIENTE.AsString)<>'' then
  Query_Cons.SQL.Add(' and P2AMBIENTE=:AMBIENTE ');

Query_Cons.SQL.Add(' group by P2AMBIENTE ');
Query_Cons.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
Query_Cons.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp_ini;
Query_Cons.ParamByName('CODEMP_FILIAL').AsInteger:=mVenda_GP.mPed1_Codemp_fin;
Query_Cons.ParamByName('ORDEM').AsInteger:=01;
Query_Cons.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
Query_Cons.ParamByName('CODPRO').AsFloat:=ValFloat(Tb_Ped02_preP2CODPRO.AsString);
if trim(Tb_Ped02_preP2AMBIENTE.AsString)<>'' then
  Query_Cons.ParamByName('AMBIENTE').AsString:=Tb_Ped02_preP2AMBIENTE.AsString;
try
   Query_Cons.Open;
except
   end;
if Query_Cons.Fields[0].AsInteger>0 then
  begin
  mQtd_Nova:=Tb_Ped02_preP2QTD.AsFloat;
  result:=true;
  mCodigo_dig:=ValFloat(Tb_Ped02_preP2CODPRO.AsString);
  mAmbiente_dig:=Tb_Ped02_preP2AMBIENTE.AsString;
  freeandnil(Query_Cons);
  DBGrid_itens.SelectedField:=tb_ped02_preP2CODPRO;
  if sbnGravar.enabled then
     DBGrid_itens.SetFocus;
  if (cb_leitor.Checked=true) or (DM1.Tb_PargerPFATDPRO.AsInteger=1) then
    begin
    if (cb_leitor.Checked=true) or (Application.MessageBox('Produto Ja Digitado Neste Pedido, deseja altera-lo?','Confirmação',MB_YESNO+MB_DEFBUTTON1)=mrYes) then
      begin
      Tb_Ped02_pre.Cancel;
      if Tb_Ped02_pre.Locate('P2CODPRO;P2AMBIENTE',vararrayof([mCodigo_dig,mAmbiente_dig]),[]) then
        begin
        if cb_leitor.Checked then
           mQtd_Acum:=Tb_Ped02_preP2QTD.AsFloat;

        Tb_Ped02_pre.Edit;
        if mQtd_Nova<>0 then
           Tb_Ped02_preP2QTD.AsFloat:=mQtd_Nova;
        end;
      end;
    Result:=False;
    end
  else if  (DM1.Tb_PargerPFATDPRO.AsInteger=0) then
    begin
    if (cb_leitor.Checked<>true) then
       ShowMessage('Produto já digitado');
    Tb_Ped02_pre.Cancel;
    Tb_Ped02_pre.Locate('P2CODPRO;P2AMBIENTE',vararrayof([mCodigo_dig,mAmbiente_dig]),[]);
    Tb_Ped02_pre.Edit;
    result:=false;
    end;
  end;
FreeandNil(Query_cons);

end;

