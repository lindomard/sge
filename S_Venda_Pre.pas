  mFator : Real;
  mDif   : Real;
  mTotGer: Real;
  mTotAcre: Real;
  mTotalNovo: Real;
  query_ratear: TQuery;
  mChave_Old: Integer;
  mItemDif: Integer;
begin
if (mVenda_GP.mped1_Chave>0) and (ce_TotAddExt.Value<>0) then
   begin
   query_ratear:=TQuery.Create(nil);
   query_ratear.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
   query_ratear.sql.Clear;
   query_ratear.sql.add('Select sum(NVL(P2TOTLIQ,round(P2QTD*P2PRECO,2))) as totmer from CADP02 WHERE '
                       +'      P2CODEMP=:CODEMP '
                       +'  and P2CHAVE=:CHAVE '
                       +'  and P2LOTSEQ=:CHAVE_ANO '
                       +' and (P2SITUACAO<>1 OR P2SITUACAO is null)') ;
    query_ratear.ParamByName('CODEMP').AsInteger  :=mVenda_GP.mPed1_Codemp;
    query_ratear.ParamByName('CHAVE').AsFloat     :=mVenda_GP.mped1_Chave;
    query_ratear.ParamByName('CHAVE_ANO').AsFloat :=mVenda_GP.mPed1_Chave_ano;
    try
       query_ratear.Open;
   except on e : exception do
      begin
      ex_erroSql_Novo(query_ratear,242522,'func Erro:'+e.Message ,'CADP02');
      query_ratear.Close;
      freeandnil(query_ratear);
      exit;
      end;
      end;
    mTotAcre:=ce_TotAddExt.Value;
    mTotalNovo:=query_ratear.fieldbyname('TOTMER').AsFloat+mTotAcre;
    mTotGer:=query_ratear.fieldbyname('TOTMER').AsFloat;
    if mTotGer>0 then
       begin
       mFator:=mTotAcre*100 / mTotGer;
       if mFator<>0 then
          begin
          mChave_Old:=
          fGerarOld(8,mVenda_gp.mPed1_Codemp_ini,mVenda_gp.mPed1_Codemp_fin,mVenda_GP.mped1_Chave,mVenda_GP.mPed1_Chave_ano);

          if mChave_Old<>0 then
             begin
             if not flfilpad(-9,'_VENDA_PRE','VALDIC_'+Formatfloat('000000', mVenda_GP.mped1_Chave)) then
                fDeletaPadroes(-9,'_VENDA_PRE','VALDIC_'+Formatfloat('000000', mVenda_GP.mped1_Chave));
             query_ratear.close;
             query_ratear.SQL.Clear;
             query_ratear.SQL.Add('Update cadp02 set P2PRECO= TRUNC ( ('
                                 +'  TRUNC(  (P2TOTLIQ +   (P2TOTLIQ-(NVL(P2ICMSR,0)+NVL(P2VFRERAT,0)+NVL(P2IMP_IMP_VDESDPADU,0)+NVL(P2VDESPACESRAT,0)) '
                                 +'+(P2TOTDES)) *  :PERC /100) ,'+IntToStr(iif(mVenda_GP.mPed1_QtdDec>0,mVenda_GP.mPed1_QtdDec,DM1.Tb_PargerPCASASPU.AsInteger))+')'
                                 +' / P2QTD) '
                                 +','+IntToStr(iif(mVenda_GP.mPed1_QtdDec>0,mVenda_GP.mPed1_QtdDec,DM1.Tb_PargerPCASASPU.AsInteger))+')'
                                 +' where P2CHAVE=:CHAVE and P2LOTSEQ=:LOTSEQ and P2CODEMP=:CODEMP ');
             query_ratear.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
             query_ratear.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
             query_ratear.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp;
             query_ratear.ParamByName('PERC').AsFloat    :=mFator;

             try
                 query_ratear.ExecSQL;
                 fdm1StartCommit;
             except on e : exception do
                begin
                ex_erroSql_Novo(query_ratear,24270,'func Erro:'+e.Message ,'CADP02');
                query_ratear.Close;
                freeandnil(query_ratear);
                exit;
                end;
                end;
             fSoRecalcular(0);
             // novo calculo


             query_ratear.Close;
             query_ratear.sql.Clear;
             query_ratear.sql.add('Select sum(NVL(P2TOTLIQ,round(P2QTD*P2PRECO,2))) as totmer from CADP02 WHERE '
                                 +'      P2CODEMP=:CODEMP '
                                 +'  and P2CHAVE=:CHAVE '
                                 +'  and P2LOTSEQ=:CHAVE_ANO '
                                 +' and (P2SITUACAO<>1 OR P2SITUACAO is null)') ;
              query_ratear.ParamByName('CODEMP').AsInteger  :=mVenda_GP.mPed1_Codemp;
              query_ratear.ParamByName('CHAVE').AsFloat     :=mVenda_GP.mped1_Chave;
              query_ratear.ParamByName('CHAVE_ANO').AsFloat :=mVenda_GP.mPed1_Chave_ano;
              try
                 query_ratear.Open;
             except on e : exception do
                begin
                ex_erroSql_Novo(query_ratear,242522,'func Erro:'+e.Message ,'CADP02');
                query_ratear.Close;
                freeandnil(query_ratear);
                exit;
                end;
                end;
             mDif:=mTotalNovo-query_ratear.fieldbyname('TOTMER').AsFloat;
             if mDif<>0 then
                begin

                query_ratear.Close;
                query_ratear.sql.Clear;
                query_ratear.sql.add('Select sum(NVL(P2TOTLIQ,round(P2QTD*P2PRECO,2))) as totmer,P2QTD,P2ITEM from CADP02 WHERE '
                                    +'      P2CODEMP=:CODEMP '
                                    +'  and P2CHAVE=:CHAVE '
                                    +'  and P2LOTSEQ=:CHAVE_ANO '
                                    +' and (P2SITUACAO<>1 OR P2SITUACAO is null)'
                                    +' group by P2QTD,P2ITEM '
                                    +' order by P2QTD,totmer desc '
                                    ) ;
                 query_ratear.ParamByName('CODEMP').AsInteger  :=mVenda_GP.mPed1_Codemp;
                 query_ratear.ParamByName('CHAVE').AsFloat     :=mVenda_GP.mped1_Chave;
                 query_ratear.ParamByName('CHAVE_ANO').AsFloat :=mVenda_GP.mPed1_Chave_ano;
                 try
                    query_ratear.Open;
                except on e : exception do
                   begin
                   ex_erroSql_Novo(query_ratear,242522,'func Erro:'+e.Message ,'CADP02');
                   query_ratear.Close;
                   freeandnil(query_ratear);
                   exit;
                   end;
                   end;
                mItemDif:=query_ratear.fieldbyname('P2ITEM').AsInteger;


                query_ratear.close;
                query_ratear.SQL.Clear;
                query_ratear.SQL.Add('Update cadp02 set P2PRECO= TRUNC ( ('
                                    +'  TRUNC(  (P2TOTLIQ - (NVL(P2ICMSR,0)+NVL(P2VFRERAT,0)+NVL(P2IMP_IMP_VDESDPADU,0)+NVL(P2VDESPACESRAT,0)) '
                                    +'+(P2TOTDES + :VALDIF))  ,'+IntToStr(iif(mVenda_GP.mPed1_QtdDec>0,mVenda_GP.mPed1_QtdDec,DM1.Tb_PargerPCASASPU.AsInteger))+')'
                                    +' / P2QTD) '
                                    +','+IntToStr(iif(mVenda_GP.mPed1_QtdDec>0,mVenda_GP.mPed1_QtdDec,DM1.Tb_PargerPCASASPU.AsInteger))+')'
                                    +' where P2CHAVE=:CHAVE and P2LOTSEQ=:LOTSEQ and P2CODEMP=:CODEMP and P2ITEM=:ITEM');
                query_ratear.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
                query_ratear.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
                query_ratear.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp;
                query_ratear.ParamByName('VALDIF').AsFloat  :=mDif;
                query_ratear.ParamByName('ITEM').AsInteger  :=mItemDif;

                try
                    query_ratear.ExecSQL;
                    fdm1StartCommit;
                except on e : exception do
                   begin
                   ex_erroSql_Novo(query_ratear,24270,'func Erro:'+e.Message ,'CADP02');
                   query_ratear.Close;
                   freeandnil(query_ratear);
                   exit;
                   end;
                   end;
                fSoRecalcular(0);
                // novo calculo
                end;

             if not flfilpad(-9,'_VENDA_PRE','VALDIC_'+Formatfloat('000000', mVenda_GP.mped1_Chave)) then
                fGravaPadroes(-9,'VALDIC_'+Formatfloat('000000', mVenda_GP.mped1_Chave)    ,'text'   ,'_VENDA_PRE',inttostr(mChave_Old));
             fBloqueiaLiberaPedido(0);
             fLerPedidoGeral(codemp,valint(edt_chave.Text),0);

             sbnAlterarClick(self);
             end;
          end;

       end;

    query_ratear.close;
    freeandnil(query_ratear);
    end;

end;

