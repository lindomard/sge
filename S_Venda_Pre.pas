function tFrm_Venda_Pre.fIncluirCadp02_Lotes(pCodemp,pItem: Integer; pChave,pChave_ano,pCodPro,pQtd: Real; pLote: String; pDtFab,pDtVcto: TDateTime; pIdPed02New, pIdPed02New100: integer): Boolean;

var
Query_Ped02: TQuery;
begin
Query_Ped02:=tQuery.Create(nil);
Query_Ped02.DatabaseName:='SG_ASSOC';
Query_Ped02.Close;
Query_Ped02.SQL.Clear;


Query_Ped02.Sql.add('MERGE INTO CADP02_LOTES t1 '
                  +'  USING (SELECT '

                   +inttostr(pCodemp)+' as P2LM_CODEMP'
                   +','+inttostr(iif(pcodemp>100,pidPed02New100,pIdPed02New))+' as P2LM_ID_PED02_NEW'
                   +','+floattostr(pCodPro)+' as P2LM_CODPRO '
                   +','+Floattostr(pchave_ano)+'  as P2LM_LOTSEQ '
                   +','+Floattostr(pchave)+' as P2LM_CHAVE '
                   +','+Floattostr(pItem)+' as P2LM_ITEM  '
                   +','+quotedstr(pLote)+' as P2LM_LOTE'
                   +','+quotedstr(formatdatetime(fdt, pDtFab))+' as P2LM_DTFAB '
                   +','+quotedstr(formatdatetime(fdt, pDtVcto))+' as P2LM_DTVCTO '
                   +','+mudavp(FloatToStr(pQtd))+' as P2LM_QTD '
                   +' from dual '
                   +') ss '
                   +' ON (t1.P2LM_CODEMP = ss.P2LM_CODEMP '
                   +' AND t1.P2LM_LOTSEQ = ss.P2LM_LOTSEQ '
                   +' AND t1.P2LM_CHAVE = ss.P2LM_CHAVE '
                   +' AND t1.P2LM_ITEM = ss.P2LM_ITEM '
                   +' AND t1.P2LM_CODPRO = ss.P2LM_CODPRO '
                   +' AND NVL(t1.P2LM_LOTE,'+quotedstr('X')+') = nvl(ss.P2LM_LOTE,'+quotedstr('X')
                   +') ) '
                   +'  WHEN MATCHED THEN '
                   +'  UPDATE SET t1.P2LM_QTD = t1.P2LM_QTD + ss.P2LM_QTD '
                   +'  WHEN NOT MATCHED THEN '
                   +'  INSERT( '

                   +' t1.P2LM_ID_NEW'
                   +',t1.P2LM_ID_PED02_NEW'
                   +',t1.P2LM_CODEMP'
                   +',t1.P2LM_CODPRO'
                   +',t1.P2LM_LOTSEQ'
                   +',t1.P2LM_CHAVE '
                   +',t1.P2LM_ITEM'
                   +',t1.P2LM_LOTE'
                   +',t1.P2LM_DTFAB'
                   +',t1.P2LM_DTVCTO'
                   +',t1.P2LM_QTD'
                   +' ) '
                   +' VALUES( '
                   +' CADP02_LOTES_SEQ.NEXTVAL '
                   +',ss.P2LM_ID_PED02_NEW '
                   +',ss.P2LM_CODEMP'
                   +',ss.P2LM_CODPRO'
                   +',ss.P2LM_LOTSEQ'
                   +',ss.P2LM_CHAVE '
                   +',ss.P2LM_ITEM'
                   +',ss.P2LM_LOTE'
                   +',ss.P2LM_DTFAB'
                   +',ss.P2LM_DTVCTO'
                   +',ss.P2LM_QTD'
                   +' ) ');
{
Query_Ped02.Close;
Query_Ped02.SQL.Clear;
Query_Ped02.SQL.Add('Insert into CADP02_LOTES ('
                   +' P2LM_CODEMP '
                   +',P2LM_CODPRO '
                   +',P2LM_LOTSEQ '
                   +',P2LM_CHAVE '
                   +',P2LM_ITEM '
                   +',P2LM_LOTE '
                   +',P2LM_DTFAB '
                   +',P2LM_DTVCTO '
                   +',P2LM_QTD '
                   +') values ('
                   +' :P2LM_CODEMP '
                   +',:P2LM_CODPRO '
                   +',:P2LM_LOTSEQ '
                   +',:P2LM_CHAVE '
                   +',:P2LM_ITEM '
                   +',:P2LM_LOTE '
                   +',:P2LM_DTFAB '
                   +',:P2LM_DTVCTO '
                   +',:P2LM_QTD '
                   +') ');

Query_Ped02.ParambyName('P2LM_CODEMP').AsInteger :=pCodemp;
Query_Ped02.ParambyName('P2LM_CODPRO').AsFloat   :=pCodPro;
Query_Ped02.ParambyName('P2LM_LOTSEQ').AsFloat   :=pChave_ano;
Query_Ped02.ParambyName('P2LM_CHAVE').AsFloat    :=pChave;
Query_Ped02.ParambyName('P2LM_ITEM').AsFloat     :=pItem;
Query_Ped02.ParambyName('P2LM_LOTE').AsString    :=pLote;
Query_Ped02.ParambyName('P2LM_DTFAB').AsDateTime :=pDtFab;
Query_Ped02.ParambyName('P2LM_DTVCTO').AsDateTime:=pDtVcto;
Query_Ped02.ParambyName('P2LM_QTD').AsFloat      :=pQtd;
 }
try
   query_Ped02.execsql;
   fdm1StartCommit;
   result:=true;
except on e : exception do
   begin
   ex_erroSql_Novo(query_Ped02,15673,'func Erro:'+e.Message ,'CADP02_LOTES');
   result:=false;
   end;
   end;


end;

