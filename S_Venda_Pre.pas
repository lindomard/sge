function TFrm_Venda_Pre.fAtualizaCFOP: Boolean;
var
query_exe: TQuery;

begin
Query_Exe:=tquery.create(nil);
Query_Exe.DatabaseName:='SG_ASSOC';

Query_Exe.Close;
Query_Exe.SQL.Clear;
Query_Exe.SQL.Add('Update CADP01 set P1CFO1=(select MIN(P2CFO) from cadp02 where P2CHAVE=:CHAVE '
                 +' and P2LOTSEQ=:LOTSEQ and (P2CODEMP=:CODEMP or P2CODEMP=:CODEMP_FILIAL)) '
                 +', P1CFO2=(select MAX(P2CFO) from cadp02 where P2CHAVE=:CHAVE '
                 +' and P2LOTSEQ=:LOTSEQ and (P2CODEMP=:CODEMP or P2CODEMP=:CODEMP_FILIAL)) '

                 +' where P1CHAVE=:CHAVE '
                 +' and P1LOTSEQ=:LOTSEQ '
                 +' and (P1CODEMP=:CODEMP or P1CODEMP=:CODEMP_FILIAL )');
Query_Exe.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
Query_Exe.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
Query_Exe.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp_ini;
Query_Exe.ParamByName('CODEMP_FILIAL').AsInteger:=mVenda_GP.mPed1_Codemp_fin;
try
   Query_Exe.ExecSQL;
   fdm1startcommit;
except
   ex_erroSql_Novo(Query_Exe,13734,'frm_venda','CADP01');
   end;

freeandnil(query_exe);
result:=true;
exit;
end;
