function TFrm_Venda_Pre.fVerificaSeEPedidoDeOrigemDeDevolucao(pChave, pLotseq, pCodemp: Integer): boolean;
var
query_ori: tQuery;
form_ocorrencias: TFrm_Ocorrencias;

begin
result:=true;
query_ori:=tQuery.create(nil);
query_ori.databasename:=DM1.SG_ASSOC.databasename;
Query_ori.SQL.Clear;
Query_ori.SQL.Add('select P1CHAVE,P1LOTSEQ,P1ORDEM '
                 +',P1TIPO,P1STATUS,P1CODEMP,P1DATAP,P1TOTALL from CADP01D,CADP01 '
                 +' WHERE P1CHAVE=P1DCHAVE AND P1LOTSEQ=P1DLOTSEQ AND P1CODEMP=P1DCODEMP '
                 +' and P1DCH_OR='+inttostr(pchave)
                 +' AND P1DLS_OR='+InttoStr(pLotseq)
                 +' AND P1DCODEMP_OR='+inttostr(pCodemp)
                 +' AND P1STATUS<8 and P1TIPO<>3');
