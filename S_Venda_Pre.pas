                        +' Select '+QuotedStr('LOTES')+' AS ORIGEM , P2LM_LOTE AS CLNUMERO,'
                        +' P2LM_QTD AS CLQTD,P2LM_DTVCTO AS CLDTVCTO,P2LM_DTFAB AS CLDTFAB '
