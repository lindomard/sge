                      +', CASE WHEN MAX(P2LM_DTFAB)<'+QuotedStr('01/01/1901')+' THEN NULL ELSE MAX(P2LM_DTFAB) END  AS  P2LM_DTFAB '
                      +', CASE WHEN MAX(P2LM_DTVCTO)<'+QuotedStr('01/01/1901')+' THEN NULL ELSE MAX(P2LM_DTVCTO) END  AS  P2LM_DTVCTO '
                      +', sum(case when P2LM_CODEMP<100 THEN P2LM_QTD ELSE 0 END) as P2LM_QTD_001 '
                      +', sum(case when P2LM_CODEMP<100 THEN 0 ELSE P2LM_QTD END) as P2LM_QTD_101 '

                   +' from CADP02_LOTES '
                   +' where (P2LM_CODEMP=:CODEMP or P2LM_CODEMP=:CODEMP_FILIAL) '
                   +' and P2LM_CHAVE=:CHAVE '
                   +' and P2LM_LOTSEQ=:CHAVE_ANO '
                   +' and P2LM_ITEM=:ITEM ');

Tb_ped02_Lotes_Ant.ParamByName('ITEM').AsInteger:=pItem;

if pCodpro=0 then
   begin
   Tb_Ped02_Lotes_Ant.SQL.add(' and P2LM_CODPRO=:CODPRO ');
