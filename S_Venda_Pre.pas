// ptipo 0-inclui 1-Exclui
function TFrm_Venda_Pre.FGravarPendencias(pTipo,pItem : Integer;pCodPro,pQtdPed,pQtdEnv,pDesc01,pDesc02,pDesc03,pPreco: Real; pNome,pMarca,pUnd: String): Boolean;
begin

if DM4.Tb_Par01PGRAPEN.Value<>1 then
   begin
   result:=true;
   exit;
   end;

//              if DM4.Tb_Par01PGRAPEN.Value=1 then

if ptipo=0 then
   begin
   if Tb_Pend.Locate('PECODPRO',PCODPRO,[]) then
      Tb_Pend.Edit
   else
      Tb_Pend.Append;
   if codemp>99 then
      Tb_PendPECODEMP.Value:=100-codemp
   else
      Tb_PendPECODEMP.Value   :=codemp;
   Tb_PendPELOTSEQ.Value      :=mVenda_GP.mPed1_Chave_ano;
   Tb_PendPECHAVE.Value       :=mVenda_GP.mPed1_Chave;
   Tb_PendPECODCLI.Value      :=mVenda_GP.mPed1_CodCli;
   Tb_PendPECODVEN.Value      :=mVenda_GP.mPed1_Codven;
   Tb_PendPEITEM.Value        :=pItem;
   Tb_PendPEDATA.Value        :=mVenda_GP.mPed1_Datap;
   Tb_PendPECODPRO.Value      :=pCodpro;
   Tb_PendPEQTDPED.Value      :=pQtdPed;
   if pQtdEnv>0 then
      Tb_PendPEQTDENV.Value      :=pQtdEnv
   else
      Tb_PendPEQTDENV.Value      :=0;
   Tb_PendPDNOME.Value        :=pNome;
   Tb_PendPDMARCA.Value        :=pMarca;
   Tb_PendPDUND.Value         :=pUnd;
   Tb_PendPEQTDPEN.Value      :=Tb_PendPEQTDPED.Value-Tb_PendPEQTDENV.Value;
   Tb_PendPEDESC01.Value      :=pDesc01;
   Tb_PendPEDESC02.Value      :=pDesc02;
   Tb_PendPEDESC03.Value      :=pDesc03;
   Tb_PendPEVALDES.Value      :=0;
   Tb_PendPEPRECO.Value       :=pPreco;
   Tb_PendVALOR_TOTAL.Value   :=Tb_PendPEPRECO.AsFloat*Tb_PendPEQTDPEN.AsFloat;
   Tb_PendPE_CHAVE_NIVEL.Value:=0;
   try
      Tb_Pend.Post;
   except
      end;
   end
else
   begin
   if Tb_Pend.Locate('PECODPRO',pCODPRO,[]) then
      begin
      if (Tb_PendPEQTDENV.AsFloat+pQtdEnv)>=Tb_PendPEQTDPED.AsFloat then
         Tb_Pend.Delete
      else
         begin
         Tb_Pend.Edit;
         Tb_PendPEQTDENV.AsFloat:=Tb_PendPEQTDENV.AsFloat+pQtdEnv;
         Tb_PendPECODPRO.Value      :=pCodpro;
         Tb_PendPDNOME.Value        :=pNome;
         Tb_PendPDUND.Value         :=pUnd;
         Tb_PendPEQTDPEN.Value      :=Tb_PendPEQTDPED.Value-Tb_PendPEQTDENV.Value;
         Tb_PendVALOR_TOTAL.Value   :=Tb_PendPEPRECO.AsFloat*Tb_PendPEQTDPEN.AsFloat;
         try
            Tb_Pend.Post;
         except
            end;
         end;
      end;
   end;
result:=true;

end;



procedure TFrm_Venda_Pre.C(DataSet: TDataSet);
begin
Try
   DM1.SG_ASSOC.ApplyUpdates([DataSet as TQuery]);
   If not DM1.SG_ASSOC.InTransaction then
      DM1.SG_ASSOC.StartTransaction;
   DM1.SG_ASSOC.Commit;
Except
   fmensagem('Ja Existe um Registro igual a Este Click em Cancelar!',0,['0'],0);
   end;

end;

procedure TFrm_Venda_Pre.Tb_PendBeforePost(DataSet: TDataSet);
var
Query_Pend: TQuery;
begin
if (Tb_PendPECODPRO.AsFloat=0) then
   abort;

if (Tb_PendPEQTDPED.AsFloat=0) then
   abort;

if mVenda_GP.mped1_Chave=0 then
   begin
   mVenda_GP.mped1_submod_grav:=0;
   if mVenda_GP.mped1_submod=100 then
      begin
      mVenda_GP.mped1_submod_grav:=100;
      if codemp>100 then
         fGravarPedido(0,-100)
      else
         fGravarPedido(0,100);
      end
   else
      begin
      if mVenda_GP.mped1_submod>0 then
         mVenda_GP.mped1_submod_grav:=100-mVenda_GP.mped1_submod;
      fGravarPedido(0,0);
      end;
   edt_chave.Text:=InttoStr(mVenda_GP.mped1_Chave);
   if (mVenda_GP.mped1_submod>0) and (mVenda_GP.mped1_submod<100) then
      begin
      mVenda_GP.mped1_submod_grav:=mVenda_GP.mped1_submod;
      if codemp>100 then
         fGravarPedido(0,-100)
      else
         fGravarPedido(0,100);
      end;
   end;

if (mCodpro_pend_Ant=0) or (Tb_PendPECODPRO.AsFloat<>mCodpro_pend_Ant)  then
   begin
   Query_Pend:=TQuery.Create(nil);
   Query_Pend.DatabaseName:='SG_ASSOC';
   Query_Pend.close;
   Query_Pend.SQL.clear;
   Query_Pend.SQL.Add('Select count(*) from CADPEN where PECHAVE=:CHAVE and '
                      +' PECODEMP=:CODEMP and PELOTSEQ=:CHAVE_ANO '
                      +' and PECODPRO=:CODPRO ');
   Query_Pend.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
   Query_Pend.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp_ini;
   Query_Pend.ParamByName('CHAVE_ANO').AsInteger:=mVenda_GP.mPed1_Chave_ano;
   Query_Pend.ParamByName('CODPRO').AsFloat:=Tb_PendPECODPRO.AsFloat;
   try
      Query_Pend.Open;
      if Query_Pend.Fields[0].AsInteger>0 then
         begin
         verteclado(0);
         MessageDlg('Produto Ja Esta Digitado!',mtWarning,[mbOk],0);
         FreeAndNil(query_pend);
         abort;
         end;
    except on e : exception do
       begin
       ex_erroSql_Novo(Query_Pend,19119,'SGE','CADPEN');
       end;
       end;
   FreeAndNil(query_pend);
   end;
if codemp>100 then
   Tb_PendPECODEMP.Value:=codemp-100
else
   Tb_PendPECODEMP.Value:=codemp;
Tb_PendPELOTSEQ.Value:=mVenda_GP.mPed1_Chave_ano;
Tb_PendPECHAVE.Value:=mVenda_GP.mPed1_Chave;
Tb_PendPECHAVE.Value:=mVenda_GP.mPed1_Chave;

Tb_PendPEID_PED01_NEW.Value      :=IIF( mVenda_GP.mPed1_id_new_000>0,mVenda_GP.mPed1_id_new_000,mVenda_GP.mPed1_id_new_100);


Tb_PendPECODVEN.Value:=mVenda_GP.mPed1_Codven;
Tb_PendPEDATA.Value:=mVenda_GP.mPed1_Datap;
if Tb_PendPEQTDENV.AsFloat>Tb_PendPEQTDPED.AsFloat then
   Tb_PendPEQTDENV.AsFloat:=Tb_PendPEQTDPED.AsFloat;
Tb_PendPEQTDPEN.Value:=Tb_PendPEQTDPED.AsFloat-Tb_PendPEQTDENV.AsFloat;
if Tb_PendPEQTDPEN.AsFloat<0 then
   Tb_PendPEQTDPEN.Value:=0;
if trim(Tb_PendPDNOME.AsString)='' then
   begin
   form_venda_pesqprod.pFilial:=mVenda_GP.mped1_Filial;
   form_venda_pesqprod.pFilial_Desc:=CB_FILIAL.Text;
   if (not form_venda_pesqprod.Qr_Pro.Active) or
      (form_venda_pesqprod.Qr_ProPDCODPRO.AsFloat<>Tb_PendPECODPRO.AsFloat) then
       begin
//       form_venda_pesqprod.Qr_Pro.Filtered:=false;

        fParametrosConulta;

       fLimparDadosPesqProd;
       mDadosPesqProd.pTipo:=1;
       mDadosPesqProd.pPre:=1;
       mDadosPesqProd.pCodEmp   :=codemp;
       mDadosPesqProd.pCodPro   :=Tb_PendPECODPRO.AsFloat;
       mDadosPesqProd.pSemFiltros:=true;
       if form_venda_pesqprod.flcadpro_Local(mDadosPesqProd) then
          begin
          Tb_PendPDNOME.Value:=form_venda_pesqprod.Qr_ProPDNOME.AsString;
          Tb_PendPDUND.Value:=form_venda_pesqprod.Qr_ProPDUND.AsString;
          Tb_PendPDMARCA.Value:=form_venda_pesqprod.Qr_ProPDMARCA.AsString;
          end;
       mDadosPesqProd.pSemFiltros:=false;
       end;
   end;


end;

