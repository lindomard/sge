function TFrm_Venda_Pre.fTotais_desc: Boolean;
var
query_totais: TQuery;
begin
lbl_totBruLiq.caption:='';;
result:=true;
if mVenda_GP.mped1_Chave>0 then
   begin
   query_totais:=TQuery.Create(nil);
   query_totais.databasename:='SG_ASSOC';
   query_totais.SQL.Clear;
   query_totais.SQL.Add('Select ped.*, VALDES*100 / CASE WHEN PCOTAB=0 THEN 1 ELSE PCOTAB END AS PERCDES from ( ');


   query_totais.SQL.Add('select sum(P2PCOTAB*P2QTD) AS PCOTAB, SUM(P2TOTLIQ) AS TOTLIQ '
                       +', sum( (P2PCOTAB*P2QTD)-(P2TOTLIQ)) AS VALDES '
                        +' from CADP02 where P2CHAVE=:CHAVE and P2LOTSEQ=:LOTSEQ ');
   query_totais.ParamByName('CHAVE').asinteger:=mVenda_GP.mped1_Chave;
   query_totais.ParamByName('LOTSEQ').asinteger:=mVenda_GP.mPed1_Chave_ano;
   query_totais.SQL.Add(' ) ped ');
   try
      query_totais.open;
      lbl_totBruLiq.Caption:='Totais: Preco de tabela: '+Formatfloat(mcasas, query_totais.fieldbyname('PCOTAB').AsFloat)
                         +' Preco Vendido: '+Formatfloat(mcasas, query_totais.fieldbyname('TOTLIQ').AsFloat)
                         +' Percentual desconto: '+Formatfloat(mcasas_pct, Truncar(query_totais.fieldbyname('PERCDES').AsFloat,1));
   except on e : exception do
      begin
      ex_erroSql_Novo(Query_totais,26837,'venda_pre '+e.Message,'CADP02');
      result:=false;
      end;
      end;
   freeandnil(query_totais);
   end;

end;


