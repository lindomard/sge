cb_tipopedEnter(self);
cb_tipopedExit(self);
if mVenda_GP.mPed1_CodFP <> mPed1_CodFP_Ant then
   mlib_mPDescLib := 0;
   
if not fTestarDesconto('G',mpreco_tab) then
   begin
    mVenda_GP.mPed1_CodFP := mPed1_CodFP_Ant;
    edt_codfp.Text:=FloatTostr(mVenda_GP.mPed1_CodFP);
