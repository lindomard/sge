function TFrm_Venda_Pre.fPercDesconto(pTpPco: Integer; pPrecoTab,pPrecoVda: Real; pDesc01: Real): Real;
begin


if (pTpPco=2) and (pDesc01=0) then
    begin
    if pPrecoTab<=pPrecoVda then
       result:= pDesc01
    else
       result:=(pPrecoTab-pPrecoVda)*100 / pPrecoTab;
//       result:=(pPrecoTab-pPrecoVda)*100 / pPrecoVda;
    end
else
   result:=pDesc01;
end;

