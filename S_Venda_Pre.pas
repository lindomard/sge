function TFrm_Venda_Pre.fExisteDesconto: boolean;

begin
result:=false;
Tb_Ped02_pre.DisableControls;
Tb_Ped02_pre.First;
while not Tb_Ped02_pre.Eof do
   begin
   if Tb_Ped02_preP2PRECO.AsFloat<Tb_Ped02_preP2PRECO_TAB.AsFloat then
      begin
      result:=true;
      break;
      end
   else if (Tb_Ped02_preP2DESC_PERC01.asfloat +
            Tb_Ped02_preP2DESC_PERC02.asfloat +
            Tb_Ped02_preP2DESC_PERC03.asfloat +
            Tb_Ped02_preP2VALDES.asfloat)> 0 then
      begin
      result:=true;
      break;
      end;
   Tb_Ped02_pre.next;
   end;
if (result=false) and (CB_DESCEMP.Checked=false) then
   begin
   cb_tppco.ItemIndex:=0;
   mVenda_GP.mped1_tppco:=cb_tppco.ItemIndex;
   end
else if (CB_DESCEMP.Checked=false) and (result=true) then
   begin
   MessageDlg('Excluir os Descontos dos Produtos antes de mudar o tipo do Pedido!',mtWarning,[mbok],0);
   end
else
   result:=false;
Tb_Ped02_pre.EnableControls;

end;

