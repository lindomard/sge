   mTotPedLot_001:=mTotPedLot_001+Tb_Ped02_LotesP2LM_QTD_001.AsFloat;
   mTotPedLot_101:=mTotPedLot_101+Tb_Ped02_LotesP2LM_QTD_101.AsFloat;
   pList_Lote.Add(Tb_Ped02_LotesP2LM_LOTE.AsString);
   mem_lotes.Post;
   Tb_Ped02_Lotes.Next;
   end;

if (mTotPedLot_001+mTotPedLot_101=0) then
   mTotPedLot_001:=Tb_Ped02_preP2QTD.AsFloat;
      
mTotDigLot_001:=mTotPedLot_001;
mTotDigLot_101:=mTotPedLot_101;


mem_lotes.SortOnFields('P2LM_LOTE');


gb_lotes.Caption:=Tb_Ped02_prePDNOME.AsString+' - '+Tb_Ped02_preP2CODPRO.AsString
