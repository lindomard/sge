procedure TFrm_Venda_Pre.DBGrid_itensColExit(Sender: TObject);
var
query_temp: TQuery;
query_arma: TQuery;
x_arma: Integer;
mNomVen: String;
mqtdfatemp: Real;
begin
{if Assigned(HintWindow) then
HintWindow.ReleaseHandle;
}
{if tb_ped02_pre.State in [dsEdit,dsInsert] then
   Tb_Ped02_pre.Cancel;
}






if tb_ped02_pre.State in [dsEdit,dsInsert] then
   begin


   if DBGrid_itens.SelectedField=tb_ped02_preP2QTD then
      begin
      if fsonumero(tb_ped02_preP2CODPRO.asstring)<>0 then
         begin
         mqtdfatemp:=fQuantidadeEmprestimoFaturado(tb_ped02_preP2CODPRO.asfloat);
         if mqtdfatemp>tb_ped02_preP2QTD.asfloat then
            begin
            MessageDlg('Ja foi faturado '+floattostr(mqtdfatemp)+' quantidade nao pode ser menor que faturada!',mtWarning,[mbOk],0);
            Tb_Ped02_preP2QTD.Value:=mQtd_Ant;
            DBGrid_itens.SelectedField:=Tb_Ped02_preP2QTD;
            if Sbngravar.enabled then
               DBGrid_itens.SetFocus;
            exit;
            end;
         end;


      if mVenda_GP.mped1_Filial > 0 then
         form_venda_pesqprod.pFilial:=mVenda_GP.mped1_Filial
      else
         form_venda_pesqprod.pFilial:=1;
      form_venda_pesqprod.pFilial_Desc:=CB_FILIAL.Text;

      if form_venda_pesqprod.Qr_ProPDCODPRO.AsFloat<>ValFloat(Tb_Ped02_preP2CODPRO.AsString) then
         begin
         mCodpro_descr_Ant:='';
         fParametrosConulta;

         fLimparDadosPesqProd;
         mDadosPesqProd.pTipo:=1;
         mDadosPesqProd.pPre:=1;
         mDadosPesqProd.pCodEmp   :=codemp;
         mDadosPesqProd.pCodPro   :=valfloat(tb_ped02_preP2CODPRO.AsString);
         mDadosPesqProd.pSemFiltros:=true;
         form_venda_pesqprod.flcadpro_Local(mDadosPesqProd);
         mDadosPesqProd.pSemFiltros:=false;

         end;
//      bbChapas.Visible:=false;

      if form_venda_pesqprod.Qr_ProPDCONTESP.AsInteger=1 then
         begin
         bbChapas.Visible:=true;
         if mQtd_Cmet<>tb_ped02_preP2QTD.asfloat then
            begin
            MessageDlg('Quantidade não pode ser diferente de '+FormatFloat(mcasqtd, mQtd_Cmet)
                      +#13+'para altera-la volte ao campo código para abrir janela de sub-produtos'
                      ,mtWarning,[mbOk],0);
            Tb_Ped02_preP2QTD.AsFloat:=mQtd_Cmet;
            end;
         end;

      if (fEDefensivo(form_venda_pesqprod.Qr_ProPDCODNCM.AsString)) then
         begin
          Application.CreateForm(tFrm_Venda_Pre_Defensivo, Frm_Venda_Pre_Defensivo);
          Frm_Venda_Pre_Defensivo.edt_numrec.Text:=Tb_Ped02_preP2NRECEITUARIO.AsString;
          Frm_Venda_Pre_Defensivo.ShowModal;
          if (Frm_Venda_Pre_Defensivo.mNumRec)<>'' then
             begin
             Tb_Ped02_preP2NRECEITUARIO.Value:=Frm_Venda_Pre_Defensivo.mNumRec;
             end;
         end;

      if tb_ped02_preP2QTD.asfloat<>0 then
         begin

         if form_venda_pesqprod.Qr_ProPDCONTESP.AsInteger=5 then
            begin
            mProcessando_SubProduto:=true;
            if form_arma=nil then
               Application.CreateForm(TFrm_Venda_Pre_Armas, form_arma);
            form_arma.Panel_item.Caption:=Tb_Ped02_prePDNOME.AsString+' ['+Tb_Ped02_preP2CODPRO.AsString+']';
            if mVenda_GP.mped1_Chave=0 then
               fGravarPed01(0);

            form_arma.pCodPro:=ValFloat(Tb_Ped02_preP2CODPRO.AsString);
            form_arma.pItem  :=Tb_Ped02_preP2ITEM.AsInteger;
            form_arma.pChave    :=mVenda_GP.mped1_Chave;
            form_arma.pChave_Ano:=mVenda_GP.mPed1_Chave_ano;
            form_arma.pCodemp   :=mVenda_GP.mPed1_Codemp_ini;
            form_arma.pCodemp_filial:=mVenda_GP.mPed1_Codemp_fin;
            form_arma.pQtd:=Tb_Ped02_preP2QTD.Value;

            query_temp:=TQuery.create(nil);
            query_temp.DatabaseName:='SG_ASSOC';
            query_temp.Close;
            query_temp.SQL.Clear;
            query_temp.SQL.Add('Delete from CADP02_ARMAS '
                              +'  where  P2ARMA_LOTSEQ=:LOTSEQ '
                              +'  and P2ARMA_CHAVE=:CHAVE '
                              +'  and P2ARMA_CODPRO=:CODPRO '
                              +'  and P2ARMA_CODEMP=:CODEMP '
                              +'  and P2ARMA_ITEM=:ITEM '
                              +'  and P2ARMA_SEQ>:QTD '
                              );
            query_temp.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave;
            query_temp.ParamByName('CHAVE').AsInteger :=mVenda_GP.mPed1_Chave;
            query_temp.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp;
            query_temp.ParamByName('CODPRO').AsFloat  :=Tb_Ped02_preP2CODPRO.AsFloat;
            query_temp.ParamByName('ITEM').AsFloat    :=Tb_Ped02_preP2ITEM.AsInteger;
            query_temp.ParamByName('QTD').AsFloat     :=Tb_Ped02_preP2QTD.Asfloat;
            try
               query_temp.ExecSQL;
               fdm1StartCommit;
            except
               end;


            query_arma:=TQuery.create(nil);
            query_arma.DatabaseName:='SG_ASSOC';
            query_arma.Close;
            query_arma.SQL.Clear;
            query_arma.SQL.Add('Select * from CADP02_ARMAS '
                              +'  where  P2ARMA_LOTSEQ=:LOTSEQ '
                              +'  and P2ARMA_CHAVE=:CHAVE '
                              +'  and P2ARMA_CODPRO=:CODPRO '
                              +'  and P2ARMA_CODEMP=:CODEMP '
                              +'  and P2ARMA_ITEM=:ITEM '
                              +'  order by P2ARMA_SEQ ');
            query_arma.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
            query_arma.ParamByName('CHAVE').AsInteger :=mVenda_GP.mped1_Chave;
            query_arma.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp;
            query_arma.ParamByName('CODPRO').AsFloat  :=Tb_Ped02_preP2CODPRO.AsFloat;
            query_arma.ParamByName('ITEM').AsFloat    :=Tb_Ped02_preP2ITEM.AsInteger;
            try
               query_arma.Open;
            except
               end;
            for x_arma:=1 to Tb_Ped02_preP2QTD.AsInteger do
               begin
               if not query_arma.Locate('P2ARMA_SEQ',x_arma,[]) then
                  begin
                  query_temp.Close;
                  query_temp.SQL.Clear;
                  query_temp.SQL.Add('Insert into CADP02_ARMAS ('
                                    +'P2ARMA_ID_NEW '
                                    +',P2ARMA_LOTSEQ'
                                    +',P2ARMA_CHAVE'
                                    +',P2ARMA_CHAVE_NIVEL'
                                    +',P2ARMA_CODPRO'
                                    +',P2ARMA_CODEMP'
                                    +',P2ARMA_ITEM'
                                    +',P2ARMA_SEQ '
                                    +',P2ARMA_TPARMA '
                                    +') values ( '
                                    +' CADP02_ARMAS_SEQ.NEXTVAL '
                                    +',:P2ARMA_LOTSEQ'
                                    +',:P2ARMA_CHAVE'
                                    +',:P2ARMA_CHAVE_NIVEL'
                                    +',:P2ARMA_CODPRO'
                                    +',:P2ARMA_CODEMP'
                                    +',:P2ARMA_ITEM'
                                    +',:P2ARMA_SEQ '
                                    +',:P2ARMA_TPARMA '
                                    +')');
                  query_temp.ParamByName('P2ARMA_LOTSEQ').AsInteger      :=mVenda_GP.mPed1_Chave_ano;
                  query_temp.ParamByName('P2ARMA_CHAVE').AsInteger       :=mVenda_GP.mped1_Chave;
                  query_temp.ParamByName('P2ARMA_CHAVE_NIVEL').AsInteger :=0;
                  query_temp.ParamByName('P2ARMA_CODEMP').AsInteger      :=mVenda_GP.mPed1_Codemp;
                  query_temp.ParamByName('P2ARMA_CODPRO').AsFloat        :=Tb_Ped02_preP2CODPRO.AsFloat;
                  query_temp.ParamByName('P2ARMA_ITEM').AsFloat          :=Tb_Ped02_preP2ITEM.AsInteger;
                  query_temp.ParamByName('P2ARMA_SEQ').AsInteger         :=x_arma;
                  query_temp.ParamByName('P2ARMA_TPARMA').AsInteger      :=0;
                  try
                     query_temp.ExecSQL;
                     fdm1StartCommit;
                  except
                     end;
                  end;
               end;


            form_arma.fLerArmas(0);
            form_arma.ShowModal;
            DBGrid_itens.SelectedField:=Tb_Ped02_preP2DESC_PERC01;
            if Sbngravar.enabled then
               DBGrid_itens.SetFocus;
            FreeAndNil(query_temp);
            FreeAndNil(query_arma);
            mProcessando_SubProduto:=false;
            end;
// inicio

          if (mVenda_GP.mped1_tppco<>4) and (mVenda_GP.mped1_tppco<6) then
             begin
              if   ((DM1.Tb_PargerPDQPCOP.AsInteger=4) or (DM1.Tb_PargerPDQPCOP.AsInteger=5) or (DM1.Tb_PargerPDQPCOP.AsInteger=6))  and (mVenda_GP.mPed1_Tabela<>'3') then
                 begin
                 if (form_venda_pesqprod.Qr_ProPDEMBPAD.AsFloat>0) and ( (DM1.Tb_PargerPDQPCOP.AsInteger<>6)
                 AND  (Tb_Ped02_preP2QTD.AsFloat>=form_venda_pesqprod.Qr_ProPDEMBPAD.AsFloat))

                 OR ( (DM1.Tb_PargerPDQPCOP.AsInteger=6) and  (form_venda_pesqprod.Qr_ProPDEMBPAD.AsFloat>0)

                   and (    (Tb_Ped02_preP2QTD.AsInteger mod form_venda_pesqprod.Qr_ProPDEMBPAD.AsInteger)=0 ) ) then

                    begin
                    Tb_Ped02_preP2TIPO_PCO.Value:=2;
                    fPegarPrecoProd(iif(mQtd_Ant<>Tb_Ped02_preP2QTD.AsFloat,2,0));
                    end
                 else
                    begin
                    if form_venda_pesqprod.Qr_ProPDEMBPAD.AsFloat>0 then
                      Tb_Ped02_preP2TIPO_PCO.Value:=1
                    else
                      begin
                      Tb_Ped02_preP2TIPO_PCO.Value:=valint(mVenda_GP.mPed1_Tabela);
//                      if (Tb_Ped02_preP2TIPO_PCO.AsInteger<1) or (Tb_Ped02_preP2TIPO_PCO.AsInteger>3) then
//                         Tb_Ped02_preP2TIPO_PCO.AsInteger:=1;
                      end;
                    end;
                 end;
              end;
// termino

         if Log_TipoLote=1 then // usa lotes de mercadorias
            fValidarLotes;

         end
       else
         begin
         if not cb_leitor.Checked then
           begin
           if not Tb_Ped02_preP2CODPRO.isnull then
              begin
              fmensagem('Quantidade tem que ser maior que 0', 0,['0'],0);
              abort;
              end;
           exit;
           end;
         end;
      if not fValidarDigitacaoItem then
         begin
         if not cb_leitor.Checked then
            abort;
         exit;
         end;


      end
// inicio vendedor
   else if DBGrid_itens.SelectedField=tb_ped02_preP2CODVEN then
      begin
      if (Tb_Ped02_preP2CODVEN.AsInteger>0) then
         begin
         if not fLerGenerico01_campos('CADVEN','VNOME',' VCODVEN='+Tb_Ped02_preP2CODVEN.AsString,mNomVen) then
            begin
            MessageDlg('Vendedor '+Tb_Ped02_preP2CODVEN.AsString+' não cadastrado!',mtWarning,[mbOk],0);
            DBGrid_itens.SelectedField:=Tb_Ped02_preP2CODVEN;
            abort;
            end;
         end;
      end
// termino vendedor
  else if DBGrid_itens.SelectedField=Tb_Ped02_preP2PRECO then
      begin



      if form_venda_pesqprod.Qr_ProPDCONTESP.AsInteger=1 then
         begin
         if  (mPreco_ant<>0) and (Arredonda(mPreco_ant,2)<>Arredonda(Tb_Ped02_preP2PRECO.AsFloat,2)) then
            Tb_Ped02_preP2PRECO.AsFloat:=mPreco_ant
         else
            begin
            if (mPreco_ant<>0) and (Arredonda(mPreco_ant,2)<>Arredonda(Tb_Ped02_preP2PRECO.AsFloat,2)) and (mped1_tpPed<>3) then
               begin
               mValidarSenha.pTipo:=0;
               mValidarSenha.pCodusr:=codusr;
               mValidarSenha.pCodSen:=63;
               mValidarSenha.pCodEmp:=0;
               mValidarSenha.pCodCli:=valfloat(edt_codcli.text);

               mValidarSenha.pCodEmp:=codemp;
               mValidarSenha.pLotSeq:=ls_numped;
               mValidarSenha.pChave :=mVenda_GP.mped1_Chave;
               mValidarSenha.pOrdem :=1;


               mValidarSenha.pTexto :='Senha para Alterar o Preço do Produto'
                +' Chave do Pedido '+FloatTostr(mVenda_GP.mped1_Chave);
               mValidarSenha.pChave_St:='';
               mValidarSenha.pDesc_requisitado :=0;

               if fValidaSenha(mValidarSenha)<>0 then
                  begin
                  Tb_Ped02_preP2PRECO.AsFloat:=mPreco_ant;
                  abort;
                  exit;
                  end;
               end;
            end;
         end;
      if (mVenda_GP.mPed1_TpComis=7) and ((mVenda_GP.mped1_tppco=2) or (mVenda_GP.mped1_tppco=3)) then // do cadastro do desconto
         begin
         if flcadcomd2(fPercDesconto(mVenda_GP.mped1_tppco,Tb_Ped02_preP2PRECO_TAB.AsFloat,Tb_Ped02_preP2PRECO.AsFloat,Tb_Ped02_preP2DESC_PERC01.AsFloat)) then
            Tb_Ped02_preP2PCOMIS.AsFloat:=DM1.Tb_ComDCDCOMIS.AsFloat;
         end;
      end
  else if DBGrid_itens.SelectedField=Tb_Ped02_preP2IMP_PU_DOLLAR then
      begin
      if valfloat(edt_cot_dollar.text)<=0 then
         begin
         MessageDlg('Cotação do Dollar tem que ser colocado!',mtWarning,[mbOk],0);
         abort;
         exit;
         end
      else
         begin
         Tb_Ped02_preP2PRECO.AsFloat:=Tb_Ped02_preP2IMP_PU_DOLLAR.Value*valfloat(edt_cot_dollar.text);
         end;
      end
   else if DBGrid_itens.SelectedField=tb_ped02_preP2CODPRO then
      begin
{      if ((Tb_Ped02_preP2CODPRO.AsString)<>(form_venda_pesqprod.Qr_ProPDCODPRO.AsString)) or (Tb_Ped02_Pre.State in [dsInsert])
         or (cb_leitor.Checked)  then}


      if ((Tb_Ped02_preP2CODPRO.AsString)<>(form_venda_pesqprod.Qr_ProPDCODPRO.AsString)) or (Tb_Ped02_Pre.State in [dsInsert])
         or (cb_leitor.Checked)  then
         begin
         mCodpro_descr_Ant:='';

         Tb_Ped02_preP2CODPRO.AsString:=fSeparaQtdCodpro(Tb_Ped02_preP2CODPRO.AsString,cb_leitor.checked);
         Tb_Ped02_preP2PRECO.AsFloat := 0;
         if (Valfloat(mCodpro_Ant)<>Valfloat(Tb_Ped02_preP2CODPRO.AsString)) and (pRet_Qtd<>0)
            or (Tb_Ped02_preP2QTD.AsFloat<=0) then
             begin
             Tb_Ped02_preP2QTD.AsFloat:=pRet_Qtd;
//             Tb_Ped02_preP2TIPO_PCO.Value:=valint(mVenda_GP.mPed1_Tabela);      lindomar20112019
//             if (Tb_Ped02_preP2TIPO_PCO.AsInteger<1) or (Tb_Ped02_preP2TIPO_PCO.AsInteger>3) then
//                Tb_Ped02_preP2TIPO_PCO.AsInteger:=1;
             end;
          end;
      if (tb_ped02_preP2CODPRO.AsString='') and (not DBGrid_itens.focused) then
         exit
      else
         begin
         if not fValidarDigitacaoItem then
            begin
            DBGrid_itens.SelectedField:=tb_ped02_preP2CODPRO;
            if Sbngravar.enabled then
               DBGrid_itens.SetFocus;
            abort;
            end
         else if trim(mCodpro_Ant)<>'' then
            begin
            if Log_TipoLote=1 then // usa lotes de mercadorias
               fValidarLotes;
            end;
        end;
      if (mVenda_GP.mped1_Chave<>0) and ((trim(mCodpro_Ant)='')) or (mCodpro_Ant<>Tb_Ped02_preP2CODPRO.AsString)  then
         begin
         if fFoiDigitado(0) then
            begin
            abort;
            exit;
            end;
         end;

      if form_venda_pesqprod.Qr_ProPDCONTESP.AsInteger=1 then
         begin
         fChamarCmet;
         end;



     if cb_leitor.Checked then
        begin
        if (mQtd_Acum<>0) then
           begin
           Tb_Ped02_preP2QTD.AsFloat:=Tb_Ped02_preP2QTD.AsFloat+mQtd_Acum;
           mQtd_Acum:=0;
           end;

//        DBGrid_itens.SelectedField:=Tb_Ped02_preP2PRECO;
//        DBGrid_itens.SelectedField:=Tb_Ped02_preP2CFOP_ECF;



//        DBGrid_itensColExit(self);

        Tb_Ped02_preP2PRECO.AsFloat := Arredonda(Tb_Ped02_preP2PRECO.AsFloat, mVenda_GP.mPed1_QtdDec);
        if (tb_ped02_preP2QTD.AsFloat>0) and (tb_ped02_preP2PRECO.AsFloat>0) then
           tb_ped02_preVALOR_TOTAL.AsFloat:=tb_ped02_preP2QTD.AsFloat*tb_ped02_preP2PRECO.AsFloat
        else
           tb_ped02_preVALOR_TOTAL.AsFloat:=0;
        DBGrid_itens.SelectedField:=Tb_Ped02_preP2CODPRO;
        if Log_TipoLote=1 then // usa lotes de mercadorias
           fValidarLotes;
        tb_ped02_pre.post;
        tb_ped02_pre.Next;
//        keybd_event(VK_DOWN,0,0,0);
        if cb_leitor.Checked then
           begin
           Tb_Ped02_pre.Append;
           DBGrid_itens.SelectedField:=Tb_Ped02_preP2CODPRO;
           end;

        exit;

//        if DBGrid_itens.Columns[14].ReadOnly=true then
//           keybd_event(VK_RETURN,0,0,0);
        end
      else
        begin
        if CB_ALTERA_DESCRICAO.Checked then
           DBGrid_itens.SelectedField:=Tb_Ped02_prePDNOME;
        end;


      end
   else if DBGrid_itens.SelectedField=Tb_Ped02_preP2TIPO_PCO then
      begin


{      if (Tb_Ped02_preP2TIPO_PCO.AsInteger<1) or (Tb_Ped02_preP2TIPO_PCO.AsInteger>3) then
         begin
         Tb_Ped02_preP2TIPO_PCO.Value:=valint(mVenda_GP.mPed1_Tabela);
         end;
         lindomar20112019
^}
//      if (Tb_Ped02_preP2TIPO_PCO.AsInteger<1) or (Tb_Ped02_preP2TIPO_PCO.AsInteger>3) then
//          Tb_Ped02_preP2TIPO_PCO.AsInteger:=1;

      if (mTpPco_Ant<>Tb_Ped02_preP2TIPO_PCO.AsInteger) and (mVenda_GP.mped1_tppco<4) then
         fPegarPrecoProd(0);
      end
   else if (DBGrid_itens.SelectedField=Tb_Ped02_preP2DESC_PERC01)  then
      begin
      if (mVenda_GP.mped1_tppco=3) or (mant_perc_desc01<>Tb_Ped02_preP2DESC_PERC01.AsFloat) then
         begin
         fPegarPrecoProd(2);
         mant_perc_desc01:=Tb_Ped02_preP2DESC_PERC01.AsFloat;
         mant_perc_desc02:=Tb_Ped02_preP2DESC_PERC02.AsFloat;
         mant_perc_desc03:=Tb_Ped02_preP2DESC_PERC03.AsFloat;
         mant_valdesc    :=Tb_Ped02_preP2VALDES.AsFloat;
         if (mVenda_GP.mPed1_TpComis=7) and ((mVenda_GP.mped1_tppco=2) or (mVenda_GP.mped1_tppco=3)) then // do cadastro do desconto
            begin
            if flcadcomd2(fPercDesconto(mVenda_GP.mped1_tppco,Tb_Ped02_preP2PRECO_TAB.AsFloat,Tb_Ped02_preP2PRECO.AsFloat,Tb_Ped02_preP2DESC_PERC01.AsFloat)) then
               Tb_Ped02_preP2PCOMIS.AsFloat:=DM1.Tb_ComDCDCOMIS.AsFloat;
            end;

         end;
      end
   else if (DBGrid_itens.SelectedField=Tb_Ped02_preP2DESC_PERC02)
           or (DBGrid_itens.SelectedField=Tb_Ped02_preP2DESC_PERC03)
           or (DBGrid_itens.SelectedField=Tb_Ped02_preP2VALDES)  then
      begin
      if (mant_perc_desc02<>Tb_Ped02_preP2DESC_PERC02.AsFloat) or
         (mant_perc_desc03<>Tb_Ped02_preP2DESC_PERC03.AsFloat) or
         (mant_valdesc<>Tb_Ped02_preP2VALDES.AsFloat) then
         begin
         fPegarPrecoProd(2);
         mant_perc_desc01:=Tb_Ped02_preP2DESC_PERC01.AsFloat;
         mant_perc_desc02:=Tb_Ped02_preP2DESC_PERC02.AsFloat;
         mant_perc_desc03:=Tb_Ped02_preP2DESC_PERC03.AsFloat;
         mant_valdesc    :=Tb_Ped02_preP2VALDES.AsFloat;
         end;
      end;



    mant_perc_desc01 := Tb_Ped02_preP2DESC_PERC01.AsFloat;
    mant_perc_desc02 := Tb_Ped02_preP2DESC_PERC02.AsFloat;
    mant_perc_desc03 := Tb_Ped02_preP2DESC_PERC03.AsFloat;
