else
  Tb_Ped02_prevalor_bruto.AsFloat:=Truncar(Tb_Ped02_preP2QTD.AsFloat*Tb_Ped02_preP2PRECO.AsFloat,2);
{
if  ((valfloat(edt_desc_valor.Text)>0) or (ValFloat(edt_pDesc01.Text)>0))
   and  (not Tb_Ped02_preP2CODPRO.IsNull) then
   begin
   if (mItem_lido<>Tb_Ped02_preP2ITEM.AsInteger) or (Tb_Ped02_preP2TOTDES.AsFloat=0) then
   }
