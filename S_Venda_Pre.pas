begin

st_qtdpedlote_001.Caption:=Formatfloat(mcasas, mTotPedLot_001);
st_qtdpedlote_101.Caption:=Formatfloat(mcasas, mTotPedLot_101);

st_qtddiglote_001.Caption:=Formatfloat(mcasas, mTotDigLot_001);
st_qtddiglote_101.Caption:=Formatfloat(mcasas, mTotDigLot_101);

