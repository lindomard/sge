function TFrm_Venda_Pre.fLer_query_nfe(out query_nfe: tquery): Boolean;
begin
if query_nfe=nil then
   begin
   query_nfe := TQuery.Create(nil);
   query_nfe.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
   end;
la_tabelas  :='';
la_Join     :='';
la_instrucao:='';
la_Empresas :='';
fInnerJoin(1,'CADCLI','CCODEMP','P1CODEMP','CCODCLI','P1CODCLI');

query_nfe.SQL.Clear;
query_nfe.SQL.Add('Select P1CODEMP,P1LOTSEQ,P1CHAVE,P1ID_NEW,P1ORDEM,P1STATUS,P1TIPO,CCNPJ,CCPF,'
                 +'CUF,P1SITPED,P1TABPV,P1CODPV,P1PVACTD,P1ORDEM,P1PRAZO,P1PVDDESCF,P1PVDIASDESCF'
                 +',P1TOTALL,P1COMIS,P1COMV02,P1COMV03,P1COMV04,P1COMISS'
                 +',P1COMIST,P1SEMCOM,P1COMASSE,P1ICMSR,P1VALFRE,P1TOTEXTCOM'
                 +',P1VALSEG,P1DESCFIN,P1TOTDI01,P1TOTDI02,P1TOTDI03,P1TOTDIVL'
                 +',P1VALDES01,P1VALDES02,P1VLRDES,P1TARBAN,P1DESPACES,P1IPIINA,P1IPIPOS'
                 +',P1IPINEG,P1TOTCGRU,P1TOTSGRU,P1TOTSERLIQ,P1VALENT,P1CODUSR,P1CODUSR_ULTEVE'
                 +',CRAZAO,P1EMITENTE,P1CODSER,P1TOTSERLIQ,P1CODCLI,P1DATANF,P1EMIDOC,P1DATDOC '
                 +',P1COMP_ULTEVE,P1CODTRA,P1BLOQPEND,P1CODBLOQ_LIB,P1CODBLOQ,P1PREVENT'
                 +',P1NUMNF,P1NUMCF,P1FORMACE,P1DATAP,P1NFE_ENVXML '
                 +',P1QTDMAN as P1QTDMAN,P1CUPOM,P1ANALISE,P1NUMNF_SERV '
                 +',P1NFCE_DATA,P1NFCE_NUMERO,P1NFCE_SERIE,P1NFCE_SITUACAO,P1NFCE_MODELO,P1NFCE_CHV_ACESSO,P1NFCE_NPROT '

                 +',P1PRAZO_ENT,P1COMIS_EXTRA,P1SUBMOD,P1DATHOR_ULTEVE,P1DATHOR_UEVE from CADP01'+iif(la_tabelas='','',',')+la_tabelas
                 +'       '+la_Join
                 +'       where '+iif(la_Empresas='','',la_Empresas+' and ')
                 +'      '+        iif(la_instrucao='','',la_instrucao+' and ')
                 +'  (P1CODEMP=:CODEMP OR P1CODEMP=:CODEMP_FILIAL) '
                 +' and P1CHAVE=:CHAVE '
                 +' and P1LOTSEQ=:LOTSEQ '
                 +' and P1ORDEM=:ORDEM '
                 +' order by P1CODEMP ');
Query_nfe.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp_ini;
Query_nfe.ParamByName('CODEMP_FILIAL').AsInteger:=mVenda_GP.mPed1_Codemp_fin;
Query_nfe.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
Query_nfe.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
Query_nfe.ParamByName('ORDEM').AsInteger:=1;
query_nfe.Open;
mCodEmp_Maxima:=mVenda_GP.mPed1_Codemp_fin;
mCodEmp_Minima:=mVenda_GP.mPed1_Codemp_ini;

if query_nfe.IsEmpty then
   begin
   fmensagem('Chave não encontrada!',0,['0'],0);
   freeandnil(query_nfe);
   result:=false;
   end
else
   result:=true;
end;


function TFrm_Venda_Pre.fDeletarChaveInexistente: Boolean;
var
query_temp: tQuery;
begin
if mVenda_GP.mped1_Chave=0 then
   begin
   result:=true;
   exit;
   end;
query_temp:=tQuery.Create(nil);
query_Temp.DatabaseName:=DM1.SG_ASSOC.databasename;
query_Temp.SQL.Add('DELETE FROM CADP01 WHERE P1CHAVE=:CHAVE and P1LOTSEQ=:LOTSEQ'
                  +' AND NVL((select count(*) FROM CADP02 WHERE P2CHAVE=P1CHAVE AND P2CODEMP=P1CODEMP),0)<1 '
                  +' AND NVL((select count(*) FROM CADP02S WHERE P2SCHAVE=P1CHAVE AND P2SCODEMP=P1CODEMP),0)<1 '

                  );
query_temp.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
query_temp.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
try
   query_temp.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
   result:=false;
   end;



query_Temp.Close;
query_Temp.SQL.Clear;
query_Temp.SQL.Add('DELETE FROM CADPFP WHERE PFPCHAVE=:CHAVE and PFPLOTSEQ=:LOTSEQ'
                  +' AND NVL((select count(*) FROM CADP02 WHERE P2CHAVE=PFPCHAVE AND P2CODEMP=PFPCODEMP),0)<1 '
                  +' AND NVL((select count(*) FROM CADP02S WHERE P2SCHAVE=PFPCHAVE AND P2SCODEMP=PFPCODEMP),0)<1 '
                  );
query_temp.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
query_temp.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
try
   query_temp.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
   result:=false;
   end;

freeandnil(query_temp);

end;
