function TFrm_Venda_Pre.fAjustarLotes_Pedidos(pChave,pLotseq,pCodemp,pcodemp_filial: Integer): Boolean;
var
Query_Exe: TQuery;
begin
Query_Exe:=TQuery.Create(nil);
Query_Exe.DatabaseName:='SG_ASSOC';
Query_Exe.Close;
Query_Exe.SQL.Clear;
Query_Exe.SQL.Add('update CADP02_LOTES set '
                 +' p2lm_item=(select max(p2item) '
                 +' from CADP02 where P2CHAVE=P2LM_CHAVE '
                 +' and P2CODEMP=P2LM_CODEMP '
                 +' AND P2LOTSEQ=P2LM_LOTSEQ '
                 +' AND P2CODPRO=P2LM_CODPRO) '
                 +' where p2lm_CHAVE=:CHAVE '
                 +' and P2LM_LOTSEQ=:LOTSEQ '
                 +' and (P2LM_CODEMP=:CODEMP '
                 +' or  P2LM_CODEMP=:CODEMP_FILIAL )');
Query_Exe.ParamByName('CHAVE').AsInteger:=pChave;
Query_Exe.ParamByName('LOTSEQ').AsInteger:=pLotseq;
Query_Exe.ParamByName('CODEMP').AsInteger:=pCodemp;
Query_Exe.ParamByName('CODEMP_FILIAL').AsInteger:=pCodemp_filial;
try
   Query_Exe.ExecSQL;
   fdm1StartCommit;
   result:=true;
except
   result:=false;
   end;
FreeandNil(Query_Exe);
end;

function tFrm_Venda_Pre.fRecalcularformas(pTipo: Integer): Boolean;
var
x: Integer;
mValorTemp: Real;
mDescValor: Real;
mDadosParametros: tDadosParametros;

begin
if mlocalizando_pedido then
   begin
   result:=true;
   exit;
   end;
mVenda_GP.mPed1_QtdParc_ant:=-1;
//mVenda_GP.mPed1_QtdParc_ant:=mVenda_GP.mPed1_QtdParc;

   mDadosParametros.pId_Ped02_new_ant_naoUtil :=0;

for x:=1 to 2 do
   begin
   if mVenda_GP.mped1_submod=100 then
      begin
      if codemp>100 then
         mVenda_GP.mPed1_Codemp:=codemp-100
      else
         mVenda_GP.mPed1_Codemp:=codemp+100
      end
   else if mVenda_GP.mped1_submod=0 then
      begin
      mVenda_GP.mPed1_Codemp:=codemp
      end
   else if x=1 then
      mVenda_GP.mPed1_Codemp:=codemp
   else
      begin
      if codemp>100 then
         mVenda_GP.mPed1_Codemp:=codemp-100
      else
         mVenda_GP.mPed1_Codemp:=codemp+100
      end;
   mVenda_GP.mPed1_AjustaFP:='S';
//   mVenda_GP.mPed1_QtdParc_ant:=-1;
   if (mVenda_GP.mped1_submod=0) or (mVenda_GP.mped1_submod=100) then
      mDescValor:=valfloat(edt_desc_valor.Text)
   else
      begin
      mValorTemp:=Arredonda( (valfloat(edt_desc_valor.Text)*mVenda_GP.mped1_submod/100), DM1.Tb_PargerPCASAS.AsInteger);
      if x=2 then
         mDescValor:=mValorTemp
      else
         mDescValor:=valfloat(edt_desc_valor.Text)-mValorTemp;
      end;
    mVenda_GP.fGravarItem(0 // produto
                        ,mitem_ant
                        ,0 // Tipo de Movimento do Estoque 0-Saida 1-Entrada 2-Não Movimenta p2Estoque
                        ,mVenda_GP.mPed1_CodFP
                        ,3 //apenas calcular  tipo do evento 0-inclusao 1-alteracao 2-exclusao 3-calcular
                        ,0 //pSituacao: Integer;
                        ,' '
                        ,mVenda_GP.mPed1_NomFP
                        ,mVenda_GP.mPed1_BaixaFP
                        ,0  //pQtd_Cal
                        ,0 // pPrecoUnit_Cal
                        ,0 //,pPrecoTab_Cal
                        ,0 // pPrecoUCPR_Cal
                        ,0 // pPrecoCus_Cal
                        ,0 // pPrecoMax_Cal,
                        ,0 // mQtd_Ant_Cal
                        ,valfloat(edt_valseg.Text)
                        ,ValFloat(edt_valfre.Text)
                        ,iif(mVenda_GP.mPed1_Codemp>100,ValFloat(edt_tarban_101.Text),ValFloat(edt_tarban1.Text))
                        ,valfloat(edt_despAces.Text)
                        ,mdescValor
                        ,mDadosParametros
                        ,nil);
   if (mVenda_GP.mped1_submod=100) or (mVenda_GP.mped1_submod=0) then
      break;
   end;

fLerFormaPag(0);

result:=true;
end;
