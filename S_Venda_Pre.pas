function tFrm_Venda_Pre.fExcluiPedido_Lotes(pChave,pLotSeq,pCodEmp,pCodEmp_Filial,pCodpro: Real;pItem,pContEsp,pTipoProd:Integer): Boolean;


var
Query_Lotes: TQuery;
mEstNor_Temp: String;
	pBaixar: pBaixarLotes;

begin
Query_Lotes := TQuery.Create(nil);
Query_Lotes.DatabaseName:='SG_ASSOC';
Query_Lotes.SQL.Clear;
Query_Lotes.SQL.Add('select P2LM_CODPRO,P2LM_ITEM,P2LM_LOTE as P2LM_LOTE'
                      +', P2LM_DTVCTO,P2LM_DTFAB,MAX(P2LM_ID_NEW) AS P2LM_ID_NEW ');
if mVenda_GP.mped1_formace=0 then
   begin
   Query_Lotes.SQL.Add(',sum(P2LM_QTD) as P2LM_QTD ');
   Query_Lotes.SQL.Add(',sum(case when P2LM_CODEMP>100 then 0 else P2LM_QTD end) as P2LM_QTD_001 ');
   Query_Lotes.SQL.Add(',sum(case when P2LM_CODEMP>100 then P2LM_QTD else 0 end) as P2LM_QTD_101 ');
   end
else
   begin
   Query_Lotes.SQL.Add(',max(P2LM_QTD) as P2LM_QTD_001 ');
   Query_Lotes.SQL.Add(',0 as P2LM_QTD_101 ');
   Query_Lotes.SQL.Add(',max(P2LM_QTD) as P2LM_QTD ');
   end;
Query_Lotes.SQL.Add(' from CADP02_LOTES '
                   +' where P2LM_CHAVE=:CHAVE '
                   +' and P2LM_LOTSEQ=:LOTSEQ '
                   +' and P2LM_CODPRO=:CODPRO '
                   +' and P2LM_ITEM=:ITEM '
                   +' and (P2LM_CODEMP=:CODEMP '
                   +' or   P2LM_CODEMP=:CODEMP_FILIAL) ');
Query_Lotes.SQL.Add(' group by P2LM_CODPRO,P2LM_ITEM,P2LM_LOTE,P2LM_DTVCTO,P2LM_DTFAB ');

Query_Lotes.ParamByName('CHAVE').Value:=pChave;
Query_Lotes.ParamByName('LOTSEQ').Value:=pLotSeq;
Query_Lotes.ParamByName('CODPRO').Value:=pCodPro;
Query_Lotes.ParamByName('ITEM').Value:=pItem;
Query_Lotes.ParamByName('CODEMP').Value:=pCodEmp;
Query_Lotes.ParamByName('CODEMP_FILIAL').Value:=pCodEmp_Filial;
try
   Query_Lotes.open;
except
   Query_Lotes.SQL.SAVETOFILE(mpastatemp +'sqllote.TXT');
   end;

While not Query_Lotes.Eof do
   begin
   if mVenda_GP.mPd_EstNor='S' then
      mEstNor_Temp:='E'
   else if mVenda_GP.mPd_EstNor='E' then
      mEstNor_Temp:='S'
   else
      mEstNor_Temp:=mVenda_GP.mPd_EstNor;
   if Query_Lotes.FieldByName('P2LM_QTD_001').AsFloat<>0 then

	pBaixar.pCodemp := mVenda_GP.mPed1_codemp;
	pBaixar.pFilial := mVenda_GP.mPed1_filial;
	pBaixar.pItem   := pitem;
	pBaixar.pDocOri := 00;
	pBaixar.pCodUsr  := codusr;
	pBaixar.pContEsp := pContEsp;
	pBaixar.pTipoProd := pTipoProd;
	pBaixar.pChave   := mVenda_GP.mped1_Chave;
	pBaixar.pChave_ano := mVenda_GP.mped1_Chave_ano;
	pBaixar.pQtd       := query_lotes.FieldByName('P2LM_QTD_001').AsFloat;
	pBaixar.pCodPro    := floattostr(pcodpro);
	pBaixar.pEstNor       := mEstNor_temp;
	pBaixar.pEstReservado := 'N';
	pBaixar.pLote         := Query_Lotes.FieldByName('P2LM_LOTE').AsString;
	pBaixar.pDtVcto       := Query_Lotes.FieldByName('P2LM_DTVCTO').AsDateTime;
	pBaixar.pDtFab        := Query_Lotes.FieldByName('P2LM_DTFAB').AsDateTime;
	pBaixar.pLoteRe       := '';
	pBaixar.pObs          := '';
  PBaixar.pChaveIdNew   := query_lotes.fieldbyname('P2LM_ID_NEW').AsInteger;

	fBaixarMercadorias(pBaixar);

{
      fBaixarMercadorias(IIF(mVenda_GP.mPed1_codemp>100,mVenda_GP.mPed1_Codemp-100,mVenda_GP.mPed1_Codemp+100)
                     ,mVenda_GP.mPed1_filial
                     ,pitem
                     ,00 // docori
                     ,codusr
                     ,pContEsp //pcontesp
                     ,pTipoProd //ptipoprod
                     ,mVenda_GP.mped1_Chave
                     ,mVenda_GP.mped1_Chave_ano
                     ,query_lotes.FieldByName('P2LM_QTD_001').AsFloat
                     ,floattostr(pcodpro)
                     ,mEstNor_temp
                     ,'N'
                     ,Query_Lotes.FieldByName('P2LM_LOTE').AsString
                     ,Query_Lotes.FieldByName('P2LM_DTVCTO').AsDateTime
                     ,'' // lote re
                     ,'' // obs

                     );

}
      if Query_Lotes.FieldByName('P2LM_QTD_101').AsFloat<>0 then


	pBaixar.pCodemp := IIF(mVenda_GP.mPed1_codemp>100,mVenda_GP.mPed1_Codemp-100,mVenda_GP.mPed1_Codemp+100);
	pBaixar.pFilial := mVenda_GP.mPed1_filial;
	pBaixar.pItem   := pitem;
	pBaixar.pDocOri := 00;
	pBaixar.pCodUsr  := codusr;
	pBaixar.pContEsp := pContEsp;
	pBaixar.pTipoProd := pTipoProd;
	pBaixar.pChave   := mVenda_GP.mped1_Chave;
	pBaixar.pChave_ano := mVenda_GP.mped1_Chave_ano;
	pBaixar.pQtd       := query_lotes.FieldByName('P2LM_QTD_101').AsFloat;
	pBaixar.pCodPro    := floattostr(pcodpro);
	pBaixar.pEstNor       := mEstNor_temp;
	pBaixar.pEstReservado := 'N';
	pBaixar.pLote         := Query_Lotes.FieldByName('P2LM_LOTE').AsString;
	pBaixar.pDtVcto       := Query_Lotes.FieldByName('P2LM_DTVCTO').AsDateTime;
	pBaixar.pDtFab        := Query_Lotes.FieldByName('P2LM_DTFAB').AsDateTime;
	pBaixar.pLoteRe       := '';
	pBaixar.pObs          := '';
  PBaixar.pChaveIdNew   := query_lotes.fieldbyname('P2LM_ID_NEW').AsInteger;

	fBaixarMercadorias(pBaixar);

{

         fBaixarMercadorias(IIF(mVenda_GP.mPed1_codemp>100,mVenda_GP.mPed1_Codemp-100,mVenda_GP.mPed1_Codemp+100)
                     ,mVenda_GP.mPed1_filial
                     ,pitem
                     ,00 // docori
                     ,codusr
                     ,pContEsp //pcontesp
                     ,pTipoProd //ptipoprod
                     ,mVenda_GP.mped1_Chave
                     ,mVenda_GP.mped1_Chave_ano
                     ,query_lotes.FieldByName('P2LM_QTD_101').AsFloat
                     ,floattostr(pcodpro)
                     ,mEstNor_temp
                     ,'N'
                     ,query_lotes.FieldByName('P2LM_LOTE').AsString
                     ,query_lotes.FieldByName('P2LM_DTVCTO').AsDateTime
                  ,'' // lote re
                  ,'' // obs

                     );


 }

{
   fGer_BaixarLotes(mVenda_GP.mped1_Filial, 1,0,trunc(pCodEmp),trunc(pCodEmp_Filial),mVenda_GP.mPd_EstNor,mVenda_GP.mPd_EstCons
                       ,mVenda_GP.mPd_EstVenda,mVenda_GP.mPd_EstTerc
                       ,Query_Lotes.fieldbyName('P2LM_CODPRO').asstring
                       ,Query_Lotes.fieldbyName('P2LM_LOTE').asstring
                       ,Query_Lotes.fieldbyName('P2LM_QTD').AsFloat
                       ,Query_Lotes.fieldbyName('P2LM_DTVCTO').asDateTime);
 }
   if ((mVenda_GP.mPed1_Tipo_Ped=8) or (mVenda_GP.mPed1_Tipo_Ped=12)
   //or (mVenda_GP.mPed1_Tipo_Ped=29)
   or (cds_aliquotasrequer_pedori.AsInteger>0)) then
      begin
      fBaixarDevolucao(1,Query_Lotes.fieldbyName('P2LM_CODPRO').AsString
                        ,Query_Lotes.fieldbyName('P2LM_LOTE').asstring
                        ,FormatDateTime(fdt2,Query_Lotes.fieldbyName('P2LM_DTVCTO').asDateTime)
                        ,Query_Lotes.fieldbyName('P2LM_QTD').AsFloat);
      end;

   Query_Lotes.Next;
   end;
FreeAndNil(Query_Lotes);
result:=true;
end;


