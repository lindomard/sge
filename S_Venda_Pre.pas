function TFrm_Venda_Pre.fGeraFPgto(pTipo,pChave,pLotseq,pCodEmp: Integer): Boolean;

var
query_fpgto: Tquery;
mCodFP: String;
mNomeFP: String;

begin

mCodFP:='0';
if flfilpad(0,'_VENDA_PRE','') then
   begin
   if DM4.Tb_FilPad2.Locate('FPCOMP','CODFP',[]) then
      mCodFP:=DM4.Tb_FilPad2FPVALOR.AsString;
   end;
edt_codfp.Text:=fdeixanum(edt_codfp.text);
if fLCadFP(0,edt_codfp.Text,'') then
   mNomeFP:=DM1.Tb_FPFPDESC.AsString
else
   mNomeFP:='DINHEIRO';


query_fpgto:=Tquery.create(nil);
query_fpgto.DatabaseName:='SG_ASSOC';
query_fpgto.Sql.Add('insert into CADPFP '
                   +'(PFPCODEMP,PFPCHAVE,PFPLOTSEQ '
                   +',PFPSEQ,PFPQTDPARC,PFPFORMA,PFPVALOR,PFPBAIXA'
                   +',PFPNOMFOR,PFPPRAZO,PFPDATA'
                   +',PFPID_NEW '
                   +') Select '
                   +'P1VCODEMP '
                   +',P1VCHAVE '
                   +',P1VLOTSEQ '
                   +',P1VSEQ '
                   +',1 AS QTDFP '
                   +','+mCodFP+' AS PFPFORMA '
                   +',P1VVALOR '
                   +','+QuotedStr('N')
                   +','+QuotedStr(mNomeFP)
                   +',0 as PFPRAZO '
                   +',P1VDATAV '
                   +',CADPFP_SEQ.NEXTVAL '
                   +' from CADP01V '
                   +' where P1VCODEMP='+IntToStr(pCodEmp)
                   +' and P1VCHAVE='+IntTosTr(pChave)
                   +' and P1VLOTSEQ='+IntTosTr(pLotseq));
try
   query_fpgto.ExecSQL;
   fdm1StartCommit;
   if ptipo=0 then
      fLerFormaPag(0);
   result:=true;
except
   query_fpgto.sql.savetofile(mpastatemp +'sql01.txt');
   end;

end;


function TFrm_Venda_Pre.fLerFormaPag(pTipo: Integer): Boolean;
var
mQtd_parc: Integer;
query_temp: TQuery;
begin
Tb_FP_pre.Close;
Tb_FP_pre.SQL.Clear;
Tb_FP_pre.SQL.Add('SELECT min(PFPCODEMP) as PFPCODEMP,PFPCHAVE,PFPLOTSEQ AS PFPCHAVE_ANO'
                  +',PFPID_NEW,PFPID_PED01_NEW,max(PFPSEQ) AS PFPPARCELA '
                 +',max(PFPQTDPARC) AS PFPQTDPARC,0 AS PFPCODBCO_BOL '
                 +',PFPFORMA AS PFPCODFP '
                 +',PFPNOMFOR AS PFPNOMFP'
                 +',PFPDATA '
                 +',PFPPRAZO,PFPNUMDOC,PFPBANCO AS PFPCODBCO_DOC '
                 +',PFPSERIE AS PFPSERIE_DOC,PFPCC AS PFPCC_DOC '
                 +',PFPCOMP AS PFPCOMP_DOC,PFPAGENCIA AS PFPAGENCIA_DOC '
                 +',PFPEMITENTE AS PFPEMITENTE_DOC '
                 +',PFPVINCULO AS PFPVINCULO_DOC '
                 +',PFPCNPF AS PFPCNPJ_CPF_DOC '
                 +',PFPRG AS PFPIE_RG '
                 +',sum(PFPVALOR) as PFPVALOR '
                 +',max(PFPBAIXA) AS PFPBAIXA '
                  +' from CADPFP ');

if ptipo=1 then
   Tb_FP_pre.SQL.Add(' where PFPCODEMP=-9999')
else
   begin
   Tb_FP_pre.SQL.Add(' where (PFPCODEMP='+IntToStr(mVenda_GP.mPed1_Codemp_ini)
                    +' or PFPCODEMP='+IntToStr(mVenda_GP.mPed1_Codemp_fin)+')');
   end;

Tb_FP_pre.SQL.Add(' and PFPCHAVE='+IntTosTr(mVenda_GP.mped1_Chave)
             +' and PFPLOTSEQ='+IntTosTr(mVenda_GP.mped1_Chave_ano));


Tb_FP_pre.SQL.Add('Group by PFPCHAVE,PFPID_NEW,PFPID_PED01_NEW,PFPLOTSEQ  '
                 +',PFPFORMA '
                 +',PFPNOMFOR'
                 +',PFPDATA '
                 +',PFPPRAZO,PFPNUMDOC,PFPBANCO '
                 +',PFPSERIE,PFPCC '
                 +',PFPCOMP,PFPAGENCIA '
                 +',PFPEMITENTE '
                 +',PFPVINCULO  '
                 +',PFPCNPF  '
                 +',PFPRG  '
                +' order by PFPDATA,PFPPARCELA ');

//Tb_FP_pre.SQL.SaveToFile(mpastatemp +'sqlfp.txt');

try
   Tb_FP_pre.Open;
   result:=true;
except
   Tb_FP_pre.SQL.SaveToFile(mpastatemp +'sqlfp.txt');
   if fVerificaRedeAtiva(true) then
      begin
      MessageDlg('Erro 963 frm_venda_pre paf_cadpfp_pre',mterror,[mbOk],0);
      result:=false;
      exit;
      end
   else
      begin
      fFecharTudo(0);
      result:=false;
      exit;
      end;
   end;
mQtd_parc:=Tb_FP_pre.RecordCount;

if mQtd_parc>1 then
   lbl_restamFP.Caption:='Existem '+Inttostr(mQtd_Parc)+' Parcelas '
else
   lbl_restamFP.Caption:='Existe '+Inttostr(mQtd_Parc)+' Parcela ';


if Tb_fp_pre.IsEmpty then
   result:=false
else
   result:=true;
if mVenda_GP.mPed1_Emidoc<>1 then
   begin
   if (Tb_FP_pre.IsEmpty) then
      begin
      query_temp:=TQuery.Create(nil);
      query_temp.DatabaseName:='SG_ASSOC';
      Query_Temp.SQL.Clear;
      Query_Temp.SQL.Add('Select sum(qtd), min(CODEMP) AS CODEMP, max(CODEMP_FILIAL) AS CODEMP_FILIAL from  '
                        +'(SELECT count(*) as qtd, min(P2CODEMP) AS CODEMP, max(P2CODEMP) AS CODEMP_FILIAL,'+QuotedStr('ped02')+' FROM CADP02 '
                        + ' WHERE P2CHAVE=:CHAVE and P2ORDEM=:ORDEM and P2LOTSEQ=:LOTSEQ '
                        +' and (P2CODEMP=:CODEMP OR P2CODEMP=:CODEMP_FILIAL) '
                        +' union '
                        +' SELECT count(*) as qtd, min(P2SCODEMP) AS CODEMP, max(P2SCODEMP) AS CODEMP_FILIAL,'+QuotedStr('ped02s')+' FROM CADP02s WHERE P2SCHAVE=:CHAVE '
                        +' and P2SORDEM=:ORDEM and P2SLOTSEQ=:LOTSEQ '
                        +' and (P2SCODEMP=:CODEMP OR P2SCODEMP=:CODEMP_FILIAL) )');
     Query_Temp.ParamByName('LOTSEQ').Value   :=mVenda_GP.mPed1_Chave_ano;
     Query_Temp.ParamByName('CHAVE').Value    :=mVenda_GP.mPed1_Chave;
     Query_Temp.ParamByName('ORDEM').Value    :=01;
     Query_Temp.ParamByName('CODEMP').Value   :=mVenda_GP.mPed1_Codemp;
     if mVenda_GP.mPed1_Codemp>100 then
        Query_Temp.ParamByName('CODEMP_FILIAL').Value:=mVenda_GP.mPed1_Codemp-100
     else
        Query_Temp.ParamByName('CODEMP_FILIAL').Value:=mVenda_GP.mPed1_Codemp+100;
     try
        query_temp.Open;
     except
        end;
     if (query_temp.fields[0].asinteger>0) and (mQtdTentativas<5) then
        begin
        mQtdTentativas:=mQtdTentativas+1;
        if (query_temp.fieldbyName('CODEMP').asinteger>0) and (query_temp.fieldbyName('CODEMP').asinteger<100) then
           fGravarPedido(1,0);
        if (query_temp.fieldbyName('CODEMP_FILIAL').asinteger>100) then
           fGravarPedido(1,100);
        if mVenda_GP.mped1_QtdParc<=0 then
           mVenda_GP.mped1_QtdParc:=1;
        if length(mVenda_GP.mPed1_Parcelas)<4 then
           mVenda_GP.mPed1_Parcelas:=insere('0','0',4);
        if length(mVenda_GP.mPed1_PrzNovos_001)<4 then
           mVenda_GP.mPed1_PrzNovos_001:='||||||||||||';
        if length(mVenda_GP.mPed1_PrzNovos_101)<4 then
           mVenda_GP.mPed1_PrzNovos_101:='||||||||||||';


        mVenda_GP.mPed1_QtdParc_ant:=mVenda_GP.mPed1_QtdParc;
        fRecalcularPedido(3);
        fTotais(0);
        fLerFormaPag(0);
        end;
      freeandnil(query_temp);

      end;
   end;
end;




