procedure TFrm_Venda_Pre.bbExcluir_itemClick(Sender: TObject);
var
mqtdfatemp: real;
begin
if (not tb_ped02_pre.Active) or (tb_ped02_preP2QTD.IsNull) or (sbnGravar.Enabled=false)  then
   exit;

if (mPed1_Origem_DeOutro='S') then
   begin
   Messagedlg('Pedido de Origem de Emprestimo de Mercadorias não podera excluir itens!',mtWarning,[mbOk],0);
   exit;
   end;

mqtdfatemp:=fQuantidadeEmprestimoFaturado(tb_ped02_preP2CODPRO.asfloat);
if mqtdfatemp>0 then
   begin
   MessageDlg('Ja foi faturado '+floattostr(mqtdfatemp)+' quantidade nao pode ser menor que faturada!',mtWarning,[mbOk],0);
   exit;
   end;

if Tb_Ped02_pre.State in [dsedit,dsinsert] then
   Tb_Ped02_pre.Cancel;

if Application.MessageBox(pchar('Quer Realmente Excluir '+tb_ped02_preP2CODPRO.AsString+'-'+tb_ped02_prePDNOME.AsString+' Quantidade: '+formatFloat(mCasQtd, tb_ped02_preP2QTD.AsFloat)),'',MB_YESNO+MB_DEFBUTTON2)<>mrYes then
   exit;
fLerCadp02_Lotes(Tb_Ped02_preP2Item.AsInteger,ValFloat(Tb_Ped02_preP2CODPRO.AsString));

tb_ped02_pre.Delete;
end;

