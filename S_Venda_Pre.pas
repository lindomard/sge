function TFrm_Venda_Pre.fValidarDocumentos(pCodCli: Real): String;
var
query_cli:  tQuery;
mRetorno:String;
begin
if (mCodCli_ValAnvisa=pCodcli) then
   begin
   result:='';
   exit;
   end;

if  (pCodcli>0) and  ( (DM1.Tb_PargerPVISA.Value=1) or (DM1.Tb_PargerPANVISA.Value=1) or (DM1.Tb_PargerPVALIDAR_CERT_TECNICO.Value=1) ) then
   begin
   query_cli :=  tQuery.create(nil);
   query_cli.databaseName:=DM1.SG_ASSOC.DatabaseName;
   query_cli.SQL.add('select CDTVALV,CDTANVISA,CCERTTECNICO_DTVCTO from CADCLI WHERE CCODCLI='+FloatToStr(pCodCli));
   try
      query_cli.open;
   except on e : exception do
      begin
      ex_erroSql_Novo(query_cli,38419,'func Erro:'+e.Message ,'CADCLI');
      query_cli.close;
      FreeAndNil(query_cli);
      result:='';
      exit;
      end;
      end;
   if (DM1.Tb_PargerPVISA.Value=1) and  ( (query_cli.fieldbyname('CDTVALV').AsDatetime>pDatanula) and
       (query_cli.fieldbyname('CDTVALV').AsDatetime<Date ))  then
       mRetorno:=mRetorno+'Data Alv. Mun. Venc. '+FormatDateTime('dd/mm/yyyy', query_cli.fieldbynaMe('CDTVALV').AsDateTime) + mQuebraLinha;

   if (DM1.Tb_PargerPANVISA.Value=1) and  ( (query_cli.fieldbyname('CDTANVISA').AsDatetime>pDatanula)
       and (query_cli.fieldbyname('CDTANVISA').AsDatetime<Date)  )  then
       mRetorno:=mRetorno+'Data Certificado da Anvisa Vencido. '+FormatDateTime('dd/mm/yyyy', query_cli.fieldbynaMe('CDTANVISA').AsDateTime) + mQuebraLinha;

   if (DM1.Tb_PargerPVALIDAR_CERT_TECNICO.Value=1) and ( (query_cli.fieldbyname('CCERTTECNICO_DTVCTO').AsDatetime>pDatanula)
      and (query_cli.fieldbyname('CCERTTECNICO_DTVCTO').AsDatetime<Date))  then
       mRetorno:=mRetorno+'Data Validade Certificado Técnico Vencimento '+FormatDateTime('dd/mm/yyyy', query_cli.fieldbynaMe('CCERTTECNICO_DTVCTO').AsDateTime) + mQuebraLinha;
   query_cli.close;
   freeandnil(query_cli);

   end;
result:=mRetorno;


end;




