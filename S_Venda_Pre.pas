procedure TFrm_Venda_Pre.btn_Retornar_ValoresAdicionaisClick(
  Sender: TObject);
var
query_atu: TQuery;
mChave_old: Integer;
begin
if flfilpad(-9,'_VENDA_PRE','VALDIC_'+Formatfloat('000000', mVenda_GP.mped1_Chave)) then
   begin
   mChave_old:=valint(DM4.Tb_FilPad2FPVALOR.AsString);
   IF mChave_old>0 then
      begin
      query_atu:=TQuery.Create(nil);
      query_atu.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
      query_atu.SQL.Add('update cadp02 nov set p2preco=nvl( (select p2preco from old_cadp02 old where p2codnov=:chave_old '
                       +' and old.p2chave=nov.p2chave and  old.p2lotseq=nov.p2lotseq '
                       +' and old.p2codemp=nov.p2codemp and old.p2item=nov.p2item),p2preco) '
                       +' where P2CODEMP=:CODEMP and P2CHAVE=:CHAVE and P2LOTSEQ=:LOTSEQ ');
      query_atu.ParamByName('CHAVE_OLD').AsInteger:=mChave_old;
      query_atu.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp;
      query_atu.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
      query_atu.ParamByName('LOTSEQ').AsInteger:=mVenda_GP.mPed1_Chave_ano;
      try
