      begin
      Query_Item:=TQuery.Create(nil);
      Query_Item.DatabaseName:='SG_ASSOC';
      Query_Item.SQL.Clear;
      Query_Item.SQL.Add('Select sum(P2TOTDES-P2VICMSDES) as TOTDES '
                     +',sum(P2VALPIS) as valpis '
                     +',sum(P2COFINS) as valcofins '
                     +',sum(P2VALIPI) as valipi '
                     +',sum(P2IMP_IMP_VII) as valii '
                     +',sum(P2ICMSN) as valicms '

                     +',sum(P2BASEN) as base_icms '
                     +',sum(P2VDESPACESRAT) as voutros '

                     +'  from CADP02 where '
                     +' P2CODEMP       =:CODEMP '
                     +' and P2CHAVE    =:CHAVE '
                     +' and P2LOTSEQ   =:LOTSEQ '
                     +' and P2ITEM     =:ITEM ');
      query_item.ParamByName('CODEMP').AsInteger     := mVenda_GP.mPed1_Codemp;
      query_item.ParamByName('CHAVE').AsInteger      := mVenda_GP.mped1_Chave;
      query_item.ParamByName('LOTSEQ').AsInteger     := mVenda_GP.mPed1_Chave_ano;
      query_item.ParamByName('ITEM').AsInteger       := Tb_Ped02_preP2ITEM.AsInteger;
      query_item.Open;
      mvaldesc_lido:=Query_Item.fieldbyname('TOTDES').AsFloat;
      Tb_Ped02_pretotdes.AsFloat        :=Query_Item.fieldbyname('TOTDES').AsFloat;
      Tb_Ped02_prevalor_ii.AsFloat      :=Query_Item.fieldbyname('valii').AsFloat;
      Tb_Ped02_prevalor_cofins.AsFloat  :=Query_Item.fieldbyname('valcofins').AsFloat;
      Tb_Ped02_prevalor_pis.AsFloat     :=Query_Item.fieldbyname('valpis').AsFloat;
      Tb_Ped02_prevalor_icms.AsFloat    :=Query_Item.fieldbyname('valicms').AsFloat;
      Tb_Ped02_prevalor_ipi.AsFloat     :=Query_Item.fieldbyname('valipi').AsFloat;

      Tb_Ped02_preicms_base.AsFloat     :=Query_Item.fieldbyname('base_icms').AsFloat;
      Tb_Ped02_prevoutro.AsFloat        :=Query_Item.fieldbyname('voutros').AsFloat;




      FreeAndNil(query_item);
      mItem_lido:=Tb_Ped02_preP2ITEM.AsInteger;
      end;
//   if (Tb_Ped02_pretotdes.AsFloat=0) then
//      Tb_Ped02_pretotdes.AsFloat  :=mvaldesc_lido;
{
   end
else
   Tb_Ped02_pretotdes.AsFloat  :=Tb_Ped02_preP2TOTDES.AsFloat;
}

Tb_Ped02_pretotdes.AsFloat  :=Tb_Ped02_preP2TOTDES.AsFloat;

Tb_Ped02_prevalor_totcalc.AsFloat:=Tb_Ped02_prevalor_bruto.AsFloat-Tb_Ped02_pretotdes.AsFloat;

if Tb_Ped02_preP2PCOMIS.AsFloat = 0 then
   Tb_Ped02_prevalor_comis.AsFloat:= 0
else
   Tb_Ped02_prevalor_comis.AsFloat:=Arredonda( (Tb_Ped02_prevalor_totcalc.AsFloat  *  Tb_Ped02_preP2PCOMIS.AsFloat / 100) , 2);



