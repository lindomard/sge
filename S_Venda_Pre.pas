function TFrm_Venda_Pre.fValidarConferenciaEletronica: boolean;
begin
result:=true;
if (mVenda_GP.mPed1_DatCon>pdatanula) and (mVenda_GP.mped1_codcon>0) then
   begin

   mValidarSenha.pTipo:=0;
   mValidarSenha.pCodusr:=codusr;
   mValidarSenha.pCodSen:=73;
   mValidarSenha.pCodCli:=mVenda_GP.mPed1_CodCli;

   mValidarSenha.pCodEmp:=codemp;
   mValidarSenha.pLotSeq:=ls_numped;
   mValidarSenha.pChave :=mVenda_GP.mped1_Chave;
   mValidarSenha.pOrdem :=1;
   mValidarSenha.pTexto :='Senha para Alterar o Pedido após Conferencia Eletronica.'
                            +' Chave do Pedido '+FloatTostr(mVenda_GP.mped1_Chave);
   mValidarSenha.pChave_St:='';
   mValidarSenha.pDesc_requisitado :=0;
