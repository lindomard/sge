function tFrm_Venda_Pre.fincluirLotes(pChave,pLotSeq,pCodemp_ini,pCodEmp_fin: Integer): Boolean;
var
Query_Lotes:TQuery;
begin
Query_Lotes:=TQuery.create(nil);
Query_Lotes.DatabaseName:='SG_ASSOC';
Query_Lotes.close;
Query_Lotes.SQL.Clear;
Query_Lotes.SQL.Add('Insert into CADP02_LOTES ('
                   +' P2LM_ID_NEW '
                   +',P2LM_CODEMP '
                   +',P2LM_ID_PED02_NEW '
                   +',P2LM_CODPRO '
                   +',P2LM_LOTSEQ '
                   +',P2LM_CHAVE '
                   +',P2LM_ITEM '
                   +',P2LM_LOTE '
                   +',P2LM_DTVCTO '
                   +',P2LM_DTFAB '
                   +',P2LM_QTD '
                   +',P2LM_QTDDEV ) '
                   +'(SELECT  CADP02_LOTES_SEQ.NEXTVAL '
                   +',P2CODEMP '
                   +',P2ID_NEW '
                   +',P2CODPRO '
                   +',P2LOTSEQ '
                   +',P2CHAVE '
                   +',ITEM '
                   +', LOTE '
                   +',P2DTVCTO '
                   +',P2DTFAB '
                   +',P2QTD '
                   +',QTDDEV '
                   +' FROM ('
                   +' Select P2CODEMP '
                   +',P2ID_NEW'
                   +',P2CODPRO '
                   +',P2LOTSEQ '
                   +',P2CHAVE '
                   +',min(P2ITEM) AS ITEM '
                   +',P2LOTE AS LOTE '
                   +',MAX(P2DTVCTO) AS P2DTVCTO '
                   +',NULL AS P2DTFAB '
                   +',sum(P2QTD) AS P2QTD'
                   +',sum(P2QTDDEV) AS QTDDEV '
                   +' from CADP02 where '
                   +' (P2CODEMP=:CODEMP or P2CODEMP=:CODEMP_FILIAL) '
                   +' and P2LOTSEQ=:LOTSEQ '
                   +' and P2CHAVE=:CHAVE '
                   +' and P2ORDEM=:ORDEM ');
 Query_Lotes.SQL.Add(' Group by P2CODEMP '
                   +',P2CODPRO '
                   +',P2LOTSEQ '
                   +',P2CHAVE,P2ID_NEW '
                   +',P2LOTE ');
 Query_Lotes.SQL.Add(' )) ');
Query_Lotes.ParamByName('CODEMP').AsInteger       :=pcodemp_ini;
Query_Lotes.ParamByName('CODEMP_FILIAL').AsInteger:=pcodemp_fin;
Query_Lotes.ParamByName('LOTSEQ').AsInteger       :=pLotseq;
Query_Lotes.ParamByName('CHAVE').AsInteger        :=pChave;
Query_Lotes.ParamByName('ORDEM').AsInteger:=01;


try
   Query_Lotes.ExecSQL;
   fdm1StartCommit;
except on e : exception do
   ex_erroSql_Novo(Query_Lotes,10251,'venda_pre'+e.Message,'CADP01');
   end;


FreeAndNil(Query_Lotes);
result:=true;
end;



