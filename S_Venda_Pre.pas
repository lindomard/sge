Query_obs.ParamByName('P1ORC_CHAVE').AsInteger:=mVenda_GP.mPed1_Chave;
try
   Query_obs.Open;
except
   end;
if Query_obs.IsEmpty then
   begin

   Query_obs.Close;
   Query_obs.SQL.Clear;
   Query_obs.SQL.Add('Insert into CADP01_ORC ('
                     +' P1ORC_CODEMP '
                     +',P1ORCID_NEW '
                     +',P1ORCID_PED01_NEW '
                     +',P1ORC_LOTSEQ '
