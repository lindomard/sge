procedure TFrm_Venda_Pre.edt_codbco101Enter(Sender: TObject);
begin
mPed1_CodBco101_Ant:=ValInt(edt_codbco101.Text);
mEventoPendente:='edt_codbco';

end;

procedure TFrm_Venda_Pre.edt_codbco101Exit(Sender: TObject);
begin
if valint(edt_codbco101.Text)=0 then
   edt_codbco101.Text:='';
if valint(edt_codbco101.Text)<>0 then
   begin
   if not flcadbco(1,0,0,edt_codbco101.Text) then
      begin
      if edt_codbco101.Enabled then
         begin
         verteclado(0);
         MessageDlg('Código do Banco não Cadastrado!',mtWarning,[mbOk],0);
         if sbnGravar.enabled then
            edt_codbco101.SetFocus;
         exit;
         end;
      end;
   end;

mVenda_GP.mPed1_CodBco101:=valint(edt_codbco101.Text);
fAtualizaBanco;
fTarifaBancaria;

mped_Alterou_Cab:=true;



end;

procedure TFrm_Venda_Pre.edt_codbco101KeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
