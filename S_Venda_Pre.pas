procedure TFrm_Venda_Pre.sbnGerenciadorTefClick(Sender: TObject);
var
formPaygoApi : TPayGoAPI;
retornoPaygo: TRetornoPayGo;
mImpressora: String;
begin
formPaygoApi :=TPayGoAPI.Create;

retornoPaygo :=    formPaygoApi.FuncoesAdministativas('VISA');
if (retornoPaygo.Aprovado) then
    begin
// inicio
    mImpressora := fRetornaImpressoraOnline('NFCE');
    if mImpressora='' then
       begin
       Application.createform(Tfrm_impressora_escolher, frm_impressora_escolher);
       frm_impressora_escolher.showmodal;
       mImpressora:=frm_impressora_escolher.mimpressora_selecionada;
       freeandnil(frm_impressora_escolher);
       end;
    IF mImpressora<>'' then
       begin
       Application.createform(Tfrm_nfce_impressao, frm_nfce_impressao);
       Frm_NFCE_Impressao.fImprimirGeralComprovante(retornoPaygo.Itens,mImpressora,'Administrativas');
       freeandnil(Frm_NFCE_Impressao);
       end
    else
       begin
       ExibirToast('Funcoes Administrativas: '+ retornoPaygo.MensagemTrasacao);
       end;
    end;
end;


