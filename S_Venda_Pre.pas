Function tFrm_Venda_pre.fValidarValorMinimo: boolean;
begin
result:=true;

if ((mVenda_gp.mPed1_Tipo_Ped=9) and (mPed_limite_emprestimo>0) and (cb_tipent.itemindex<>0)) then
    result:=true
else
   begin
   if fLerGenerico_query('CADPV','PVVALORMIN','PVCODPV=0'+inttostr(mVenda_GP.mPed1_CodPV)+' and PVCODTIP='+QuotedStr(mVenda_GP.mPed1_TabPV),query_consulta) then
      begin
      if query_consulta.fieldbyname('PVVALORMIN').asfloat>valfloat(edt_totliq.text) then
         begin
         MessageDlg('Plano de Vendas válido apenas para pedidos com valores a partir de '+formatfloat(mcasas, query_consulta.fieldbyname('PVVALORMIN').asfloat)
                 ,mtWarning,[mbOk],0);
         mGravandoPedido := false;
         result:=false;
         exit;
         end;
      end;
   end;
end;


