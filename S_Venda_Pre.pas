procedure TFrm_Venda_pre.fAtualizarCadpfp(ptipo: Integer); // 0-tb_fp_pre 1-Tb_pv2
begin
if ptipo=1 then
   begin

   DM1.Tb_PV2.First;
   mVenda_GP.mPed1_Parcelas:=insere(DM1.Tb_PV2PV2PRAZO.AsString,'0',4);
    mVenda_GP.mPed1_PrzNovos_001:='P|'+DM1.Tb_PV2PV2PRAZO.AsString+'|||||||||||';
    mVenda_GP.mPed1_PrzNovos_101:='P|'+DM1.Tb_PV2PV2PRAZO.AsString+'|||||||||||';
   DM1.Tb_PV2.Next;
   while not DM1.Tb_PV2.Eof do
      begin
      mVenda_GP.mPed1_Parcelas:=mVenda_GP.mPed1_Parcelas+insere( DM1.Tb_PV2PV2PRAZO.AsString,'0',4);
      mVenda_GP.mPed1_PrzNovos_001:=mVenda_GP.mPed1_PrzNovos_001+'P|'+DM1.Tb_PV2PV2PRAZO.AsString+'|||||||||||';
      mVenda_GP.mPed1_PrzNovos_101:=mVenda_GP.mPed1_PrzNovos_101+'P|'+DM1.Tb_PV2PV2PRAZO.AsString+'|||||||||||';
      DM1.Tb_PV2.Next;
      end;
   mVenda_GP.mped1_QtdParc:=DM1.Tb_PV2.RecordCount;
   mVenda_GP.mPed1_AjustaFP :='S';
   end
else
   begin
   Tb_FP_pre.First;
   mVenda_GP.mPed1_Parcelas:=insere(Tb_FP_prePFPPRAZO.AsString,'0',4);
   mVenda_GP.mPed1_PrzNovos_001:='P|'+Tb_FP_prePFPPRAZO.AsString+'|||||||||||';
   mVenda_GP.mPed1_PrzNovos_101:='P|'+Tb_FP_prePFPPRAZO.AsString+'|||||||||||';

   Tb_FP_pre.Next;
   while not Tb_FP_pre.Eof do
      begin
      mVenda_GP.mPed1_Parcelas:=mVenda_GP.mPed1_Parcelas+insere(Tb_FP_prePFPPRAZO.AsString,'0',4);
      mVenda_GP.mPed1_PrzNovos_001:=mVenda_GP.mPed1_PrzNovos_001+'P|'+Tb_FP_prePFPPRAZO.AsString+'|||||||||||';
      mVenda_GP.mPed1_PrzNovos_101:=mVenda_GP.mPed1_PrzNovos_101+'P|'+Tb_FP_prePFPPRAZO.AsString+'|||||||||||';
      Tb_FP_pre.Next;
      end;
   mVenda_GP.mped1_QtdParc:=Tb_FP_pre.RecordCount;
   mVenda_GP.mPed1_AjustaFP :='S';
   end;

end;

