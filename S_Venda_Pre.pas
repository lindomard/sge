procedure TFrm_Venda_pre.fCancelarAlteracoes(pDadosPedidosOld: tDadosPedidoOld);
var
mChaveOld: Integer;
query_old: tQuery;
   procedure fVoltarValoresOld;
   var
   query_voltar_old: tQuery;
   begin
   query_voltar_old:=tQuery.create(nil);
   query_voltar_old.databaseName:=DM1.SG_ASSOC.DatabaseName;
   query_voltar_old.SQL.clear;
   query_voltar_old.SQL.Add('Update CADP01 set '
                           +' P1CODCLI=:P1CODCLI'
                           +',P1BANCO=:P1BANCO '
                           +',P1TABPV=:P1TABPV '
                           +',P1CODPV=:P1CODPV '
                           +' where P1CHAVE = :P1CHAVE '
                           +' and   P1CODEMP = :P1CODEMP '
                           +' and P1LOTSEQ = :P1LOTSEQ ');


   query_voltar_old.ParamByName('P1CODCLI').AsFloat := query_old.fieldByName('P1CODCLI').AsFloat;
   query_voltar_old.ParamByName('P1BANCO').AsFloat  := query_old.fieldByName('P1BANCO').AsFloat;
   query_voltar_old.ParamByName('P1TABPV').AsString := query_old.fieldByName('P1TABPV').AsString;
   query_voltar_old.ParamByName('P1CODPV').AsFloat  := query_old.fieldByName('P1CODPV').AsFloat;


   query_voltar_old.ParamByName('P1CHAVE').AsFloat  := pDadosPedidosOld.pChave;
   query_voltar_old.ParamByName('P1CODEMP').AsFloat  := pDadosPedidosOld.pCodEmp;
   query_voltar_old.ParamByName('P1LOTSEQ').AsFloat  := pDadosPedidosOld.pLotSeq;


   try
      query_voltar_old.ExecSQL;
      fdm1StartCommit;
   except on e : exception do
      begin
      ex_erroSql_Novo(query_voltar_old,31723,'func Erro:'+e.Message ,'OLD_CADP01');
      query_voltar_old.close;
      freeandnil(query_voltar_old);
      exit;
      end;
      end;
   query_voltar_old.Close;
   freeandnil(query_voltar_old);
   end;
begin
query_old:=tQuery.create(nil);
query_old.databaseName:=DM1.SG_ASSOC.DatabaseName;
query_old.SQL.clear;
query_old.SQL.add('select P1CODNOV,P1TOTALL,P1CODCLI,P1CODVEN,P1SUBMOD,P1TABPV,P1BANCO,P1TIPO,P1CODPV '
                +' FROM OLD_CADP01 '
                +' where P1LOTSEQ='+inttoStr(pDadosPedidosOld.pLotSeq)
                +' and p1chave='+inttostr(pDadosPedidosOld.pChave)
                +' and (p1codemp='+inttostr(pDadosPedidosOld.pCodemp)+' or p1codemp = '
                +inttostr(iif(pDadosPedidosOld.pcodemp>100, pDadosPedidosOld.pcodemp-100, pDadosPedidosOld.pcodemp+100))+')'
                +' order by P1CODNOV DESC ');

query_old.sql.text:='Select * FROM ('
                  +query_old.SQL.text
                  +' ) where rownum<2';
try
   query_old.Open;
except on e : exception do
   begin
   ex_erroSql_Novo(query_old,31714,'func Erro:'+e.Message ,'OLD_CADP01');
   query_old.close;
   freeandnil(query_old);
   exit;
   end;
   end;
if not query_old.IsEmpty then
   begin
   if (query_old.FieldByName('P1TIPO').AsInteger<>pDadosPedidosOld.pTipo)
       or (arredonda(query_old.FieldByName('P1TOTALL').AsFloat,2)<>arredonda(pDadosPedidosOld.pValor,2))
       or (query_old.FieldByName('P1SUBMOD').AsString<>pDadosPedidosOld.pSubMod) then
      begin
      query_old.close;
      freeandnil(query_old);
      exit;
      end;
   if (query_old.FieldByName('P1CODCLI').AsFloat<>pDadosPedidosOld.pCodCli)
      or (query_old.FieldByName('P1CODPV').AsFloat<>pDadosPedidosOld.pCodPv)
      or (query_old.FieldByName('P1TABPV').AsString<>pDadosPedidosOld.pTabPv)
      or (query_old.FieldByName('P1BANCO').AsFloat<>pDadosPedidosOld.pCodBco) then
      fVoltarValoresOld;
   end;
query_old.close;
freeandnil(query_old);

end;
