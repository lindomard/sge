function TFrm_Venda_Pre.fVerificaRestricaonaTrocadeCliente(pcodcli_nov: real): boolean;
var
query_validar: TQuery;
form_ocorrencias: TFrm_Ocorrencias;

begin
result:=true;

if (mVenda_GP.mped1_Chave=0) or (mlocalizando_pedido=true) then
   exit;
query_validar:=TQuery.Create(nil);
query_validar.DatabaseName:=DM1.sg_assoc.databasename;
query_validar.sql.add('SELECT P2CODPRO,PDNOME,PDMARCA,P2QTD,P2ITEM from CADP02,CADP01,CADCLI,CADPRO '
                     +' where P1CODEMP=0'+floattostr(mVenda_GP.mPed1_Codemp)
                     +' and P1CHAVE=0'+floattostr(mVenda_GP.mped1_Chave)
                     +' and P1LOTSEQ=0'+floattostr(mVenda_GP.mPed1_Chave_ano)
                      +' and P2LOTSEQ=P1LOTSEQ '
                      +' and P2CODEMP=P1CODEMP '
                      +' and P2CHAVE=P1CHAVE '
                      +' and PDCODPRO=P2CODPRO '
                      +' and P2LOTSEQ=P1LOTSEQ '
                      +' and CCODCLI='+floattostr(pcodcli_nov)+' and CBLOQCONTROLADO='+quotedstr('S')
                      +' and NVL(PDCODCON,0)>0 ');
// ex_erroSql_Novo(query_validar,28470,'SGE','CADP01');

try
    query_validar.open;
except on e : exception do
    ex_erroSql_Novo(query_validar,28470,'SGE','CADP01');
    end;
if query_validar.IsEmpty=false then
   begin
   Application.CreateForm(TFrm_Ocorrencias, form_ocorrencias);
   Form_Ocorrencias.mErros:=false;
   While not query_validar.eof do
      begin
      Form_Ocorrencias.adicionaItemListView('Produto '+query_validar.fieldbyname('PDNOME').asstring+'-'
                                     +query_validar.fieldbyname('P2CODPRO').asstring
                                    +' Item: '+query_validar.fieldbyname('P2ITEM').asstring
                                    +' possui controle especial e o cliente nao aceita!');
      Form_Ocorrencias.mErros:=true;
      query_validar.Next;
      end;
   form_ocorrencias.ShowModal;
   freeandnil(form_ocorrencias);
   result:=false;
   end;
query_validar.close;
query_validar.sql.clear;

query_validar.sql.add('SELECT P2CHAVE,P2CODPRO,PDCODGRU,PDNOME FROM CADP02,CADPRO,CADCLI_BLQ_GRU_PRO '
                     +' where P2CODEMP=0'+floattostr(mVenda_GP.mPed1_Codemp)
                     +' and P2CHAVE=0'+floattostr(mVenda_GP.mped1_Chave)
                     +' and P2LOTSEQ=0'+floattostr(mVenda_GP.mPed1_Chave_ano)
                     +' AND PDCODPRO=P2CODPRO '
                     +' AND CBGP_CODCLI='+FloatToStr(pcodcli_nov)
                     +' and PDCODGRU=CBGP_CODGRU ');

try
    query_validar.open;
except on e : exception do
    ex_erroSql_Novo(query_validar,28470,'SGE','CADP01');
    end;
if query_validar.IsEmpty=false then
   begin
   Application.CreateForm(TFrm_Ocorrencias, form_ocorrencias);
   Form_Ocorrencias.mErros:=false;
   While not query_validar.eof do
      begin
      Form_Ocorrencias.adicionaItemListView('Produto '+query_validar.fieldbyname('PDNOME').asstring+'-'
                                     +query_validar.fieldbyname('P2CODPRO').asstring
                                    +' Código do Grupo: '+query_validar.fieldbyname('PDCODGRU').asstring
                                    +' Esta com venda Restrita para este cliente!');
      Form_Ocorrencias.mErros:=true;
      query_validar.Next;
      end;
   form_ocorrencias.ShowModal;
   freeandnil(form_ocorrencias);
   result:=false;
   end;

query_validar.close;
freeandnil(query_validar);
end;



