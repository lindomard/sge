function TFrm_Venda_Pre.fTestarEstoqueMinimo(pCodPro: real): boolean;


    function fJaEstaLiberado(pIdPed02: Integer): boolean;
    var
    qr_cadp02_libbloq: tQuery;
    begin
    result:=true;
    qr_cadp02_libbloq:=tQuery.create(nil);
    qr_cadp02_libbloq.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
    qr_cadp02_libbloq.SQL.add('Select count(*) from CADP02_BLOQLIB where P02BL_ID_PED02 = '+intToStr(pIdPed02)
    +' and P02BL_ID_BLQ = 75 '
    +' and (P02BL_DATHOR_LIB is null or P02BL_DATHOR_LIB>:DATHOR_LIB )');
    qr_cadp02_libbloq.ParamByName('DATHOR_LIB').AsDateTime := pdatanula;
    try
       qr_cadp02_libbloq.open;
       result:=qr_cadp02_libbloq.fields[0].asinteger>0;
    except on e : exception do
       begin
       ex_erroSql_Novo(qr_cadp02_libbloq,34422,'func Erro:'+e.Message ,'CADP02_BLOQLIB');
       result:=false;
       end;
       end;
//    ex_erroSql_Novo(qr_cadp02_libbloq,34422,'func Erro:' ,'CADP02_BLOQLIB');

    qr_cadp02_libbloq.Close;
    FreeAndNil(qr_cadp02_libbloq);
    end;


    function fAdicionarBloqLib(pIdPed02: Integer): boolean;
    var
    qr_cadp02_libbloq: tQuery;
    begin
    result:=true;
    qr_cadp02_libbloq:=tQuery.create(nil);
    qr_cadp02_libbloq.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
    qr_cadp02_libbloq.SQL.add('MERGE INTO CADP02_BLOQLIB  t1 using ('
                             +' select '+inttostr(pIdPed02) +' as P02BL_ID_PED02 '
                             +', 75 as P02BL_ID_BLQ  '
                             +', sysdate as P02BL_DATHOR_LIB '
                             +', '+inttostr(codusr)+' as  P02BL_ID_USR  '
                             +', '+quotedstr('sem motivo')+' as P02BL_MOTIVO '
                             +' from dual )'
                              +'  ss on '
                              +' (t1.P02BL_ID_PED02 = ss.P02BL_ID_PED02  and t1.P02BL_ID_BLQ = ss.P02BL_ID_BLQ) '
                              +' WHEN MATCHED then UPDATE SET '
                              +' t1.P02BL_ID_USR= ss.P02BL_ID_USR, '
                              +' t1.P02BL_DATHOR_LIB= ss.P02BL_DATHOR_LIB '
                              +', t1.P02BL_MOTIVO= ss.P02BL_MOTIVO '
                              +' WHEN NOT MATCHED THEN INSERT ( '
                              +' t1.P02BL_ID '
                              +' ,t1.P02BL_ID_PED02 '
                              +' ,t1.P02BL_ID_BLQ '
                              +' ,t1.P02BL_DATHOR_LIB '
                              +' ,t1.P02BL_ID_USR  '
                              +' ,t1.P02BL_MOTIVO '
                              +' ) values ('
                               +' CADP02_BLOQLIB_SEQ.NEXTVAL '
                              +' ,ss.P02BL_ID_PED02 '
                              +' ,ss.P02BL_ID_BLQ  '
                              +' ,ss.P02BL_DATHOR_LIB '
                              +' ,ss.P02BL_ID_USR  '
                              +' ,ss.P02BL_MOTIVO '
                              +')');


    try
       qr_cadp02_libbloq.ExecSQL;
       fdm1StartCommit;
    except on e : exception do
       begin
       ex_erroSql_Novo(qr_cadp02_libbloq,34469,'func Erro:'+e.Message ,'CADP02_BLOQLIB');
       result:=false;
       end;
       end;
    qr_cadp02_libbloq.Close;
    FreeAndNil(qr_cadp02_libbloq);
    end;

begin


if (mVenda_GP.mPed1_Tipo_Ped<>1) and (mVenda_GP.mPed1_Tipo_Ped<>9) then
   begin
   result:=true;
   exIt;
   end;

if form_venda_pesqprod.Qr_ProPDCODPRO.AsFloat<>ValFloat(Tb_Ped02_preP2CODPRO.AsString) then
   begin
   mDadosPesqProd.pTipo:=1;
   mDadosPesqProd.pPre:=1;
   mDadosPesqProd.pCodEmp   :=codemp;
   mDadosPesqProd.pCodPro   :=valfloat(tb_ped02_preP2CODPRO.AsString);
   mDadosPesqProd.pSemFiltros:=true;
   form_venda_pesqprod.flcadpro_Local(mDadosPesqProd);
   mDadosPesqProd.pSemFiltros:=false;
   end;


if form_venda_pesqprod.Qr_ProPDSALDO.AsFloat<=form_venda_pesqprod.Qr_ProPDESTMIN.AsFloat then
   begin
   if (Tb_Ped02_preP2ID_NEW.AsInteger>0) then
      begin
      if fJaEstaLiberado(Tb_Ped02_preP2ID_NEW.AsInteger) then
         begin
         result:=true;
         exit;
         end;
      end;



   mValidarSenha.pTipo:=0;
   mValidarSenha.pCodusr:=codusr;
   mValidarSenha.pCodSen:=75;
   mValidarSenha.pCodEmp:=0;
   mValidarSenha.pCodCli:=valfloat(edt_codcli.text);
   mValidarSenha.pCodEmp:=codemp;
   mValidarSenha.pLotSeq:=ls_numped;
   mValidarSenha.pChave :=mVenda_GP.mped1_Chave;
   mValidarSenha.pOrdem :=1;
   mValidarSenha.pTexto :='Senha para Confirmar Venda com estoque menor ou igual ao minimo. Chave do Pedido '+FloatTostr(mVenda_GP.mped1_Chave);
   mValidarSenha.pChave_St:='';
   mValidarSenha.pDesc_requisitado :=0;
   if fValidaSenha(mValidarSenha)<>0 then
      begin
      result:=false;
      exit;
      end
   else
      begin
      fAdicionarBloqLib(Tb_Ped02_preP2ID_NEW.AsInteger);
      end;

   end;
result:=true;

end;


