mem_lotes.Open;
mem_lotesP2LM_DTVCTO.DisplayFormat:=fdt2;
mem_lotesP2LM_QTD_001.DisplayFormat:=mcasqtd;
mem_lotesP2LM_QTD_101.DisplayFormat:=mcasqtd;
mLote_Carregando:=true;

if pList_Lote=nil then
