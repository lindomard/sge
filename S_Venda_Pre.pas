function TFrm_Venda_Pre.fValidarSenha(pTexto: string; pCodBloq,pcodSen: integer):boolean;
begin

mValidarSenha.pTipo   :=iif(DM1.Tb_PargerPGRAVPEDBLOQ.asinteger=0,0,1);
mValidarSenha.pCodusr :=codusr;
mValidarSenha.pCodSen :=pcodSen;
mValidarSenha.pCodEmp:=0;
mValidarSenha.pCodCli:=DM1.Tb_CliCCODCLI.Value;
mValidarSenha.pCodEmp:=codemp;
mValidarSenha.pLotSeq:=ls_numped;
mValidarSenha.pChave :=mVenda_GP.mped1_Chave;
mValidarSenha.pOrdem :=1;
mValidarSenha.pTexto :='Cliente: '+
DM1.Tb_CliCRAZAO.Asstring +'-'+DM1.Tb_CliCCODCLI.Asstring+pTexto +'. Para liberar digite a senha'
    +' Chave do Pedido '+FloatTostr(mVenda_GP.mped1_Chave);
mPd_CodResp_Senha:=fValidaSenha(mValidarSenha);
if mPd_CodResp_Senha=0 then
   begin
   mVenda_GP.mPed1_codusr_lbloq :=codusr;
   mVenda_GP.mPed1_codbloq      :=fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq,formatfloat('00', pCodBloq));
   mVenda_GP.mPed1_codbloq_lib  :=fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq_lib,formatfloat('00', pCodBloq));
   mCodCli_ValAnvisa            := fsonumero(edt_codcli.text);
   end

else if mPd_CodResp_Senha=2 then
   begin
   mVenda_GP.mPed1_bloqPend     :=2;
   mVenda_GP.mPed1_codbloq      :=fAdicionaRemoveTexto(0,mVenda_GP.mPed1_codbloq, formatfloat('00', pCodBloq));
   mCodCli_ValAnvisa            := fsonumero(edt_codcli.text);
   end
else
   begin
//   mCodCli_Analisado   :=0;
   mCodCli_ValAnvisa   :=0;
   result:=False;
   exit;
   end;
end;


