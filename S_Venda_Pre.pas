                                          +' Tipo '+ tab_tped_mov[query_ori.FieldByName('P1TIPO').asinteger,00]);
      Form_Ocorrencias.ListView1.Items[Form_Ocorrencias.mPosicaoItem].ImageIndex:=3;
      Form_Ocorrencias.mErros:=true;
      query_ori.next;
      end;

   if Form_Ocorrencias.mErros then
      begin
      result:=false;
      form_ocorrencias.lbl_ocorrencia.Caption:='Não sera possível excluir o pedidoo';
      Form_Ocorrencias.ShowModal;
      end;
   freeandnil(form_ocorrencias);

   end;
query_ori.close;
freeandnil(query_ori);


end;


