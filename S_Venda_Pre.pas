function TFrm_Venda_Pre.fArredondarPrecos(pCasas: integer): Boolean;
var
Query_Temp: tQuery;
begin
Query_Temp:=tQuery.Create(nil);
Query_Temp.DatabaseName:='SG_ASSOC';;
Query_Temp.Close;
Query_Temp.SQL.Clear;
Query_Temp.SQL.Add('Update CADP02 set P2PRECO=ROUND(P2PRECO,'+IntTostr(pCasas)+') '
                  +' where P2CHAVE=:CHAVE '
                  +' and P2LOTSEQ=:LOTSEQ '
                  +' and P2ORDEM=:ORDEM '
                  +' and (P2CODEMP=:CODEMP or P2CODEMP=:CODEMP_FILIAL)');
Query_temp.ParamByName('CHAVE').Value :=mVenda_GP.mped1_Chave;
Query_temp.ParamByName('LOTSEQ').Value:=mVenda_GP.mPed1_Chave_ano;
Query_temp.ParamByName('ORDEM').Value :=01;
Query_temp.ParamByName('CODEMP').Value:=mVenda_GP.mPed1_Codemp_ini;
Query_temp.ParamByName('CODEMP_FILIAL').Value:=mVenda_GP.mPed1_Codemp_fin;
try
   Query_Temp.ExecSQL;
   fdm1StartCommit;
except
   end;

freeandNil(query_temp);
result:=true;


end;



function TFrm_Venda_Pre.fCalcularPedido(pChave,pLotSeq,pCodEmp,pOrdem: Real): Boolean;
var

Query_Calc: tQuery;
Query_pfp: tQuery;
mCalc_QtdDup: Integer;
mCalc_Parcelas,mCalc_PrzNovos_001: String;
mCalc_pDesc01,mCalc_pDesc02,mCalc_pDesc03: Real;

mCalc_DescRat: Real;
begin
if mlocalizando_pedido then
   begin
   result:=true;
   exit;
   end;


Query_Calc:=tQuery.Create(nil);
Query_Calc.DatabaseName:='SG_ASSOC';
Query_Calc.Close;
Query_Calc.SQL.clear;
Query_Calc.SQL.Add('SELECT SUM(P2DESCRAT) AS DESCRAT, '
                  +' max(P1DESC01) as PERCDESC01, '
                  +' max(P1DESC02) as PERCDESC02, '
                  +' 0 as PERCDESC03 '
                  +' FROM CADP01,CADP02 '
                  +' WHERE P2CHAVE=P1CHAVE '
                  +' AND P2ORDEM=P1ORDEM '
                  +' AND P2LOTSEQ=P1LOTSEQ '
                  +' AND P2CODEMP=P1CODEMP '
                  +' and P1CODEMP=:CODEMP '
                  +' and P1CHAVE=:CHAVE  '
                  +' and P1ORDEM=:ORDEM '
                  +' and P1LOTSEQ=:LOTSEQ ');
Query_Calc.ParamByName('CODEMP').Value        := pCodEmp;
Query_Calc.ParamByName('CHAVE').Value         := pchave;
Query_Calc.ParamByName('LOTSEQ').Value        := pLotseq;
Query_Calc.ParamByName('ORDEM').Value         := pordem;
try
   Query_Calc.Open;
   fdm1StartCommit;
except
   end;
mcalc_pDesc01:=Query_Calc.FieldbyName('PERCDESC01').AsFloat;
mcalc_pDesc02:=Query_Calc.FieldbyName('PERCDESC02').AsFloat;
mcalc_pDesc03:=Query_Calc.FieldbyName('PERCDESC03').AsFloat;
mCalc_DescRat:=Query_Calc.FieldbyName('DESCRAT').AsFloat;


Query_pfp:=tQuery.Create(nil);
Query_pfp.DatabaseName:='SG_ASSOC';
Query_pfp.SQL.clear;
Query_pfp.SQL.Add('Select PFPPRAZO from CADPFP where '
                 +' PFPCHAVE=:CHAVE '
                 +' and PFPORDEM=:ORDEM '
                 +' and PFPLOTSEQ=:LOTSEQ '
                 +' and PFPCODEMP=:CODEMP ');
Query_pfp.ParamByName('CHAVE').value :=pchave;
Query_pfp.ParamByName('ORDEM').value :=pordem;
Query_pfp.ParamByName('LOTSEQ').value:=plotseq;
Query_pfp.ParamByName('CODEMP').value:=pcodemp;
try
   Query_pfp.open;
except
   end;



Query_pfp:=tQuery.Create(nil);
Query_pfp.DatabaseName:='SG_ASSOC';
Query_pfp.SQL.clear;
Query_pfp.SQL.Add('Select PFPPRAZO from CADPFP where '
                 +' PFPCHAVE=:CHAVE '
                 +' and PFPORDEM=:ORDEM '
                 +' and PFPLOTSEQ=:LOTSEQ '
                 +' and PFPCODEMP=:CODEMP ');
Query_pfp.ParamByName('CHAVE').value :=pchave;
Query_pfp.ParamByName('ORDEM').value :=pordem;
Query_pfp.ParamByName('LOTSEQ').value:=plotseq;
Query_pfp.ParamByName('CODEMP').value:=pcodemp;
try
   Query_pfp.open;
except
   end;
mCalc_Qtddup:=0;


mCalc_Parcelas:=insere(Query_pfp.fieldbyName('PFPPRAZO').AsString,'0',4);
mCalc_PrzNovos_001:='P|'+Query_pfp.fieldbyName('PFPPRAZO').AsString+'|||||||||||';

Query_pfp.Next;
while not Query_pfp.Eof do
   begin
   mCalc_qtdDUP:=mCalc_QtdDup+1;
   mCalc_Parcelas:=mCalc_Parcelas+insere(Query_pfp.fieldbyName('PFPPRAZO').AsString,'0',4);
   mCalc_PrzNovos_001:=mCalc_PrzNovos_001+'P|'+Query_pfp.fieldbyName('PFPPRAZO').AsString+'|||||||||||';
   query_pfp.Next;
   end;

FreeAndNil(Query_pfp);

Query_Calc.Close;
Query_Calc.SQL.clear;
Query_Calc.SQL.Add('Insert into CADP02_PRE_TEMP ('
                  +' P2T_CODEMP '
                  +',P2T_CODEMP_FILIAL '
                  +',P2T_CHAVE '
                  +',P2T_CHAVE_ANO '
                  +',P2T_ALTDUP'
                  +',P2T_QTDDUP'
                  +',P2T_QTDDUP_ANT'
                  +',P2T_PRAZOS '
                  +',PT2_PRZNOVOS '
                  +',P2T_TIPO_EVENTO '
                  +',P2T_PED1_DESC_PERC01'
                  +',P2T_PED1_DESC_PERC02'
                  +',P2T_PED1_DESC_PERC03'
                  +',P2T_PED1_DESC_PERC01_ANT'
                  +',P2T_PED1_DESC_PERC02_ANT'
                  +',P2T_PED1_DESC_PERC03_ANT'
                  +',P2T_PED1_DESCRAT'
                  +',P2T_TPPCO_CAB'



                  +') values ('
                  +' :P2T_CODEMP '
                  +',:P2T_CODEMP_FILIAL '
                  +',:P2T_CHAVE '
                  +',:P2T_CHAVE_ANO '
                  +',:P2T_ALTDUP'
                  +',:P2T_QTDDUP'
                  +',:P2T_QTDDUP_ANT'
                  +',:P2T_PRAZOS '
                  +',:P2T_PRZNOVOS '
                  +',:P2T_TIPO_EVENTO '
                  +',:P2T_PED1_DESC_PERC01'
                  +',:P2T_PED1_DESC_PERC02'
                  +',:P2T_PED1_DESC_PERC03'
                  +',:P2T_PED1_DESC_PERC01_ANT'
                  +',:P2T_PED1_DESC_PERC02_ANT'
                  +',:P2T_PED1_DESC_PERC03_ANT'
                  +',:P2T_PED1_DESCRAT'
                  +',:P2T_TPPCO_CAB'


                  +')');
Query_Calc.ParamByName('P2T_CODEMP').Value        := pcodemp;
if pcodemp>100 then
   Query_Calc.ParamByName('P2T_CODEMP_FILIAL').Value :=pcodemp-100
else
   Query_Calc.ParamByName('P2T_CODEMP_FILIAL').Value :=pcodemp+100;

Query_Calc.ParamByName('P2T_CHAVE').Value         :=pchave;
Query_Calc.ParamByName('P2T_CHAVE_ANO').Value     :=plotseq;
Query_Calc.ParamByName('P2T_ALTDUP').Value        :='S';
Query_Calc.ParamByName('P2T_QTDDUP').Value        :=mCalc_QtdDup;
Query_Calc.ParamByName('P2T_QTDDUP_ANT').Value    :=-1;
Query_Calc.ParamByName('P2T_PRAZOS').Value        :=mCalc_Parcelas;
Query_Calc.ParamByName('P2T_PRZNOVOS').Value      :=mCalc_PrzNovos_001;
Query_Calc.ParamByName('P2T_TIPO_EVENTO').Value   :=3;
Query_Calc.ParamByName('P2T_PED1_DESC_PERC01').AsFloat  := mCalc_pDesc01;
Query_Calc.ParamByName('P2T_PED1_DESC_PERC02').AsFloat  := mCalc_pDesc02;
Query_Calc.ParamByName('P2T_PED1_DESC_PERC03').AsFloat  := mCalc_pDesc03;

Query_Calc.ParamByName('P2T_PED1_DESC_PERC01_ANT').AsFloat  := -1;
Query_Calc.ParamByName('P2T_PED1_DESC_PERC02_ANT').AsFloat  := -1;
Query_Calc.ParamByName('P2T_PED1_DESC_PERC03_ANT').AsFloat  := -1;
Query_Calc.ParamByName('P2T_PED1_DESCRAT').AsFloat :=mCalc_DescRat;
Query_Calc.ParamByName('P2T_TPPCO_CAB').AsInteger := mVenda_GP.mped1_tppco;


try
   Query_Calc.ExecSQL;
   fdm1StartCommit;
except
   end;

// inicio

Query_Calc.SQL.clear;
Query_Calc.SQL.Add('Delete from CADP02_PRE_TEMP  where '
                  +' P2T_CODEMP=:CODEMP '
                  +' and P2T_CODEMP_FILIAL=:CODEMP_FILIAL '
                  +' and P2T_CHAVE=:CHAVE  '
                  +' and P2T_CHAVE_ANO=:CHAVE_ANO ');
Query_Calc.ParamByName('CODEMP').Value        := pcodemp;
if pcodemp>100 then
   Query_Calc.ParamByName('CODEMP_FILIAL').Value :=pcodemp-100
else
   Query_Calc.ParamByName('CODEMP_FILIAL').Value :=pcodemp+100;

Query_Calc.ParamByName('CHAVE').Value         :=pchave;
Query_Calc.ParamByName('CHAVE_ANO').Value     :=plotseq;
try
   Query_Calc.ExecSQL;
   fdm1StartCommit;
except
   end;

FreeAndNil(Query_Calc);
result:=true;
end;

function TFrm_Venda_Pre.fTarifaBancaria: Boolean;
var
mTarBco_001: Real;
mTarBco_101: Real;
Query_Cons: TQuery;
mInstBco: String;
mQtdDup_001: Integer;
mQtdDup_101: Integer;
begin
if mlocalizando_pedido then
   begin
   if mVenda_GP.mped1_submod=0 then
      begin
      edt_codbco1.Visible       :=true;
      edt_codbco101.Visible     :=False;
      end
   else if mVenda_GP.mped1_submod=100 then
      begin
      edt_codbco1.Visible       :=false;
      edt_codbco101.Visible     :=true;
      end
   else
      begin
      edt_codbco1.Visible       :=true;
      edt_codbco101.Visible     :=true;
      end;

   result:=true;
   exit;
   end;

if (not mPed_Cli_Ctarban) or ((mVenda_GP.mPed1_CodBco1=0) and (mVenda_GP.mPed1_CodBco101=0)) then
   begin
   mVenda_GP.mPed1_TarBan_001:=0;
   mVenda_GP.mPed1_TarBan_101:=0;
   edt_tarban_101.Text := FormatFloat(mcasas, mVenda_GP.mPed1_TarBan_101);
   edt_tarban1.Text := FormatFloat(mcasas, mVenda_GP.mPed1_TarBan_001);
   mVenda_GP.mPed1_QtdParc_ant:=mVenda_GP.mPed1_QtdParc;
   fRecalcularPedido(3);
   result:=true;
   exit;
   end;


if mVenda_GP.mped1_submod=0 then
   begin
   edt_codbco1.Visible       :=true;
   edt_codbco101.Visible     :=False;
   edt_codbco101.Text        :='0';
   mVenda_GP.mPed1_TarBan_101:=0;
   end
else if mVenda_GP.mped1_submod=100 then
   begin
   edt_codbco1.Visible       :=false;
   edt_codbco101.Visible     :=true;
   edt_codbco1.Text          :='0';
   mVenda_GP.mPed1_TarBan_001:=0;
   end
else
   begin
   edt_codbco1.Visible       :=true;
   edt_codbco101.Visible     :=true;
   end;
mTarBco_001:=0;
mTarBco_101:=0;
Query_Cons:=tQuery.Create(nil);
Query_Cons.DatabaseName:='SG_ASSOC';


if ValFloat(edt_codbco1.Text)<>0 then
   begin
   Query_Cons.Close;
   Query_Cons.SQL.clear;
   Query_Cons.SQL.Add('Select BCTARIFA from CADBCO where BCCODBCO=:CODBCO ');
   mInstBco:=fRetInstMECadastro('CADBCO','BCCODEMP',mVenda_GP.mPed1_Codemp);
   if trim(mInstBco)<>'' then
      Query_Cons.SQL.add(' and '+mInstBco);
   Query_Cons.ParamByName('CODBCO').Value:=valint(edt_codbco1.Text);
   Query_Cons.Open;
   if not Query_Cons.IsEmpty then
      mTarBco_001:=Query_Cons.fieldbyName('BCTARIFA').asfloat;
   end;

if ValFloat(edt_codbco101.Text)<>0 then
   begin
   Query_Cons.Close;
   Query_Cons.SQL.clear;
   Query_Cons.SQL.Add('Select BCTARIFA from CADBCO where BCCODBCO=:CODBCO ');
   mInstBco:=fRetInstMECadastro('CADBCO','BCCODEMP',mVenda_GP.mPed1_Codemp);
   if trim(mInstBco)<>'' then
      Query_Cons.SQL.add(' and '+mInstBco);
   Query_Cons.ParamByName('CODBCO').Value:=valint(edt_codbco101.Text);
   Query_Cons.Open;
   if not Query_Cons.IsEmpty then
      mTarBco_101:=Query_Cons.fieldbyName('BCTARIFA').asfloat;
   end;
if (Tb_Ped02_pre.IsEmpty) and (Tb_ped02S_pre.IsEmpty) then
   begin
   if ((not DM1.Tb_PV.Active) or ( copy(edt_codCondPag.Text,1,2) <> DM1.Tb_PVPVCODTIP.AsString)
      or (valint(copy(edt_codCondPag.Text,3,length(edt_codcondpag.text)-2))<>DM1.Tb_PVPVCODPV.asinteger))
      and (edt_codCondPag.Text<>'PO99') then
      begin
      flcadpv(1,0,copy(edt_codCondPag.Text,1,2),copy(edt_codCondPag.Text,3,length(edt_codcondpag.text)-2));
      end;
    DM1.Tb_PV2.first;
    While not DM1.Tb_PV2.Eof do
      begin
      mQtdDup_001:=mQtdDup_001+1;
      mQtdDup_101:=mQtdDup_101+1;
      DM1.Tb_PV2.Next;
      end;
   end
else
   begin
   Query_Cons.Close;
   Query_Cons.SQL.clear;
   Query_Cons.SQL.Add('select sum(case when PFPCODEMP>99 then 1 else 0 end) as qtddup_101 '
                     +', sum(case when PFPCODEMP>99 then 0 else 1 end) as qtddup_001 '
                     +' from cadpfp where pfpchave=:CHAVE '
                     +' and PFPLOTSEQ=:LOTSEQ and PFPORDEM=:ORDEM '
                     +' and (PFPCODEMP=:CODEMP or PFPCODEMP=:CODEMP_FILIAL ) ');
   query_cons.parambyName('CHAVE').AsFloat        :=mVenda_GP.mped1_Chave;
   query_cons.parambyName('LOTSEQ').AsFloat       :=mVenda_GP.mPed1_Chave_ano;
   query_cons.parambyName('ORDEM').AsFloat        :=01;
   query_cons.parambyName('CODEMP').AsFloat       :=mVenda_GP.mPed1_Codemp_ini;
   query_cons.parambyName('CODEMP_FILIAL').AsFloat:=mVenda_GP.mPed1_Codemp_fin;
   try
      Query_Cons.Open;
      mQtdDup_001:=Query_Cons.fieldbyName('QTDDUP_001').AsInteger;
      mQtdDup_101:=Query_Cons.fieldbyName('QTDDUP_101').AsInteger;
   except
      end;
   end;
if mQtdDup_001<1 then
   mQtdDup_001:=1;
if mQtdDup_101<1 then
   mQtdDup_101:=1;
if edt_codbco1.Visible=true then
   mVenda_GP.mPed1_TarBan_001:=mQtdDup_001*mTarBco_001
else
   mVenda_GP.mPed1_TarBan_001:=0;


if edt_codbco101.Visible=true then
   mVenda_GP.mPed1_TarBan_101:=mQtdDup_101*mTarBco_101
else
   mVenda_GP.mPed1_TarBan_101:=0;

edt_tarban_101.Text := FormatFloat(mcasas, mVenda_GP.mPed1_TarBan_101);
edt_tarban1.Text := FormatFloat(mcasas, mVenda_GP.mPed1_TarBan_001);

mVenda_GP.mPed1_QtdParc_ant:=mVenda_GP.mPed1_QtdParc;

fRecalcularPedido(3);
FreeAndNil(Query_Cons);
result:=true;
end;


