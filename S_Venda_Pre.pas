procedure TFrm_Venda_Pre.mem_lotesAfterInsert(DataSet: TDataSet);
begin
mAnt_QtdLote_001:=0;
mAnt_QtdLote_101:=0;
mAnt_lote:='';
end;

procedure TFrm_Venda_Pre.mem_lotesAfterPost(DataSet: TDataSet);
var
bookmark: TBookmark;
begin

pList_Lote.Clear;
if not mem_lotes.IsEmpty then
   begin
   bookmark:=mem_lotes.GetBookmark;
   mem_lotes.First;
   While not mem_lotes.Eof do
      begin
      pList_Lote.Add(mem_lotesP2LM_LOTE.asstring);
      mem_lotes.Next;
      end;
   mem_lotes.GotoBookmark(bookmark);
   end;

mTotDigLot_001:=mTotDigLot_001+mem_lotesP2LM_QTD_001.AsFloat-mAnt_QtdLote_001;
mTotDigLot_101:=mTotDigLot_101+mem_lotesP2LM_QTD_101.AsFloat-mAnt_QtdLote_101;
mAnt_QtdLote_001:=0;
mAnt_QtdLote_101:=0;
fMostrarTotaisLote;


end;

procedure TFrm_Venda_Pre.mem_lotesBeforeDelete(DataSet: TDataSet);
begin

if not sbnGravar.Enabled then
   begin
   abort;
   exit;
   end;

mTotDigLot_001:=mTotDigLot_001-mem_lotesP2LM_QTD_001.AsFloat;
mTotDigLot_101:=mTotDigLot_101-mem_lotesP2LM_QTD_101.AsFloat;
mAnt_QtdLote_001:=0;
mAnt_QtdLote_101:=0;
fMostrarTotaisLote;

end;

procedure TFrm_Venda_Pre.mem_lotesBeforePost(DataSet: TDataSet);
var
mQtd: Real;
begin
if not mLote_Carregando then
   begin
   if mVenda_GP.mPd_EstNor='S' then
      begin
      if Query_Soma_Lote_Edit.Locate('CLNUMERO',mem_lotesP2LM_LOTE.AsString,[loPartialKey,loCaseInsensitive]) then
         begin
         mem_lotesP2LM_LOTE.AsString    :=Query_Soma_Lote_Edit.fieldbyName('CLNUMERO').AsString;
         mem_lotesP2LM_DTVCTO.AsDateTime:=Query_Soma_Lote_Edit.fieldbyName('CLDTVCTO').AsDateTime;
         mem_lotesP2LM_DTFAB.AsDateTime:=Query_Soma_Lote_Edit.fieldbyName('CLDTFAB').AsDateTime;
         mQtd:=mem_lotesP2LM_QTD_001.AsFloat+mem_lotesP2LM_QTD_101.AsFloat;
         if mqtd>Query_Soma_Lote_Edit.FieldbyName('CLQTD').asfloat then
            begin
            MessageDlg('Quantidade Requisitada '+FormatFloat(mcasqtd, mQtd)
            +' Disponivel '+FormatFloat(mcasqtd, Query_Soma_Lote_Edit.FieldbyName('CLQTD').asfloat),mtWarning,[mbOk],0);
            DBGrid_Man_lote.SelectedField:=mem_lotesP2LM_LOTE;
            if sbnGravar.enabled then
               DBGrid_Man_lote.SetFocus;
            abort;
            end;

         if (mAnt_lote<>mem_lotesP2LM_LOTE.asString)  then
//         if ((mem_lotes.State in [dsEdit]) and (mAnt_lote<>mem_lotesP2LM_LOTE.asString) ) or (mAnt_lote<>mem_lotesP2LM_LOTE.asString) then
            begin
            if fLoteJaDigitado(mem_lotesP2LM_LOTE.AsString) then
               begin
               if sbnGravar.enabled then
                  DBGrid_Man_lote.SetFocus;
               abort;
               end;
            end;
         end
      else
         begin
         MessageDlg('Lote Não Encontrado!',mtWarning,[mbOk],0);
         mem_lotes.Cancel;
         DBGrid_Man_lote.SelectedField:=mem_lotesP2LM_LOTE;
         if sbnGravar.enabled then
            DBGrid_Man_lote.SetFocus;
         abort;
         end;
      end;
   end;

end;

function  TFrm_Venda_Pre.fLoteJaDigitado(pLote: String):Boolean;
var
x_lote: Integer;
begin
result:=false;
for x_lote:=0 to pList_Lote.Count-1 do
   begin
   if trim(pList_Lote[x_lote])=trim(pLote) then
      begin
      MessageDlg('Lote ja Digitado anteriormente!',mtWarning,[mbOk],0);
      result:=true;
      exit;
      end;
   end;
end;


//poper=0 normal 1-exclusao
function tFrm_Venda_Pre.FBaixarLotes(pOper: Integer;pCodPro: Real;pEstNor_Ant,pEstCons_Ant,pEstVenda_Ant,pEstTer_Ant: String; pItem,pContEsp,pTipoProd: Integer; pIdPed02New,pIdPed02New100: integer): Boolean;


var
mDifer: Real;
Query_Ped02: TQuery;
mQtdCal: Real;
mTipo_Oper: Integer;
mEstnor_oper: string;
mEstReservado_oper: string;
  pBaixar: pBaixarLotes;

begin
    fGerarEvento('19771 - vai baixar lotes');

if cds_lotes=nil then
   begin
   cds_lotes:=TClientDataSet.Create(nil);
   cds_lotes.FieldDefs.Add('LOTE',ftString, 20, false);
   cds_lotes.FieldDefs.Add('CODPRO',ftFloat, 0, false);
   cds_lotes.FieldDefs.Add('ITEM',ftInteger, 0, false);
   cds_lotes.FieldDefs.Add('DTVCTO',ftDateTime, 0, false);
   cds_lotes.FieldDefs.Add('DTFAB',ftDateTime, 0, false);
   cds_lotes.FieldDefs.Add('QTD_NOV',ftFloat, 0, false);
   cds_lotes.FieldDefs.Add('QTD_ANT_001',ftFloat, 0, false);
   cds_lotes.FieldDefs.Add('QTD_ANT_101',ftFloat, 0, false);
   cds_lotes.FieldDefs.Add('QTD_NOV_001',ftFloat, 0, false);
   cds_lotes.FieldDefs.Add('QTD_NOV_101',ftFloat, 0, false);

   cds_lotes.CreateDataSet;
   cds_lotes.LogChanges := False;
   end;
cds_lotes.Open;
cds_lotes.EmptyDataSet;
if not Tb_Ped02_Lotes_Ant.Active then
   fLerCadp02_Lotes_Antes(pItem,pCodPro);
//   LINDOMAR
Tb_Ped02_Lotes_Ant.First;

While not Tb_Ped02_Lotes_Ant.Eof do
   begin
    fGerarEvento('19797 - vai baixar lotes');

   if cds_lotes.Locate('CODPRO;ITEM;LOTE',VarArrayOf([Tb_Ped02_Lotes_AntP2LM_CODPRO.AsString
                          ,Tb_Ped02_Lotes_AntP2LM_ITEM.AsInteger
                          ,Tb_Ped02_Lotes_AntP2LM_LOTE.AsString]),[]) then
      cds_lotes.Edit
   else
      begin
      cds_lotes.Append;
      cds_lotes.FieldByName('CODPRO').AsFloat   :=Tb_Ped02_Lotes_AntP2LM_CODPRO.AsFloat;
      cds_lotes.FieldByName('ITEM').AsInteger   :=Tb_Ped02_Lotes_AntP2LM_ITEM.AsInteger;
      cds_lotes.FieldByName('LOTE').AsString    :=Tb_Ped02_Lotes_AntP2LM_LOTE.AsString;
      cds_lotes.FieldByName('DTVCTO').AsDateTime:=Tb_Ped02_Lotes_AntP2LM_DTVCTO.AsDateTime;
      cds_lotes.FieldByName('DTFAB').AsDateTime:=Tb_Ped02_Lotes_AntP2LM_DTFAB.AsDateTime;
      cds_lotes.FieldByName('QTD_NOV').AsFloat  :=0;
      cds_lotes.FieldByName('QTD_ANT_001').AsFloat  :=0;
      cds_lotes.FieldByName('QTD_ANT_101').AsFloat  :=0;
      cds_lotes.FieldByName('QTD_NOV_001').AsFloat  :=0;
      cds_lotes.FieldByName('QTD_NOV_101').AsFloat  :=0;

      end;
   cds_lotes.FieldByName('QTD_ANT_101').AsFloat  :=cds_lotes.FieldByName('QTD_ANT_101').AsFloat
                                              +Tb_Ped02_Lotes_AntP2LM_QTD_101.AsFloat;
   cds_lotes.FieldByName('QTD_ANT_001').AsFloat  :=cds_lotes.FieldByName('QTD_ANT_001').AsFloat
                                              +Tb_Ped02_Lotes_AntP2LM_QTD_001.AsFloat;
   cds_lotes.Post;
   Tb_Ped02_Lotes_Ant.Next;
   end;

if ((pEstNor_Ant='N') and (pEstCons_Ant='N') and (pEstVenda_Ant='N') and (pEstTer_Ant='N'))  then
   begin
   cds_lotes.First;
