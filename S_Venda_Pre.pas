function TFrm_Venda_Pre.fValorFormaFixa(pforma: String): Real;
var
pValRet: Real;
x_Campo: Integer;
x_tot: Integer;

mnv_Prazo: INTEGER;
mNv_Tipo: String;
Nv_valor: Real;
mNv_CodFP: Integer;
mNv_NomFP: String;
mNv_Baixa : String;
mNv_vAcum: string;
mNv_QtdParc: Integer;
mNv_QtdParcDiv: Integer;
mnv_ValFixo: Real;
mNv_valor: Real;
mNv_QtdDupRat: Integer;
begin
mnv_ValFixo   :=0;
x_campo       :=0;
mNv_QtdParcDiv:=0;
mNv_QtdParc  :=0;
mNv_valor    :=0;
mNv_QtdDupRat:=0;
for x_tot:=1 to length(pforma) do
   begin
   if pforma[x_tot]=';' then
      begin
      if  length(mNv_vAcum)>0 then
          begin
          if x_campo=0 then
             mnv_Prazo:=valint(mnv_vAcum)
          else if x_Campo=1 then
             mNv_Tipo:=mnv_vAcum
          else if x_Campo=2 then
             mNv_valor:=valfloat(mnv_vAcum)
          else if x_Campo=3 then
             mNv_CodFP:=valint(mnv_vAcum)
          else if x_Campo=4 then
             mNv_NomFP:=mnv_vAcum
          else if x_Campo=5 then
             mNv_Baixa:=mnv_vAcum;
          end;
       x_Campo:=x_Campo+1;
       if x_Campo>5 then
          begin
          x_Campo:=0;
          mNv_QtdParc:=mNv_QtdParc+1;
          if (mNv_tipo='V') and (mNv_Valor<>0) then
             mnv_ValFixo:=mNv_ValFixo+mNv_Valor
          else
             mNv_QtdParcDiv:=mNv_QtdParcDiv+1;
          if mNv_Tipo<>'V' then
             mNv_QtdDupRat:=mNv_QtdDupRat+1;
          end;
       mnv_vAcum:='';
       end
    else
       mNv_Vacum:=mnv_vAcum + pforma[x_tot];
   end;
Result:=mnv_ValFixo;
end;


function TFrm_Venda_Pre.fValordaParcela(pAntPerc: Real;pParcela: Integer): Real;
var
pValRet: Real;
x_Campo: Integer;
x_tot: Integer;

mnv_Prazo: INTEGER;
mNv_Tipo: String;
Nv_valor: Real;
mNv_CodFP: Integer;
mNv_NomFP: String;
mNv_Baixa : String;
mNv_vAcum: string;
mNv_QtdParc: Integer;
mNv_QtdParcDiv: Integer;
mnv_ValFixo: Real;
mNv_valor: Real;
mNv_QtdDupRat: Integer;
mValorParcSel: Real;
x_emp: Integer;
pForma: String;
begin
mnv_ValFixo   :=0;
x_campo       :=0;
mNv_QtdParcDiv:=0;
mNv_valor    :=0;
mNv_QtdDupRat:=0;
mValorParcSel:=0;

for x_emp:=1 to 2 do
   begin
   if pAntPerc=0 then
      begin
      if x_emp=2 then
         continue;
      end
   else if pAntPerc=100 then
      begin
      if x_emp=1 then
         continue;
      end;
   if x_emp=1 then
      pforma:=mVenda_GP.mPed1_PrzNovos_001
   else
      pforma:=mVenda_GP.mPed1_PrzNovos_101;
   mNv_QtdParc  :=0;
   x_campo       :=0;
   for x_tot:=1 to length(pForma) do
      begin
      if pforma[x_tot]=';' then
         begin
         if  length(mNv_vAcum)>0 then
             begin
             if x_campo=0 then
                mnv_Prazo:=valint(mnv_vAcum)
             else if x_Campo=1 then
                mNv_Tipo:=mnv_vAcum
             else if x_Campo=2 then
                mNv_valor:=valfloat(mnv_vAcum)
             else if x_Campo=3 then
                mNv_CodFP:=valint(mnv_vAcum)
             else if x_Campo=4 then
                mNv_NomFP:=mnv_vAcum
             else if x_Campo=5 then
                mNv_Baixa:=mnv_vAcum;
             end;
          x_Campo:=x_Campo+1;
          if x_Campo>5 then
             begin
             x_Campo:=0;
             mNv_QtdParc:=mNv_QtdParc+1;
             if mNv_QtdParc=pParcela then
                mValorParcSel:=mValorParcSel+mNv_valor;
             if (mNv_tipo='V') and (mNv_Valor<>0) then
                mnv_ValFixo:=mNv_ValFixo+mNv_Valor
             else
                mNv_QtdParcDiv:=mNv_QtdParcDiv+1;
             if mNv_Tipo<>'V' then
                mNv_QtdDupRat:=mNv_QtdDupRat+1;
             end;
          mnv_vAcum:='';
          end
       else
          mNv_Vacum:=mnv_vAcum + pforma[x_tot];
      end;
   end;
Result:=mValorParcSel;
end;


function TFrm_Venda_Pre.fDividirFormasFixas(pAntPerc,pNovoPerc: Real): Boolean;

var
pValRet: Real;
x_Campo: Integer;
x_tot: Integer;
mnv_Prazo: INTEGER;
mNv_Tipo: String;
Nv_valor: Real;
mNv_CodFP: Integer;
mNv_NomFP: String;
mNv_Baixa : String;
mNv_vAcum: string;
mNv_QtdParc: Integer;
mNv_QtdParcDiv: Integer;
mnv_ValFixo: Real;
mNv_valor: Real;
mNv_QtdDupRat: Integer;

mNovoValor_001: String;
mNovoValor_101: String;
x_emp: Integer;
mValor_Calc: Real;
pforma: string;
begin
mnv_ValFixo   :=0;
x_campo       :=0;
mNv_QtdParcDiv:=0;
mNv_QtdParc  :=0;
mNv_valor    :=0;
mNv_QtdDupRat:=0;
mNovoValor_001:='';
mNovoValor_101:='';
mValor_Calc:=0;

for x_emp:=1 to 2 do
   begin
   if x_emp=1 then
      pforma:=mVenda_GP.mPed1_PrzNovos_001
   else
      pforma:=mVenda_GP.mPed1_PrzNovos_101;
   x_campo       :=0;
   mNv_QtdParc  :=0;

   for x_tot:=1 to length(pforma) do
      begin
      if pforma[x_tot]=';' then
         begin
         if length(mNv_vAcum)>0 then
            begin
            if x_campo=0 then
               mnv_Prazo:=valint(mnv_vAcum)
            else if x_Campo=1 then
               mNv_Tipo:=mnv_vAcum
            else if x_Campo=2 then
               mNv_valor:=valfloat(mnv_vAcum)
            else if x_Campo=3 then
               mNv_CodFP:=valint(mnv_vAcum)
            else if x_Campo=4 then
               mNv_NomFP:=mnv_vAcum
            else if x_Campo=5 then
               mNv_Baixa:=mnv_vAcum;
            end;
         x_Campo:=x_Campo+1;
         if x_Campo>5 then
            begin
            mNv_QtdParc:=mNv_QtdParc+1;
            x_Campo:=0;
            if (mNv_tipo='V') and (mNv_Valor<>0) then
               begin
               mValor_Calc:=fValordaParcela(pAntPerc, mNv_QtdParc);

               if (pNovoPerc=100) or (pNovoPerc=0) then
                  mNv_valor:=mValor_Calc
               else
                  begin
                  mNv_valor:=Arredonda( (mValor_Calc*pNovoPerc/100) ,2);
                  if x_emp=1 then
                     mNv_valor:=mValor_Calc-mNv_valor;
                  end;
               if x_emp=1 then
                  begin
                  mNovoValor_001:=mNovoValor_001+inttostr(mnv_Prazo)+';V;'+formatFloat('##0.00' ,mNv_valor)+';'
                                +inttostr(mNv_CodFP)+';'+mNv_NomFP+';;';
                  end
               else
                  begin
                  mNovoValor_101:=mNovoValor_101+inttostr(mnv_Prazo)+';V;'+formatFloat('##0.00' ,mNv_valor)+';'
                                 +inttostr(mNv_CodFP)+';'+mNv_NomFP+';;';
                  end;
               mnv_ValFixo:=mNv_ValFixo+mNv_Valor
               end
            else
                begin
                mNv_QtdParcDiv:=mNv_QtdParcDiv+1;
                if x_emp=1 then
                   begin
                   mNovoValor_001:=mNovoValor_001+inttostr(mnv_Prazo)+';P;;'
                                +inttostr(mNv_CodFP)+';'+mNv_NomFP+';;';
                   end
                else
                  begin
                  mNovoValor_101:=mNovoValor_101+inttostr(mnv_Prazo)+';P;;'
                                 +inttostr(mNv_CodFP)+';'+mNv_NomFP+';;';
                  end;
               end;
            if mNv_Tipo<>'V' then
               mNv_QtdDupRat:=mNv_QtdDupRat+1;
            end;
         mnv_vAcum:='';
         end
      else
         mNv_Vacum:=mnv_vAcum + pforma[x_tot];
      end;
   end;
mVenda_GP.mPed1_PrzNovos_001:=mNovoValor_001;
mVenda_GP.mPed1_PrzNovos_101:=mNovoValor_101;

Result:=True;
end;

