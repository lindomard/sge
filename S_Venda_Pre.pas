                     +',P1ORC_PRAZOENT '
                     +',P1ORC_VALPRO '
                     +',P1ORC_FORMAPAG '
                     +',P1ORC_LETRA '
                     +',P1ORC_FUNDO '
                     +',P1ORC_TAMANHO '
                     +',P1ORC_TABUTE '
                     +',P1ORC_PAPEL '
                     +',P1ORC_QTDROLO '
                     +',P1ORC_MTROLO '
                     +',P1ORC_CONTATO '
                     +',P1ORC_FONE_CONTATO '
                     +',P1ORC_METAL_TIPOS_CORTES '
                     +',P1ORC_METAL_QTD_VIAS_PROD '


                     +' ) values ('
                     +' :P1ORC_CODEMP '
                     +',CADP01_ORC_SEQ.NEXTVAL '
                     +','+inttoStr(iif( mVenda_GP.mPed1_id_new_000>0, mVenda_GP.mPed1_id_new_000, mVenda_GP.mPed1_id_new_100 ))
                     +',:P1ORC_LOTSEQ '
