begin
edt_tpc_tipos_cortes.Text := cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.AsString;
spn_tpc_seq.Value         := cds_ped01_tipos_cortePTC_SEQ.AsInteger;
mpct_id                   := cds_ped01_tipos_cortePTC_ID.AsInteger;
mpct_seq                  := cds_ped01_tipos_cortePTC_SEQ.AsInteger;
mpct_tipo_corte           := cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.AsString;


fTpc_AtualizaEventos;

end;

procedure TFrm_Venda_Pre.tpc_excluirClick(Sender: TObject);
begin
if LowerCase(tpc_excluir.Caption)='cancelar' then
   begin
   edt_tpc_tipos_cortes.text:='';
   spn_tpc_seq.Value         := 0;
   end
else
   begin
   if cds_ped01_tipos_corte.IsEmpty = false then
      begin
      if application.MessageBox(pchar('Quer Realmente Exluir o Tipo de Corte '+cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.asString),'Confirmação',MB_YESNO+MB_DEFBUTTON2)<>mrYes then
         exit;
      mped_Alterou_Cab:=true;
