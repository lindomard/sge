   query_existe.ParamByName('P1DCH_OR').AsInteger       :=mem_ped01dP1DCH_OR.AsInteger;
   query_existe.ParamByName('P1DOR_OR').AsInteger       :=mem_ped01dP1DOR_OR.AsInteger;
