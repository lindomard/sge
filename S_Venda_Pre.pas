procedure TFrm_Venda_Pre.DBGrid_Man_loteKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
var
  form_cons_Lote: TFrm_ConsLot;
begin
if key=113 then
   begin
   Application.CreateForm(TFrm_ConsLot,form_cons_Lote);
   form_cons_Lote.CODPRO.Text:=Tb_Ped02_preP2CODPRO.AsString;
   form_cons_Lote.NOMPRO.Text:=Tb_Ped02_prePDNOME.AsString+' - '+Tb_Ped02_prePDMARCA.AsString;
   form_cons_Lote.ShowModal;
   if (fsonumero(form_cons_Lote.plote)<>0) or (fsonumero(form_cons_Lote.pdtvcto)<>0) then
      begin
      if not (mem_lotes.State in [dsEdit,dsInsert]) then
         begin
         if (mem_lotesP2LM_QTD_001.IsNull) and (mem_lotesP2LM_QTD_101.IsNull) then
            mem_lotes.Append
         else
            mem_lotes.edit;
         end;

      mem_lotesP2LM_LOTE.Value   :=form_cons_Lote.plote;
      try
         mem_lotesP2LM_DTVCTO.Value :=StrToDate(form_cons_Lote.pdtvcto);
      except
         end;
      try
         mem_lotesP2LM_DTFAB.Value :=StrToDate(form_cons_Lote.pdtfab);
      except
         end;
{
      mem_lotesP2LM_LOTE.Value   :=Query_Soma_Lote_Edit.fieldbyname('CLNUMERO').AsString;
      mem_lotesP2LM_DTVCTO.Value :=Query_Soma_Lote_Edit.fieldbyname('CLDTVCTO').AsDateTime;
      mem_lotesP2LM_DTFAB.Value :=Query_Soma_Lote_Edit.fieldbyname('CLDTFAB').AsDateTime;

 }
      mem_lotes.Post;
      end;
  if form_cons_Lote<>nil then
    FreeAndNil(form_cons_Lote);

  end;
end;

