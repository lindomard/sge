   Query_ori.open;
except on e : exception do
   ex_erroSql_Novo(query_ori,30889,'func Erro:'+e.Message ,'CADP01');
   end;
if not query_ori.IsEmpty then
   begin
   result:=false;
   Application.CreateForm(TFrm_Ocorrencias, form_ocorrencias);
   form_ocorrencias.ListView1.Clear;
   While not query_ori.Eof do
      begin


      Form_Ocorrencias.adicionaItemListView('Chave Utilizada no Pedido  '+query_ori.fieldbyname('P1CHAVE').asstring+'/'+query_ori.fieldbyname('P1CODEMP').AsString
