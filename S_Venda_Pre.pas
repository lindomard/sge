procedure TFrm_Venda_Pre.edt_chaveExit(Sender: TObject);
begin
if mCloseQueryAcionado then
   exit;

pOperacaoPedido:=0;
if (valint(edt_chave.Text)>0) then // and (mVenda_GP.mped1_Chave<>valint(edt_chave.Text)) then
   begin
   mlocalizando_pedido:=true;
   mProcessamento_Externo:=true;

   mped1_tpPed:=0;
   fSetarAcionarDev;

   if not fLerPedidoGeral(codemp,valint(edt_chave.Text),0) then
//   if not fLerPedidoGeral(codemp,valint(edt_chave.Text),valint(FormatDateTime('yyyy', date))) then
      begin
      edt_chave.Text:='';
      if Sbngravar.enabled then
        edt_chave.SetFocus;
      end
   else
      begin
      fAtualizarBotoes(1);
//      fAtualizarBotoes(2);

{
      if ValFloat(edt_TotProdServ.Text)=0 then
        begin
        sbnAlterarClick(self);
        fAjustarItensPed(false);
        sbnGravarClick(self);
        end;
}
      end;
   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;

   DM1.Query1.SQL.Add(' select * from cadp02 where P2CODPRO>=0 and p2codpro not in '
                     +'  (select '
                     +' pdcodpro from cadpro where 1=1 '
                     +fFiltrosMultiEmpresa('PDCODEMP','CADPRO',mvenda_GP.mPed1_Codemp_ini)
                     +' )'

                     +' and P2CHAVE='+FloatToStr(mVenda_GP.mped1_Chave)

                     +fFiltrosMultiEmpresa('P2CODEMP','CADPED',mvenda_GP.mPed1_Codemp_ini)

                     );

   try



     DM1.Query1.Open;
   except
     DM1.Query1.SQL.SaveToFile(mpastatemp +'sql.txt');
     end;
   if not DM1.Query1.IsEmpty then
     begin
     Application.CreateForm(TFrm_Ocorrencias, Frm_Ocorrencias);
     while not DM1.Query1.Eof do
       begin
       Frm_Ocorrencias.adicionaItemListView(' Item '+DM1.Query1.FieldByName('P2ITEM').AsString
                                        +' - Produto '+DM1.Query1.FieldByName('P2CODPRO').AsString
                                        +' '+DM1.Query1.FieldByName('p2nompro_ori').AsString
                                        +' - Codigo do produto não encontrado no Cadastro de Produtos ');
       DM1.Query1.Next;
       end;
     Frm_Ocorrencias.ShowModal;
     end;
   fLerCadp02_Lotes(Tb_Ped02_preP2Item.AsInteger,ValFloat(Tb_Ped02_preP2CODPRO.AsString));
   FbuscaEstoque(ValFloat(Tb_Ped02_preP2CODPRO.AsString));


   fLerFormaPag(0);
//lindomar
   if Tb_FP_pre.IsEmpty then
      begin
      fGeraFPgto(0,mVenda_GP.mped1_Chave,mVenda_GP.mPed1_Chave_ano,mVenda_GP.mPed1_Codemp_ini);
      if mVenda_GP.mPed1_Codemp_ini<>mVenda_GP.mPed1_Codemp_fin then
         fGeraFPgto(0,mVenda_GP.mped1_Chave,mVenda_GP.mPed1_Chave_ano,mVenda_GP.mPed1_Codemp_fin);
       end;
   if Tb_FP_prePFPVALOR.IsNull then
      begin
            mVenda_GP.mPed1_QtdParc_ant:=mVenda_GP.mPed1_QtdParc;

      fRecalcularformas(0);
      fLerFormaPag(0);
      end;
   Qr_P01_ADDEXT.Close;
   Qr_P01_ADDEXT.SQL.Clear;
   Qr_P01_ADDEXT.SQL.Add(' select * from CADP01_ADDEXT ');
   Qr_P01_ADDEXT.SQL.Add(' where P1AE_CODEMP='+FloatToStr(mVenda_GP.mPed1_Codemp));
   Qr_P01_ADDEXT.SQL.Add('   and P1AE_CHAVE='+FloatToStr(mVenda_GP.mPed1_Chave));
   Qr_P01_ADDEXT.SQL.Add('   and P1AE_LOTSEQ='+FloatToStr(mVenda_GP.mPed1_Chave_ano));
   Qr_P01_ADDEXT.Open;

   DM1.Query1.Close;
   DM1.Query1.SQL.Clear;
   DM1.Query1.SQL.Add(' select sum(P1AE_VALOR) as Total from CADP01_ADDEXT ');
   DM1.Query1.SQL.Add(' where P1AE_CODEMP='+FloatToStr(mVenda_GP.mPed1_Codemp));
   DM1.Query1.SQL.Add('   and P1AE_CHAVE='+FloatToStr(mVenda_GP.mPed1_Chave));
   DM1.Query1.SQL.Add('   and P1AE_LOTSEQ='+FloatToStr(mVenda_GP.mPed1_Chave_ano));
   DM1.Query1.Open;
   ce_TotAddExt.Value:=DM1.Query1.FieldByName('Total').AsFloat;
   mped_Alterou_Cab:=false;

  if flfilpad(0,'_principal','CB_DESFP') then
    begin
    if DM4.Tb_FilPad2FPVALOR.AsString = 'true' then
      begin
      Tb_FP_pre.First;
      mDescFp_Ant:=0;
        while not Tb_FP_pre.Eof do
        begin
        fLCadFP(0,Tb_FP_prePFPCODFP.AsString,'');
        try
           mDescFp_Ant := mDescFp_Ant + Tb_FP_prePFPVALOR.AsFloat
                       /ValFloat(edt_totliq.Text)
                      *(mVenda_GP.mPed1_TotMer+mVenda_GP.mPed1_TotSer)*(1-DM1.Tb_FPFPDESCMAX.AsInteger/100);
        except
           end;
        Tb_FP_pre.Next;
        end;
      try
         if (mVenda_GP.mPed1_TotMer+mVenda_GP.mPed1_TotSer) >0 then
            mDescFp_Ant := Truncar((1 - mDescFp_Ant / (mVenda_GP.mPed1_TotMer+mVenda_GP.mPed1_TotSer))*100,2)
         else
            mDescFp_Ant := 0;
      except
         end;
      if mDescFp_Ant < 0 then
        mDescFp_Ant := 0;
      end;
    end;
  mlocalizando_pedido:=false;
   mProcessamento_Externo:=false;

  end;

end;

