      DBGrid_servicos.SetFocus;
   Abort;
   end
else if tb_ped02s_preP2SPRECO.AsFloat<=0 then
   begin
   MessageDlg('Preço Invalido!',mtWarning,[mbOk],0);
   DBGrid_servicos.SelectedField:=tb_ped02s_preP2SPRECO;
   if sbnGravar.enabled then
      DBGrid_servicos.SetFocus;
   Abort;
   end;
if (tb_ped02s_preP2SQTD.AsFloat>0) and (tb_ped02s_preP2SPRECO.AsFloat>0) then
   begin
   tb_ped02s_preVALOR_TOTAL.AsFloat:=tb_ped02s_preP2SQTD.AsFloat*tb_ped02s_preP2SPRECO.AsFloat;
   fCalcularComissoesServicos;
   end
else
   tb_ped02s_preVALOR_TOTAL.AsFloat:=0;

if not fTestarCoRelacionadosNFse then
   begin
   if sbnGravar.enabled then
      DBGrid_servicos.SetFocus;
   abort;
   end;
end;


procedure TFrm_Venda_Pre.edt_submodExit(Sender: TObject);
begin
if ValInt(edt_submod.text)>100 then
   edt_submod.text:='100'
else if ValInt(edt_submod.text)<0 then
   edt_submod.text:='0';
edt_submod.Text:=fdeixanum(edt_subMod.text);
mVenda_GP.mped1_submod:=valint(edt_submod.Text);
mVenda_GP.mped1_formace:=1;

if mVenda_GP.mped1_submod>0 then
   begin
   if mVenda_GP.mPed1_Codemp_ini > 100 then
      mVenda_GP.mPed1_Codemp_fin:=mVenda_GP.mPed1_Codemp_ini-100
   else
      mVenda_GP.mPed1_Codemp_fin:=mVenda_GP.mPed1_Codemp_ini+100;
   mCodEmp_Maxima:=mVenda_GP.mPed1_Codemp_fin;
   end;



if mSubMOd_ant<>mVenda_GP.mped1_submod then
   begin


   if  ((valint(edt_submod.Text)<>100) AND (valint(edt_submod.Text)<>0) ) and (mVenda_GP.mped1_Chave>0)  then
       begin
       if fLerGenerico_query('CADP02_CMET','count(*) as qtd','P2CM_CHAVE=0'+IntToStr(mVenda_GP.mped1_Chave)+' and P2CM_LOTSEQ='+IntToStr(mVenda_GP.mPed1_Chave_ano),query_consulta) then
          begin
          if query_consulta.fields[0].AsInteger>0 then
             begin
             MessageDlg('Pedido possui chapa-metatica valido apenas 0 ou 100!',mtWarning,[mbOk],0);
             edt_submod.Text:=FormatFloat('000',mSubMOd_ant);
             if sbnGravar.Enabled then
                edt_submod.SetFocus;
             exit;
             end;
          end;

       end;




   fDeletarChaveInexistente;

//   fDividirFormasFixas(mSubMOd_ant,mVenda_GP.mped1_submod);
   mped_Alterou_Cab:=true;
   RecalcularSubMod(false,mSubMOd_ant,mVenda_GP.mped1_submod,mVenda_GP.mped1_formace,mVenda_GP.mped1_formace
                   ,mVenda_GP.mPd_EstNor
