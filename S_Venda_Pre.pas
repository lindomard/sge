       if sbnGravar.enabled then
           edt_data_pent.SetFocus;
        exit;
        end;
     exit;
     end;
   if fsonumero(edt_hora_pent.Text)=0 then
      mVenda_GP.mPed1_dathot_pent:=edt_data_pent.Date
