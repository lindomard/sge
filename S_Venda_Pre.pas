procedure TFrm_Venda_Pre.fLerCadp01_Anexos(pChave_ano,pChave,pCodEmp: Real);

begin
if PCODEMP>100 then
   PCODEMP:=PCODEMP-100;

if DM1_ADO.ADOConnection1.connected=false then
   begin
   DM1_ADO.ADOConnection1.Close;
   DM1_ADO.ADOConnection1.ConnectionString:='Provider=MSDAORA.1;Password=DEZENOVE;User ID='+Banco_usuario+';Data Source='+Banco_ServerName+';Persist Security Info=True';
   DM1_ADO.ADOConnection1.Open;
   end;

Tb_Ped_Anexos.close;
Tb_Ped_Anexos.Connection:=DM1_ADO.ADOConnection1;
Tb_Ped_Anexos.SQL.Text:='Select '
                      +'P1A_CODEMP '
                      +',P1A_CHAVE_ANO '
                      +',P1A_CHAVE '
                      +',P1A_SEQ '
                      +',P1A_OBS'
                      +',P1A_NOMEORI '
                      +',P1A_ID_NEW '
                      +',P1A_ID_PED01_NEW '
                      +' from CADP01_ANEXOS where P1A_CODEMP='+Floattostr(pCodEmp)
                      +' and P1A_CHAVE_ANO='+Floattostr(pChave_ano)
                      +' and P1A_CHAVE='+Floattostr(pChave)
                      +' order by P1A_SEQ ';
try
   Tb_Ped_Anexos.oPEN;
except on e : exception do
   begin
   ex_erroSql_ado(Tb_Ped_Anexos,29484,'_stru'+e.message,'user');
   end;
   end;
end;

