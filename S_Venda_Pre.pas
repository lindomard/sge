   Query_obs.ParamByName('P1ORC_LETRA').AsString   :=trim(edt_pnl_letra.Text);
   Query_obs.ParamByName('P1ORC_FUNDO').AsString   :=trim(edt_pnl_fundo.Text);
   Query_obs.ParamByName('P1ORC_TAMANHO').AsString :=trim(edt_pnl_tamanho.Text);
   Query_obs.ParamByName('P1ORC_TABUTE').AsString  :=trim(edt_pnl_tabute.Text);
   Query_obs.ParamByName('P1ORC_PAPEL').AsString   :=trim(edt_pnl_papel.Text);
   Query_obs.ParamByName('P1ORC_QTDROLO').AsString :=trim(edt_pnl_rolo.Text);
