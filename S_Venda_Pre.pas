   Query_AjustaFP.ParamByName('CODEMP_FILIAL').AsInteger:=mVenda_GP.mPed1_Codemp_fin;
   try
      Query_AjustaFP.ExecSql;
      fdm1StartCommit;
   except
      end;
   fLerFormaPag(0);
//   fAtualizarCadpfp(0);

//   lindomar
//   edt_codCondPagExit(self);
   FreeAndNil(Query_AjustaFP);
   end;



mEventoPendente:='';

end;

