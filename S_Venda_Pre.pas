function TFrm_Venda_Pre.fQuantidadeEmprestimoFaturado(pCodpro: Real): Real;
var
query_empfat: TQuery;
begin
result:=0;

if mVenda_GP.mPed1_Tipo_Ped=9 then
   begin
   la_tabelas  :='';
   la_Join     :='';
   la_instrucao:='';
   la_Empresas :='';
   fInnerJoin3(1,'CADP01','P1CODEMP','POPEDORI_CODEMP','P1LOTSEQ','POPEDORI_CHAVE_ANO','P1CHAVE','POPEDORI_CHAVE');
   la_instrucao:=la_instrucao+' and ';

   fInnerJoin4(1,'CADP02','P2CODEMP','POPEDORI_CODEMP','P2LOTSEQ','POPEDORI_CHAVE_ANO','P2CHAVE','POPEDORI_CHAVE','P2ITEM','POPEDORI_ITEM');


   query_empfat:=TQuery.create(nil);
   query_empfat.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
   query_empfat.sql.add('Select NVL(sum(POPEDORI_QTD),0) as QTDFAT from CADP02_PEDORI '+iif(la_tabelas='','',',')+la_tabelas
                       +'       '+la_Join
                       +'       where '+iif(la_instrucao='','',la_instrucao+' and ')
                       +' p1status<2 '
                       +' and POPEDORI_CHAVE='+Inttostr(mVenda_GP.mPed1_chave)
                       +fFiltrosMultiEmpresa('POPEDORI_CODEMP', 'CADP02',mvenda_gp.mPed1_Codemp)
                       +' and POPEDORI_CHAVE_ANO='+Inttostr(mVenda_GP.mPed1_Chave_ano));
   if pcodpro>0 then                            
      query_empfat.SQL.add(' and P2CODPRO='+floattostr(pCodpro));
   try
      query_empfat.Open;
      result:=valfloat(query_empfat.fieldbyname('QTDFAT').asString);
   except on e : exception do
      begin
      ex_erroSql_Novo(query_empfat,29290,'func Erro:'+e.Message ,'CADP02_PEDORI');
      end;
      end;
   query_empfat.close;
   freeandnil(query_empfat);
   end;
end;

procedure TFrm_Venda_Pre.sbn_novaClick(Sender: TObject);
