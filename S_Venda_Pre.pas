if EstaoPressionadas([VK_CONTROL,VK_MENU,VK_F2]) then
   begin
   fDeletaPadroes(0,'_VENDA_PRE','CODBCO_101');
   fGravaPadroes(0,'CODBCO_101'    ,'text'   ,'_VENDA_PRE',edt_codbco101.Text);
   MessageDlg('Banco '+edt_codbco101.Text+' - '+edt_nombco.Text+' Definidos como padrão!',mtInformation,[mbOk],0);
   end;

end;

procedure TFrm_Venda_Pre.edt_codbco101KeyPress(Sender: TObject;
  var Key: Char);
begin
if (key in ['A'..'Z']) or (key in ['a'..'z']) or (key='%') then

   begin
   edt_codbco101.Text:=fChamaBco(0,'_venda',key);
   edt_codbco101Exit(Self);
   key:=#0;
   end;

end;

