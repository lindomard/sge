procedure TFrm_Venda_Pre.fCarregarTiposDeVias;
var
query_tpc: TQuery;
begin

query_tpc:=TQuery.Create(nil);
query_tpc.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_tpc.SQL.add('select * from CADP01_TIPOS_CORTE where PTC_CODEMP=:CODEMP '
                 +' and PTC_CHAVE = :CHAVE '
                 +' and PTC_CHAVE_ANO = :CHAVE_ANO '
                 +' order by PTC_SEQ ' );
query_tpc.ParamByName('CODEMP').AsInteger := mVenda_GP.mPed1_Codemp;
query_tpc.ParamByName('CHAVE').AsInteger := mVenda_GP.mped1_Chave;
query_tpc.ParamByName('CHAVE_ANO').AsInteger := mVenda_GP.mPed1_Chave_ano;
try
   query_tpc.Open;
except on e : exception do
   begin
   ex_erroSql_Novo(query_tpc,32644,'SGE','CADP01_TIPOS_CORTE');
   query_tpc.close;
   freeandnil(query_tpc);
   exit;
   end;
   end;
if cds_ped01_tipos_corte.Active=false then
   cds_ped01_tipos_corte.CreateDataSet;
cds_ped01_tipos_corte.EmptyDataSet;
While not query_tpc.Eof do
   begin
   cds_ped01_tipos_corte.Append;
   cds_ped01_tipos_cortePTC_ID.AsInteger           :=  query_tpc.fieldbyName('PTC_ID').AsInteger;
   cds_ped01_tipos_cortePTC_CODEMP.AsInteger       :=  query_tpc.fieldbyName('PTC_CODEMP').AsInteger;
   cds_ped01_tipos_cortePTC_CHAVE.AsInteger        :=  query_tpc.fieldbyName('PTC_CHAVE').AsInteger;
   cds_ped01_tipos_cortePTC_CHAVE_ANO.AsInteger    :=  query_tpc.fieldbyName('PTC_CHAVE_ANO').AsInteger;
   cds_ped01_tipos_cortePTC_SEQ.AsInteger          :=  query_tpc.fieldbyName('PTC_SEQ').AsInteger;
   cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.AsString :=  query_tpc.fieldbyName('PTC_TIPO_DO_CORTE').AsString;
   cds_ped01_tipos_cortePTC_ID_NEW.AsFloat         :=  query_tpc.fieldbyName('PTC_ID_NEW').AsFloat;
   cds_ped01_tipos_cortePTC_ID_PED01_NEW.AsFloat   :=  query_tpc.fieldbyName('PTC_ID_PED01_NEW').AsFloat;


   cds_ped01_tipos_corte.Post;
   query_tpc.Next;
   end;

query_tpc.Close;
freeandnil(query_tpc);

end;


procedure TFrm_Venda_Pre.fGravarTiposDeVias;
var
query_tpc: TQuery;
mMaiorTpc: integer;
mSelectTpc: String;
begin
if cds_ped01_tipos_corte.IsEmpty then
   mMaiorTpc:=-1
else
   begin
   mMaiorTpc :=  cds_ped01_tipos_corte.RecordCount;
   end;

{
if (mMaiorTpc < CB_METAL_QTD_VIAS_PROD.Value) then
   begin
   MessageDlg('Quantidade de Vias Esperado '+inttostr(CB_METAL_QTD_VIAS_PROD.Value)+' Encontrado '+inttostr(mMaiorTpc)+' é invalido ',mtWarning,[mbOk],0);
   end;
}


query_tpc:=TQuery.Create(nil);
query_tpc.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_tpc.SQL.add('delete from CADP01_TIPOS_CORTE where '
                 +' PTC_CODEMP=:CODEMP '
                 +' and PTC_CHAVE = :CHAVE '
                 +' and PTC_CHAVE_ANO = :CHAVE_ANO '
                 +' and PTC_SEQ > :SEQ ');
query_tpc.ParamByName('CODEMP').AsInteger := mVenda_GP.mPed1_Codemp;
query_tpc.ParamByName('CHAVE').AsInteger := mVenda_GP.mped1_Chave;
query_tpc.ParamByName('CHAVE_ANO').AsInteger := mVenda_GP.mPed1_Chave_ano;
query_tpc.ParamByName('SEQ').AsInteger := mMaiorTpc;
try
   query_tpc.execsql;
except on e : exception do
   begin
   ex_erroSql_Novo(query_tpc,32704,'SGE','CADP01_TIPOS_CORTE');
   query_tpc.close;
   freeandnil(query_tpc);
   exit;
   end;
   end;

{ MERGE INTO TESTE t1
  USING (SELECT 1 AS ID,'LINDOMAR2' AS NOME
           FROM DUAL) ss
     ON (t1.ID = ss.ID) -- whatever the key is
   WHEN MATCHED THEN
     UPDATE SET t1.NOME = ss.NOME
   WHEN NOT MATCHED THEN
     INSERT( t1.ID, t1.NOME )
       VALUES( ss.ID, ss.NOME )
}

mSelectTpc := '';
cds_ped01_tipos_corte.first;
While not cds_ped01_tipos_corte.Eof do
   begin
   mSelectTpc:=mSelectTpc+iif(trim(mSelectTpc)='','',' union all '+chr(13));
   mSelectTpc :=mSelectTpc  + ' select '+
   iif(cds_ped01_tipos_cortePTC_ID.AsInteger<1,
   inttostr(fBuscarProximoIdPed01TiposCorte),
   cds_ped01_tipos_cortePTC_ID.AsString) +' AS PTC_ID'
               +', ' +  cds_ped01_tipos_cortePTC_CODEMP.AsString +' AS PTC_CODEMP'
               +', ' +  cds_ped01_tipos_cortePTC_CHAVE.AsString  +' AS PTC_CHAVE'
               +', ' + cds_ped01_tipos_cortePTC_CHAVE_ANO.AsString +' AS PTC_CHAVE_ANO'
               +', ' +cds_ped01_tipos_cortePTC_SEQ.AsString +' as  PTC_SEQ'
               +', ' +QuotedStr( fCorrigirAspasSimplesParaSql(cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.AsString)) +' as PTC_TIPO_DO_CORTE'
               +', ' +cds_ped01_tipos_cortePTC_ID.AsString +' as  PTC_SEQ'
               +', ' +cds_ped01_tipos_cortePTC_ID_PED01_NEW.AsString +' as  PTC_SEQ'
               +' from dual '+chr(13);
   cds_ped01_tipos_corte.Next;

   end;
if trim(mSelectTpc)<>'' then
   begin
   mSelectTpc:='Select * from ('+mSelectTpc+') ';

   query_tpc.close;
   query_tpc.SQL.clear;
   query_tpc.SQL.add(' MERGE INTO CADP01_TIPOS_CORTE  t1 '
                    +' USING ('+mSelectTpc
                    +') ss '
                    +'  ON (t1.PTC_ID = ss.PTC_ID) '
                    +'  WHEN MATCHED THEN '
                    +'  UPDATE SET t1.PTC_TIPO_DO_CORTE = ss.PTC_TIPO_DO_CORTE '
                    +'  WHEN NOT MATCHED THEN '
                    +'   INSERT( '
                    +' t1.PTC_ID '
                    +', t1.PTC_CODEMP'
                    +', t1.PTC_CHAVE'
                    +', t1.PTC_CHAVE_ANO'
                    +', t1.PTC_SEQ'
                    +', t1.PTC_TIPO_DO_CORTE'
                    +', t1.PTC_ID_NEW'
                    +', t1.PTC_ID_PED01_NEW'
                    +' ) '
                    +'  VALUES( '
                    +'  ss.PTC_ID '
                    +', ss.PTC_CODEMP'
                    +', ss.PTC_CHAVE'
                    +', ss.PTC_CHAVE_ANO'
                    +', ss.PTC_SEQ'
                    +', ss.PTC_TIPO_DO_CORTE'
                    +', ss.PTC_ID_NEW'
                    +', ss.PTC_ID_PED01_NEW'

                    +' )');

   try
      query_tpc.execSql;
//      ex_erroSql_Novo(query_tpc,32770,'SGE','CADP01_TIPOS_CORTE');

   except on e : exception do
      begin
      ex_erroSql_Novo(query_tpc,32770,'SGE','CADP01_TIPOS_CORTE');
      query_tpc.close;
      freeandnil(query_tpc);
      exit;
      end;
      end;
   end;



query_tpc.Close;
freeandnil(query_tpc);

end;



