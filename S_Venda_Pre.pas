if (mVenda_GP.mPed1_Tipo_Ped=8) or (mVenda_GP.mPed1_Tipo_Ped=12)
//or (mVenda_GP.mPed1_Tipo_Ped=29)
or (cds_aliquotasrequer_pedori.AsInteger>0) then
   begin
   Query_Lote.SQL.Add('SELECT P2LM_CODPRO AS CLCODPRO, P2LM_LOTE AS CLNUMERO,P2LM_DTVCTO AS CLDTVCTO, P2LM_DTFAB AS CLDTFAB, '
                      +'       P2LM_QTD AS CLQTD FROM CADP02_LOTES ');

   mCompChaves:=' Where ((';
   mem_ped01d.First;
   While not mem_ped01d.Eof do
      begin
      if mem_ped01dP1DCH_OR.IsNull then
         begin
         mem_ped01d.Next;
         Continue;
         end;
      Query_lote.SQL.add(mCompChaves+'( P2LM_CODEMP=0'+mem_ped01dP1DCODEMP_OR.AsString
                        +' and P2LM_LOTSEQ=0'+mem_ped01dP1DLS_OR.AsString
                        +' and P2LM_CHAVE=0'+mem_ped01dP1DCH_OR.AsString+')');
      mCompChaves:=' ) or ( ';
      mem_ped01d.Next;
      end;
   if mCompChaves=' ) or ( ' then
      begin
      Query_Lote.SQL.Add(')) ');
      end;
   end
else
   begin
   Query_lote.SQL.Add('Select CLCODPRO,CLNUMERO,CLDTVCTO,CLDTFAB,CLQTD from CADLGC '
                   +' where (CLCODEMP=:CODEMP or CLCODEMP=:CODEMP_FILIAL) '
                   +' and CLCODPRO=:CODPRO '
                   +' and  (CLFILIAL=:FILIAL or CLFILIAL is null) '

                   +' order by CLDTVCTO,CLNUMERO');
   Query_lote.parambyName('FILIAL').asinteger:=mVenda_GP.mped1_Filial;
   query_lote.parambyName('CODEMP').asinteger:=codemp;
   if codemp>100 then
      query_lote.parambyName('CODEMP_FILIAL').asinteger:=codemp-100
   else
      query_lote.parambyName('CODEMP_FILIAL').asinteger:=codemp+100;
   query_lote.ParamByName('CODPRO').AsFloat:=fSonumero(pCodpro);
   end;
query_lote.open;
mQtd_Falta:=pQtd_Nova;
Tb_Ped02_Lotes.First;
While (not Tb_Ped02_Lotes.Eof) do
   begin
   if Arredonda( Tb_Ped02_LotesP2LM_QTD.AsFloat , DM1.Tb_PargerPCASQTD.AsInteger)<=Arredonda(mQtd_Falta, DM1.Tb_PargerPCASQTD.AsInteger) then
      begin
      mQtd_Falta:=mQtd_Falta-Arredonda( Tb_Ped02_LotesP2LM_QTD.AsFloat , DM1.Tb_PargerPCASQTD.AsInteger);
      end
   else
      begin
      if mQtd_Falta<=0 then
         Tb_Ped02_Lotes.Delete
      else
         begin
         Tb_Ped02_Lotes.Edit;
         Tb_Ped02_LotesP2LM_QTD.AsFloat:=mQtd_Falta;
         Tb_Ped02_Lotes.Post;
         mQtd_Falta:=0;
         end;
      end;
   Tb_Ped02_Lotes.Next;
   end;


While (not Query_lote.Eof) and (mQtd_Falta>0) do
   begin

   if (Query_lote.fieldbyName('CLQTD').AsFloat) <=0 then
      begin
      Query_lote.Next;
      Continue;
      end;
   if Tb_Ped02_Lotes.Locate(  'P2LM_CODPRO;P2LM_LOTE',vararrayof([Query_lote.fieldbyName('CLCODPRO').AsFloat,
                        Query_lote.fieldbyName('CLNUMERO').AsString]),[]) then
      begin
      if (pEstNor_Ant='N') and (pEstNor_Atu='S') then
         mQtdAnt:=Tb_Ped02_LotesP2LM_QTD.AsFloat
      else
         mQtdAnt:=0;
      if (Query_lote.fieldbyName('CLQTD').AsFloat) <=mQtdAnt then
         begin
         Query_lote.Next;
         Continue;
         end;
      Tb_Ped02_Lotes.Edit
      end
   else
      begin
      Tb_Ped02_Lotes.Append;
      Tb_Ped02_LotesP2LM_ITEM.AsInteger:=pItem;
      Tb_Ped02_LotesP2LM_CODPRO.Value  :=fsonumero(pCodpro);
      Tb_Ped02_LotesP2LM_QTD.AsFloat:=0;
      Tb_Ped02_LotesP2LM_LOTE.AsString :=Query_lote.fieldbyName('CLNUMERO').AsString;
      Tb_Ped02_LotesP2LM_DTVCTO.AsDateTime :=Query_lote.fieldbyName('CLDTVCTO').AsDateTime;
      Tb_Ped02_LotesP2LM_DTFAB.AsDateTime  :=Query_lote.fieldbyName('CLDTFAB').AsDateTime;
      end;
   if mQtd_Falta<=(Query_lote.fieldbyName('CLQTD').AsFloat-mQtdAnt) then
      begin
      Tb_Ped02_LotesP2LM_QTD.AsFloat   :=Tb_Ped02_LotesP2LM_QTD.AsFloat+(mQtd_Falta);
      mQtd_Falta:=0;
      end
   else
      begin
      Tb_Ped02_LotesP2LM_QTD.AsFloat   :=Tb_Ped02_LotesP2LM_QTD.AsFloat+
               Arredonda( Query_lote.fieldbyName('CLQTD').AsFloat-mQtdAnt, DM1.Tb_PargerPCASQTD.AsInteger);
      mQtd_Falta:=Arredonda( ( (mQtd_Falta+mQtdAnt) -Query_lote.fieldbyName('CLQTD').AsFloat), DM1.Tb_PargerPCASQTD.AsInteger);
      end;
   Tb_Ped02_Lotes.Post;
   Query_lote.Next;
   end;

if mQtd_Falta>0 then
   begin
   Tb_Ped02_Lotes.First;
   While (not Tb_Ped02_Lotes.Eof) and (mQtd_Falta>0) do
      begin
      if trim(Tb_Ped02_LotesP2LM_LOTE.AsString)<>'' then
         begin
         Tb_Ped02_Lotes.Next;
         continue;
         end;
      Tb_Ped02_Lotes.Edit;
      Tb_Ped02_LotesP2LM_ITEM.AsInteger:=pItem;
      Tb_Ped02_LotesP2LM_CODPRO.Value  :=fsonumero(pCodpro);
      Tb_Ped02_LotesP2LM_QTD.AsFloat   :=Tb_Ped02_LotesP2LM_QTD.AsFloat+mQtd_Falta;
      Tb_Ped02_LotesP2LM_LOTE.AsString :='';
      Tb_Ped02_LotesP2LM_DTVCTO.AsDateTime :=pdatanula;
      Tb_Ped02_LotesP2LM_DTFAB.AsDateTime  :=pdatanula;
      Tb_Ped02_Lotes.Post;
      mQtd_Falta:=0;
      Tb_Ped02_Lotes.Next;
      end;
   if mQtd_Falta>0 then
      begin
      Tb_Ped02_Lotes.Append;
      Tb_Ped02_LotesP2LM_ITEM.AsInteger:=pItem;
      Tb_Ped02_LotesP2LM_CODPRO.Value  :=fsonumero(pCodpro);
      Tb_Ped02_LotesP2LM_QTD.AsFloat:=mQtd_Falta;
      Tb_Ped02_LotesP2LM_LOTE.AsString :='';
      Tb_Ped02_LotesP2LM_DTVCTO.AsDateTime :=pdatanula;
      Tb_Ped02_LotesP2LM_DTFAB.AsDateTime  :=pdatanula;
      Tb_Ped02_Lotes.Post;
      mQtd_Falta:=0;
      end;
   end;


if mVenda_GP.mped1_submod=0 then
   begin
   Tb_Ped02_Lotes.First;
   While not Tb_Ped02_Lotes.Eof do
      begin
      Tb_Ped02_Lotes.Edit;
      Tb_Ped02_LotesP2LM_QTD_101.Value:=0;
      Tb_Ped02_LotesP2LM_QTD_001.Value:=Tb_Ped02_LotesP2LM_QTD.AsFloat;
      Tb_Ped02_Lotes.Post;
      Tb_Ped02_Lotes.Next;
      end;
   end
else if mVenda_GP.mped1_submod=100 then
   begin
   Tb_Ped02_Lotes.First;
   While not Tb_Ped02_Lotes.Eof do
      begin
      Tb_Ped02_Lotes.Edit;
      Tb_Ped02_LotesP2LM_QTD_001.Value:=0;
      Tb_Ped02_LotesP2LM_QTD_101.Value:=Tb_Ped02_LotesP2LM_QTD.AsFloat;
      Tb_Ped02_Lotes.Post;
      Tb_Ped02_Lotes.Next;
      end;
   end
else
   begin
   Tb_Ped02_Lotes.First;
   While not Tb_Ped02_Lotes.Eof do
      begin
      Tb_Ped02_Lotes.Edit;

      if mVenda_GP.mped1_formace=1 then
         begin
         Tb_Ped02_LotesP2LM_QTD_101.Value:=0;
         mQtdCal:=Tb_Ped02_LotesP2LM_QTD.AsFloat;
         Tb_Ped02_LotesP2LM_QTD_001.Value:=mQtdCal;
         end
      else
         begin
         mQtdCal:=Tb_Ped02_LotesP2LM_QTD.AsFloat;
         mQtdCal:=Arredonda( (mQtdCal*mVenda_GP.mped1_submod/100), 0);
         Tb_Ped02_LotesP2LM_QTD_101.Value:=mQtdCal;
         mQtdCal:=Tb_Ped02_LotesP2LM_QTD.AsFloat-mQtdCal;
         Tb_Ped02_LotesP2LM_QTD_001.Value:=mQtdCal;
         end;
      Tb_Ped02_Lotes.Post;
      Tb_Ped02_Lotes.Next;
      end;
   end;


FreeAndNil(Query_lote);
result:=true;


end;

function TFrm_Venda_Pre.fLerCadp02_Lotes(pItem: Integer;pCodPro: Real): Boolean;
begin
Tb_Ped02_Lotes.Close;
Tb_Ped02_Lotes.SQL.Clear;
Tb_Ped02_Lotes.SQL.add(' Select SUM(P2LM_QTD) AS P2LM_QTD, '
                      +' sum( CASE WHEN P2LM_CODEMP<100 THEN P2LM_QTD ELSE 0 END ) AS P2LM_QTD_001 '
                      +' ,sum(  CASE WHEN P2LM_CODEMP<100 THEN 0 ELSE P2LM_QTD END) AS P2LM_QTD_101 '
                      +' ,P2LM_ITEM,P2LM_LOTE,P2LM_DTFAB,P2LM_DTVCTO,P2LM_CODPRO '
                      +' from CADP02_LOTES '
                      +' where (P2LM_CODEMP=:CODEMP or P2LM_CODEMP=:CODEMP_FILIAL) '
                      +' and P2LM_CHAVE=:CHAVE '
                      +' and P2LM_LOTSEQ=:CHAVE_ANO '
                      + ' and P2LM_ITEM=:ITEM ');
Tb_ped02_Lotes.ParamByName('ITEM').AsInteger:=pItem;

//                      +' and P2LM_CODPRO=:CODPROM ');
if pCodpro=0 then
   begin
   Tb_Ped02_Lotes.SQL.add(' and P2LM_CODPRO=:CODPRO ');
   Tb_ped02_Lotes.ParamByName('CODPRO').AsFloat:=ValFloat(Tb_Ped02_preP2CODPRO.AsString);
   end
else
   begin
   Tb_Ped02_Lotes.SQL.add(' and P2LM_CODPRO=:CODPRO ');
   Tb_ped02_Lotes.ParamByName('CODPRO').AsFloat:=pCodPro;
   end;

Tb_Ped02_Lotes.SQL.add('  GROUP BY P2LM_ITEM,P2LM_LOTE,P2LM_DTFAB,P2LM_DTVCTO,P2LM_CODPRO ');
Tb_Ped02_Lotes.SQL.add(' order by P2LM_DTVCTO,P2LM_LOTE ');
Tb_ped02_Lotes.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp_ini;
Tb_ped02_Lotes.ParamByName('CODEMP_FILIAL').AsInteger:=mVenda_GP.mPed1_Codemp_fin;
Tb_ped02_Lotes.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
Tb_ped02_Lotes.ParamByName('CHAVE_ANO').AsInteger:=mVenda_GP.mPed1_Chave_ano;
//Tb_ped02_Lotes.ParamByName('ITEM').AsInteger:=pItem;
Try
   Tb_Ped02_Lotes.Open;
   result:=true;
except
   ex_erroSql_Novo(Tb_Ped02_Lotes,5980,'venda_pre','CADP02_LOTES');
   result:=false;
   end;

end;



function TFrm_Venda_Pre.fLerCadp02_Lotes_Antes(pItem: Integer;pCodPro: Real): Boolean;
begin
Tb_Ped02_Lotes_Ant.Close;
Tb_Ped02_Lotes_Ant.SQL.Clear;
