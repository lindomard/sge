mpct_seq                  := -1;
mpct_tipo_corte           := '-1';



end;
function TFrm_Venda_Pre.fExisteOrdemTpc(pOrdem: integer; pPosicao: integer): boolean;
var
mEncontrado: String;
mPosicao : integer;

begin
mEncontrado:='';

cds_ped01_tipos_corte.First;
mPosicao:=0;
While not cds_ped01_tipos_corte.Eof do
   begin
   mPosicao:=mPosicao+1;

   if  mPosicao<>pPosicao then
      begin
      if cds_ped01_tipos_cortePTC_SEQ.AsInteger=pOrdem then
         begin
         mEncontrado:=mEncontrado+'Ordem '+IntToStr(pOrdem)+' Tipo do Corte '+cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.AsString+#13;
         end;
      end;
   cds_ped01_tipos_corte.Next;
   end;
if trim(mEncontrado)<>'' then
   begin
   MessageDlg('Ordem encontrada '+mEncontrado+'. É invalido!',mtWarning,[mbOk],0 );
   result:=false;
   end
else
   result:=true;

end;


function TFrm_Venda_Pre.fExisteTipoCorteTpc(pTipoCorte: String; pPosicao: Integer): boolean;
var
mEncontrado: String;
mPosicao: integer;
begin
mEncontrado:='';

cds_ped01_tipos_corte.First;
mPosicao:=0;
While not cds_ped01_tipos_corte.Eof do
   begin
   mPosicao:=mPosicao+1;
   if mPosicao<>pPosicao then
      begin
      if cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.AsString=pTipoCorte then
         begin
         mEncontrado:=mEncontrado+'Ordem '+cds_ped01_tipos_cortePTC_SEQ.AsString+' Tipo do Corte '+cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.AsString+#13;
         end;
      end;
   cds_ped01_tipos_corte.Next;
   end;
if trim(mEncontrado)<>'' then
   begin
   MessageDlg('Tipo de Conte Encontrado '+mEncontrado+'. É invalido!',mtWarning,[mbOk],0 );
   result:=false;
   end
else
   result:=true;

end;

function TFrm_Venda_Pre.fPosicaoTpc: tBookmark;
var
mPosicao: integer;
begin
mpct_posicao:=-1;
mPosicao:=0;
if (mpct_id<=0) and (mpct_seq<=0) then
   begin
   result := nil;
   end
else
   begin
   cds_ped01_tipos_corte.First;
   While not cds_ped01_tipos_corte.eof do

      begin
      mPosicao:=mPosicao+1;
      if (cds_ped01_tipos_cortePTC_ID.AsInteger=mpct_id) and
         (mpct_seq = cds_ped01_tipos_cortePTC_SEQ.AsInteger) and
         (mpct_tipo_corte = cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.AsString) then
         begin
         result := cds_ped01_tipos_corte.GetBookmark;
         mpct_posicao:=mPosicao;
         exit;
         end;
      cds_ped01_tipos_corte.Next;
      end;
   end;
result := nil

end;


procedure TFrm_Venda_Pre.tpc_salvarClick(Sender: TObject);
var
mBookMarck: TBookmark;
begin

if spn_tpc_seq.Value<1 then
   begin
   MessageDlg('Ordem Tem que Ser Maior que 0 (zero)', mtWarning,[mbOk],0);
   exit;
   end
else if spn_tpc_seq.Value>CB_METAL_QTD_VIAS_PROD.Value  then
   begin
   MessageDlg('Ordem Tem que Ser menor que  '+inttostr(CB_METAL_QTD_VIAS_PROD.Value+1) , mtWarning,[mbOk],0);
   exit;
   end;



mped_Alterou_Cab:=true;

mBookMarck:=fPosicaoTpc;

if not fExisteOrdemTpc(spn_tpc_seq.Value,mpct_posicao) then
   exit;

if not fExisteTipoCorteTpc(edt_tpc_tipos_cortes.Text,mpct_posicao) then
   exit;
//cds_ped01_tipos_corte.DisableControls;

if (mpct_id>0) or (mpct_seq>0) then
   begin
   cds_ped01_tipos_corte.First;
   While not cds_ped01_tipos_corte.eof do
      begin
      if (cds_ped01_tipos_cortePTC_ID.AsInteger = mpct_id) and
         (mpct_seq                = cds_ped01_tipos_cortePTC_SEQ.AsInteger) and
         (mpct_tipo_corte        = cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.AsString)   then
         begin
         cds_ped01_tipos_corte.Edit;
         break;
         end;
      cds_ped01_tipos_corte.Next;
      end;
   end
else
   begin
   cds_ped01_tipos_corte.Append;
   cds_ped01_tipos_cortePTC_ID.value :=0;
   end;

cds_ped01_tipos_cortePTC_CODEMP.value        :=mVenda_GP.mPed1_Codemp;
cds_ped01_tipos_cortePTC_CHAVE.value         :=mVenda_GP.mped1_Chave;
cds_ped01_tipos_cortePTC_CHAVE_ANO.value     :=mVenda_GP.mPed1_Chave_ano;
cds_ped01_tipos_cortePTC_SEQ.value           :=spn_tpc_seq.Value;
cds_ped01_tipos_cortePTC_TIPO_DO_CORTE.value :=edt_tpc_tipos_cortes.Text;
cds_ped01_tipos_corte.post;

if mBookMarck<>nil then
   cds_ped01_tipos_corte.GotoBookmark(mBookMarck);
//cds_ped01_tipos_corte.EnableControls;
tpc_excluirClick(self);

end;

