function TFrm_Venda_Pre.fValidarCbenef(pChave: integer): boolean;
var
query_cbenef: tQuery;
begin
if DM1.Tb_EmpEMP_OPTSIMPLES.AsInteger<>3 then
   begin
   result:=true;
   exit;
   end;
query_cbenef:=tQuery.create(nil);
query_cbenef.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
query_cbenef.Sql.add('SELECT PDCODPRO,PDNOME,PDCLAS,P2CBENEF,CST_CODIGO,CSTB_CBENEF,CUF,CSTB_UF FROM CADP02,CADPRO,CADCST_ICMS,CADP01,CADCLI '
                    +' ,CADCST_ICMS_CBENEF WHERE PDCODPRO=P2CODPRO '
                    +' AND CST_CODIGO=SUBSTR(P2SIT,2,2) '
                    +' AND P1ID_NEW = P2ID_PED01_NEW '
                    +' AND CCODCLI=P1CODCLI '
                    +' AND CSTB_ID_CST=CST_ID '
                    +' AND CUF=CSTB_UF '
                    +' AND LENGTH(NVL(PDCLAS,'+QuotedStr(' ')+'))>2 AND NVL(P2CBENEF ,'+QuotedStr(' ')+')='+QuotedStr(' ')
                    +' AND P2CHAVE='+IntTostr(pChave));
try
   query_cbenef.open;
except on e : exception do
   begin
   ex_erroSql_Novo(query_cbenef,33979,'venda_pre'+e.Message,'CADP02');
   end;
   end;
if not query_cbenef.IsEmpty then
   begin
   Application.CreateForm(TFrm_Ocorrencias, frm_ocorrencias);
   frm_ocorrencias.ListView1.Clear;
   Frm_Ocorrencias.mErros:=false;
   While not query_cbenef.eof do
      begin
      Frm_Ocorrencias.adicionaItemListView('Produto '+query_cbenef.fieldbyname('PDNOME').AsString +' / ' +
                                          query_cbenef.FieldByName('PDCODPRO').AsString
                                          +' Ncm '+query_cbenef.FieldByName('PDCLAS').AsString +' Esta sem Código do Beneficio ');
      Frm_Ocorrencias.ListView1.Items[Frm_Ocorrencias.mPosicaoItem].ImageIndex:=3;
      Frm_Ocorrencias.mErros:=true;
      query_cbenef.next;
      end;
   if Frm_Ocorrencias.mErros then
      begin
      frm_ocorrencias.lbl_ocorrencia.Caption:='Não sera possível Emitir a Nota Fiscal!!!';
      Frm_Ocorrencias.ShowModal;
      end;
   freeandnil(frm_ocorrencias);
   end;


result := query_cbenef.IsEmpty;
query_cbenef.close;
FreeAndNil(query_cbenef);

end;
