function TFrm_Venda_Pre.fTemPrazoMem(): boolean;
var
mTemPrazoFiado: boolean;
mCodVinc: integer;
begin
mTemPrazoFiado:=false;

if (mped_CBLOQVDAPRZ=0) or (sbnGravar.enabled=false) then

   begin
   result := mTemPrazoFiado;
   exit;
   end;

{
if ( (pVinc>0) and  (pVinc<5) )  or   (pPrazo<1) then
else
   mTemPrazoFiado:= true;
 }

mem_cadpfp.First;
While not mem_cadpfp.Eof do
   begin
   if fLerGenerico_query('CADFP','FPCODIGO,FPDESC,FPVINCULO','FPCODIGO='+mem_cadpfpPFPFORMA.AsString,query_consulta) then
      mCodVinc := query_consulta.fieldbyname('FPVINCULO').AsInteger;
      if (mem_cadpfpPFPPRAZO.AsInteger<1) then
         begin
         mem_cadpfp.Next;
         continue;
         end;

       case mCodVinc of
          00: begin
              if mem_cadpfpPFPDATA.AsDateTime>now then
                 begin
                 mTemPrazoFiado := true;
                 break;
                 end
              else
                 begin
                 mem_cadpfp.Next;
                 continue;
                 end;
              end;
          03: begin mem_cadpfp.Next; continue; end;
          04: begin mem_cadpfp.Next; continue; end;
          05: begin mem_cadpfp.Next; continue; end;
          06: begin mem_cadpfp.Next; continue; end;
          17: begin mem_cadpfp.Next; continue; end;
          20: begin mem_cadpfp.Next; continue; end;
          21: begin mem_cadpfp.Next; continue; end;
          22: begin mem_cadpfp.Next; continue; end;
          23: begin mem_cadpfp.Next; continue; end;
          30: begin mem_cadpfp.Next; continue; end;
          else begin
               mTemPrazoFiado := true;
               break;
               end;
          end;
{
       query_consulta.Next;

   if ( (mCodVinc>0) and
      (mCodVinc<5) )  or
      (mem_cadpfpPFPPRAZO.AsInteger<1) then
      begin
      mem_cadpfp.Next;
      continue;
      end;
}
   mTemPrazoFiado := true;
   mem_cadpfp.Next;
   end;

if mTemPrazoFiado then
   begin
   verteclado(0);
   MessageDlg('Cliente Sem Permissão Para Venda a Prazo!',mtWarning,[mbOk],0);
   end;
result := mTemPrazoFiado;

end;

