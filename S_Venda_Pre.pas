function TFrm_Venda_Pre.fTotaisAdicionais: Boolean;

var
  Qry :TQuery;
begin
Qry:=TQuery.Create(nil);
Qry.DatabaseName:=DM1.SG_ASSOC.DatabaseName;
Qry.Close;
Qry.SQL.Clear;
Qry.SQL.Add(' select sum(P1AE_VALOR) as TOTAL from CADP01_ADDEXT ');
Qry.SQL.Add(' where P1AE_CODEMP='+FloatToStr(mVenda_GP.mPed1_Codemp));
Qry.SQL.Add('   and P1AE_CHAVE='+FloatToStr(mVenda_GP.mPed1_Chave));
Qry.SQL.Add('   and P1AE_LOTSEQ='+FloatToStr(mVenda_GP.mPed1_Chave_ano));
