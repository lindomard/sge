else
   begin
   try
      edt_hora_pent.Text:=formatDatetime('hh:nn', StrTotime(edt_hora_pent.Text+':00'));
   except
      edt_hora_pent.Text:='00:00';
      end;
   end;
edt_data_pentExit(self);

end;

