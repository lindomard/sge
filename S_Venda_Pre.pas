                   ,mVenda_GP.mPd_EstVenda

                   ,mVenda_GP.mPd_EstNor
                   ,mVenda_GP.mPd_EstCons
                   ,mVenda_GP.mPd_EstTerc
                   ,mVenda_GP.mPd_EstVenda
                   );
   mped1_Calculando:=True;
   fAjustarItensPed(false);
   mped1_Calculando:=False;

//    sbnCalcularClick(self);

   end;
mSubMOd_ant:=valint(edt_submod.Text);
fTarifaBancaria;
if mVenda_GP.mped1_submod=0 then
   begin
   edt_codbco1.Visible       :=true;
   edt_codbco101.Visible     :=False;
   end
else if mVenda_GP.mped1_submod=100 then
   begin
   edt_codbco1.Visible       :=false;
   edt_codbco101.Visible     :=true;
   end
else
   begin
   edt_codbco1.Visible       :=true;
   edt_codbco101.Visible     :=true;
   end;
fAtualizarPed01D(2);
fAtualizarPed01D(0);
fDeletarChaveInexistente;

mped_Alterou_Cab:=true;

end;

