procedure TFrm_Venda_Pre.Qr_P01_ADDEXTBeforePost(DataSet: TDataSet);
var
i:Integer;

begin
if (length(trim(Qr_P01_ADDEXTP1AE_NOME.AsString))>1) and (Qr_P01_ADDEXTP1AE_VALOR.AsFloat<>0) then
   begin
   Qr_P01_ADDEXTP1AE_CODEMP.Value:=mVenda_GP.mPed1_Codemp;
   Qr_P01_ADDEXTP1AE_CHAVE.Value :=mVenda_GP.mped1_Chave;
   Qr_P01_ADDEXTP1AE_LOTSEQ.Value:=mVenda_GP.mPed1_Chave_ano;

   if Qr_P01_ADDEXTP1AE_ITEM.IsNull then
      begin
      if fLerGenerico_query('CADP01_ADDEXT','max(P1AE_ITEM) as ITEM','P1AE_CODEMP='+inttostr(mVenda_GP.mPed1_Codemp)
                          +' and P1AE_CHAVE='+inttostr(mVenda_GP.mped1_Chave)
                          +' and P1AE_LOTSEQ='+inttostr(mVenda_GP.mPed1_Chave_ano),query_consulta) then
         Qr_P01_ADDEXTP1AE_ITEM.AsInteger:=query_consulta.Fieldbyname('ITEM').AsInteger+1;
      end;
   end
else
   begin
   Qr_P01_ADDEXT.Cancel;
   abort;
   end;


For i:=0 to Qr_P01_ADDEXT.FieldCount-1 do
   begin
   if not Qr_P01_ADDEXT.Fields[i].IsNull then
      Continue;
   if Qr_P01_ADDEXT.fields[i].DataType in [ftfloat,ftcurrency,ftinteger,ftword,FtDate,FtDateTime] then
      Qr_P01_ADDEXT.Fields[i].Value:=0
//   else if Qr_P01_ADDEXT.fields[i].DataType in [ftDate,ftDateTime] then
//      Qr_P01_ADDEXT.Fields[i].Value:=0
   else if Qr_P01_ADDEXT.Fields[i].DataType in [ftString,ftMemo] then
      Qr_P01_ADDEXT.Fields[i].Value:=' ';
   end;


end;

