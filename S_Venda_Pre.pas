function TFrm_Venda_Pre.fTemPrazoFP(pBloqVdaPrz: Integer ): boolean;
var
mTemPrazoFiado: boolean;
begin
mTemPrazoFiado:=false;

if (pBloqVdaPrz=0) or (sbnGravar.enabled=false) then
   begin
   result := mTemPrazoFiado;
   exit;
   end;
{
if ( (pVinc>0) and  (pVinc<5) )  or   (pPrazo<1) then
else
   mTemPrazoFiado:= true;
 }

if edt_codfp.text<>DM1.Tb_FPFPCODIGO.asstring then
   begin
   if not fLCadFP(0,edt_codfp.Text,'') then
      begin
      result := mTemPrazoFiado;
      exit;
      end;
   end;
if not (Tb_FP_pre.IsEmpty) then
   begin
   Tb_FP_pre.DisableControls;
   Tb_FP_PRE.first;
   While not Tb_FP_pre.Eof do
      begin
      case Tb_FP_prePFPVINCULO_DOC.asinteger of
         00: begin
             if Tb_fp_prePFPDATA.Asdatetime>now() then
                begin
                mTemPrazoFiado := true;
                break;
                end
             else
                begin
                Tb_FP_pre.next;
                continue;
                end;
             end;
         02: begin Tb_FP_pre.next; continue; end;
         03: begin Tb_FP_pre.Next; continue; end;
         04: begin Tb_FP_pre.Next; continue; end;
         06: begin Tb_FP_pre.Next; continue; end;
         17: begin Tb_FP_pre.Next; continue; end;
         20: begin Tb_FP_pre.Next; continue; end;
         21: begin Tb_FP_pre.Next; continue; end;
         22: begin Tb_FP_pre.Next; continue; end;
         23: begin Tb_FP_pre.Next; continue; end;
         24: begin Tb_FP_pre.Next; continue; end;
         30: begin Tb_FP_pre.Next; continue; end;
         end;
//      if (Tb_FP_prePFPPRAZO.AsInteger>0)  then
//         begin
         mTemPrazoFiado := true;
         break;
  //       end;
      Tb_FP_pre.Next;
      end;
   Tb_FP_pre.EnableControls;

   end;

if mTemPrazoFiado then
   begin
   verteclado(0);
   MessageDlg('Cliente Sem Permissão Para Venda a Prazo!',mtWarning,[mbOk],0);
   end;
result := mTemPrazoFiado;

end;



