function fPosArray(pArrayOff: array of string; pTexto: String): Integer;
var
x:Integer;
mResult: Integer;
begin
mResult:=-1;
for x:=low(pArrayOff) to high(pArrayOff) do
   begin
   if Uppercase(pArrayOff[x])=Uppercase(pTexto) then
      begin
      mResult:=x;
      break;
      end;
   end;
result:=mresult;
end;
