procedure TFrm_Venda_Pre.fTpc_AtualizaEventos;

begin
spn_tpc_seq.Enabled := CB_METAL_QTD_VIAS_PROD.Value>0;
edt_tpc_tipos_cortes.Enabled := CB_METAL_QTD_VIAS_PROD.Value>0;


if cds_ped01_tipos_corte.active=false then
   begin
   cds_ped01_tipos_corte.CreateDataSet;
   cds_ped01_tipos_corte.open;
   end;

try
   if (mpct_evento='') and  ( (spn_tpc_seq.Value>0) or (trim(edt_tpc_tipos_cortes.Text)<>'') ) then // se alterando
     mpct_evento:='I';
except on e : exception do
   begin
   mpct_evento:='I';
   messageDlg('Erro '+e.Message,mtError,[mbOk],0);
   end;
   end;

tpc_salvar.Enabled  :=false;
tpc_editar.Enabled  :=cds_ped01_tipos_corte.RecordCount>0;
tpc_excluir.Enabled :=false;

if (mpct_evento='A') OR (mpct_evento='I') then // se alterando
   begin
   tpc_excluir.Enabled :=true;
   tpc_excluir.Caption:='Cancelar';

   if (length(edt_tpc_tipos_cortes.Text)>0) and
      (spn_tpc_seq.Value>0) then
      begin
      tpc_salvar.Enabled:=true;
      end
   else
      begin
      if cds_ped01_tipos_corte.RecordCount>0 then
         begin
         tpc_excluir.Enabled :=true;
         tpc_excluir.Caption:='excluir';
         tpc_editar.Enabled :=true;
         end;
      end;
   end

end;
