procedure TFrm_Venda_Pre.Tb_ped02S_preCalcFields(DataSet: TDataSet);
var
  Query_Item: TQuery;
begin


if mVenda_GP.mPed1_ArrTrunc = 0 then
  Tb_ped02S_prevalor_bruto.AsFloat:=Arredonda(Tb_Ped02s_preP2SQTD.AsFloat*Tb_Ped02S_preP2SPRECO.AsFloat,2)
else
  Tb_Ped02S_prevalor_bruto.AsFloat:=Truncar(Tb_Ped02S_preP2SQTD.AsFloat*Tb_Ped02S_preP2SPRECO.AsFloat,2);

if  ((valfloat(edt_desc_valor.Text)>0) or (ValFloat(edt_pDesc01.Text)>0))
   and  (not Tb_ped02S_preP2SCODSER.IsNull) then
   begin
   if (mServico_lido<>Tb_Ped02s_preP2sITEM.AsInteger) or (Tb_Ped02S_preP2sTOTDES.AsFloat=0) then
      begin
      Query_Item:=TQuery.Create(nil);
      Query_Item.DatabaseName:='SG_ASSOC';
      Query_Item.SQL.Clear;
      Query_Item.SQL.Add('Select sum(P2STOTDES) as TOTDES from CADP02S where '
                     +' P2SCODEMP       =:CODEMP '
                     +' and P2SCHAVE    =:CHAVE '
                     +' and P2SLOTSEQ   =:LOTSEQ '
                     +' and P2SITEM     =:ITEM ');
      query_item.ParamByName('CODEMP').AsInteger     := mVenda_GP.mPed1_Codemp;
      query_item.ParamByName('CHAVE').AsInteger      := mVenda_GP.mped1_Chave;
      query_item.ParamByName('LOTSEQ').AsInteger     := mVenda_GP.mPed1_Chave_ano;
      query_item.ParamByName('ITEM').AsInteger       := Tb_Ped02_preP2ITEM.AsInteger;
      query_item.Open;
      mvaldesc_lido:=Query_Item.fieldbyname('TOTDES').AsFloat;
      Tb_Ped02S_pretotdes.AsFloat  :=Query_Item.fieldbyname('TOTDES').AsFloat;
      FreeAndNil(query_item);
      mServico_lido:=Tb_Ped02S_preP2SITEM.AsInteger;
      end;
   if (Tb_Ped02S_pretotdes.AsFloat=0) then
      Tb_Ped02S_pretotdes.AsFloat  :=mvaldesc_lido;
   end
else
   Tb_Ped02S_pretotdes.AsFloat  :=Tb_Ped02S_preP2STOTDES.AsFloat;

Tb_Ped02S_prevalor_totcalc.AsFloat:=Tb_Ped02S_prevalor_bruto.AsFloat-Tb_Ped02S_pretotdes.AsFloat;
if Tb_ped02S_preP2SDESCFIN_PERC.AsFloat>0 then
   Tb_ped02S_predescfin_valor.AsFloat:=Arredonda( (Tb_ped02S_prevalor_totcalc.AsFloat*Tb_ped02S_preP2SDESCFIN_PERC.AsFloat/100) ,2)
else
   Tb_ped02S_predescfin_valor.AsFloat:=0;




end;

