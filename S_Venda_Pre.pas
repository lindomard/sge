   function fAgruparPed02_dev(pcodEmp,pcodEmp_filial,pChave,pChave_ano: Integer): Boolean;
   var
   Query_testar: tQuery;
   Query_Exe: tQuery;
   mErro: Boolean;
   begin
   mErro:=false;
   Query_testar:=tQuery.Create(nil);
   Query_testar.DatabaseName:='SG_ASSOC';
   Query_testar.Close;
   Query_testar.SQL.Clear;
   Query_testar.SQL.Add('select count(*) from '+mcadp02+' where '
                    +' ('+mp2codemp+'=:CODEMP_MENOR or '+mp2codemp+'=:CODEMP_MAIOR ) '
                    +' and   '+mp2chave+'=:CHAVE'
                    +' and   '+mp2lotseq+'=:CHAVE_ANO'
                    +' and   '+mp2ordem+'=:ORDEM '
                    +' group by '+mp2codpro
                    +'  having count(*)>1 ');
   Query_testar.ParamByName('CODEMP_MENOR').AsInteger   :=pCodEmp;
   Query_testar.ParamByName('CODEMP_MAIOR').AsInteger   :=pCodEmp_filial;
   Query_testar.ParamByName('CHAVE').AsInteger    :=pChave;
   Query_testar.ParamByName('CHAVE_ANO').AsInteger:=pChave_ano;
   Query_testar.ParamByName('ORDEM').AsInteger    :=1;
   try
      Query_testar.Open;
   except
      mErro:=true;
      end;
   if not mErro then
      begin
      if Query_testar.fields[0].AsInteger>0 then
         begin
         Query_testar.Close;
         Query_testar.SQL.Clear;
         Query_testar.SQL.Add('select COLUMN_NAME,DATA_TYPE from USER_TAB_COLUMNS where '
                          +' TABLE_NAME='+QuotedStr(mcadp02)
                          +' and not COLUMN_NAME in ('+QuotedStr(mp2codemp)
                          +','+QuotedStr(mp2chave)
                          +','+QuotedStr(mp2lotseq)
                          +','+QuotedStr(mp2ordem)
                          +','+QuotedStr(mp2codpro)
                          +','+QuotedStr(mp2qtd)
                          +','+QuotedStr(mp2item)
                          +','+QuotedStr(mp2Id_New)

                          +')');

         try
            Query_testar.Open;
         except
            mErro:=true;
            end;
         if not mErro then
            begin
            Query_exe:=tQuery.Create(nil);
            Query_exe.DatabaseName:='SG_ASSOC';
            Query_exe.Close;
            Query_exe.SQL.Clear;
            Query_exe.SQL.Add('Insert into '+mcadp02+' ('
                             +' '+mp2Id_New
                             +','+mp2item
                             +','+mp2codemp
                             +','+mp2CHAVE
                             +','+mp2LOTSEQ );
            if pTipo=0 then
               Query_exe.SQL.Add(','+mp2ORDEM );
            Query_exe.SQL.Add(','+mp2qtd
                             +','+mp2codpro);
            While not query_testar.Eof do
               begin
               Query_Exe.SQL.add(','+Query_testar.fieldbyName('COLUMN_NAME').AsString);
               Query_testar.Next;
               end;
            Query_testar.First;

            Query_exe.SQL.Add(') '
            +' select '
            +mcadp02+'_SEQ.NEXTVAL AS ID_NEW, T2.* '
                        +' FROM ( '

             +'            select ROWNUM AS ITEM,TAB02.*  FROM ( (select '
                             +' '+mp2codemp+'*-1 '
                             +','+mp2CHAVE
                             +','+mp2LOTSEQ);
            if pTipo=0 then
               Query_exe.SQL.Add(','+mp2ORDEM );
            Query_exe.SQL.Add(',sum('+mp2qtd+') as P2QTD '
                             +','+mp2CODPRO  );
            While not query_testar.Eof do
               begin
               if (Query_testar.fieldbyName('COLUMN_NAME').AsString<>'P2ID_NEW') then
                  Query_Exe.SQL.add(',max('+Query_testar.fieldbyName('COLUMN_NAME').AsString+')');
               Query_testar.Next;
               end;
            Query_exe.SQL.add(' from '+mCADP02+' where '
                            +' ('+mp2CODEMP+'=:CODEMP_MENOR or '+mp2CODEMP+'=:CODEMP_MAIOR ) '
                            +' and   '+mp2CHAVE+'=:CHAVE'
                            +' and   '+mp2LOTSEQ+'=:CHAVE_ANO'
                            +' and   '+mp2ORDEM+'=:ORDEM '
                            +' group by '+mp2CODEMP+','+mp2CHAVE+','+mp2LOTSEQ+','+mp2ORDEM+','+mp2CODPRO
                            +' ) TAB02 ) order by ITEM  '
                            +'   ');

            Query_exe.sql.add('  ) T2 ');

            Query_Exe.ParamByName('CODEMP_MENOR').AsInteger   :=pCodEmp;
            Query_Exe.ParamByName('CODEMP_MAIOR').AsInteger   :=pCodEmp_filial;
            Query_Exe.ParamByName('CHAVE').AsInteger    :=pChave;
            Query_Exe.ParamByName('CHAVE_ANO').AsInteger:=pChave_ano;
            Query_Exe.ParamByName('ORDEM').AsInteger    :=1;
            try
               Query_Exe.ExecSQL;
               fdm1StartCommit;
            except
              ex_erroSql_Novo(Query_Exe,22644,'frm_venda_pre',mCADP02);
              mErro:=true;
              end;                                            
            if not mErro then
               begin
               Query_exe.Close;
               Query_exe.SQL.Clear;
               Query_exe.SQL.Add('Delete from '+mCADP02+' where '
                               +' ('+mp2CODEMP+'=:CODEMP_MENOR or '+mp2CODEMP+'=:CODEMP_MAIOR ) '
                               +' and   '+mp2CHAVE+'=:CHAVE'
                               +' and   '+mp2LOTSEQ+'=:CHAVE_ANO'
                               +' and   '+mp2ORDEM+'=:ORDEM ');
               Query_Exe.ParamByName('CODEMP_MENOR').AsInteger   :=pCodEmp;
               Query_Exe.ParamByName('CODEMP_MAIOR').AsInteger   :=pCodEmp_filial;
               Query_Exe.ParamByName('CHAVE').AsInteger    :=pChave;
