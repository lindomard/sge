function TFrm_Venda_Pre.fTestarDev: Boolean;
var
Query_Busca:TQuery;
begin
Query_Busca:=TQuery.Create(nil);
Query_Busca.DatabaseName:='SG_ASSOC';

Query_Busca.Close;
Query_Busca.SQL.Clear;
if mped1_tpPed=3 then
   begin
   Query_Busca.SQL.Add('Select PF1CHAVE AS P1CHAVE,PF1LOTSEQ AS P1LOTSEQ,PF1CODEMP AS P1CODEMP,PF1CODFOR AS  P1CODCLI '
                  +'      ,PF1TOTLIQ AS  P1TOTALL,PF1DATA AS P1DATAP,0 AS  P1ORDEM, FCGC AS CCNPJ,FIE AS CIE  '
                  +', FRAZAO AS RAZSOC '
                  +' from CADPF1,CADFOR where PF1STATUS>0 '
                       +' and FCODFOR=PF1CODFOR ');
   if mem_ped01dP1DCH_OR.AsInteger>0 then
      Query_Busca.SQL.add(' and PF1CHAVE='+mem_ped01dP1DCH_OR.AsString);
   if mem_ped01dP1DLS_OR.AsInteger>0 then
      Query_Busca.SQL.add(' and P1FLOTSEQ='+mem_ped01dP1DLS_OR.AsString);
   if mem_ped01dP1DCODEMP_OR.AsInteger>0 then
      Query_Busca.SQL.add(' and PF1CODEMP='+mem_ped01dP1DCODEMP_OR.AsString)
   else
      begin
      Query_Busca.SQL.Add('and (PF1CODEMP=:CODEMP or PF1CODEMP=:CODEMP_FILIAL )');
      Query_Busca.ParamByName('CODEMP').AsInteger:=codemp;
      if mVenda_GP.mPed1_Codemp>100 then
         Query_Busca.ParamByName('CODEMP_FILIAL').AsInteger:=codemp-100
      else
         Query_Busca.ParamByName('CODEMP_FILIAL').AsInteger:=codemp+100;
      end;
   Query_Busca.SQL.add(' order by P1CODEMP ');
   end
else
   begin
   Query_Busca.SQL.Add('Select P1CHAVE,P1LOTSEQ,P1CODEMP,P1CODCLI '
                  +'      ,P1TOTALL,P1DATAP,P1ORDEM '
                  +'      , CCNPJ AS CCNPJ,CIE AS CIE '
                  +' , CRAZAO AS RAZSOC '
                  +'  from CADP01,CADCLI where P1STATUS<8 and P1EMIDOC>0 and P1TIPO<>9  '
                         +' and CCODCLI=P1CODCLI ');
   if mem_ped01dP1DCH_OR.AsInteger>0 then
      Query_Busca.SQL.add(' and P1CHAVE='+mem_ped01dP1DCH_OR.AsString);
   if mem_ped01dP1DLS_OR.AsInteger>0 then
      Query_Busca.SQL.add(' and P1LOTSEQ='+mem_ped01dP1DLS_OR.AsString);
   if mem_ped01dP1DCODEMP_OR.AsInteger>0 then
      Query_Busca.SQL.add(' and P1CODEMP='+mem_ped01dP1DCODEMP_OR.AsString)
   else
      begin
      Query_Busca.SQL.Add('and (P1CODEMP=:CODEMP or P1CODEMP=:CODEMP_FILIAL )');
      Query_Busca.ParamByName('CODEMP').AsInteger:=codemp;
      if mVenda_GP.mPed1_Codemp>100 then
         Query_Busca.ParamByName('CODEMP_FILIAL').AsInteger:=codemp-100
      else
         Query_Busca.ParamByName('CODEMP_FILIAL').AsInteger:=codemp+100;

      end;
   Query_Busca.SQL.add(' order by P1CODEMP ');
   end;
try
   Query_Busca.Open;
except on e : exception do
   begin
   ex_erroSql_Novo(Query_Busca,19079,'frm lrs'+e.Message ,'CADEST');
   result:=false;
   exit;
   end;
   end;

if mped1_tpPed=3 then
   begin
   if  ( (insere(query_busca.fieldbyname('CCNPJ').asstring,'0',14)<>mcnpj_cli) and
      (insere(query_busca.fieldbyname('CCNPJ').asstring,'0',14)<>mcpf_cli)) then
      begin
      MessageDlg('Pedido não é do fornecedor '+edt_nomcli.Text+' cnpj '+MaskCPFCNPJ(mcnpj_cli )+#13
                +'e sim do fornecedor '+Query_Busca.fieldbyname('razsoc').asstring+' cnpj '
                +MaskCPFCNPJ(query_busca.fieldbyname('CCNPJ').asstring)
                ,mtwarning,[mbOk],0);
      result:=false;

      end;
   end
else
   begin
   if query_busca.fieldbyname('P1CODCLI').asfloat<>fsonumero(edt_codcli.text) then
      begin
       MessageDlg('Pedido não é do cliente '+edt_nomcli.Text+' cnpj '+MaskCPFCNPJ(mcnpj_cli )+#13
                +'e sim do cliente '+Query_Busca.fieldbyname('razsoc').asstring+' cnpj '+MaskCPFCNPJ(query_busca.fieldbyname('CCNPJ').asstring)
                ,mtwarning,[mbOk],0);
      result:=false;
      end;
   end;
FreeAndNil(Query_Busca);

end;

