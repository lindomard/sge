                                      -DM1.Query2.FieldByName('P1DESC01').AsFloat
                                      -DM1.Query2.FieldByName('P1DESC02').AsFloat
                                      -DM1.Query2.FieldByName('P1VLRDES').AsFloat)*100;
      except
         mVenda_GP.mPed1_Perc_Frete:=0;
         end;
      end;
   end;

