function tFrm_Venda_Pre.fChamaPesqPro(pCodSol: Integer; pFormOri,pCarDig: String): String;
{
Parametros
PCodSol: Solicitou o Seguinte Codigo: 0-Codigo do Produto
                                      1-Codigo de Barras
                                      2-Codigo do Produto+Lote

pFormOri = Formulario de Origem da Chamada
pCarDig  = Caractere Digitado
}

begin

mla_lote    :='';
mla_dtvcto  :='';
result:='';
if usaformpro_normal then
   begin
   Form_Pro_Nov.PC1.ActivePage:=Form_Pro_Nov.tsTab;
   Form_Pro_Nov.proNov_ori:=pFormOri;
   Form_Pro_Nov.mtipo    :=1;
   if pCarDig<>'' then
      begin
      if (Form_Pro_Nov.CAMPO.ItemIndex=1) and (not ENumero(pCarDig)) then
         Form_Pro_Nov.CAMPO.ItemIndex:=0;
      Form_Pro_Nov.Edit1.Text:=PCarDig;
      Form_Pro_Nov.Edit1.SelStart:=1;
      Form_Pro_Nov.Edit1.SelLength:=1;
      end;
   if Form_Pro_Nov.ShowModal=mrOk then
      begin
      if pcodsol=0 then
         Result:=DM1.Tb_ProPDCODPRO.AsString
      else if pcodsol=1 then
         Result:=DM1.Tb_ProPDCODBAR.AsString
      else if pcodsol=3 then
         Result:=DM1.Tb_ProPDMARCA.AsString
      else
         Result:=DM1.Tb_ProPDCODPRO.AsString;

      fParametrosConulta;
      fLimparDadosPesqProd;
      mDadosPesqProd.pTipo:=1;
      mDadosPesqProd.pPre:=1;
      mDadosPesqProd.pCodEmp   :=codemp;
//      mDadosPesqProd.pCodPro   :=DM1.Tb_ProPDCODPRO.AsFloat;
      mDadosPesqProd.pSemFiltros:=true;
      form_venda_pesqprod.flcadpro_Local(mDadosPesqProd);
      mDadosPesqProd.pSemFiltros:=false;
      end;
   end
else
   begin
   form_venda_pesqprod.pFilial:=mVenda_GP.mped1_Filial;
   form_venda_pesqprod.pFilial_Desc:=CB_FILIAL.Text;

   propesq_ori:=pFormOri;
   if pCarDig<>'' then
      begin
      if (form_venda_pesqprod.CAMPO.ItemIndex=1) and (not ENumero(pCarDig)) then
         form_venda_pesqprod.CAMPO.ItemIndex:=0;
      form_venda_pesqprod.Edit1.Text:=PCarDig;
      form_venda_pesqprod.Edit1.SelStart:=1;
      form_venda_pesqprod.Edit1.SelLength:=1;
      end;
   form_venda_pesqprod.parpp_acretodos:=mPv_Acrescimo;

   if (form_venda_pesqprod.WindowState=wsNormal)
      and not (form_venda_pesqprod.Visible=True) then
   fLimparDadosPesqProd;

   form_venda_pesqprod.mpro_codcli              :=floattostr(mVenda_GP.mPed1_CodCli);
   form_venda_pesqprod.mpro_aceita_pco_exclusivo:=mPed_PvAceitarpcoexclusivo;
   if fsonumero(form_venda_pesqprod.CODCLI.Text)<>
      mPed_Cli_CodCli then
      begin
      form_venda_pesqprod.CODCLI.Text:=floattostr(mPed_Cli_CodCli);
      if (form_venda_pesqprod.CB_TABPV.Text<>mVenda_GP.mPed1_TabPV) or
         (fsonumero(form_venda_pesqprod.CODPV.TEXT)<>mVenda_GP.mPed1_CODPV) then
         begin
         form_venda_pesqprod.CB_TABPV.Text:=mVenda_GP.mPed1_TabPV;
         form_venda_pesqprod.CODPV.TEXT   :=inttostr(mVenda_GP.mPed1_CODPV);
         end;
      form_venda_pesqprod.CODCLIExit(self);
      end;

   if form_venda_pesqprod.ShowModal=mrOk then
      begin
      if pcodsol=0 then
         Result:=form_venda_pesqprod.Qr_ProPDCODPRO.AsString
      else if pcodsol=1 then
         Result:=form_venda_pesqprod.Qr_ProPDCODBAR.AsString
      else if pcodsol=3 then
         Result:=form_venda_pesqprod.Qr_ProPDMARCA.AsString
      else
         Result:=form_venda_pesqprod.Qr_ProPDCODPRO.AsString;
      end;
   end;
end;

procedure TFrm_Venda_Pre.edt_acrespuExit(Sender: TObject);
var
  perc: Real;
begin
if ValFloat(edt_acrespu.Text)>=100 then
  begin
  edt_acrespu.Text := '99,99';
  end;

if mVenda_GP.mPed1_Acrescimo<>valfloat(edt_acrespu.Text) then
  begin

  mped_Alterou_Cab:=True;
  if mVenda_GP.mPed1_Acrescimo > 0 then
     begin
     if cb_tppco.ItemIndex=2 then
        begin
        perc := - mVenda_GP.mPed1_Acrescimo;
        if (not Tb_ped02_pre.active) or  (sbnGravar.Enabled=false) or (Tb_ped02_pre.isEmpty) then
           exit;
        Tb_Ped02_pre.First;
        While not Tb_Ped02_pre.Eof do
           begin
           Tb_Ped02_pre.Edit;
           Tb_Ped02_preP2PRECO.AsFloat:=Arredonda(Tb_Ped02_preP2PRECO.AsFloat*(1+perc/100),mVenda_GP.mPed1_QtdDec);
           tb_ped02_preVALOR_TOTAL.AsFloat:=tb_ped02_preP2QTD.AsFloat*tb_ped02_preP2PRECO.AsFloat;
           Tb_Ped02_pre.Post;
           Tb_Ped02_pre.Next;
           end;
         perc:=valfloat(edt_acrespu.Text);
         if (not Tb_ped02_pre.active) or  (sbnGravar.Enabled=false) or (Tb_ped02_pre.isEmpty) then
           exit;
         end;
      end;
   mVenda_GP.mPed1_Acrescimo:=ValFloat(edt_acrespu.Text);

   Tb_Ped02_pre.First;
   While not Tb_Ped02_pre.Eof do
     begin
     Tb_Ped02_pre.Edit;
     if cb_tppco.ItemIndex=2 then
        Tb_Ped02_preP2PRECO.AsFloat:=Arredonda(Tb_Ped02_preP2PRECO.AsFloat/(1-perc/100),mVenda_GP.mPed1_QtdDec)
     else
        fPegarPrecoProd(0);

     tb_ped02_preVALOR_TOTAL.AsFloat:=tb_ped02_preP2QTD.AsFloat*tb_ped02_preP2PRECO.AsFloat;
     Tb_Ped02_pre.Post;
     Tb_Ped02_pre.Next;
     end;
  end;
//mVenda_GP.mPed1_Acrescimo:=ValFloat(edt_acrespu.Text);
edt_acrespu.Text:=FormatFloat(mcasas,ValFloat(edt_acrespu.Text));
end;

Function TFrm_Venda_Pre.fAjustarItensPed(pAjustarPU: Boolean): Boolean;
var
  mTabIcm,mCst,mCsoSN: String;
  mCsoSN_Ori: Integer;
begin
if (not Tb_ped02_pre.active) or  (sbnGravar.Enabled=false) or (Tb_ped02_pre.isEmpty) then
   begin
   result:=true;
   exit;
   end;
fGerarEvento('17624 ajustando dados ');

 mped1_ajustandodados:=true;

Tb_Ped02_pre.First;
While not Tb_Ped02_pre.Eof do
   begin
//   form_venda_pesqprod.Qr_Pro.Filtered:=false;

   fParametrosConulta;
   fLimparDadosPesqProd;
   mDadosPesqProd.pTipo:=1;
   mDadosPesqProd.pPre:=1;
   mDadosPesqProd.pCodEmp   :=codemp;
   mDadosPesqProd.pCodPro   :=tb_ped02_preP2CODPRO.AsFloat;
   mDadosPesqProd.pSemFiltros:=true;
   if not form_venda_pesqprod.flcadpro_Local(mDadosPesqProd) then
      begin
      mDadosPesqProd.pSemFiltros:=false;
      Tb_Ped02_pre.Next;
      Continue;
      end;

   mDadosPesqProd.pSemFiltros:=false;
   Tb_Ped02_pre.Edit;
   fGerarEvento('17636 valor do campo ajustarpu '+iif(pajustarpu=true,'true','false'));
   if (pAjustarPU) then //and (form_venda_pesqprod.Qr_Propcoven.AsFloat<>0) then
       begin

// tipo preco inicio

          if (mVenda_GP.mped1_tppco<>4) and (mVenda_GP.mped1_tppco<6) then
             begin
             if (mVenda_GP.mPed1_Tabela='3') then
                Tb_Ped02_preP2TIPO_PCO.Value:=valint(mVenda_GP.mPed1_Tabela)
             else if   (   (DM1.Tb_PargerPDQPCOP.AsInteger=4) or
                           (DM1.Tb_PargerPDQPCOP.AsInteger=5) or (DM1.Tb_PargerPDQPCOP.AsInteger=6) and (mVenda_GP.mPed1_Tabela<>'3')) then
                 begin
                 if (form_venda_pesqprod.Qr_ProPDEMBPAD.AsFloat>0) and (Tb_Ped02_preP2QTD.AsFloat>=form_venda_pesqprod.Qr_ProPDEMBPAD.AsFloat) then
                    begin
                    Tb_Ped02_preP2TIPO_PCO.Value:=2;
                    end
                 else
                    begin
                    if form_venda_pesqprod.Qr_ProPDEMBPAD.AsFloat>0 then
                      Tb_Ped02_preP2TIPO_PCO.Value:=1
                    else
                      begin
                      Tb_Ped02_preP2TIPO_PCO.Value:=valint(mVenda_GP.mPed1_Tabela);
                      end;
                    end;
                 end;
              end;


// tipo preco termino

       fPegarPrecoProd(0);
       end;
    mCodpro_Ant:=tb_ped02_preP2CODPRO.AsString;
    fValidarDigitacaoItem;
   if tb_ped02_preP2QTD.asfloat<>0 then
      begin
      if Log_TipoLote=1 then // usa lotes de mercadorias
         fValidarLotes;
      end;

      if ( (length( trim(Tb_Ped02_prePDNOME.AsString)) <1) or
         ((Tb_Ped02_preP2CODPRO.AsFloat<>valfloat(mCodpro_Ant)) and (valfloat(mcodpro_ant)<>0)) ) then
       tb_ped02_prePDNOME.Value :=form_venda_pesqprod.Qr_ProPDNOME.Value;
   tb_ped02_prePDMARCA.Value :=form_venda_pesqprod.Qr_ProPDMARCA.Value;

   tb_ped02_prePDUND.Value  :=form_venda_pesqprod.Qr_ProPDUND.Value;
   if not fDadosFiscais(Tb_Ped02_Pre) then
      begin
      Tb_Ped02_pre.Next;
      Continue;
      end;
   Tb_Ped02_preP2PRECO.AsFloat := Arredonda(Tb_Ped02_preP2PRECO.AsFloat, mVenda_GP.mPed1_QtdDec);
   if (tb_ped02_preP2QTD.AsFloat>0) and (tb_ped02_preP2PRECO.AsFloat>0) then
      tb_ped02_preVALOR_TOTAL.AsFloat:=tb_ped02_preP2QTD.AsFloat*tb_ped02_preP2PRECO.AsFloat
   else
      tb_ped02_preVALOR_TOTAL.AsFloat:=0;
   Tb_Ped02_pre.Post;

   Tb_Ped02_pre.Next;
   end;
mped1_ajustandodados:=false;

result:=true;
fGravarPed01(0);
fTotais(0);
end;

function TFrm_Venda_Pre.fDescontoProporcional(pTotalDesc, pQtdDev, pQTdTot: Real): real;
begin
if (pTotalDesc<=0) or (pQtdDev=pQtdTot) then
   result:=pTotalDesc
else
   begin
   result  := (pTotalDesc/pqtdTot)*pQtdDev

   end;

end;

