   end
else
   begin
   Tb_Ped02_Lotes_Ant.SQL.add(' and P2LM_CODPRO=:CODPRO ');
   Tb_ped02_Lotes_Ant.ParamByName('CODPRO').AsFloat:=pCodPro;
   end;

Tb_Ped02_Lotes_Ant.SQL.add(' group by P2LM_CODPRO '
                   +',P2LM_LOTSEQ '
                   +',P2LM_CHAVE '
                   +',P2LM_ITEM '
                   +',P2LM_LOTE '
                   +',P2LM_DTFAB ');

Tb_Ped02_Lotes_Ant.SQL.add(' order by P2LM_LOTE ');
Tb_ped02_Lotes_Ant.ParamByName('CODEMP').AsInteger:=mVenda_GP.mPed1_Codemp_ini;
Tb_ped02_Lotes_Ant.ParamByName('CODEMP_FILIAL').AsInteger:=mVenda_GP.mPed1_Codemp_fin;
Tb_ped02_Lotes_Ant.ParamByName('CHAVE').AsInteger:=mVenda_GP.mped1_Chave;
Tb_ped02_Lotes_Ant.ParamByName('CHAVE_ANO').AsInteger:=mVenda_GP.mPed1_Chave_ano;
//Tb_ped02_Lotes_Ant.ParamByName('ITEM').AsInteger:=pItem;
Try
   Tb_Ped02_Lotes_Ant.Open;
   result:=true;
except
   ex_erroSql_Novo(Tb_Ped02_Lotes_Ant,5980,'venda_pre','CADP02_LOTES');
   result:=false;
   end;



                         //          3251-0933
end;

