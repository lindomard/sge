function TFrm_Venda_Pre.fpcoliq(ptipo: Integer; pPreco, pDesc01, pDesc02,pDesc03: Real): Real;
var
preco: Real;
begin
if ptipo=0 then
   begin
   preco:=ppreco-(ppreco*pdesc01/100);
   preco:=preco -(preco*pDesc02/100);
   preco:=preco -(preco*pDesc03/100)
   end
else
   begin
   preco:=ppreco-(ppreco*pdesc01/100);
   preco:=preco -(preco*pDesc02/100);
   preco:=preco -(preco*pDesc03/100)
   end;
preco:=Arredonda(preco,mVenda_GP.mPed1_QtdDec);
Result:=Preco;
end;


