  object U_FP_pre: TUpdateSQL
    ModifySQL.Strings = (
      'update CADPFP'
      'set'
      '  PFPCODEMP = :PFPCODEMP,'
      '  PFPCHAVE = :PFPCHAVE,'
      '  PFPCHAVE_ANO = :PFPCHAVE_ANO,'
      '  PFPPARCELA = :PFPPARCELA,'
      '  PFPQTDPARC = :PFPQTDPARC,'
      '  PFPCODBCO_BOL = :PFPCODBCO_BOL,'
      '  PFPCODFP = :PFPCODFP,'
      '  PFPBAIXA = :PFPBAIXA,'
      '  PFPVALOR = :PFPVALOR,'
      '  PFPNOMFP = :PFPNOMFP,'
      '  PFPDATA = :PFPDATA,'
      '  PFPPRAZO = :PFPPRAZO,'
      '  PFPNUMDOC = :PFPNUMDOC,'
      '  PFPCODBCO_DOC = :PFPCODBCO_DOC,'
      '  PFPSERIE_DOC = :PFPSERIE_DOC,'
      '  PFPCC_DOC = :PFPCC_DOC,'
      '  PFPCOMP_DOC = :PFPCOMP_DOC,'
      '  PFPAGENCIA_DOC = :PFPAGENCIA_DOC,'
      '  PFPEMITENTE_DOC = :PFPEMITENTE_DOC,'
      '  PFPVINCULO_DOC = :PFPVINCULO_DOC,'
      '  PFPCNPJ_CPF_DOC = :PFPCNPJ_CPF_DOC,'
      '  PFPIE_RG = :PFPIE_RG'
      'where'
      '  PFPCODEMP = :OLD_PFPCODEMP and'
      '  PFPCHAVE = :OLD_PFPCHAVE and'
      '  PFPCHAVE_ANO = :OLD_PFPCHAVE_ANO and'
      '  PFPPARCELA = :OLD_PFPPARCELA')
    InsertSQL.Strings = (
      'insert into CADPFP'
      '  (PFPCODEMP, PFPCHAVE, PFPCHAVE_ANO, PFPPARCELA, PFPQTDPARC, '
      'PFPCODBCO_BOL, '
      '   PFPCODFP, PFPBAIXA, PFPVALOR, PFPNOMFP, PFPDATA, PFPPRAZO, '
      'PFPNUMDOC, '
      '   PFPCODBCO_DOC, PFPSERIE_DOC, PFPCC_DOC, PFPCOMP_DOC, '
      'PFPAGENCIA_DOC, '
      '   PFPEMITENTE_DOC, PFPVINCULO_DOC, PFPCNPJ_CPF_DOC, PFPIE_RG)'
      'values'
      
        '  (:PFPCODEMP, :PFPCHAVE, :PFPCHAVE_ANO, :PFPPARCELA, :PFPQTDPAR' +
        'C, '
      ':PFPCODBCO_BOL, '
      
        '   :PFPCODFP, :PFPBAIXA, :PFPVALOR, :PFPNOMFP, :PFPDATA, :PFPPRA' +
        'ZO, '
      ':PFPNUMDOC, '
      '   :PFPCODBCO_DOC, :PFPSERIE_DOC, :PFPCC_DOC, :PFPCOMP_DOC, '
      ':PFPAGENCIA_DOC, '
      
        '   :PFPEMITENTE_DOC, :PFPVINCULO_DOC, :PFPCNPJ_CPF_DOC, :PFPIE_R' +
        'G)')
    DeleteSQL.Strings = (
      'delete from CADPFP'
      'where'
      '  PFPCODEMP = :OLD_PFPCODEMP and'
      '  PFPCHAVE = :OLD_PFPCHAVE and'
      '  PFPCHAVE_ANO = :OLD_PFPCHAVE_ANO and'
      '  PFPPARCELA = :OLD_PFPPARCELA')
    Left = 166
    Top = 223
  end
  object Tb_Ped02_pre: TQuery
    CachedUpdates = True
    BeforeInsert = Tb_Ped02_preBeforeInsert
    AfterInsert = Tb_Ped02_preAfterInsert
    BeforeEdit = Tb_Ped02_preBeforeEdit
    AfterEdit = Tb_Ped02_preAfterEdit
    BeforePost = Tb_Ped02_preBeforePost
    AfterPost = Tb_Ped02_preAfterPost
    BeforeCancel = Tb_Ped02_preBeforeCancel
    AfterCancel = Tb_Ped02_preAfterCancel
    BeforeDelete = Tb_Ped02_preBeforeDelete
    AfterDelete = Tb_Ped02_preAfterDelete
    OnCalcFields = Tb_Ped02_preCalcFields
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      'select ROWNUM AS POSICAO,  P2ITEM,P2QTD,P2DESC1 AS P2DESC_PERC01'
      '       ,P2DESC2 AS P2DESC_PERC02,to_char(P2CODPRO) as P2CODPRO,'
      '       P2DESC3 AS P2DESC_PERC03,P2PRECO       ,P2SIT AS P2CST'
      '       , P2CSOSN'
      '       ,P2CFO AS P2CFOP_NF'
      '       ,P2CFOSUBECF AS P2CFOP_ECF'
      '       ,P2COMPLEMENTO AS P2DESC_COMP'
      '       ,P2QTD*P2PRECO AS VALOR_TOTAL'
      '       ,0 AS P2CSOSN_ORI'
      '       ,P2REDUTICM AS P2ICMS_PPRED'
      '       ,P2MODBCST'
      '       ,P2ST_IVA'
      '       ,P2ST_REDUT'
      '       ,P2ST_ICMCRED AS P2ST_ICMSCRED'
      '       ,P2ST_ICMDEB AS P2ST_ICMSDEB'
      '       ,P2ICMS_BCIPI'
      '       ,P2ICMS_VLIPI'
      '       ,P2ICMS_ALIPI'
      '       ,P2REDUTICM AS P2ICMS_PPRED_101'
      '       ,P2MODBCST AS P2MODBCST_101'
      '       ,P2ST_IVA AS P2ST_IVA_101'
      '       ,P2ST_REDUT AS P2ST_REDUT_101'
      '       ,P2ST_ICMCRED AS P2ST_ICMSCRED_101'
      '       ,P2ST_ICMDEB AS P2ST_ICMSDEB_101'
      '       ,P2PCOTAB AS P2PRECO_TAB,'
      '       P2UCPR AS  P2PRECO_UCPR'
      '       ,P2PCOCUS AS P2PRECO_CUS'
      '       ,P2PCOMAX AS P2PRECO_MAXCONS'
      '       ,P2ALIPI AS P2IPI_PERC'
      '       ,P2ALIQ AS P2ICMS_PERC'
      '       ,P2ALIQICMSDES AS P2ICMS_DESPERC'
      '       ,P2ALIQAPROXTRIB AS P2ALIQAPROXTRIB'
      '       ,P2ALCOFINS P2COFINS_PERC'
      '       ,P2ALPIS AS P2PIS_PERC'
      '       ,P2PCRED_SN P2ICMSSN_PERC'
      '       ,P2CST_PIS'
      '       ,P2CST_COFINS'
      '       ,P2CST_IPI'
      '       ,P2CONTESP'
      '                ,P2CODVEN'
      '                ,P2AMBIENTE'
      '                ,P2PDESCF AS P2DESCFIN_PERC,P2CONS_PROPRIO,'
      
        '                  PDNOME,PDUND,PDMARCA,P2PROMOCAO, P2DESCPR,P2VA' +
        'LDES,'
      'P2PCOMIS,P2TIPO_PCO, PDSECAO'
      ''
      ' FROM cadp02,cadpro'
      ''
      '                where  PDCODPRO =P2CODPRO'
      '')
    UpdateObject = U_Ped02_pre
    Left = 726
    Top = 456
