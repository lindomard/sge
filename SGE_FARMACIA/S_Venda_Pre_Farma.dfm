    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      
        'SELECT PFPCODEMP,PFPCHAVE,PFPLOTSEQ AS PFPCHAVE_ANO,PFPSEQ AS PF' +
        'PPARCELA '
      '                 ,PFPSEQ AS PFPQTDPARC,0 AS PFPCODBCO_BOL '
      '                 ,PFPFORMA AS PFPCODFP '
      '                 ,'#39'N'#39' AS PFPBAIXA'
      '                 ,PFPVALOR '
      '                 ,PFPNOMFOR AS PFPNOMFP'
      '                 ,PFPDATA '
      '                 ,PFPPRAZO,PFPNUMDOC,PFPBANCO AS PFPCODBCO_DOC '
      '                 ,PFPSERIE AS PFPSERIE_DOC,PFPCC AS PFPCC_DOC '
      
        '                 ,PFPCOMP AS PFPCOMP_DOC,PFPAGENCIA AS PFPAGENCI' +
        'A_DOC '
      '                 ,PFPEMITENTE AS PFPEMITENTE_DOC '
      '                 ,PFPVINCULO AS PFPVINCULO_DOC '
      '                 ,PFPCNPF AS PFPCNPJ_CPF_DOC '
      '                 ,PFPRG AS PFPIE_RG '
      ''
      '                 FROM CADPFP '
      '')
    UpdateObject = U_FP_pre
