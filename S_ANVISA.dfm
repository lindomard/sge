  object Table1: TQuery
    OnCalcFields = Table1CalcFields
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      'select PDCODPRO, PDNOME, PDCODBAR, PDREGMS,'
      '       PDCODCON, PDPRZVAL, CLNUMERO,CLDTVCTO, CLQTD'
      '       from CADPRO, CADLGC'
      'Where PDCODCON>0'
      '   AND CLCODPRO(+)=PDCODPRO'
      'Order by PDNOME')
