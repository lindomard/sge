  object Tb_LDR_Provisao: TQuery
    CachedUpdates = True
    BeforeInsert = Tb_LDR_ProvisaoBeforeInsert
    AfterInsert = Tb_LDR_ProvisaoAfterInsert
    DatabaseName = 'SG_ASSOC'
    SQL.Strings = (
      'Select CADLDR_PROVISAO.*,'
      ''
      'CASE'
      ' WHEN CP_TIPO='#39'CL'#39' THEN'
      '(SELECT CRAZAO FROM CADCLI WHERE CCODCLI=CP_CODIGO)'
      ' WHEN CP_TIPO='#39'TR'#39' THEN'
      '(SELECT TRRAZTRA FROM CADTRA WHERE TRCODTRA=CP_CODIGO)'
      ' WHEN CP_TIPO='#39'FU'#39' THEN'
      '(SELECT CFNOMFUN FROM CADFUN WHERE CFCODFUN=CP_CODIGO)'
      ' WHEN CP_TIPO='#39'US'#39' THEN'
      '(SELECT NOMUSR FROM CADUSR WHERE CODUSR=CP_CODIGO)'
      'ELSE'
      '(SELECT FRAZAO FROM CADFOR WHERE FCODFOR=CP_CODIGO)'
      'END'
      ''
      'AS NOME'
      ', CP_DESCMV AS NOMBCO'
      ', CP_DESCMV AS NOMDEP'
      ', CP_DESCMV AS NOMCCU'
      ''
      ' from CADLDR_Provisao')
    UpdateObject = U_LDR_Provisao
    Left = 664
    Top = 278
