  object U_LDR_Provisao: TUpdateSQL
    ModifySQL.Strings = (
      'update CADCLI'
      'set'
      '  CP_CODEMP = :CP_CODEMP,'
      '  CP_DATAPREV = :CP_DATAPREV,'
      '  CP_VALOR = :CP_VALOR,'
      '  CP_CHAVE = :CP_CHAVE,'
      '  CP_CODBCO = :CP_CODBCO,'
      '  CP_CODCC = :CP_CODCC,'
      '  CP_CODDEP = :CP_CODDEP,'
      '  CP_NATDC = :CP_NATDC,'
      '  CP_DESCMV = :CP_DESCMV,'
      '  CP_TIPO = :CP_TIPO,'
      '  CP_CODIGO = :CP_CODIGO,'
      '  CP_DATHOR_INC = :CP_DATHOR_INC,'
      '  CP_DATHOR_ALT = :CP_DATHOR_ALT,'
      '  CP_CODUSR_INC = :CP_CODUSR_INC,'
      '  CP_CODUSR_ALT = :CP_CODUSR_ALT,'
      '  NOME = :NOME,'
      '  NOMBCO = :NOMBCO,'
      '  NOMDEP = :NOMDEP,'
      '  NOMCCU = :NOMCCU'
      'where'
      '  CP_CODEMP = :OLD_CP_CODEMP and'
      '  CP_DATAPREV = :OLD_CP_DATAPREV and'
      '  CP_CHAVE = :OLD_CP_CHAVE')
    InsertSQL.Strings = (
      'insert into CADCLI'
      
        '  (CP_CODEMP, CP_DATAPREV, CP_VALOR, CP_CHAVE, CP_CODBCO, CP_COD' +
        'CC, CP_CODDEP, '
      
        '   CP_NATDC, CP_DESCMV, CP_TIPO, CP_CODIGO, CP_DATHOR_INC, CP_DA' +
        'THOR_ALT, '
      '   CP_CODUSR_INC, CP_CODUSR_ALT, NOME, NOMBCO, NOMDEP, NOMCCU)'
      'values'
      
        '  (:CP_CODEMP, :CP_DATAPREV, :CP_VALOR, :CP_CHAVE, :CP_CODBCO, :' +
        'CP_CODCC, '
      
        '   :CP_CODDEP, :CP_NATDC, :CP_DESCMV, :CP_TIPO, :CP_CODIGO, :CP_' +
        'DATHOR_INC, '
      
        '   :CP_DATHOR_ALT, :CP_CODUSR_INC, :CP_CODUSR_ALT, :NOME, :NOMBC' +
        'O, :NOMDEP, '
      '   :NOMCCU)')
    DeleteSQL.Strings = (
      'delete from CADCLI'
      'where'
      '  CP_CODEMP = :OLD_CP_CODEMP and'
      '  CP_DATAPREV = :OLD_CP_DATAPREV and'
      '  CP_CHAVE = :OLD_CP_CHAVE')
    Left = 696
    Top = 283
  end
