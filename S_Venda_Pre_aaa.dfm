  object Tb_ped02S_pre: TSQLQuery
    MaxBlobSize = 1
    Params = <>
    SQL.Strings = (
      'Select P2SCODEMP,P2SCHAVE,P2SCHAVE_ANO,P2SITEM,P2SCODSER,P2SQTD,'
      
        '        P2SPDESC01,P2SPDESC02,P2SPDESC03,P2SPRECO,P2SDESC_COMP,P' +
        '2SCST,P2SCSOSN,'
      
        '        P2SBCISSQN,P2SVISSQN,P2SPISSQN,P2SSITUACAO,P2SPCOTAB,P2S' +
        'PCOCUS,P2STOTDES,'
      
        '        P2SDESCRAT,P2SDESCFIN_PERC,P2SDESCFIN_VALOR,P2SBCINSS,P2' +
        'SPREDINSS,'
      
        '        P2SVREDINSS,P2SALIQINSS,P2SPREDIRRF,P2VPREDIRRF,P2SBCIRR' +
        'F,P2SVIRRF,'
      '        P2SALIQIRRF,P2SQTD*P2SPRECO AS VALOR_TOTAL,'
      '        P2SCFOP_NF,P2SCFOP_ECF,P2SCODVEN,'
      '        PDNOME,PDUND FROM paf_cadp02s_pre'
      'left join paf_cadpro '
      '          on (PDCODPRO =P2SCODSER '
      '          and PDCODEMP=P2SCODEMP) ')
    Left = 560
    Top = 104
