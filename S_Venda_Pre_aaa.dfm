  object Tb_Ped02_pre: TSQLQuery
    MaxBlobSize = -1
    Params = <>
    SQL.Strings = (
      'select P2ITEM,P2QTD,P2DESC_PERC01,P2DESC_PERC02,P2CODPRO,'
      
        'P2DESC_PERC03,P2PRECO,P2CST,P2CSOSN,P2CFOP_NF,P2CFOP_ECF,P2DESC_' +
        'COMP'
      ',P2QTD*P2PRECO AS VALOR_TOTAL,P2CSOSN_ORI,P2ICMS_PPRED,'
      
        'P2MODBCST,P2ST_IVA,P2ST_REDUT,P2ST_ICMSCRED,P2ST_ICMSDEB,P2PRECO' +
        '_TAB,'
      'P2PRECO_UCPR,P2PRECO_CUS,P2PRECO_MAXCONS,P2IPI_PERC,P2ICMS_PERC,'
      
        'P2COFINS_PERC,P2PIS_PERC,P2ICMSSN_PERC,P2CST_IPI,P2CST_PIS,P2CST' +
        '_COFINS,P2DESCFIN_PERC,P2CODVEN,'
      'P2AMBIENTE,P2PROMOCAO'
      ',PDNOME,PDUND FROM paf_cadp02'
      'left join paf_cadpro '
      '          on (PDCODPRO =P2CODPRO '
      '          and PDCODEMP=P2CODEMP) ')
    Left = 736
    Top = 104
